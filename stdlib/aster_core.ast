// aster_core.ast — the subset-safe core of the library (v0.23.77-dev).
//
// The bootstrap stage (`bootstrap/aster.ast`) is compiled by itself, and its
// own compiler understands a deliberately small language: i32 / i64 / u8 / ptr
// / ptr<u8>, no structs, no f64, no ptr<S>. The full library uses all of those,
// so it cannot be linked into the self-hosting chain — this file is the part
// that can be: memory, strings, integer parsing and the integer formatters.
//
// Every routine here is a byte-for-byte copy of the one in `aster_std.ast`
// (the extractor in tests/library-core-checks.sh asserts that), and none of
// them touches a global, so the object needs no initialiser and imports
// nothing. `tests/library-core-checks.sh` builds it with the *host* compiler
// and with the *self-hosted* stage and runs the same consumer against both.

fn memcpy(dst: ptr<u8>, src: ptr<u8>, n: i32) -> i32 {
    let i: i32 = 0;
    while (i < n) {
        store_u8(dst + i, load_u8(src + i));
        i = i + 1;
    }
    return n;
}

// Fill n bytes with c's low 8 bits (store_u8 truncates, as C's unsigned char
// conversion does). Returns n.

fn memset(dst: ptr<u8>, c: i32, n: i32) -> i32 {
    let i: i32 = 0;
    while (i < n) {
        store_u8(dst + i, c);
        i = i + 1;
    }
    return n;
}

// Byte-wise unsigned comparison of the first n bytes: the first differing
// pair's difference, 0 when equal. The unsigned reading matters — a signed
// compare would order 0x80 below 0x7F and flip the answer for high bytes.

fn memcmp(a: ptr<u8>, b: ptr<u8>, n: i32) -> i32 {
    let i: i32 = 0;
    while (i < n) {
        let x: i32 = load_u8(a + i);
        let y: i32 = load_u8(b + i);
        if (x != y) { return x - y; }
        i = i + 1;
    }
    return 0;
}

// ===========================================================================
// str — NUL-terminated text: the identifier and keyword matcher's toolkit.
// ===========================================================================

fn strlen(s: ptr<u8>) -> i32 {
    let i: i32 = 0;
    while (load_u8(s + i) != 0) { i = i + 1; }
    return i;
}

// C's strcmp: first differing byte pair's difference, 0 when equal. Compares
// as unsigned bytes (load_u8 zero-extends), and stops at the NUL both share.
// The loop bound is a guard, not the terminator: every string shorter than a
// million bytes returns from inside, and the tail return only satisfies the
// compiler's fall-through check (while(true) returns are not seen as
// terminating).

fn strcmp(a: ptr<u8>, b: ptr<u8>) -> i32 {
    let i: i32 = 0;
    while (i < 1000000) {
        let x: i32 = load_u8(a + i);
        let y: i32 = load_u8(b + i);
        if (x != y) { return x - y; }
        if (x == 0) { return 0; }
        i = i + 1;
    }
    return 0;
}

// C's strncpy: copy at most n bytes, NUL-pad when src is shorter, no
// terminator when src runs to n or beyond. Returns min(strlen(src), n) — the
// number of source characters actually copied — so a truncation shows up in
// the return value rather than only in the buffer. (The pad loop runs after
// the count is taken: returning its own index would answer n for every
// short source.)

fn strncpy(dst: ptr<u8>, src: ptr<u8>, n: i32) -> i32 {
    let i: i32 = 0;
    while (i < n) {
        let c: i32 = load_u8(src + i);
        store_u8(dst + i, c);
        if (c == 0) { break; }
        i = i + 1;
    }
    let copied: i32 = i;
    while (i < n) {
        store_u8(dst + i, 0);
        i = i + 1;
    }
    return copied;
}

// ===========================================================================
// num — integers to text: ELF fields and diagnostics.
// ===========================================================================

// Reverse the i digits written at buf[0..i) in place, then NUL-terminate.
// Shared by utoa/utohex — the digits come out least-significant first.

fn reverse_digits(buf: ptr<u8>, i: i32) -> i32 {
    let j: i32 = 0;
    let k: i32 = i - 1;
    while (j < k) {
        let t: i32 = load_u8(buf + j);
        store_u8(buf + j, load_u8(buf + k));
        store_u8(buf + k, t);
        j = j + 1;
        k = k - 1;
    }
    store_u8(buf + i, 0);
    return i;
}

// Unsigned decimal (v is read as its value; the caller keeps it >= 0 — the
// signed case is itoa's job). Returns the digit count.

fn utoa(v: i64, buf: ptr<u8>) -> i32 {
    if (v == 0) {
        store_u8(buf, 48);
        store_u8(buf + 1, 0);
        return 1;
    }
    let i: i32 = 0;
    while (v > 0) {
        let d: i32 = v % 10;              // narrowing: i64 -> i32, in range
        store_u8(buf + i, 48 + d);        // '0' + digit
        v = v / 10;
        i = i + 1;
    }
    return reverse_digits(buf, i);
}

// Signed decimal: '-' then the magnitude. The magnitude of i64's most
// negative value is not representable, so that one input is out of contract
// (the twin asserts the same). Returns the character count, sign included.

fn itoa(v: i64, buf: ptr<u8>) -> i32 {
    if (v < 0) {
        store_u8(buf, 45);                // '-'
        return 1 + utoa(-v, buf + 1);
    }
    return utoa(v, buf);
}

// Lowercase hexadecimal, no prefix, no leading zeros ("0" for zero). The
// width an ELF dump wants is the caller's business (pad in the buffer).
// Returns the digit count.

fn utohex(v: i64, buf: ptr<u8>) -> i32 {
    if (v == 0) {
        store_u8(buf, 48);
        store_u8(buf + 1, 0);
        return 1;
    }
    let i: i32 = 0;
    while (v > 0) {
        let d: i32 = v % 16;
        let ch: i32 = 48 + d;             // '0'..'9'
        if (d > 9) { ch = 87 + d; }       // 'a'..'f' (97 - 10)
        store_u8(buf + i, ch);
        v = v / 16;
        i = i + 1;
    }
    return reverse_digits(buf, i);
}

// ===========================================================================
// hash — open addressing over two global arrays: the symbol table / label
// table a bootstrap compiler needs. 1024 slots (a power of two, so the mask
// is an AND), linear probing, an empty slot is key 0, and a key that is
// already present updates its value instead of duplicating.
// ===========================================================================

fn strncmp(a: ptr<u8>, b: ptr<u8>, n: i32) -> i32 {
    let i: i32 = 0;
    while (i < n) {
        let x: i32 = load_u8(a + i);
        let y: i32 = load_u8(b + i);
        if (x != y) { return x - y; }
        if (x == 0) { return 0; }
        i = i + 1;
    }
    return 0;
}

// strchr(s, c): an offset of the first c in s, or -1. c is compared at its
// low 8 bits, so strchr(s, 'a') and strchr(s, 97) are the same question.

fn strchr(s: ptr<u8>, c: i32) -> i32 {
    let i: i32 = 0;
    let want: i32 = c & 255;
    while (1) {
        let ch: i32 = load_u8(s + i);
        if (ch == want) { return i; }
        if (ch == 0) { return -1; }
        i = i + 1;
    }
    return -1;
}

// strstr(h, n): an offset of the first occurrence of n in h, or -1. The empty
// needle answers 0, as C's does.

fn strstr(h: ptr<u8>, n: ptr<u8>) -> i32 {
    let nl: i32 = strlen(n);
    if (nl == 0) { return 0; }
    let i: i32 = 0;
    while (1) {
        if (load_u8(h + i) == 0) { return -1; }
        if (strncmp(h + i, n, nl) == 0) { return i; }
        i = i + 1;
    }
    return -1;
}

// strcat(d, s): append s to d, NUL included; d must have room. Returns the
// resulting length (not d's address), because the length is what a caller
// advancing a cursor needs.

fn strcat(d: ptr<u8>, s: ptr<u8>) -> i32 {
    let dl: i32 = strlen(d);
    let sl: i32 = strlen(s);
    let i: i32 = 0;
    while (i <= sl) {
        store_u8(d + dl + i, load_u8(s + i));
        i = i + 1;
    }
    return dl + sl;
}

// atoi(s): leading spaces, an optional sign, then decimal digits until the
// first non-digit. Anything else is 0, and a lone sign is 0 too. The value
// wraps like ordinary 32-bit arithmetic past the range, which is what an
// unchecked C atoi does with 32 bits.

fn atoi(s: ptr<u8>) -> i32 {
    let i: i32 = 0;
    while (load_u8(s + i) == 32) { i = i + 1; }
    let neg: i32 = 0;
    let ch: i32 = load_u8(s + i);
    if (ch == 45) { neg = 1; i = i + 1; }
    else if (ch == 43) { i = i + 1; }
    let v: i32 = 0;
    while (1) {
        let d: i32 = load_u8(s + i);
        if (d < 48 || d > 57) { break; }
        v = v * 10 + (d - 48);
        i = i + 1;
    }
    if (neg) { return 0 - v; }
    return v;
}

// is_digit / is_space / is_alpha: 1 or 0, ASCII only (the same test set a
// lexer needs, which is what this library is written for).

fn is_digit(c: i32) -> i32 {
    if (c >= 48 && c <= 57) { return 1; }
    return 0;
}

fn is_space(c: i32) -> i32 {
    if (c == 32 || (c >= 9 && c <= 13)) { return 1; }
    return 0;
}
// v0.23.77-dev: C's isalpha exactly — A-Z and a-z, and *not* '_'. The bootstrap
// scanner treats an underscore as an identifier character where it needs one
// (`is_alpha(c) || c == 95`), so keeping the underscore out of here is what let
// the library's version replace the stage's own without changing the lexer.

fn is_alpha(c: i32) -> i32 {
    if ((c >= 65 && c <= 90) || (c >= 97 && c <= 122)) { return 1; }
    return 0;
}

// fmt_i32(buf, v): v in decimal, no padding, NUL-terminated. Returns the
// digit count (-1 aside). INT32_MIN is handled by working on the magnitude in
// i64, where its absolute value fits.

// f64_bits(m, k): the IEEE-754 binary64 bit pattern of the exact value
// m * 2^k, as an i64 - the piece a decimal-literal converter will end on, and
// useful on its own for hand-built floats. Only integer arithmetic is used,
// which is the whole point: the bootstrap stage has no float type.
//
// Rounding is round-half-to-even, as IEEE-754 requires. Zero answers +0.0, and
// a value this routine cannot represent exactly enough (a magnitude that would
// overflow to infinity, or one that underflows past the subnormal range)
// answers the pattern infinity / zero respectively - the same answers the
// hardware gives.
fn f64_bits(m: i64, k: i32) -> i64 {
    if (m == 0) { return 0; }
    let neg: i32 = 0;
    // No casts here: the subset has none. Assigning an i64 to a u64 keeps its
    // bits, which is exactly the reinterpretation wanted.
    let a: u64 = m;
    if (m < 0) {
        neg = 1;
        a = 0 - m;
    }
    // The highest set bit: a value's binary exponent before normalization.
    let top: i32 = 0;
    let probe: u64 = a;
    while (probe > 1) {
        probe = probe >> 1;
        top = top + 1;
    }
    // A value of 1..2 times 2^(top+k). The biased exponent is that plus 1023,
    // and the fraction field wants 52 bits below the leading one.
    let e: i32 = top + k + 1023;
    let mant: u64 = 0;
    if (top <= 52) {
        // exact: shift the bits up into the 53-bit form, drop the leading one
        mant = (a << (52 - top)) & 4503599627370495;
        if (e <= 0) {
            // subnormal: the leading one is implicit only above the bias, so
            // shift the whole value right by (1 - e) and round there.
            mant = a >> (1 - top - k);
            e = 0;
        }
    } else {
        let drop: i32 = top - 52;
        mant = a >> drop;
        // the bits that fall off decide the rounding
        let rest: u64 = a - (mant << drop);
        let one: u64 = 1;
        let half: u64 = one << (drop - 1);
        if (rest > half) {
            mant = mant + 1;
        } else if (rest == half) {
            if ((mant & 1) == 1) { mant = mant + 1; }
        }
        if (mant > 4503599627370495) {
            mant = mant >> 1;
            e = e + 1;
        }
    }
    if (e >= 2047) {
        // overflow: infinity, which is what the hardware would answer
        if (neg == 1) { return 0 - 9218868437227405312; }
        return 9218868437227405312;
    }
    let eu: u64 = e;
    let bits: u64 = (eu << 52) | mant;
    let out: i64 = bits;
    if (neg == 1) { return 0 - out; }
    return out;
}
// f64_from_dec(digits, exp10): the IEEE-754 bit pattern of digits * 10^exp10,
// for a non-negative value - the step a decimal literal like 3.14 needs. Like
// f64_bits it is integer-only, because the bootstrap stage has no float type.
//
// The mantissa is kept in a u64 and renormalized after every power of ten, with
// the bits that fall off OR-ed into `sticky`. Ten steps of headroom keep the
// shift from overflowing: 10^2 < 2^7, so 2^54 * 10^2 still fits.
//
// Rounding is one decision at the end - round-half-to-even over
// (kept, dropped, sticky) - rather than a rounding at every step, which is what
// makes the result the nearest double instead of an accumulation of ties.
fn f64_from_dec(digits: u64, exp10: i32) -> i64 {
    if (digits == 0) { return 0; }
    // A 128-bit window, not 64. The reason is measurable: with 53 bits kept and
    // a 64-bit window a division leaves only four bits of headroom, so a chain
    // of them drifts - 1e-22 came out one ulp low. A 128-bit window puts the
    // per-step truncation at 2^-124, and 300 steps still cannot reach the
    // rounding cutoff.
    let hi: u64 = 0;
    let lo: u64 = digits;
    let k: i32 = 0;
    let sticky: i32 = 0;
    // normalize until hi's top bit is set: the window is full
    while (hi < 9223372036854775808) {
        hi = (hi << 1) | (lo >> 63);
        lo = lo << 1;
        k = k - 1;
    }
    let p: i32 = exp10;
    let step: i32 = 0;
    while (step < p) {
        // room for *10, dropping the top bits of the window into `sticky`
        while (hi >= 1152921504606846976) {
            // order matters: lo takes hi's last bit, so hi must not move first
            if ((lo & 1) == 1) { sticky = 1; }
            lo = (lo >> 1) | ((hi & 1) << 63);
            hi = hi >> 1;
            k = k + 1;
        }
        // (hi:lo) * 10, split so nothing overflows: lo*8 + lo*2 with carries
        let c3: u64 = lo >> 61;
        let c1: u64 = lo >> 63;
        let a: u64 = lo << 3;
        let b: u64 = lo << 1;
        let sl: u64 = a + b;
        let ov: u64 = 0;
        if (sl < a) { ov = 1; }
        lo = sl;
        // floor(lo*10 / 2^64) is (lo>>61) + (lo>>63) + the add's carry -
        // each already counts whole 2^64 blocks, so neither is scaled again
        hi = hi * 10 + c3 + c1 + ov;
        step = step + 1;
    }
    while (step > p) {
        // (hi:lo) / 10 - long division, sixty-four bits at a time. The remainder
        // never exceeds nine, so `rem * 2 + 1` always fits.
        let qhi: u64 = hi / 10;
        let rem: u64 = hi - qhi * 10;
        let qlo: u64 = 0;
        let bit: i32 = 63;
        while (bit >= 0) {
            rem = rem * 2 + ((lo >> bit) & 1);
            qlo = qlo << 1;
            if (rem >= 10) {
                rem = rem - 10;
                qlo = qlo | 1;
            }
            bit = bit - 1;
        }
        if (rem != 0) { sticky = 1; }
        hi = qhi;
        lo = qlo;
        // refill the window: a division leaves its top bits empty
        while (hi < 9223372036854775808) {
            hi = (hi << 1) | (lo >> 63);
            lo = lo << 1;
            k = k - 1;
        }
        step = step - 1;
    }
    // refill the window one last time: the multiplication loop leaves hi
    // anywhere below 2^64, and the 53 bits are taken from its top
    while (hi < 9223372036854775808) {
        hi = (hi << 1) | (lo >> 63);
        lo = lo << 1;
        k = k - 1;
    }
    // one rounding decision: keep 53 bits, look at the next one, and take
    // `sticky` (plus everything below) as the tie-breaker
    let kept: u64 = hi >> 11;
    let roundbit: u64 = (hi >> 10) & 1;
    let rest: i32 = sticky;
    if ((hi & 1023) != 0) { rest = 1; }
    if (lo != 0) { rest = 1; }
    if (roundbit == 1 && (rest == 1 || (kept & 1) == 1)) { kept = kept + 1; }
    let e: i32 = 52 + k + 75 + 1023;
    if (kept > 9007199254740991) { kept = kept >> 1; e = e + 1; }
    if (e >= 2047) { return 9218868437227405312; }
    // Below the normal range the exponent field would go negative; the subnormal
    // forms are not built here, so those literals answer zero rather than a
    // pattern that is quietly wrong.
    if (e <= 0) { return 0; }
    let eu: u64 = e;
    let bits: u64 = (eu << 52) | (kept - 4503599627370496);
    let out: i64 = bits;
    return out;
}
