// aster_std.ast — the standard library written in Aster itself: the first
// slice (mem/str/num/hash, v0.23.42-dev), the second (v0.23.77-dev: memmove,
// the C string searches, atoi, the fixed-arity formatters, an integer sort and
// a bump allocator over mmap), the printing slice (fmt_f64/fmt_f32) and the
// basic library (files, a growable arena, a byte buffer, two vectors and a
// panic), and its second slice (64-bit formatting, the integer and double
// parsers, the string helpers) and the third slice (a map with string keys and
// pointer values, and a sort by element width — 87 routines in all,
// declarations shared by `include`).
// The original introduction:
//
// the first slice of a standard library written in Aster
// itself: the routines a self-hosting compiler reaches for before it has a
// compiler to build them with (SELFHOSTING-PLAN M2). No libc, no allocator,
// no compiler change — pure Aster over the v0.23.40/41-dev syscall and byte
// intrinsics, delivered as one relocatable object the bootstrap links:
//
//   aster build-obj stdlib/aster_std.ast -o std.o
//   aster build-obj yourapp.ast -o app.o
//   aster link-obj app.o std.o -o app
//
// (include only shares declarations, never bodies — v0.23.13-dev — so a
// library ships as an object, and the consumer declares `extern fn`/`extern
// let`. examples/stdlib_demo.ast is that consumer; tests/stdlib-checks.sh
// diffs every routine against tests/aster-std-twin.c.)
//
// Two idioms carry the whole file:
//
//   * Every byte-buffer parameter is `ptr<u8>`, never bare `ptr`: that
//     spelling is the one that takes BOTH a string literal (whose type is
//     already a ptr to NUL-terminated rodata) and `&arr` of a `u8[N]` (a
//     strided ptr<u8> since v0.23.30-dev). A bare `ptr` parameter refuses
//     `&arr`, and a `ptr[N]` element refuses `&arr` — measured, not assumed.
//   * There are no casts, so a narrowing arrives as an ordinary assignment
//     (`let d: i32 = v % 10;` truncates an i64); only constant initializers
//     are range-checked. Mixed-width arithmetic widens to the wider side, so
//     the FNV loop below stays in i64 without any ceremony.
//
// Everything returns an i32 or an i64 the exit status / a buffer can show —
// there is no void — and every negative answer is a documented sentinel
// (-1), never a trap.

// ===========================================================================
// mem — byte primitives over load_u8/store_u8.
// ===========================================================================

// Copy n bytes, src and dst overlapping is the caller's problem (forward copy
// only, exactly like C's memcpy). Returns n, so a wrong count is observable.
/** 前向复制 n 字节，重叠是调用方的问题，返回 n。
 * @en Copy n bytes forward; overlapping regions are the caller's problem; return n.
 */
fn memcpy(dst: ptr<u8>, src: ptr<u8>, n: i32) : i32 {
    let i: i32 = 0;
    while (i < n) {
        store_u8(dst + i, load_u8(src + i));
        i = i + 1;
    }
    return n;
}

// Fill n bytes with c's low 8 bits (store_u8 truncates, as C's unsigned char
// conversion does). Returns n.
/** 把 n 字节填为 c 的低 8 位，返回 n。
 * @en Fill n bytes with the low 8 bits of c; return n.
 */
fn memset(dst: ptr<u8>, c: i32, n: i32) : i32 {
    let i: i32 = 0;
    while (i < n) {
        store_u8(dst + i, c);
        i = i + 1;
    }
    return n;
}

// Byte-wise unsigned comparison of the first n bytes: the first differing
// pair's difference, 0 when equal. The unsigned reading matters — a signed
// compare would order 0x80 below 0x7F and flip the answer for high bytes.
/** 前 n 字节无符号比较，首个不同字节对的差，相等为 0。
 * @en Compare the first n bytes as unsigned bytes: the difference of the first differing pair, 0 when equal.
 */
fn memcmp(a: ptr<u8>, b: ptr<u8>, n: i32) : i32 {
    let i: i32 = 0;
    while (i < n) {
        let x: i32 = load_u8(a + i);
        let y: i32 = load_u8(b + i);
        if (x != y) { return x - y; }
        i = i + 1;
    }
    return 0;
}

// ===========================================================================
// str — NUL-terminated text: the identifier and keyword matcher's toolkit.
// ===========================================================================

/** 返回首个 NUL 之前的字节数。
 * @en Return the number of bytes before the first NUL.
 */
fn strlen(s: ptr<u8>) : i32 {
    let i: i32 = 0;
    while (load_u8(s + i) != 0) { i = i + 1; }
    return i;
}

// C's strcmp: first differing byte pair's difference, 0 when equal. Compares
// as unsigned bytes (load_u8 zero-extends), and stops at the NUL both share.
// The loop bound is a guard, not the terminator: every string shorter than a
// million bytes returns from inside, and the tail return only satisfies the
// compiler's fall-through check (while(true) returns are not seen as
// terminating).
/** 首个不同字节对的无符号差，相等为 0，NUL 参与比较。
 * @en The unsigned difference of the first differing byte pair, 0 when equal; NUL takes part in the comparison.
 */
fn strcmp(a: ptr<u8>, b: ptr<u8>) : i32 {
    let i: i32 = 0;
    while (i < 1000000) {
        let x: i32 = load_u8(a + i);
        let y: i32 = load_u8(b + i);
        if (x != y) { return x - y; }
        if (x == 0) { return 0; }
        i = i + 1;
    }
    return 0;
}

// Unsigned UTF-8 bytewise ordering. Null sorts before every non-null string.
/** 按无符号 UTF-8 字节序比较两串，空指针排在一切非空之前。
 * @en Compare two strings in unsigned UTF-8 byte order; a null pointer sorts before every non-null string.
 */
fn __aster_cn_str_order(a: ptr<u8>, b: ptr<u8>) : i32 {
    if (a == b) { return 0; }
    if (a == 0) { return 0 - 1; }
    if (b == 0) { return 1; }
    let i: i32 = 0;
    while (true) {
        let x: i32 = load_u8(a + i);
        let y: i32 = load_u8(b + i);
        if (x < y) { return 0 - 1; }
        if (x > y) { return 1; }
        if (x == 0) { return 0; }
        i = i + 1;
    }
    return 0;
}

/** 字符串视图，指针加 i64 长度的 16 字节值类型。
 * @en A string view, a 16-byte value type of a pointer plus an i64 length.
 */
struct AsterStringView { data: ptr<u8>, len: i64 }

/** 从 NUL 结尾串建字符串视图，s 为 0 时长度为 0。
 * @en Build a string view from a NUL-terminated string; the length is 0 when s is 0.
 */
fn __aster_cn_str_view(s: ptr<u8>) : AsterStringView {
    let view: AsterStringView;
    view.data = s;
    view.len = 0;
    if (s != 0) { view.len = i64(strlen(s)); }
    return view;
}

/** 从视图建 NUL 结尾串，长度非法或视图内含 NUL 返回 0。
 * @en Build a NUL-terminated string from a view; return 0 for an illegal length or a view containing NUL.
 */
fn __aster_cn_string_from_view(view: AsterStringView) : ptr<u8> {
    if (view.len < 0 || view.len > 67108863) { return 0; }
    if (view.len > 0 && view.data == 0) { return 0; }
    let length: i32 = i32(view.len);
    let i: i32 = 0;
    while (i < length) {
        if (load_u8(view.data + i) == 0) { return 0; }
        i = i + 1;
    }
    let output: ptr<u8> = ptr<u8>(alloc(length + 1));
    if (output == 0) { return 0; }
    if (length > 0) { memcpy(output, view.data, length); }
    store_u8(output + length, 0);
    return output;
}

// The Chinese frontend's string `+` uses the growable arena. Null operands
// act as empty strings; 0 means the allocation limit or mmap was reached.
/** 字符串加法，空操作数视为空串，超限或分配失败返回 0。
 * @en String addition; an empty operand counts as an empty string; return 0 when over the limit or allocation fails.
 */
fn __aster_cn_str_concat(a: ptr<u8>, b: ptr<u8>) : ptr<u8> {
    let a_len: i32 = 0;
    let b_len: i32 = 0;
    if (a != 0) { a_len = strlen(a); }
    if (b != 0) { b_len = strlen(b); }
    if (a_len > 67108863 || b_len > 67108863 - a_len) { return 0; }
    let total: i32 = a_len + b_len;
    let output: ptr<u8> = ptr<u8>(alloc(total + 1));
    if (output == 0) { return 0; }
    if (a_len > 0) { memcpy(output, a, a_len); }
    if (b_len > 0) { memcpy(output + a_len, b, b_len); }
    store_u8(output + total, 0);
    return output;
}

// C's strncpy: copy at most n bytes, NUL-pad when src is shorter, no
// terminator when src runs to n or beyond. Returns min(strlen(src), n) — the
// number of source characters actually copied — so a truncation shows up in
// the return value rather than only in the buffer. (The pad loop runs after
// the count is taken: returning its own index would answer n for every
// short source.)
/** 至多复制 n 字节，源短时 NUL 填充，返回实际复制的源字符数。
 * @en Copy at most n bytes, NUL-padding when the source is shorter; return the number of source characters actually copied.
 */
fn strncpy(dst: ptr<u8>, src: ptr<u8>, n: i32) : i32 {
    let i: i32 = 0;
    while (i < n) {
        let c: i32 = load_u8(src + i);
        store_u8(dst + i, c);
        if (c == 0) { break; }
        i = i + 1;
    }
    let copied: i32 = i;
    while (i < n) {
        store_u8(dst + i, 0);
        i = i + 1;
    }
    return copied;
}

// ===========================================================================
// num — integers to text: ELF fields and diagnostics.
// ===========================================================================

// Reverse the i digits written at buf[0..i) in place, then NUL-terminate.
// Shared by utoa/utohex — the digits come out least-significant first.
/** 把 buf 前 i 个数字原地倒序并补 NUL，返回 i。
 * @en Reverse the first i digits of buf in place and append NUL; return i.
 */
fn reverse_digits(buf: ptr<u8>, i: i32) : i32 {
    let j: i32 = 0;
    let k: i32 = i - 1;
    while (j < k) {
        let t: i32 = load_u8(buf + j);
        store_u8(buf + j, load_u8(buf + k));
        store_u8(buf + k, t);
        j = j + 1;
        k = k - 1;
    }
    store_u8(buf + i, 0);
    return i;
}

// Unsigned decimal (v is read as its value; the caller keeps it >= 0 — the
// signed case is itoa's job). Returns the digit count.
/** 把无符号整数写成十进制，返回数字个数，零写 "0" 返回 1。
 * @en Write an unsigned integer as decimal; return the digit count; zero writes "0" and returns 1.
 */
fn utoa(v: i64, buf: ptr<u8>) : i32 {
    if (v == 0) {
        store_u8(buf, 48);
        store_u8(buf + 1, 0);
        return 1;
    }
    let i: i32 = 0;
    while (v > 0) {
        let d: i32 = v % 10;              // narrowing: i64 -> i32, in range
        store_u8(buf + i, 48 + d);        // '0' + digit
        v = v / 10;
        i = i + 1;
    }
    return reverse_digits(buf, i);
}

// Signed decimal: '-' then the magnitude. The magnitude of i64's most
// negative value is not representable, so that one input is out of contract
// (the twin asserts the same). Returns the character count, sign included.
/** 把有符号整数写成十进制，返回字符数含符号。
 * @en Write a signed integer as decimal; return the character count including the sign.
 */
fn itoa(v: i64, buf: ptr<u8>) : i32 {
    if (v < 0) {
        store_u8(buf, 45);                // '-'
        return 1 + utoa(-v, buf + 1);
    }
    return utoa(v, buf);
}

// Lowercase hexadecimal, no prefix, no leading zeros ("0" for zero). The
// width an ELF dump wants is the caller's business (pad in the buffer).
// Returns the digit count.
/** 把整数写成小写十六进制，无前缀无前导零，返回数字个数。
 * @en Write an integer as lower-case hexadecimal, no prefix and no leading zeros; return the digit count.
 */
fn utohex(v: i64, buf: ptr<u8>) : i32 {
    if (v == 0) {
        store_u8(buf, 48);
        store_u8(buf + 1, 0);
        return 1;
    }
    let i: i32 = 0;
    while (v > 0) {
        let d: i32 = v % 16;
        let ch: i32 = 48 + d;             // '0'..'9'
        if (d > 9) { ch = 87 + d; }       // 'a'..'f' (97 - 10)
        store_u8(buf + i, ch);
        v = v / 16;
        i = i + 1;
    }
    return reverse_digits(buf, i);
}

// ===========================================================================
// hash — open addressing over two global arrays: the symbol table / label
// table a bootstrap compiler needs. 1024 slots (a power of two, so the mask
// is an AND), linear probing, an empty slot is key 0, and a key that is
// already present updates its value instead of duplicating.
// ===========================================================================

/** 固定哈希表的键串，0 表示空槽。
 * @en The key strings of the fixed hash table; 0 marks an empty slot.
 */
let hkeys: ptr<u8>[1024] = 0;   // key strings; 0 means empty
/** 与 hkeys 平行的固定哈希表的值。
 * @en The values of the fixed hash table, parallel to hkeys.
 */
let hvals: i64[1024] = 0;   // values, parallel to hkeys

// FNV-1a over the bytes, 64-bit. The offset basis 0xcbf29ce484222325 does
// not fit an i64 literal, so it enters as its two's-complement value
// -3750763034362895579 — the same 64 bits (14695981039346656037 - 2^64).
// Multiplication wraps (two's complement), which is what the hash wants
// anyway.
/** 对字符串算 FNV-1a 64 位哈希。
 * @en Compute the FNV-1a 64-bit hash of a string.
 */
fn hash_str(s: ptr<u8>) : i64 {
    let h: i64 = -3750763034362895579;
    let i: i32 = 0;
    while (i < 1000000) {
        let b: i32 = load_u8(s + i);
        if (b == 0) { return h; }
        h = (h ^ b) * 1099511628211;
        i = i + 1;
    }
    return h;
}

// Insert or update: returns the slot index, or -1 when all 1024 slots are
// occupied (a table that full is a bootstrap-scale bug, not a condition to
// grow into — the caller's input was not that large).
/** 在固定 1024 槽表里插入或更新键值，返回槽下标，表满返回 -1。
 * @en Insert or update a key in the fixed 1024-slot table; return the slot index, -1 when the table is full.
 */
fn hash_put(key: ptr<u8>, val: i64) : i32 {
    let i: i32 = hash_str(key) & 1023;
    let probes: i32 = 0;
    while (probes < 1024) {
        let k: ptr<u8> = hkeys[i];
        if (k == 0) {
            hkeys[i] = key;
            hvals[i] = val;
            return i;
        }
        if (strcmp(k, key) == 0) {
            hvals[i] = val;
            return i;
        }
        i = i + 1;
        if (i == 1024) { i = 0; }
        probes = probes + 1;
    }
    return -1;
}

// Look up: the value, or -1 when absent. Values are therefore non-negative
// by contract — true for the table indices and counts a compiler stores.
/** 在固定表里查值，不存在返回 -1，值按契约非负。
 * @en Look a value up in the fixed table; return -1 when absent; values are non-negative by contract.
 */
fn hash_get(key: ptr<u8>) : i64 {
    let i: i32 = hash_str(key) & 1023;
    let probes: i32 = 0;
    while (probes < 1024) {
        let k: ptr<u8> = hkeys[i];
        if (k == 0) { return -1; }        // empty slot ends the probe chain
        if (strcmp(k, key) == 0) { return hvals[i]; }
        i = i + 1;
        if (i == 1024) { i = 0; }
        probes = probes + 1;
    }
    return -1;
}

// ===========================================================================
// v0.23.77-dev: the second slice — the routines a command-line tool needs
// before it can be pleasant to write: overlap-safe copy, the string searches
// C programs reach for, an integer parser, fixed-arity formatting (there is no
// variadic call, so formatting is a family of typed writers rather than one
// printf), an in-place integer sort, and a bump allocator over mmap.
//
// Casts are available since v0.23.48-dev (`i32(x)`, `i64(x)`), so where the
// first slice narrowed with `%` the new code spells the width it means.
// Everything still returns a non-void value: a count, a sentinel, or the
// input pointer, because a wrong answer has to be observable.
// ===========================================================================

// memmove(dst, src, n): copy n bytes, correct when the ranges overlap. A
// forward copy is used unless dst starts above src, where it would overwrite
// bytes it has not read yet; that case copies backwards. Returns n.
/** 复制 n 字节，重叠也正确，返回 n。
 * @en Copy n bytes, correctly even when the regions overlap; return n.
 */
fn memmove(dst: ptr<u8>, src: ptr<u8>, n: i32) : i32 {
    if (dst == src || n <= 0) { return n; }
    if (i64(dst) < i64(src)) {
        let i: i32 = 0;
        while (i < n) {
            store_u8(dst + i, load_u8(src + i));
            i = i + 1;
        }
    } else {
        let i: i32 = n;
        while (i > 0) {
            i = i - 1;
            store_u8(dst + i, load_u8(src + i));
        }
    }
    return n;
}

// strncmp(a, b, n): the first differing pair's difference over at most n
// bytes, 0 when equal — unsigned bytes, the same reading memcmp uses.
/** 至多比较 n 字节的 strcmp，n 耗尽前遇 NUL 即相等。
 * @en strcmp over at most n bytes; equal once NUL is met before n runs out.
 */
fn strncmp(a: ptr<u8>, b: ptr<u8>, n: i32) : i32 {
    let i: i32 = 0;
    while (i < n) {
        let x: i32 = load_u8(a + i);
        let y: i32 = load_u8(b + i);
        if (x != y) { return x - y; }
        if (x == 0) { return 0; }
        i = i + 1;
    }
    return 0;
}

// strchr(s, c): an offset of the first c in s, or -1. c is compared at its
// low 8 bits, so strchr(s, 'a') and strchr(s, 97) are the same question.
/** 返回首个 c 低 8 位的下标，找不到返回 -1。
 * @en Return the index of the first c (low 8 bits); return -1 when not found.
 */
fn strchr(s: ptr<u8>, c: i32) : i32 {
    let i: i32 = 0;
    let want: i32 = c & 255;
    while (1) {
        let ch: i32 = load_u8(s + i);
        if (ch == want) { return i; }
        if (ch == 0) { return -1; }
        i = i + 1;
    }
    return -1;
}

// strstr(h, n): an offset of the first occurrence of n in h, or -1. The empty
// needle answers 0, as C's does.
/** 返回 n 在 h 中首次出现的下标，空针返回 0，找不到返回 -1。
 * @en Return the index where n first occurs in h, 0 for an empty needle, -1 when not found.
 */
fn strstr(h: ptr<u8>, n: ptr<u8>) : i32 {
    let nl: i32 = strlen(n);
    if (nl == 0) { return 0; }
    let i: i32 = 0;
    while (1) {
        if (load_u8(h + i) == 0) { return -1; }
        if (strncmp(h + i, n, nl) == 0) { return i; }
        i = i + 1;
    }
    return -1;
}

// strcat(d, s): append s to d, NUL included; d must have room. Returns the
// resulting length (not d's address), because the length is what a caller
// advancing a cursor needs.
/** 把 s 含 NUL 追加到 d 末尾，返回结果长度。
 * @en Append s, NUL included, to the end of d; return the resulting length.
 */
fn strcat(d: ptr<u8>, s: ptr<u8>) : i32 {
    let dl: i32 = strlen(d);
    let sl: i32 = strlen(s);
    let i: i32 = 0;
    while (i <= sl) {
        store_u8(d + dl + i, load_u8(s + i));
        i = i + 1;
    }
    return dl + sl;
}

// atoi(s): leading whitespace, an optional sign, then decimal digits until the
// first non-digit. Anything else is 0, and a lone sign is 0 too. The value
// wraps like ordinary 32-bit arithmetic past the range, which is what an
// unchecked C atoi does with 32 bits.
/** 跳过前导空白与可选符号读十进制整数，其余为 0，超范围按 32 位回绕。
 * @en Skip leading blanks and an optional sign, then read a decimal integer; anything else reads as 0, out of range wraps in 32 bits.
 */
fn atoi(s: ptr<u8>) : i32 {
    let i: i32 = 0;
    while (is_space(load_u8(s + i))) { i = i + 1; }
    let neg: i32 = 0;
    let ch: i32 = load_u8(s + i);
    if (ch == 45) { neg = 1; i = i + 1; }
    else if (ch == 43) { i = i + 1; }
    let v: i32 = 0;
    while (1) {
        let d: i32 = load_u8(s + i);
        if (d < 48 || d > 57) { break; }
        v = v * 10 + (d - 48);
        i = i + 1;
    }
    if (neg) { return 0 - v; }
    return v;
}

// is_digit / is_space / is_alpha: 1 or 0, ASCII only (the same test set a
// lexer needs, which is what this library is written for).
/** c 是 0-9 返回 1，否则返回 0。
 * @en Return 1 when c is 0-9, 0 otherwise.
 */
fn is_digit(c: i32) : i32 {
    if (c >= 48 && c <= 57) { return 1; }
    return 0;
}
/** c 是空格或 9..13 的空白返回 1，否则返回 0。
 * @en Return 1 when c is a space or a blank in 9..13, 0 otherwise.
 */
fn is_space(c: i32) : i32 {
    if (c == 32 || (c >= 9 && c <= 13)) { return 1; }
    return 0;
}
// v0.23.77-dev: C's isalpha exactly — A-Z and a-z, and *not* '_'. The bootstrap
// scanner treats an underscore as an identifier character where it needs one
// (`is_alpha(c) || c == 95`), so keeping the underscore out of here is what let
// the library's version replace the stage's own without changing the lexer.
/** c 是 A-Z 或 a-z 返回 1，否则返回 0，不含下划线。
 * @en Return 1 when c is A-Z or a-z, 0 otherwise; underscore is not included.
 */
fn is_alpha(c: i32) : i32 {
    if ((c >= 65 && c <= 90) || (c >= 97 && c <= 122)) { return 1; }
    return 0;
}

// fmt_i32(buf, v): v in decimal, no padding, NUL-terminated. Returns the
// digit count (-1 aside). INT32_MIN is handled by working on the magnitude in
// i64, where its absolute value fits.
/** 把 i32 写成十进制并补 NUL，返回数字个数。
 * @en Write an i32 as decimal with a NUL terminator; return the digit count.
 */
fn fmt_i32(buf: ptr<u8>, v: i32) : i32 {
    let at: i32 = 0;
    let w: i64 = v;
    if (w < 0) {
        store_u8(buf, 45);
        at = 1;
        w = 0 - w;
    }
    let tmp: u8[16] = 0;
    let i: i32 = 0;
    if (w == 0) {
        store_u8(tmp, 48);
        i = 1;
    }
    while (w > 0) {
        store_u8(tmp + i, 48 + i32(w % 10));
        w = w / 10;
        i = i + 1;
    }
    let j: i32 = i;
    while (j > 0) {
        j = j - 1;
        store_u8(buf + at, load_u8(tmp + j));
        at = at + 1;
    }
    store_u8(buf + at, 0);
    return at;
}

// fmt_hex(buf, v, digits): exactly `digits` lowercase hex characters, zero
// padded, NUL-terminated; digits is clamped to 1..8. Returns the count.
// fmt_i32_w(buf, v, width): v in decimal, right-aligned in a field of `width`
// columns, space padded, NUL terminated; answers the bytes written. A value
// wider than the field is written in full (the field is a minimum, not a
// truncation) - the same rule C's "%*d" with a positive width follows.
/** 把 i32 写成十进制并右对齐于 width 列，空格填充，返回写了多少字节。
 * @en Write an i32 as decimal, right-aligned to width columns with space padding; return the number of bytes written.
 */
fn fmt_i32_w(buf: ptr<u8>, v: i32, width: i32) : i32 {
    let tmp: u8[24] = 0;
    let n: i32 = fmt_i32(tmp, v);
    let pad: i32 = width - n;
    let at: i32 = 0;
    while (at < pad) {
        store_u8(buf + at, 32);
        at = at + 1;
    }
    let i: i32 = 0;
    while (i < n) {
        store_u8(buf + at + i, load_u8(tmp + i));
        i = i + 1;
    }
    store_u8(buf + at + n, 0);
    return at + n;
}

// fmt_hex_w(buf, v, width): lowercase hex, right-aligned in a field of `width`
// columns, SPACE padded - the companion of fmt_hex (which zero pads). A value
// wider than the field is written in full, the same rule fmt_i32_w follows.
/** 把 i32 写成小写十六进制并右对齐于 width 列，空格填充，返回写了多少字节。
 * @en Write an i32 as lower-case hexadecimal, right-aligned to width columns with space padding; return the number of bytes written.
 */
fn fmt_hex_w(buf: ptr<u8>, v: i32, width: i32) : i32 {
    // fmt_hex prints exactly the digits it is asked for, so ask for the full
    // width and drop the leading zeros here - that is the natural length.
    let tmp: u8[16] = 0;
    let full: i32 = fmt_hex(tmp, v, 8);
    let start: i32 = 0;
    while (start < full - 1) {
        if (load_u8(tmp + start) != 48) { break; }
        start = start + 1;
    }
    let n: i32 = full - start;
    let pad: i32 = width - n;
    let at: i32 = 0;
    while (at < pad) {
        store_u8(buf + at, 32);
        at = at + 1;
    }
    let i: i32 = 0;
    while (i < n) {
        store_u8(buf + at + i, load_u8(tmp + start + i));
        i = i + 1;
    }
    store_u8(buf + at + n, 0);
    return at + n;
}

/** 把 i32 写成恰好 digits 位小写十六进制，零填充，返回位数。
 * @en Write an i32 as exactly digits lower-case hex digits, zero-padded; return the digit count.
 */
fn fmt_hex(buf: ptr<u8>, v: i32, digits: i32) : i32 {
    let d: i32 = digits;
    if (d < 1) { d = 1; }
    if (d > 8) { d = 8; }
    let i: i32 = 0;
    while (i < d) {
        let shift: i32 = (d - 1 - i) * 4;
        let nib: i32 = (v >> shift) & 15;
        let ch: i32 = 48 + nib;
        if (nib > 9) { ch = 87 + nib; }
        store_u8(buf + i, ch);
        i = i + 1;
    }
    store_u8(buf + d, 0);
    return d;
}

// sort_i32(a, n): the i32 array at `a` in ascending order. The general form
// below (`sort_bytes`) is what does the work; this is the typed wrapper a
// caller reaches for, kept as the same name and contract the library has had
// since v0.23.77-dev's second slice.
/** 把 i32 数组升序排列。
 * @en Sort an i32 array in ascending order.
 */
fn sort_i32(a: ptr, n: i32) : i32 { return sort_bytes(a, n, 4, ptr(cmp_i32_asc)); }
// A bump allocator over one 64 KiB anonymous mapping: the shape a compiler's
// arena wants (no free list, no metadata, 8-byte aligned). malloc answers 0
// when the mapping is exhausted; free is the documented no-op, so a program
// that frees is still correct and simply does not reclaim.
/** malloc 的映射基址。
 * @en The base address of malloc's mapping.
 */
let heap_base: ptr = 0;
/** malloc 的映射已用字节数。
 * @en The used bytes of malloc's mapping.
 */
let heap_used: i32 = 0;
/** malloc 的映射大小。
 * @en The size of malloc's mapping.
 */
let heap_size: i32 = 0;

/** 在一次 64 KiB 匿名映射上 bump 分配并 8 字节对齐，n<=0 或耗尽返回 0。
 * @en Bump-allocate on a single 64 KiB anonymous mapping, 8-byte aligned; return 0 when n<=0 or the mapping is exhausted.
 */
fn malloc(n: i32) : ptr {
    if (heap_base == 0) {
        heap_base = mmap(ptr(0), 65536, 3, 34, 0 - 1, 0);
        // mmap answers a pointer in [-4095, -1] on failure (a negated
        // errno): a failed mapping must answer 0, not leave a bogus base
        // for this and later calls to hand out. The base is reset so a
        // later call retries the mapping.
        let mapped: i64 = i64(heap_base);
        if (mapped < 0 && mapped >= 0 - 4095) {
            heap_base = 0;
            return 0;
        }
        heap_size = 65536;
        heap_used = 0;
    }
    if (n <= 0) { return 0; }
    let need: i32 = (n + 7) & (0 - 8);
    // A request near i32's top wraps the rounding above to a non-positive
    // `need`, which the exhaustion check below would then pass: such a
    // request can never fit the 64 KiB mapping, so it answers 0 as well.
    if (need <= 0) { return 0; }
    if (heap_used + need > heap_size) { return 0; }
    let p: ptr = heap_base + heap_used;
    heap_used = heap_used + need;
    return p;
}

/** 文档化的 no-op，不回收，返回 0。
 * @en A documented no-op that never reclaims; return 0.
 */
fn free(p: ptr) : i32 {
    return 0;
}

// ===========================================================================
// v0.23.77-dev: printing a double.
//
// There is no variadic call and no printf, so the shape is the same one the
// integer formatters already use: a writer that emits into a caller's buffer
// and answers how many bytes it wrote. The number is printed in fixed point
// (d digits after the point, d clamped to 0..9): an exponent form needs a
// second rounding decision and a cursor that can shift, which a compiler's
// diagnostic output does not need.
//
// Rounding is half-up on the *binary* value, so 3.14159 with two digits is
// 3.14 and -2.718 with one digit is -2.7. A value that is exactly halfway
// between two representable decimals goes up, which is the rule a person
// reading a diagnostic expects, and is deliberately not C's round-half-even.
// ===========================================================================

// fmt_f64(buf, v, decimals): v in fixed point with `decimals` digits after
// the point (clamped to 0..9), NUL-terminated. Returns the byte count, sign
// included. `nan` and `inf` are spelled the way a C printf spells them, so a
// program's output stays comparable with one.
/** 把 f64 写成定点小数，decimals 位小数，返回字节数含符号。
 * @en Write an f64 as a fixed-point decimal with decimals fractional digits; return the byte count including the sign.
 */
fn fmt_f64(buf: ptr<u8>, v: f64, decimals: i32) : i32 {
    let at: i32 = 0;
    let x: f64 = v;
    // A NaN is neither negative nor orderable, so it is answered first.
    if (x != x) {
        store_u8(buf, 110);                // 'n'
        store_u8(buf + 1, 97);             // 'a'
        store_u8(buf + 2, 110);            // 'n'
        store_u8(buf + 3, 0);
        return 3;
    }
    if (x < 0.0) {
        store_u8(buf, 45);                 // '-'
        at = 1;
        x = 0.0 - x;
    }
    // An infinity times zero is a NaN; a finite value times zero is a plain
    // zero. That is the whole test, and it needs no constant beyond 0.0.
    let probe: f64 = x * 0.0;
    if (probe != probe) {
        store_u8(buf + at, 105);           // 'i'
        store_u8(buf + at + 1, 110);       // 'n'
        store_u8(buf + at + 2, 102);       // 'f'
        store_u8(buf + at + 3, 0);
        return at + 3;
    }
    let d: i32 = decimals;
    if (d < 0) { d = 0; }
    if (d > 9) { d = 9; }
    // The same power of ten twice: once as a double, for the rounding, and
    // once as an integer, for splitting the rounded value into halves.
    let scale: f64 = 1.0;
    let iscale: i64 = 1;
    let i: i32 = 0;
    while (i < d) {
        scale = scale * 10.0;
        iscale = iscale * 10;
        i = i + 1;
    }
    let total: i64 = i64(x * scale + 0.5);
    at = at + utoa(total / iscale, buf + at);
    if (d > 0) {
        store_u8(buf + at, 46);            // '.'
        at = at + 1;
        let frac: i64 = total % iscale;
        let div: i64 = iscale / 10;
        let k: i32 = 1;
        while (k < d) {
            store_u8(buf + at, 48 + i32((frac / div) % 10));
            at = at + 1;
            div = div / 10;
            k = k + 1;
        }
        store_u8(buf + at, 48 + i32(frac % 10));
        at = at + 1;
    }
    store_u8(buf + at, 0);
    return at;
}

// fmt_f32(buf, v, decimals): the single-precision sibling. The value widens to
// a double first — one exact conversion, so the digits printed are the digits
// the single actually holds, not a second rounding's worth of noise past them.
/** 把 f32 拓宽为 f64 后按 fmt_f64 写成定点小数，返回字节数。
 * @en Widen an f32 to f64 and write it as fmt_f64 does; return the byte count.
 */
fn fmt_f32(buf: ptr<u8>, v: f32, decimals: i32) : i32 {
    return fmt_f64(buf, f64(v), decimals);
}

// ===========================================================================
// v0.23.77-dev: the basic library — files, a growable arena, and buffers.
//
// The syscalls have been reachable from Aster since v0.23.40-dev, but only as
// raw intrinsics: every program wrote `openat(-100, path, 0, 0)` itself and
// every program that needed a string built up in memory used a fixed-size
// global array with a capacity check. This section is the missing layer.
//
// Two allocators, deliberately:
//   * `malloc`/`free` (the v0.23.42-dev pair) stay exactly as they are — one
//     64 KiB mapping, 8-byte aligned, 0 when exhausted. That exhaustion
//     sentinel is a documented, tested contract, and the bootstrap relies on
//     the small footprint.
//   * `alloc`/`ralloc` are the growable pair the buffers below use: when the
//     current mapping has no room, `alloc` maps another one and keeps using
//     it. Nothing is ever returned to the kernel, so a pointer stays valid for
//     the life of the program — which is the arena rule the language already
//     documents (`free` answers 0 and reclaims nothing).
// ===========================================================================

// --- files ---------------------------------------------------------------

// Linux's AT_FDCWD, the only directory handle a program needs here.
/** Linux 的 AT_FDCWD（-100）。
 * @en Linux AT_FDCWD (-100).
 */
const kAtFdcwd: i32 = 0 - 100;

// The open(2) flags, Linux values, in value order. fd_open takes these by
// name — `O_WRONLY | O_CREAT | O_TRUNC` is 577 — instead of bare numbers.
/** Linux 的 O_RDONLY（0）。
 * @en Linux O_RDONLY (0).
 */
const O_RDONLY: i32 = 0;
/** Linux 的 O_WRONLY（1）。
 * @en Linux O_WRONLY (1).
 */
const O_WRONLY: i32 = 1;
/** Linux 的 O_RDWR（2）。
 * @en Linux O_RDWR (2).
 */
const O_RDWR: i32 = 2;
/** Linux 的 O_CREAT（64）。
 * @en Linux O_CREAT (64).
 */
const O_CREAT: i32 = 64;
/** Linux 的 O_EXCL（128）。
 * @en Linux O_EXCL (128).
 */
const O_EXCL: i32 = 128;
/** Linux 的 O_TRUNC（512）。
 * @en Linux O_TRUNC (512).
 */
const O_TRUNC: i32 = 512;
/** Linux 的 O_APPEND（1024）。
 * @en Linux O_APPEND (1024).
 */
const O_APPEND: i32 = 1024;
/** Linux 的 O_NONBLOCK（2048）。
 * @en Linux O_NONBLOCK (2048).
 */
const O_NONBLOCK: i32 = 2048;
/** Linux 的 O_CLOEXEC（524288）。
 * @en Linux O_CLOEXEC (524288).
 */
const O_CLOEXEC: i32 = 524288;

// fd_open(path, flags, mode): openat(AT_FDCWD, …) with the caller's flags
// (the `O_*` constants above, e.g. `O_WRONLY|O_CREAT|O_TRUNC` = 577).
// Answers the fd, or -1.
/** 打开文件，返回 fd，失败返回 -1。
 * @en Open a file; return the fd, -1 on failure.
 */
fn fd_open(path: ptr<u8>, flags: i32, mode: i32) : i32 {
    return openat(kAtFdcwd, path, flags, mode);
}
/** read 的直通，返回读到的字节数。
 * @en A pass-through for read; return the bytes read.
 */
fn fd_read(fd: i32, buf: ptr<u8>, n: i32) : i32 { return read(fd, buf, n); }
/** write 的直通，返回写出的字节数。
 * @en A pass-through for write; return the bytes written.
 */
fn fd_write(fd: i32, buf: ptr<u8>, n: i32) : i32 { return write(fd, buf, n); }
/** close 的直通，返回内核原值。
 * @en A pass-through for close; return the kernel's value.
 */
fn fd_close(fd: i32) : i32 { return close(fd); }

// write_all(fd, buf, n): a short write is legal (a pipe, a tty), so a loop
// writes the rest. Answers the bytes written, or -1 when the kernel refuses.
/** 循环写完 n 字节，返回写了多少字节，内核拒绝返回 -1。
 * @en Write n bytes in a loop; return the bytes written, -1 when the kernel refuses.
 */
fn write_all(fd: i32, buf: ptr<u8>, n: i32) : i32 {
    let done: i32 = 0;
    while (done < n) {
        let w: i32 = write(fd, buf + done, n - done);
        if (w <= 0) { return 0 - 1; }
        done = done + w;
    }
    return done;
}

// file_size(path): st_size out of an fstat, or -1. The AArch64 `struct stat`
// puts st_size at byte 48, so the buffer is read at that offset rather than
// as a typed array — the layout is the kernel's, not ours.
/** 返回文件的 st_size，失败返回 -1。
 * @en Return the file's st_size; return -1 on failure.
 */
fn file_size(path: ptr<u8>) : i64 {
    let fd: i32 = fd_open(path, 0, 0);
    if (fd < 0) { return 0 - 1; }
    let st: u8[128] = 0;
    let r: i32 = fstat(fd, &st);
    fd_close(fd);
    if (r != 0) { return 0 - 1; }
    return load_i64(&st + 48);
}

// slurp_bytes(path, out_len): the whole file in a fresh `alloc` buffer, NUL
// terminated, with the length written through `out_len` (may be 0). Answers 0
// when the file cannot be opened or read. A length of 0 from the descriptor is
// not trusted alone — a directory or a pipe answers 0 — so the buffer is read
// until the kernel says there is nothing left.
/** 整文件读进一块新的 alloc 缓冲并补 NUL，长度写进 out_len，失败返回 0。
 * @en Read a whole file into a fresh alloc buffer with a NUL terminator, writing the length to out_len; return 0 on failure.
 */
fn slurp_bytes(path: ptr<u8>, out_len: ptr<u8>) : ptr {
    let fd: i32 = fd_open(path, 0, 0);
    if (fd < 0) { return 0; }
    let size: i64 = file_size(path);
    let cap: i32 = (size > 0) ? i32(size) + 1 : 4096;
    let buf: ptr = alloc(cap);
    if (buf == 0) { fd_close(fd); return 0; }
    let count: i32 = 0;
    let space: i32 = cap - 1;
    while (1) {
        if (space <= 0) {
            // The file grew under us (or the size was a lie): double and go on.
            let bigger: ptr = ralloc(buf, cap, cap * 2);
            if (bigger == 0) { fd_close(fd); return 0; }
            buf = bigger;
            cap = cap * 2;
            space = cap - 1 - count;
        }
        let n: i32 = read(fd, buf + count, space);
        if (n < 0) { fd_close(fd); return 0; }
        if (n == 0) { break; }
        count = count + n;
        space = space - n;
    }
    fd_close(fd);
    store_u8(buf + count, 0);
    if (out_len != 0) { store_i64(out_len, i64(count)); }
    return buf;
}

// slurp(path): the same, for text, answering only the pointer (0 on failure).
/** 整文件读进一块新的 alloc 缓冲并补 NUL，只给指针，失败返回 0。
 * @en Read a whole file into a fresh alloc buffer with a NUL terminator, returning only the pointer; return 0 on failure.
 */
fn slurp(path: ptr<u8>) : ptr {
    let n: u8[8] = 0;                 // the out-parameter is a byte buffer, so
    return slurp_bytes(path, &n);     // the length has a place to land
}

// --- the growable arena --------------------------------------------------
// One chunk at a time: when the current mapping is full, a new one is mapped
// and becomes current. Nothing is freed, so every earlier pointer stays valid.

/** alloc 的当前映射基址。
 * @en The base address of alloc's current mapping.
 */
let arena_base: ptr = 0;
/** alloc 的当前映射已用字节数。
 * @en The used bytes of alloc's current mapping.
 */
let arena_used: i32 = 0;
/** alloc 的当前映射大小。
 * @en The size of alloc's current mapping.
 */
let arena_size: i32 = 0;
// A single request larger than this is refused rather than mapped: a typo in
// a size must not ask the kernel for a gigabyte.
/** 单次 arena 请求上限 64 MiB，超过即拒绝。
 * @en The per-request arena limit of 64 MiB; larger requests are refused.
 */
const kArenaMaxChunk: i32 = 67108864;   // 64 MiB

/** 内部辅助，映射一块新 chunk 并设为当前 chunk，失败返回 0。
 * @en Internal helper that maps a new chunk and makes it the current one; return 0 on failure.
 */
fn arena_new_chunk(n: i32) : ptr {
    let want: i32 = n < 65536 ? 65536 : n;
    let p: ptr = mmap(ptr(0), want, 3, 34, 0 - 1, 0);
    let result: i64 = i64(p);
    if (result < 0 && result >= 0 - 4095) { return 0; }
    arena_base = p;
    arena_used = 0;
    arena_size = want;
    return p;
}

// alloc(n): n bytes, 8-byte aligned, from the growable arena; 0 when n <= 0 or
// the request is beyond kArenaMaxChunk.
/** 在 growable arena 里分配 n 字节并 8 字节对齐，失败返回 0。
 * @en Allocate n bytes in the growable arena, 8-byte aligned; return 0 on failure.
 */
fn alloc(n: i32) : ptr {
    if (n <= 0) { return 0; }
    if (n > kArenaMaxChunk) { return 0; }
    let need: i32 = (n + 7) & (0 - 8);
    if (arena_base == 0) {
        if (arena_new_chunk(need) == 0) { return 0; }
    }
    if (arena_used + need > arena_size) {
        if (arena_new_chunk(need) == 0) { return 0; }
    }
    let p: ptr = arena_base + arena_used;
    arena_used = arena_used + need;
    return p;
}

// ralloc(p, old_n, new_n): a copy into a fresh block, which is all a grow-only
// arena can promise. Answers the new pointer (0 on failure); the old one keeps
// its bytes at its old address.
/** 把旧块内容复制到新块，new_n<=old_n 时返回 p 本身，失败返回 0。
 * @en Copy the old block into a new block; return p itself when new_n<=old_n, 0 on failure.
 */
fn ralloc(p: ptr, old_n: i32, new_n: i32) : ptr {
    if (new_n <= 0) { return 0; }
    if (p != 0 && new_n <= old_n) { return p; }
    let q: ptr = alloc(new_n);
    if (q == 0) { return 0; }
    if (p != 0) {
        let copy: i32 = old_n < new_n ? old_n : new_n;
        let i: i32 = 0;
        while (i < copy) {
            store_u8(q + i, load_u8(p + i));
            i = i + 1;
        }
    }
    return q;
}

// --- closure callback adapter context pool (C-2) --------------------------
// A closure passed to a `fn(ptr)` parameter is adapted by a 24-byte context
// {code: ptr, env: ptr, user: ptr} that the thunk reads on every call. The
// context used to come from `alloc`, i.e. the grow-only arena, so every
// registration leaked 24 bytes forever. Contexts now come from a dedicated
// reuse pool instead:
//
//   * the first registration takes one arena chunk of 256 slots (6144
//     bytes, a one-time cost) and chains the slots into a free list;
//   * `aster_cn_adapter_alloc` pops a free slot, or `alloc`s a fresh
//     24-byte block once all 256 slots are live at once (correct, but that
//     overflow block is outside the pool and cannot be reclaimed);
//   * `aster_cn_adapter_free` returns a slot to the pool. It answers 1
//     when a slot was recycled and 0 otherwise: a null pointer, a pointer
//     outside the pool, and an already-freed slot are all no-ops, so a
//     registry may call it unconditionally on the `user` pointer it stored
//     without knowing whether that pointer came from an adapter.
//
// Ownership contract: the `user` pointer delivered alongside an adapter
// thunk is an adapter context owned by the callee. Whoever stores the
// (callback, user) pair must call `aster_cn_adapter_free` on the stored
// `user` when the registration is removed. A callee that only invokes the
// callback synchronously and does not retain the pair can call
// `aster_cn_adapter_free(user)` before returning instead: the call is a
// no-op for a genuine user pointer, so it is safe even when the caller
// passed an ordinary function pointer. Only a callee that neither retains
// nor frees the pair leaks, one pool slot per call until the pool overflows,
// which is why registrations should go through a registry.
/** 闭包适配器上下文大小 24 字节。
 * @en The closure-adapter context size, 24 bytes.
 */
const kAsterCnAdapterContextSize: i32 = 24;
/** 闭包适配器复用池槽数 256。
 * @en The closure-adapter reuse pool size, 256 slots.
 */
const kAsterCnAdapterPoolSlots: i32 = 256;
/** 适配器复用池基址。
 * @en The base address of the adapter reuse pool.
 */
let aster_cn_adapter_pool_base: ptr = 0;
/** 适配器复用池空闲链表头。
 * @en The head of the adapter pool's free list.
 */
let aster_cn_adapter_free_head: ptr = 0;

/** 从复用池取一个 24 字节闭包适配器槽，失败返回 0。
 * @en Take a 24-byte closure-adapter slot from the reuse pool; return 0 on failure.
 */
fn aster_cn_adapter_alloc() : ptr {
    if (aster_cn_adapter_pool_base == 0) {
        let base: ptr = alloc(kAsterCnAdapterContextSize * kAsterCnAdapterPoolSlots);
        if (base == 0) { return 0; }
        aster_cn_adapter_pool_base = base;
        let i: i32 = 0;
        while (i < kAsterCnAdapterPoolSlots - 1) {
            store_i64(base + i * kAsterCnAdapterContextSize, i64(base + (i + 1) * kAsterCnAdapterContextSize));
            i = i + 1;
        }
        store_i64(base + (kAsterCnAdapterPoolSlots - 1) * kAsterCnAdapterContextSize, 0);
        aster_cn_adapter_free_head = base;
    }
    if (aster_cn_adapter_free_head != 0) {
        let p: ptr = aster_cn_adapter_free_head;
        aster_cn_adapter_free_head = ptr(load_i64(p));
        return p;
    }
    return alloc(kAsterCnAdapterContextSize);
}

/** 把适配器槽还给复用池，成功返回 1，池外或已释放返回 0。
 * @en Return an adapter slot to the pool; return 1 on success, 0 for a null, foreign or already-freed slot.
 */
fn aster_cn_adapter_free(p: ptr) : i32 {
    if (p == 0) { return 0; }
    if (aster_cn_adapter_pool_base == 0) { return 0; }
    let off: i64 = i64(p) - i64(aster_cn_adapter_pool_base);
    if (off < 0 || off >= i64(kAsterCnAdapterContextSize) * i64(kAsterCnAdapterPoolSlots) || off % i64(kAsterCnAdapterContextSize) != 0) { return 0; }
    let cur: ptr = aster_cn_adapter_free_head;
    while (cur != 0) {
        if (cur == p) { return 0; }
        cur = ptr(load_i64(cur));
    }
    store_i64(p, i64(aster_cn_adapter_free_head));
    aster_cn_adapter_free_head = p;
    return 1;
}

// --- a byte buffer -------------------------------------------------------
// `Buf` is a pointer/length/capacity triple. It lives in the caller's storage
// (or in the arena), so a program decides where its buffers are; passing
// `ptr<Buf>` keeps the ABI to one register.

/** 字节缓冲，指针、长度与容量的三元组。
 * @en A byte buffer, a triple of pointer, length and capacity.
 */
struct Buf { data: ptr, count: i32, cap: i32 }

/** 初始化 Buf，分配至少 16 字节并把首字节写 NUL，失败返回 -1。
 * @en Initialise a Buf, allocating at least 16 bytes and writing NUL to the first byte; return -1 on failure.
 */
fn buf_init(b: ptr<Buf>, cap: i32) : i32 {
    let want: i32 = cap < 16 ? 16 : cap;
    b.data = alloc(want);
    if (b.data == 0) { return 0 - 1; }
    b.count = 0;
    b.cap = want;
    store_u8(b.data, 0);
    return 0;
}

/** 清空 Buf 的字段，不归还 arena，返回 0。
 * @en Clear a Buf's fields without returning memory to the arena; return 0.
 */
fn buf_free(b: ptr<Buf>) : i32 {
    b.data = 0;
    b.count = 0;
    b.cap = 0;
    return 0;
}

/** 保证 Buf 有 count+extra+1 的容量，不够时加倍，失败返回 -1。
 * @en Guarantee a Buf room for count+extra+1 bytes, doubling when short; return -1 on failure.
 */
fn buf_reserve(b: ptr<Buf>, extra: i32) : i32 {
    let need: i32 = b.count + extra + 1;
    if (need <= b.cap) { return 0; }
    let want: i32 = b.cap * 2;
    let cap: i32 = want < need ? need : want;
    let bigger: ptr = ralloc(b.data, b.cap, cap);
    if (bigger == 0) { return 0 - 1; }
    b.data = bigger;
    b.cap = cap;
    return 0;
}

/** 向 Buf 追加 n 字节并补 NUL，失败返回 -1，否则返回新 count。
 * @en Append n bytes to a Buf and add NUL; return -1 on failure, the new count otherwise.
 */
fn buf_append(b: ptr<Buf>, s: ptr<u8>, n: i32) : i32 {
    if (n <= 0) { return b.count; }
    if (buf_reserve(b, n) != 0) { return 0 - 1; }
    let i: i32 = 0;
    while (i < n) {
        store_u8(b.data + b.count + i, load_u8(s + i));
        i = i + 1;
    }
    b.count = b.count + n;
    store_u8(b.data + b.count, 0);
    return b.count;
}

/** 向 Buf 追加整个 NUL 结尾串。
 * @en Append a whole NUL-terminated string to a Buf.
 */
fn buf_appends(b: ptr<Buf>, s: ptr<u8>) : i32 { return buf_append(b, s, strlen(s)); }

/** 向 Buf 追加一个字节并补 NUL，失败返回 -1，否则返回新 count。
 * @en Append one byte to a Buf and add NUL; return -1 on failure, the new count otherwise.
 */
fn buf_putc(b: ptr<Buf>, c: i32) : i32 {
    if (buf_reserve(b, 1) != 0) { return 0 - 1; }
    store_u8(b.data + b.count, c & 255);
    b.count = b.count + 1;
    store_u8(b.data + b.count, 0);
    return b.count;
}

/** 把 Buf 的 count 置 0 并保留容量，返回 0。
 * @en Set a Buf's count to 0 while keeping its capacity; return 0.
 */
fn buf_reset(b: ptr<Buf>) : i32 {
    b.count = 0;
    if (b.data != 0) { store_u8(b.data, 0); }
    return 0;
}

// buf_cstr(b): NUL terminate in place and hand back the bytes, so a buffer can
// be passed to any `ptr<u8>` consumer.
/** 原地补 NUL 并交回 Buf 的字节指针，data 为 0 时返回 0。
 * @en Add NUL in place and hand back the Buf's byte pointer; return 0 when data is 0.
 */
fn buf_cstr(b: ptr<Buf>) : ptr<u8> {
    if (b.data == 0) { return 0; }
    store_u8(b.data + b.count, 0);
    return b.data;
}

// --- integer and pointer vectors -----------------------------------------
// No generics, so the two element kinds the compiler needs are concrete types
// built the same way: a length, a capacity, and a block of elements.

/** i32 向量，指针、长度与容量的三元组。
 * @en An i32 vector, a triple of pointer, length and capacity.
 */
struct Vec32 { data: ptr, count: i32, cap: i32 }
/** 指针向量，指针、长度与容量的三元组。
 * @en A pointer vector, a triple of pointer, length and capacity.
 */
struct VecPtr { data: ptr, count: i32, cap: i32 }

/** 初始化 Vec32，分配至少 8 个元素，失败返回 -1。
 * @en Initialise a Vec32, allocating at least 8 elements; return -1 on failure.
 */
fn vec32_init(v: ptr<Vec32>, cap: i32) : i32 {
    let want: i32 = cap < 8 ? 8 : cap;
    v.data = alloc(want * 4);
    if (v.data == 0) { return 0 - 1; }
    v.count = 0;
    v.cap = want;
    return 0;
}
/** 清空 Vec32 的字段，返回 0。
 * @en Clear a Vec32's fields; return 0.
 */
fn vec32_free(v: ptr<Vec32>) : i32 { v.data = 0; v.count = 0; v.cap = 0; return 0; }
/** 向 Vec32 追加一个 i32，满时容量翻倍，失败返回 -1，否则返回新 count。
 * @en Push an i32 onto a Vec32, doubling capacity when full; return -1 on failure, the new count otherwise.
 */
fn vec32_push(v: ptr<Vec32>, x: i32) : i32 {
    if (v.count >= v.cap) {
        let bigger: ptr = ralloc(v.data, v.cap * 4, v.cap * 8);
        if (bigger == 0) { return 0 - 1; }
        v.data = bigger;
        v.cap = v.cap * 2;
    }
    // An element is 4 bytes: a 64-bit store here would clobber the next one.
    *(v.data + v.count * 4) = x;
    v.count = v.count + 1;
    return v.count;
}
/** 返回 Vec32 第 i 个元素，越界返回 0。
 * @en Return element i of a Vec32; return 0 when out of bounds.
 */
fn vec32_get(v: ptr<Vec32>, i: i32) : i32 {
    if (i < 0 || i >= v.count) { return 0; }
    return *(v.data + i * 4);
}
/** 设置 Vec32 第 i 个元素，越界返回 -1，成功返回 x。
 * @en Set element i of a Vec32; return -1 when out of bounds, x on success.
 */
fn vec32_set(v: ptr<Vec32>, i: i32, x: i32) : i32 {
    if (i < 0 || i >= v.count) { return 0 - 1; }
    // 4 bytes, like the push: a 64-bit store would clobber the next element.
    *(v.data + i * 4) = x;
    return x;
}

/** 初始化 VecPtr，分配至少 8 个元素，失败返回 -1。
 * @en Initialise a VecPtr, allocating at least 8 elements; return -1 on failure.
 */
fn vecptr_init(v: ptr<VecPtr>, cap: i32) : i32 {
    let want: i32 = cap < 8 ? 8 : cap;
    v.data = alloc(want * 8);
    if (v.data == 0) { return 0 - 1; }
    v.count = 0;
    v.cap = want;
    return 0;
}
/** 清空 VecPtr 的字段，返回 0。
 * @en Clear a VecPtr's fields; return 0.
 */
fn vecptr_free(v: ptr<VecPtr>) : i32 { v.data = 0; v.count = 0; v.cap = 0; return 0; }
/** 向 VecPtr 追加一个指针，满时容量翻倍，失败返回 -1，否则返回新 count。
 * @en Push a pointer onto a VecPtr, doubling capacity when full; return -1 on failure, the new count otherwise.
 */
fn vecptr_push(v: ptr<VecPtr>, x: ptr) : i32 {
    if (v.count >= v.cap) {
        let bigger: ptr = ralloc(v.data, v.cap * 8, v.cap * 16);
        if (bigger == 0) { return 0 - 1; }
        v.data = bigger;
        v.cap = v.cap * 2;
    }
    store_i64(v.data + v.count * 8, i64(x));
    v.count = v.count + 1;
    return v.count;
}
/** 返回 VecPtr 第 i 个元素，越界返回 0。
 * @en Return element i of a VecPtr; return 0 when out of bounds.
 */
fn vecptr_get(v: ptr<VecPtr>, i: i32) : ptr {
    if (i < 0 || i >= v.count) { return 0; }
    return ptr(load_i64(v.data + i * 8));
}
/** 设置 VecPtr 第 i 个元素，越界返回 -1，成功返回 0。
 * @en Set element i of a VecPtr; return -1 when out of bounds, 0 on success.
 */
fn vecptr_set(v: ptr<VecPtr>, i: i32, x: ptr) : i32 {
    if (i < 0 || i >= v.count) { return 0 - 1; }
    store_i64(v.data + i * 8, i64(x));
    return 0;
}

// --- diagnostics ---------------------------------------------------------
// There is no `exit` intrinsic: a program leaves through `main`'s return. So
// `panic` reports on stderr and answers the code the caller should return.
/** 把串写到 stderr，返回写了多少字节。
 * @en Write a string to stderr; return the bytes written.
 */
fn eputs(s: ptr<u8>) : i32 { return write_all(2, s, strlen(s)); }

// No string literal here on purpose: a literal becomes an object symbol with a
// per-file counter (`__aster_string_0`), so a library carrying one would collide
// at link time with every consumer that carries its own. The prefix and the
// newline are assembled in bytes instead — see the note in
// docs/language-reference.md and audit A-25.
/** 向 stderr 写 aster: 加消息并换行，返回 1。
 * @en Write "aster: " plus a message and a newline to stderr; return 1.
 */
fn panic(msg: ptr<u8>) : i32 {
    let prefix: u8[8] = 0;
    store_u8(prefix, 97);      // 'a'
    store_u8(prefix + 1, 115); // 's'
    store_u8(prefix + 2, 116); // 't'
    store_u8(prefix + 3, 101); // 'e'
    store_u8(prefix + 4, 114); // 'r'
    store_u8(prefix + 5, 58);  // ':'
    store_u8(prefix + 6, 32);  // ' '
    store_u8(prefix + 7, 0);
    let nl: u8[2] = 0;
    store_u8(nl, 10);
    write_all(2, prefix, 7);
    write_all(2, msg, strlen(msg));
    write_all(2, nl, 1);
    return 1;
}

// ===========================================================================
// v0.23.77-dev: the basic library, second slice — the conversions and the
// string helpers a front end actually needs, and that the first slice left
// as 32-bit-only or absent.
//
// The conventions are the library's own: a byte buffer is `ptr<u8>`, a value
// that does not fit a return register is written through an out-parameter,
// and a failure is a sentinel (-1 for "consumed nothing", 0 for "null
// pointer") rather than a status enum the caller has to decode.
// ===========================================================================

// fmt_i64(buf, v): decimal i64, NUL terminated. `utoa` takes an i64 but a
// magnitude is unsigned: INT64_MIN's absolute value is 2^63, which no i64
// holds, so the digits are produced in u64 arithmetic.
/** 把 i64 写成十进制并补 NUL，返回字符数。
 * @en Write an i64 as decimal with a NUL terminator; return the character count.
 */
fn fmt_i64(buf: ptr<u8>, v: i64) : i32 {
    let at: i32 = 0;
    let mag: u64 = 0;
    if (v < 0) {
        store_u8(buf, 45);                 // '-'
        at = 1;
        mag = u64(0) - u64(v);
    } else {
        mag = u64(v);
    }
    let tmp: u8[24] = 0;
    let i: i32 = 0;
    if (mag == 0) {
        store_u8(tmp, 48);
        i = 1;
    }
    while (mag > 0) {
        store_u8(tmp + i, 48 + i32(mag % 10));
        mag = mag / 10;
        i = i + 1;
    }
    let j: i32 = i;
    while (j > 0) {
        j = j - 1;
        store_u8(buf + at, load_u8(tmp + j));
        at = at + 1;
    }
    store_u8(buf + at, 0);
    return at;
}

// fmt_hex64(buf, v): exactly sixteen lowercase hex digits, NUL terminated.
// The two halves go through `fmt_hex`, which already clamps to eight.
/** 把 i64 写成恰好 16 位小写十六进制，返回 16。
 * @en Write an i64 as exactly 16 lower-case hex digits; return 16.
 */
fn fmt_hex64(buf: ptr<u8>, v: i64) : i32 {
    let hi: i32 = i32(i64(u64(v) >> u64(32)));
    let lo: i32 = i32(v);
    fmt_hex(buf, hi, 8);
    fmt_hex(buf + 8, lo, 8);
    return 16;
}

// digit_value(c): 0..35 for 0-9 / a-z / A-Z, -1 for anything else.
/** 把 0-9/a-z/A-Z 映射为 0..35，其余返回 -1。
 * @en Map 0-9/a-z/A-Z to 0..35; return -1 for anything else.
 */
fn digit_value(c: i32) : i32 {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 122) { return c - 87; }
    if (c >= 65 && c <= 90) { return c - 55; }
    return 0 - 1;
}

// strtoi(s, base, out): the integer in s read in `base` (2..36, or 0 for
// "auto": 0x/0X hex, 0b/0B binary, otherwise decimal), with leading whitespace and
// an optional sign. The value is written through `out` as an i64; the answer is
// the number of bytes consumed, or -1 when there was no digit at all. Reading
// stops at the first character that is not a digit of the base, exactly as
// strtol does.
/** 按 base 读整数并把 i64 值写进 out，返回消费字节数，无数字返回 -1。
 * @en Read an integer in the given base and store the i64 value in out; return the bytes consumed, -1 when no digits were read.
 */
fn strtoi(s: ptr<u8>, base: i32, out: ptr<u8>) : i32 {
    let i: i32 = 0;
    let b: i32 = base;
    if (b != 0 && (b < 2 || b > 36)) { return 0 - 1; }
    while (is_space(load_u8(s + i))) { i = i + 1; }
    let neg: i32 = 0;
    let ch: i32 = load_u8(s + i);
    if (ch == 45) { neg = 1; i = i + 1; }
    else if (ch == 43) { i = i + 1; }
    if (b == 0) {
        if (load_u8(s + i) == 48 && (load_u8(s + i + 1) == 120 || load_u8(s + i + 1) == 88)) { b = 16; i = i + 2; }
        else if (load_u8(s + i) == 48 && (load_u8(s + i + 1) == 98 || load_u8(s + i + 1) == 66)) { b = 2; i = i + 2; }
        else { b = 10; }
    } else if (b == 16) {
        if (load_u8(s + i) == 48 && (load_u8(s + i + 1) == 120 || load_u8(s + i + 1) == 88)) { i = i + 2; }
    }
    let v: i64 = 0;
    let digits: i32 = 0;
    while (1) {
        let c: i32 = load_u8(s + i);
        if (c == 0) { break; }
        let d: i32 = digit_value(c);
        if (d < 0 || d >= b) { break; }
        v = v * i64(b) + i64(d);
        digits = digits + 1;
        i = i + 1;
    }
    if (digits == 0) { return 0 - 1; }
    if (neg) { v = 0 - v; }
    store_i64(out, v);
    return i;
}

// atof(s, out): the double in s — digits, an optional fraction, an optional
// exponent — written through `out` (a `ptr<f64>`, because a double cannot be
// stored through a byte pointer without reinterpreting its bits, which the
// language does not do). Answers the bytes consumed, or -1 with no digits.
/** 读 double 并写进 out，返回消费字节数，无数字返回 -1。
 * @en Read a double and store it in out; return the bytes consumed, -1 when no digits were read.
 */
fn atof(s: ptr<u8>, out: ptr<f64>) : i32 {
    let i: i32 = 0;
    while (is_space(load_u8(s + i))) { i = i + 1; }
    let neg: i32 = 0;
    let ch: i32 = load_u8(s + i);
    if (ch == 45) { neg = 1; i = i + 1; }
    else if (ch == 43) { i = i + 1; }
    let v: f64 = 0.0;
    let seen: i32 = 0;
    while (1) {
        let c: i32 = load_u8(s + i);
        if (c < 48 || c > 57) { break; }
        v = v * 10.0 + f64(c - 48);
        seen = seen + 1;
        i = i + 1;
    }
    if (load_u8(s + i) == 46) {
        i = i + 1;
        let scale: f64 = 0.1;
        while (1) {
            let c: i32 = load_u8(s + i);
            if (c < 48 || c > 57) { break; }
            v = v + f64(c - 48) * scale;
            scale = scale * 0.1;
            seen = seen + 1;
            i = i + 1;
        }
    }
    if (seen == 0) { return 0 - 1; }
    let e: i32 = load_u8(s + i);
    if (e == 101 || e == 69) {
        let j: i32 = i + 1;
        let eneg: i32 = 0;
        let sc: i32 = load_u8(s + j);
        if (sc == 45) { eneg = 1; j = j + 1; }
        else if (sc == 43) { j = j + 1; }
        let exp: i32 = 0;
        let ed: i32 = 0;
        while (1) {
            let c: i32 = load_u8(s + j);
            if (c < 48 || c > 57) { break; }
            // Clamp the exponent at 1000: the digits are still consumed and
            // counted, but the multiplier loop below stays bounded, and a
            // clamped exponent overflows 10^exp to inf exactly when C's
            // strtod overflows (exp > 308). Without the clamp the i32
            // accumulator wraps negative and the loop runs zero times,
            // silently returning 1.0 for "1e999999999999".
            if (exp < 1000) { exp = exp * 10 + (c - 48); if (exp > 1000) { exp = 1000; } }
            ed = ed + 1;
            j = j + 1;
        }
        if (ed > 0) {
            let mult: f64 = 1.0;
            let k: i32 = 0;
            while (k < exp) { mult = mult * 10.0; k = k + 1; }
            // Skip the multiply/divide for a zero mantissa: 0.0 * inf is
            // NaN, but C's strtod gives 0.0 for "0e999".
            if (v != 0.0) {
                if (eneg) { v = v / mult; } else { v = v * mult; }
            }
            i = j;
        }
    }
    if (neg) { v = 0.0 - v; }
    *(out) = v;
    return i;
}

// --- strings -------------------------------------------------------------

// streq(a, b): 1 when the two NUL-terminated strings are equal.
/** 两串相等返回 1，否则返回 0。
 * @en Return 1 when the two strings are equal, 0 otherwise.
 */
fn streq(a: ptr<u8>, b: ptr<u8>) : i32 { return strcmp(a, b) == 0 ? 1 : 0; }

/** s 以 p 开头返回 1，否则返回 0。
 * @en Return 1 when s starts with p, 0 otherwise.
 */
fn starts_with(s: ptr<u8>, p: ptr<u8>) : i32 {
    let n: i32 = strlen(p);
    if (n > strlen(s)) { return 0; }
    return strncmp(s, p, n) == 0 ? 1 : 0;
}

/** s 以 suf 结尾返回 1，否则返回 0。
 * @en Return 1 when s ends with suf, 0 otherwise.
 */
fn ends_with(s: ptr<u8>, suf: ptr<u8>) : i32 {
    let n: i32 = strlen(suf);
    let m: i32 = strlen(s);
    if (n > m) { return 0; }
    return strcmp(s + (m - n), suf) == 0 ? 1 : 0;
}

// trim(s): strip leading and trailing spaces *in place* (the string must be
// writable — not a literal) and answer the first non-space byte. Tabs are left
// alone: a tab inside a line is data, and this helper is for configuration-
// and source-shaped text.
/** 原地去首尾空格，只去空格不管 Tab，返回首个非空格字节处。
 * @en Strip leading and trailing spaces in place (spaces only, not Tab); return the first non-space byte.
 */
fn trim(s: ptr<u8>) : ptr<u8> {
    let i: i32 = 0;
    while (load_u8(s + i) == 32) { i = i + 1; }
    let n: i32 = strlen(s + i);
    while (n > 0) {
        if (load_u8(s + i + n - 1) != 32) { break; }
        n = n - 1;
    }
    store_u8(s + i + n, 0);
    return s + i;
}

// next_line(line): the line after this one, or 0 at the end of the text. The
// newline is replaced by a NUL and a preceding carriage return is stripped, so
// a CRLF file iterates like an LF one:
//
//     let ln: ptr = text;
//     while (ln != 0) { use(ln); ln = next_line(ln); }
/** 返回下一行首地址，行尾返回 0，换行符被改写为 NUL。
 * @en Return the address of the next line, 0 at the end; the newline is rewritten to NUL.
 */
fn next_line(line: ptr<u8>) : ptr<u8> {
    let i: i32 = 0;
    while (1) {
        let c: i32 = load_u8(line + i);
        if (c == 0) {
            if (i > 0 && load_u8(line + i - 1) == 13) { store_u8(line + i - 1, 0); }
            return 0;
        }
        if (c == 10) {
            if (i > 0 && load_u8(line + i - 1) == 13) { store_u8(line + i - 1, 0); }
            else { store_u8(line + i, 0); }
            return line + i + 1;
        }
        i = i + 1;
    }
    return 0;
}

// to_upper(s): ASCII letters to uppercase *in place* (the buffer must be
// writable), answering s.
/** 原地把 ASCII 字母转大写，返回 s。
 * @en Convert ASCII letters to upper case in place; return s.
 */
fn to_upper(s: ptr<u8>) : ptr<u8> {
    let i: i32 = 0;
    while (1 == 1) {
        let ch: i32 = load_u8(s + i);
        if (ch == 0) { return s; }
        if (ch >= 97 && ch <= 122) { store_u8(s + i, ch - 32); }
        i = i + 1;
    }
    return s;
}

// to_lower(s): ASCII letters to lowercase in place, answering s.
/** 原地把 ASCII 字母转小写，返回 s。
 * @en Convert ASCII letters to lower case in place; return s.
 */
fn to_lower(s: ptr<u8>) : ptr<u8> {
    let i: i32 = 0;
    while (1 == 1) {
        let ch: i32 = load_u8(s + i);
        if (ch == 0) { return s; }
        if (ch >= 65 && ch <= 90) { store_u8(s + i, ch + 32); }
        i = i + 1;
    }
    return s;
}

// strrchr(s, c): the index of the LAST c in s, or -1. `strchr`'s companion; the
// terminator is not searched, matching C.
/** 返回最后一个 c 的下标，不搜终结符，找不到返回 -1。
 * @en Return the index of the last c; the terminator is not searched; return -1 when not found.
 */
fn strrchr(s: ptr<u8>, c: i32) : i32 {
    let want: i32 = c & 255;
    let i: i32 = 0;
    let last: i32 = 0 - 1;
    while (1 == 1) {
        let ch: i32 = load_u8(s + i);
        if (ch == 0) { return last; }
        if (ch == want) { last = i; }
        i = i + 1;
    }
    return last;
}

// f64_from_dec(digits, exp10): the IEEE-754 bit pattern of digits * 10^exp10,
// for a non-negative value - the step a decimal literal like 3.14 needs. Like
// f64_bits it is integer-only, because the bootstrap stage has no float type.
//
// The mantissa is kept in a u64 and renormalized after every power of ten, with
// the bits that fall off OR-ed into `sticky`. Ten steps of headroom keep the
// shift from overflowing: 10^2 < 2^7, so 2^54 * 10^2 still fits.
//
// Rounding is one decision at the end - round-half-to-even over
// (kept, dropped, sticky) - rather than a rounding at every step, which is what
// makes the result the nearest double instead of an accumulation of ties.
/** 用纯整数运算算 digits * 10^exp10 的 IEEE-754 binary64 位模式。
 * @en Compute the IEEE-754 binary64 bit pattern of digits * 10^exp10 using pure integer arithmetic.
 */
fn f64_from_dec(digits: u64, exp10: i32) : i64 {
    if (digits == 0) { return 0; }
    // A 128-bit window, not 64. The reason is measurable: with 53 bits kept and
    // a 64-bit window a division leaves only four bits of headroom, so a chain
    // of them drifts - 1e-22 came out one ulp low. A 128-bit window puts the
    // per-step truncation at 2^-124, and 300 steps still cannot reach the
    // rounding cutoff.
    let hi: u64 = 0;
    let lo: u64 = digits;
    let k: i32 = 0;
    let sticky: i32 = 0;
    // normalize until hi's top bit is set: the window is full
    while (hi < 9223372036854775808) {
        hi = (hi << 1) | (lo >> 63);
        lo = lo << 1;
        k = k - 1;
    }
    let p: i32 = exp10;
    let step: i32 = 0;
    while (step < p) {
        // room for *10, dropping the top bits of the window into `sticky`
        while (hi >= 1152921504606846976) {
            // order matters: lo takes hi's last bit, so hi must not move first
            if ((lo & 1) == 1) { sticky = 1; }
            lo = (lo >> 1) | ((hi & 1) << 63);
            hi = hi >> 1;
            k = k + 1;
        }
        // (hi:lo) * 10, split so nothing overflows: lo*8 + lo*2 with carries
        let c3: u64 = lo >> 61;
        let c1: u64 = lo >> 63;
        let a: u64 = lo << 3;
        let b: u64 = lo << 1;
        let sl: u64 = a + b;
        let ov: u64 = 0;
        if (sl < a) { ov = 1; }
        lo = sl;
        // floor(lo*10 / 2^64) is (lo>>61) + (lo>>63) + the add's carry -
        // each already counts whole 2^64 blocks, so neither is scaled again
        hi = hi * 10 + c3 + c1 + ov;
        step = step + 1;
    }
    while (step > p) {
        // (hi:lo) / 10 - long division, sixty-four bits at a time. The remainder
        // never exceeds nine, so `rem * 2 + 1` always fits.
        let qhi: u64 = hi / 10;
        let rem: u64 = hi - qhi * 10;
        let qlo: u64 = 0;
        let bit: i32 = 63;
        while (bit >= 0) {
            rem = rem * 2 + ((lo >> bit) & 1);
            qlo = qlo << 1;
            if (rem >= 10) {
                rem = rem - 10;
                qlo = qlo | 1;
            }
            bit = bit - 1;
        }
        if (rem != 0) { sticky = 1; }
        hi = qhi;
        lo = qlo;
        // refill the window: a division leaves its top bits empty
        while (hi < 9223372036854775808) {
            hi = (hi << 1) | (lo >> 63);
            lo = lo << 1;
            k = k - 1;
        }
        step = step - 1;
    }
    // refill the window one last time: the multiplication loop leaves hi
    // anywhere below 2^64, and the 53 bits are taken from its top
    while (hi < 9223372036854775808) {
        hi = (hi << 1) | (lo >> 63);
        lo = lo << 1;
        k = k - 1;
    }
    // one rounding decision: keep 53 bits, look at the next one, and take
    // `sticky` (plus everything below) as the tie-breaker
    let kept: u64 = hi >> 11;
    let roundbit: u64 = (hi >> 10) & 1;
    let rest: i32 = sticky;
    if ((hi & 1023) != 0) { rest = 1; }
    if (lo != 0) { rest = 1; }
    if (roundbit == 1 && (rest == 1 || (kept & 1) == 1)) { kept = kept + 1; }
    let e: i32 = 52 + k + 75 + 1023;
    if (kept > 9007199254740991) { kept = kept >> 1; e = e + 1; }
    if (e >= 2047) { return 9218868437227405312; }
    // Below the normal range the exponent field would go negative; the subnormal
    // forms are not built here, so those literals answer zero rather than a
    // pattern that is quietly wrong.
    if (e <= 0) { return 0; }
    let eu: u64 = e;
    let bits: u64 = (eu << 52) | (kept - 4503599627370496);
    let out: i64 = bits;
    return out;
}
// f64_bits(m, k): the IEEE-754 binary64 bit pattern of the exact value
// m * 2^k, as an i64 - the piece a decimal-literal converter will end on, and
// useful on its own for hand-built floats. Only integer arithmetic is used,
// which is the whole point: the bootstrap stage has no float type.
//
// Rounding is round-half-to-even, as IEEE-754 requires. Zero answers +0.0, and
// a value this routine cannot represent exactly enough (a magnitude that would
// overflow to infinity, or one that underflows past the subnormal range)
// answers the pattern infinity / zero respectively - the same answers the
// hardware gives.
/** 用纯整数运算算 m * 2^k 的 IEEE-754 binary64 位模式。
 * @en Compute the IEEE-754 binary64 bit pattern of m * 2^k using pure integer arithmetic.
 */
fn f64_bits(m: i64, k: i32) : i64 {
    if (m == 0) { return 0; }
    let neg: i32 = 0;
    // No casts here: the subset has none. Assigning an i64 to a u64 keeps its
    // bits, which is exactly the reinterpretation wanted.
    let a: u64 = m;
    if (m < 0) {
        neg = 1;
        a = 0 - m;
    }
    // The highest set bit: a value's binary exponent before normalization.
    let top: i32 = 0;
    let probe: u64 = a;
    while (probe > 1) {
        probe = probe >> 1;
        top = top + 1;
    }
    // A value of 1..2 times 2^(top+k). The biased exponent is that plus 1023,
    // and the fraction field wants 52 bits below the leading one.
    let e: i32 = top + k + 1023;
    let one: u64 = 1;
    if (e <= 0) {
        // Subnormal or zero: the fraction field is the value scaled by 2^1074,
        // rounded half-to-even. Below half of the smallest subnormal the
        // answer is zero, as the hardware gives.
        let s: i32 = k + 1074;
        let m2: u64 = 0;
        if (s >= 0) {
            m2 = a << s;
        } else {
            let drop: i32 = 0 - s;
            if (drop == 64) {
                if (a > 9223372036854775808) { m2 = 1; }
            } else if (drop < 64) {
                m2 = a >> drop;
                let rest: u64 = a - (m2 << drop);
                let half: u64 = one << (drop - 1);
                if (rest > half) {
                    m2 = m2 + 1;
                } else if (rest == half) {
                    if ((m2 & 1) == 1) { m2 = m2 + 1; }
                }
            }
        }
        if (m2 >= 4503599627370496) {
            // Rounded up to the smallest normal: exponent field 1, fraction 0.
            let nbits: u64 = 4503599627370496;
            if (neg == 1) { nbits = nbits | (one << 63); }
            let nout: i64 = nbits;
            return nout;
        }
        if (m2 == 0) { return 0; }
        // Subnormal: exponent field 0, fraction m2.
        if (neg == 1) { m2 = m2 | (one << 63); }
        let sout: i64 = m2;
        return sout;
    }
    let mant: u64 = 0;
    if (top <= 52) {
        // exact: shift the bits up into the 53-bit form, drop the leading one
        mant = (a << (52 - top)) & 4503599627370495;
    } else {
        let drop: i32 = top - 52;
        mant = a >> drop;
        // the bits that fall off decide the rounding
        let rest: u64 = a - (mant << drop);
        let half: u64 = one << (drop - 1);
        if (rest > half) {
            mant = mant + 1;
        } else if (rest == half) {
            if ((mant & 1) == 1) { mant = mant + 1; }
        }
        // Only a carry past all 53 bits moves the exponent: the leading one
        // is dropped by the mask below, never shifted into the exponent.
        if (mant > 9007199254740991) {
            mant = mant >> 1;
            e = e + 1;
        }
        mant = mant & 4503599627370495;
    }
    if (e >= 2047) {
        // overflow: infinity, which is what the hardware would answer
        if (neg == 1) { return 0 - 4503599627370496; }
        return 9218868437227405312;
    }
    let eu: u64 = e;
    let bits: u64 = (eu << 52) | mant;
    // The sign is a bit, not a negation: negating the bit pattern as an
    // integer only coincides with flipping the sign bit when the exponent
    // field is 1024 and the fraction is zero.
    if (neg == 1) { bits = bits | (one << 63); }
    let out: i64 = bits;
    return out;
}

// utf8_encode(cp, buf): write the UTF-8 form of code point cp into buf and
// answer the bytes written (1..4). Answers 0 - writing nothing - for a value
// that is not a code point (negative, above U+10FFFF, or a surrogate).
/** 把码点写成 UTF-8，返回写了多少字节，非码点返回 0。
 * @en Write a code point as UTF-8; return the bytes written, 0 for a non-code-point.
 */
fn utf8_encode(cp: i32, buf: ptr<u8>) : i32 {
    if (cp < 0) { return 0; }
    if (cp > 1114111) { return 0; }
    if (cp >= 55296 && cp <= 57343) { return 0; }
    if (cp < 128) {
        store_u8(buf, cp);
        return 1;
    }
    if (cp < 2048) {
        store_u8(buf, 192 + cp / 64);
        store_u8(buf + 1, 128 + cp % 64);
        return 2;
    }
    if (cp < 65536) {
        store_u8(buf, 224 + cp / 4096);
        store_u8(buf + 1, 128 + cp / 64 % 64);
        store_u8(buf + 2, 128 + cp % 64);
        return 3;
    }
    store_u8(buf, 240 + cp / 262144);
    store_u8(buf + 1, 128 + cp / 4096 % 64);
    store_u8(buf + 2, 128 + cp / 64 % 64);
    store_u8(buf + 3, 128 + cp % 64);
    return 4;
}

// utf8_decode(s, at): the code point whose first byte is s[at], or -1 when the
// bytes there are not a valid sequence (an unexpected continuation byte, a
// truncated sequence, an overlong form, or a surrogate).
/** 返回 s[at] 处首字节的码点，非法序列返回 -1。
 * @en Return the code point of the first byte at s[at]; return -1 for an illegal sequence.
 */
fn utf8_decode(s: ptr<u8>, at: i32) : i32 {
    let b0: i32 = load_u8(s + at);
    if (b0 < 128) {
        if (b0 == 0) { return 0 - 1; }
        return b0;
    }
    if (b0 < 194) { return 0 - 1; }
    if (b0 < 224) {
        let b1: i32 = load_u8(s + at + 1);
        if (b1 / 64 != 2) { return 0 - 1; }
        return (b0 - 192) * 64 + (b1 - 128);
    }
    if (b0 < 240) {
        let c1: i32 = load_u8(s + at + 1);
        let c2: i32 = load_u8(s + at + 2);
        if (c1 / 64 != 2) { return 0 - 1; }
        if (c2 / 64 != 2) { return 0 - 1; }
        let cp3: i32 = (b0 - 224) * 4096 + (c1 - 128) * 64 + (c2 - 128);
        if (cp3 < 2048) { return 0 - 1; }
        if (cp3 >= 55296 && cp3 <= 57343) { return 0 - 1; }
        return cp3;
    }
    if (b0 < 245) {
        let d1: i32 = load_u8(s + at + 1);
        let d2: i32 = load_u8(s + at + 2);
        let d3: i32 = load_u8(s + at + 3);
        if (d1 / 64 != 2) { return 0 - 1; }
        if (d2 / 64 != 2) { return 0 - 1; }
        if (d3 / 64 != 2) { return 0 - 1; }
        let cp4: i32 = (b0 - 240) * 262144 + (d1 - 128) * 4096 + (d2 - 128) * 64 + (d3 - 128);
        if (cp4 < 65536) { return 0 - 1; }
        if (cp4 > 1114111) { return 0 - 1; }
        return cp4;
    }
    return 0 - 1;
}

// utf8_len(s): the number of code points in s - every byte that is not a
// continuation byte (top bits 10) starts one. Bytes are assumed well formed,
// which utf8_decode is there to check.
/** 返回字符串的码点个数，假定字节良构。
 * @en Return the number of code points in a string; the bytes are assumed well-formed.
 */
fn utf8_len(s: ptr<u8>) : i32 {
    let n: i32 = 0;
    let i: i32 = 0;
    while (1 == 1) {
        let b: i32 = load_u8(s + i);
        if (b == 0) { return n; }
        if (b / 64 != 2) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

// i32_abs(v): |v|, without the INT32_MIN trap a naive negate would have -
// the single unrepresentable value answers INT32_MIN, as C's abs() does.
/** 返回绝对值，INT32_MIN 答 INT32_MIN。
 * @en Return the absolute value; INT32_MIN answers INT32_MIN.
 */
fn i32_abs(v: i32) : i32 {
    if (v < 0) { return 0 - v; }
    return v;
}

// memchr(buf, n, c): the index of the first byte equal to c in the first n
// bytes of buf, or -1. Unlike strchr it needs no terminator and stops at n.
/** 在前 n 字节内找首个等于 c 低 8 位的字节下标，找不到返回 -1。
 * @en Find the index of the first byte equal to the low 8 bits of c within the first n bytes; return -1 when not found.
 */
fn memchr(buf: ptr<u8>, n: i32, c: i32) : i32 {
    let want: i32 = c & 255;
    let i: i32 = 0;
    while (i < n) {
        if (load_u8(buf + i) == want) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// strncat(dst, src, room): append at most room bytes of src to dst and
// terminate. The room counts bytes *after* dst's own end, so
// `strncat(d, s, sizeof(d) - strlen(d) - 1)` never overruns.
/** 至多追加 room 字节并补终结符，返回 dst。
 * @en Append at most room bytes plus a terminator; return dst.
 */
fn strncat(dst: ptr<u8>, src: ptr<u8>, room: i32) : ptr<u8> {
    let d: i32 = strlen(dst);
    let i: i32 = 0;
    while (i < room) {
        let ch: i32 = load_u8(src + i);
        if (ch == 0) { break; }
        store_u8(dst + d + i, ch);
        i = i + 1;
    }
    store_u8(dst + d + i, 0);
    return dst;
}

// str_dup(s): a copy of s in the growable arena (0 when the arena refuses).
/** 在 growable arena 里复制一份字符串，arena 拒绝时返回 0。
 * @en Copy a string into the growable arena; return 0 when the arena refuses.
 */
fn str_dup(s: ptr<u8>) : ptr<u8> {
    let n: i32 = strlen(s);
    let p: ptr = alloc(n + 1);
    if (p == 0) { return 0; }
    memcpy(p, s, n);
    store_u8(p + n, 0);
    return p;
}

// ===========================================================================
// v0.23.77-dev: the basic library, third slice — a map with string keys and
// pointer values, and a sort that works on any element width.
//
// The first slice's hash table (v0.23.42-dev) is a fixed 1024-slot table of
// `i64` values; this one is the shape a compiler's symbol table needs: the
// table grows, the value is an address, and a key is whatever the caller
// already owns (the map never copies it).
// ===========================================================================

// --- a map: string keys, pointer values ----------------------------------
// Open addressing with linear probing over a power-of-two table of 16-byte
// entries (key, value). A slot is empty when its key is 0. There is no
// deletion: the arena cannot hand memory back, and a compiler's tables only
// ever grow.

/** 字符串键到指针值的可增长映射表。
 * @en A growable map from string keys to pointer values.
 */
struct Map { ents: ptr, count: i32, cap: i32 }

// A deleted key's slot keeps this in place of the key: linear probing needs a
// *occupied but free* marker, or a delete would break every probe run that
// passed through the slot. `ptr(1)` is not an address any key can have.
/** 返回墓碑标记 ptr(1)，供删除后的探测链继续走过去。
 * @en Return the tombstone marker ptr(1), which lets probe chains walk past a deleted slot.
 */
fn map_tomb() : ptr { return ptr(1); }

/** 初始化 Map，容量取不小于 cap 的 2 的幂且至少 8，失败返回 -1。
 * @en Initialise a Map with capacity the smallest power of two not less than cap, at least 8; return -1 on failure.
 */
fn map_init(m: ptr<Map>, cap: i32) : i32 {
    let want: i32 = cap < 8 ? 8 : cap;
    let p: i32 = 8;
    while (p < want) { p = p * 2; }
    m.ents = alloc(p * 16);
    if (m.ents == 0) { return 0 - 1; }
    m.count = 0;
    m.cap = p;
    return 0;
}

/** 返回 Map 第 i 槽的键，不检查越界。
 * @en Return the key of slot i of a Map; bounds are not checked.
 */
fn map_key_at(m: ptr<Map>, i: i32) : ptr<u8> {
    return ptr<u8>(ptr(load_i64(m.ents + i * 16)));
}
/** 返回 Map 第 i 槽的值，不检查越界。
 * @en Return the value of slot i of a Map; bounds are not checked.
 */
fn map_val_at(m: ptr<Map>, i: i32) : ptr {
    return ptr(load_i64(m.ents + i * 16 + 8));
}

// map_slot: the index holding `key`, or the first empty slot on its probe run.
// map_slot: the index holding `key`, or the first slot a new key may occupy —
// the first tombstone on the probe run when there is one, otherwise the first
// empty slot. `map_find` is the read-only form: it stops at the first empty
// slot and answers -1 for "absent".
/** 返回持有 key 的下标，或新键可占的下标，优先复用首个墓碑。
 * @en Return the index holding key, or the index a new key can take, preferring the first tombstone on the probe chain.
 */
fn map_slot(m: ptr<Map>, key: ptr<u8>) : i32 {
    let mask: i32 = m.cap - 1;
    let i: i32 = i32(hash_str(key) & i64(mask));
    let tomb: i32 = 0 - 1;
    // The probe is bounded to one full circle: a table with no empty slot
    // (live keys plus tombstones filling every slot) would otherwise loop
    // forever. A tombstone found on the run is still a usable slot; with
    // neither a tombstone nor an empty slot there is nowhere to put the
    // key, so the answer is -1 and the caller grows and retries.
    let n: i32 = 0;
    while (n < m.cap) {
        let k: ptr<u8> = map_key_at(m, i);
        if (k == 0) {
            if (tomb >= 0) { return tomb; }
            return i;
        }
        if (k == map_tomb()) {
            if (tomb < 0) { tomb = i; }
        } else if (streq(k, key) == 1) {
            return i;
        }
        i = (i + 1) & mask;
        n = n + 1;
    }
    if (tomb >= 0) { return tomb; }
    return 0 - 1;
}

/** 只读查找持有 key 的下标，不存在返回 -1。
 * @en Read-only lookup of the index holding key; return -1 when absent.
 */
fn map_find(m: ptr<Map>, key: ptr<u8>) : i32 {
    let mask: i32 = m.cap - 1;
    let i: i32 = i32(hash_str(key) & i64(mask));
    // Bounded to one full circle, like map_slot: a table with no empty
    // slot would otherwise loop forever on an absent key. A key that is
    // present is still found (the probe covers every slot); an absent key
    // answers -1, which is this function's contract.
    let n: i32 = 0;
    while (n < m.cap) {
        let k: ptr<u8> = map_key_at(m, i);
        if (k == 0) { return 0 - 1; }
        if (k != map_tomb()) {
            if (streq(k, key) == 1) { return i; }
        }
        i = (i + 1) & mask;
        n = n + 1;
    }
    return 0 - 1;
}

/** 把 Map 容量翻倍并重哈希全部 live 项，失败返回 -1 且旧表不动。
 * @en Double a Map's capacity and rehash every live entry; return -1 on failure with the old table untouched.
 */
fn map_grow(m: ptr<Map>) : i32 {
    let old: ptr = m.ents;
    let oldcap: i32 = m.cap;
    let newcap: i32 = oldcap * 2;
    let n: ptr = alloc(newcap * 16);
    if (n == 0) { return 0 - 1; }
    m.ents = n;
    m.cap = newcap;
    m.count = 0;
    let i: i32 = 0;
    while (i < oldcap) {
        let k: ptr<u8> = ptr<u8>(ptr(load_i64(old + i * 16)));
        // A tombstone is not a live entry: rehashing it would hash the marker
        // address itself (and count it), so only live keys move.
        if (k != 0 && k != map_tomb()) {
            let v: ptr = ptr(load_i64(old + i * 16 + 8));
            let j: i32 = map_slot(m, k);
            store_i64(m.ents + j * 16, i64(k));
            store_i64(m.ents + j * 16 + 8, i64(v));
            m.count = m.count + 1;
        }
        i = i + 1;
    }
    return 0;
}

// map_put(m, key, val): 1 when the key is new, 0 when it replaced a value, -1
// when the arena refused. A smaller val of 0 is still a stored value; only an
// absent key reads back as 0.
/** 向 Map 存入键值，键新返回 1、替换返回 0、失败返回 -1，负载过半时先增长。
 * @en Store a key and value in a Map; return 1 for a new key, 0 for a replacement, -1 on failure; grow first when more than half full.
 */
fn map_put(m: ptr<Map>, key: ptr<u8>, val: ptr) : i32 {
    if (m.ents == 0) {
        if (map_init(m, 8) != 0) { return 0 - 1; }
    }
    if ((m.count + 1) * 2 > m.cap) {
        if (map_grow(m) != 0) { return 0 - 1; }
    }
    let i: i32 = map_slot(m, key);
    if (i < 0) {
        // The table is full of live keys and tombstones (the count-based
        // grow check above does not see tombstones): grow and retry once.
        // Growing drops the tombstones, so the retry finds a slot; if the
        // arena refuses, the answer is -1 as usual.
        if (map_grow(m) != 0) { return 0 - 1; }
        i = map_slot(m, key);
        if (i < 0) { return 0 - 1; }
    }
    let fresh: i32 = 1;
    if (map_key_at(m, i) != 0 && map_key_at(m, i) != map_tomb()) { fresh = 0; }
    store_i64(m.ents + i * 16, i64(key));
    store_i64(m.ents + i * 16 + 8, i64(val));
    if (fresh == 1) { m.count = m.count + 1; }
    return fresh;
}

/** 返回 key 对应的值，不存在返回 0。
 * @en Return the value for key; return 0 when absent.
 */
fn map_get(m: ptr<Map>, key: ptr<u8>) : ptr {
    if (m.ents == 0 || m.count == 0) { return 0; }
    let i: i32 = map_find(m, key);
    if (i < 0) { return 0; }
    return map_val_at(m, i);
}

// map_del(m, key): 1 when the key was there and is gone, 0 when it was not.
// The slot becomes a tombstone - not empty, because a probe run that reached
// this slot has to keep going past it - and the count drops by one. A later
// map_put reuses the tombstone (map_slot prefers the first one on its run).
/** 从 Map 删除 key，在返回 1、不在返回 0，槽变墓碑。
 * @en Delete key from a Map; return 1 when present, 0 when absent; the slot becomes a tombstone.
 */
fn map_del(m: ptr<Map>, key: ptr<u8>) : i32 {
    if (m.ents == 0 || m.count == 0) { return 0; }
    let i: i32 = map_find(m, key);
    if (i < 0) { return 0; }
    store_i64(m.ents + i * 16, i64(map_tomb()));
    store_i64(m.ents + i * 16 + 8, 0);
    m.count = m.count - 1;
    return 1;
}

/** key 在 Map 里返回 1，否则返回 0。
 * @en Return 1 when key is in the Map, 0 otherwise.
 */
fn map_has(m: ptr<Map>, key: ptr<u8>) : i32 {
    if (map_get(m, key) != 0) { return 1; }
    return 0;
}

// --- sorting by element width --------------------------------------------
// `sort_bytes` is the general form: an insertion sort over `count` elements of
// `width` bytes, ordering them with a comparator that takes two element
// addresses and answers <0, 0 or >0 — C's qsort contract, with the comparator
// as a plain function pointer. Insertion sort is the right choice here for the
// reason the language makes it cheap: it is stable, it touches each element
// once in the common (nearly sorted) case, and a compiler's tables are small.
// The element cap is the 256-byte scratch buffer the swap needs.

/** 用比较器对 count 个 width 字节元素做插入排序，width 非法返回 -1。
 * @en Insertion-sort count elements of width bytes with a comparator; return -1 for an illegal width.
 */
fn sort_bytes(base: ptr, count: i32, width: i32, cmp: ptr) : i32 {
    if (width <= 0 || width > 256) { return 0 - 1; }
    if (count < 2) { return count; }
    let tmp: u8[256] = 0;
    let i: i32 = 1;
    while (i < count) {
        memcpy(&tmp, base + i * width, width);
        let j: i32 = i;
        while (j > 0) {
            let prev: ptr = base + (j - 1) * width;
            if (cmp(prev, ptr(&tmp)) <= 0) { break; }
            memmove(base + j * width, prev, width);
            j = j - 1;
        }
        memmove(base + j * width, ptr(&tmp), width);
        i = i + 1;
    }
    return count;
}

// The comparators the typed wrappers use. `*(a)` on a bare ptr reads an i32,
// which is exactly an element of an i32 array.
/** i32 升序比较器。
 * @en An ascending comparator for i32.
 */
fn cmp_i32_asc(a: ptr, b: ptr) : i32 {
    let x: i32 = *(a);
    let y: i32 = *(b);
    if (x < y) { return 0 - 1; }
    if (x > y) { return 1; }
    return 0;
}
/** i64 升序比较器。
 * @en An ascending comparator for i64.
 */
fn cmp_i64_asc(a: ptr, b: ptr) : i32 {
    let x: i64 = load_i64(a);
    let y: i64 = load_i64(b);
    if (x < y) { return 0 - 1; }
    if (x > y) { return 1; }
    return 0;
}
/** u8 升序比较器。
 * @en An ascending comparator for u8.
 */
fn cmp_u8_asc(a: ptr, b: ptr) : i32 {
    let x: i32 = load_u8(a);
    let y: i32 = load_u8(b);
    if (x < y) { return 0 - 1; }
    if (x > y) { return 1; }
    return 0;
}
// An element of a `ptr[N]` is an address; the strings it points at are what a
// caller wants ordered.
/** 字符串升序比较器，比较指针指向的串。
 * @en An ascending comparator for strings, comparing the strings the pointers point to.
 */
fn cmp_str_asc(a: ptr, b: ptr) : i32 {
    let x: ptr<u8> = ptr<u8>(ptr(load_i64(a)));
    let y: ptr<u8> = ptr<u8>(ptr(load_i64(b)));
    return strcmp(x, y);
}

/** 把 i64 数组升序排列。
 * @en Sort an i64 array in ascending order.
 */
fn sort_i64(a: ptr, n: i32) : i32 { return sort_bytes(a, n, 8, ptr(cmp_i64_asc)); }
/** 把 u8 数组升序排列。
 * @en Sort a u8 array in ascending order.
 */
fn sort_u8(a: ptr, n: i32) : i32 { return sort_bytes(a, n, 1, ptr(cmp_u8_asc)); }
/** 把字符串指针数组按指向的串升序排列。
 * @en Sort an array of string pointers in ascending order of the strings they point to.
 */
fn sort_str(a: ptr, n: i32) : i32 { return sort_bytes(a, n, 8, ptr(cmp_str_asc)); }
