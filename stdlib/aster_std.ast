// aster_std.ast — the standard library written in Aster itself: the first
// slice (mem/str/num/hash, v0.23.42-dev), the second (v0.23.77-dev: memmove,
// the C string searches, atoi, the fixed-arity formatters, an integer sort and
// a bump allocator over mmap) and the same release's printing slice
// (fmt_f64/fmt_f32: a double in fixed point — 29 routines in all).
// The original introduction:
//
// the first slice of a standard library written in Aster
// itself: the routines a self-hosting compiler reaches for before it has a
// compiler to build them with (SELFHOSTING-PLAN M2). No libc, no allocator,
// no compiler change — pure Aster over the v0.23.40/41-dev syscall and byte
// intrinsics, delivered as one relocatable object the bootstrap links:
//
//   aster build-obj stdlib/aster_std.ast -o std.o
//   aster build-obj yourapp.ast -o app.o
//   aster link-obj app.o std.o -o app
//
// (include only shares declarations, never bodies — v0.23.13-dev — so a
// library ships as an object, and the consumer declares `extern fn`/`extern
// let`. examples/stdlib_demo.ast is that consumer; tests/stdlib-checks.sh
// diffs every routine against tests/aster-std-twin.c.)
//
// Two idioms carry the whole file:
//
//   * Every byte-buffer parameter is `ptr<u8>`, never bare `ptr`: that
//     spelling is the one that takes BOTH a string literal (whose type is
//     already a ptr to NUL-terminated rodata) and `&arr` of a `u8[N]` (a
//     strided ptr<u8> since v0.23.30-dev). A bare `ptr` parameter refuses
//     `&arr`, and a `ptr[N]` element refuses `&arr` — measured, not assumed.
//   * There are no casts, so a narrowing arrives as an ordinary assignment
//     (`let d: i32 = v % 10;` truncates an i64); only constant initializers
//     are range-checked. Mixed-width arithmetic widens to the wider side, so
//     the FNV loop below stays in i64 without any ceremony.
//
// Everything returns an i32 or an i64 the exit status / a buffer can show —
// there is no void — and every negative answer is a documented sentinel
// (-1), never a trap.

// ===========================================================================
// mem — byte primitives over load_u8/store_u8.
// ===========================================================================

// Copy n bytes, src and dst overlapping is the caller's problem (forward copy
// only, exactly like C's memcpy). Returns n, so a wrong count is observable.
fn memcpy(dst: ptr<u8>, src: ptr<u8>, n: i32) -> i32 {
    let i: i32 = 0;
    while (i < n) {
        store_u8(dst + i, load_u8(src + i));
        i = i + 1;
    }
    return n;
}

// Fill n bytes with c's low 8 bits (store_u8 truncates, as C's unsigned char
// conversion does). Returns n.
fn memset(dst: ptr<u8>, c: i32, n: i32) -> i32 {
    let i: i32 = 0;
    while (i < n) {
        store_u8(dst + i, c);
        i = i + 1;
    }
    return n;
}

// Byte-wise unsigned comparison of the first n bytes: the first differing
// pair's difference, 0 when equal. The unsigned reading matters — a signed
// compare would order 0x80 below 0x7F and flip the answer for high bytes.
fn memcmp(a: ptr<u8>, b: ptr<u8>, n: i32) -> i32 {
    let i: i32 = 0;
    while (i < n) {
        let x: i32 = load_u8(a + i);
        let y: i32 = load_u8(b + i);
        if (x != y) { return x - y; }
        i = i + 1;
    }
    return 0;
}

// ===========================================================================
// str — NUL-terminated text: the identifier and keyword matcher's toolkit.
// ===========================================================================

fn strlen(s: ptr<u8>) -> i32 {
    let i: i32 = 0;
    while (load_u8(s + i) != 0) { i = i + 1; }
    return i;
}

// C's strcmp: first differing byte pair's difference, 0 when equal. Compares
// as unsigned bytes (load_u8 zero-extends), and stops at the NUL both share.
// The loop bound is a guard, not the terminator: every string shorter than a
// million bytes returns from inside, and the tail return only satisfies the
// compiler's fall-through check (while(true) returns are not seen as
// terminating).
fn strcmp(a: ptr<u8>, b: ptr<u8>) -> i32 {
    let i: i32 = 0;
    while (i < 1000000) {
        let x: i32 = load_u8(a + i);
        let y: i32 = load_u8(b + i);
        if (x != y) { return x - y; }
        if (x == 0) { return 0; }
        i = i + 1;
    }
    return 0;
}

// C's strncpy: copy at most n bytes, NUL-pad when src is shorter, no
// terminator when src runs to n or beyond. Returns min(strlen(src), n) — the
// number of source characters actually copied — so a truncation shows up in
// the return value rather than only in the buffer. (The pad loop runs after
// the count is taken: returning its own index would answer n for every
// short source.)
fn strncpy(dst: ptr<u8>, src: ptr<u8>, n: i32) -> i32 {
    let i: i32 = 0;
    while (i < n) {
        let c: i32 = load_u8(src + i);
        store_u8(dst + i, c);
        if (c == 0) { break; }
        i = i + 1;
    }
    let copied: i32 = i;
    while (i < n) {
        store_u8(dst + i, 0);
        i = i + 1;
    }
    return copied;
}

// ===========================================================================
// num — integers to text: ELF fields and diagnostics.
// ===========================================================================

// Reverse the i digits written at buf[0..i) in place, then NUL-terminate.
// Shared by utoa/utohex — the digits come out least-significant first.
fn reverse_digits(buf: ptr<u8>, i: i32) -> i32 {
    let j: i32 = 0;
    let k: i32 = i - 1;
    while (j < k) {
        let t: i32 = load_u8(buf + j);
        store_u8(buf + j, load_u8(buf + k));
        store_u8(buf + k, t);
        j = j + 1;
        k = k - 1;
    }
    store_u8(buf + i, 0);
    return i;
}

// Unsigned decimal (v is read as its value; the caller keeps it >= 0 — the
// signed case is itoa's job). Returns the digit count.
fn utoa(v: i64, buf: ptr<u8>) -> i32 {
    if (v == 0) {
        store_u8(buf, 48);
        store_u8(buf + 1, 0);
        return 1;
    }
    let i: i32 = 0;
    while (v > 0) {
        let d: i32 = v % 10;              // narrowing: i64 -> i32, in range
        store_u8(buf + i, 48 + d);        // '0' + digit
        v = v / 10;
        i = i + 1;
    }
    return reverse_digits(buf, i);
}

// Signed decimal: '-' then the magnitude. The magnitude of i64's most
// negative value is not representable, so that one input is out of contract
// (the twin asserts the same). Returns the character count, sign included.
fn itoa(v: i64, buf: ptr<u8>) -> i32 {
    if (v < 0) {
        store_u8(buf, 45);                // '-'
        return 1 + utoa(-v, buf + 1);
    }
    return utoa(v, buf);
}

// Lowercase hexadecimal, no prefix, no leading zeros ("0" for zero). The
// width an ELF dump wants is the caller's business (pad in the buffer).
// Returns the digit count.
fn utohex(v: i64, buf: ptr<u8>) -> i32 {
    if (v == 0) {
        store_u8(buf, 48);
        store_u8(buf + 1, 0);
        return 1;
    }
    let i: i32 = 0;
    while (v > 0) {
        let d: i32 = v % 16;
        let ch: i32 = 48 + d;             // '0'..'9'
        if (d > 9) { ch = 87 + d; }       // 'a'..'f' (97 - 10)
        store_u8(buf + i, ch);
        v = v / 16;
        i = i + 1;
    }
    return reverse_digits(buf, i);
}

// ===========================================================================
// hash — open addressing over two global arrays: the symbol table / label
// table a bootstrap compiler needs. 1024 slots (a power of two, so the mask
// is an AND), linear probing, an empty slot is key 0, and a key that is
// already present updates its value instead of duplicating.
// ===========================================================================

let hkeys: ptr<u8>[1024] = 0;   // key strings; 0 means empty
let hvals: i64[1024] = 0;   // values, parallel to hkeys

// FNV-1a over the bytes, 64-bit. The offset basis 0xcbf29ce484222325 does
// not fit an i64 literal, so it enters as its two's-complement value
// -3750763034362895579 — the same 64 bits (14695981039346656037 - 2^64).
// Multiplication wraps (two's complement), which is what the hash wants
// anyway.
fn hash_str(s: ptr<u8>) -> i64 {
    let h: i64 = -3750763034362895579;
    let i: i32 = 0;
    while (i < 1000000) {
        let b: i32 = load_u8(s + i);
        if (b == 0) { return h; }
        h = (h ^ b) * 1099511628211;
        i = i + 1;
    }
    return h;
}

// Insert or update: returns the slot index, or -1 when all 1024 slots are
// occupied (a table that full is a bootstrap-scale bug, not a condition to
// grow into — the caller's input was not that large).
fn hash_put(key: ptr<u8>, val: i64) -> i32 {
    let i: i32 = hash_str(key) & 1023;
    let probes: i32 = 0;
    while (probes < 1024) {
        let k: ptr<u8> = hkeys[i];
        if (k == 0) {
            hkeys[i] = key;
            hvals[i] = val;
            return i;
        }
        if (strcmp(k, key) == 0) {
            hvals[i] = val;
            return i;
        }
        i = i + 1;
        if (i == 1024) { i = 0; }
        probes = probes + 1;
    }
    return -1;
}

// Look up: the value, or -1 when absent. Values are therefore non-negative
// by contract — true for the table indices and counts a compiler stores.
fn hash_get(key: ptr<u8>) -> i64 {
    let i: i32 = hash_str(key) & 1023;
    let probes: i32 = 0;
    while (probes < 1024) {
        let k: ptr<u8> = hkeys[i];
        if (k == 0) { return -1; }        // empty slot ends the probe chain
        if (strcmp(k, key) == 0) { return hvals[i]; }
        i = i + 1;
        if (i == 1024) { i = 0; }
        probes = probes + 1;
    }
    return -1;
}

// ===========================================================================
// v0.23.77-dev: the second slice — the routines a command-line tool needs
// before it can be pleasant to write: overlap-safe copy, the string searches
// C programs reach for, an integer parser, fixed-arity formatting (there is no
// variadic call, so formatting is a family of typed writers rather than one
// printf), an in-place integer sort, and a bump allocator over mmap.
//
// Casts are available since v0.23.48-dev (`i32(x)`, `i64(x)`), so where the
// first slice narrowed with `%` the new code spells the width it means.
// Everything still returns a non-void value: a count, a sentinel, or the
// input pointer, because a wrong answer has to be observable.
// ===========================================================================

// memmove(dst, src, n): copy n bytes, correct when the ranges overlap. A
// forward copy is used unless dst starts above src, where it would overwrite
// bytes it has not read yet; that case copies backwards. Returns n.
fn memmove(dst: ptr<u8>, src: ptr<u8>, n: i32) -> i32 {
    if (dst == src || n <= 0) { return n; }
    if (i64(dst) < i64(src)) {
        let i: i32 = 0;
        while (i < n) {
            store_u8(dst + i, load_u8(src + i));
            i = i + 1;
        }
    } else {
        let i: i32 = n;
        while (i > 0) {
            i = i - 1;
            store_u8(dst + i, load_u8(src + i));
        }
    }
    return n;
}

// strncmp(a, b, n): the first differing pair's difference over at most n
// bytes, 0 when equal — unsigned bytes, the same reading memcmp uses.
fn strncmp(a: ptr<u8>, b: ptr<u8>, n: i32) -> i32 {
    let i: i32 = 0;
    while (i < n) {
        let x: i32 = load_u8(a + i);
        let y: i32 = load_u8(b + i);
        if (x != y) { return x - y; }
        if (x == 0) { return 0; }
        i = i + 1;
    }
    return 0;
}

// strchr(s, c): an offset of the first c in s, or -1. c is compared at its
// low 8 bits, so strchr(s, 'a') and strchr(s, 97) are the same question.
fn strchr(s: ptr<u8>, c: i32) -> i32 {
    let i: i32 = 0;
    let want: i32 = c & 255;
    while (1) {
        let ch: i32 = load_u8(s + i);
        if (ch == want) { return i; }
        if (ch == 0) { return -1; }
        i = i + 1;
    }
    return -1;
}

// strstr(h, n): an offset of the first occurrence of n in h, or -1. The empty
// needle answers 0, as C's does.
fn strstr(h: ptr<u8>, n: ptr<u8>) -> i32 {
    let nl: i32 = strlen(n);
    if (nl == 0) { return 0; }
    let i: i32 = 0;
    while (1) {
        if (load_u8(h + i) == 0) { return -1; }
        if (strncmp(h + i, n, nl) == 0) { return i; }
        i = i + 1;
    }
    return -1;
}

// strcat(d, s): append s to d, NUL included; d must have room. Returns the
// resulting length (not d's address), because the length is what a caller
// advancing a cursor needs.
fn strcat(d: ptr<u8>, s: ptr<u8>) -> i32 {
    let dl: i32 = strlen(d);
    let sl: i32 = strlen(s);
    let i: i32 = 0;
    while (i <= sl) {
        store_u8(d + dl + i, load_u8(s + i));
        i = i + 1;
    }
    return dl + sl;
}

// atoi(s): leading spaces, an optional sign, then decimal digits until the
// first non-digit. Anything else is 0, and a lone sign is 0 too. The value
// wraps like ordinary 32-bit arithmetic past the range, which is what an
// unchecked C atoi does with 32 bits.
fn atoi(s: ptr<u8>) -> i32 {
    let i: i32 = 0;
    while (load_u8(s + i) == 32) { i = i + 1; }
    let neg: i32 = 0;
    let ch: i32 = load_u8(s + i);
    if (ch == 45) { neg = 1; i = i + 1; }
    else if (ch == 43) { i = i + 1; }
    let v: i32 = 0;
    while (1) {
        let d: i32 = load_u8(s + i);
        if (d < 48 || d > 57) { break; }
        v = v * 10 + (d - 48);
        i = i + 1;
    }
    if (neg) { return 0 - v; }
    return v;
}

// is_digit / is_space / is_alpha: 1 or 0, ASCII only (the same test set a
// lexer needs, which is what this library is written for).
fn is_digit(c: i32) -> i32 {
    if (c >= 48 && c <= 57) { return 1; }
    return 0;
}
fn is_space(c: i32) -> i32 {
    if (c == 32 || (c >= 9 && c <= 13)) { return 1; }
    return 0;
}
fn is_alpha(c: i32) -> i32 {
    if ((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95) { return 1; }
    return 0;
}

// fmt_i32(buf, v): v in decimal, no padding, NUL-terminated. Returns the
// digit count (-1 aside). INT32_MIN is handled by working on the magnitude in
// i64, where its absolute value fits.
fn fmt_i32(buf: ptr<u8>, v: i32) -> i32 {
    let at: i32 = 0;
    let w: i64 = v;
    if (w < 0) {
        store_u8(buf, 45);
        at = 1;
        w = 0 - w;
    }
    let tmp: u8[16] = 0;
    let i: i32 = 0;
    if (w == 0) {
        store_u8(tmp, 48);
        i = 1;
    }
    while (w > 0) {
        store_u8(tmp + i, 48 + i32(w % 10));
        w = w / 10;
        i = i + 1;
    }
    let j: i32 = i;
    while (j > 0) {
        j = j - 1;
        store_u8(buf + at, load_u8(tmp + j));
        at = at + 1;
    }
    store_u8(buf + at, 0);
    return at;
}

// fmt_hex(buf, v, digits): exactly `digits` lowercase hex characters, zero
// padded, NUL-terminated; digits is clamped to 1..8. Returns the count.
fn fmt_hex(buf: ptr<u8>, v: i32, digits: i32) -> i32 {
    let d: i32 = digits;
    if (d < 1) { d = 1; }
    if (d > 8) { d = 8; }
    let i: i32 = 0;
    while (i < d) {
        let shift: i32 = (d - 1 - i) * 4;
        let nib: i32 = (v >> shift) & 15;
        let ch: i32 = 48 + nib;
        if (nib > 9) { ch = 87 + nib; }
        store_u8(buf + i, ch);
        i = i + 1;
    }
    store_u8(buf + d, 0);
    return d;
}

// sort_i32(a, n): in-place ascending insertion sort of n 32-bit values at a.
// The array is addressed as a bare ptr so `*(a + i * 4)` is a 32-bit load and
// store; a ptr<u8> would read bytes. Returns n.
fn sort_i32(a: ptr, n: i32) -> i32 {
    let i: i32 = 1;
    while (i < n) {
        let v: i32 = *(a + i * 4);
        let j: i32 = i;
        while (j > 0) {
            if (*(a + (j - 1) * 4) <= v) { break; }
            *(a + j * 4) = *(a + (j - 1) * 4);
            j = j - 1;
        }
        *(a + j * 4) = v;
        i = i + 1;
    }
    return n;
}

// A bump allocator over one 64 KiB anonymous mapping: the shape a compiler's
// arena wants (no free list, no metadata, 8-byte aligned). malloc answers 0
// when the mapping is exhausted; free is the documented no-op, so a program
// that frees is still correct and simply does not reclaim.
let heap_base: ptr = 0;
let heap_used: i32 = 0;
let heap_size: i32 = 0;

fn malloc(n: i32) -> ptr {
    if (heap_base == 0) {
        heap_base = mmap(ptr(0), 65536, 3, 34, 0 - 1, 0);
        heap_size = 65536;
        heap_used = 0;
    }
    if (n <= 0) { return 0; }
    let need: i32 = (n + 7) & (0 - 8);
    if (heap_used + need > heap_size) { return 0; }
    let p: ptr = heap_base + heap_used;
    heap_used = heap_used + need;
    return p;
}

fn free(p: ptr) -> i32 {
    return 0;
}

// ===========================================================================
// v0.23.77-dev: printing a double.
//
// There is no variadic call and no printf, so the shape is the same one the
// integer formatters already use: a writer that emits into a caller's buffer
// and answers how many bytes it wrote. The number is printed in fixed point
// (d digits after the point, d clamped to 0..9): an exponent form needs a
// second rounding decision and a cursor that can shift, which a compiler's
// diagnostic output does not need.
//
// Rounding is half-up on the *binary* value, so 3.14159 with two digits is
// 3.14 and -2.718 with one digit is -2.7. A value that is exactly halfway
// between two representable decimals goes up, which is the rule a person
// reading a diagnostic expects, and is deliberately not C's round-half-even.
// ===========================================================================

// fmt_f64(buf, v, decimals): v in fixed point with `decimals` digits after
// the point (clamped to 0..9), NUL-terminated. Returns the byte count, sign
// included. `nan` and `inf` are spelled the way a C printf spells them, so a
// program's output stays comparable with one.
fn fmt_f64(buf: ptr<u8>, v: f64, decimals: i32) -> i32 {
    let at: i32 = 0;
    let x: f64 = v;
    // A NaN is neither negative nor orderable, so it is answered first.
    if (x != x) {
        store_u8(buf, 110);                // 'n'
        store_u8(buf + 1, 97);             // 'a'
        store_u8(buf + 2, 110);            // 'n'
        store_u8(buf + 3, 0);
        return 3;
    }
    if (x < 0.0) {
        store_u8(buf, 45);                 // '-'
        at = 1;
        x = 0.0 - x;
    }
    // An infinity times zero is a NaN; a finite value times zero is a plain
    // zero. That is the whole test, and it needs no constant beyond 0.0.
    let probe: f64 = x * 0.0;
    if (probe != probe) {
        store_u8(buf + at, 105);           // 'i'
        store_u8(buf + at + 1, 110);       // 'n'
        store_u8(buf + at + 2, 102);       // 'f'
        store_u8(buf + at + 3, 0);
        return at + 3;
    }
    let d: i32 = decimals;
    if (d < 0) { d = 0; }
    if (d > 9) { d = 9; }
    // The same power of ten twice: once as a double, for the rounding, and
    // once as an integer, for splitting the rounded value into halves.
    let scale: f64 = 1.0;
    let iscale: i64 = 1;
    let i: i32 = 0;
    while (i < d) {
        scale = scale * 10.0;
        iscale = iscale * 10;
        i = i + 1;
    }
    let total: i64 = i64(x * scale + 0.5);
    at = at + utoa(total / iscale, buf + at);
    if (d > 0) {
        store_u8(buf + at, 46);            // '.'
        at = at + 1;
        let frac: i64 = total % iscale;
        let div: i64 = iscale / 10;
        let k: i32 = 1;
        while (k < d) {
            store_u8(buf + at, 48 + i32((frac / div) % 10));
            at = at + 1;
            div = div / 10;
            k = k + 1;
        }
        store_u8(buf + at, 48 + i32(frac % 10));
        at = at + 1;
    }
    store_u8(buf + at, 0);
    return at;
}

// fmt_f32(buf, v, decimals): the single-precision sibling. The value widens to
// a double first — one exact conversion, so the digits printed are the digits
// the single actually holds, not a second rounding's worth of noise past them.
fn fmt_f32(buf: ptr<u8>, v: f32, decimals: i32) -> i32 {
    return fmt_f64(buf, f64(v), decimals);
}
