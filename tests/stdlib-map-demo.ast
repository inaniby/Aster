// tests/stdlib-map-demo.ast — the third slice of the basic library: a map with
// string keys and pointer values, and a sort that works on any element width.
//
// The C twin (tests/aster-std-map-twin.c) does the same work with its own hash
// table and qsort, and prints the same summary line.
include "ailib.ast";

fn cmp_desc(a: ptr, b: ptr) -> i32 {
    let x: i32 = *(a);
    let y: i32 = *(b);
    if (x > y) { return 0 - 1; }
    if (x < y) { return 1; }
    return 0;
}

// A comparator of this file's own: the address of an *extern* function cannot
// be taken ("its location is another object's business"), so a consumer of the
// library supplies its own comparator even though the library ships one.
fn cmp_pair_asc(a: ptr, b: ptr) -> i32 {
    let x: i32 = *(a);
    let y: i32 = *(b);
    if (x < y) { return 0 - 1; }
    if (x > y) { return 1; }
    return 0;
}

fn main() -> i32 {
    let ok: i32 = 0;
    let cell: i64[8] = 0;

    // 1. a map: put, replace, miss, and a table that grows
    let m: Map = Map { 0, 0, 0 };
    if (map_init(&m, 4) != 0) { return 1; }
    if (map_put(&m, "alpha", ptr(&cell[0])) == 1) { ok = ok + 1; }
    if (map_put(&m, "beta", ptr(&cell[1])) == 1) { ok = ok + 1; }
    if (map_put(&m, "alpha", ptr(&cell[2])) == 0) { ok = ok + 1; }   // replaced
    if (map_get(&m, "alpha") == ptr(&cell[2])) { ok = ok + 1; }
    if (map_get(&m, "beta") == ptr(&cell[1])) { ok = ok + 1; }
    if (map_get(&m, "gamma") == 0) { ok = ok + 1; }
    if (map_has(&m, "gamma") == 0) { ok = ok + 1; }
    let i: i32 = 0;
    while (i < 200) {
        let k: u8[16] = 0;
        fmt_i32(k, i);
        let copy: ptr<u8> = str_dup(k);          // the map never copies a key
        if (copy == 0) { return 2; }
        if (map_put(&m, copy, ptr(&cell[3])) != 1) { return 3; }
        i = i + 1;
    }
    let count: i32 = m.count;
    if (count == 202) { ok = ok + 1; }            // alpha, beta and 200 numbers
    let probe: u8[16] = 0;
    fmt_i32(probe, 137);
    if (map_get(&m, probe) != ptr(&cell[3])) { return 4; }
    if (map_get(&m, "alpha") != ptr(&cell[2])) { return 5; }   // survived the growth
    ok = ok + 1;

    // 2. the typed sorts
    let a: i32[5] = 0;
    a[0] = 5; a[1] = 0 - 3; a[2] = 9; a[3] = 0; a[4] = 2;
    sort_i32(ptr(&a), 5);
    if (a[0] == 0 - 3 && a[4] == 9) { ok = ok + 1; }
    let l: i64[4] = 0;
    l[0] = 5000000000l; l[1] = 0 - 1l; l[2] = 7l; l[3] = 0l;
    sort_i64(ptr(&l), 4);
    if (l[0] == 0 - 1l && l[3] == 5000000000l) { ok = ok + 1; }
    let u: u8[4] = 0;
    u[0] = 200; u[1] = 3; u[2] = 255; u[3] = 0;
    sort_u8(ptr(&u), 4);
    if (u[0] == 0 && u[3] == 255) { ok = ok + 1; }
    let names: ptr[3] = 0;
    names[0] = "pear"; names[1] = "apple"; names[2] = "fig";
    sort_str(ptr(&names), 3);
    if (streq(ptr<u8>(names[0]), "apple") == 1) { ok = ok + 1; }
    if (streq(ptr<u8>(names[2]), "pear") == 1) { ok = ok + 1; }

    // 3. the general form, with a comparator of the caller's own
    let d: i32[4] = 0;
    d[0] = 1; d[1] = 4; d[2] = 2; d[3] = 3;
    sort_bytes(ptr(&d), 4, 4, ptr(cmp_desc));
    if (d[0] == 4 && d[3] == 1) { ok = ok + 1; }
    // an element wider than a register: two i32s per element, ordered by the
    // first one, with the pair kept together by the width-8 swap
    let pairs: i32[6] = 0;
    pairs[0] = 2; pairs[1] = 20; pairs[2] = 1; pairs[3] = 10; pairs[4] = 3; pairs[5] = 30;
    sort_bytes(ptr(&pairs), 3, 8, ptr(cmp_pair_asc));
    if (pairs[0] == 1 && pairs[1] == 10 && pairs[2] == 2 && pairs[3] == 20 && pairs[4] == 3) { ok = ok + 1; }

    // summary: ok|count|i32first|i32last|u8max|name0|desc0
    let out: u8[128] = 0;
    let at: i32 = 0;
    at = at + fmt_i32(out, ok);
    out[at] = 124; at = at + 1;
    at = at + fmt_i32(out + at, count);
    out[at] = 124; at = at + 1;
    at = at + fmt_i32(out + at, a[0]);
    out[at] = 124; at = at + 1;
    at = at + fmt_i32(out + at, a[4]);
    out[at] = 124; at = at + 1;
    at = at + fmt_i32(out + at, u[3]);
    out[at] = 124; at = at + 1;
    at = at + fmt_i32(out + at, load_u8(ptr<u8>(names[0])));
    out[at] = 124; at = at + 1;
    at = at + fmt_i32(out + at, d[0]);
    write_all(1, out, at);
    let nl: u8[2] = 0;
    store_u8(nl, 10);
    write_all(1, nl, 1);
    return ok == 16 ? 0 : 1;
}
