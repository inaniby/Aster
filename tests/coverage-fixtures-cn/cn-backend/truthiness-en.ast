// aster:language=en
enum Flag { Off = 0, On = 1 }
fn main(): i32 {
let total: i32 = 0;
let state: Flag = On;
if (state) {
total = total + 1;
}
state = Off;
if (state) {
return 99;
}
let loopState: Flag = On;
while (loopState) {
total = total + 1;
loopState = Off;
}
let count: i64 = 1;
while (count) {
total = total + 1;
count = count - 1;
}
if (0) {
return 90;
}
let flag: bool = true;
if (flag) {
total = total + 1;
}
flag = false;
if (flag) {
return 91;
}
if (count == 0) {
total = total + 1;
}
return total;
}
