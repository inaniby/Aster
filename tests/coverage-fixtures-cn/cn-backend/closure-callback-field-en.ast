// aster:language=en
struct Holder { callback: closure(ptr): i32 }
fn register(callback: fn(ptr): i32, user: ptr): i32 {
    return callback(user);
}
fn main(): i32 {
    let holder: Holder;
    holder.callback = fn [] (user: ptr): i32 {
        return 42;
    };
    return register(holder.callback, null);
}
