// aster:language=en
struct Point { x: i32, y: i32, label: string }
fn main(): i32 {
let points: Point[2] = [Point { 1, 2, "first" }, Point { 3, 4, "second" }];
let defaults: Point[1];
if (defaults[0].label == null) { return 1; }
if (defaults[0].x != 0) { return 2; }
points[1].y = 44;
return points[1].y;
}
