// aster:language=en
class Scheduler {
    @static
    fn register(callback: fn(ptr): i32, user: ptr): i32 {
        return callback(user);
    }
}
fn main(): i32 {
    let offset: i32 = 41;
    let callback = fn [offset] (user: ptr): i32 {
        return offset + 1;
    };
    return Scheduler.register(callback, null);
}
