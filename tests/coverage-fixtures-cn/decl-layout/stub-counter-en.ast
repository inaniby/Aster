    return 0;
}
fn aui_button(key: i32, text: ptr, cb: fn(ptr) -> i32, user: ptr) -> i32 {
    logKey(key);
    if (key == 1786076415) {
        savedDec = cb;
    } else if (key == 183326715) {
        savedInc = cb;
    } else if (key == -1039401196) {
        savedReset = cb;
    }
    savedUser = user;
    return 0;
}
fn aui_pad(dp: i32) -> i32 {
