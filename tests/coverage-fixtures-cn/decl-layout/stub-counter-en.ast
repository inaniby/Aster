        statev = value;
    }
    return 0;
}
fn aui_invalidate() -> i32 {
    return 0;
}
fn aui_end() -> i32 {
    endn = endn + 1;
    return 0;
}
fn main() -> i32 {
    let p: ptr<App> = &g_app;
