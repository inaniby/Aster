布局 页甲(s: 指针<应用>, 用户: 指针): 视图 {
    列 甲 {
        变量 打开: 整数 = 0
        如果 s.选择打开 == 键(语言)
            打开 = 1
        结束 如果
        下拉选择 语言, s.语言, 打开, 指针("选") {
            选项 英语, 指针("英语")
        }
        标签 乙, 指针("乙")
    }
    尾标 = 1
}
方法 启动方法(): 整数
    变量 p: 指针<应用> = &g_app
    g_app.选择打开 = -1594825719
    变量 r: 整数 = 页甲(p, p)
    如果 列时尾标 != 0
        返回 1
    结束 如果
    如果 尾标 != 1
        返回 2
    结束 如果
    如果 打开值 != 1
        返回 3
    结束 如果
    返回 r
