方法 启动方法(): 整数
    变量 字体结果: 整数 = 设置运行时字体路径(指针("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"))
    如果 字体结果 != 1
        返回 90
    结束 如果
    设置字体(g_font, 1)
    gallery_headless_init()
    变量 n0: 整数 = 无窗口渲染(宽, 高, g_buf)
    如果 n0 <= 0
        返回 1
    结束 如果
    如果 gallery_count() != 0
        返回 3
    结束 如果
    变量 e0: 整数 = 输出计数页(指针("counter0"), 0)
    // [5/7]：真实点按 + 按钮（105）——绝不直接调 gallery_add_one()。
    如果 点按按钮(105) != 0
        返回 6
    结束 如果
    如果 gallery_count() != 1
        返回 6
    结束 如果
    变量 n1: 整数 = 无窗口渲染(宽, 高, g_buf)
    如果 n1 <= 0
        返回 2
    结束 如果
    变量 e1: 整数 = 输出计数页(指针("counter1"), 1)
    gallery_set_tab(1)
    变量 n2: 整数 = 无窗口渲染(宽, 高, g_buf)
    如果 n2 <= 0
        返回 5
    结束 如果
    变量 e1b: 整数 = 输出输入页(指针("input"))
    如果 调试图形(1000, g_rect) != 0
        返回 9
    结束 如果
    如果 g_rect[3] <= 0
        返回 9
    结束 如果
    如果 统计像素(0, 148, 宽, 高 - 148, 2) <= 0
        返回 9
    结束 如果
    gallery_set_tab(2)
    变量 n3: 整数 = 无窗口渲染(宽, 高, g_buf)
    如果 n3 <= 0
        返回 4
    结束 如果
    // B12① / B15：根页须为 路由 1 / 深度 1。
    如果 路由() != 1
        返回 7
    结束 如果
    如果 导航深度() != 1
        返回 7
    结束 如果
    变量 e2: 整数 = 输出导航页(指针("nav_root"), 0)
    如果 点按按钮(403) != 0
        返回 7
    结束 如果
    变量 n4: 整数 = 无窗口渲染(宽, 高, g_buf)
    如果 n4 <= 0
        返回 4
    结束 如果
    如果 路由() != 2
        返回 7
    结束 如果
    如果 导航深度() != 2
        返回 7
    结束 如果
    变量 e3: 整数 = 输出导航页(指针("nav_push"), 1)
    如果 点按按钮(420) != 0
        返回 8
    结束 如果
    变量 n5: 整数 = 无窗口渲染(宽, 高, g_buf)
    如果 n5 <= 0
        返回 4
    结束 如果
    如果 路由() != 1
        返回 8
    结束 如果
    如果 导航深度() != 1
        返回 8
    结束 如果
    变量 e4: 整数 = 输出导航页(指针("nav_pop"), 0)
    gallery_set_tab(0)
    变量 n6: 整数 = 无窗口渲染(宽, 高, g_buf)
    如果 n6 <= 0
        返回 2
    结束 如果
    如果 gallery_count() != 1
        返回 3
    结束 如果
    // [6/7]：中文渲染缺字即方框占位；缺字数须为 0。
    如果 运行时缺字数() != 0
        返回 10
    结束 如果
