// aui.ast — AsterUI 公共接口（v1.48.6）
//
// 只有 extern 声明，不含任何内部 struct：应用看不到节点布局。
// 句柄统一 i32；用户状态统一 ptr；字符串统一 UTF-8（NUL 结尾，另带长度变体）。
// 单位统一 dp（整数）；布局结果由库内换算成 Q16.16 像素。
//
// 使用方式：应用源码 include 本文件，构建时把 aui_impl.o 链接进来。
// 详见 docs/AsterUI-design.md 与附录 D。

// ---- 会话 ----
extern fn aui_android_attach(activity: ptr, saved: ptr, saved_size: i64,
                             build: fn(ptr) : i32, user: ptr,
                             init: fn(ptr) : i32, flags: i32) : i32;
// v2.20.0: Linux fbdev attach -- aui_android_attach 的 Linux 对应物。
// build/user 事先由应用的 *_headless_init() 注册（extern 调用），
// app_init 由应用入口直接调；这里只做平台一半：日志、时钟、字体探测、
// 窗口 + 输入队列、帧泵、首帧。密度/edge-to-edge/内容区/字体路径由
// 适配器在调它之前经公开 setter 定好。win/queue 是适配器的会话指针
// （非空即可，present/input 路径只把它当句柄传回适配器）；logdir
// 是 trace.txt/aui.log 所在的目录（0 = 不写文件日志）。
extern fn aui_fbdev_attach(win: ptr, queue: ptr, logdir: ptr) : i32;
// v2.20.0: Linux runner 的空闲判断——1 = 近期有帧要出（动效/脏区/待定
// 计时），0 = 可阻塞等输入。读 g_aui_pump_need，与泵线程同一标志。
extern fn aui_pump_need() : i32;
extern fn aui_frame(now_ns: i64) : i32;
extern fn aui_invalidate() : i32;
extern fn aui_invalidate_layout() : i32;
extern fn aui_shutdown() : i32;
extern fn aui_set_font(font: ptr, scale: i32) : i32;
// v1.16：回退字体（通常是 16x16 CJK 图集）。主字体找不到的码点查这里；
// 传 font=0 关闭。拉丁 8x8 字体常用 scale=2，汉字 16x16 常用 scale=1。
extern fn aui_set_fallback_font(font: ptr, scale: i32) : i32;
extern fn aui_version() : i32;
// v2.19.2：应用版本（APK 的版本名 + code，与框架版本区分）。应用在
// build 里调 aui_set_app_version 一次登记；启动日志行与 Gallery
// System 标签页都读这两个 getter，不再各写一份。
extern fn aui_set_app_version(name: ptr, code: i32) : i32;
extern fn aui_app_version_name() : ptr;
extern fn aui_app_version_code() : i32;

// ---- 文件日志（W3 合并，见 aui_impl.ast 的 aui_log_* 实现）----
// trace.txt 只记里程碑字母；aui.log 记带 i64 时间戳的完整行为行，
// 格式 "[<ms>] <L> AUI: <msg>\n"，写内部 + 外部 files 目录各一份
// （<dir>/aui.log，128 KiB 轮转），同时镜像到 logcat（tag AsterUI）。
// attach 时自动初始化；aui_log_set_file 供无宿主测试指定主文件。
// aui_log_tail 回读主文件尾部（应用内日志查看器用）。
extern fn aui_log(level: i32, msg: ptr) : i32;
extern fn aui_log1(level: i32, p0: ptr, v: i32, p1: ptr) : i32;
extern fn aui_log2(level: i32, p0: ptr, a: i32, p1: ptr, b: i32, p2: ptr) : i32;
extern fn aui_log_lines() : i32;
extern fn aui_log_tail(out: ptr, cap: i32) : i32;
extern fn aui_log_set_file(path: ptr) : i32;

// ---- Custom fonts (v2.5) ----
// Load a font file from an arbitrary device path at runtime
// (HYZhengYuan etc.). The engine holds one active face; loading
// a custom font remembers the previously active face (the system
// font on the device) so aui_rt_restore_system_font goes back to
// it. A failed load restores that face too and reports the reason
// via aui_rt_custom_err -- never a silent fallback, never a blank
// screen. Weight is read from the file (fvar, else the family-name
// suffix, else OS/2), never from the filename.
// aui_ext_dir answers the app's external files dir (0 when no
// Android attach, e.g. headless); the Gallery's default font
// folder is <ext>/fonts.
extern fn aui_ext_dir() : ptr;
extern fn aui_rt_set_custom_font(path: ptr) : i32;
extern fn aui_rt_restore_system_font() : i32;
extern fn aui_rt_custom_active() : i32;
extern fn aui_rt_custom_err() : i32;
extern fn aui_rt_custom_load_ms() : i32;
extern fn aui_rt_custom_path() : ptr;
extern fn aui_rt_system_path() : ptr;
extern fn aui_rt_font_weight() : i32;
extern fn ui_sysfont_path() : ptr;
extern fn ui_sysfont_face_name() : ptr;
extern fn ui_sysfont_name_weight() : i32;

// ---- 构建（在 build 回调内按顺序调用）----
extern fn aui_root() : i32;
extern fn aui_column(key: i32) : i32;
extern fn aui_row(key: i32) : i32;
extern fn aui_stack(key: i32) : i32;
extern fn aui_scroll(key: i32) : i32;
extern fn aui_pad(dp: i32) : i32;
extern fn aui_gap(dp: i32) : i32;
extern fn aui_weight(w: i32) : i32;
extern fn aui_align(a: i32) : i32;
extern fn aui_bg(color: u32) : i32;
extern fn aui_radius(dp: i32) : i32;
// v0.1-cn D-2a 前置（评估稿 §1.3 的 5 个缺失项，见 D2A-SCHEMA.md）：
// 通用宽高 / 通用前景色 / 长按选中。修饰器，挂最近创建的节点，返回 i32；
// 无目标返回 0（与 aui_pad/aui_gap 同款形态）。
// aui_size：每维 i32 dp；−1 = 未指定（包内容/默认量出，现行行为），
// 其它负值按 −1 归一。−1 在此只表示“未指定”，不是 Android 的
// MATCH_PARENT/WRAP_CONTENT（评估稿 §8 第 4 条）；填满走既有 weight 机制。
extern fn aui_size(w: i32, h: i32) : i32;
// aui_fg：u32 ARGB，逐节点前景色覆盖；未设置时走主题。只覆盖文本前景
// （适用节点种见 D2A-SCHEMA.md）；背景仍走 aui_bg。显式 0x00000000
// 也是有效覆盖。状态色（选中/按下/禁用）不被覆盖。
extern fn aui_fg(color: u32) : i32;
// aui_selectable：flag != 0 = 可选中。标记接受任何节点；选中行为只对
// 文本节点（label，含 aui_text_i32）生效：长按 500 ms 不动即选中其全文。
// 有 aui_long_press 回调登记的节点走回调、不产生选区；选区状态读
// aui_selection_key()（0 = 无选区）/ aui_debug_selection()。
extern fn aui_selectable(flag: i32) : i32;
extern fn aui_label(key: i32, text: ptr) : i32;
extern fn aui_label_n(key: i32, text: ptr, len: i32) : i32;
extern fn aui_text_i32(key: i32, value: i32) : i32;
extern fn aui_button(key: i32, text: ptr, cb: fn(ptr) : i32, user: ptr) : i32;
// v1.17：开关。on != 0 为开；状态由应用持有，每次 build 传入。
// 点按只调用 cb(user)，应用翻转状态后 aui_invalidate() 即可。
extern fn aui_switch(key: i32, on: i32, cb: fn(ptr) : i32, user: ptr) : i32;
// v1.17：进度条。value 是千分比 0..1000（越界夹紧），0 = 空、1000 = 满。
extern fn aui_progress(key: i32, value: i32) : i32;
// v1.20：复选框 / 单选框。文字是内联标签；checked/selected != 0 为选中。
// 状态由应用持有（同开关）；点按只调 cb(user)，应用改状态后 aui_invalidate()。
// 单选组的互斥也由应用维护：回调里把同组其他项置 0，再置自己。
extern fn aui_checkbox(key: i32, text: ptr, checked: i32, cb: fn(ptr) : i32, user: ptr) : i32;
extern fn aui_radio(key: i32, text: ptr, selected: i32, cb: fn(ptr) : i32, user: ptr) : i32;
// v1.31：标签片（Chip）。selected != 0 为主色填充 + on_primary 文字，
// 否则 surface 底 + on_surface 24% 1 dp 边框。尺寸是固有宽（文字 + 32 dp），
// 高至少 28 dp；放在行里并排，放在列里按固有宽左对齐。
extern fn aui_chip(key: i32, text: ptr, selected: i32, cb: fn(ptr) : i32, user: ptr) : i32;
// v2.10：角标（Badge，对照 HuxerUI tree_view 例子里的 Badge 辅助函数：
// 11 pt 半粗体文字、左右 9 dp 上下 4 dp 内边距、满圆角药丸形）。纯展示，
// 不接收点击。aui_badge 传文字与前后景色；aui_badge_count 只传数量：
// count <= 0 不画（零尺寸）、1..99 显示数字、>= 100 显示 "99+"，白字红底；
// aui_badge_dot 是 8 dp 实心圆点（颜色自定），放在行尾或图标旁作未读提示。
extern fn aui_badge(key: i32, text: ptr, fg: u32, bg: u32) : i32;
extern fn aui_badge_count(key: i32, count: i32) : i32;
extern fn aui_badge_dot(key: i32, color: u32) : i32;
// 仅测试：out = [x, y, w, h, visible]；找不到返回 -1。
// 仅测试：D-2a 修饰值读回。out = [size_w_dp, size_h_dp, text_sp,
// fg_bits, fg_set, selectable]（未设置项为 −1/0）；找不到 key 返回 −1。
extern fn aui_debug_d2a(key: i32, out: ptr) : i32;
// 仅测试：选区读回。out = [node_idx, key, start_cp, end_cp]；无选区返回 −1。
extern fn aui_debug_selection(out: ptr) : i32;
// 选中文本节点的 key；无选区返回 0。
extern fn aui_selection_key() : i32;
extern fn aui_debug_badge(key: i32, out: ptr) : i32;
// v1.32：环形进度（对照 HuxerUI ProgressCircle）。直径 size dp（0 = 24 dp，
// 夹在 8..240），描边 = max(1, size/8) dp。value 是千分比 0..1000，从
// 12 点起顺时针铺弧；value < 0 为不确定进度：固定 28% 的弧、900 ms 转
// 一圈，由帧泵自动驱动，应用不需要定时器。控件是固有正方形，不接收点击；
// 列里用 aui_align(1/2) 居中/右对齐。
extern fn aui_progress_circle(key: i32, value: i32, size: i32) : i32;
// 仅测试：环形进度状态，out 写 [value, size_dp]；找到返回 0。
extern fn aui_debug_progress_circle(key: i32, out: ptr) : i32;
// v1.33：树视图（对照 HuxerUI TreeView / TreeViewStyle）。容器 + 按
// 可见顺序声明的 aui_tree_item 行。行高固定 32 dp，纵向滚动、惯性、
// 滚动条、裁剪都与 aui_scroll 相同。受控组件：展开/选中状态由应用保存，
// flags 用 AUI_TREE_* 按位组合；点按行只调 cb(user)，应用在回调里
// 切换展开/选中后 aui_invalidate()。depth 为缩进层级（0..32，每级
// 20 dp）；branch 行在 24 dp 指示槽里画 12 dp 三角，expanded 下指、
// 否则右指；selected 铺 14% 主色底，disabled 用 38% 文字色且不派发
// 点击。文本单行，右端留 8 dp 并裁剪。放进列里时，树和包含它的列通常
// 都要 aui_weight(1)：列会先按内容测量高度，权重子项拿不到剩余空间。
extern let AUI_TREE_BRANCH: i32;
extern let AUI_TREE_EXPANDED: i32;
extern let AUI_TREE_SELECTED: i32;
extern let AUI_TREE_DISABLED: i32;
extern fn aui_tree(key: i32) : i32;
extern fn aui_tree_item(key: i32, text: ptr, depth: i32, flags: i32,
                        cb: fn(ptr) : i32, user: ptr) : i32;
// 仅测试：树行状态，out 写 [depth, flags]；找到返回 0。
extern fn aui_debug_tree_item(key: i32, out: ptr) : i32;
// v1.45：虚拟列表（对照 HuxerUI VirtualList）。固定行高，只构建视口内
// （上下各多一行）的行节点，适合上千条数据。count = 数据总数，item_dp =
// 行高；on_bind 在构建时按 aui_vlist_first()..aui_vlist_last()（闭区间）
// 循环调用 aui_vlist_row(index)，在行内继续建内容：行是列容器，宽度
// 铺满内容区，高度固定。列表本身是容器：建完行内容后必须调 aui_end()
// 闭合列表，否则后续兄弟节点会嵌进列表内（v2.11 的 Badge 行重叠就是
// 漏了这一次 aui_end）。滚动、惯性、滚动条、裁剪与 aui_scroll 相同，
// 偏移按 key 跨帧保留；key 必须非 0 且全树唯一。on_tap 挂在每一行上：
// 点行（没有被行内按钮吃掉）时调用，回调里用 aui_vlist_tap_index() 读
// 行下标、aui_vlist_tap_key() 读容器 key。窗口校正可能晚一帧生效，
// 应用无需关心；程序化滚动用 aui_vlist_scroll_to。
extern fn aui_vlist(key: i32, count: i32, item_dp: i32,
                    on_bind: fn(ptr) : i32, on_tap: fn(ptr) : i32,
                    user: ptr) : i32;
extern fn aui_vlist_row(index: i32) : i32;
extern fn aui_vlist_first() : i32;
extern fn aui_vlist_last() : i32;
extern fn aui_vlist_tap_index() : i32;
extern fn aui_vlist_tap_key() : i32;
extern fn aui_vlist_scroll(key: i32) : i32;
extern fn aui_vlist_scroll_to(key: i32, px: i32) : i32;
// 仅测试：out = [x,y,w,h,count,first,last,offset_px]；当前窗口不含该
// 行下标时 aui_debug_vlist_row 返回 -1。
extern fn aui_debug_vlist(key: i32, out: ptr) : i32;
extern fn aui_debug_vlist_row(key: i32, index: i32, out: ptr) : i32;
// v2.10：不定高虚拟列表（对照 HuxerUI VirtualList.EstimatedItemExtent）。
// 与 aui_vlist 的区别只有行高：固定列表每行等高（item_dp），不定高列表
// 每行高度由内容量出、按下标缓存。est_dp 是未量过项的估计高（首帧窗口
// 与总高都按它算）；on_bind 在构建时按 aui_vlist_first()..aui_vlist_last()
// （闭区间，与固定列表共用）循环调用 aui_vlist_var_row(index)，在行内
// 继续建内容：行是列容器，宽度铺满内容区，高度由内容决定。列表本身
// 是容器：建完行内容后必须调 aui_end() 闭合列表，否则后续兄弟节点会
// 嵌进列表内（v2.11 的 Badge 行重叠就是漏了这一次 aui_end）。滚动、惯性、
// 滚动条、裁剪与 aui_vlist 相同，偏移按 key 跨帧保留；key 必须非 0 且全树
// 唯一。on_tap 语义与固定列表相同（回调里用 aui_vlist_tap_index() /
// aui_vlist_tap_key() 读取）。程序化滚动到指定项用
// aui_vlist_var_scroll_to_item（align 0 顶对齐 / 1 居中 / 2 底对齐）。
// 行高缓存规则（量一次、缓存、显式失效）：行第一次布局时量内容高并写入
// 缓存，之后布局直接用缓存值，不再重测；内容变了应用必须调
// aui_vlist_var_invalidate（单项）或 invalidate_all（整表）；增删用
// aui_vlist_var_insert / remove 平移缓存（否则下标错位、高度串位）；
// count 直接变化（没走 insert/remove）视为换了一批数据，整表失效重测；
// 内容宽度变化（旋转/窗口变宽）整表自动失效（文字换行变了旧高度无意义）。
// 每表缓存上限 1024 项：超出上限的项永远用估计高（仍可渲染、仍可滚动，
// 只是深处位置按估计算）；登记表共 16 槽（与固定列表共用）。
extern fn aui_vlist_var(key: i32, count: i32, est_dp: i32,
                       on_bind: fn(ptr) : i32, on_tap: fn(ptr) : i32,
                       user: ptr) : i32;
extern fn aui_vlist_var_row(index: i32) : i32;
extern fn aui_vlist_var_scroll_to_item(key: i32, index: i32, align: i32) : i32;
extern fn aui_vlist_var_invalidate(key: i32, index: i32) : i32;
extern fn aui_vlist_var_invalidate_all(key: i32) : i32;
extern fn aui_vlist_var_insert(key: i32, index: i32) : i32;
extern fn aui_vlist_var_remove(key: i32, index: i32) : i32;
// 仅测试：aui_debug_vlist_var 的 out 与 aui_debug_vlist 相同；
// aui_debug_vlist_var_row 的 out = [x,y,w,h,cached_h_px,measured]；
// aui_debug_vlist_var_stats 的 out = [total_px,measured_count,write_count,cap]
// （write_count 是高度写回次数：无变化重布局不增长，证明量一次缓存有效）。
extern fn aui_debug_vlist_var(key: i32, out: ptr) : i32;
extern fn aui_debug_vlist_var_row(key: i32, index: i32, out: ptr) : i32;
extern fn aui_debug_vlist_var_stats(key: i32, out: ptr) : i32;
// v2.12：可调分栏（对照 HuxerUI SplitLayout，缺口 #5）。两个窗格、
// 一条分隔条：horizontal != 0 时窗格左右排（分隔条竖直）、0 时上下排
// （分隔条水平）。ratio 是首窗格的占比（千分比 0..1000），只作初值：
// 同 key 第一次构建时写入登记表，之后构建沿用登记表里的值（拖动与
// aui_split_set_ratio 维护它），想重置必须调 aui_split_set_ratio——
// 传新 ratio 重建不会重置（否则拖动后下一帧就弹回初值，与滚动偏移
// 同一条规则）。分隔条可见 4 dp（文字色 12%，与 aui_divider 同色）、
// 命中宽 24 dp（以条中心为准）：按下命中区直接开始拖（与滑块相同，
// 不设 8 dp 拖动门槛），MOVE 实时改比例并在比例变化时调 cb(user)，
// UP/取消结束拖动；分隔条本身不接收点击（点窗格空白处不会触发 cb）。
// 最小窗格：默认 48 dp，aui_split_min(dp) 在 aui_split 紧后调用
// （0..200 dp 夹取）；布局时首窗格夹在 [min, 总宽-分隔条-min]，总宽
// 小于 2*min+分隔条时两窗格均分。两个子节点是普通容器（通常用列），
// 建完必须调 aui_end() 闭合（与列表同规则）；少于两个子节点时无分隔条，
// 单个子节点铺满；多于两个子节点时多余的忽略（零尺寸）。嵌套分栏可以
// 用（窗格里再放一个 aui_split）。key 必须非 0 且全树唯一；登记表共
// 16 槽，超出的分栏仍按传入 ratio 布局、但拖动不持久（与列表同规则）。
extern fn aui_split(key: i32, horizontal: i32, ratio: i32,
                    cb: fn(ptr) : i32, user: ptr) : i32;
// 修饰器，紧跟 aui_split 调用（在第一个窗格之前）：设最小窗格 dp。
extern fn aui_split_min(dp: i32) : i32;
// 读当前比例（登记表值，拖动中读到的是实时值）；找不到返回 -1。
extern fn aui_split_ratio(key: i32) : i32;
// 写比例（0..1000 夹取；拖动中的最小窗格边界同样适用）；找不到返回 -1。
// 只写登记表，不调 cb；下次布局生效。
extern fn aui_split_set_ratio(key: i32, ratio: i32) : i32;
// 仅测试：out = [x,y,w,h,horizontal,ratio,min_dp,div_px]
// （div_px 是分隔条中心沿主轴的绝对像素坐标）；找不到返回 -1。
extern fn aui_debug_split(key: i32, out: ptr) : i32;
// 仅测试：某窗格的矩形；out = [x,y,w,h]；index 只能是 0/1，否则 -1。
extern fn aui_debug_split_pane(key: i32, index: i32, out: ptr) : i32;
// v1.46：虚拟网格（对照 HuxerUI VirtualGrid）。固定行高，只构建视口内
// （上下各多一行）的格子节点，适合上千项。cols > 0 表示固定列数；
// cols <= 0 按 min_cell_dp 自适应：列数 = (内容宽 + 间距) / (最小格宽 +
// 间距)。行/列间距都用 aui_gap 设置，格宽按列数均分。on_bind 在构建时
// 按 aui_vgrid_first()..aui_vgrid_last()（闭区间，格子下标而非行号）
// 循环调用 aui_vgrid_cell(index)，在格子内继续建内容：格子是列容器，
// 宽高由布局统一安排。滚动/惯性/滚动条/裁剪与 aui_vlist 相同；on_tap
// 点格时调用，回调里用 aui_vgrid_tap_index()/aui_vgrid_tap_key() 读取。
// 列数/间距/视口高变化时窗口会晚一帧自动重建，应用无需关心。
extern fn aui_vgrid(key: i32, count: i32, cols: i32, min_cell_dp: i32,
                    row_dp: i32, on_bind: fn(ptr) : i32,
                    on_tap: fn(ptr) : i32, user: ptr) : i32;
extern fn aui_vgrid_cell(index: i32) : i32;
extern fn aui_vgrid_first() : i32;
extern fn aui_vgrid_last() : i32;
extern fn aui_vgrid_tap_index() : i32;
extern fn aui_vgrid_tap_key() : i32;
extern fn aui_vgrid_scroll(key: i32) : i32;
extern fn aui_vgrid_scroll_to(key: i32, px: i32) : i32;
// 仅测试：out = [x,y,w,h,count,cols,first,last,offset_px]；当前窗口不含
// 该格子下标时 aui_debug_vgrid_cell 返回 -1。
extern fn aui_debug_vgrid(key: i32, out: ptr) : i32;
extern fn aui_debug_vgrid_cell(key: i32, index: i32, out: ptr) : i32;
// v2.17：虚拟表格（对照 HuxerUI virtual_table）。行列都虚拟化：只构建
// 视口内（上下各多一行、左右各多一列）的格子节点，适合上万行 × 上百列。
// rows 行 × cols 列（列上限 512）；row_dp 行高，表头与行同高。on_bind 在
// 构建时按 aui_vtable_first_row()..aui_vtable_last_row() ×
// aui_vtable_first_col()..aui_vtable_last_col()（闭区间）循环：表头调用
// aui_vtable_header(col)，表身调用 aui_vtable_cell(row, col)，在格子内
// 继续建内容（格子是列容器，宽高由布局统一安排）。列宽默认 128dp，用
// aui_vtable_col(key, col, width_dp) 逐列设置（width_dp <= 0 恢复默认）；
// 列宽只在下次构建时生效，改动后框架自动重建。表头纵向固定、横向跟随
// 内容滚动；首列横向固定、纵向跟随滚动。滚动/惯性/裁剪与 aui_vlist
// 相同，只是纵横双轴：纵向走 scroll_get/set（直搬复用），横向走独立
// 的 off_x（横向滚动整屏重画，不直搬）。on_tap 点格时调用，回调里用
// aui_vtable_tap_row()/aui_vtable_tap_col() 读取（表头行 row == -1）。
// 程序化滚动到指定格用 aui_vtable_scroll_to(key, row, col, align)
// （align 0 起始对齐 / 1 居中 / 2 末端对齐，双轴同义；row/col 越界夹取）。
// 对齐按“可见区”算：表头占一行高、首列占一列宽，目标格落在表头下 /
// 首列右，不藏到固定部分下面。
extern fn aui_vtable(key: i32, rows: i32, cols: i32, row_dp: i32,
                     on_bind: fn(ptr) : i32, on_tap: fn(ptr) : i32,
                     user: ptr) : i32;
extern fn aui_vtable_col(key: i32, col: i32, width_dp: i32) : i32;
extern fn aui_vtable_header(col: i32) : i32;
extern fn aui_vtable_cell(row: i32, col: i32) : i32;
extern fn aui_vtable_first_row() : i32;
extern fn aui_vtable_last_row() : i32;
extern fn aui_vtable_first_col() : i32;
extern fn aui_vtable_last_col() : i32;
extern fn aui_vtable_tap_row() : i32;
extern fn aui_vtable_tap_col() : i32;
extern fn aui_vtable_tap_key() : i32;
extern fn aui_vtable_scroll_to(key: i32, row: i32, col: i32, align: i32) : i32;
// 仅测试：out = [x,y,w,h,rows,cols,first_row,last_row,first_col,
// last_col,off_y,off_x]（像素/整数）；当前窗口不含该格子时
// aui_debug_vtable_cell 返回 -1。aui_debug_vtable_set_x 直接设横向
// 偏移（像素，自动夹取），与 aui_debug_scroll_set（纵向）配对。
extern fn aui_debug_vtable(key: i32, out: ptr) : i32;
extern fn aui_debug_vtable_cell(key: i32, row: i32, col: i32, out: ptr) : i32;
extern fn aui_debug_vtable_set_x(key: i32, px: i32) : i32;
// v1.47：横向虚拟列表（对照 HuxerUI VirtualList.ScrollAxis(Horizontal)）。
// 项宽固定 item_w_dp；item_h_dp > 0 时项高固定，否则撑满容器内容高。
// 只构建视口附近（左右各多一项）的项节点，适合上千项卡片横滑。
// 项间距用 aui_gap 设置；拖动/惯性/底部横滚动条/裁剪与 aui_vlist 相同，
// 只是方向换成水平。on_bind 在构建时按 aui_hlist_first()..aui_hlist_last()
// （闭区间）循环 aui_hlist_item(index)；on_tap 点项时调用，回调里用
// aui_hlist_tap_index()/aui_hlist_tap_key() 读取。视口宽变化时窗口会晚
// 一帧自动重建，应用无需关心。
extern fn aui_hlist(key: i32, count: i32, item_w_dp: i32, item_h_dp: i32,
                    on_bind: fn(ptr) : i32, on_tap: fn(ptr) : i32,
                    user: ptr) : i32;
extern fn aui_hlist_item(index: i32) : i32;
extern fn aui_hlist_first() : i32;
extern fn aui_hlist_last() : i32;
extern fn aui_hlist_tap_index() : i32;
extern fn aui_hlist_tap_key() : i32;
extern fn aui_hlist_scroll(key: i32) : i32;
extern fn aui_hlist_scroll_to(key: i32, px: i32) : i32;
// 仅测试：out = [x,y,w,h,count,first,last,offset_px]；当前窗口不含该项
// 下标时 aui_debug_hlist_item 返回 -1。
extern fn aui_debug_hlist(key: i32, out: ptr) : i32;
extern fn aui_debug_hlist_item(key: i32, index: i32, out: ptr) : i32;
// ---- 按压水波纹（v1.48）----
// 对照 HuxerUI indication.h：开启后按住走通用点击路径的控件时，从触点
// 扩散一圈主题主色的状态层（12% alpha，320 ms 线性扩散），松手后 220 ms
// 淡出。v1.48.1 起 UP/取消当拍就进入淡出并叫醒帧泵，不再等下一帧。
// 默认关闭（保持旧界面像素不变），aui_ripple(1) 打开，aui_ripple(0)
// 关闭并立即清除当前波纹；返回设置后的值。
// 覆盖按钮 / 图标按钮 / 分段 / 标签页 / 芯片 / 列表行 / 网格格 / 横向列表项 /
// 导航项等带回调的节点；对话框、浮层、下拉、组合框、日期/时间等自带按压
// 逻辑的容器不画。波纹按节点矩形与圆角裁剪，不影响命中、布局和滚动。
// v1.48.2 起，波纹帧只重画它所在的节点矩形（局部呈现），并把该矩形作为
// ANativeWindow_lock 的 dirty 区；只有“波纹是唯一变化”时才启用，波纹外
// 有任何内容变化会自动退回整屏，接口无需改动。
// v1.48.3 起，手指拖动/列表开始滚动会立即清除波纹（不淡出）；滚动帧不再
// 为波纹额外绘制，也不会因为帧泵和输入各画一帧而重复呈现。
// v1.48.4 起，滚动只重排不重新测量，拖动帧交给帧泵按 16 ms 节拍呈现；
// 每帧 trace 增加 w（等窗口锁）/C（光栅）/t（提交）毫秒数，局部帧再加
// X = 重画宽 << 12 | 高。接口与像素输出不变。
// aui_ripple_active 返回 0 空闲 / 1 按住 / 2 淡出。
extern fn aui_ripple(on: i32) : i32;
extern fn aui_ripple_active() : i32;
// 仅测试：out = [key,x,y,rad_px,alpha,phase,max_r,elapsed_ms]。
extern fn aui_debug_ripple(out: ptr) : i32;
// v2.8：DEBUG overlay 开关 + 状态（框架级内置，见 REPORT-v28.md）。
// aui_debug_overlay(0/1)：显式开/关（关时面板一并收起），返回当前开关。
// aui_debug_overlay_state：out = [on, expanded, 缎带 cx,cy,w,h,
//   面板 x,y,w,h（收起为 -1）, fps 快照, 上一帧光栅 ms]。
extern fn aui_debug_overlay(on: i32) : i32;
extern fn aui_debug_overlay_on() : i32;
extern fn aui_debug_overlay_state(out: ptr) : i32;
// v1.34：Toast / SnackBar（对照 HuxerUI presentation.h）。二者都是不挂树
// 的底部浮层，不参与页面/滚动/对话框布局。
// Toast 是被动反馈：底部居中、最多同时 4 条（新的在下、旧的向上叠），
// 深色 #1F2328 94% 底 + 白字、16/12 dp 内边距、8 dp 圆角、最大 480 dp；
// 触摸直接穿透到底层（HuxerUI pointer pass-through）。duration_ms：
// >0 毫秒后自动收起，0 = 默认 2000 ms，<0 = 常驻直到手动收起。
// 返回 >0 的句柄；文本指针需在显示期间有效（建议字面量）。
extern fn aui_toast(text: ptr, duration_ms: i32) : i32;
extern fn aui_toast_dismiss(handle: i32) : i32;
// SnackBar 是窗口内唯一、可带一个动作按钮的内容浮层：新调用替换旧的；
// 深色 #1F2328 底、白字、动作 #79C0FF，min 48 dp、最大 600 dp，底部留
// 24 dp。duration_ms 同上（默认 4000 ms）；按住动作按钮时倒计时暂停。
// 点动作按钮先收起提示再调 cb(user)；点提示表面会吞掉点击，不穿透。
// action 传 0/空串或 cb 为 0 时退化为纯消息 SnackBar。
extern fn aui_snackbar(key: i32, text: ptr, action: ptr, duration_ms: i32,
                       cb: fn(ptr) : i32, user: ptr) : i32;
extern fn aui_snackbar_dismiss() : i32;
// 仅测试：Toast 几何（out = [x,y,w,h,id,active]）/ 当前数量。
extern fn aui_debug_toast(handle: i32, out: ptr) : i32;
extern fn aui_debug_toast_count() : i32;
// 仅测试：SnackBar out = [x,y,w,h,ax,ay,aw,ah,id,rem_ms,state]；
// state 0 无 / 1 可见 / 2 动作按下；没有时返回 -1。
extern fn aui_debug_snackbar(out: ptr) : i32;
// 仅测试：当前不确定进度相位（0..65535）。
extern fn aui_debug_spin_phase() : i32;
// v1.20：滑块。value / step 都是千分比（0..1000），step 是吸附步长（<=1 不吸附）。
// 按下即跳到触点，拖动持续回调 cb(user)；拖动期间用 aui_slider_value(key)
// 读实时值。应用在回调里保存值并 aui_invalidate()，下一帧传入新值。
extern fn aui_slider(key: i32, value: i32, step: i32, cb: fn(ptr) : i32, user: ptr) : i32;
extern fn aui_slider_value(key: i32) : i32;
// v1.21：分段控件。容器 + aui_segment 子项，宽度均分；selected 是当前段下标。
// 点按任意一段只调容器的 cb(user)，回调里用 aui_segmented_value(容器 key)
// 读新下标，应用保存后 aui_invalidate()。段的 key 必须非 0（用于按压态）。
extern fn aui_segmented(key: i32, selected: i32, cb: fn(ptr) : i32, user: ptr) : i32;
extern fn aui_segment(key: i32, text: ptr) : i32;
extern fn aui_segmented_value(key: i32) : i32;
// v1.22：标签页。容器 + aui_tab 子项，宽度由文字决定（min 48 dp，左内边距
// 12 dp），一行排开、不换行；selected 是当前页下标，底部 2 dp 主色指示条
// 只盖住当前页。点按任意页只调容器的 cb(user)，回调里用
// aui_tabs_value(容器 key) 读新下标，应用保存后 aui_invalidate()。
// 页的 key 必须非 0（用于按压态），页内容由应用按当前下标自行渲染。
// v2.6.1：内容比容器宽时标签栏可横向拖动（8 dp slop，松手有惯性，
// 与 ScrollView/hlist 同一套 keyed scroll 表；容器 key 必须非 0
// 才能记偏移）。点按仍走通用 clickable 路径，拖动超过 slop 后
// 取消按压、松手不触发点按；超出容器的部分由绘制裁剪裁掉。
extern fn aui_tabs(key: i32, selected: i32, cb: fn(ptr) : i32, user: ptr) : i32;
extern fn aui_tab(key: i32, text: ptr) : i32;
extern fn aui_tabs_value(key: i32) : i32;
// v1.24：横向分页。容器 + aui_page 子项；每页占满视口，页与页横向排开，
// 只画当前页附近的可见部分。左右拖动超过 8 dp 且横向占优时接管手势，
// 松手按位移（>= 35% 视口宽）或速度（>= 600 px/s）提议相邻页，只调
// 容器的 cb(user)；回调里用 aui_pager_value(容器 key) 读提案，应用保存
// 后 aui_invalidate()。selected 变化也会用 200 ms ease-out 吸到目标页。
// 页的 key 必须非 0（用于命中与子控件），页内容由应用自行构建。
extern fn aui_pager(key: i32, selected: i32, cb: fn(ptr) : i32, user: ptr) : i32;
extern fn aui_page(key: i32) : i32;
extern fn aui_pager_value(key: i32) : i32;
// v1.25：模态对话框（对照 HuxerUI Dialog）。只在 open != 0 时调用；
// 后续子项都放进返回的卡片，用 aui_end() 关闭。遮罩覆盖整窗、卡片在
// 内容区居中（最大 320 dp 宽、两侧各留 24 dp），卡片默认 surface 底、
// 16 dp 圆角、24 dp 内边距、12 dp 间距，可用常规修饰器覆盖。
// 点遮罩或按系统 BACK 会调 cb(user)，应用在回调里把 open 置 0；关闭
// 原因用 aui_dialog_reason() 读（1 遮罩 / 2 BACK）。卡片空白不关闭。
// 只支持同时一层；对话框内不要放文本框（输入焦点/键盘不支持）。
extern fn aui_dialog(key: i32, open: i32, cb: fn(ptr) : i32, user: ptr) : i32;
extern fn aui_dialog_reason() : i32;
// v1.26：下拉选择（对照 HuxerUI Select）。触发器是普通布局里的一个控件，
// 选项用 aui_option 紧随其后声明，用 aui_end() 结束；选项始终存在，只有
// open != 0 时才在锚定浮层里展开（宽度跟触发器，放不下时翻到上方）。
// 点触发器（关闭状态）reason=0，应用把 open 置 1；点选项 reason=1，用
// aui_select_value(容器 key) 读下标后更新 selected 并关闭；点触发器/
// 外部 reason=2、BACK reason=3，应用关闭。浮层展开时是模态层，底层
// 不接收点击。selected 越界时显示 placeholder。同时只支持一个展开。
extern fn aui_select(key: i32, selected: i32, open: i32,
                     placeholder: ptr, cb: fn(ptr) : i32, user: ptr) : i32;
extern fn aui_option(key: i32, text: ptr) : i32;
extern fn aui_select_value(key: i32) : i32;
extern fn aui_select_reason() : i32;
// v1.35：菜单（对照 HuxerUI Menu）。只在 open != 0 时调用；返回的节点
// 后面用 aui_menu_item / aui_menu_separator 声明条目，aui_end() 结束。
// 默认锚在 anchor_key 对应节点下方（放不下翻到上方），也可以 aui_menu_at
// 指定屏幕左上角。宽度取最宽条目（最小 180 dp），条目最少 36 dp 高，
// 内容超高时菜单内可拖动滚动；同时只允许一个菜单。
// 关闭时调 cb(user)，或用 aui_menu_reason() 读（1 条目 / 2 外部 / 3 BACK）；
// 点中条目时先用 aui_menu_item_key() 读条目 key，再调条目自己的 cb。
// flags：AUI_MENU_CHECKED 显示勾选，AUI_MENU_DISABLED 置灰且不可点。
extern let AUI_MENU_CHECKED: i32;
extern let AUI_MENU_DISABLED: i32;
extern let AUI_MENU_REASON_ITEM: i32;
extern let AUI_MENU_REASON_OUTSIDE: i32;
extern let AUI_MENU_REASON_BACK: i32;
extern fn aui_menu(key: i32, anchor_key: i32, open: i32,
                   cb: fn(ptr) : i32, user: ptr) : i32;
extern fn aui_menu_at(key: i32, px: i32, py: i32, open: i32,
                      cb: fn(ptr) : i32, user: ptr) : i32;
extern fn aui_menu_item(key: i32, text: ptr, flags: i32,
                        cb: fn(ptr) : i32, user: ptr) : i32;
extern fn aui_menu_separator(key: i32) : i32;
extern fn aui_menu_reason() : i32;
extern fn aui_menu_item_key() : i32;
extern fn aui_menu_dismiss() : i32;
// 仅测试：菜单 out = [x,y,w,h,key,reason,item_key,off,maxoff,items]；
// 条目 out = [x,y,w,h,index,flags,checked,disabled]；没有时返回 -1。
extern fn aui_debug_menu(out: ptr) : i32;
extern fn aui_debug_menu_item(key: i32, out: ptr) : i32;
extern fn aui_debug_menu_touch(out: ptr) : i32;
// v1.36：图标按钮（对照 HuxerUI IconButton）。内置矢量图标，40 dp 触控
// 方块、20 dp 图形、4 dp 圆角、32 dp 按下指示层；颜色取主题文字色，
// 禁用时降到 38% 不透明度且不接收点击。icon 取 AUI_ICON_*；size_dp 传 0
// 用默认 40 dp，图形按方块的一半绘制。图标用圆头粗线段/圆环/三角形
// 现场绘制（与勾选标记同一套抗锯齿），不占图片内存。
// aui_icon 是同一套图形的只读版本（默认 20 dp），可放进行/列/流式布局，
// 用于工具条、列表前缀或图例；颜色同样跟随主题文字色。
extern let AUI_ICONBTN_DISABLED: i32;
extern let AUI_ICON_PLUS: i32;
extern let AUI_ICON_MINUS: i32;
extern let AUI_ICON_CHECK: i32;
extern let AUI_ICON_CLOSE: i32;
extern let AUI_ICON_CHEVRON_LEFT: i32;
extern let AUI_ICON_CHEVRON_RIGHT: i32;
extern let AUI_ICON_CHEVRON_UP: i32;
extern let AUI_ICON_CHEVRON_DOWN: i32;
extern let AUI_ICON_ARROW_LEFT: i32;
extern let AUI_ICON_ARROW_RIGHT: i32;
extern let AUI_ICON_SEARCH: i32;
extern let AUI_ICON_MORE: i32;
extern let AUI_ICON_MENU: i32;
extern let AUI_ICON_PLAY: i32;
extern let AUI_ICON_PAUSE: i32;
extern let AUI_ICON_STAR: i32;
extern let AUI_ICON_TRASH: i32;
extern let AUI_ICON_EDIT: i32;
extern let AUI_ICON_HOME: i32;
extern let AUI_ICON_SETTINGS: i32;
extern let AUI_ICON_CALENDAR: i32;
extern let AUI_ICON_DOWNLOAD: i32;
extern fn aui_icon_button(key: i32, icon: i32, size_dp: i32, flags: i32,
                          cb: fn(ptr) : i32, user: ptr) : i32;
extern fn aui_icon(key: i32, icon: i32, size_dp: i32) : i32;
