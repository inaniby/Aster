// 导航项 out = [x,y,w,h,index,flags,selected,disabled]。
extern fn aui_debug_nav_bar(key: i32, out: ptr) : i32;
extern fn aui_debug_nav_item(key: i32, out: ptr) : i32;
// v1.42：侧边导航栏（对照 HuxerUI NavigationPane）。容器 + aui_nav_pane_item
// 子项；收缩态 72 dp 只画图标，展开态（AUI_NAV_PANE_EXPANDED）256 dp 画
// 图标 + 单行文字。每项高 48 dp，选中项有 32 dp 高的指示胶囊：收缩态
// 56 dp 宽居中，展开态铺满项宽。选中语义与底部导航栏一致：selected 由
// 应用维护，点未选中且启用的项只调容器 cb(user)，回调里用 aui_nav_value
// 读请求下标；点已选中项或禁用项不回调。默认左右各 8 dp 内边距（aui_pad
// 可覆盖水平与垂直），背景默认 surface，可用 aui_bg 覆盖。栏宽固定，
// 放进行里时请用 aui_align(3) 让它纵向铺满，内容列再给 aui_weight(1)。
extern let AUI_NAV_PANE_COMPACT: i32;
extern let AUI_NAV_PANE_EXPANDED: i32;
extern fn aui_nav_pane(key: i32, selected: i32, expanded: i32,
                       cb: fn(ptr) : i32, user: ptr) : i32;
extern fn aui_nav_pane_item(key: i32, icon: i32, label: ptr, flags: i32) : i32;
// 仅测试：侧边栏 out = [x,y,w,h,selected,count,expanded,pad]；
// 侧边项 out = [x,y,w,h,index,flags,selected,disabled]。
extern fn aui_debug_nav_pane(key: i32, out: ptr) : i32;
extern fn aui_debug_nav_pane_item(key: i32, out: ptr) : i32;
// v1.44：可编辑组合框（对照 HuxerUI ComboBox）。aui_combo 创建单行输入
// 触发器，hint 是空文本时的占位符；文本与 text_field 共用按键文本池，
// 所以 aui_text_set / aui_text_append / aui_text_backspace / aui_text_value
// 都能直接用（key 就是 combo 的 key）。open != 0 时，紧随其后声明的
// aui_combo_suggestion 会摆进锚在触发器下方（放不下翻到上方）的浮层，
// 宽跟触发器、最多铺满内容区，每项高 48 dp；关闭时不参与布局。建议内容
// 由应用过滤后声明，库不做匹配。
// 点触发器：聚焦并回调 reason=0（AUI_COMBO_REASON_FIELD），应用把 open
// 置 1；点建议：reason=1（PICK），回调里用 aui_combo_value(容器 key) 读
// 当前建议序列里的下标，或用 aui_combo_pick_key() 读建议自己的 key（建议
// 经应用过滤后下标会变，用 key 映射选项更稳）；点外部或展开时再点触发器：
// reason=2；系统 BACK：reason=3。展开
// 期间是半模态：触发器/浮层/外部照常判定，屏幕键盘的按键仍可点，方便
// 边输入边看过滤结果。与对话框/菜单/下拉/浮层/底部弹层互斥。
// 空文本聚焦时光标停在首位（x + pad），占位符右移 4 dp 让开光标；
// 有正文时光标跟在文本末尾，超宽文本截头后停在右端。
extern let AUI_COMBO_REASON_FIELD: i32;
extern let AUI_COMBO_REASON_PICK: i32;
extern let AUI_COMBO_REASON_OUTSIDE: i32;
extern let AUI_COMBO_REASON_BACK: i32;
extern fn aui_combo(key: i32, hint: ptr, open: i32,
                    cb: fn(ptr) : i32, user: ptr) : i32;
extern fn aui_combo_suggestion(key: i32, text: ptr) : i32;
extern fn aui_combo_value(key: i32) : i32;
extern fn aui_combo_pick_key() : i32;
extern fn aui_combo_reason() : i32;
// 仅测试：组合框 out = [x,y,w,h,open,count,pad,focused]；
// 建议项 out = [x,y,w,h,index,visible,pressed,0]；
// 浮层矩形 out = [x,y,w,h]（没有展开时返回 -1）。
extern fn aui_debug_combo(key: i32, out: ptr) : i32;
extern fn aui_debug_combo_suggestion(key: i32, out: ptr) : i32;
extern fn aui_debug_combo_panel(out: ptr) : i32;
// v1.38：底部弹出层（对照 HuxerUI BottomSheet）。只在 open != 0 时调用；
// 后续子项放进返回的卡片，aui_end() 结束。遮罩为 42% 黑覆盖整窗，卡片
// 贴底、左右各留 16 dp、最大 640 dp 宽、顶部 14 dp 圆角、20 dp 内边距、
// 12 dp 间距；高度按内容测量，最多占内容区 85%（超出部分被裁剪，长列表
// 请用 aui_scroll 包住并让它占用剩余高度）。进入时以 240 ms ease-out 从
// 底部滑入。卡片顶部 32 dp 是拖拽区，下拉超过卡片高度 1/4（最少 96 dp）
// 即视为关闭。点遮罩 reason=1、系统 BACK reason=2、下拉 reason=3，都会
// 调 cb(user) 且不再下传手势，应用在回调里把 open 置 0。
// 同时只支持一层，并与 aui_dialog 互斥（任一方打开时另一方返回 -1）。
// 拖拽手柄默认显示（32×4 dp，居中）；紧跟 aui_sheet 调用
// aui_sheet_handle(0) 可隐藏，传非 0 恢复。
extern fn aui_sheet(key: i32, open: i32, cb: fn(ptr) : i32, user: ptr) : i32;
extern fn aui_sheet_handle(show: i32) : i32;
extern fn aui_sheet_reason() : i32;
// 仅测试：底部弹出层 out = [x,y,w,h,drag_px,flags]（像素）；没有时返回 -1。
extern fn aui_debug_sheet(out: ptr) : i32;
// v1.39：锚定浮层（对照 HuxerUI Popup）。任意内容挂在锚点旁边，不是条目
// 列表。只在 open != 0 时调用；后续子项放进返回的浮层，aui_end() 结束。
// 默认锚在 anchor_key 对应节点下方、左对齐（4 dp 间距），放不下自动翻到
// 反方向，最后夹在内容区 8 dp 边距内；aui_popup_at 改为以屏幕点为锚点。
// 宽度默认取孩子最宽 + 32 dp（上下各 16 dp 内边距），最少 96 dp、最多
// 360 dp，也可以用 aui_popup_width 固定；高度按内容测量并夹在内容区。
// 浮层是 1 dp 描边 + 12 dp 圆角的 surface，孩子之间 12 dp 间距。
// 交互是模态的：点浮层外关闭（reason 1）、系统 BACK 关闭（reason 2）、
// aui_popup_dismiss 关闭（reason 3）；内容里的按钮/滑块照常工作，空白的
// 内边距吞掉点击。关闭时调 cb(user)，应用在回调里把 open 置 0。
// 同时只允许一层，且与 dialog / sheet / menu / 展开的 select 互斥。
extern let AUI_POPUP_BELOW: i32;
extern let AUI_POPUP_ABOVE: i32;
extern let AUI_POPUP_RIGHT: i32;
extern let AUI_POPUP_LEFT: i32;
extern let AUI_POPUP_ALIGN_START: i32;
extern let AUI_POPUP_ALIGN_CENTER: i32;
extern let AUI_POPUP_ALIGN_END: i32;
extern fn aui_popup(key: i32, anchor_key: i32, open: i32,
                    cb: fn(ptr) : i32, user: ptr) : i32;
extern fn aui_popup_at(key: i32, px: i32, py: i32, open: i32,
                       cb: fn(ptr) : i32, user: ptr) : i32;
extern fn aui_popup_place(side: i32, align: i32) : i32;
extern fn aui_popup_width(dp: i32) : i32;
extern fn aui_popup_reason() : i32;
extern fn aui_popup_dismiss() : i32;
// 仅测试：锚定浮层 out = [x,y,w,h,side,align,reason]（像素）；没有时返回 -1。
extern fn aui_debug_popup(out: ptr) : i32;
// v1.27：工具提示（对照 HuxerUI Tooltip）。修饰器挂在“最近创建的节点”上；
// 如果刚 aui_end() 关闭了容器，则挂到那个容器（容器提示要先 end 再声明）。
// 气泡不进节点树、不影响布局与命中：触摸按住 500 ms 不动才显示（移动超过
// 8 dp 取消），按住期间一直显示，松手后再停留 1.5 s。长按显示后本次抬起
// 不再触发控件点击；短按照常点击。任一新的按下、系统 BACK、换页、打开
// 对话框/下拉都会立即收起。side 取 AUI_ANCHOR_*，align 取 AUI_TIP_ALIGN_*；
// 默认锚点上方居中，放不下自动翻到对侧并夹在内容区内 8 dp 边距。
// 同一时刻只显示一个（后按住的目标会顶掉前一个）；文本指针需在显示期间
// 保持有效（建议传字面量）。
extern let AUI_ANCHOR_ABOVE: i32;
extern let AUI_ANCHOR_BELOW: i32;
extern let AUI_ANCHOR_RIGHT: i32;
extern let AUI_ANCHOR_LEFT: i32;
extern let AUI_TIP_ALIGN_START: i32;
extern let AUI_TIP_ALIGN_CENTER: i32;
extern let AUI_TIP_ALIGN_END: i32;
extern fn aui_tooltip(text: ptr, side: i32, align: i32) : i32;
// v2.7：长按手势（对照 HuxerUI LongPressGesture）。修饰器，挂在最近创建
// 的节点上（刚 aui_end() 关闭容器则挂到容器）。DOWN 后 500 ms 内不动
// 即触发一次 cb(user)，回调里用 aui_long_press_key() 读触发节点的 key；
// 触发后本次抬起不再补发点按（与 tap 互斥）。提前抬起、移动超过 8 dp、
// 变成滚动拖拽、系统取消或 BACK 都取消待定。同一时刻只有一个待定。
// 阈值 500 ms：Android ViewConfiguration.getLongPressTimeout() 与
// HuxerUI LongPressGesture 默认一致。
extern fn aui_long_press(cb: fn(ptr) : i32, user: ptr) : i32;
extern fn aui_long_press_key() : i32;

// v2.18：捏合手势（对照 HuxerUI TransformGesture 的 scale + focal
// point；rotation 不在本轮）。修饰器，挂在最近创建的节点上（刚 aui_end()
// 关闭容器则挂到容器）。两指才识别：第二指按下时接管并调一次 cb(user)，
// 每次 MOVE 调一次，一指抬起或取消时再调一次；回调里用下面的读数器读
// 状态。接管时取消单指的点按/长按待定/滚动拖拽；结束后剩下的手指不恢复
// 滚动、不补发点按、不起 fling。同一节点重复声明覆盖回调；登记表 8 项，
// 满了返回 -1。两指起始间距 < 8 dp 不接管（防退化）。
extern fn aui_pinch(cb: fn(ptr) : i32, user: ptr) : i32;
// 自手势开始的累计缩放，Q16.16（65536 = 1.00×）；结束后保持终值。
extern fn aui_pinch_scale() : i32;
// 当前焦点（质心），px。
extern fn aui_pinch_cx() : i32;
extern fn aui_pinch_cy() : i32;
// 质心相对上次更新的位移（平移），px，可正负。
extern fn aui_pinch_dx() : i32;
extern fn aui_pinch_dy() : i32;
// 捏合进行中为 1，否则 0。
extern fn aui_pinch_active() : i32;
// 拥有本次/上次手势的节点 key。
extern fn aui_pinch_key() : i32;
// 已登记的捏合节点数。
extern fn aui_pinch_n() : i32;

// v2.19：语义树导出（对照 HuxerUI semantics.h；一期只做导出，不接系统）。
// 角色常量（0 = 未设置，走 kind 默认角色）；aui_semantics 挂在最近创建
// 的节点上（刚 aui_end() 关闭容器则挂到容器）：role 为 AUI_SEM_*，0 =
// 不覆盖角色；label 为 NUL 结尾 UTF-8，0 = 不覆盖 label；重复声明覆盖。
// aui_sem_hide 把最近节点及其子树排除出导出。aui_sem_export 把整棵活动
// 树写进调用方缓冲（一行一个节点：<角色> "<label>" key=<key> [x,y,w,h]，
// 2 空格缩进，先序，行尾 \n，整体 NUL 终止）；成功返回字节数（不含 NUL），
// 缓冲不够返回 -1（缓冲内为截断前缀 + NUL 终止）。
extern let AUI_SEM_GENERIC: i32;
extern let AUI_SEM_TEXT: i32;
extern let AUI_SEM_HEADING: i32;
extern let AUI_SEM_IMAGE: i32;
extern let AUI_SEM_BUTTON: i32;
extern let AUI_SEM_LINK: i32;
extern let AUI_SEM_CHECKBOX: i32;
extern let AUI_SEM_RADIO: i32;
extern let AUI_SEM_SWITCH: i32;
extern let AUI_SEM_SLIDER: i32;
extern let AUI_SEM_PROGRESS: i32;
extern let AUI_SEM_COMBOBOX: i32;
extern let AUI_SEM_TEXTFIELD: i32;
extern let AUI_SEM_SEARCHFIELD: i32;
extern let AUI_SEM_TAB: i32;
extern let AUI_SEM_TABLIST: i32;
extern let AUI_SEM_MENU: i32;
extern let AUI_SEM_MENUITEM: i32;
extern let AUI_SEM_DIALOG: i32;
extern let AUI_SEM_NAVIGATION: i32;
extern let AUI_SEM_LIST: i32;
extern let AUI_SEM_LISTITEM: i32;
extern let AUI_SEM_GRID: i32;
extern let AUI_SEM_GRIDCELL: i32;
extern let AUI_SEM_SCROLLVIEW: i32;
extern let AUI_SEM_TREE: i32;
extern let AUI_SEM_TREEITEM: i32;
extern let AUI_SEM_SEPARATOR: i32;
extern fn aui_semantics(role: i32, label: ptr) : i32;
extern fn aui_sem_hide() : i32;
extern fn aui_sem_export(buf: ptr, cap: i32) : i32;

// v2.9：协作任务 / 延迟（对照 HuxerUI Task/Delay，docs/design/tasks.md）。
// Delay(500ms) 在 UI 线程恢复、回调里可直接改 State；Aster 无闭包与
// 协程，退化为一次性延时回调：aui_delay(ms, cb, user) 注册后由帧泵在
// 到期时调一次 cb(user)（UI 线程，可调状态 setter）；ms 为毫秒，0 表
// 示下一拍就触发（deadline = 当前时刻），负数拒绝。返回 handle（槽位
// 下标 >= 0），-1 = 参数错（ms < 0 或 cb 为空）或登记表已满（32 项）。
// 同一时刻最多 32 个待定任务；满了不扩容、不排队。
// 触发顺序：按 deadline 升序，同 deadline 按注册顺序；回调里再注册
// 新任务或取消其他任务都安全（触发时先取最早到期者、槽位先释放再调
// 回调，每拍最多触发 32 次）。任务触发后泵会标脏重画一帧。
extern fn aui_delay(ms: i32, cb: fn(ptr) : i32, user: ptr) : i32;
// 取消待定任务：1 = 取消了一个待定任务；0 = 句柄未知、已触发或已取消
// （安全空操作，不报错）。
extern fn aui_delay_cancel(handle: i32) : i32;
// v1.28：日期选择（对照 HuxerUI DatePicker）。单个叶子控件，内部自有
// 日网格/年网格两种视图；y/m/d 为应用持有的当前值（任一项越界时按日历
// 归一化，如 2024-02-31 → 2024-02-29），显示月份由库内维护，切换月份
// 不改变选中值。标题中间可点，在“年月”和 20 年一页的年网格间切换；
// “<”“>”按当前视图翻月/翻 20 年，整月超出 min/max 时点击无效。点日期或
// 年份后选中值变化才调 cb(user)，应用用 aui_date_selected(key) 读取，导航
// 与视图切换不发回调。min/max 也是闭区间且可只设一头；week_start 为
// 每周第一天（0 周日 .. 6 周六，默认 0）。这三个修饰器作用于最近创建的
// 日期选择器，需紧跟在 aui_date_picker 之后调用。宽度在列/滚动容器里
// 撑满可用宽度，否则按 7 列 32 dp 单元格出固有宽度；格宽按可用宽度
// 均分、上限 36 dp，7 行日网格 + 44 dp 页眉。日期回调里应重建页面并把
// 新值传给 aui_date_picker。
extern fn aui_date_picker(key: i32, y: i32, m: i32, d: i32,
                          cb: fn(ptr) : i32, user: ptr) : i32;
extern fn aui_date_min(y: i32, m: i32, d: i32) : i32;
extern fn aui_date_max(y: i32, m: i32, d: i32) : i32;
extern fn aui_date_week_start(wd: i32) : i32;
extern fn aui_date_selected(key: i32, out: ptr) : i32;

// ---- 时间选择（v1.29）----
// 对照 HuxerUI TimePicker：52 dp 页眉（时/分两个字段 + 可选 AM/PM 组）+
// 直径至多 208 dp 的圆表盘，纵向容器里撑满可用宽度，否则固有宽 232 dp。
// 受控时刻由应用保存（hour 0..23、minute 0..59，超界夹紧）；点表盘或
// AM/PM、或点选时/分字段切换表盘后，值变化才调 cb(user)，应用用
// aui_time_selected(key, out) 读取新值。默认 24 小时制、步长 1 分钟；
// aui_time_step 只接受 1..60 且整除 60 的分钟数，aui_time_12h 打开
// 12 小时制（一圈 12 个标签 + AM/PM）。二者作用于最近创建的时间选择器，
// 需紧跟在 aui_time_picker 之后调用。受控值不强制吸附，只有表盘输入
// 才按步长量化。24 小时制外圈 1..12、内圈 00/13..23；分钟表盘每 5 分钟
// 一个标签，角度按步长量化。表盘按下即取值、拖动连续更新，选时态松手
// 自动切到选分。
extern fn aui_time_picker(key: i32, hour: i32, minute: i32,
                          cb: fn(ptr) : i32, user: ptr) : i32;
extern fn aui_time_step(minutes: i32) : i32;
extern fn aui_time_12h(on: i32) : i32;
extern fn aui_time_selected(key: i32, out: ptr) : i32;

// ---- 下拉刷新（v1.30）----
// 纵向滚动容器，只有内容一个子节点。内容在顶部时继续下拖产生阻尼位移
// （0.45，最多 96 dp），松手超过 68 dp 触发一次 cb(user)，指示圈旋转
// 并收进 52 dp 的刷新位。refreshing 由应用持有：回调里把状态置 1 后
// invalidate，刷新期间保持旋转；置 0 后指示圈吸附回顶部。应用没有
// 定时器也不影响体验：回调触发后即使 refreshing 立刻回到 0，指示圈
// 仍会转满 700 ms 再收起。key 必须 > 0，同时最多 16 个。
extern fn aui_refresh_box(key: i32, refreshing: i32,
                          cb: fn(ptr) : i32, user: ptr) : i32;
// 仅测试：当前内容下移量（像素）、状态（0 空闲 / 1 下拉 / 2 旋转 /
// 3 吸附）、旋转相位（0..65535）。
extern fn aui_debug_refresh(key: i32) : i32;
extern fn aui_debug_refresh_state(key: i32) : i32;
extern fn aui_debug_refresh_phase(key: i32) : i32;
extern fn aui_text_field(key: i32, hint: ptr) : i32;
extern fn aui_keyboard(target_key: i32) : i32;
extern fn aui_key(key: i32, code: i32) : i32;
extern fn aui_spacer(key: i32, dp: i32) : i32;
extern fn aui_image(key: i32, rgba: ptr, w: i32, h: i32) : i32;

// ---- Canvas 自定义绘图节点（v2.6；对照 HuxerUI Canvas，见 GAP.md §4）----
// 应用给一个 draw_fn(ctx)，框架在场景构建时于节点矩形内调用它，回调
// 只发绘制命令（aui_cv_*），所发命令裁剪到节点矩形。参数一律 dp，与
// 现有布局一致。w_dp == 0 表示无固有宽（配 aui_align(3) 撑满父容器）；
// h_dp 是固有高（须 > 0）。draw_fn 的形态与现有 (fn, ctx) 回调一致。
// 命中测试 v1 跳过 Canvas 内部：点按不调 draw_fn（draw_fn 不是点击
// 回调），Canvas 内的滚动仍走父容器。合同见 aui_impl.ast 的 canvas
// 节与 ADOPTION-NOTES.md：回调里只发绘制命令，不改状态、不建控件；
// 越界行为未定义，不静默兜底。
extern fn aui_canvas(key: i32, w_dp: i32, h_dp: i32,
                     draw_fn: fn(ptr) : i32, user: ptr) : i32;
// 仅绘制回调内可用：当前 Canvas 的尺寸（dp）写进 out[0..1]，返回 0；
// 回调外调用返回 -1（out 不动）。draw_fn 靠它居中构图（HuxerUI 的
// PaintContext 收到的 Size 在此等价）。
extern fn aui_cv_size(out: ptr) : i32;
// 绘制原语（仅绘制回调内可用；回调外调用返回 -1，不发命令）：
// 坐标一律相对 Canvas 左上角（dp）；圆角/环厚/线半宽以 dp 计。
// rect：radius_dp == 0 为直角矩形，> 0 为圆角矩形。text：单行，
// x/y 为行框左上角，颜色为文字色。image：rgba 为 RGBA8888 行紧排
// （stride = iw*4），w/h 为目标尺寸（dp），iw/ih 为源尺寸（像素）。
// ring：ring_dp 为环厚；0 为实心圆盘。tri：dir 0 朝右、1 朝下。
// line：half_dp 为半宽（线宽 = 2 * half_dp）。
// half：半圆填充，dir 0 左 / 1 右 / 2 上 / 3 下（直径边含在内）。
// arc：弧线描边，start_deg/span_deg 为度数（0 = 12 点，顺时针）。
// dashring：虚线环（整圈），dash_deg/gap_deg 为度数。
extern fn aui_cv_rect(x: i32, y: i32, w: i32, h: i32, color: i32, radius_dp: i32) : i32;
extern fn aui_cv_text(x: i32, y: i32, text: ptr, color: i32) : i32;
extern fn aui_cv_image(x: i32, y: i32, w: i32, h: i32, rgba: ptr, iw: i32, ih: i32) : i32;
extern fn aui_cv_ring(x: i32, y: i32, d: i32, color: i32, ring_dp: i32) : i32;
extern fn aui_cv_tri(x: i32, y: i32, w: i32, h: i32, color: i32, dir: i32) : i32;
extern fn aui_cv_line(x0: i32, y0: i32, x1: i32, y1: i32, color: i32, half_dp: i32) : i32;
extern fn aui_cv_half(x: i32, y: i32, d: i32, color: i32, dir: i32) : i32;
extern fn aui_cv_arc(x: i32, y: i32, d: i32, color: i32, thick_dp: i32, start_deg: i32, span_deg: i32) : i32;
extern fn aui_cv_dashring(x: i32, y: i32, d: i32, color: i32, thick_dp: i32, start_deg: i32, dash_deg: i32, gap_deg: i32) : i32;
extern fn aui_end() : i32;

// ---- PNG 解码（v1.13）----
// 纯原生解码 8 位、非隔行 PNG：灰度 / 真彩 / 调色板 / 灰度+alpha / RGBA，
// 支持 tRNS 透明和 0~4 全部行过滤器；zlib 流支持 stored / fixed / dynamic
// 三种 deflate 块。输出 RGBA8888（字节序 R,G,B,A），行紧排（stride = w*4）。
// 不支持 16 位、隔行和色彩管理块，遇到返回 -2；不校验块 CRC（资源可信），
// 但所有长度与下标都做边界检查。
// dims 由调用方提供（i32[2]），成功时写入宽高，失败写 0。
// 返回：0 成功，-1 不是 PNG，-2 格式不支持，-3 缓冲不够，-4 数据损坏。
// 行宽上限 32768 字节（RGBA 约 8192 像素）。
extern fn aui_png_decode(data: ptr, len: i32, out: ptr, cap: i32, dims: ptr) : i32;
// 从库内固定 1 MiB 池分配并解码，失败返回 0；池用 aui_png_pool_reset 复位。
extern fn aui_png_decode_pool(data: ptr, len: i32, dims: ptr) : ptr;
extern fn aui_png_pool_reset() : i32;

// ---- 状态（256 槽，按 i32 key 寻址）----
extern fn aui_state_get(key: i32) : i32;
extern fn aui_state_set(key: i32, value: i32) : i32;
// Phase 0：显式释放一个 state 槽位（1 = 释放了一个，0 = key 不存在）。
extern fn aui_state_release(key: i32) : i32;

// ---- 可诊断错误（Phase 0 真正回收）----
// 最近一次错误码，0 = 无错误。A-10x 内存与容量，A-12x 线程与回调。
extern fn aui_last_error() : i32;
extern fn aui_clear_error() : i32;
// 标准库 arena 已用字节（只读，供回收探针读基线）。
extern fn aui_arena_used() : i32;

// ---- 回调复用池（Phase 0 真正回收，固定 64 槽）----
// 注册返句柄（(代数 << 8) | 槽下标）；满记 A-120 返 -1；Window 已退休记 A-122 返 -1。
extern fn aui_cb_register(cb: fn(ptr) : i32, user: ptr) : i32;
// 注册闭包回调：v 指向闭包值的 16 字节 {code, env}，只拷贝两个指针，
// 不产生 thunk、不分配 arena。另有 aui_cb_register_closure_arg(v, arg)
// 指定节点调用实参。
extern fn aui_cb_register_closure_ptr(v: ptr) : i32;
extern fn aui_cb_register_closure_arg(v: ptr, arg: ptr) : i32;
// 按句柄调用（fn 形态调 fn1(arg)，闭包形态调 fn2(env, arg)）。
// 句柄无效/已注销记 A-121 返 -1。
extern fn aui_cb_invoke(handle: i32, arg: ptr) : i32;
// 注销句柄（1 = 注销了一个，0 = 句柄无效/已注销，记 A-121）。
extern fn aui_cb_release(handle: i32) : i32;
// Window 退休：禁新注册并注销全部在用槽，返注销的槽数。
extern fn aui_cb_retire_all() : i32;
// 节点回调分派 thunk：节点 cb 挂此函数、user 挂 ptr(handle)。
extern fn aui_cb_node_thunk(user: ptr) : i32;
// 重置池子（测试用；也清 retired 标志）。
extern fn aui_cb_init() : i32;
// 回调池与帧区度量（aui_debug_* 惯例）。
extern fn aui_debug_cb_used() : i32;
extern fn aui_debug_cb_hwm() : i32;
extern fn aui_debug_cb_cycles() : i32;
extern fn aui_debug_cb_retired() : i32;
extern fn aui_debug_frame_seq() : i32;
extern fn aui_debug_frame_sealed() : i32;
extern fn aui_debug_frame_node_hwm() : i32;
extern fn aui_debug_frame_cmd_hwm() : i32;
extern fn aui_debug_frame_num_hwm() : i32;

// ---- 焦点 / 文本（v1.7）----
extern fn aui_focus(key: i32) : i32;
extern fn aui_focus_get() : i32;
extern fn aui_text_value(key: i32) : ptr;
extern fn aui_text_len(key: i32) : i32;
extern fn aui_text_append(key: i32, ch: i32) : i32;   // ch = Unicode 码点
extern fn aui_text_backspace(key: i32) : i32;         // 删一个 UTF-8 码点
extern fn aui_text_clear(key: i32) : i32;
extern fn aui_text_set(key: i32, text: ptr, len: i32) : i32;

// ---- 页面栈 / 返回键（v1.8）----
// 路由值由应用解释（建议 >0）；push/pop/reset 自动清焦点并重建。
// KEYCODE_BACK：先收键盘，再逐级 pop，根页面调用 aui_finish。
extern fn aui_route() : i32;
extern fn aui_nav_depth() : i32;
extern fn aui_nav_push(route: i32) : i32;
extern fn aui_nav_pop() : i32;
extern fn aui_nav_reset(route: i32) : i32;
extern fn aui_finish() : i32;

// ---- 主题 / 系统适配（v1.9）----
// 调色板由系统深浅色模式自动切换；应用自定义背景时用 aui_theme_color
// 取当前主题色，树重建后颜色会跟着变。安全区按 dp 返回（向下取整）。
extern let AUI_COLOR_BG: i32;
extern let AUI_COLOR_SURFACE: i32;
extern let AUI_COLOR_PRIMARY: i32;
extern let AUI_COLOR_PRIMARY_DARK: i32;
extern let AUI_COLOR_TEXT: i32;
extern let AUI_COLOR_ON_PRIMARY: i32;
extern let AUI_COLOR_HINT: i32;
extern let AUI_COLOR_PRESSED: i32;
extern let AUI_COLOR_TINT: i32;
extern let AUI_COLOR_SCROLLBAR: i32;
extern let AUI_COLOR_KEYBOARD_BG: i32;
// v2.13：edge-to-edge 下状态栏/导航栏条带的底色，默认跟主题底色走；
// 图标颜色由框架经 JNI 换（API 30+），与条带一起切换。API 30 以下
// 或 JNI 失败时回落深色条带；应用可用 aui_set_system_bar 换成自己的颜色。
extern let AUI_COLOR_SYSTEM_BAR: i32;
extern fn aui_theme_color(role: i32) : u32;
// v2.15：主题令牌（ThemeSpec）。颜色令牌 0-11 与旧数字角色一一对应
// （0 background / 1 surface / 2 primary / 3 primary_dark /
// 4 on_surface / 5 on_primary / 6 on_surface_variant / 7 pressed /
// 8 primary_container / 9 scrollbar / 10 keyboard_bg / 11 system_bar），
// 12 scrim / 13 error / 14 inverse_surface / 15 inverse_on_surface 新增。
// aui_token_color(token) 取当前解析值（含最近的局部主题覆盖）；
// aui_theme_color(role) 是兼容入口（role 0-11 即令牌 0-11）。
extern let AUI_TOK_BACKGROUND: i32;
extern let AUI_TOK_SURFACE: i32;
extern let AUI_TOK_PRIMARY: i32;
extern let AUI_TOK_PRIMARY_DARK: i32;
extern let AUI_TOK_ON_SURFACE: i32;
extern let AUI_TOK_ON_PRIMARY: i32;
extern let AUI_TOK_ON_SURFACE_VARIANT: i32;
extern let AUI_TOK_PRESSED: i32;
extern let AUI_TOK_PRIMARY_CONTAINER: i32;
extern let AUI_TOK_SCROLLBAR: i32;
extern let AUI_TOK_KEYBOARD_BG: i32;
extern let AUI_TOK_SYSTEM_BAR: i32;
extern let AUI_TOK_SCRIM: i32;
extern let AUI_TOK_ERROR: i32;
extern let AUI_TOK_INVERSE_SURFACE: i32;
extern let AUI_TOK_INVERSE_ON_SURFACE: i32;
extern fn aui_token_color(token: i32) : u32;
// v2.15：局部主题容器。在子树内覆盖令牌（只影响子树，兄弟与树外
// 不受影响；内层覆盖优先于外层）。用法见 aui_theme_begin 的实现注释。
// aui_theme_set/aui_theme_shape 紧跟 aui_theme_begin 调用；子树以
// aui_end() 结束。没有打开的 Theme 时两者返回 -1。
extern fn aui_theme_begin(key: i32) : i32;
extern fn aui_theme_set(token: i32, color: u32) : i32;
extern fn aui_theme_shape(token: i32, dp: i32) : i32;
extern fn aui_debug_theme(out: ptr) : i32;
// v2.15：形状令牌（默认值复现 v2.11 的 8 dp 外观）：extra_small 4 /
// small 8 / medium 12 / large 16 / extra_large 28 / full 胶囊（h/2）。
// aui_shape(token) 读 dp 值；aui_shape_radius(token) 是按令牌设半径的
// 修饰器（紧跟组件调用）。间距令牌：4/8/16/24/32 dp，aui_space 读值。
extern let AUI_SHAPE_XS: i32;
extern let AUI_SHAPE_SMALL: i32;
extern let AUI_SHAPE_MEDIUM: i32;
extern let AUI_SHAPE_LARGE: i32;
extern let AUI_SHAPE_XL: i32;
extern let AUI_SHAPE_FULL: i32;
extern fn aui_shape(token: i32) : i32;
extern fn aui_shape_radius(token: i32) : i32;
extern let AUI_SPACE_XS: i32;
extern let AUI_SPACE_SM: i32;
extern let AUI_SPACE_MD: i32;
extern let AUI_SPACE_LG: i32;
extern let AUI_SPACE_XL: i32;
extern fn aui_space(token: i32) : i32;
// v2.15：排版角色（TextRole）。Body 48 px、Label 48 px + 仿粗、
// Title 64 px（行高 80 px）；aui_text_role(role) 是修饰器，紧跟
// aui_label/aui_button 调用，只对这两类节点有效。
extern let AUI_ROLE_BODY: i32;
extern let AUI_ROLE_LABEL: i32;
extern let AUI_ROLE_TITLE: i32;
extern fn aui_text_role(role: i32) : i32;
extern fn aui_debug_text_role(role: i32) : i32;
// v0.1-cn D-2a 前置：任意字号。i32 sp；−1 = 默认（走现有角色制）。
// 只对 label(5)/button(6) 有效（与 aui_text_role 同一适用范围），
// 其它种返回 −1。sp → em 像素：cell = sp * 3（正文 16 sp = 48 px，
// 与角色制同一口径），运行时 cell 钳在 8..64（sp > 21 按 21 sp 计）。
extern fn aui_text_size(sp: i32) : i32;
extern fn aui_dark() : i32;
extern fn aui_set_dark(on: i32) : i32;
extern fn aui_safe_left() : i32;
extern fn aui_safe_top() : i32;
extern fn aui_safe_right() : i32;
extern fn aui_safe_bottom() : i32;
// v1.14：Android 15 edge-to-edge 适配。默认在 API 35+ 且内容区等于
// 整窗时按 24dp 估算上下系统栏（NDK 没有 WindowInsets 查询接口）。
// aui_edge_to_edge(1) 关闭估算，内容铺满整窗；aui_set_insets 指定
// 最小安全区（dp），与系统/估算值取较大者，用于刘海等特殊设备。
extern fn aui_edge_to_edge(on: i32) : i32;
extern fn aui_set_insets(left: i32, top: i32, right: i32, bottom: i32) : i32;
// v2.13：系统栏条带颜色（0xAARRGGBB）。传 0 = 跟随主题角色
// AUI_COLOR_SYSTEM_BAR（默认跟主题底色走）。
extern fn aui_set_system_bar(color: u32) : i32;
extern fn aui_system_bar_color() : u32;
// v2.14：JNI 实测系统栏高（见 sysbar_measure_insets）。
// aui_debug_measure_insets 手动触发一次量取（返回 1 测到 / 0 回落）；
// aui_debug_insets_source 返回当前安全区来源（0 无/铺满 / 1 内容区 /
// 2 JNI 实测 / 3 24dp 估算）；aui_debug_insets_px 的 out =
// [top_px, bottom_px, top_dp, bottom_dp]，未测到时四项均为 -1。
extern fn aui_debug_measure_insets() : i32;
extern fn aui_debug_insets_source() : i32;
extern fn aui_debug_insets_px(out: ptr) : i32;

// ---- 动画（v1.10；v2.16 扩展）----
// 固定 64 个槽，按 (key, prop) 寻址；只影响绘制阶段的透明度/位移/缩放，
// 不触发 build/layout，也不改变命中测试与滚动布局。
// ALPHA 取值 0..255；TX/TY 单位 dp；SCALE 为 Q16.16（65536 = 1.0x，
// 取值 0.01x..4x）；VALUE 为通用标量（只读值，不画）。
// duration_ms <= 0 或 from == to 时直接落到终值。帧由库内自唤醒帧泵
// （v1.12：专用线程 + 16 ms 节拍）驱动，与 fling 共用，应用不必自己刷帧；
// 同一 key 再次调用且目标未变时保留当前进度（弹簧改目标时保留速度）。
// 弹簧：stiffness 劲度（1/s^2，默认 320，与 HuxerUI SpringSpec 相同），
// damping_pm 阻尼比千分比（默认 820 = 0.82）；收敛判据 |x-t|<=0.004 且
// |v|<=0.125（属性单位），5 s 硬上限强制落点。
// 关键帧：fracs/progs 为千分比数组（端点固定 0 → 1000），curves 为每段
// 缓动（与段起点对齐）；repeat 0 一次、>0 指定次数、-1 无限；
// rmode 0 每轮重起、1 往返。完成回调（aui_anim_on_done）只在自然结束
// 时调一次；改道/取消会丢掉它，需重挂。减弱动效（HuxerUI MotionScheme
// reduced_motion）：开始时直接落点，运行中下一拍一次落点。
extern let AUI_ANIM_ALPHA: i32;
extern let AUI_ANIM_TX: i32;
extern let AUI_ANIM_TY: i32;
extern let AUI_ANIM_SCALE: i32;
extern let AUI_ANIM_VALUE: i32;
extern let AUI_EASE_LINEAR: i32;
extern let AUI_EASE_OUT: i32;        // 1-(1-t)^2
extern let AUI_EASE_IN_OUT: i32;     // 3t^2-2t^3
extern let AUI_EASE_IN: i32;         // t^2
extern fn aui_anim(key: i32, prop: i32, from: i32, to: i32,
                   duration_ms: i32, curve: i32) : i32;
extern fn aui_anim_spring(key: i32, prop: i32, target: i32,
                          stiffness: i32, damping_pm: i32) : i32;
extern fn aui_anim_keyframe(key: i32, prop: i32, from: i32, to: i32,
                            ms: i32, n: i32, fracs: ptr, progs: ptr,
                            curves: ptr, repeat: i32, rmode: i32) : i32;
extern fn aui_anim_on_done(key: i32, prop: i32, cb: fn(ptr) : i32,
                           user: ptr) : i32;
extern fn aui_set_reduced_motion(on: i32) : i32;
extern fn aui_reduced_motion() : i32;
extern fn aui_anim_value(key: i32, prop: i32) : i32;
extern fn aui_anim_active() : i32;
extern fn aui_anim_reset(key: i32, prop: i32) : i32;
extern fn aui_debug_anim(key: i32, prop: i32, out: ptr) : i32;

// ---- 页面转场（v1.11）----
// aui_nav_transition 设置 push/pop/reset 时的页面转场时长（毫秒，0..1000，
// 默认 0 表示关闭）。开启后导航瞬间把旧页面的绘制命令快照下来，与重建后的
// 新页面双层交叉淡入并水平位移，期间不派发点击、BACK 被吞掉。
// 快照上限 2048 条命令 / 48 KB 文本，超出则该次转场自动退化为直切。
// aui_nav_busy 在转场进行中返回 1，可用于显示/隐藏返回键等。
//
// v1.12.0 起帧源换成自唤醒帧泵（专用 native 线程 + pipe2 唤醒 + poll 16 ms
// 节拍），不再依赖 UI 线程 looper，因此空闲页面也能按 16 ms 连续出帧。
// 转场有以下硬保证（都为了不在真机上“卡住”）：
//   1. 帧泵启动失败（pipe2 / pthread_create）时直接切成直切，绝不进入转场；
//   2. 只有 present 成功（窗口锁成功）才算一帧；失败帧不计帧、下一拍
//      重试，连续约 2 s 失败则判定帧泵不可用。即使帧泵一帧都没出，任何
//      输入事件到达时只要已超过时长就立即收尾并照常处理该事件；转场期间
//      一帧都没来（且已超时 250 ms），后续导航一律直切；转场结束 trace
//      记 Z + 实际帧数；帧泵首帧成功记 Y0，present 失败记 Y1/Y2；
//   3. 首个帧泵帧尚未来临（g_aui_pump_frames < 1）时导航一律直切（trace
//      记 a7），并主动唤醒帧泵再试，帧到之后的导航恢复正常转场；
//   4. trace 第二行写 V + 版本号，旧包/新包一眼可分。
//
// v1.12.3 起转场帧走合成快路径：两页开头都是同色不透明满屏底色时，两层
// 底色先压成一个颜色，整屏只做一次不透明填充，内容层照旧按 alpha 绘制；
// 同时转场期间 UI 线程不再同步 present（只标脏唤醒帧泵），避免和泵抢锁。
// 真机单帧从 100 ms 级降到与普通整页帧相当，240 ms 转场能出 10 帧以上。
// 转场帧耗时记 trace `q`（毫秒），窗口锁等待记 `w`（毫秒）。
extern fn aui_nav_transition(ms: i32) : i32;
extern fn aui_nav_busy() : i32;

// ---- 无宿主渲染（测试 / 离屏）----
// 先 aui_headless_init 注册 build 回调，再 aui_headless_render 渲染到调用方
// 提供的 RGBA8888 缓冲区（stride = w），返回本次绘制的命令数。
extern fn aui_headless_init(build: fn(ptr) : i32, user: ptr) : i32;
extern fn aui_headless_render(w: i32, h: i32, out: ptr) : i32;
// 仅测试：模拟 onContentRectChanged 的内容区（像素）。
extern fn aui_debug_set_content(l: i32, t: i32, r: i32, b: i32) : i32;
extern fn aui_debug_set_density(dpi: i32) : i32;
extern fn aui_debug_set_time(t: i64) : i32;
// 仅测试：待定任务数（v2.9 延迟 API；面板/诊断与 Gallery 演示用）。
extern fn aui_debug_task_pending() : i32;
// 仅测试：给 headless 测试挂一个窗口指针，走真机泵路径 pump_frame_once()。
extern fn aui_debug_set_win(win: ptr) : i32;
// 仅测试：最近一帧的节点数 / 绘制命令数。
extern fn aui_debug_node_count() : i32;
// v1.48.4：累计 build 次数（测试用；滚动帧不应逐帧重建）。
extern fn aui_debug_build_count() : i32;
// v1.48.6：最近一帧是否走了纯滚动直搬 / 帧缓冲是否可用（测试用）。
extern fn aui_debug_frame_blit() : i32;
