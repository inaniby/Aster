extern fn aui_debug_icon_button(key: i32, out: ptr) : i32;
extern fn aui_debug_icon(key: i32, out: ptr) : i32;
// v1.37：流式布局（对照 HuxerUI Flow）。子项按声明顺序从左到右排，
// 放不下就换行；aui_gap 同时作为同行子项间距和行间距。子项 align 控制
// 行内垂直对齐（0 顶 / 1 中 / 2 底 / 3 拉伸），aui_weight 让子项在
// 本行内按比例吃掉剩余宽度。宽度铺满可用宽度；主轴对齐用
// aui_flow_align（0 start / 1 center / 2 end / 3 space-between），
// 作用于最近创建的 flow，需在添加子项之前调用。
// 注意：列/卡片/滚动这类“铺满宽度”的容器放进 flow 会独占一行，
// flow 更适合标签片、按钮、图标、文本等固有宽度子项。
extern let AUI_FLOW_START: i32;
extern let AUI_FLOW_CENTER: i32;
extern let AUI_FLOW_END: i32;
extern let AUI_FLOW_SPACE_BETWEEN: i32;
extern fn aui_flow(key: i32) : i32;
extern fn aui_flow_align(a: i32) : i32;
// v1.37：分隔线（对照 HuxerUI Divider）。水平线 1 dp 粗、铺满可用宽度，
// 竖直时 1 dp 宽、默认 align = 3（行里拉伸到行高）。颜色 = 当前主题
// 文字色 12% 透明度；aui_bg 可覆盖（建议自带 alpha）。aui_pad 在水平线
// 上表现为左右缩进，在竖直线上表现为上下缩进。
extern fn aui_divider(key: i32) : i32;
extern fn aui_divider_v(key: i32) : i32;
// 仅测试：流式布局 out = [x,y,w,h,lines,justify]；
// 分隔线 out = [x,y,w,h,axis,thickness]。
extern fn aui_debug_flow(key: i32, out: ptr) : i32;
extern fn aui_debug_divider(key: i32, out: ptr) : i32;
// v1.40：顶部应用栏（对照 HuxerUI TopAppBar）。容器 + 标题 + 可选 leading
// 图标按钮；后续声明的子项都是右侧动作（按声明顺序从左到右排，间距默认 0）。
// 高度默认 48 dp（子项更高时随之增高），左右内边距 8 dp；标题单行、
// 垂直居中，无 leading 时左缩进 16 dp，有 leading 时距其 4 dp，超出可用
// 区间会被裁剪。leading_icon 取 AUI_ICON_*，传 0 表示没有 leading；
// 自动创建的 leading 按钮 key 为 -key，点击回调 cb(user)。标题对齐用
// aui_top_bar_align（0 start / 1 center，需在添加动作之前调用）；
// aui_top_bar_divider(1) 在底部画 1 px 文字色 12% 提示线（默认关闭）。
// 背景默认 surface，可用 aui_bg 覆盖；放进列里时铺满可用宽度。
extern let AUI_TOP_BAR_START: i32;
extern let AUI_TOP_BAR_CENTER: i32;
extern fn aui_top_bar(key: i32, title: ptr, leading_icon: i32,
                      cb: fn(ptr) : i32, user: ptr) : i32;
extern fn aui_top_bar_align(a: i32) : i32;
extern fn aui_top_bar_divider(show: i32) : i32;
