extern fn aui_debug_top_bar(key: i32, out: ptr) : i32;
// v1.41：底部导航栏（对照 HuxerUI NavigationBar）。容器 + 等宽的 aui_nav_item
// 子项；selected 是应用维护的当前下标（0 起，越界按无选中处理），每项内容
// 是图标 + 单行文字。点未选中且启用的项时只调容器的 cb(user)，回调里用
// aui_nav_value(容器 key) 读请求的下标；点已选中项或禁用项不回调。
// 高度最小 64 dp，选中项在图标下画 56×32 dp、16 dp 圆角的主色 12% 胶囊；
// 未选中文字默认显示，用 aui_nav_labels(0) 只显示选中项文字（需在添加子项
// 之前调用）。背景默认 surface，可用 aui_bg 覆盖；放进列里时铺满可用宽度。
extern let AUI_NAV_HIDE_UNSELECTED: i32;
extern let AUI_NAV_ITEM_DISABLED: i32;
extern fn aui_nav_bar(key: i32, selected: i32,
                      cb: fn(ptr) : i32, user: ptr) : i32;
extern fn aui_nav_item(key: i32, icon: i32, label: ptr, flags: i32) : i32;
extern fn aui_nav_labels(show: i32) : i32;
extern fn aui_nav_value(key: i32) : i32;
