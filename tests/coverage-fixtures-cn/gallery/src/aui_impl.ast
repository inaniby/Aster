let g_aui_time_down_y: i32 = 0;
let g_aui_time_drag: i32 = 0;
let g_aui_time_dial: i32 = 0;                 // 1 = 表盘已捕获本次手势
// 表盘几何缓存（Q16.16 px）。
let g_aui_tg_cx: i32 = 0;
let g_aui_tg_cy: i32 = 0;
let g_aui_tg_cw: i32 = 0;
let g_aui_tg_hx: i32 = 0;                     // 头部（含周期组）左上
let g_aui_tg_hw: i32 = 0;
let g_aui_tg_hh: i32 = 0;
let g_aui_tg_fw: i32 = 0;                     // 单个字段宽
let g_aui_tg_sw: i32 = 0;                     // 冒号宽
let g_aui_tg_pw: i32 = 0;                     // AM/PM 组宽
let g_aui_tg_ps: i32 = 0;                     // 组与字段间距
let g_aui_tg_hfx: i32 = 0;
let g_aui_tg_mfx: i32 = 0;
let g_aui_tg_pfx: i32 = 0;
