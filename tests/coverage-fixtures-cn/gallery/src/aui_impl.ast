let g_aui_tg_dcy: i32 = 0;
let g_aui_tg_dr: i32 = 0;
let g_aui_tg_dial_y: i32 = 0;
// 12 个 30° 单位向量与 atan 八分段线性表；库内不放浮点，
// 首次使用 time_tab_init 写进 .bss（全局数组不能用非零字面量初始化）。
let g_aui_time_uvx: i32[12] = 0;
let g_aui_time_uvy: i32[12] = 0;
let g_aui_time_atan: i32[9] = 0;
let g_aui_time_tab: i32 = 0;
let g_aui_time_ax: i32 = 0;                   // 选中点在表盘上的坐标
let g_aui_time_ay: i32 = 0;

// ---- 下拉刷新（v1.30）----
// 对照 HuxerUI RefreshBox：纵向滚动容器，内容在顶部时继续下拖产生
// 阻尼位移；松手超过阈值触发一次回调，指示圈开始旋转。位移与旋转
// 相位按 key 存在树外，重建不丢。refreshing 由应用持有；应用清除后
// 指示器回位。没有应用定时器，所以回调触发后即使应用立刻把
// refreshing 置 0，指示器也会至少转满 700 ms 再收起（反馈窗口）。
let AUI_REF_CAP: i32 = 16;
let AUI_REF_ACK_NS: i64 = 700000000;
let g_aui_ref_key: i32[16] = 0;
let g_aui_ref_disp: i32[16] = 0;              // 内容下移，Q16.16 px
let g_aui_ref_on: i32[16] = 0;                // 应用传入的 refreshing
let g_aui_ref_phase: i32[16] = 0;             // 指示圈旋转相位，0..65535
let g_aui_ref_anim: i32[16] = 0;              // 1 = 位移正在吸附
let g_aui_ref_from: i32[16] = 0;
let g_aui_ref_to: i32[16] = 0;
let g_aui_ref_t0: i64[16] = 0;
let g_aui_ref_dur: i64[16] = 0;
let g_aui_ref_ack: i64[16] = 0;               // 反馈窗口截止时刻，ns
let g_aui_ref_spin_t: i64[16] = 0;            // 上一次算相位的时间
let g_aui_ref_used: i32 = 0;
let g_aui_ref_drag_key: i32 = 0;
let g_aui_ref_y0: i32 = 0;
let g_aui_ref_off0: i32 = 0;
let g_aui_ref_moved: i32 = 0;
let g_aui_ref_uv: i32[2] = 0;                 // ref_uv 输出：单位向量

// ---- 环形进度（v1.32）----
// 不确定进度的旋转相位直接由当前时钟算（测试可注入假时钟）；spin_live
// 在 build 期间由 aui_progress_circle 置位，让帧泵/定时器保持节拍。
let g_aui_spin_live: i32 = 0;                 // 本帧存在不确定进度圈
let g_aui_spin_phase: i32 = 0;                // 最近一次推进的相位，0..65535

// ---- 惯性（v1.6）----
// 拖动时用最近几次 MOVE 的位移/时间估速度，松手后由 timerfd 以 16 ms
// 周期驱动动画；速度按 15/16 每 16 ms 衰减，撞到上下边界立即停止。
let g_aui_fling_key: i32 = 0;
let g_aui_fling_vel: i32 = 0;                 // 偏移速度，Q16.16 px/s
let g_aui_fling_t: i64 = 0;                   // 上次积分时刻，ns
let g_aui_fling_active: i32 = 0;
let g_aui_fling_axis: i32 = 0;                // v2.17：0 = 纵向，1 = 横向（表格）
let g_aui_vel: i32 = 0;                       // 拖动速度平滑值，Q16.16 px/s
let g_aui_last_y: i32 = 0;
let g_aui_last_x: i32 = 0;                     // 横向拖动采样（v1.47）
let g_aui_last_t: i64 = 0;
let g_aui_timer_ticks: i64 = 0;               // 帧泵出帧计数（转场看门狗 / 轨迹）
let g_aui_input_seq: i64 = 0;                 // 输入事件序号
let g_aui_paint_seq: i32 = 0;                 // 呈现序号
let g_aui_looper: ptr = 0;                    // onInputQueueCreated 里的 UI 线程 looper

// ---- v1.12 帧泵 ----
// 真机 trace 证明挂在 UI 线程 looper 上的 16 ms timerfd 在 looper 空闲时
// 收不到回调（只有输入把 looper 叫醒后才偶尔来一帧），转场因此卡死。帧泵
// 换成独立线程：自己按 16 ms 调 aui_frame，不再依赖 looper；绘制与输入用
// 一把互斥锁串行化，窗口生命周期仍然只在 UI 线程上处理。
let g_aui_pump_on: i32 = 0;                   // 1 = 线程已启动
let g_aui_pump_fail: i32 = 0;                 // 1 = 启动失败，之后一律直切
let g_aui_pump_run: i32 = 0;                  // 1 = 线程应继续存活
let g_aui_pump_need: i32 = 0;                 // 1 = 需要 16 ms 连续出帧
let g_aui_pump_r: i32 = -1;                   // 唤醒管道读端
let g_aui_pump_w: i32 = -1;                   // 唤醒管道写端（非阻塞）
let g_aui_pump_fds: i32[2] = 0;               // pipe2 结果
let g_aui_pump_pfd: i32[2] = 0;               // struct pollfd { fd, events, revents }
let g_aui_pump_tid: i64[1] = 0;               // pthread_t
let g_aui_pump_frames: i64 = 0;               // 真正 present 成功的帧数
let g_aui_pump_tick: i64 = 0;                 // 上一帧结束时刻，用来补足 16 ms 节拍
let g_aui_pump_lfail: i32 = 0;                // 1 = 已记录过 present 失败
let g_aui_pump_failn: i32 = 0;                // 连续 present 失败次数
let g_aui_pump_byte: u8[8] = 0;
let g_aui_lock: i64[8] = 0;                   // pthread_mutex_t（bionic 40 B）

struct AuiTimeSpec {
    sec: i64,
    nsec: i64
}

let g_aui_ts: AuiTimeSpec = AuiTimeSpec { 0, 0 };

// ---- 动画（v1.10；v2.16 扩展：弹簧/关键帧/缩放/完成回调/减弱动效）----
// 固定 64 个槽，按 key + 属性寻址。动画只改变绘制阶段（透明度/位移/缩放），
// 不触发 build/layout；滚动、fling 与动画共用帧泵的 16 ms 节拍。
// 模式（g_aui_anim_mode）：0 补间（v1.10），1 弹簧（半隐式欧拉，固定点），
// 2 关键帧（分段缓动 + 重复/往返）。三种模式共用一张槽表与帧调度
// （anim_active_count → 帧泵保活 + frame_timer），不另起线程或时钟。
let AUI_ANIM_CAP: i32 = 64;
let AUI_ANIM_ALPHA: i32 = 1;
let AUI_ANIM_TX: i32 = 2;                     // dp
let AUI_ANIM_TY: i32 = 3;                     // dp
let AUI_ANIM_SCALE: i32 = 4;                  // Q16.16，65536 = 1.0x
let AUI_ANIM_VALUE: i32 = 5;                  // 通用标量，只读值，不画
let AUI_ANIM_MODE_TWEEN: i32 = 0;
let AUI_ANIM_MODE_SPRING: i32 = 1;
let AUI_ANIM_MODE_KEYFRAME: i32 = 2;
let AUI_EASE_LINEAR: i32 = 0;
let AUI_EASE_OUT: i32 = 1;                    // 1-(1-t)^2
let AUI_EASE_IN_OUT: i32 = 2;                 // 3t^2-2t^3
let AUI_EASE_IN: i32 = 3;                     // t^2
let g_aui_anim_key: i32[64] = 0;
let g_aui_anim_prop: i32[64] = 0;
let g_aui_anim_from: i32[64] = 0;
let g_aui_anim_to: i32[64] = 0;
let g_aui_anim_val: i32[64] = 0;
let g_aui_anim_start: i64[64] = 0;
let g_aui_anim_dur: i64[64] = 0;
let g_aui_anim_curve: i32[64] = 0;
let g_aui_anim_on: i32[64] = 0;
let g_aui_anim_seen: i32[64] = 0;
let g_aui_anim_mode: i32[64] = 0;             // 0 补间 / 1 弹簧 / 2 关键帧
let g_aui_anim_stiff: i32[64] = 0;            // 弹簧劲度（1/s^2，夹 [1,2000]）
let g_aui_anim_damp: i32[64] = 0;             // 弹簧阻尼比（千分比，夹 [0,2000]）
let g_aui_anim_last: i64[64] = 0;             // 弹簧上一步帧时间（ns）
let g_aui_anim_spr_x: i64[64] = 0;            // 弹簧位置（属性单位的 Q16.16）
let g_aui_anim_spr_v: i64[64] = 0;            // 弹簧速度（单位/s 的 Q16.16）
let g_aui_anim_kf_n: i32[64] = 0;             // 关键帧数（2..8）
let g_aui_anim_kf_frac: i32[512] = 0;         // 关键帧时间（千分比，槽*8+段）
let g_aui_anim_kf_prog: i32[512] = 0;         // 关键帧进度（千分比）
let g_aui_anim_kf_curve: i32[512] = 0;        // 段缓动（该帧 → 下一帧）
let g_aui_anim_repeat: i32[64] = 0;           // 关键帧重复：0 一次，>0 次数，-1 无限
let g_aui_anim_rmode: i32[64] = 0;            // 关键帧重复方向：0 重起，1 往返
let g_aui_anim_cb: fn(ptr) : i32[64] = 0;    // 完成回调（自然结束才调一次）
let g_aui_anim_cb_user: ptr[64] = 0;
let g_aui_anim_done_cb: fn(ptr) : i32[64] = 0;   // 本拍待调的完成回调
let g_aui_anim_done_user: ptr[64] = 0;
let g_aui_anim_done_n: i32 = 0;
let g_aui_reduced_motion: i32 = 0;            // 1 = 减弱动效（HuxerUI MotionScheme）
let g_aui_anim_used: i32 = 0;                 // 高水位，绘制时只扫到它
let g_aui_anim_seq: i32 = 0;                  // 每次 build 递增，用于淘汰旧槽
let g_aui_anim_now: i64 = 0;                  // 当前帧时间；测试可注入
let g_aui_anim_fake: i32 = 0;
let g_aui_anim_out: i32[4] = 0;               // anim_apply 输出：alpha/tx/ty/scale

// 绘制阶段的动画状态：cmd_add 统一应用，节点子树自然继承。
let g_aui_paint_alpha: i32 = 255;
let g_aui_paint_dx: i32 = 0;
let g_aui_paint_dy: i32 = 0;
// v2.16：绘制阶段的缩放栈（HuxerUI Scale 默认锚点：节点中心）。
// 每层 = 绕中心 (ox, oy) 的均匀缩放 sx（Q16.16）。命令坐标逐层穿过
// 栈（外 → 内）；宽度/字号只乘 sx。恒等时栈空，cmd_add 走快捷分支，
// 与旧行为逐字节一致。嵌套缩放按中心逐层复合，无溢出（每层均为
// Q16.16 坐标上的定点运算）；32 层封顶，超出的缩放按 1.0 计。
let g_aui_paint_sc_d: i32 = 0;
let g_aui_paint_sc_sx: i32[32] = 0;
let g_aui_paint_sc_ox: i32[32] = 0;
let g_aui_paint_sc_oy: i32[32] = 0;

// 把 p（Q16.16）依次穿过缩放栈（外 → 内），返回屏幕坐标。
fn paint_scale_x(p: i32) : i32 {
    let v: i64 = i64(p);
    let d: i32 = 0;
    while (d < g_aui_paint_sc_d) {
        let ox: i64 = i64(g_aui_paint_sc_ox[d]);
        let sx: i64 = i64(g_aui_paint_sc_sx[d]);
        v = ox + ((v - ox) * sx >> 16);
        d = d + 1;
    }
    return i32(v);
}

fn paint_scale_y(p: i32) : i32 {
    let v: i64 = i64(p);
    let d: i32 = 0;
    while (d < g_aui_paint_sc_d) {
        let oy: i64 = i64(g_aui_paint_sc_oy[d]);
        let sy: i64 = i64(g_aui_paint_sc_sx[d]);
        v = oy + ((v - oy) * sy >> 16);
        d = d + 1;
    }
    return i32(v);
}

// 尺寸（宽/高/半径/字号）只乘各层 sx，与锚点无关。
fn paint_scale_w(w: i32) : i32 {
    let v: i64 = i64(w);
    let d: i32 = 0;
    while (d < g_aui_paint_sc_d) {
        v = (v * i64(g_aui_paint_sc_sx[d])) >> 16;
        d = d + 1;
    }
    return i32(v);
}
// 当前绘制位置的背景色（v1.20）：根用主题 bg，容器/叶子有自己 bg 时覆盖，
// 子树继承。checkbox / radio 用它把描边内圈“挖空”，不需要额外的 stroke 原语。
let g_aui_paint_bg: u32 = 0xFFF6F6F8;

// ---- 页面转场（v1.11）----
// push/pop/reset 前把上一帧的命令列表深拷贝一份（文字也复制），新页面
// 建好后把旧快照与新命令一起绘制：旧页淡出/左移，新页淡入/右移。
// 快照只保留绘制数据，不保留节点、命中测试或输入状态。
let AUI_PAGE_CMD_CAP: i32 = 2048;
let AUI_PAGE_TEXT_CAP: i32 = 49152;
let g_aui_page_pool: i64[16384] = 0;          // 2048 × 64 B
let g_aui_page_cmds: ptr<AuiCmd> = g_aui_page_pool;
let g_aui_page_text: u8[49152] = 0;
let g_aui_page_count: i32 = 0;
let g_aui_page_text_used: i32 = 0;
let g_aui_page_on: i32 = 0;
let g_aui_page_start: i64 = 0;
let g_aui_page_dur: i64 = 0;
let g_aui_page_dir: i32 = 0;                  // 1 push / -1 pop / 0 fade
let g_aui_page_armed: i32 = 0;                // 1 = 帧定时器已被本转场占用
let g_aui_page_ticks0: i64 = 0;               // 转场开始时的定时器帧计数
let g_aui_timer_dead: i32 = 0;                // 1 = 帧定时器被证实不工作，转场降级为直切
let g_aui_nav_ms: i32 = 0;                    // 0 = 关闭页面转场（默认）

// ---- 字体 ----
// W2: g_aui_font / g_aui_font2 no longer hold AUF blobs (no .auf in
// the repo). aui_set_font() / aui_set_fallback_font() ignore the
// pointer and only record the scale; glyphs come from the runtime
// adapter (font_runtime.ast). The pointers stay as API-compat
// storage, always 0. g_aui_rt_mode == 1 selects the runtime path.
let g_aui_font: ptr = 0;
let g_aui_rt_mode: i32 = 1;
// v1.16：可选的回退字体（CJK）。主字体找不到码点时查它；两套字体各自带
// 缩放，因为 8x8 拉丁字体通常放大 2 倍使用，而 16x16 汉字按 1 倍绘制。
let g_aui_font2: ptr = 0;
let g_aui_text_scale2: i32 = 1;
let g_aui_utf8_adv: i32 = 1;
let g_aui_mlines: i32 = 1;
let g_aui_mwidth: i32 = 0;
// v1.18：按词换行。测量和绘制共用一次 layout_text 的结果，两处必须一致，
// 否则节点宽度按 A 算、实际按 B 画，长标签会溢出或被截断。
let AUI_LINE_CAP: i32 = 64;
let g_aui_line_start: i32[64] = 0;
let g_aui_line_len: i32[64] = 0;
let g_aui_line_w: i32[64] = 0;

// ---- 数字格式化 ----
let g_aui_num_buf: u8[2048] = 0;
let g_aui_num_off: i32 = 0;
// v2.16.1：数字缓冲内容变化标记。i32_to_str 每次 build 都重写
// g_aui_num_buf；新串与该偏移处的旧串逐字节相同（值没变）时不标记，
// 不同（读数值变了）时标记。动画损伤比较只在标记时才把指向该缓冲
// 的文本矩形并进来——否则读数标签每帧都被并入，损伤矩形从弹簧卡片
// 一路拉到读数行，包围盒超 1/4 屏、损伤门永远不开。
let g_aui_num_changed: i32 = 0;

// ---- 文本输入（v1.7）----
// 文本按 key 存在树外的固定池里，和滚动偏移一样跨帧重建保留。
// 键盘也由库自己画：节点 kind 11，点击后直接改目标字段，不需要应用回调。
let AUI_TEXT_CAP: i32 = 32;
let AUI_TEXT_SLOT: i32 = 256;         // 每槽字节数（含结尾 NUL）
// v2.5.1：槽位由 64 B 扩到 256 B。64 B 时 AUI_TEXT_MAX = 63，
// 真机字体文件夹路径（72 字符）预填就被静默截断在 "fi"，
// 拼文件名后路径不存在，Load 永远 err=1。槽宽集中在这一个
// 常量上，所有取址都走 idx * AUI_TEXT_SLOT，不再写死 64。
let AUI_TEXT_MAX: i32 = 255;
let g_aui_text_key: i32[32] = 0;
let g_aui_text_len: i32[32] = 0;
let g_aui_text_used: i32 = 0;
let g_aui_text_pool: u8[8192] = 0;            // 32 × 256 B
let g_aui_empty: u8[1] = 0;

let g_aui_kb_target: i32 = 0;
let g_aui_kb_shift: i32 = 0;
let g_aui_kb_mode: i32 = 0;                   // 0 字母，1 数字/符号
let g_aui_kb_ready: i32 = 0;
let g_aui_kb_q1: u8[11] = 0;
let g_aui_kb_q2: u8[10] = 0;
let g_aui_kb_q3: u8[8] = 0;
let g_aui_kb_d1: u8[11] = 0;
let g_aui_kb_d2: u8[11] = 0;
let g_aui_kb_d3: u8[11] = 0;
let g_aui_kb_done: u8[5] = 0;
