let g_aui_kb_ch: u8[2] = 0;
let g_aui_kb_glyphs: u8[128] = 0;

// ---- 状态 / 焦点 / 按压 ----
let g_aui_state_key: i32[256] = 0;
let g_aui_state_val: i32[256] = 0;
let g_aui_state_used: i32 = 0;
let g_aui_focus_key: i32 = 0;
let g_aui_press_key: i32 = 0;
let g_aui_pressing: i32 = 0;
let g_aui_press_downx: i32 = 0;             // v2.7：通用点按的 DOWN 像素点（8 dp 取消判定用）
let g_aui_press_downy: i32 = 0;

// ---- 按压水波纹（v1.48）----
// 对照 HuxerUI 的 Indication：按住时以触点为中心扩散一层主题主色（12%
// alpha）的圆形状态层，松手后淡出。不新增节点类型，波纹跟着“当前按下的
// 节点 key”走，只对走通用点击路径的控件生效。
let g_aui_ripple_on: i32 = 0;                 // 1 = 开启（默认关，保持旧截图不变）
let g_aui_ripple_phase: i32 = 0;              // 0 idle / 1 按住 / 2 松手淡出
let g_aui_ripple_key: i32 = 0;
let g_aui_ripple_x: i32 = 0;                  // 触点，px（绝对）
let g_aui_ripple_y: i32 = 0;
let g_aui_ripple_t0: i64 = 0;                 // 开始时间
let g_aui_ripple_up: i64 = 0;                 // 松手时间（0 = 仍按住）
let g_aui_ripple_rad: i32 = 0;                // 当前半径 px
let g_aui_ripple_alpha: i32 = 0;              // 当前 alpha 0..31
let g_aui_ripple_maxr: i32 = 0;               // 覆盖到最远角的半径 px
let g_aui_ripple_vkind: i32 = 0;              // 52/54/56：虚拟列表项（key 为 0）
let g_aui_ripple_vidx: i32 = -1;              // 项下标（跨重建跟随）
let g_aui_ripple_vbase: i32 = 0;              // 容器 key
let g_aui_ripple_age: i32 = 0;                // 按下至今的毫秒数（调试/测试）
// v1.48.3：本批输入里是否收到 UP。用来区分“正常松手”（淡出）和“手势被
// 拖动/滚动取消”（直接消失，不再在滚动期间多画 220 ms 波纹）。
let g_aui_ripple_up_seen: i32 = 0;

// ---- 页面栈（v1.8）----
// 路由只是一个 i32，应用在 build 里按 aui_route() 分支。栈存在库的 .bss 里，
// 所以每帧重建树、甚至窗口重建都不会丢；返回键先收键盘，再逐级弹出。
let AUI_NAV_MAX: i32 = 8;
let g_aui_nav_stack: i32[8] = 0;
let g_aui_nav_depth: i32 = 1;
let g_aui_route_key: i32 = 1;
let g_aui_nav_ready: i32 = 0;
let g_aui_finished: i32 = 0;

// ---- Android ----
let g_aui_activity: ptr = 0;
let g_aui_win: ptr = 0;
let g_aui_have_win: i32 = 0;
let g_aui_queue: ptr = 0;
let g_aui_ev: ptr[1] = 0;
let g_aui_winbuf: i32[32] = 0;
let g_aui_dirty: i32[4] = 0;
let g_aui_attached: i32 = 0;
let g_aui_build: fn(ptr) : i32;
let g_aui_init: fn(ptr) : i32;
let g_aui_user: ptr = 0;
// v2.5: the app's external files dir (ANativeActivity offset 40),
// saved at attach for the custom-font default folder (<ext>/fonts).
// 0 when no Android attach has run (headless). The pointer aliases
// the system's ANativeActivity struct: stable for the process.
let g_aui_ext_dir: ptr = 0;

// 真机没有 adb 时的启动轨迹：写到应用的外部 files 目录 trace.txt。
// 每个里程碑一行（单字母 + 可选 8 位十六进制）。崩溃后可据此定位阶段。
let g_aui_trace_fd: i32 = -1;
let g_aui_trace_path: u8[256] = 0;
let g_aui_trace_buf: u8[16] = 0;

// W3：文件日志（从自研 runtime/log.ast 合并，M1.1）。trace.txt 只记
// 里程碑字母，查崩溃阶段够用，但看不到带时间的完整行为；aui.log
// 补上后者，两种记录并存、互不冲突。行格式与自研一致：
//   "[<ms>] <L> AUI: <msg>\n"
// <ms> 是单调时钟毫秒（i64，见 M1.2b 的教训：不用 i32 存时间戳）；
// <L> 是 Android 优先级字母（V/D/I/W/E）。两个文件：内部 files
// 目录（私有）+ 外部 files 目录（用户可用文件应用复制）。每行都
// open/write/close，不跨帧持 fd，崩溃最多丢一行。每个文件 128 KiB
// 轮转：追加前文件已超上限就先截断（最旧的行丢掉，最新的留下）。
// 同时镜像到 logcat（__android_log_print，tag AsterUI）。目录不
// 存在或路径未设置时静默跳过：日志绝不能拖垮应用。
let g_aui_log_path1: u8[256] = 0;   // 主文件：<internal>/aui.log
let g_aui_log_path2: u8[256] = 0;   // 副文件：<external>/aui.log
let g_aui_log_set: i32 = 0;         // 1 = 至少设置了一个路径
let g_aui_log_lines: i32 = 0;       // 自 attach 起写入的行数
let g_aui_log_line: u8[512] = 0;    // 行格式化草稿
let g_aui_log_line_len: i32 = 0;
let g_aui_log_msg: u8[256] = 0;     // 消息拼接草稿
let g_aui_log_msg_len: i32 = 0;

let g_aui_null: ptr = 0;

// ---- 平台符号 ----
extern fn __android_log_print(prio: i32, tag: ptr, fmt: ptr) : i32;
extern fn ANativeWindow_setBuffersGeometry(window: ptr, width: i32, height: i32, format: i32) : i32;
extern fn ANativeWindow_getWidth(window: ptr) : i32;
extern fn ANativeWindow_getHeight(window: ptr) : i32;
extern fn ANativeWindow_lock(window: ptr, outBuffer: ptr, inOutDirty: ptr) : i32;
extern fn ANativeWindow_unlockAndPost(window: ptr) : i32;
extern fn AInputQueue_attachLooper(queue: ptr, looper: ptr, ident: i32, cb: ptr, data: ptr) : i32;
extern fn AInputQueue_detachLooper(queue: ptr) : i32;
extern fn AInputQueue_getEvent(queue: ptr, outEvent: ptr) : i32;
extern fn AInputQueue_preDispatchEvent(queue: ptr, event: ptr) : i32;
extern fn AInputQueue_finishEvent(queue: ptr, event: ptr, handled: i32) : i32;
extern fn AInputEvent_getType(event: ptr) : i32;
extern fn AKeyEvent_getAction(event: ptr) : i32;
extern fn AKeyEvent_getKeyCode(event: ptr) : i32;
extern fn AMotionEvent_getAction(event: ptr) : i32;
extern fn AMotionEvent_getX(event: ptr, pointerIndex: i32) : i32;
extern fn AMotionEvent_getY(event: ptr, pointerIndex: i32) : i32;
// v2.18：多指（NDK API 9+，libandroid；与 getX/getY 同一 --needed 映射）。
extern fn AMotionEvent_getPointerCount(event: ptr) : i32;
extern fn AMotionEvent_getPointerId(event: ptr, pointerIndex: i32) : i32;
extern fn ANativeActivity_finish(activity: ptr) : i32;
extern fn ALooper_forThread() : ptr;
extern fn ALooper_prepare(opts: i32) : ptr;
extern fn ALooper_addFd(looper: ptr, fd: i32, ident: i32, events: i32, cb: ptr, data: ptr) : i32;
extern fn ALooper_removeFd(looper: ptr, fd: i32) : i32;
extern fn pthread_create(tid: ptr, attr: ptr, start: ptr, arg: ptr) : i32;
extern fn pthread_join(tid: i64, ret: ptr) : i32;
extern fn pthread_mutex_lock(m: ptr) : i32;
extern fn pthread_mutex_unlock(m: ptr) : i32;
extern fn pipe2(fds: ptr, flags: i32) : i32;
extern fn poll(fds: ptr, nfds: i32, timeout: i32) : i32;
// 注意：此声明必须保留。拿掉它，clock_ns() 的调用会直接走编译器
// clock_gettime 内建（无声明调用无视其他文件的同名定义，双文件
// 探针已证），无头测试的假时钟 fake_set_clock（fake_ndk.ast 的
// clock_gettime 定义）随之失效。Linux 侧由 fbdev.ast 的 wrapper
// 转发到内建（见 src/linux/fbdev.ast）；Android .so 走 libc。
extern fn clock_gettime(clk: i32, tp: ptr) : i32;
// v2.7.2：libc memcpy/memmove（bionic/glibc，NEON）。n 必须是 i64：
// C 的 size_t 是 64 位，i32 会让 libc 读到 x2 上半的垃圾。真机滚动
// 每帧两段 13 MB 拷贝走这里；headless 下 fake_ndk.ast 提供同名
// stub（Aster 循环），静态链接不受影响。注意：不要把名字改回
// mem_copy_bytes——那是 stdlib 的字节循环（已在 v2.7.2 改名让位）。
extern fn memcpy(dst: ptr, src: ptr, n: i64) : ptr;
extern fn memmove(dst: ptr, src: ptr, n: i64) : ptr;
extern fn lrintf() : i32;
extern fn AConfiguration_new() : ptr;
extern fn AConfiguration_fromAssetManager(cfg: ptr, assets: ptr) : i32;
extern fn AConfiguration_getDensity(cfg: ptr) : i32;
extern fn AConfiguration_getUiModeNight(cfg: ptr) : i32;
extern fn AConfiguration_delete(cfg: ptr) : i32;

// ===========================================================================
// 2. 定点与基础工具
// ===========================================================================

fn fx(v: i32) : i32 { return v << 16; }

fn fx_mul(a: i32, b: i32) : i32 {
    let t: i64 = i64(a);
    let u: i64 = i64(b);
    let p: i64 = t * u;
    return i32(p >> 16);
}

fn fx_div(a: i32, b: i32) : i32 {
    let t: i64 = i64(a);
    let u: i64 = i64(b);
    let n: i64 = t * 65536;
    return i32(n / u);
}

fn fx_px(v: i32) : i32 {
    if (v >= 0) { return (v + 32768) >> 16; }
    return -((0 - v + 32768) >> 16);
}

fn iabs(v: i32) : i32 {
    if (v < 0) { return 0 - v; }
    return v;
}

fn dp2q(dp: i32) : i32 {
    return fx_mul(fx(dp), g_aui_density);
}

// v2.6：Q16.16 像素换算回 dp（Canvas 回调读节点实际尺寸用）。
fn q2dp(q: i32) : i32 {
    return fx_px(fx_div(q, g_aui_density));
}

// ---- 滚动偏移表 ----
// 节点树每帧重建，滚动量必须挂在 key 上才能跨帧保留。
fn scroll_find(key: i32) : i32 {
    let i: i32 = 0;
    while (i < g_aui_scroll_used) {
        if (g_aui_scroll_key[i] == key) { return i; }
        i = i + 1;
    }
    return -1;
}

fn scroll_slot(key: i32) : i32 {
    let i: i32 = scroll_find(key);
    if (i >= 0) { return i; }
    if (g_aui_scroll_used >= AUI_SCROLL_CAP) { return -1; }
    i = g_aui_scroll_used;
    g_aui_scroll_key[i] = key;
    g_aui_scroll_val[i] = 0;
    g_aui_scroll_max[i] = 0;
    g_aui_scroll_used = g_aui_scroll_used + 1;
    return i;
}

fn vlist_idx(key: i32) : i32 {
    if (key == 0) { return -1; }
    let i: i32 = 0;
    while (i < g_aui_vlist_used) {
        if (g_aui_vlist_key[i] == key) { return i; }
        i = i + 1;
    }
    return -1;
}

fn vgrid_idx(key: i32) : i32 {
    if (key == 0) { return -1; }
    let i: i32 = 0;
    while (i < g_aui_vgrid_used) {
        if (g_aui_vgrid_key[i] == key) { return i; }
        i = i + 1;
    }
    return -1;
}

fn hlist_idx(key: i32) : i32 {
    if (key == 0) { return -1; }
    let i: i32 = 0;
    while (i < g_aui_hlist_used) {
        if (g_aui_hlist_key[i] == key) { return i; }
        i = i + 1;
    }
    return -1;
}

// 虚拟容器（列表/网格/横向列表/表格）的偏移都以像素存，不走 Q16.16。
fn virtual_key(key: i32) : i32 {
    if (vlist_idx(key) >= 0) { return 1; }
    if (vgrid_idx(key) >= 0) { return 1; }
    if (hlist_idx(key) >= 0) { return 1; }
    if (vtable_idx(key) >= 0) { return 1; }
    return 0;
}

fn scroll_get(key: i32) : i32 {
    let vj: i32 = vlist_idx(key);
    if (vj >= 0) { return g_aui_vlist_off[vj]; }
    vj = vgrid_idx(key);
    if (vj >= 0) { return g_aui_vgrid_off[vj]; }
    vj = hlist_idx(key);
    if (vj >= 0) { return g_aui_hlist_off[vj]; }
    // v2.17：表格的纵向偏移；横向偏移走独立的 vtable_off_x/set_x。
    vj = vtable_idx(key);
    if (vj >= 0) { return g_aui_vtable_off[vj]; }
    let i: i32 = scroll_find(key);
    if (i < 0) { return 0; }
    return g_aui_scroll_val[i];
}

fn scroll_max(key: i32) : i32 {
    let vj: i32 = vlist_idx(key);
    if (vj >= 0) { return g_aui_vlist_max[vj]; }
    vj = vgrid_idx(key);
    if (vj >= 0) { return g_aui_vgrid_max[vj]; }
    vj = hlist_idx(key);
    if (vj >= 0) { return g_aui_hlist_max[vj]; }
    vj = vtable_idx(key);
    if (vj >= 0) { return g_aui_vtable_max[vj]; }
    let i: i32 = scroll_find(key);
    if (i < 0) { return 0; }
    return g_aui_scroll_max[i];
}

fn scroll_set(key: i32, v: i32) : i32 {
    let vj: i32 = vlist_idx(key);
    if (vj >= 0) {
        if (v < 0) { v = 0; }
        if (v > g_aui_vlist_max[vj]) { v = g_aui_vlist_max[vj]; }
        g_aui_vlist_off[vj] = v;
        return v;
    }
    vj = vgrid_idx(key);
    if (vj >= 0) {
        if (v < 0) { v = 0; }
        if (v > g_aui_vgrid_max[vj]) { v = g_aui_vgrid_max[vj]; }
        g_aui_vgrid_off[vj] = v;
        return v;
    }
    vj = hlist_idx(key);
    if (vj >= 0) {
        if (v < 0) { v = 0; }
        if (v > g_aui_hlist_max[vj]) { v = g_aui_hlist_max[vj]; }
        g_aui_hlist_off[vj] = v;
        return v;
    }
    vj = vtable_idx(key);
    if (vj >= 0) {
        if (v < 0) { v = 0; }
        if (v > g_aui_vtable_max[vj]) { v = g_aui_vtable_max[vj]; }
        g_aui_vtable_off[vj] = v;
        return v;
    }
    let i: i32 = scroll_slot(key);
    if (i < 0) { return 0; }
    if (v < 0) { v = 0; }
    if (v > g_aui_scroll_max[i]) { v = g_aui_scroll_max[i]; }
    g_aui_scroll_val[i] = v;
    return v;
}

fn scroll_store_max(key: i32, m: i32) : i32 {
    let vj: i32 = vlist_idx(key);
    if (vj >= 0) {
        if (m < 0) { m = 0; }
        g_aui_vlist_max[vj] = m;
        if (g_aui_vlist_off[vj] > m) { g_aui_vlist_off[vj] = m; }
        return 0;
    }
    vj = vgrid_idx(key);
    if (vj >= 0) {
        if (m < 0) { m = 0; }
        g_aui_vgrid_max[vj] = m;
        if (g_aui_vgrid_off[vj] > m) { g_aui_vgrid_off[vj] = m; }
        return 0;
    }
    vj = hlist_idx(key);
    if (vj >= 0) {
        if (m < 0) { m = 0; }
        g_aui_hlist_max[vj] = m;
        if (g_aui_hlist_off[vj] > m) { g_aui_hlist_off[vj] = m; }
        return 0;
    }
    vj = vtable_idx(key);
    if (vj >= 0) {
        if (m < 0) { m = 0; }
        g_aui_vtable_max[vj] = m;
        if (g_aui_vtable_off[vj] > m) { g_aui_vtable_off[vj] = m; }
        return 0;
    }
    let i: i32 = scroll_slot(key);
    if (i < 0) { return 0; }
    if (m < 0) { m = 0; }
    g_aui_scroll_max[i] = m;
    if (g_aui_scroll_val[i] > m) { g_aui_scroll_val[i] = m; }
    return 0;
}

// v1.48.4：滚动只改偏移，尺寸没变，标一个“轻布局”——下一拍跳过 measure，
// 直接 arrange。虚拟列表 arrange 发现窗口不够时会自己置 need_build，
// 那种情况下 pump_ui 会退回完整 measure。
fn mark_scroll_dirty() : i32 {
    g_aui_need_layout = 1;
    g_aui_need_paint = 1;
    g_aui_layout_light = 1;
    return 0;
}

// v1.48.6：当前正在被拖动/惯性滚动的目标 key（0 = 没有）。直搬只跟一个
// 滚动容器：一次手势只会滚一个，程序化滚动走完整重画。
fn active_scroll_key() : i32 {
    if (g_aui_fling_active != 0 && g_aui_fling_key != 0) { return g_aui_fling_key; }
    if (g_aui_dragging != 0 && g_aui_drag_key != 0) { return g_aui_drag_key; }
    return 0;
}

// ---- 虚拟列表登记表（v1.45）----
// 只记录每个虚拟列表最近一次的视口高与窗口范围；节点本身每帧重建。
fn vlist_find(key: i32) : i32 {
    return vlist_idx(key);
}

fn vlist_slot(key: i32) : i32 {
    if (key == 0) { return -1; }
    let i: i32 = vlist_find(key);
    if (i >= 0) { return i; }
    if (g_aui_vlist_used >= AUI_VLIST_CAP) { return -1; }
    i = g_aui_vlist_used;
    g_aui_vlist_key[i] = key;
    g_aui_vlist_vp[i] = 0;
    g_aui_vlist_used_vp[i] = 0;
    g_aui_vlist_first[i] = 0;
    g_aui_vlist_last[i] = -1;
    g_aui_vlist_off[i] = 0;
    g_aui_vlist_max[i] = 0;
    g_aui_vlist_var[i] = 0;
    g_aui_vlvar_w[i] = 0;
    g_aui_vlvar_writes[i] = 0;
    g_aui_vlvar_count[i] = 0;
    g_aui_vlvar_est[i] = 0;
    g_aui_vlist_used = g_aui_vlist_used + 1;
    return i;
}

// 偏移变了：该 key 是虚拟列表时要求下一拍重建窗口。
fn vlist_touch(key: i32) : i32 {
    if (vlist_find(key) < 0) { return 0; }
    g_aui_need_build = 1;
    g_aui_pump_need = 1;
    return 1;
}

// ---- 虚拟网格登记表（v1.46）----
// 记录每个网格最近一次实测的列数、间距、视口高与窗口范围；
// 这些值只用于下一拍 build 的窗口估算，节点每帧重建。
fn vgrid_find(key: i32) : i32 {
    return vgrid_idx(key);
}

fn vgrid_slot(key: i32) : i32 {
    if (key == 0) { return -1; }
    let i: i32 = vgrid_find(key);
    if (i >= 0) { return i; }
    if (g_aui_vgrid_used >= AUI_VGRID_CAP) { return -1; }
    i = g_aui_vgrid_used;
    g_aui_vgrid_key[i] = key;
    g_aui_vgrid_vp[i] = 0;
    g_aui_vgrid_used_vp[i] = 0;
    g_aui_vgrid_cols[i] = 0;
    g_aui_vgrid_gap[i] = 0;
    g_aui_vgrid_first[i] = 0;
    g_aui_vgrid_last[i] = -1;
    g_aui_vgrid_off[i] = 0;
    g_aui_vgrid_max[i] = 0;
    g_aui_vgrid_used = g_aui_vgrid_used + 1;
    return i;
}

// 偏移变了：该 key 是虚拟网格时要求下一拍重建窗口。
fn vgrid_touch(key: i32) : i32 {
    if (vgrid_find(key) < 0) { return 0; }
    g_aui_need_build = 1;
    g_aui_pump_need = 1;
    return 1;
}

// ---- 横向虚拟列表登记表（v1.47）----
fn hlist_find(key: i32) : i32 {
    return hlist_idx(key);
}

fn hlist_slot(key: i32) : i32 {
    if (key == 0) { return -1; }
    let i: i32 = hlist_find(key);
    if (i >= 0) { return i; }
    if (g_aui_hlist_used >= AUI_HLIST_CAP) { return -1; }
    i = g_aui_hlist_used;
    g_aui_hlist_key[i] = key;
    g_aui_hlist_vp[i] = 0;
    g_aui_hlist_used_vp[i] = 0;
    g_aui_hlist_first[i] = 0;
    g_aui_hlist_last[i] = -1;
    g_aui_hlist_gap[i] = 0;
    g_aui_hlist_off[i] = 0;
    g_aui_hlist_max[i] = 0;
    g_aui_hlist_used = g_aui_hlist_used + 1;
    return i;
}

fn hlist_touch(key: i32) : i32 {
    if (hlist_find(key) < 0) { return 0; }
    g_aui_need_build = 1;
    g_aui_pump_need = 1;
    return 1;
}

// ---- 虚拟表格登记表（v2.17）----
// 对照 HuxerUI virtual_table：行列都虚拟化，表头纵向固定、首列横向固定。
// 纵向偏移走 scroll_get/set 的纵向分派（拖动/惯性/滚动条/直搬复用）；
// 横向偏移单独存 off_x——直搬只认纵向，横向滚动走整屏重画。列宽按 dp
// 存（0 = 未设置，用默认 128dp），换算像素时按当前密度；列数上限 512。
let AUI_VTABLE_CAP: i32 = 12;
let AUI_VTABLE_COLS_MAX: i32 = 512;
let AUI_VTABLE_W_DEFAULT: i32 = 128;   // 默认列宽，dp
let g_aui_vtable_key: i32[12] = 0;
let g_aui_vtable_vp: i32[12] = 0;              // 上一帧视口高，Q16.16
let g_aui_vtable_used_vp: i32[12] = 0;         // 本帧 build 时用的视口高
let g_aui_vtable_vpw: i32[12] = 0;             // 上一帧视口宽，Q16.16
let g_aui_vtable_used_vpw: i32[12] = 0;        // 本帧 build 时用的视口宽
let g_aui_vtable_first_row: i32[12] = 0;       // 本帧构建的首行下标
let g_aui_vtable_last_row: i32[12] = -1;       // 本帧构建的末行下标
let g_aui_vtable_first_col: i32[12] = 0;       // 本帧构建的首列下标
let g_aui_vtable_last_col: i32[12] = -1;       // 本帧构建的末列下标
let g_aui_vtable_off: i32[12] = 0;             // 纵向偏移，像素
let g_aui_vtable_max: i32[12] = 0;             // 纵向最大偏移，像素
let g_aui_vtable_offx: i32[12] = 0;            // 横向偏移，像素
let g_aui_vtable_maxx: i32[12] = 0;            // 横向最大偏移，像素
let g_aui_vtable_used: i32 = 0;
let g_aui_vtable_w: i32[6144] = 0;             // 12 槽 × 512 列宽（dp，0 = 默认）
// build 期间 on_bind 回调的上下文（取首末行/列、建格时读行高/回调）。
let g_aui_vtable_cur_key: i32 = 0;
let g_aui_vtable_cur_rh: i32 = 0;              // 行高，Q16.16
let g_aui_vtable_cur_user: ptr = 0;
let g_aui_vtable_cur_tap: fn(ptr) : i32;
let g_aui_vtable_first_row_cur: i32 = 0;
let g_aui_vtable_last_row_cur: i32 = -1;
let g_aui_vtable_first_col_cur: i32 = 0;
let g_aui_vtable_last_col_cur: i32 = -1;
// 点中格时先写 (容器 key, 行, 列)，回调里用 aui_vtable_tap_row/col() 读；
// 表头行 row = -1。
let g_aui_vtable_tap_key: i32 = 0;
let g_aui_vtable_tap_row: i32 = -1;
let g_aui_vtable_tap_col: i32 = -1;

fn vtable_idx(key: i32) : i32 {
    if (key == 0) { return -1; }
    let i: i32 = 0;
    while (i < g_aui_vtable_used) {
        if (g_aui_vtable_key[i] == key) { return i; }
        i = i + 1;
    }
    return -1;
}

fn vtable_find(key: i32) : i32 {
    return vtable_idx(key);
}

fn vtable_slot(key: i32) : i32 {
    if (key == 0) { return -1; }
    let i: i32 = vtable_find(key);
    if (i >= 0) { return i; }
    if (g_aui_vtable_used >= AUI_VTABLE_CAP) { return -1; }
    i = g_aui_vtable_used;
    g_aui_vtable_key[i] = key;
    g_aui_vtable_vp[i] = 0;
    g_aui_vtable_used_vp[i] = 0;
    g_aui_vtable_vpw[i] = 0;
    g_aui_vtable_used_vpw[i] = 0;
    g_aui_vtable_first_row[i] = 0;
    g_aui_vtable_last_row[i] = -1;
    g_aui_vtable_first_col[i] = 0;
    g_aui_vtable_last_col[i] = -1;
    g_aui_vtable_off[i] = 0;
    g_aui_vtable_max[i] = 0;
    g_aui_vtable_offx[i] = 0;
    g_aui_vtable_maxx[i] = 0;
    g_aui_vtable_used = g_aui_vtable_used + 1;
    return i;
}

// v2.17.1：横向偏移变了只标轻脏（与纵向 scroll_set 同模型）：下一拍
// arrange 自愈检查窗口够不够，够就不重建（直搬可接），不够才置
// need_build。旧逻辑每变一次偏移就强制重建，横向拖动/惯性每帧都
// 是整屏重画，直搬永远接不上。
fn vtable_touch(key: i32) : i32 {
    if (vtable_find(key) < 0) { return 0; }
    g_aui_need_layout = 1;
    g_aui_need_paint = 1;
    g_aui_layout_light = 1;
    g_aui_pump_need = 1;
    return 1;
}

// 列宽（dp）：槽内未设置返回默认 128。
fn vtable_col_dp(s: i32, col: i32) : i32 {
    if (s < 0 || col < 0 || col >= AUI_VTABLE_COLS_MAX) { return AUI_VTABLE_W_DEFAULT; }
    let w: i32 = g_aui_vtable_w[s * AUI_VTABLE_COLS_MAX + col];
    if (w <= 0) { return AUI_VTABLE_W_DEFAULT; }
    return w;
}

// 列宽（Q16.16 px）。
fn vtable_colw_q(s: i32, col: i32) : i32 {
    return dp2q(vtable_col_dp(s, col));
}

// 列宽（像素，>= 1）。
fn vtable_col_px(s: i32, col: i32) : i32 {
    let p: i32 = vtable_colw_q(s, col) >> 16;
    if (p < 1) { p = 1; }
    return p;
}

// 列 col 的内容左边界（像素，从表左起），即前面各列宽之和。
fn vtable_col_x(s: i32, col: i32) : i32 {
    let x: i32 = 0;
    let c: i32 = 0;
    while (c < col) {
        x = x + vtable_col_px(s, c);
        c = c + 1;
    }
    return x;
}

// 内容总宽（像素），i64 防溢出后夹到 2e9。
fn vtable_total_w(s: i32, cols: i32) : i32 {
    let t64: i64 = i64(vtable_col_x(s, cols));
    if (t64 > 2000000000) { return 2000000000; }
    return i32(t64);
}

// 像素 x 落在哪一列（0..cols-1；x 超出内容宽返回最后一列）。
fn vtable_col_at(s: i32, x: i32, cols: i32) : i32 {
    if (cols <= 0) { return -1; }
    if (x < 0) { x = 0; }
    let c: i32 = 0;
    let acc: i32 = 0;
    while (c < cols) {
        let w: i32 = vtable_col_px(s, c);
        if (x < acc + w) { return c; }
        acc = acc + w;
        c = c + 1;
    }
    return cols - 1;
}

// 横向偏移读/写（像素，写时自动夹到 maxx）。
fn vtable_off_x(key: i32) : i32 {
    let s: i32 = vtable_idx(key);
    if (s < 0) { return 0; }
    return g_aui_vtable_offx[s];
}

fn vtable_set_x(key: i32, v: i32) : i32 {
    let s: i32 = vtable_idx(key);
    if (s < 0) { return 0; }
    if (v < 0) { v = 0; }
    if (v > g_aui_vtable_maxx[s]) { v = g_aui_vtable_maxx[s]; }
    g_aui_vtable_offx[s] = v;
    return v;
}

fn vtable_maxx(key: i32) : i32 {
    let s: i32 = vtable_idx(key);
    if (s < 0) { return 0; }
    return g_aui_vtable_maxx[s];
}

fn vtable_store_maxx(key: i32, m: i32) : i32 {
    let s: i32 = vtable_idx(key);
    if (s < 0) { return 0; }
    if (m < 0) { m = 0; }
    g_aui_vtable_maxx[s] = m;
    if (g_aui_vtable_offx[s] > m) { g_aui_vtable_offx[s] = m; }
    return 0;
}

// 当前树里 key 对应的表格节点下标；没建好返回 -1。
fn vtable_node(key: i32) : i32 {
    let i: i32 = g_aui_node_count - 1;
    while (i >= 0) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.kind == 63 && n.key == key) { return i; }
        i = i - 1;
    }
    return -1;
}

// ---- 下拉刷新状态（v1.30）----
fn ref_find(key: i32) : i32 {
    if (key <= 0) { return -1; }
    let i: i32 = 0;
    while (i < g_aui_ref_used) {
        if (g_aui_ref_key[i] == key) { return i; }
        i = i + 1;
    }
    return -1;
}

fn ref_slot(key: i32) : i32 {
    if (key <= 0) { return -1; }
    let i: i32 = ref_find(key);
    if (i >= 0) { return i; }
    if (g_aui_ref_used >= AUI_REF_CAP) { return -1; }
    i = g_aui_ref_used;
    g_aui_ref_key[i] = key;
    g_aui_ref_disp[i] = 0;
    g_aui_ref_on[i] = 0;
    g_aui_ref_phase[i] = 0;
    g_aui_ref_anim[i] = 0;
    g_aui_ref_from[i] = 0;
    g_aui_ref_to[i] = 0;
    g_aui_ref_t0[i] = 0;
    g_aui_ref_dur[i] = 0;
    g_aui_ref_ack[i] = 0;
    g_aui_ref_spin_t[i] = 0;
    g_aui_ref_used = g_aui_ref_used + 1;
    return i;
}

fn ref_disp(key: i32) : i32 {
    let s: i32 = ref_find(key);
    if (s < 0) { return 0; }
    return g_aui_ref_disp[s];
}

fn ref_set_disp(key: i32, v: i32) : i32 {
    let s: i32 = ref_find(key);
    if (s < 0) { return 0; }
    if (v < 0) { v = 0; }
    g_aui_ref_disp[s] = v;
    return v;
}

// 从当前位移吸附到 to（Q16.16），dur 纳秒；0 表示直接到位。
fn ref_anim_to(s: i32, to: i32, dur: i64) : i32 {
    if (s < 0) { return 0; }
    if (g_aui_ref_disp[s] == to || dur <= 0) {
        g_aui_ref_disp[s] = to;
        g_aui_ref_anim[s] = 0;
        return 0;
    }
    g_aui_ref_from[s] = g_aui_ref_disp[s];
    g_aui_ref_to[s] = to;
    g_aui_ref_t0[s] = anim_now();
    g_aui_ref_dur[s] = dur;
    g_aui_ref_anim[s] = 1;
    return 0;
}

// build 里每帧调用：应用传入的 refreshing 变化时调整目标位移。
fn ref_sync(s: i32, on: i32) : i32 {
    if (s < 0) { return 0; }
    let r: i32 = 0;
    if (on != 0) { r = 1; }
    let prev: i32 = g_aui_ref_on[s];
    if (prev == r) { return 0; }
    g_aui_ref_on[s] = r;
    if (r != 0) {
        // 应用开始刷新：收进刷新位（已有下拉位移时直接续接）。
        g_aui_ref_ack[s] = 0;
        ref_anim_to(s, dp2q(52), 150000000);
    } else {
        // 应用结束刷新：立即收起，不再等反馈窗口。
        g_aui_ref_ack[s] = 0;
        ref_anim_to(s, 0, 200000000);
    }
    return 1;
}

fn ref_spinning(s: i32) : i32 {
    if (s < 0) { return 0; }
    if (g_aui_ref_on[s] != 0) { return 1; }
    if (g_aui_ref_ack[s] != 0) { return 1; }
    return 0;
}

// 每帧推进：旋转相位 + 位移吸附。返回 1 = 仍需下一帧。
fn ref_step(now: i64) : i32 {
    let active: i32 = 0;
    let i: i32 = 0;
    while (i < g_aui_ref_used) {
        if (g_aui_ref_key[i] != 0) {
            if (g_aui_ref_ack[i] != 0 && g_aui_ref_on[i] == 0 &&
                now >= g_aui_ref_ack[i]) {
                g_aui_ref_ack[i] = 0;
                ref_anim_to(i, 0, 200000000);
            }
            if (ref_spinning(i) != 0) {
                let dt: i64 = now - g_aui_ref_spin_t[i];
                if (g_aui_ref_spin_t[i] <= 0 || dt < 0) { dt = 16000000; }
                if (dt > 32000000) { dt = 32000000; }
                g_aui_ref_spin_t[i] = now;
                let dp: i32 = i32((dt * 65536) / 900000000);
                g_aui_ref_phase[i] = (g_aui_ref_phase[i] + dp) & 65535;
                if (g_aui_ref_anim[i] == 0 && g_aui_ref_disp[i] < dp2q(52)) {
                    ref_anim_to(i, dp2q(52), 150000000);
                }
                g_aui_need_paint = 1;
                active = 1;
            } else {
                g_aui_ref_spin_t[i] = 0;
            }
            if (g_aui_ref_anim[i] != 0) {
                let el: i64 = now - g_aui_ref_t0[i];
                if (el < 0) { el = 0; }
                let dur: i64 = g_aui_ref_dur[i];
                if (dur <= 0) { dur = 200000000; }
                let t: i32 = i32((el * 65536) / dur);
                if (t >= 65536) {
                    g_aui_ref_disp[i] = g_aui_ref_to[i];
                    g_aui_ref_anim[i] = 0;
                } else {
                    let e: i32 = anim_ease(t, AUI_EASE_OUT);
                    g_aui_ref_disp[i] = anim_lerp(g_aui_ref_from[i], g_aui_ref_to[i], e);
                }
                g_aui_need_layout = 1;
                g_aui_need_paint = 1;
                active = 1;
            }
        }
        i = i + 1;
    }
    return active;
}

fn refresh_busy() : i32 {
    let n: i32 = 0;
    let i: i32 = 0;
    while (i < g_aui_ref_used) {
        if (g_aui_ref_key[i] != 0) {
            if (ref_spinning(i) != 0 || g_aui_ref_anim[i] != 0) { n = n + 1; }
        }
        i = i + 1;
    }
    // v1.32：不确定进度圈也属于“有动效”，复用同一套帧泵/定时器判定。
    n = n + g_aui_spin_live;
    return n;
}

fn ref_node(key: i32) : i32 {
    let i: i32 = 0;
    while (i < g_aui_node_count) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.kind == 29 && n.key == key) { return i; }
        i = i + 1;
    }
    return -1;
}

fn ref_state(key: i32) : i32 {
    let s: i32 = ref_find(key);
    if (s < 0) { return 0; }
    if (ref_spinning(s) != 0) { return 2; }
    if (g_aui_ref_anim[s] != 0) { return 3; }
    if (g_aui_ref_disp[s] != 0) { return 1; }
    return 0;
}

// ---- 分页偏移表（v1.24）----
fn pager_find(key: i32) : i32 {
    if (key <= 0) { return -1; }
    let i: i32 = 0;
    while (i < g_aui_pager_used) {
        if (g_aui_pager_key[i] == key) { return i; }
        i = i + 1;
    }
    return -1;
}

fn pager_slot(key: i32) : i32 {
    if (key <= 0) { return -1; }
    let i: i32 = pager_find(key);
    if (i >= 0) { return i; }
    if (g_aui_pager_used >= AUI_PAGER_CAP) { return -1; }
    i = g_aui_pager_used;
    g_aui_pager_key[i] = key;
    g_aui_pager_off[i] = 0;
    g_aui_pager_max[i] = 0;
    g_aui_pager_init[i] = 0;
    g_aui_pager_anim_on[i] = 0;
    g_aui_pager_anim_from[i] = 0;
    g_aui_pager_anim_to[i] = 0;
    g_aui_pager_anim_start[i] = 0;
    g_aui_pager_anim_dur[i] = 0;
    g_aui_pager_used = g_aui_pager_used + 1;
    return i;
}

fn pager_get(key: i32) : i32 {
    let i: i32 = pager_find(key);
    if (i < 0) { return 0; }
    return g_aui_pager_off[i];
}

fn pager_set(key: i32, v: i32) : i32 {
    let i: i32 = pager_slot(key);
    if (i < 0) { return 0; }
    if (v < 0) { v = 0; }
    if (v > g_aui_pager_max[i]) { v = g_aui_pager_max[i]; }
    g_aui_pager_off[i] = v;
    return v;
}

fn pager_store_max(key: i32, m: i32) : i32 {
    let i: i32 = pager_slot(key);
    if (i < 0) { return 0; }
    if (m < 0) { m = 0; }
    g_aui_pager_max[i] = m;
    if (g_aui_pager_off[i] > m) { g_aui_pager_off[i] = m; }
    if (g_aui_pager_anim_to[i] > m) { g_aui_pager_anim_to[i] = m; }
    return 0;
}

fn pager_anim_stop(key: i32) : i32 {
    let i: i32 = pager_find(key);
    if (i < 0) { return 0; }
    g_aui_pager_anim_on[i] = 0;
    return 0;
}

fn pager_anim_count() : i32 {
    let n: i32 = 0;
    let i: i32 = 0;
    while (i < g_aui_pager_used) {
        if (g_aui_pager_anim_on[i] != 0) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

// 从当前偏移吸到 to（Q16.16），默认 200 ms EaseOut；duration=0 直接落位。
fn pager_anim_to(key: i32, to: i32, ms: i32) : i32 {
    let i: i32 = pager_slot(key);
    if (i < 0) { return -1; }
    let from: i32 = g_aui_pager_off[i];
    if (to < 0) { to = 0; }
    if (to > g_aui_pager_max[i]) { to = g_aui_pager_max[i]; }
    let dur: i64 = i64(ms) * 1000000;
    if (dur <= 0 || from == to) {
        g_aui_pager_off[i] = to;
        g_aui_pager_anim_on[i] = 0;
        g_aui_need_layout = 1;
        g_aui_need_paint = 1;
        return 0;
    }
    g_aui_pager_anim_from[i] = from;
    g_aui_pager_anim_to[i] = to;
    g_aui_pager_anim_start[i] = anim_now();
    g_aui_pager_anim_dur[i] = dur;
    g_aui_pager_anim_on[i] = 1;
    let ar: i32 = frame_timer_arm();
    g_aui_need_paint = 1;
    return 0;
}

fn pager_step(now: i64) : i32 {
    if (g_aui_pager_used == 0) { return 0; }
    let changed: i32 = 0;
    let live: i32 = 0;
    let i: i32 = 0;
    while (i < g_aui_pager_used) {
        if (g_aui_pager_anim_on[i] != 0) {
            let v: i32 = g_aui_pager_off[i];
            if (now <= g_aui_pager_anim_start[i]) {
                v = g_aui_pager_anim_from[i];
            } else {
                let el: i64 = now - g_aui_pager_anim_start[i];
                if (el >= g_aui_pager_anim_dur[i]) {
                    v = g_aui_pager_anim_to[i];
                    g_aui_pager_anim_on[i] = 0;
                } else {
                    let t: i32 = i32((el * 65536) / g_aui_pager_anim_dur[i]);
                    let e: i32 = anim_ease(t, AUI_EASE_OUT);
                    v = anim_lerp(g_aui_pager_anim_from[i],
                                  g_aui_pager_anim_to[i], e);
                }
            }
            if (v != g_aui_pager_off[i]) {
                g_aui_pager_off[i] = v;
                changed = 1;
            }
            if (g_aui_pager_anim_on[i] != 0) { live = live + 1; }
        }
        i = i + 1;
    }
    if (changed != 0) {
        g_aui_need_layout = 1;
        g_aui_need_paint = 1;
    }
    if (live == 0 && g_aui_fling_active == 0 && g_aui_page_on == 0 &&
        anim_active_count() == 0) {
        let d: i32 = frame_timer_disarm();
    }
    return changed;
}

fn pager_drag_clear() : i32 {
    g_aui_pager_drag_key = 0;
    g_aui_pager_dragging = 0;
    g_aui_pager_lock = 0;
    g_aui_pager_vel = 0;
    g_aui_pager_last_x = 0;
    g_aui_pager_last_t = 0;
    g_aui_pager_drag_cb = 0;
    g_aui_pager_drag_user = 0;
    return 0;
}

fn str_len(s: ptr) : i32 {
    if (s == 0) { return 0; }
    let i: i32 = 0;
    while (load_u8(s + i) != 0) {
        i = i + 1;
    }
    return i;
}

fn i32_to_str(v: i32) : ptr {
    // 返回写入 g_aui_num_buf 的起点；g_aui_num_buf 每次 build 重置。
    if (g_aui_num_off + 16 > 2048) { let e: i32 = aui_set_err(AUI_ERR_NUM_OVERFLOW); return g_aui_null; }
    let start: i32 = g_aui_num_off;
    let neg: i32 = 0;
    let n: i32 = v;
    if (n < 0) { neg = 1; n = 0 - n; }
    let tmp: u8[12] = 0;
    let i: i32 = 0;
    if (n == 0) {
        let w0: i32 = store_u8(tmp + 0, 48);
        i = 1;
    } else {
        while (n > 0) {
            let d: i32 = n - (n / 10) * 10;
            let w1: i32 = store_u8(tmp + i, 48 + d);
            i = i + 1;
            n = n / 10;
        }
    }
    // v2.16.1：先与旧串逐字节比（新串 = 可选 '-' + tmp 倒序的数字）。
    // 长度或任一字节不同，说明该偏移处的读数值变了，标记。
    let nl: i32 = i;
    if (neg != 0) { nl = nl + 1; }
    let ol: i32 = 0;
    while (ol < 16) {
        let ob0: i32 = load_u8(g_aui_num_buf + start + ol);
        if (ob0 == 0) { break; }
        ol = ol + 1;
    }
    if (ol != nl) {
        g_aui_num_changed = 1;
    } else {
        let ci: i32 = 0;
        while (ci < nl) {
            let nb: i32 = 0;
            if (neg != 0 && ci == 0) {
                nb = 45;
            } else {
                let di: i32 = ci;
                if (neg != 0) { di = di - 1; }
                nb = load_u8(tmp + (i - 1 - di));
            }
            let ob2: i32 = load_u8(g_aui_num_buf + start + ci);
            if (nb != ob2) { g_aui_num_changed = 1; break; }
            ci = ci + 1;
        }
    }
    if (neg != 0) {
        let w2: i32 = store_u8(g_aui_num_buf + g_aui_num_off, 45);
        g_aui_num_off = g_aui_num_off + 1;
    }
    while (i > 0) {
        i = i - 1;
        let ch: i32 = load_u8(tmp + i);
        let w3: i32 = store_u8(g_aui_num_buf + g_aui_num_off, ch);
        g_aui_num_off = g_aui_num_off + 1;
    }
    let w4: i32 = store_u8(g_aui_num_buf + g_aui_num_off, 0);
    g_aui_num_off = g_aui_num_off + 1;
    return g_aui_num_buf + start;
}

// ===========================================================================
// 3. 字体与 UTF-8
// ===========================================================================
//
// W2 font surgery (whole-package adoption): the reference text stack
// assumed AUF1 bitmap fonts injected with @embed. Those files do not
// exist in this repo (Noto-derived, OFL -- carrying any font licence
// is forbidden), so no AUF blob is ever dereferenced any more. All
// glyph access goes through the runtime-font adapter in
// stdlib/asterui/font_runtime.ast (extern decls below): the runtime
// TrueType engine when a system font is loaded, else the hand-drawn
// ASCII/CJK fallback. The AUF record readers (font_at_*, glyph_find_in,
// draw_glyph) are kept intact behind g_aui_rt_mode == 0 for reference
// only; g_aui_rt_mode is always 1 (see aui_set_font).

extern fn aui_rt_ensure() : i32;
extern fn aui_rt_set_font_path(path: ptr) : i32;
extern fn aui_rt_active() : i32;
extern fn aui_rt_pixel() : i32;
extern fn aui_rt_line_h() : i32;
extern fn aui_rt_set_cell(cell: i32) : i32;
extern fn aui_rt_advance(cp: i32) : i32;
extern fn aui_rt_glyph(cp: i32) : i32;
extern fn aui_rt_bm() : ptr;
extern fn aui_rt_bw() : i32;
extern fn aui_rt_bh() : i32;
extern fn aui_rt_xo() : i32;
extern fn aui_rt_yo() : i32;
extern fn aui_rt_missing() : i32;
extern fn aui_rt_fallback_events() : i32;
extern fn aui_rt_fallback_reason() : i32;
extern fn ui_sysfont_ok() : i32;
extern fn ui_sysfont_err() : i32;
extern fn ui_sysfont_face() : i32;
extern fn ui_sysfont_is_cff() : i32;
extern fn ui_sysfont_is_glyf() : i32;
extern fn ui_sysfont_is_cff2() : i32;
extern fn ui_sysfont_cmap_fmt() : i32;
extern fn ui_sysfont_glyphs() : i32;
extern fn ui_sysfont_upm() : i32;
extern fn ui_sysfont_fvar_wght() : i32;
extern fn ui_sysfont_probe_n() : i32;
extern fn ui_sysfont_probe_path(i: i32) : ptr;
extern fn ui_sysfont_probe_size(i: i32) : i32;
extern fn ui_sysfont_probe_err(i: i32) : i32;
extern fn ui_tt_rasterize(cp: i32, cw: i32, ch: i32) : i32;
extern fn ui_tt_decode_failures() : i32;
extern fn ui_tt_cache_hits() : i32;
extern fn ui_tt_cache_misses() : i32;
extern fn ui_tt_cache_evictions() : i32;
extern fn ui_tt_cache_live() : i32;
extern fn ui_tt_raster_ms() : i64;
extern fn ui_tt_raster_n() : i32;
extern fn ui_tt_set_clock(f: fn() : i64) : i32;
// Custom fonts (v2.5, stdlib/asterui/font_runtime.ast):
// load a font file from a device path, restore the system font,
// and report custom-font state. Weight is read from the file,
// never from the filename (see aui_rt_font_weight).
extern fn aui_rt_set_custom_font(path: ptr) : i32;
extern fn aui_rt_restore_system_font() : i32;
extern fn aui_rt_custom_active() : i32;
extern fn aui_rt_custom_err() : i32;
extern fn aui_rt_custom_load_ms() : i32;
extern fn aui_rt_custom_path() : ptr;
extern fn aui_rt_system_path() : ptr;
extern fn aui_rt_font_weight() : i32;
extern fn ui_sysfont_name_weight() : i32;
extern fn ui_sysfont_path() : ptr;
extern fn ui_sysfont_face_name() : ptr;

fn font_at_u8(f: ptr, off: i32) : i32 {
    if (f == 0) { return 0; }
    return load_u8(f + off);
}

fn font_at_u16(f: ptr, off: i32) : i32 {
    if (f == 0) { return 0; }
    return load_u16(f + off);
}

fn font_at_u32(f: ptr, off: i32) : i32 {
    if (f == 0) { return 0; }
    return *(f + off);
}

fn font_u8(off: i32) : i32 { return font_at_u8(g_aui_font, off); }
fn font_u16(off: i32) : i32 { return font_at_u16(g_aui_font, off); }
fn font_u32(off: i32) : i32 { return font_at_u32(g_aui_font, off); }

fn font_glyph_count() : i32 { return font_u16(8); }
fn font_pixel() : i32 { return font_u16(10); }
fn font_line_h() : i32 { return font_u8(12); }
fn font_table() : i32 { return font_u32(16); }
fn font_bitmap() : i32 { return font_u32(20); }

fn font2_pixel() : i32 { return font_at_u16(g_aui_font2, 10); }
fn font2_line_h() : i32 { return font_at_u8(g_aui_font2, 12); }

// 在指定字体里二分查找码点；返回字形记录相对文件头的偏移，找不到 -1。
fn glyph_find_in(f: ptr, cp: i32) : i32 {
    if (f == 0) { return -1; }
    let lo: i32 = 0;
    let hi: i32 = font_at_u16(f, 8) - 1;
    let tab: i32 = font_at_u32(f, 16);
    while (lo <= hi) {
        let mid: i32 = (lo + hi) / 2;
        let off: i32 = tab + mid * 16;
        let c: i32 = *(f + off);
        if (c == cp) { return off; }
        if (c < cp) { lo = mid + 1; } else { hi = mid - 1; }
    }
    return -1;
}

fn glyph_find(cp: i32) : i32 { return glyph_find_in(g_aui_font, cp); }

fn glyph_advance(cp: i32) : i32 {
    // W2: runtime-font path -- advance from the adapter (hmtx, or the
    // hand-drawn fallback). The AUF branch below is reference-only.
    if (g_aui_rt_mode == 1) {
        let ra: i32 = aui_rt_advance(cp);
        return fx(ra * g_aui_text_scale);
    } else {
    }
    let off: i32 = glyph_find_in(g_aui_font, cp);
    if (off >= 0) {
        return fx(load_u8(g_aui_font + off + 4) * g_aui_text_scale);
    }
    if (g_aui_font2 != 0) {
        off = glyph_find_in(g_aui_font2, cp);
        if (off >= 0) {
            return fx(load_u8(g_aui_font2 + off + 4) * g_aui_text_scale2);
        }
    }
    return fx(8 * g_aui_text_scale);
}

// ===========================================================================
// v2.15：排版角色（TextRole，对照 HuxerUI DefaultTextStyle）。
// ---------------------------------------------------------------------------
// role 存在节点的 aux2 里（0 Body / 1 Label / 2 Title，缺省 Body；
// 其它值按 Body 处理）。角色解析出的 (cell, bold) 写进下面两个全局，
// 再由 text_style_for_node 推给运行时（aui_rt_set_cell，跨编译单元）。
// cell 是光栅化 em 尺寸（px，scale 1 下）：Body 48（= v2.14 的唯一
// 尺寸，像素恒等）、Label 48 + 仿粗、Title 64（行高 80 px）。bold 是
// 仿粗：绘制时每个字形画两次、第二次右移 1 设备 px，与顶栏标题的
// top_bar_bold_off() 同一手法；回退位图（24/48 px 固定暂存）不放大，
// 只按 cell 推进——见 font_runtime.ast 的说明。
// 调用点：measure() 入口、paint_node() 入口、emit_text_lines() 入口
// 各按当前节点的 aux2 置一次；TEXT 命令的 aux 带上 (cell | bold<<16)，
// 回放时按命令恢复（draw_cmd_list_from op 2）。Canvas 文本与调试面板
// 不走角色（Canvas 用节点自身的 Body；面板走 op 10 定尺寸文本）。
// ===========================================================================
let AUI_ROLE_BODY: i32 = 0;
let AUI_ROLE_LABEL: i32 = 1;
let AUI_ROLE_TITLE: i32 = 2;

let g_aui_text_cell: i32 = 48;
let g_aui_text_bold: i32 = 0;

// 角色 -> 打包样式 (cell | bold<<16)。HuxerUI 的角色映射是
// Body->body_medium、Label->label_large、Title->title_large；这里
// body/label 同一 em 尺寸（48），只用粗细区分，Title 用更大的 em（64）。
fn text_role_style(role: i32) : i32 {
    if (role == AUI_ROLE_TITLE) { return 64; }
    if (role == AUI_ROLE_LABEL) { return 48 | (1 << 16); }
    return 48;
}

// 按节点的角色置当前排版样式（含推给运行时）。在 measure/paint/
// emit_text_lines 各入口调用；调用者负责在子树之后恢复（paint_node
// 存取，measure 靠每次入口重设）。
// 注意：角色只读 label(5)/button(6) 的 aux2；其它种类的 aux2 另有
// 用途（vlist/vgrid/hlist 的行下标、尺寸等），读作角色会 corrupt 渲染。
fn text_style_for_node(n: ptr<AuiNode>) : i32 {
    let role: i32 = 0;
    if (n.kind == 5 || n.kind == 6) { role = n.aux2; }
    let st: i32 = text_role_style(role);
    let cell: i32 = st & 65535;
    // D-2a：逐节点字号覆盖（只对 label/button；其它种的 aux2 另有用途，
    // 与 aui_text_role 同一适用范围）。sp → em 像素与角色制同一口径：
    // 正文 16 sp = 48 px，即 cell = sp * 3；运行时 cell 钳在 8..64
    // （aui_rt_set_cell）。字号只覆盖尺寸，角色的粗细（bold）保留。
    if (n.kind == 5 || n.kind == 6) {
        let ti: i32 = d2a_idx(n);
        if (ti >= 0 && g_d2a_text_sp[ti] >= 0) {
            cell = g_d2a_text_sp[ti] * 3;
            if (cell < 8) { cell = 8; }
            if (cell > 64) { cell = 64; }
        }
    }
    // v2.16：绘制阶段的缩放同时缩放字号。measure 时缩放栈恒为空
    // （paint_node 的存取保证），所以布局尺寸不受影响；emit 时按
    // 完整缩放重算，断行与居中都用缩放后的度量。
    if (g_aui_paint_sc_d != 0) {
        cell = paint_scale_w(cell);
        if (cell < 8) { cell = 8; }
        if (cell > 64) { cell = 64; }
        // v2.16.1：缩放中的字号按 8 px 取整。弹簧/滑杆扫过 1.0x→1.15x 时
        // cell 逐像素变（48→55），每个新尺寸都重光栅全部可见字形（一轮
        // 弹簧 185 次 miss，128 格缓存被逐尺寸条目挤穿、后续帧反复抖穿）。
        // 取整后一轮只剩 48/56 两个尺寸，首轮约 60 次 miss，之后全命中；
        // 字形尺寸步进 ≤8 px（按钮矩形仍平滑缩放），可接受。未缩放时
        // 不走这支，48/64 精确值不变。
        cell = (cell + 4) / 8 * 8;
        if (cell < 8) { cell = 8; }
        if (cell > 64) { cell = 64; }
    }
    g_aui_text_cell = cell;
    g_aui_text_bold = (st >> 16) & 65535;
    let rc: i32 = aui_rt_set_cell(g_aui_text_cell);
    return 0;
}

// 恢复默认排版样式（Body）。不带角色的浮层绘制器（菜单/浮层/提示/
// Toast/SnackBar）在入口调它，避免用上子树残留的 cell。
fn text_style_default() : i32 {
    g_aui_text_cell = 48;
    g_aui_text_bold = 0;
    let rc: i32 = aui_rt_set_cell(48);
    return 0;
}

// 当前样式的 TEXT 命令 aux（cell | bold<<16）。aux==0 的旧命令按
// 默认 48/不粗回放（Canvas 文本、历史快照）。
fn text_cmd_aux() : i32 {
    return g_aui_text_cell | (g_aui_text_bold << 16);
}

// 修饰器：给最近创建的节点设排版角色（紧跟 aui_label/aui_button 等调用）。
// 只对 label(5)/button(6) 有效；其它种类的 aux2 另有用途，调用无效果
//（返回 -1），避免误写行下标或尺寸。
fn aui_text_role(role: i32) : i32 {
    let n: ptr<AuiNode> = modify_target();
    if (n == 0) { return 0; }
    if (n.kind != 5 && n.kind != 6) { return -1; }
    n.aux2 = role;
    return 0;
}

// 测试探针：角色 -> 打包样式（cell | bold<<16），与 text_role_style 同值。
fn aui_debug_text_role(role: i32) : i32 {
    return text_role_style(role);
}

// 行高取两套字体的较大者；拉丁 8x8 放大 2 倍（20 px）通常高于 16x16
// 汉字（18 px），所以混合排版不会被汉字撑高。
// W2: runtime-font path -- one native size (48 px em, 60 px line at
// scale 1, matching font_latin48/font_cjk48); the AUF branch below
// is reference-only.
fn text_line_h() : i32 {
    if (g_aui_rt_mode == 1) {
        let lh0: i32 = aui_rt_line_h();
        return fx(lh0 * g_aui_text_scale);
    } else {
    }
    let lh: i32 = font_line_h() * g_aui_text_scale;
    if (g_aui_font2 != 0) {
        let l2: i32 = font2_line_h() * g_aui_text_scale2;
        if (l2 > lh) { lh = l2; }
    }
    return fx(lh);
}

// 文本命令的字形高度：同样取较大者，用来垂直居中。
// W2: runtime-font path -- native em 48 px at scale 1.
fn text_glyph_h() : i32 {
    if (g_aui_rt_mode == 1) {
        let gh0: i32 = aui_rt_pixel();
        return fx(gh0 * g_aui_text_scale);
    } else {
    }
    let gh: i32 = font_pixel() * g_aui_text_scale;
    if (g_aui_font2 != 0) {
        let g2: i32 = font2_pixel() * g_aui_text_scale2;
        if (g2 > gh) { gh = g2; }
    }
    return fx(gh);
}

fn utf8_next(s: ptr, i: i32, tlen: i32) : i32 {
    let b: i32 = load_u8(s + i);
    if (b < 128) {
        g_aui_utf8_adv = 1;
        return b;
    }
    if ((b & 224) == 192 && i + 1 < tlen) {
        let b1: i32 = load_u8(s + i + 1);
        g_aui_utf8_adv = 2;
        return ((b & 31) << 6) | (b1 & 63);
    }
    if ((b & 240) == 224 && i + 2 < tlen) {
        let b1: i32 = load_u8(s + i + 1);
        let b2: i32 = load_u8(s + i + 2);
        g_aui_utf8_adv = 3;
        return ((b & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63);
    }
    if ((b & 248) == 240 && i + 3 < tlen) {
        let b1: i32 = load_u8(s + i + 1);
        let b2: i32 = load_u8(s + i + 2);
        let b3: i32 = load_u8(s + i + 3);
        g_aui_utf8_adv = 4;
        return ((b & 7) << 18) | ((b1 & 63) << 12) | ((b2 & 63) << 6) | (b3 & 63);
    }
    g_aui_utf8_adv = 1;
    return 65533;
}

// 返回最宽行宽（Q16.16），设置 g_aui_mlines。maxw<=0 表示不换行。
//
// v1.18：换行优先落在最近的空格上（整词换行），只有一个单词本身就比一整行
// 还宽时才按字符切。这样 24px 字体下的长句不会出现 "t/est" 这种断词。
// 行结果同时缓存给 emit_text_lines 用，保证测量宽度 == 实际绘制。
fn layout_text(s: ptr, tlen: i32, maxw: i32) : i32 {
    let lines: i32 = 0;
    let mx: i32 = 0;
    let i: i32 = 0;
    let start: i32 = 0;
    let lw: i32 = 0;          // 当前行宽（含空格）
    let wordw: i32 = 0;       // 最近一个空格之后的宽度
    let sp: i32 = -1;         // 当前行最近一个空格的位置
    let spw: i32 = 0;         // 该空格之前的行宽
    while (i < tlen) {
        let b: i32 = load_u8(s + i);
        if (b == 10) {
            if (lines < AUI_LINE_CAP) {
                g_aui_line_start[lines] = start;
                g_aui_line_len[lines] = i - start;
                g_aui_line_w[lines] = lw;
                lines = lines + 1;
            }
            if (lw > mx) { mx = lw; }
            i = i + 1;
            start = i;
            lw = 0; wordw = 0; sp = -1;
        } else {
            let cp: i32 = utf8_next(s, i, tlen);
            let adv: i32 = glyph_advance(cp);
            if (maxw > 0 && lw > 0 && lw + adv > maxw) {
                if (sp >= start) {
                    // 在空格处折行，空格本身不出现在行尾。
                    if (lines < AUI_LINE_CAP) {
                        g_aui_line_start[lines] = start;
                        g_aui_line_len[lines] = sp - start;
                        g_aui_line_w[lines] = spw;
                        lines = lines + 1;
                    }
                    if (spw > mx) { mx = spw; }
                    start = sp + 1;
                    lw = wordw;
                    sp = -1;
                }
                if (lw > 0 && lw + adv > maxw) {
                    // 单个词比整行还宽：退化成按字符切。
                    if (lines < AUI_LINE_CAP) {
                        g_aui_line_start[lines] = start;
                        g_aui_line_len[lines] = i - start;
                        g_aui_line_w[lines] = lw;
                        lines = lines + 1;
                    }
                    if (lw > mx) { mx = lw; }
                    start = i;
                    lw = 0;
                }
            }
            if (b == 32) {
                sp = i;
                spw = lw;
                wordw = 0;
            } else {
                wordw = wordw + adv;
            }
            lw = lw + adv;
            i = i + g_aui_utf8_adv;
        }
    }
    if (lines < AUI_LINE_CAP) {
        g_aui_line_start[lines] = start;
        g_aui_line_len[lines] = tlen - start;
        g_aui_line_w[lines] = lw;
        lines = lines + 1;
    }
    if (lw > mx) { mx = lw; }
    g_aui_mlines = lines;
    g_aui_mwidth = mx;
    return mx;
}

fn text_measure(s: ptr, tlen: i32, maxw: i32) : i32 {
    return layout_text(s, tlen, maxw);
}

// ===========================================================================
// 4. 构建器
// ===========================================================================

fn node_at(i: i32) : ptr<AuiNode> {
    return g_aui_nodes + i * sizeof(AuiNode);
}

fn cmd_at(i: i32) : ptr<AuiCmd> {
    return g_aui_cmds + i * sizeof(AuiCmd);
}

// ===========================================================================
// 5b. 可诊断错误与帧区度量（Phase 0 真正回收）
// ===========================================================================
// 容量耗尽不再静默：最近一次错误码，0 = 无错误。错误码段见 CONTRACT.md §3
// （A-100–A-199 归 AsterUI 运行时）：A-10x 内存与容量，A-12x 线程与回调。
let g_aui_last_err: i32 = 0;
let AUI_ERR_NODE_FULL: i32 = 100;
let AUI_ERR_CMD_FULL: i32 = 101;
let AUI_ERR_NUM_OVERFLOW: i32 = 102;
let AUI_ERR_TABLE_FULL: i32 = 103;
let AUI_ERR_LINE_TRUNC: i32 = 104;
let AUI_ERR_CB_FULL: i32 = 120;
let AUI_ERR_CB_BAD_HANDLE: i32 = 121;
let AUI_ERR_CB_RETIRED: i32 = 122;

fn aui_set_err(code: i32) : i32 {
    g_aui_last_err = code;
    return code;
}

fn aui_last_error() : i32 { return g_aui_last_err; }

fn aui_clear_error() : i32 {
    g_aui_last_err = 0;
    return 0;
}

// 帧区度量：节点/命令/数字缓冲每 build 重置（见 aui_root）；高水位只增
// 不减，直到显式复位；frame_seq 每 build +1；sealed 在提交后置 1、
// 下一 build 开始时清 0（提交后不得保留指向临时区的指针）。
let g_aui_frame_seq: i32 = 0;
let g_aui_frame_sealed: i32 = 0;
let g_aui_frame_node_hwm: i32 = 0;
let g_aui_frame_cmd_hwm: i32 = 0;
let g_aui_frame_num_hwm: i32 = 0;

fn node_alloc(kind: i32, key: i32) : i32 {
    if (g_aui_node_count >= AUI_NODE_CAP) { let e: i32 = aui_set_err(AUI_ERR_NODE_FULL); return -1; }
    // v2.6：Canvas 绘制回调里不许建节点。回调在 paint_node 中途执行，
    // 此时新建节点会挂进正在绘制的保留树（子节点遍历已开始），属于
    // 合同越界：拒绝，不静默兜底。
    if (g_aui_in_cv != 0) { return -1; }
    g_aui_last_closed = -1;      // 新节点之后 aui_tooltip 回到“最近创建”语义
    let i: i32 = g_aui_node_count;
    g_aui_node_count = g_aui_node_count + 1;
    let n: ptr<AuiNode> = node_at(i);
    n.kind = kind;
    n.flags = 0;
    n.key = key;
    n.parent = -1;
    n.first_child = -1;
    n.next_sibling = -1;
    n.x = 0; n.y = 0; n.w = 0; n.h = 0;
    n.pad = 0;
    n.gap = 0;
    n.weight = 0;
    n.align = 0;
    n.bg = 0;
    n.radius = 0;
    n.aux = -1;
    n.aux2 = 0;
    n.text = g_aui_null;
    n.cb = 0;
    n.user = g_aui_null;
    g_aui_sem_role[i] = 0;   // v2.19：语义注册随节点复位（每帧重建）
    g_aui_sem_label[i] = 0;
    g_aui_sem_hide[i] = 0;
    g_d2a_size_w[i] = -1;     // D-2a：修饰值随节点复位（每帧重建）
    g_d2a_size_h[i] = -1;
    g_d2a_text_sp[i] = -1;
    g_d2a_fg[i] = 0;
    g_d2a_fg_set[i] = 0;
    g_d2a_sel[i] = 0;
    return i;
}

fn attach_child(child: i32) : i32 {
    if (child < 0) { return -1; }
    let par: i32 = g_aui_stk_parent[g_aui_depth];
    let last: i32 = g_aui_stk_last[g_aui_depth];
    let cn: ptr<AuiNode> = node_at(child);
    cn.parent = par;
    cn.next_sibling = -1;
    if (last < 0) {
        let pn: ptr<AuiNode> = node_at(par);
        pn.first_child = child;
    } else {
        let ln: ptr<AuiNode> = node_at(last);
        ln.next_sibling = child;
    }
    g_aui_stk_last[g_aui_depth] = child;
    return child;
}

fn push_container(kind: i32, key: i32) : i32 {
    let i: i32 = node_alloc(kind, key);
    if (i < 0) { return -1; }
    let r: i32 = attach_child(i);
    if (g_aui_depth < AUI_STACK_MAX) {
        g_aui_depth = g_aui_depth + 1;
        g_aui_stk_parent[g_aui_depth] = i;
        g_aui_stk_last[g_aui_depth] = -1;
    }
    g_aui_last_created = i;
    return i;
}

fn push_leaf(kind: i32, key: i32) : i32 {
    let i: i32 = node_alloc(kind, key);
    if (i < 0) { return -1; }
    let r: i32 = attach_child(i);
    g_aui_last_created = i;
    return i;
}

fn aui_root() : i32 {
    // Phase 0：采样上一 build 的终值进高水位（节点/命令/数字缓冲在
    // 本 build 开始时清零，终值只有此刻能看到）。
    if (g_aui_node_count > g_aui_frame_node_hwm) { g_aui_frame_node_hwm = g_aui_node_count; }
    if (g_aui_cmd_count > g_aui_frame_cmd_hwm) { g_aui_frame_cmd_hwm = g_aui_cmd_count; }
    if (g_aui_num_off > g_aui_frame_num_hwm) { g_aui_frame_num_hwm = g_aui_num_off; }
    g_aui_frame_seq = g_aui_frame_seq + 1;
    g_aui_frame_sealed = 0;
    g_aui_node_count = 0;
    g_aui_cmd_count = 0;
    g_aui_num_off = 0;
    g_aui_depth = 0;
    g_aui_root = -1;
    // v2.15：每帧重建，主题栈从空开始（上一帧漏掉的 aui_end 不污染本帧）。
    g_aui_theme_depth = 0;
    // v1.24：“刚点/刚松手”的提案值只保证在当帧回调里可读；重建后
    // aui_tabs_value / aui_pager_value 回读到的是应用保存的真实选中页。
    g_aui_tab_key = 0;
    g_aui_nav_key = 0;
    g_aui_pager_prop_key = 0;
    g_aui_dialog = -1;
    g_aui_dialog_card = -1;
    g_aui_dialog_reason = 0;
    // v1.38：底部弹出层同帧重建；had 用来判断是不是“新打开”，避免每次
    // 重建都把滑入动画从头播一遍。
    if (g_aui_sheet >= 0) { g_aui_sheet_had = 1; } else { g_aui_sheet_had = 0; }
    g_aui_sheet = -1;
    g_aui_sheet_card = -1;
    g_aui_sheet_reason = 0;
    // v1.35：菜单不挂树，每帧构建时重新登记；had 用来区分“持续打开”
    // 与“重新打开”，后者要把内部滚动偏移归零。
    if (g_aui_menu >= 0) { g_aui_menu_had = 1; } else { g_aui_menu_had = 0; }
    g_aui_menu = -1;
    g_aui_menu_items = 0;
    // v1.39：锚定浮层同帧重建；had 只用于区分“持续打开”，不重播状态。
    if (g_aui_popup >= 0) { g_aui_popup_had = 1; } else { g_aui_popup_had = 0; }
    g_aui_popup = -1;
    g_aui_select_open = -1;
    g_aui_select_key = 0;
    g_aui_select_val = -1;
    g_aui_select_reason = 0;
    // v1.26.2：按压下标属于输入状态，不再在重建时清空（否则 DOWN 触发的
    // 重建会把刚点下的选项底色还原，选项按下视觉永远不出现）。它由
    // DOWN/UP/CANCEL/BACK 负责清除，只在浮层打开期间有意义。
    g_aui_select_px = 0;
    g_aui_select_py = 0;
    g_aui_select_pw = 0;
    g_aui_select_ph = 0;
    g_aui_select_vis = 0;
    // v1.44：组合框同帧重建。按压下标属于输入状态，交给 DOWN/UP/CANCEL
    // 清理；浮层矩形每帧重算。
    g_aui_combo_open = -1;
    g_aui_combo_key = 0;
    g_aui_combo_val = -1;
    g_aui_combo_pick = 0;
    g_aui_combo_reason = 0;
    g_aui_combo_px = 0;
    g_aui_combo_py = 0;
    g_aui_combo_pw = 0;
    g_aui_combo_ph = 0;
    g_aui_combo_vis = 0;
    // v1.27：工具提示登记表每帧重建；显示中的气泡持有文本/锚点快照，
    // 重建不影响它（和按压态一样属于输入状态）。
    g_aui_tip_used = 0;
    g_aui_last_closed = -1;
    // v1.32：不确定进度圈每帧重建时重新登记；帧泵靠这个标志续命。
    g_aui_spin_live = 0;
    g_aui_spin_phase = 0;
    let r: i32 = node_alloc(1, 0);
    g_aui_root = r;
    g_aui_stk_parent[0] = r;
    g_aui_stk_last[0] = -1;
    g_aui_last_created = r;
    return r;
}

fn aui_column(key: i32) : i32 { return push_container(2, key); }
fn aui_row(key: i32) : i32 { return push_container(3, key); }
fn aui_stack(key: i32) : i32 { return push_container(4, key); }
fn aui_scroll(key: i32) : i32 { return push_container(9, key); }

// v1.45：虚拟列表（对照 HuxerUI VirtualList）。只创建视口附近的行：
// 构建时按“当前偏移 + 上一帧视口高”算出 [first, last]，调用 on_bind
// 让应用用 aui_vlist_row 建这些行；布局后若窗口不够或视口变了，下一拍
// 自动重建。行高固定（item_dp），内容总高 = pad*2 + count*行高。
// on_tap 挂到每一行上；点行时先写 (容器 key, 行下标)，回调里用
// aui_vlist_tap_index() 读取。
fn aui_vlist(key: i32, count: i32, item_dp: i32,
             on_bind: fn(ptr) : i32, on_tap: fn(ptr) : i32,
             user: ptr) : i32 {
    let i: i32 = push_container(51, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    if (count < 0) { count = 0; }
    let ih: i32 = dp2q(item_dp);
    if (ih < 65536) { ih = 65536; }
    n.aux = count;
    n.aux2 = ih;
    n.cb = on_tap;
    n.user = user;
    let s: i32 = vlist_slot(key);
    let used: i32 = 0;
    if (s >= 0) { used = g_aui_vlist_vp[s]; }
    if (used <= 0) { used = dp2q(480); }
    // 偏移一律按像素处理（总高可达数十万 px，不能放进 Q16.16）。
    let usedpx: i32 = used >> 16;
    if (usedpx <= 0) { usedpx = 480; }
    let cpx: i32 = i32((i64(count) * i64(ih)) / 65536);
    let off: i32 = scroll_get(key);
    if (off > cpx - usedpx) { off = cpx - usedpx; }
    if (off < 0) { off = 0; }
    let ihpx: i32 = ih >> 16;
    if (ihpx < 1) { ihpx = 1; }
    // 窗口公式不扣内边距：pad 可能在本调用之后才由 aui_pad 设置，
    // 忽略它只会多取一行，不会漏行。
    // v1.48.5：上下各多建两行。拖动/惯性不再每一帧强制重建，窗口是否
    // 够用交给 arrange_vlist 判断；多出的一行就是“检测到需要重建”到
    // “下一拍真的重建”之间的过渡，快速滑动时不会露出空白行。
    let first: i32 = off / ihpx - 2;
    if (first < 0) { first = 0; }
    let last: i32 = (off + usedpx) / ihpx + 2;
    if (last > count - 1) { last = count - 1; }
    if (last < first) { last = first - 1; }
    if (s >= 0) {
        g_aui_vlist_used_vp[s] = used;
        g_aui_vlist_first[s] = first;
        g_aui_vlist_last[s] = last;
    }
    // on_bind 允许嵌套（虽然少见）：保存并恢复当前上下文。
    let sv_key: i32 = g_aui_vlist_cur_key;
    let sv_ih: i32 = g_aui_vlist_cur_ih;
    let sv_user: ptr = g_aui_vlist_cur_user;
    let sv_tap: fn(ptr) : i32 = g_aui_vlist_cur_tap;
    let sv_first: i32 = g_aui_vlist_first_cur;
    let sv_last: i32 = g_aui_vlist_last_cur;
    g_aui_vlist_cur_key = key;
    g_aui_vlist_cur_ih = ih;
    g_aui_vlist_cur_user = user;
    g_aui_vlist_cur_tap = on_tap;
    g_aui_vlist_first_cur = first;
    g_aui_vlist_last_cur = last;
    if (on_bind != 0) { let r: i32 = on_bind(user); }
    g_aui_vlist_cur_key = sv_key;
    g_aui_vlist_cur_ih = sv_ih;
    g_aui_vlist_cur_user = sv_user;
    g_aui_vlist_cur_tap = sv_tap;
    g_aui_vlist_first_cur = sv_first;
    g_aui_vlist_last_cur = sv_last;
    // on_bind 里的 aui_end 会把 last_created 清掉；恢复成容器本身，
    // 让调用方紧接着的 aui_weight / aui_pad / aui_bg 作用在列表上。
    g_aui_last_created = i;
    return i;
}

// 在 on_bind 里按可见顺序建一行；行高固定，宽度由 arrange 撑到内容宽。
fn aui_vlist_row(index: i32) : i32 {
    let i: i32 = push_container(52, 0);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.aux = g_aui_vlist_cur_ih;
    n.aux2 = index;
    n.cb = g_aui_vlist_cur_tap;
    n.user = g_aui_vlist_cur_user;
    return i;
}

// 当前 on_bind 窗口（闭区间）。只在 build 期间有意义。
fn aui_vlist_first() : i32 { return g_aui_vlist_first_cur; }
fn aui_vlist_last() : i32 { return g_aui_vlist_last_cur; }
// 最近一次点中的行下标；不在行点击回调里时为 -1。
fn aui_vlist_tap_index() : i32 { return g_aui_vlist_tap_idx; }
fn aui_vlist_tap_key() : i32 { return g_aui_vlist_tap_key; }

// ---- 不定高虚拟列表（v2.10）----
// 项高：已缓存的用缓存值（像素，>= 1），否则用估计高；s < 0（登记表满，
// 列表没拿到槽）时全部用估计高。
fn vlvar_h(s: i32, idx: i32, estpx: i32) : i32 {
    if (s < 0) { return estpx; }
    if (idx < 0) { return estpx; }
    if (idx >= AUI_VLVAR_HCAP) { return estpx; }
    let h: i32 = g_aui_vlvar_h[s * AUI_VLVAR_HCAP + idx];
    if (h <= 0) { return estpx; }
    return h;
}

// 前 idx 项的高度和（像素），用估计高补未测量项；idx 钳到 [0, count]。
fn vlvar_prefix(s: i32, idx: i32, count: i32, estpx: i32) : i32 {
    let n: i32 = idx;
    if (n > count) { n = count; }
    if (n < 0) { n = 0; }
    let sum: i32 = 0;
    let i: i32 = 0;
    while (i < n) {
        sum = sum + vlvar_h(s, i, estpx);
        i = i + 1;
    }
    return sum;
}

fn vlvar_total(s: i32, count: i32, estpx: i32) : i32 {
    return vlvar_prefix(s, count, count, estpx);
}

// 已测量项数（下标 < min(count, HCAP) 里缓存 > 0 的项）。
fn vlvar_measured(s: i32, count: i32) : i32 {
    if (s < 0) { return 0; }
    let n: i32 = count;
    if (n > AUI_VLVAR_HCAP) { n = AUI_VLVAR_HCAP; }
    if (n < 0) { n = 0; }
    let m: i32 = 0;
    let i: i32 = 0;
    while (i < n) {
        if (g_aui_vlvar_h[s * AUI_VLVAR_HCAP + i] > 0) { m = m + 1; }
        i = i + 1;
    }
    return m;
}

// 整表清零（只清高度，不触发布局；build 里换数据时用）。
fn vlvar_clear(s: i32) : i32 {
    if (s < 0) { return -1; }
    let i: i32 = 0;
    while (i < AUI_VLVAR_HCAP) {
        g_aui_vlvar_h[s * AUI_VLVAR_HCAP + i] = 0;
        i = i + 1;
    }
    return 0;
}

// 由偏移/视口算窗口 [first, last]（闭区间，上下各多 2 行余量）：
// first = 首个底边 > off 的项；last = 末个顶边 < off+vp 的项。
// 一次线性扫描累加（count <= 1024 时每帧一次可忽略）。
// out[0] = first，out[1] = last。
fn vlvar_window(s: i32, count: i32, estpx: i32, off: i32, vp: i32, out: ptr) : i32 {
    let first: i32 = 0;
    let last: i32 = -1;
    if (count > 0) {
        let sum: i32 = 0;
        let i: i32 = 0;
        let found: i32 = 0;
        while (i < count) {
            let h: i32 = vlvar_h(s, i, estpx);
            let top: i32 = sum;
            let bot: i32 = sum + h;
            if (found == 0 && bot > off) { first = i; found = 1; }
            if (top < off + vp) { last = i; }
            sum = sum + h;
            i = i + 1;
        }
        if (found == 0) { first = count - 1; }
        if (last < first) { last = first; }
    }
    first = first - 2;
    if (first < 0) { first = 0; }
    last = last + 2;
    if (last > count - 1) { last = count - 1; }
    if (last < first) { last = first - 1; }
    *(out + 0) = first;
    *(out + 4) = last;
    return 0;
}

// v2.10：不定高虚拟列表（对照 HuxerUI VirtualList.EstimatedItemExtent）。
// 只创建视口附近的行：构建时按“当前偏移 + 上一帧视口高”算出 [first, last]，
// 调用 on_bind 让应用用 aui_vlist_var_row 建这些行；布局后若窗口不够或
// 视口变了，下一拍自动重建。行高由内容量出并按下标缓存（见
// measure_vlist_var_row），未量过的项用估计高 est_dp。
// on_tap 挂到每一行上；点行时先写 (容器 key, 行下标)，回调里用
// aui_vlist_tap_index() 读取（与固定列表共用）。
fn aui_vlist_var(key: i32, count: i32, est_dp: i32,
                 on_bind: fn(ptr) : i32, on_tap: fn(ptr) : i32,
                 user: ptr) : i32 {
    let i: i32 = push_container(58, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    if (count < 0) { count = 0; }
    let est: i32 = dp2q(est_dp);
    if (est < 65536) { est = 65536; }
    n.aux = count;
    n.aux2 = est;
    n.cb = on_tap;
    n.user = user;
    let s: i32 = vlist_slot(key);
    if (s >= 0) {
        g_aui_vlist_var[s] = 1;
        // count 直接变了（没走 insert/remove）= 换了一批数据：整表失效重测。
        // insert/remove 自己维护 g_aui_vlvar_count，所以走它们的 count 变化
        // 不会误清（平移后的缓存保留）。
        if (g_aui_vlvar_count[s] != 0 && g_aui_vlvar_count[s] != count) {
            let cl: i32 = vlvar_clear(s);
        }
        g_aui_vlvar_count[s] = count;
        let estpx: i32 = est >> 16;
        if (estpx < 1) { estpx = 1; }
        g_aui_vlvar_est[s] = estpx;
    }
    let used: i32 = 0;
    if (s >= 0) { used = g_aui_vlist_vp[s]; }
    if (used <= 0) { used = dp2q(480); }
    // 偏移一律按像素处理（总高可达数十万 px，不能放进 Q16.16）。
    let usedpx: i32 = used >> 16;
    if (usedpx <= 0) { usedpx = 480; }
    let estpx2: i32 = est >> 16;
    if (estpx2 < 1) { estpx2 = 1; }
    let total: i32 = 0;
    if (s >= 0) { total = vlvar_total(s, count, estpx2); } else { total = count * estpx2; }
    let off: i32 = scroll_get(key);
    if (off > total - usedpx) { off = total - usedpx; }
    if (off < 0) { off = 0; }
    // 窗口公式不扣内边距：pad 可能在本调用之后才由 aui_pad 设置，
    // 忽略它只会多取一行，不会漏行。
    let w: i32[2] = 0;
    let rw: i32 = vlvar_window(s, count, estpx2, off, usedpx, w);
    let first: i32 = w[0];
    let last: i32 = w[1];
    if (s >= 0) {
        g_aui_vlist_used_vp[s] = used;
        g_aui_vlist_first[s] = first;
        g_aui_vlist_last[s] = last;
    }
    // on_bind 允许嵌套（虽然少见）：保存并恢复当前上下文。
    let sv_key: i32 = g_aui_vlist_cur_key;
    let sv_ih: i32 = g_aui_vlist_cur_ih;
    let sv_user: ptr = g_aui_vlist_cur_user;
    let sv_tap: fn(ptr) : i32 = g_aui_vlist_cur_tap;
    let sv_first: i32 = g_aui_vlist_first_cur;
    let sv_last: i32 = g_aui_vlist_last_cur;
    g_aui_vlist_cur_key = key;
    g_aui_vlist_cur_ih = est;
    g_aui_vlist_cur_user = user;
    g_aui_vlist_cur_tap = on_tap;
    g_aui_vlist_first_cur = first;
    g_aui_vlist_last_cur = last;
    if (on_bind != 0) { let r: i32 = on_bind(user); }
    g_aui_vlist_cur_key = sv_key;
    g_aui_vlist_cur_ih = sv_ih;
    g_aui_vlist_cur_user = sv_user;
    g_aui_vlist_cur_tap = sv_tap;
    g_aui_vlist_first_cur = sv_first;
    g_aui_vlist_last_cur = sv_last;
    // on_bind 里的 aui_end 会把 last_created 清掉；恢复成容器本身，
    // 让调用方紧接着的 aui_weight / aui_pad / aui_bg 作用在列表上。
    g_aui_last_created = i;
    return i;
}

// 在 on_bind 里按可见顺序建一行；行是列容器，高度由内容量出（见
// measure_vlist_var_row），宽度由 arrange 撑到内容宽。
fn aui_vlist_var_row(index: i32) : i32 {
    let i: i32 = push_container(59, 0);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.aux = 0;
    n.aux2 = index;
    n.cb = g_aui_vlist_cur_tap;
    n.user = g_aui_vlist_cur_user;
    return i;
}

// 程序化滚动到指定项：align 0 顶对齐 / 1 居中 / 2 底对齐。
// 返回实际偏移（像素）；列表不存在返回 -1。
fn aui_vlist_var_scroll_to_item(key: i32, index: i32, align: i32) : i32 {
    let s: i32 = vlist_find(key);
    if (s < 0) { return -1; }
    let count: i32 = g_aui_vlvar_count[s];
    if (count <= 0) { return -1; }
    if (index < 0) { index = 0; }
    if (index > count - 1) { index = count - 1; }
    let estpx: i32 = g_aui_vlvar_est[s];
    if (estpx < 1) { estpx = 1; }
    let vp: i32 = g_aui_vlist_vp[s] >> 16;
    if (vp <= 0) { vp = 480; }
    let top: i32 = vlvar_prefix(s, index, count, estpx);
    let h: i32 = vlvar_h(s, index, estpx);
    let target: i32 = top;
    if (align == 1) { target = top - (vp - h) / 2; }
    if (align == 2) { target = top + h - vp; }
    let v: i32 = scroll_set(key, target);
    let vt: i32 = vlist_touch(key);
    let r: i32 = aui_invalidate_layout();
    return v;
}

// 单项失效：清掉该项缓存高度，下一拍重测。返回 0；列表不存在或下标
// 越界返回 -1。
fn aui_vlist_var_invalidate(key: i32, index: i32) : i32 {
    let s: i32 = vlist_find(key);
    if (s < 0) { return -1; }
    if (index < 0 || index >= AUI_VLVAR_HCAP) { return -1; }
    g_aui_vlvar_h[s * AUI_VLVAR_HCAP + index] = 0;
    let vt: i32 = vlist_touch(key);
    let r: i32 = aui_invalidate_layout();
    return 0;
}

// 整表失效：清掉全部缓存高度，下一拍逐项重测。
fn aui_vlist_var_invalidate_all(key: i32) : i32 {
    let s: i32 = vlist_find(key);
    if (s < 0) { return -1; }
    let c: i32 = vlvar_clear(s);
    let vt: i32 = vlist_touch(key);
    let r: i32 = aui_invalidate_layout();
    return 0;
}

// 插入一项：缓存高度向后平移一位（下标 >= index 的项），新项清零待量，
// 登记的 count +1（下次 build 传新 count 时不再误判为换数据）。
// 应用顺序：改自己的数据 → 调这个 → aui_invalidate()（本函数已触发重建）。
fn aui_vlist_var_insert(key: i32, index: i32) : i32 {
    let s: i32 = vlist_find(key);
    if (s < 0) { return -1; }
    if (index < 0) { index = 0; }
    if (index >= AUI_VLVAR_HCAP) { return -1; }
    let base: i32 = s * AUI_VLVAR_HCAP;
    let i: i32 = AUI_VLVAR_HCAP - 2;
    while (i >= index) {
        g_aui_vlvar_h[base + i + 1] = g_aui_vlvar_h[base + i];
        i = i - 1;
    }
    g_aui_vlvar_h[base + index] = 0;
    g_aui_vlvar_count[s] = g_aui_vlvar_count[s] + 1;
    let vt: i32 = vlist_touch(key);
    let r: i32 = aui_invalidate_layout();
    return 0;
}

// 删除一项：缓存高度向前平移一位（下标 > index 的项），末尾清零，
// 登记的 count -1。应用顺序与 insert 相同。
fn aui_vlist_var_remove(key: i32, index: i32) : i32 {
    let s: i32 = vlist_find(key);
    if (s < 0) { return -1; }
    if (index < 0 || index >= AUI_VLVAR_HCAP) { return -1; }
    let base: i32 = s * AUI_VLVAR_HCAP;
    let i: i32 = index;
    while (i < AUI_VLVAR_HCAP - 1) {
        g_aui_vlvar_h[base + i] = g_aui_vlvar_h[base + i + 1];
        i = i + 1;
    }
    g_aui_vlvar_h[base + AUI_VLVAR_HCAP - 1] = 0;
    if (g_aui_vlvar_count[s] > 0) { g_aui_vlvar_count[s] = g_aui_vlvar_count[s] - 1; }
    let vt: i32 = vlist_touch(key);
    let r: i32 = aui_invalidate_layout();
    return 0;
}

// v1.46：虚拟网格（对照 HuxerUI VirtualGrid）。cols > 0 固定列数；
// cols <= 0 按 min_cell_dp 自适应，列数 = (内容宽 + 间距) / (最小格宽 + 间距)。
// 行高固定 row_dp，行/列间距都用 aui_gap 设置。只构建窗口附近的下标，
// on_bind 里用 aui_vgrid_first()..aui_vgrid_last() 循环 aui_vgrid_cell(i)。
// 列数/间距/视口高在布局后回写登记表，变化时下一拍自动重建窗口。
fn aui_vgrid(key: i32, count: i32, cols: i32, min_cell_dp: i32, row_dp: i32,
             on_bind: fn(ptr) : i32, on_tap: fn(ptr) : i32,
             user: ptr) : i32 {
    let i: i32 = push_container(53, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    if (count < 0) { count = 0; }
    if (count > 1000000) { count = 1000000; }
    let rh: i32 = dp2q(row_dp);
    if (rh < 65536) { rh = 65536; }
    if (min_cell_dp < 1) { min_cell_dp = 1; }
    if (min_cell_dp > 4096) { min_cell_dp = 4096; }
    let cs: i32 = cols;
    if (cs < 0) { cs = 0; }
    if (cs > 4096) { cs = 4096; }
    // flags 低 16 位 = 请求列数，高 16 位 = 最小格宽（dp）。
    n.aux = count;
    n.aux2 = rh;
    n.flags = (cs & 65535) | (min_cell_dp << 16);
    n.cb = on_tap;
    n.user = user;
    let s: i32 = vgrid_slot(key);
    // 自适应列数在首帧还不知道容器宽：用上一帧实测值，没有就按 1 列
    // 保守构建；布局后列数变化会触发重建。
    let ecols: i32 = cs;
    if (ecols <= 0) {
        ecols = 1;
        if (s >= 0 && g_aui_vgrid_cols[s] > 0) { ecols = g_aui_vgrid_cols[s]; }
    }
    let gap: i32 = 0;
    if (s >= 0) { gap = g_aui_vgrid_gap[s]; }
    let used: i32 = 0;
    if (s >= 0) { used = g_aui_vgrid_vp[s]; }
    if (used <= 0) { used = dp2q(480); }
    let usedpx: i32 = used >> 16;
    if (usedpx <= 0) { usedpx = 480; }
    let rhpx: i32 = rh >> 16;
    if (rhpx < 1) { rhpx = 1; }
    let gappx: i32 = gap >> 16;
    if (gappx < 0) { gappx = 0; }
    let pitch: i32 = rhpx + gappx;
    if (pitch < 1) { pitch = 1; }
    let rows: i32 = 0;
    if (count > 0) { rows = (count + ecols - 1) / ecols; }
    let cpx64: i64 = i64(rows) * i64(rhpx);
    let cpx: i32 = 0;
    if (cpx64 > 2000000000) { cpx = 2000000000; } else { cpx = i32(cpx64); }
    if (rows > 1) { cpx = cpx + (rows - 1) * gappx; }
    let off: i32 = scroll_get(key);
    if (off > cpx - usedpx) { off = cpx - usedpx; }
    if (off < 0) { off = 0; }
    // v1.48.5：同虚拟列表，上下各多建两行作为重建过渡。
    let firstr: i32 = off / pitch - 2;
    if (firstr < 0) { firstr = 0; }
    let lastr: i32 = (off + usedpx) / pitch + 2;
    let first: i32 = firstr * ecols;
    if (first > count - 1) { first = count - 1; }
    if (first < 0) { first = 0; }
    let last: i32 = (lastr + 1) * ecols - 1;
    if (last > count - 1) { last = count - 1; }
    if (last < first) { last = first - 1; }
    if (s >= 0) {
        g_aui_vgrid_used_vp[s] = used;
        g_aui_vgrid_first[s] = first;
        g_aui_vgrid_last[s] = last;
    }
    // on_bind 允许嵌套：保存并恢复当前上下文。
    let sv_key: i32 = g_aui_vgrid_cur_key;
    let sv_rh: i32 = g_aui_vgrid_cur_rh;
    let sv_user: ptr = g_aui_vgrid_cur_user;
    let sv_tap: fn(ptr) : i32 = g_aui_vgrid_cur_tap;
    let sv_first: i32 = g_aui_vgrid_first_cur;
    let sv_last: i32 = g_aui_vgrid_last_cur;
    g_aui_vgrid_cur_key = key;
    g_aui_vgrid_cur_rh = rh;
    g_aui_vgrid_cur_user = user;
    g_aui_vgrid_cur_tap = on_tap;
    g_aui_vgrid_first_cur = first;
    g_aui_vgrid_last_cur = last;
    if (on_bind != 0) { let r: i32 = on_bind(user); }
    g_aui_vgrid_cur_key = sv_key;
    g_aui_vgrid_cur_rh = sv_rh;
    g_aui_vgrid_cur_user = sv_user;
    g_aui_vgrid_cur_tap = sv_tap;
    g_aui_vgrid_first_cur = sv_first;
    g_aui_vgrid_last_cur = sv_last;
    g_aui_last_created = i;
    return i;
}

// 在 on_bind 里建一个格子；宽高由布局统一安排。
fn aui_vgrid_cell(index: i32) : i32 {
    let i: i32 = push_container(54, 0);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.aux = g_aui_vgrid_cur_rh;
    n.aux2 = index;
    n.cb = g_aui_vgrid_cur_tap;
    n.user = g_aui_vgrid_cur_user;
    return i;
}

// 当前 on_bind 窗口（闭区间），指下标而不是行。
fn aui_vgrid_first() : i32 { return g_aui_vgrid_first_cur; }
fn aui_vgrid_last() : i32 { return g_aui_vgrid_last_cur; }
fn aui_vgrid_tap_index() : i32 { return g_aui_vgrid_tap_idx; }
fn aui_vgrid_tap_key() : i32 { return g_aui_vgrid_tap_key; }

// v2.17：虚拟表格（对照 HuxerUI virtual_table）。行列都虚拟化：只构建
// 视口内（上下各多一行、左右各多一列）的格子，表头常建。on_bind 里按
// aui_vtable_first_row()..aui_vtable_last_row() ×
// aui_vtable_first_col()..aui_vtable_last_col()（闭区间）循环，表头调
// aui_vtable_header(col)，表身调 aui_vtable_cell(row, col)。表头纵向
// 固定、首列横向固定；纵向偏移走 scroll_get/set，横向走独立 off_x。
fn aui_vtable(key: i32, rows: i32, cols: i32, row_dp: i32,
              on_bind: fn(ptr) : i32, on_tap: fn(ptr) : i32,
              user: ptr) : i32 {
    let i: i32 = push_container(63, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    if (rows < 0) { rows = 0; }
    if (rows > 1000000) { rows = 1000000; }
    if (cols < 0) { cols = 0; }
    if (cols > AUI_VTABLE_COLS_MAX) { cols = AUI_VTABLE_COLS_MAX; }
    let rh: i32 = dp2q(row_dp);
    if (rh < 65536) { rh = 65536; }
    if (rh > dp2q(256)) { rh = dp2q(256); }
    // aux = 行数，aux2 = 行高（Q16.16，表头同高），flags = 列数。
    n.aux = rows;
    n.aux2 = rh;
    n.flags = cols;
    n.cb = on_tap;
    n.user = user;
    let s: i32 = vtable_slot(key);
    let used: i32 = 0;
    if (s >= 0) { used = g_aui_vtable_vp[s]; }
    if (used <= 0) { used = dp2q(480); }
    let usedpx: i32 = used >> 16;
    if (usedpx <= 0) { usedpx = 480; }
    let usedw: i32 = 0;
    if (s >= 0) { usedw = g_aui_vtable_vpw[s]; }
    if (usedw <= 0) { usedw = dp2q(360); }
    let usedwpx: i32 = usedw >> 16;
    if (usedwpx <= 0) { usedwpx = 360; }
    let rhpx: i32 = rh >> 16;
    if (rhpx < 1) { rhpx = 1; }
    // 纵向窗口：上下各多建一行（v1.48.5 同规则）。
    let off: i32 = scroll_get(key);
    let cpx64: i64 = i64(rows + 1) * i64(rhpx);
    let cpx: i32 = 0;
    if (cpx64 > 2000000000) { cpx = 2000000000; } else { cpx = i32(cpx64); }
    if (off > cpx - usedpx) { off = cpx - usedpx; }
    if (off < 0) { off = 0; }
    let firstr: i32 = off / rhpx - 1;
    if (firstr < 0) { firstr = 0; }
    if (firstr > rows - 1) { firstr = rows - 1; }
    if (firstr < 0) { firstr = 0; }
    let lastr: i32 = (off + usedpx) / rhpx + 1;
    if (lastr > rows - 1) { lastr = rows - 1; }
    if (lastr < firstr) { lastr = firstr - 1; }
    // 横向窗口：左右各多建一列。表头与表身共用同一列窗口。
    let offx: i32 = vtable_off_x(key);
    let totw: i32 = 0;
    if (s >= 0) { totw = vtable_total_w(s, cols); }
    if (offx > totw - usedwpx) { offx = totw - usedwpx; }
    if (offx < 0) { offx = 0; }
    let firstc: i32 = vtable_col_at(s, offx, cols);
    let lastc: i32 = vtable_col_at(s, offx + usedwpx, cols);
    if (firstc > 0) { firstc = firstc - 1; }
    if (lastc < cols - 1) { lastc = lastc + 1; }
    if (firstc < 0) { firstc = 0; }
    if (lastc < firstc) { lastc = firstc - 1; }
    if (s >= 0) {
        g_aui_vtable_used_vp[s] = used;
        g_aui_vtable_used_vpw[s] = usedw;
        g_aui_vtable_first_row[s] = firstr;
        g_aui_vtable_last_row[s] = lastr;
        g_aui_vtable_first_col[s] = firstc;
        g_aui_vtable_last_col[s] = lastc;
    }
    // on_bind 允许嵌套：保存并恢复当前上下文。
    let sv_key: i32 = g_aui_vtable_cur_key;
    let sv_rh: i32 = g_aui_vtable_cur_rh;
    let sv_user: ptr = g_aui_vtable_cur_user;
    let sv_tap: fn(ptr) : i32 = g_aui_vtable_cur_tap;
    let sv_fr: i32 = g_aui_vtable_first_row_cur;
    let sv_lr: i32 = g_aui_vtable_last_row_cur;
    let sv_fc: i32 = g_aui_vtable_first_col_cur;
    let sv_lc: i32 = g_aui_vtable_last_col_cur;
    g_aui_vtable_cur_key = key;
    g_aui_vtable_cur_rh = rh;
    g_aui_vtable_cur_user = user;
    g_aui_vtable_cur_tap = on_tap;
    g_aui_vtable_first_row_cur = firstr;
    g_aui_vtable_last_row_cur = lastr;
    g_aui_vtable_first_col_cur = firstc;
    g_aui_vtable_last_col_cur = lastc;
    if (on_bind != 0) {
        // v2.17.1：首列横向固定，窗口再偏也必须建出来（否则大偏移下首列
        // 消失，命中与绘制都没它）。先建首列（命中测试先匹配到它，与视
        // 觉遮盖一致），再建滚动窗口；首列已在窗口内时只调一次，避免
        // 重复建格。槽里记的仍是滚动窗口（自愈检查用它）。
        if (firstc > 0) {
            g_aui_vtable_first_col_cur = 0;
            g_aui_vtable_last_col_cur = 0;
            let r0: i32 = on_bind(user);
            g_aui_vtable_first_col_cur = firstc;
            g_aui_vtable_last_col_cur = lastc;
        }
        let r: i32 = on_bind(user);
    }
    g_aui_vtable_cur_key = sv_key;
    g_aui_vtable_cur_rh = sv_rh;
    g_aui_vtable_cur_user = sv_user;
    g_aui_vtable_cur_tap = sv_tap;
    g_aui_vtable_first_row_cur = sv_fr;
    g_aui_vtable_last_row_cur = sv_lr;
    g_aui_vtable_first_col_cur = sv_fc;
    g_aui_vtable_last_col_cur = sv_lc;
    g_aui_last_created = i;
    return i;
}

// 逐列设宽度（dp，<= 0 恢复默认 128dp）；改动后自动重建窗口。
// 表还没建过时也接受（先登记，首帧 build 即用）。
fn aui_vtable_col(key: i32, col: i32, width_dp: i32) : i32 {
    let s: i32 = vtable_slot(key);
    if (s < 0) { return -1; }
    if (col < 0 || col >= AUI_VTABLE_COLS_MAX) { return -1; }
    if (width_dp < 0) { width_dp = 0; }
    if (width_dp > 4096) { width_dp = 4096; }
    let old: i32 = g_aui_vtable_w[s * AUI_VTABLE_COLS_MAX + col];
    if (old == width_dp) { return 0; }
    g_aui_vtable_w[s * AUI_VTABLE_COLS_MAX + col] = width_dp;
    g_aui_need_build = 1;
    g_aui_pump_need = 1;
    return 0;
}

// 在 on_bind 里建一个表头格；宽高由布局统一安排（行高 = 表格行高）。
fn aui_vtable_header(col: i32) : i32 {
    let i: i32 = push_container(64, 0);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.aux = -1;                        // 行：-1 = 表头
    n.aux2 = col;
    n.flags = g_aui_vtable_cur_rh;
    n.cb = g_aui_vtable_cur_tap;
    n.user = g_aui_vtable_cur_user;
    return i;
}

// 在 on_bind 里建一个表身格；宽高由布局统一安排。
fn aui_vtable_cell(row: i32, col: i32) : i32 {
    let i: i32 = push_container(64, 0);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.aux = row;
    n.aux2 = col;
    n.flags = g_aui_vtable_cur_rh;
    n.cb = g_aui_vtable_cur_tap;
    n.user = g_aui_vtable_cur_user;
    return i;
}

// 当前 on_bind 窗口（闭区间）：行是表身行号，列是列号。
fn aui_vtable_first_row() : i32 { return g_aui_vtable_first_row_cur; }
fn aui_vtable_last_row() : i32 { return g_aui_vtable_last_row_cur; }
fn aui_vtable_first_col() : i32 { return g_aui_vtable_first_col_cur; }
fn aui_vtable_last_col() : i32 { return g_aui_vtable_last_col_cur; }
fn aui_vtable_tap_row() : i32 { return g_aui_vtable_tap_row; }
fn aui_vtable_tap_col() : i32 { return g_aui_vtable_tap_col; }
fn aui_vtable_tap_key() : i32 { return g_aui_vtable_tap_key; }

// 程序化滚动到指定格（row/col 越界夹取；align 0 起始 / 1 居中 /
// 2 末端对齐，双轴同义；行 -1 表示只滚横向、列 -1 表示只滚纵向）。
// 会触发窗口重建。
fn aui_vtable_scroll_to(key: i32, row: i32, col: i32, align: i32) : i32 {
    let s: i32 = vtable_find(key);
    if (s < 0) { return -1; }
    let n: i32 = vtable_node(key);
    if (n < 0) { return -1; }
    let nn: ptr<AuiNode> = node_at(n);
    let rows: i32 = nn.aux;
    let cols: i32 = nn.flags;
    let rhpx: i32 = nn.aux2 >> 16;
    if (rhpx < 1) { rhpx = 1; }
    if (align < 0) { align = 0; }
    if (align > 2) { align = 2; }
    let hpx: i32 = nn.h >> 16;
    let wpx: i32 = nn.w >> 16;
    if (row >= 0) {
        if (row > rows - 1) { row = rows - 1; }
        // 表身行 row 的内容顶 = (row+1)*行高（前面还有一行表头）。
        // 对齐按“可见区”算：表头占一行高，起始对齐时行顶贴表头底，
        // 不能藏到表头下面；居中/末端同理按表头下的表身区算。
        let top: i32 = (row + 1) * rhpx;
        let target: i32 = top - rhpx;
        if (align == 1) { target = top - rhpx - (hpx - rhpx - rhpx) / 2; }
        if (align == 2) { target = top - hpx + rhpx; }
        let v: i32 = scroll_set(key, target);
        let tv: i32 = vtable_touch(key);
    }
    if (col >= 0) {
        if (col > cols - 1) { col = cols - 1; }
        let left: i32 = vtable_col_x(s, col);
        let wp: i32 = vtable_col_px(s, col);
        // 首列占 w0 宽横向固定：起始对齐时格左贴首列右，不能藏到首列
        // 下面；居中按首列右边的可见区算；末端对齐不受首列影响。
        let w0: i32 = vtable_col_px(s, 0);
        let targetx: i32 = left - w0;
        if (align == 1) { targetx = left - w0 - (wpx - w0 - wp) / 2; }
        if (align == 2) { targetx = left + wp - wpx; }
        let vx: i32 = vtable_set_x(key, targetx);
        let tx: i32 = vtable_touch(key);
    }
    let r: i32 = aui_invalidate_layout();
    return 0;
}

// v1.47：横向虚拟列表（对照 HuxerUI VirtualList.ScrollAxis(Horizontal)）。
// 项宽固定 item_w_dp；item_h_dp > 0 时项高固定，否则撑满容器内容高。
// 只构建窗口附近的项，on_bind 里用 aui_hlist_first()..aui_hlist_last()
// 循环 aui_hlist_item(i)。项间距用 aui_gap 设置；内容宽 = pad*2 +
// count*项宽 + (count-1)*间距，可能超过 Q16.16，偏移按像素存。
fn aui_hlist(key: i32, count: i32, item_w_dp: i32, item_h_dp: i32,
             on_bind: fn(ptr) : i32, on_tap: fn(ptr) : i32,
             user: ptr) : i32 {
    let i: i32 = push_container(55, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    if (count < 0) { count = 0; }
    if (count > 1000000) { count = 1000000; }
    let iw: i32 = dp2q(item_w_dp);
    if (iw < 65536) { iw = 65536; }
    let ih: i32 = 0;
    if (item_h_dp > 0) {
        ih = dp2q(item_h_dp);
        if (ih < 65536) { ih = 65536; }
    }
    n.aux = count;
    n.aux2 = iw;
    n.flags = ih;                     // 项高；0 = 撑满内容高
    n.cb = on_tap;
    n.user = user;
    let s: i32 = hlist_slot(key);
    let gap: i32 = 0;
    if (s >= 0) { gap = g_aui_hlist_gap[s]; }
    let used: i32 = 0;
    if (s >= 0) { used = g_aui_hlist_vp[s]; }
    if (used <= 0) { used = dp2q(480); }
    let usedpx: i32 = used >> 16;
    if (usedpx <= 0) { usedpx = 480; }
    let iwpx: i32 = iw >> 16;
    if (iwpx < 1) { iwpx = 1; }
    let gappx: i32 = gap >> 16;
    if (gappx < 0) { gappx = 0; }
    let pitch: i32 = iwpx + gappx;
    if (pitch < 1) { pitch = 1; }
    // 内容宽估算：只用于首帧窗口，布局后会按真实值校正。
    let cpx64: i64 = i64(count) * i64(iwpx);
    let cpx: i32 = 0;
    if (cpx64 > 2000000000) { cpx = 2000000000; } else { cpx = i32(cpx64); }
    if (count > 1) {
        let g64: i64 = i64(count - 1) * i64(gappx);
        if (g64 > 2000000000) { cpx = 2000000000; } else { cpx = cpx + i32(g64); }
    }
    let off: i32 = scroll_get(key);
    if (off > cpx - usedpx) { off = cpx - usedpx; }
    if (off < 0) { off = 0; }
    // v1.48.5：左右各多建两项，作为重建过渡。
    let first: i32 = off / pitch - 2;
    if (first < 0) { first = 0; }
    let last: i32 = (off + usedpx) / pitch + 2;
    if (last > count - 1) { last = count - 1; }
    if (last < first) { last = first - 1; }
    if (s >= 0) {
        g_aui_hlist_used_vp[s] = used;
        g_aui_hlist_first[s] = first;
        g_aui_hlist_last[s] = last;
    }
    // on_bind 允许嵌套：保存并恢复当前上下文。
    let sv_key: i32 = g_aui_hlist_cur_key;
    let sv_iw: i32 = g_aui_hlist_cur_iw;
    let sv_ih: i32 = g_aui_hlist_cur_ih;
    let sv_user: ptr = g_aui_hlist_cur_user;
    let sv_tap: fn(ptr) : i32 = g_aui_hlist_cur_tap;
    let sv_first: i32 = g_aui_hlist_first_cur;
    let sv_last: i32 = g_aui_hlist_last_cur;
    g_aui_hlist_cur_key = key;
    g_aui_hlist_cur_iw = iw;
    g_aui_hlist_cur_ih = ih;
    g_aui_hlist_cur_user = user;
    g_aui_hlist_cur_tap = on_tap;
    g_aui_hlist_first_cur = first;
    g_aui_hlist_last_cur = last;
    if (on_bind != 0) { let r: i32 = on_bind(user); }
    g_aui_hlist_cur_key = sv_key;
    g_aui_hlist_cur_iw = sv_iw;
    g_aui_hlist_cur_ih = sv_ih;
    g_aui_hlist_cur_user = sv_user;
    g_aui_hlist_cur_tap = sv_tap;
    g_aui_hlist_first_cur = sv_first;
    g_aui_hlist_last_cur = sv_last;
    g_aui_last_created = i;
    return i;
}

// 在 on_bind 里建一项；宽度固定，高度由布局统一安排。
fn aui_hlist_item(index: i32) : i32 {
    let i: i32 = push_container(56, 0);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.aux = g_aui_hlist_cur_iw;
    n.aux2 = index;
    n.flags = g_aui_hlist_cur_ih;
    n.cb = g_aui_hlist_cur_tap;
    n.user = g_aui_hlist_cur_user;
    return i;
}

// 当前 on_bind 窗口（闭区间）。
fn aui_hlist_first() : i32 { return g_aui_hlist_first_cur; }
fn aui_hlist_last() : i32 { return g_aui_hlist_last_cur; }
fn aui_hlist_tap_index() : i32 { return g_aui_hlist_tap_idx; }
fn aui_hlist_tap_key() : i32 { return g_aui_hlist_tap_key; }

// v1.30：下拉刷新容器（对照 HuxerUI RefreshBox）。内容是唯一子节点；
// 内容在顶部时继续下拉产生阻尼位移，松手超过 68 dp 回调一次。
// refreshing 由应用持有；清 0 后指示器收起。
fn aui_refresh_box(key: i32, refreshing: i32, cb: fn(ptr) : i32, user: ptr) : i32 {
    let i: i32 = push_container(29, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.cb = cb;
    n.user = user;
    let s: i32 = ref_slot(key);
    if (s >= 0) { let r: i32 = ref_sync(s, refreshing); }
    return i;
}

fn aui_end() : i32 {
    let closed: i32 = -1;
    if (g_aui_depth > 0) {
        closed = g_aui_stk_parent[g_aui_depth];
        g_aui_depth = g_aui_depth - 1;
    }
    // v2.15：关掉 Theme 容器时把它的覆盖弹出主题栈。
    if (closed >= 0) {
        let cn: ptr<AuiNode> = node_at(closed);
        if (cn.kind == 62) {
            let rp: i32 = theme_pop();
        }
    }
    // v1.27：容器关闭后 aui_tooltip 可以挂到这个容器上。
    g_aui_last_closed = closed;
    g_aui_last_created = -1;
    return 0;
}

// v1.27：工具提示修饰器（对照 HuxerUI Tooltip）。挂在最近创建的节点上；
// 如果刚 aui_end() 关闭了容器，则挂到那个容器。side / align 越界时取
// 默认值（上方、居中）。气泡在长按 500 ms 后显示，同一时刻只有一个。
fn tip_lookup(i: i32) : i32 {
    let k: i32 = 0;
    while (k < g_aui_tip_used) {
        if (g_aui_tips_node[k] == i) { return k; }
        k = k + 1;
    }
    return -1;
}

fn find_tip(i: i32) : i32 {
    let cur: i32 = i;
    while (cur >= 0) {
        let k: i32 = tip_lookup(cur);
        if (k >= 0) { return k; }
        let n: ptr<AuiNode> = node_at(cur);
        cur = n.parent;
    }
    return -1;
}

fn aui_tooltip(text: ptr, side: i32, align: i32) : i32 {
    let t: i32 = g_aui_last_created;
    if (t < 0) { t = g_aui_last_closed; }
    if (t < 0 || text == 0) { return -1; }
    if (side < 0 || side > 3) { side = 0; }
    if (align < 0 || align > 2) { align = 1; }
    let k: i32 = tip_lookup(t);
    if (k < 0) {
        if (g_aui_tip_used >= AUI_TIP_CAP) { return -1; }
        k = g_aui_tip_used;
        g_aui_tip_used = g_aui_tip_used + 1;
    }
    g_aui_tips_node[k] = t;
    g_aui_tips_text[k] = text;
    g_aui_tips_side[k] = side;
    g_aui_tips_align[k] = align;
    return 0;
}

// 收起气泡与待定状态。返回 1 = 之前有可见内容（调用方需要重绘）。
fn tip_dismiss() : i32 {
    let had: i32 = 0;
    if (g_aui_tip_on != 0 || g_aui_tip_pend != 0) { had = 1; }
    g_aui_tip_on = 0;
    g_aui_tip_pend = 0;
    g_aui_tip_pend_idx = -1;
    g_aui_tip_hold = 1;
    g_aui_tip_until = 0;
    g_aui_tip_text = 0;
    if (had != 0) {
        g_aui_need_paint = 1;
        g_aui_pump_need = 1;
    }
    return had;
}

// 长按判定通过：气泡接管本次手势。
fn tip_show() : i32 {
    g_aui_tip_pend = 0;
    g_aui_tip_pend_idx = -1;
    g_aui_tip_on = 1;
    g_aui_tip_hold = 1;
    g_aui_tip_until = 0;
    g_aui_pressing = 0;
    g_aui_press_key = 0;
    g_aui_need_layout = 1;
    g_aui_need_paint = 1;
    g_aui_pump_need = 1;
    return 0;
}

// 帧节拍：到 500 ms 显示；松手停留到期后收起。由 pump_ui / 帧泵每拍调用，
// 时间来自 clock_ns（测试用 fake_set_clock 注入）。
fn tip_tick() : i32 {
    let ch: i32 = 0;
    let now: i64 = clock_ns();
    if (g_aui_tip_pend != 0 && now - g_aui_tip_start >= 500000000) {
        let r: i32 = tip_show();
        let tw: i32 = pump_wake();
        // v2.7.1-diag：工具提示显示（对照实验：与长按同走 500ms 泵机制）。
        let tel: i32 = i32((now - g_aui_tip_start) / 1000000);
        let tl: i32 = aui_log1(4, "tip show el=", tel, "ms");
        ch = 1;
    }
    if (g_aui_tip_on != 0 && g_aui_tip_hold == 0 && g_aui_tip_until > 0 &&
        now >= g_aui_tip_until) {
        let r2: i32 = tip_dismiss();
        ch = 1;
    }
    return ch;
}

// 1 = 还有计时任务（待定长按或停留倒计时）。帧泵据此保持 16 ms 轮询。
fn tip_busy() : i32 {
    if (g_aui_tip_pend != 0) { return 1; }
    if (g_aui_tip_on != 0 && g_aui_tip_hold == 0 && g_aui_tip_until > 0) {
        return 1;
    }
    return 0;
}

// ---- 长按手势（v2.7）----
// 登记表与工具提示同构：节点下标查回调，命中沿祖先链向上找（find_lp）。
fn lp_lookup(i: i32) : i32 {
    let k: i32 = 0;
    while (k < g_aui_lp_used) {
        if (g_aui_lp_node[k] == i) { return k; }
        k = k + 1;
    }
    return -1;
}

fn find_lp(i: i32) : i32 {
    let cur: i32 = i;
    while (cur >= 0) {
        let k: i32 = lp_lookup(cur);
        if (k >= 0) { return k; }
        let n: ptr<AuiNode> = node_at(cur);
        cur = n.parent;
    }
    return -1;
}

// v2.7：长按修饰器（对照 HuxerUI LongPressGesture）。挂在最近创建的
// 节点上；如果刚 aui_end() 关闭了容器，则挂到那个容器。同一节点重复
// 声明覆盖回调。DOWN 后 500 ms 内不动即触发一次 cb(user)，回调里用
// aui_long_press_key() 读触发节点的 key；触发后本次抬起不再补发点按。
fn aui_long_press(cb: fn(ptr) : i32, user: ptr) : i32 {
    let t: i32 = g_aui_last_created;
    if (t < 0) { t = g_aui_last_closed; }
    if (t < 0 || cb == 0) { return -1; }
    let k: i32 = lp_lookup(t);
    if (k < 0) {
        if (g_aui_lp_used >= AUI_LP_CAP) { return -1; }
        k = g_aui_lp_used;
        g_aui_lp_used = g_aui_lp_used + 1;
    }
    g_aui_lp_node[k] = t;
    g_aui_lp_cb[k] = cb;
    g_aui_lp_user[k] = user;
    return 0;
}

// 触发时回调里读到的节点 key（分段 / 标签页的 getter 模式）。
fn aui_long_press_key() : i32 {
    return g_aui_lp_key;
}

// ---- 捏合手势（v2.18，对照 HuxerUI TransformGesture）----
// 登记表与长按同构：节点下标查回调，命中沿祖先链向上找（find_pn）。
fn pn_lookup(i: i32) : i32 {
    let k: i32 = 0;
    while (k < g_aui_pn_used) {
        if (g_aui_pn_node[k] == i) { return k; }
        k = k + 1;
    }
    return -1;
}

fn find_pn(i: i32) : i32 {
    let cur: i32 = i;
    while (cur >= 0) {
        let k: i32 = pn_lookup(cur);
        if (k >= 0) { return k; }
        let n: ptr<AuiNode> = node_at(cur);
        cur = n.parent;
    }
    return -1;
}

// v2.18：捏合修饰器（对照 HuxerUI TransformGesture 的 scale + focal
// point；rotation 不在本轮）。挂在最近创建的节点上；如果刚 aui_end()
// 关闭了容器，则挂到那个容器。同一节点重复声明覆盖回调。两指才识别：
// 第二指按下时接管并调一次 cb(user)，每次 MOVE 调一次，一指抬起或
// 取消时再调一次；回调里用 aui_pinch_scale/cx/cy/dx/dy 读状态。
fn aui_pinch(cb: fn(ptr) : i32, user: ptr) : i32 {
    let t: i32 = g_aui_last_created;
    if (t < 0) { t = g_aui_last_closed; }
    if (t < 0 || cb == 0) { return -1; }
    let k: i32 = pn_lookup(t);
    if (k < 0) {
        if (g_aui_pn_used >= AUI_PN_CAP) { return -1; }
        k = g_aui_pn_used;
        g_aui_pn_used = g_aui_pn_used + 1;
    }
    g_aui_pn_node[k] = t;
    g_aui_pn_cb[k] = cb;
    g_aui_pn_user[k] = user;
    return 0;
}

// 读数器：累计缩放 Q16.16（65536 = 1.00×）、焦点、质心位移、进行标志、
// 拥有本次/上次手势的节点 key、登记数量。
fn aui_pinch_scale() : i32 { return g_aui_pn_scale; }
fn aui_pinch_cx() : i32 { return g_aui_pn_cx; }
fn aui_pinch_cy() : i32 { return g_aui_pn_cy; }
fn aui_pinch_dx() : i32 { return g_aui_pn_dx; }
fn aui_pinch_dy() : i32 { return g_aui_pn_dy; }
fn aui_pinch_active() : i32 {
    if (g_aui_pn_state == 1) { return 1; }
    return 0;
}
fn aui_pinch_key() : i32 { return g_aui_pn_key; }
fn aui_pinch_n() : i32 { return g_aui_pn_used; }

// 测试辅助：捏合状态（0 空闲 / 1 进行中 / 2 已结束）。
fn aui_debug_pinch_state() : i32 { return g_aui_pn_state; }

// ---- 语义树导出（v2.19，对照 HuxerUI semantics.h；一期只做导出）----
// 角色常量：HuxerUI SemanticRole 全集，0 = 未设置（走 kind 默认角色）。
// 导出只读树、不交给系统（无 TalkBack 桥：注册无障碍服务需要 Java 壳，
// 是无 dex 路线的硬边界）。
let AUI_SEM_GENERIC: i32 = 1;
let AUI_SEM_TEXT: i32 = 2;
let AUI_SEM_HEADING: i32 = 3;
let AUI_SEM_IMAGE: i32 = 4;
let AUI_SEM_BUTTON: i32 = 5;
let AUI_SEM_LINK: i32 = 6;
let AUI_SEM_CHECKBOX: i32 = 7;
let AUI_SEM_RADIO: i32 = 8;
let AUI_SEM_SWITCH: i32 = 9;
let AUI_SEM_SLIDER: i32 = 10;
let AUI_SEM_PROGRESS: i32 = 11;
let AUI_SEM_COMBOBOX: i32 = 12;
let AUI_SEM_TEXTFIELD: i32 = 13;
let AUI_SEM_SEARCHFIELD: i32 = 14;
let AUI_SEM_TAB: i32 = 15;
let AUI_SEM_TABLIST: i32 = 16;
let AUI_SEM_MENU: i32 = 17;
let AUI_SEM_MENUITEM: i32 = 18;
let AUI_SEM_DIALOG: i32 = 19;
let AUI_SEM_NAVIGATION: i32 = 20;
let AUI_SEM_LIST: i32 = 21;
let AUI_SEM_LISTITEM: i32 = 22;
let AUI_SEM_GRID: i32 = 23;
let AUI_SEM_GRIDCELL: i32 = 24;
let AUI_SEM_SCROLLVIEW: i32 = 25;
let AUI_SEM_TREE: i32 = 26;
let AUI_SEM_TREEITEM: i32 = 27;
let AUI_SEM_SEPARATOR: i32 = 28;

// 并行数组（设计文档 §14 允许的第二种存放法）：不改 96 B 节点布局；
// node_alloc 随节点其余字段一起复位（每帧重建，注册的合同是每构建声明一次）。
let g_aui_sem_role: i32[4096] = 0;   // 0 = 未设置，走 kind 默认
let g_aui_sem_label: ptr[4096] = 0;  // 0 = 未设置，用节点自带文本
let g_aui_sem_hide: i32[4096] = 0;   // 非 0 = 导出时跳过该节点及子树

// ===========================================================================
// D-2a 前置 5 项（v0.1-cn，评估稿 §1.3 / DESIGN.md §6.1）
// ===========================================================================
// 并行数组（设计文档 §14 允许的第二种存放法）：不改 96 B 节点布局；
// node_alloc 随节点其余字段一起复位（每帧重建，修饰器每构建声明一次）。
// 尺寸 −1 = 未指定（包内容/默认量出）；字号 −1 = 默认（走角色制）；
// 前景色用 fg_set 区分“未设置”与显式 0x00000000。
let g_d2a_size_w: i32[4096] = 0;   // dp；-1 = 未指定
let g_d2a_size_h: i32[4096] = 0;   // dp；-1 = 未指定
let g_d2a_text_sp: i32[4096] = 0;  // sp；-1 = 默认
let g_d2a_fg: i32[4096] = 0;       // ARGB 位模式（i32 存 u32）
let g_d2a_fg_set: i32[4096] = 0;   // 1 = 已显式覆盖
let g_d2a_sel: i32[4096] = 0;      // 1 = 可选中
// 选中态（跨 build 保留，按节点下标 + 可选中校验懒失效，见 d2a_sel_valid）。
let g_d2a_sel_node: i32 = -1;     // 当前选中文本的节点下标，-1 = 无
let g_d2a_sel_start: i32 = 0;      // 选区起点（码点偏移；本轮恒为 0）
let g_d2a_sel_end: i32 = 0;        // 选区终点（码点偏移；本轮恒为全文长）
// 可选中长按待定（与 aui_long_press 的待定并行、互斥：有回调登记的
// 节点走回调，不产生选区；同一 500 ms / 8 dp 阈值、同一泵节拍）。
let g_d2a_sel_pend: i32 = 0;
let g_d2a_sel_pend_idx: i32 = -1;
let g_d2a_sel_pend_key: i32 = 0;
let g_d2a_sel_start_ns: i64 = 0;
let g_d2a_sel_downx: i32 = 0;
let g_d2a_sel_downy: i32 = 0;

// 节点指针 → 下标（并行数组索引）。节点池是定长 96 B 槽位，见 node_at。
fn d2a_idx(n: ptr<AuiNode>) : i32 {
    if (n == 0) { return -1; }
    let d: i64 = i64(n) - i64(g_aui_nodes);
    if (d < 0) { return -1; }
    let i: i32 = i32(d / i64(sizeof(AuiNode)));
    if (i < 0 || i >= AUI_NODE_CAP) { return -1; }
    return i;
}

// 节点前景色解析——显式 aui_fg 覆盖优先，否则用调用方给的主题色。
// 调用点只在文本绘制处；状态色（选中/按下/禁用）由调用方先算好再
// 传进来，不被覆盖（调用方在状态分支里不调本函数）。
fn d2a_fg_or(n: ptr<AuiNode>, def: i32) : i32 {
    let ti: i32 = d2a_idx(n);
    if (ti >= 0 && g_d2a_fg_set[ti] != 0) { return g_d2a_fg[ti]; }
    return def;
}

// 选区有效性（懒失效）：下标越界、节点不再是文本节点、或不再可选中
// 时清掉选区（build 改结构后旧下标可能指到别的节点，不能直接信任）。
fn d2a_sel_valid() : i32 {
    let idx: i32 = g_d2a_sel_node;
    if (idx < 0 || idx >= g_aui_node_count) {
        g_d2a_sel_node = -1;
        g_d2a_sel_start = 0;
        g_d2a_sel_end = 0;
        return 0;
    }
    let n: ptr<AuiNode> = node_at(idx);
    if (n.kind != 5 || g_d2a_sel[idx] == 0) {
        g_d2a_sel_node = -1;
        g_d2a_sel_start = 0;
        g_d2a_sel_end = 0;
        return 0;
    }
    return 1;
}

// 选中 idx 节点的全文（本轮选区恒为全文：起点 0，终点为码点数）。
// 非文本节点 / 不可选中节点返回 0，不改已有选区。
fn d2a_select(idx: i32) : i32 {
    if (idx < 0 || idx >= g_aui_node_count) { return 0; }
    let n: ptr<AuiNode> = node_at(idx);
    if (n.kind != 5) { return 0; }
    if (g_d2a_sel[idx] == 0) { return 0; }
    let tlen: i32 = n.aux;
    if (tlen < 0) { tlen = str_len(n.text); }
    if (tlen <= 0) { return 0; }
    let cps: i32 = 0;
    let p: i32 = 0;
    while (p < tlen) {
        utf8_next(n.text, p, tlen);
        let adv: i32 = g_aui_utf8_adv;
        if (adv <= 0) { adv = 1; }
        p = p + adv;
        cps = cps + 1;
    }
    g_d2a_sel_node = idx;
    g_d2a_sel_start = 0;
    g_d2a_sel_end = cps;
    g_aui_need_paint = 1;
    g_aui_pump_need = 1;
    return 1;
}

fn d2a_sel_clear() : i32 {
    if (g_d2a_sel_node < 0) { return 0; }
    g_d2a_sel_node = -1;
    g_d2a_sel_start = 0;
    g_d2a_sel_end = 0;
    g_aui_need_paint = 1;
    g_aui_pump_need = 1;
    return 0;
}

fn d2a_sel_cancel_pend() : i32 {
    g_d2a_sel_pend = 0;
    g_d2a_sel_pend_idx = -1;
    g_d2a_sel_pend_key = 0;
    return 0;
}

fn d2a_sel_fire() : i32 {
    let idx: i32 = g_d2a_sel_pend_idx;
    let c: i32 = d2a_sel_cancel_pend();
    let r: i32 = d2a_select(idx);
    return r;
}

// 可选中长按计时（与 lp_tick 同级，挂在 lp_tick 里，见下）。
fn d2a_sel_tick() : i32 {
    if (g_d2a_sel_pend != 0 && clock_ns() - g_d2a_sel_start_ns >= AUI_LP_NS) {
        let r: i32 = d2a_sel_fire();
        let tw: i32 = pump_wake();
        return 1;
    }
    return 0;
}

fn d2a_sel_busy() : i32 {
    if (g_d2a_sel_pend != 0) { return 1; }
    return 0;
}

// 选区底色块（主色 14%，与 tree 选中同一口径），画在文字之前。
// 画完返回 0；选区已失效时清掉并返回 0。调用方（paint_node 的 label
// 分支）已按当前字号置好排版样式，行几何与随后 emit 的文字一致。
fn d2a_sel_paint(n: ptr<AuiNode>, idx: i32) : i32 {
    if (g_d2a_sel_node != idx) { return 0; }
    if (d2a_sel_valid() == 0) { return 0; }
    let s: ptr = n.text;
    let tlen: i32 = n.aux;
    if (tlen < 0) { tlen = str_len(s); }
    if (tlen <= 0) { return 0; }
    let inner: i32 = n.w - n.pad * 2;
    if (inner < 0) { inner = 0; }
    let mw: i32 = layout_text(s, tlen, inner);
    let lh: i32 = text_line_h();
    let col: i32 = ref_alpha(theme_primary(), 36);
    let li: i32 = 0;
    while (li < g_aui_mlines) {
        let lw: i32 = g_aui_line_w[li];
        if (lw > 0) {
            let tx: i32 = n.x + n.pad;
            let ty: i32 = n.y + n.pad + li * lh;
            let r: i32 = cmd_add(1, tx, ty, lw, lh, col, 0, g_aui_null, 0, 0);
        }
        li = li + 1;
    }
    return 0;
}

// 语义修饰器（aui_long_press / aui_pinch 同一挂接语义）：role 为
// AUI_SEM_*，0 = 不覆盖角色；label 为 NUL 结尾 UTF-8，0 = 不覆盖 label；
// 重复声明覆盖。label 指针与节点文本指针同一合同：节点存活期间有效。
fn aui_semantics(role: i32, label: ptr) : i32 {
    if (role < 0 || role > 28) { return -1; }
    let t: i32 = g_aui_last_created;
    if (t < 0) { t = g_aui_last_closed; }
    if (t < 0) { return -1; }
    if (role != 0) { g_aui_sem_role[t] = role; }
    if (label != 0) { g_aui_sem_label[t] = label; }
    return 0;
}

// 隐藏标记（对照 HuxerUI Semantics.hidden）：导出时跳过该节点及整棵子树。
fn aui_sem_hide() : i32 {
    let t: i32 = g_aui_last_created;
    if (t < 0) { t = g_aui_last_closed; }
    if (t < 0) { return -1; }
    g_aui_sem_hide[t] = 1;
    return 0;
}

// kind 的默认角色。segment 是组内互斥选择（RadioButton）；日期/时间选择器
// 点开选择器，算触发命令（Button）；vtable 有行有列，是 Grid 不是 List；
// split 是两窗格间的可调边界（Separator）；未知 kind 一律 Generic。
fn sem_default_role(kind: i32) : i32 {
    if (kind == 5) { return AUI_SEM_TEXT; }
    if (kind == 6) { return AUI_SEM_BUTTON; }
    if (kind == 8) { return AUI_SEM_IMAGE; }
    if (kind == 9) { return AUI_SEM_SCROLLVIEW; }
    if (kind == 10) { return AUI_SEM_TEXTFIELD; }
    if (kind == 12) { return AUI_SEM_SWITCH; }
    if (kind == 13) { return AUI_SEM_PROGRESS; }
    if (kind == 14) { return AUI_SEM_CHECKBOX; }
    if (kind == 15) { return AUI_SEM_RADIO; }
    if (kind == 16) { return AUI_SEM_SLIDER; }
    if (kind == 18) { return AUI_SEM_RADIO; }
    if (kind == 19) { return AUI_SEM_TABLIST; }
    if (kind == 20) { return AUI_SEM_TAB; }
    if (kind == 24) { return AUI_SEM_DIALOG; }
    if (kind == 25) { return AUI_SEM_COMBOBOX; }
    if (kind == 26) { return AUI_SEM_LISTITEM; }
    if (kind == 27) { return AUI_SEM_BUTTON; }
    if (kind == 28) { return AUI_SEM_BUTTON; }
    if (kind == 30) { return AUI_SEM_BUTTON; }
    if (kind == 31) { return AUI_SEM_PROGRESS; }
    if (kind == 32) { return AUI_SEM_TREE; }
    if (kind == 33) { return AUI_SEM_TREEITEM; }
    if (kind == 34) { return AUI_SEM_MENU; }
    if (kind == 35) { return AUI_SEM_MENUITEM; }
    if (kind == 36) { return AUI_SEM_SEPARATOR; }
    if (kind == 37) { return AUI_SEM_BUTTON; }
    if (kind == 38) { return AUI_SEM_IMAGE; }
    if (kind == 40) { return AUI_SEM_SEPARATOR; }
    if (kind == 42) { return AUI_SEM_DIALOG; }
    if (kind == 43) { return AUI_SEM_DIALOG; }
    if (kind == 44) { return AUI_SEM_NAVIGATION; }
    if (kind == 45) { return AUI_SEM_NAVIGATION; }
    if (kind == 46) { return AUI_SEM_LINK; }
    if (kind == 47) { return AUI_SEM_NAVIGATION; }
    if (kind == 48) { return AUI_SEM_LINK; }
    if (kind == 49) { return AUI_SEM_COMBOBOX; }
    if (kind == 50) { return AUI_SEM_LISTITEM; }
    if (kind == 51) { return AUI_SEM_LIST; }
    if (kind == 52) { return AUI_SEM_LISTITEM; }
    if (kind == 53) { return AUI_SEM_GRID; }
    if (kind == 54) { return AUI_SEM_GRIDCELL; }
    if (kind == 55) { return AUI_SEM_LIST; }
    if (kind == 56) { return AUI_SEM_LISTITEM; }
    if (kind == 57) { return AUI_SEM_IMAGE; }
    if (kind == 58) { return AUI_SEM_LIST; }
    if (kind == 59) { return AUI_SEM_LISTITEM; }
    if (kind == 60) { return AUI_SEM_TEXT; }
    if (kind == 61) { return AUI_SEM_SEPARATOR; }
    if (kind == 63) { return AUI_SEM_GRID; }
    if (kind == 64) { return AUI_SEM_GRIDCELL; }
    return AUI_SEM_GENERIC;
}

// 节点自带文本是否可作派生 label：只有这些 kind 的 n.text 是 UTF-8 显示
// 文本（aux 为长度或 -1；46/48 的 aux 是图标 id，长度一律 strlen）。
// image 的 text 是 RGBA、text field 的 text 是当前值、canvas 的 text 为
// 空——一律不派生，宁可空串也不吐垃圾字节。
fn sem_has_text(idx: i32) : i32 {
    let n: ptr<AuiNode> = node_at(idx);
    if (n.text == 0) { return 0; }
    let k: i32 = n.kind;
    if (k == 5 || k == 6 || k == 14 || k == 15 || k == 18 || k == 20 || k == 26 || k == 30 || k == 33 || k == 35 || k == 46 || k == 48 || k == 50 || k == 60) { return 1; }
    return 0;
}

fn sem_label_ptr(idx: i32) : ptr {
    let lp: ptr = g_aui_sem_label[idx];
    if (lp != 0) { return lp; }
    if (sem_has_text(idx) == 0) { return g_aui_null; }
    let n: ptr<AuiNode> = node_at(idx);
    return n.text;
}

fn sem_label_len(idx: i32) : i32 {
    let lp: ptr = g_aui_sem_label[idx];
    if (lp != 0) { return sem_strlen(lp); }
    if (sem_has_text(idx) == 0) { return 0; }
    let n: ptr<AuiNode> = node_at(idx);
    if (n.text == 0) { return 0; }
    if (n.kind == 46 || n.kind == 48) { return sem_strlen(n.text); }
    if (n.aux >= 0) { return n.aux; }
    return sem_strlen(n.text);
}

fn sem_strlen(s: ptr) : i32 {
    let i: i32 = 0;
    if (s == 0) { return 0; }
    while (load_u8(s + i) != 0) { i = i + 1; }
    return i;
}

// ---- 导出写缓冲（只写、不读共享状态；失败返回 -1，不写越界字节）----
fn sem_put_u8(buf: ptr, cap: i32, pos: i32, c: i32) : i32 {
    if (pos + 1 >= cap) { return -1; }
    let w: i32 = store_u8(buf + pos, c & 255);
    return pos + 1;
}

fn sem_put_str(buf: ptr, cap: i32, pos: i32, s: ptr) : i32 {
    let p: i32 = pos;
    let i: i32 = 0;
    while (load_u8(s + i) != 0) {
        p = sem_put_u8(buf, cap, p, load_u8(s + i));
        if (p < 0) { return -1; }
        i = i + 1;
    }
    return p;
}

fn sem_put_i32(buf: ptr, cap: i32, pos: i32, v: i32) : i32 {
    let tmp: u8[12] = 0;
    let p: i32 = pos;
    let n: i32 = v;
    if (n == -2147483648) { return sem_put_str(buf, cap, p, "-2147483648"); }
    if (n < 0) {
        p = sem_put_u8(buf, cap, p, 45);
        if (p < 0) { return -1; }
        n = 0 - n;
    }
    let i: i32 = 0;
    if (n == 0) {
        let w0: i32 = store_u8(tmp + 0, 48);
        i = 1;
    } else {
        while (n > 0) {
            let d: i32 = n - (n / 10) * 10;
            let w1: i32 = store_u8(tmp + i, 48 + d);
            i = i + 1;
            n = n / 10;
        }
    }
    while (i > 0) {
        i = i - 1;
        p = sem_put_u8(buf, cap, p, load_u8(tmp + i));
        if (p < 0) { return -1; }
    }
    return p;
}

fn sem_put_role(buf: ptr, cap: i32, pos: i32, role: i32) : i32 {
    if (role == AUI_SEM_TEXT) { return sem_put_str(buf, cap, pos, "Text"); }
    if (role == AUI_SEM_HEADING) { return sem_put_str(buf, cap, pos, "Heading"); }
    if (role == AUI_SEM_IMAGE) { return sem_put_str(buf, cap, pos, "Image"); }
    if (role == AUI_SEM_BUTTON) { return sem_put_str(buf, cap, pos, "Button"); }
    if (role == AUI_SEM_LINK) { return sem_put_str(buf, cap, pos, "Link"); }
    if (role == AUI_SEM_CHECKBOX) { return sem_put_str(buf, cap, pos, "Checkbox"); }
    if (role == AUI_SEM_RADIO) { return sem_put_str(buf, cap, pos, "RadioButton"); }
    if (role == AUI_SEM_SWITCH) { return sem_put_str(buf, cap, pos, "Switch"); }
    if (role == AUI_SEM_SLIDER) { return sem_put_str(buf, cap, pos, "Slider"); }
    if (role == AUI_SEM_PROGRESS) { return sem_put_str(buf, cap, pos, "ProgressIndicator"); }
    if (role == AUI_SEM_COMBOBOX) { return sem_put_str(buf, cap, pos, "ComboBox"); }
    if (role == AUI_SEM_TEXTFIELD) { return sem_put_str(buf, cap, pos, "TextField"); }
    if (role == AUI_SEM_SEARCHFIELD) { return sem_put_str(buf, cap, pos, "SearchField"); }
    if (role == AUI_SEM_TAB) { return sem_put_str(buf, cap, pos, "Tab"); }
    if (role == AUI_SEM_TABLIST) { return sem_put_str(buf, cap, pos, "TabList"); }
    if (role == AUI_SEM_MENU) { return sem_put_str(buf, cap, pos, "Menu"); }
    if (role == AUI_SEM_MENUITEM) { return sem_put_str(buf, cap, pos, "MenuItem"); }
    if (role == AUI_SEM_DIALOG) { return sem_put_str(buf, cap, pos, "Dialog"); }
    if (role == AUI_SEM_NAVIGATION) { return sem_put_str(buf, cap, pos, "Navigation"); }
    if (role == AUI_SEM_LIST) { return sem_put_str(buf, cap, pos, "List"); }
    if (role == AUI_SEM_LISTITEM) { return sem_put_str(buf, cap, pos, "ListItem"); }
    if (role == AUI_SEM_GRID) { return sem_put_str(buf, cap, pos, "Grid"); }
    if (role == AUI_SEM_GRIDCELL) { return sem_put_str(buf, cap, pos, "GridCell"); }
    if (role == AUI_SEM_SCROLLVIEW) { return sem_put_str(buf, cap, pos, "ScrollView"); }
    if (role == AUI_SEM_TREE) { return sem_put_str(buf, cap, pos, "Tree"); }
    if (role == AUI_SEM_TREEITEM) { return sem_put_str(buf, cap, pos, "TreeItem"); }
    if (role == AUI_SEM_SEPARATOR) { return sem_put_str(buf, cap, pos, "Separator"); }
    return sem_put_str(buf, cap, pos, "Generic");
}

// label 转义写出：双引号与反斜杠加前缀反斜杠、控制字符改空格，
// 保证严格一行一个节点。引号与反斜杠用字节码写（不依赖字面量转义）。
fn sem_put_label(buf: ptr, cap: i32, pos: i32, s: ptr, nlen: i32) : i32 {
    let p: i32 = pos;
    let i: i32 = 0;
    while (i < nlen) {
        let c: i32 = load_u8(s + i);
        if (c == 34) {
            p = sem_put_u8(buf, cap, p, 92);
            if (p < 0) { return -1; }
            p = sem_put_u8(buf, cap, p, 34);
            if (p < 0) { return -1; }
        } else if (c == 92) {
            p = sem_put_u8(buf, cap, p, 92);
            if (p < 0) { return -1; }
            p = sem_put_u8(buf, cap, p, 92);
            if (p < 0) { return -1; }
        } else if (c < 32) {
            p = sem_put_u8(buf, cap, p, 32);
            if (p < 0) { return -1; }
        } else {
            p = sem_put_u8(buf, cap, p, c);
            if (p < 0) { return -1; }
        }
        i = i + 1;
    }
    return p;
}

// 先序写一行：<缩进><角色> "<label>" key=<key> [x,y,w,h]\n
// bounds 与 aui_debug_rect 同一算法（Q16.16 >> 16），天然一致。
// 深度上限为构建栈 AUI_STACK_MAX（30），递归有界（paint_node 同款）。
fn sem_walk(idx: i32, depth: i32, buf: ptr, cap: i32, pos: i32) : i32 {
    if (g_aui_sem_hide[idx] != 0) { return pos; }
    let n: ptr<AuiNode> = node_at(idx);
    let p: i32 = pos;
    let d: i32 = 0;
    while (d < depth) {
        p = sem_put_str(buf, cap, p, "  ");
        if (p < 0) { return -1; }
        d = d + 1;
    }
    let role: i32 = g_aui_sem_role[idx];
    if (role == 0) { role = sem_default_role(n.kind); }
    p = sem_put_role(buf, cap, p, role);
    if (p < 0) { return -1; }
    p = sem_put_u8(buf, cap, p, 32);
    if (p < 0) { return -1; }
    p = sem_put_u8(buf, cap, p, 34);
    if (p < 0) { return -1; }
    let lp: ptr = sem_label_ptr(idx);
    let ll: i32 = sem_label_len(idx);
    if (lp != 0 && ll > 0) {
        p = sem_put_label(buf, cap, p, lp, ll);
        if (p < 0) { return -1; }
    }
    p = sem_put_u8(buf, cap, p, 34);
    if (p < 0) { return -1; }
    p = sem_put_str(buf, cap, p, " key=");
    if (p < 0) { return -1; }
    p = sem_put_i32(buf, cap, p, n.key);
    if (p < 0) { return -1; }
    p = sem_put_str(buf, cap, p, " [");
    if (p < 0) { return -1; }
    p = sem_put_i32(buf, cap, p, n.x >> 16);
    if (p < 0) { return -1; }
    p = sem_put_u8(buf, cap, p, 44);
    if (p < 0) { return -1; }
    p = sem_put_i32(buf, cap, p, n.y >> 16);
    if (p < 0) { return -1; }
    p = sem_put_u8(buf, cap, p, 44);
    if (p < 0) { return -1; }
    p = sem_put_i32(buf, cap, p, n.w >> 16);
    if (p < 0) { return -1; }
    p = sem_put_u8(buf, cap, p, 44);
    if (p < 0) { return -1; }
    p = sem_put_i32(buf, cap, p, n.h >> 16);
    if (p < 0) { return -1; }
    p = sem_put_str(buf, cap, p, "]\n");
    if (p < 0) { return -1; }
    let c: i32 = n.first_child;
    while (c >= 0) {
        p = sem_walk(c, depth + 1, buf, cap, p);
        if (p < 0) { return -1; }
        let cn: ptr<AuiNode> = node_at(c);
        c = cn.next_sibling;
    }
    return p;
}

// 导出整棵活动树。成功返回字节数（不含 NUL）；缓冲不够返回 -1（缓冲内
// 为截断前缀 + NUL 终止）；根不存在返回 0（空串）。
fn aui_sem_export(buf: ptr, cap: i32) : i32 {
    if (buf == 0 || cap <= 0) { return -1; }
    let w0: i32 = store_u8(buf, 0);
    if (g_aui_root < 0) { return 0; }
    let p: i32 = sem_walk(g_aui_root, 0, buf, cap, 0);
    if (p < 0) {
        let w1: i32 = store_u8(buf + cap - 1, 0);
        return -1;
    }
    let w2: i32 = store_u8(buf + p, 0);
    return p;
}

// 调拥有本次手势的登记回调（Started/Changed/Ended/Canceled 共用）。
fn pn_fire() : i32 {
    if (g_aui_pn_slot < 0) { return 0; }
    let cb: fn(ptr) : i32 = g_aui_pn_cb[g_aui_pn_slot];
    let user: ptr = g_aui_pn_user[g_aui_pn_slot];
    if (cb == 0) { return 0; }
    let r: i32 = cb(user);
    return 0;
}

// 第二指按下：决定是否接管为捏合。返回 0（调用方 handle_motion 直接
// return，不落入单指链）。接管条件：已有第一指、无独占属主、第二指
// 落在捏合登记节点（含祖先）、两指间距 >= 8 dp。
fn pn_pointer_down(ev: ptr, pidx: i32) : i32 {
    if (g_aui_pn_state == 1) { return 0; }   // 第三指：忽略
    if (g_aui_pn_p0id < 0) { return 0; }     // 无第一指：忽略
    // 独占属主在接管期间不让位（与单指链的独占顺序一致）。
    if (g_aui_slider_key != 0 || g_aui_split_drag_key != 0 ||
        g_aui_pager_dragging != 0 || g_aui_sheet_drag >= 0 ||
        g_aui_menu >= 0 || g_aui_popup >= 0 ||
        g_aui_combo_open >= 0 || g_aui_select_open >= 0 ||
        g_aui_date_press_key != 0 || g_aui_time_press_key != 0 ||
        g_aui_snack_down != 0 || g_dbg_down != 0 || g_dbg_panel_down != 0 ||
        g_aui_ref_drag_key != 0) { return 0; }
    let p1id: i32 = AMotionEvent_getPointerId(ev, pidx);
    let p1x: i32 = event_xi(ev, pidx);
    let p1y: i32 = event_yi(ev, pidx);
    // 第一指的当前位置按 id 从事件里现找（index 会随抬起变化，id 稳定）。
    let n: i32 = AMotionEvent_getPointerCount(ev);
    let p0x: i32 = g_aui_pn_p0x;
    let p0y: i32 = g_aui_pn_p0y;
    let i: i32 = 0;
    while (i < n) {
        let id: i32 = AMotionEvent_getPointerId(ev, i);
        if (id == g_aui_pn_p0id) {
            p0x = event_xi(ev, i);
            p0y = event_yi(ev, i);
        }
        i = i + 1;
    }
    let hit: i32 = hit_test(g_aui_root, p1x, p1y);
    let k: i32 = find_pn(hit);
    if (k < 0) { return 0; }
    let dx: i32 = p1x - p0x;
    let dy: i32 = p1y - p0y;
    let spread: i32 = isqrt(dx * dx + dy * dy);
    let slop: i32 = dp2q(8) >> 16;
    if (spread < slop) { return 0; }
    // 接管：取消单指的软状态（点按/长按待定/滚动拖拽/分页候选），
    // 不产生 fling（UP 派发要求 was_drag != 0，而 dragging 已清）。
    let lc: i32 = lp_cancel_why(7);
    if (g_aui_tip_pend != 0) {
        g_aui_tip_pend = 0;
        g_aui_tip_pend_idx = -1;
    }
    g_aui_pressing = 0;
    g_aui_press_key = 0;
    g_aui_dragging = 0;
    g_aui_drag_key = 0;
    pager_drag_clear();
    g_aui_pn_p1id = p1id;
    g_aui_pn_p0x = p0x;
    g_aui_pn_p0y = p0y;
    g_aui_pn_p1x = p1x;
    g_aui_pn_p1y = p1y;
    g_aui_pn_spread0 = spread;
    g_aui_pn_cx = (p0x + p1x) / 2;
    g_aui_pn_cy = (p0y + p1y) / 2;
    g_aui_pn_dx = 0;
    g_aui_pn_dy = 0;
    g_aui_pn_scale = 65536;
    g_aui_pn_state = 1;
    g_aui_pn_slot = k;
    let nn: ptr<AuiNode> = node_at(g_aui_pn_node[k]);
    g_aui_pn_key = nn.key;
    let tp: i32 = trace_hex(80, pidx);        // P + pointer index
    let pf: i32 = pn_fire();
    aui_invalidate();
    return 0;
}

// 一指抬起（POINTER_UP）：捏合结束。剩下的手指不恢复滚动、不点按、
// 不 fling——接管时已清掉按压与拖动态。
fn pn_pointer_up(ev: ptr, pidx: i32) : i32 {
    if (g_aui_pn_state != 1) { return 0; }
    let id: i32 = AMotionEvent_getPointerId(ev, pidx);
    if (id != g_aui_pn_p0id && id != g_aui_pn_p1id) { return 0; }
    let e: i32 = pn_end(0);
    return 0;
}

// 捏合进行中的 MOVE：按 id 更新两指位置，重算 spread/质心/累计缩放/
// 平移增量，调回调。调用方 handle_motion 直接 return，不走单指链。
fn pn_move(ev: ptr) : i32 {
    if (g_aui_pn_state != 1) { return 0; }
    let n: i32 = AMotionEvent_getPointerCount(ev);
    let i: i32 = 0;
    while (i < n) {
        let id: i32 = AMotionEvent_getPointerId(ev, i);
        if (id == g_aui_pn_p0id) {
            g_aui_pn_p0x = event_xi(ev, i);
            g_aui_pn_p0y = event_yi(ev, i);
        }
        if (id == g_aui_pn_p1id) {
            g_aui_pn_p1x = event_xi(ev, i);
            g_aui_pn_p1y = event_yi(ev, i);
        }
        i = i + 1;
    }
    let dx: i32 = g_aui_pn_p1x - g_aui_pn_p0x;
    let dy: i32 = g_aui_pn_p1y - g_aui_pn_p0y;
    let spread: i32 = isqrt(dx * dx + dy * dy);
    if (spread < 1) { spread = 1; }
    let cx: i32 = (g_aui_pn_p0x + g_aui_pn_p1x) / 2;
    let cy: i32 = (g_aui_pn_p0y + g_aui_pn_p1y) / 2;
    g_aui_pn_dx = cx - g_aui_pn_cx;
    g_aui_pn_dy = cy - g_aui_pn_cy;
    g_aui_pn_cx = cx;
    g_aui_pn_cy = cy;
    g_aui_pn_scale = i32((i64(spread) * 65536) / i64(g_aui_pn_spread0));
    let pf: i32 = pn_fire();
    aui_invalidate();
    return 0;
}

// 结束捏合：why 0 = 一指抬起（Ended），1 = 取消（Canceled）。
// 缩放/焦点/key 保持终值，供回调后读取；状态置 2（已结束）。
fn pn_end(why: i32) : i32 {
    if (g_aui_pn_state != 1) { return 0; }
    g_aui_pn_state = 2;
    g_aui_pn_p1id = -1;
    let tq: i32 = trace_hex(81, why);         // Q + 原因
    let pf: i32 = pn_fire();
    g_aui_pn_slot = -1;
    aui_invalidate();
    return 0;
}

// 取消待定与已触发状态。返回 1 = 之前有待定或已触发（调用方需要重绘）。
// why：1=新按下，2=返回键，3=提示认领抬起，4=系统取消，5=移动超 slop，
// 6=提前抬起，7=捏合接管；0=未指定。
fn lp_cancel_why(why: i32) : i32 {
    let had: i32 = 0;
    if (g_aui_lp_pend != 0 || g_aui_lp_fired != 0) { had = 1; }
    if (had != 0) {
        // v2.7.1-diag：取消行（el=自按下起毫秒，ticks=待定期间 lp_tick 调用次数）。
        let cel: i32 = i32((clock_ns() - g_aui_lp_start) / 1000000);
        let cl: i32 = aui_log3(4, "lp cancel why=", why, " el=", cel, "ms ticks=", g_aui_lp_diag_ticks, "");
    }
    g_aui_lp_pend = 0;
    g_aui_lp_pend_idx = -1;
    g_aui_lp_pend_key = 0;
    g_aui_lp_fired = 0;
    g_aui_lp_key = 0;
    // D-2a：BACK 同时取消可选中待定（已建立的选区不受影响）。
    let sc4: i32 = d2a_sel_cancel_pend();
    if (had != 0) {
        g_aui_need_paint = 1;
        g_aui_pump_need = 1;
    }
    return had;
}

fn lp_cancel() : i32 {
    return lp_cancel_why(0);
}

// 长按判定通过：调一次回调，接管本次手势。点按互斥靠清按压态：
// 通用点按派发要求 down != 0，自然跳过。
fn lp_fire() : i32 {
    let k: i32 = g_aui_lp_pend_idx;
    g_aui_lp_pend = 0;
    g_aui_lp_pend_idx = -1;
    g_aui_lp_fired = 1;
    g_aui_lp_key = g_aui_lp_pend_key;
    g_aui_lp_pend_key = 0;
    // v2.7.1-diag：触发行（el=自按下起毫秒，ticks=待定期间 lp_tick 调用次数）。
    let fel: i32 = i32((clock_ns() - g_aui_lp_start) / 1000000);
    let fl: i32 = aui_log3(4, "lp fire key=", g_aui_lp_key, " el=", fel, "ms ticks=", g_aui_lp_diag_ticks, "");
    let cb: fn(ptr) : i32 = 0;
    let user: ptr = 0;
    if (k >= 0 && k < g_aui_lp_used) {
        cb = g_aui_lp_cb[k];
        user = g_aui_lp_user[k];
    }
    g_aui_pressing = 0;
    g_aui_press_key = 0;
    g_aui_need_paint = 1;
    g_aui_pump_need = 1;
    if (cb != 0) {
        let r: i32 = cb(user);
    }
    return 0;
}

// 帧节拍：到 500 ms 触发一次。由 pump_ui 每拍调用，时间来自
// clock_ns（测试用 fake_set_clock 注入）。
fn lp_tick() : i32 {
    // D-2a：可选中长按与长按回调共用泵节拍（同一 500 ms 阈值）。
    if (d2a_sel_tick() != 0) { return 1; }
    // v2.7.1-diag：待定期间每次被调都计数（真机日志用：ticks=0 说明
    // 泵在本次按住期间根本没调过 lp_tick）。
    if (g_aui_lp_pend != 0) {
        g_aui_lp_diag_ticks = g_aui_lp_diag_ticks + 1;
    }
    if (g_aui_lp_pend != 0 && clock_ns() - g_aui_lp_start >= AUI_LP_NS) {
        let r: i32 = lp_fire();
        let tw: i32 = pump_wake();
        return 1;
    }
    return 0;
}

// v2.7.1-diag：泵要回空闲、而长按还在待定——记一行（每按一次只记
// 一次）。若真机日志出现这行、之后又无 fire，说明泵再也没调 lp_tick。
fn lp_diag_idle() : i32 {
    if (g_aui_lp_pend == 0) { return 0; }
    if (g_aui_lp_diag_idle != 0) { return 0; }
    g_aui_lp_diag_idle = 1;
    let el: i32 = i32((clock_ns() - g_aui_lp_start) / 1000000);
    let l: i32 = aui_log2(4, "lp pump idle el=", el, "ms ticks=", g_aui_lp_diag_ticks, "");
    return 0;
}

// 1 = 还有计时任务（待定长按）。帧泵据此保持 16 ms 轮询。
fn lp_busy() : i32 {
    if (g_aui_lp_pend != 0) { return 1; }
    return 0;
}

// ---- 协作任务 / 延迟（v2.9）----
// 对照 HuxerUI Task/Delay（docs/design/tasks.md）：Delay(500ms) 在 UI
// 线程恢复，回调里可直接改 State。Aster 无闭包/协程，退化为一次性延时
// 回调。登记表固定 32 项，与长按登记表同构；handle = 槽位下标。
let AUI_TASK_CAP: i32 = 32;
let g_aui_task_cb: fn(ptr) : i32[32] = 0;
let g_aui_task_user: ptr[32] = 0;
let g_aui_task_deadline: i64[32] = 0;   // ns（clock_ns）；到期时刻
let g_aui_task_seq: i32[32] = 0;        // 注册顺序（同 deadline 时先注册先触发）
let g_aui_task_state: i32[32] = 0;      // 0 空，1 待定
let g_aui_task_next_seq: i32 = 0;

// v2.9：一次性延时。ms < 0 或 cb 为空返回 -1；登记表满返回 -1。
// 0 ms 即 deadline = 当前时刻，下一拍 task_tick 触发。
fn aui_delay(ms: i32, cb: fn(ptr) : i32, user: ptr) : i32 {
    if (ms < 0 || cb == 0) { return -1; }
    let k: i32 = 0;
    while (k < AUI_TASK_CAP) {
        if (g_aui_task_state[k] == 0) { break; }
        k = k + 1;
    }
    if (k >= AUI_TASK_CAP) { return -1; }
    let now: i64 = clock_ns();
    g_aui_task_cb[k] = cb;
    g_aui_task_user[k] = user;
    g_aui_task_deadline[k] = now + i64(ms) * 1000000;
    g_aui_task_seq[k] = g_aui_task_next_seq;
    g_aui_task_next_seq = g_aui_task_next_seq + 1;
    g_aui_task_state[k] = 1;
    g_aui_pump_need = 1;
    let w: i32 = pump_wake();
    return k;
}

// v2.9：取消待定任务。1 = 取消了一个待定任务；0 = 句柄未知/已触发/
// 已取消（安全空操作）。
fn aui_delay_cancel(handle: i32) : i32 {
    if (handle < 0 || handle >= AUI_TASK_CAP) { return 0; }
    if (g_aui_task_state[handle] != 1) { return 0; }
    g_aui_task_state[handle] = 0;
    g_aui_task_cb[handle] = 0;
    g_aui_task_user[handle] = 0;
    return 1;
}

// v2.9：待定任务数（调试 getter；面板/诊断与 Gallery 演示用）。
fn aui_debug_task_pending() : i32 {
    let n: i32 = 0;
    let k: i32 = 0;
    while (k < AUI_TASK_CAP) {
        if (g_aui_task_state[k] == 1) { n = n + 1; }
        k = k + 1;
    }
    return n;
}

// 1 = 还有待定任务。帧泵据此保持 16 ms 轮询。
fn task_busy() : i32 {
    if (aui_debug_task_pending() != 0) { return 1; }
    return 0;
}

// ===========================================================================
// 5c. 回调复用池（Phase 0 真正回收）
// ===========================================================================
// 固定 64 槽，.bss 静态数组，池子自己拥有内存，不走 arena。
// 两种形态：kind 0 = 普通 fn(ptr) -> i32（cb + user）；kind 1 = 闭包
// （code: fn(ptr, ptr) -> i32 + env: ptr，从闭包值的 16 字节 {code, env}
// 拷贝而来——闭包值从不经过 fn 参数，因此不触发编译器 thunk / arena
// env 分配（C-2 绕过）；注册/注销同一闭包值只复用槽位，不产生新上下文。
// 句柄 = (代数 << 8) | 槽下标；代数区分注销后复用的旧句柄。
// 每槽还存 arg：节点绑定时 thunk 用它作调用实参（fn 形态下 arg = user，
// 闭包形态下 arg 由 aui_cb_register_closure_arg 指定，缺省为 0）。
let AUI_CB_CAP: i32 = 64;
let AUI_CB_KIND_FN: i32 = 0;
let AUI_CB_KIND_CLOSURE: i32 = 1;
let g_aui_cb_fn1: fn(ptr) : i32[64] = 0;
let g_aui_cb_fn2: fn(ptr, ptr) : i32[64] = 0;
let g_aui_cb_env: ptr[64] = 0;
let g_aui_cb_arg: ptr[64] = 0;
let g_aui_cb_kind: i32[64] = 0;
let g_aui_cb_state: i32[64] = 0;      // 0 空闲，1 在用
let g_aui_cb_gen: i32[64] = 0;
let g_aui_cb_next: i32[64] = 0;       // 空闲链表
let g_aui_cb_free: i32 = 0;           // 空闲链表头（-1 = 无空闲）
let g_aui_cb_used: i32 = 0;
let g_aui_cb_hwm: i32 = 0;
let g_aui_cb_cycles: i32 = 0;         // 注册 + 注销总次数
let g_aui_cb_retired: i32 = 0;        // 1 = Window 已退休，拒绝新注册
let g_aui_cb_inited: i32 = 0;

// 重置池子（测试用；也清 retired 标志）。正常路径只调一次。
fn aui_cb_init() : i32 {
    let i: i32 = 0;
    while (i < AUI_CB_CAP) {
        g_aui_cb_fn1[i] = 0;
        g_aui_cb_fn2[i] = 0;
        g_aui_cb_env[i] = 0;
        g_aui_cb_arg[i] = 0;
        g_aui_cb_kind[i] = 0;
        g_aui_cb_state[i] = 0;
        g_aui_cb_gen[i] = 0;
        if (i + 1 < AUI_CB_CAP) { g_aui_cb_next[i] = i + 1; } else { g_aui_cb_next[i] = -1; }
        i = i + 1;
    }
    g_aui_cb_free = 0;
    g_aui_cb_used = 0;
    g_aui_cb_hwm = 0;
    g_aui_cb_cycles = 0;
    g_aui_cb_retired = 0;
    g_aui_cb_inited = 1;
    return 0;
}

fn aui_cb_ensure_init() : i32 {
    if (g_aui_cb_inited != 0) { return 0; }
    let r: i32 = aui_cb_init();
    return r;
}

// 取一个空闲槽；满时记 A-120 返 -1。
fn aui_cb_alloc_slot() : i32 {
    let e: i32 = aui_cb_ensure_init();
    if (g_aui_cb_free < 0) { let er: i32 = aui_set_err(AUI_ERR_CB_FULL); return -1; }
    let s: i32 = g_aui_cb_free;
    g_aui_cb_free = g_aui_cb_next[s];
    g_aui_cb_state[s] = 1;
    g_aui_cb_used = g_aui_cb_used + 1;
    if (g_aui_cb_used > g_aui_cb_hwm) { g_aui_cb_hwm = g_aui_cb_used; }
    g_aui_cb_cycles = g_aui_cb_cycles + 1;
    return s;
}

// 注册普通回调。成功返句柄；cb 为空返 -1；池满记 A-120 返 -1；
// Window 已退休记 A-122 返 -1。
fn aui_cb_register(cb: fn(ptr) : i32, user: ptr) : i32 {
    if (g_aui_cb_retired != 0) { let er: i32 = aui_set_err(AUI_ERR_CB_RETIRED); return -1; }
    if (cb == 0) { return -1; }
    let s: i32 = aui_cb_alloc_slot();
    if (s < 0) { return -1; }
    g_aui_cb_fn1[s] = cb;
    g_aui_cb_fn2[s] = 0;
    g_aui_cb_env[s] = user;
    g_aui_cb_arg[s] = user;
    g_aui_cb_kind[s] = AUI_CB_KIND_FN;
    return (g_aui_cb_gen[s] << 8) | s;
}

// 注册闭包回调：v 指向闭包值的 16 字节 {code, env}，只拷贝两个指针，
// 不产生 thunk、不分配 arena。成功返句柄；v 为空或 code 为空返 -1；
// 池满记 A-120 返 -1；Window 已退休记 A-122 返 -1。
fn aui_cb_register_closure_ptr(v: ptr) : i32 {
    if (g_aui_cb_retired != 0) { let er: i32 = aui_set_err(AUI_ERR_CB_RETIRED); return -1; }
    if (v == 0) { return -1; }
    let code: fn(ptr, ptr) : i32 = load_ptr(v);
    if (code == 0) { return -1; }
    let s: i32 = aui_cb_alloc_slot();
    if (s < 0) { return -1; }
    g_aui_cb_fn1[s] = 0;
    g_aui_cb_fn2[s] = code;
    g_aui_cb_env[s] = load_ptr(v + 8);
    g_aui_cb_arg[s] = 0;
    g_aui_cb_kind[s] = AUI_CB_KIND_CLOSURE;
    return (g_aui_cb_gen[s] << 8) | s;
}

// 注册闭包回调并指定节点调用实参（节点绑定时 thunk 传给闭包的“用户”）。
fn aui_cb_register_closure_arg(v: ptr, arg: ptr) : i32 {
    let h: i32 = aui_cb_register_closure_ptr(v);
    if (h < 0) { return -1; }
    let s: i32 = h & 255;
    g_aui_cb_arg[s] = arg;
    return h;
}

// 按句柄调用。fn 形态调 fn1(arg)；闭包形态调 fn2(env, arg)。
// 句柄无效/已注销记 A-121 返 -1。
fn aui_cb_invoke(handle: i32, arg: ptr) : i32 {
    let s: i32 = handle & 255;
    let g: i32 = handle >> 8;
    if (s < 0 || s >= AUI_CB_CAP) { let er: i32 = aui_set_err(AUI_ERR_CB_BAD_HANDLE); return -1; }
    if (g_aui_cb_state[s] != 1) { let er: i32 = aui_set_err(AUI_ERR_CB_BAD_HANDLE); return -1; }
    if (g_aui_cb_gen[s] != g) { let er: i32 = aui_set_err(AUI_ERR_CB_BAD_HANDLE); return -1; }
    if (g_aui_cb_kind[s] == AUI_CB_KIND_CLOSURE) {
        let f: fn(ptr, ptr) : i32 = g_aui_cb_fn2[s];
        return f(g_aui_cb_env[s], arg);
    }
    let f1: fn(ptr) : i32 = g_aui_cb_fn1[s];
    return f1(arg);
}

// 注销句柄，槽位立即回空闲链表。1 = 注销了一个；0 = 句柄无效/已注销
// （记 A-121，安全空操作）。
fn aui_cb_release(handle: i32) : i32 {
    let s: i32 = handle & 255;
    let g: i32 = handle >> 8;
    if (s < 0 || s >= AUI_CB_CAP) { let er: i32 = aui_set_err(AUI_ERR_CB_BAD_HANDLE); return 0; }
    if (g_aui_cb_state[s] != 1) { let er: i32 = aui_set_err(AUI_ERR_CB_BAD_HANDLE); return 0; }
    if (g_aui_cb_gen[s] != g) { let er: i32 = aui_set_err(AUI_ERR_CB_BAD_HANDLE); return 0; }
    g_aui_cb_state[s] = 0;
    g_aui_cb_fn1[s] = 0;
    g_aui_cb_fn2[s] = 0;
    g_aui_cb_env[s] = 0;
    g_aui_cb_arg[s] = 0;
    g_aui_cb_gen[s] = g_aui_cb_gen[s] + 1;
    g_aui_cb_next[s] = g_aui_cb_free;
    g_aui_cb_free = s;
    g_aui_cb_used = g_aui_cb_used - 1;
    g_aui_cb_cycles = g_aui_cb_cycles + 1;
    return 1;
}

// Window 退休：先禁新注册，再注销全部在用槽（回调指针与 env 清零，
// 槽位归还）。返注销的槽数。由 aui_shutdown 调用。
fn aui_cb_retire_all() : i32 {
    let e: i32 = aui_cb_ensure_init();
    g_aui_cb_retired = 1;
    let n: i32 = 0;
    let s: i32 = 0;
    while (s < AUI_CB_CAP) {
        if (g_aui_cb_state[s] == 1) {
            g_aui_cb_state[s] = 0;
            g_aui_cb_fn1[s] = 0;
            g_aui_cb_fn2[s] = 0;
            g_aui_cb_env[s] = 0;
            g_aui_cb_arg[s] = 0;
            g_aui_cb_gen[s] = g_aui_cb_gen[s] + 1;
            g_aui_cb_next[s] = g_aui_cb_free;
            g_aui_cb_free = s;
            g_aui_cb_used = g_aui_cb_used - 1;
            n = n + 1;
        }
        s = s + 1;
    }
    return n;
}

// 节点回调分派 thunk：节点 cb 挂此函数、user 挂 ptr(handle)。
// 按槽内登记的 arg 调用（fn 形态下 arg = 注册时的 user）。
fn aui_cb_node_thunk(user: ptr) : i32 {
    let h: i32 = i32(user);
    let s: i32 = h & 255;
    if (s < 0 || s >= AUI_CB_CAP) { return -1; }
    if (g_aui_cb_state[s] != 1) { return -1; }
    if (g_aui_cb_gen[s] != (h >> 8)) { return -1; }
    return aui_cb_invoke(h, g_aui_cb_arg[s]);
}

// 标准库 arena 已用字节（只读，供回收探针读基线；arena 本身不归框架管）。
extern let arena_used: i32;

fn aui_arena_used() : i32 { return arena_used; }

fn aui_debug_cb_used() : i32 { return g_aui_cb_used; }
fn aui_debug_cb_hwm() : i32 { return g_aui_cb_hwm; }
fn aui_debug_cb_cycles() : i32 { return g_aui_cb_cycles; }
fn aui_debug_cb_retired() : i32 { return g_aui_cb_retired; }
fn aui_debug_frame_seq() : i32 { return g_aui_frame_seq; }
fn aui_debug_frame_sealed() : i32 { return g_aui_frame_sealed; }
fn aui_debug_frame_node_hwm() : i32 { return g_aui_frame_node_hwm; }
fn aui_debug_frame_cmd_hwm() : i32 { return g_aui_frame_cmd_hwm; }
fn aui_debug_frame_num_hwm() : i32 { return g_aui_frame_num_hwm; }

// 帧节拍：触发所有到期任务（deadline 升序，同 deadline 按注册顺序）。
// 每轮取当前最早到期者，槽位先释放再调回调：回调里再注册（0 ms 链式
// 任务）或取消其他任务都不会破坏扫描；每拍最多触发 32 次，回调里无限
// 链式注册 0 ms 任务也不会让这一拍死循环，剩下的下一拍触发。
// 由 pump_ui / pump_frame_once 每拍调用，时间来自 clock_ns（测试用
// fake_set_clock 注入）。
fn task_tick() : i32 {
    let fired: i32 = 0;
    let n: i32 = 0;
    while (n < AUI_TASK_CAP) {
        let now: i64 = clock_ns();
        let best: i32 = -1;
        let k: i32 = 0;
        while (k < AUI_TASK_CAP) {
            if (g_aui_task_state[k] == 1 && g_aui_task_deadline[k] <= now) {
                if (best < 0 || g_aui_task_deadline[k] < g_aui_task_deadline[best] ||
                    (g_aui_task_deadline[k] == g_aui_task_deadline[best] && g_aui_task_seq[k] < g_aui_task_seq[best])) {
                    best = k;
                }
            }
            k = k + 1;
        }
        if (best < 0) { return fired; }
        let cb: fn(ptr) : i32 = g_aui_task_cb[best];
        let user: ptr = g_aui_task_user[best];
        g_aui_task_state[best] = 0;
        g_aui_task_cb[best] = 0;
        g_aui_task_user[best] = 0;
        fired = fired + 1;
        g_aui_need_paint = 1;
        g_aui_pump_need = 1;
        let fl: i32 = aui_log1(4, "task fire h=", best, "");
        if (cb != 0) {
            let r: i32 = cb(user);
        }
        n = n + 1;
    }
    return fired;
}

fn tip_align_off(span: i32, w: i32, a: i32) : i32 {
    if (a == 1) { return (span - w) / 2; }
    if (a == 2) { return span - w; }
    return 0;
}

// v1.27：工具提示布局。先按最大宽度换行，气泡尺寸 = 文本 + 8/4 dp 内边距，
// 高度不小于 24 dp；默认锚点上方居中（HuxerUI 默认），放不下翻到对侧，
// 最后整体夹进内容区并留 8 dp 边距。
fn tip_layout(cx: i32, cy: i32, cw: i32, ch: i32) : i32 {
    if (g_aui_tip_on == 0) { return 0; }
    let s: ptr = g_aui_tip_text;
    if (s == 0) { g_aui_tip_on = 0; return 0; }
    let tlen: i32 = str_len(s);
    if (tlen <= 0) { g_aui_tip_on = 0; return 0; }
    let margin: i32 = dp2q(8);
    let gap: i32 = dp2q(4);
    let padx: i32 = dp2q(8);
    let pady: i32 = dp2q(4);
    let maxw: i32 = dp2q(320);
    let avail: i32 = cw - margin * 2;
    if (avail < maxw) { maxw = avail; }
    if (maxw <= padx * 2) { g_aui_tip_on = 0; return 0; }
    let maxtext: i32 = maxw - padx * 2;
    g_aui_tip_tw = maxtext;
    let mw: i32 = layout_text(s, tlen, maxtext);
    let lh: i32 = text_line_h();
    let w: i32 = mw + padx * 2;
    if (w > maxw) { w = maxw; }
    if (w <= 0) { g_aui_tip_on = 0; return 0; }
    let h: i32 = g_aui_mlines * lh + pady * 2;
    let minh: i32 = dp2q(24);
    if (h < minh) { h = minh; }
    let maxh: i32 = ch - margin * 2;
    if (h > maxh) { h = maxh; }
    if (h <= 0) { g_aui_tip_on = 0; return 0; }
    let ax: i32 = g_aui_tip_ax;
    let ay: i32 = g_aui_tip_ay;
    let aw: i32 = g_aui_tip_aw;
    let ah: i32 = g_aui_tip_ah;
    let side: i32 = g_aui_tip_side;
    let al: i32 = g_aui_tip_align;
    let x: i32 = 0;
    let y: i32 = 0;
    if (side == 1) {                 // 下方
        y = ay + ah + gap;
        if (y + h > cy + ch - margin) {
            let up: i32 = ay - gap - h;
            if (up >= cy + margin) { y = up; }
            else { y = cy + ch - margin - h; }
        }
        x = ax + tip_align_off(aw, w, al);
    } else if (side == 2) {          // 右侧
        x = ax + aw + gap;
        if (x + w > cx + cw - margin) {
            let lf: i32 = ax - gap - w;
            if (lf >= cx + margin) { x = lf; }
            else { x = cx + cw - margin - w; }
        }
        y = ay + tip_align_off(ah, h, al);
    } else if (side == 3) {          // 左侧
        x = ax - gap - w;
        if (x < cx + margin) {
            let rt: i32 = ax + aw + gap;
            if (rt + w <= cx + cw - margin) { x = rt; }
            else { x = cx + margin; }
        }
        y = ay + tip_align_off(ah, h, al);
    } else {                         // 上方（默认）
        y = ay - gap - h;
        if (y < cy + margin) {
            let dn: i32 = ay + ah + gap;
            if (dn + h <= cy + ch - margin) { y = dn; }
            else { y = cy + margin; }
        }
        x = ax + tip_align_off(aw, w, al);
    }
    if (x < cx + margin) { x = cx + margin; }
    if (y < cy + margin) { y = cy + margin; }
    if (x + w > cx + cw - margin) { x = cx + cw - margin - w; }
    if (y + h > cy + ch - margin) { y = cy + ch - margin - h; }
    if (x < cx) { x = cx; }
    if (y < cy) { y = cy; }
    g_aui_tip_x = x;
    g_aui_tip_y = y;
    g_aui_tip_w = w;
    g_aui_tip_h = h;
    return 0;
}

fn modify_target() : ptr<AuiNode> {
    if (g_aui_last_created < 0) { return 0; }
    return node_at(g_aui_last_created);
}

fn aui_pad(dp: i32) : i32 {
    let n: ptr<AuiNode> = modify_target();
    if (n == 0) { return 0; }
    n.pad = dp2q(dp);
    return 0;
}

fn aui_gap(dp: i32) : i32 {
    let n: ptr<AuiNode> = modify_target();
    if (n == 0) { return 0; }
    n.gap = dp2q(dp);
    return 0;
}

fn aui_weight(w: i32) : i32 {
    let n: ptr<AuiNode> = modify_target();
    if (n == 0) { return 0; }
    n.weight = w;
    return 0;
}

fn aui_align(a: i32) : i32 {
    let n: ptr<AuiNode> = modify_target();
    if (n == 0) { return 0; }
    n.align = a;
    return 0;
}

fn aui_bg(color: u32) : i32 {
    let n: ptr<AuiNode> = modify_target();
    if (n == 0) { return 0; }
    n.bg = color;
    return 0;
}

fn aui_radius(dp: i32) : i32 {
    let n: ptr<AuiNode> = modify_target();
    if (n == 0) { return 0; }
    n.radius = dp2q(dp);
    return 0;
}

// D-2a 前置 5 项：通用宽高 / 任意字号 / 通用前景色 / 长按选中。
// 形态与 aui_pad/aui_gap/aui_weight/aui_align/aui_bg/aui_radius 同款：
// 修饰器，挂最近创建的节点，返回 i32；无目标返回 0。
// 尺寸：每维 i32 dp；−1 = 未指定（包内容/默认量出，现行行为），其它负值
// 按 −1 归一。−1 在此只表示“未指定”，不是 Android 的 MATCH_PARENT /
// WRAP_CONTENT（评估稿 §8 第 4 条：不引入 −1/−2 魔法数）；填满走既有
// weight 机制。尺寸在 measure 入口（avail）与出口（w/h）起约束作用。
fn aui_size(w: i32, h: i32) : i32 {
    let t: i32 = g_aui_last_created;
    if (t < 0) { return 0; }
    if (w < 0) { w = -1; }
    if (h < 0) { h = -1; }
    g_d2a_size_w[t] = w;
    g_d2a_size_h[t] = h;
    return 0;
}

// 字号：i32 sp；−1 = 默认（走现有角色制），其它负值按 −1 归一。
// 只对 label(5)/button(6) 有效（与 aui_text_role 同一适用范围），
// 其它种返回 -1。
fn aui_text_size(sp: i32) : i32 {
    let n: ptr<AuiNode> = modify_target();
    if (n == 0) { return 0; }
    if (n.kind != 5 && n.kind != 6) { return -1; }
    if (sp < 0) { sp = -1; }
    g_d2a_text_sp[g_aui_last_created] = sp;
    return 0;
}

// 前景色：u32 ARGB，逐节点覆盖；未设置时走主题。显式 0x00000000
// 也是有效覆盖（fg_set 区分“未设置”）。背景仍走 aui_bg。
fn aui_fg(color: u32) : i32 {
    let n: ptr<AuiNode> = modify_target();
    if (n == 0) { return 0; }
    let t: i32 = g_aui_last_created;
    g_d2a_fg[t] = i32(color);
    g_d2a_fg_set[t] = 1;
    return 0;
}

// 长按选中：flag != 0 = 可选中。标记本身接受任何节点；选中行为只对
// 文本节点（label/kind 5，含 aui_text_i32）生效。有 aui_long_press
// 回调登记的节点走回调、不产生选区。
fn aui_selectable(flag: i32) : i32 {
    let n: ptr<AuiNode> = modify_target();
    if (n == 0) { return 0; }
    let t: i32 = g_aui_last_created;
    if (flag != 0) { g_d2a_sel[t] = 1; } else { g_d2a_sel[t] = 0; }
    return 0;
}

fn aui_label(key: i32, text: ptr) : i32 {
    let i: i32 = push_leaf(5, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.text = text;
    n.aux = -1;
    return i;
}

fn aui_label_n(key: i32, text: ptr, tlen: i32) : i32 {
    let i: i32 = push_leaf(5, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.text = text;
    n.aux = tlen;
    return i;
}

fn aui_text_i32(key: i32, value: i32) : i32 {
    let s: ptr = i32_to_str(value);
    let i: i32 = push_leaf(5, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.text = s;
    n.aux = -1;
    return i;
}

fn aui_button(key: i32, text: ptr, cb: fn(ptr) : i32, user: ptr) : i32 {
    let i: i32 = push_leaf(6, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.text = text;
    n.aux = -1;
    n.cb = cb;
    n.user = user;
    return i;
}

// v1.36：图标按钮（kind 37）。icon 取 AUI_ICON_*（越界按 PLUS 处理），
// size_dp = 0 用默认 40 dp；图形边长 = 方块的一半。禁用位在 flags 里，
// 绘制降透明度、命中路径也不派发回调。
fn aui_icon_button(key: i32, icon: i32, size_dp: i32, flags: i32,
                   cb: fn(ptr) : i32, user: ptr) : i32 {
    let i: i32 = push_leaf(37, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    if (icon < 1 || icon > AUI_ICON_MAX) { icon = AUI_ICON_PLUS; }
    n.aux = icon;
    let sz: i32 = size_dp;
    if (sz <= 0) { sz = 40; }
    if (sz < 24) { sz = 24; }
    if (sz > 96) { sz = 96; }
    n.aux2 = dp2q(sz);
    n.flags = flags & AUI_ICONBTN_DISABLED;
    n.cb = cb;
    n.user = user;
    return i;
}

// v1.36：只读图标（kind 38）。默认 20 dp；不接收点击，可放进行/列/栈。
fn aui_icon(key: i32, icon: i32, size_dp: i32) : i32 {
    let i: i32 = push_leaf(38, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    if (icon < 1 || icon > AUI_ICON_MAX) { icon = AUI_ICON_PLUS; }
    n.aux = icon;
    let sz: i32 = size_dp;
    if (sz <= 0) { sz = 20; }
    if (sz < 8) { sz = 8; }
    if (sz > 96) { sz = 96; }
    n.aux2 = dp2q(sz);
    return i;
}

// v1.37：流式布局容器（kind 39，对照 HuxerUI Flow）。子项按声明顺序
// 从左到右排，放不下就换行；aui_gap 同时作为列间距和行间距。
// 宽度在可用宽度里铺满，行内剩余宽度可用 aux2 的主轴对齐分配。
fn aui_flow(key: i32) : i32 {
    return push_container(39, key);
}

// v1.37：Flow 主轴对齐（0 start / 1 center / 2 end / 3 space-between），
// 作用于最近创建的节点；必须在添加子项之前调用。
fn aui_flow_align(a: i32) : i32 {
    let n: ptr<AuiNode> = modify_target();
    if (n == 0) { return 0; }
    if (n.kind != 39) { return 0; }
    if (a < 0) { a = 0; }
    if (a > 3) { a = 3; }
    n.aux2 = a;
    return 0;
}

// v1.37：水平分隔线（kind 40，对照 HuxerUI Divider）。1 dp 细线，宽度
// 铺满可用宽度；aui_pad 控制左右缩进（上下内边距会把线盒撑高，线本身
// 仍然居中）。默认颜色是文字色 12% 透明度，aui_bg 可覆盖。
fn aui_divider(key: i32) : i32 {
    let i: i32 = push_leaf(40, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.aux = 0;
    n.aux2 = dp2q(1);
    return i;
}

// v1.37：垂直分隔线。1 dp 宽，高度默认 24 dp；默认 align = 3，放进
// 行/流式行里会拉伸到整行高度，放进列里会铺满列宽并在中间画竖线。
fn aui_divider_v(key: i32) : i32 {
    let i: i32 = push_leaf(40, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.aux = 1;
    n.aux2 = dp2q(1);
    n.align = 3;
    return i;
}

// v1.40：顶部应用栏（kind 44，对照 HuxerUI TopAppBar）。容器 + 标题 +
// 可选的自动 leading 图标按钮；后续声明的子项都是右侧动作，按声明顺序
// 从右往左排（action_spacing 默认 0）。高度 48 dp（子项更高时随之增高），
// 左右内边距 8 dp；无 leading 时标题左缩进 16 dp，有 leading 时距它 4 dp。
// 标题单行、垂直居中，超出可用区间时被裁剪（不会盖住 leading/动作）。
// leading 图标的 key 取 -key，回调由 cb/user 提供；icon 传 0 表示没有。
fn aui_top_bar(key: i32, title: ptr, leading_icon: i32,
               cb: fn(ptr) : i32, user: ptr) : i32 {
    let i: i32 = push_container(44, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.text = title;
    n.aux = -1;
    n.aux2 = AUI_TOP_BAR_START;
    if (leading_icon != 0) {
        let lk: i32 = -key;
        if (lk == 0) { lk = -1; }
        let li: i32 = aui_icon_button(lk, leading_icon, 0, 0, cb, user);
        if (li >= 0) {
            let ln: ptr<AuiNode> = node_at(li);
            ln.flags = ln.flags | AUI_TB_LEADING;
        }
        // 自动创建的 leading 不应成为后续修饰器的目标；让 aui_top_bar_align
        // / aui_gap 等继续作用在应用栏本身。
        g_aui_last_created = i;
    }
    return i;
}

// v1.40：标题对齐（0 start / 1 center）。作用于最近创建的顶部应用栏，
// 必须在添加动作子项之前调用（同 aui_flow_align）。
fn aui_top_bar_align(a: i32) : i32 {
    let n: ptr<AuiNode> = modify_target();
    if (n == 0) { return 0; }
    if (n.kind != 44) { return 0; }
    if (a < 0) { a = 0; }
    if (a > 1) { a = 1; }
    n.aux2 = a;
    return 0;
}

// v1.40：底部 1 px 提示线开关。传非 0 显示（文字色 12%），默认隐藏。
fn aui_top_bar_divider(show: i32) : i32 {
    let n: ptr<AuiNode> = modify_target();
    if (n == 0) { return 0; }
    if (n.kind != 44) { return 0; }
    if (show != 0) {
        n.flags = n.flags | AUI_TB_DIVIDER;
    } else if ((n.flags & AUI_TB_DIVIDER) != 0) {
        n.flags = n.flags - AUI_TB_DIVIDER;
    }
    return 0;
}

// v1.41：底部导航栏（对照 HuxerUI NavigationBar）。等宽项的容器，
// selected 是当前下标并夹到 >= 0；cb(user) 只在点到“未选中且启用”的
// 项时调用，回调里用 aui_nav_value(容器 key) 读请求的下标。
fn aui_nav_bar(key: i32, selected: i32, cb: fn(ptr) : i32, user: ptr) : i32 {
    let i: i32 = push_container(45, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.aux = selected;
    if (n.aux < 0) { n.aux = 0; }
    n.cb = cb;
    n.user = user;
    return i;
}

// v1.41：导航项（kind 46）。图标走内置矢量图形，label 是常量字符串；
// flags 仅 AUI_NAV_ITEM_DISABLED 有效。key 必须非 0（用于按压态）。
fn aui_nav_item(key: i32, icon: i32, label: ptr, flags: i32) : i32 {
    let i: i32 = push_leaf(46, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.aux = icon;
    n.text = label;
    n.aux2 = 0;                 // 项下标，arrange 时写入
    n.flags = flags & AUI_NAV_ITEM_DISABLED;
    if (n.parent >= 0) {
        let pn: ptr<AuiNode> = node_at(n.parent);
        n.cb = pn.cb;
        n.user = pn.user;
    }
    return i;
}

// v1.41：是否显示未选中项的文字（默认显示）。作用于最近创建的导航栏，
// 必须在添加 aui_nav_item 之前调用（同 aui_top_bar_align）。
fn aui_nav_labels(show: i32) : i32 {
    let n: ptr<AuiNode> = modify_target();
    if (n == 0) { return 0; }
    if (n.kind != 45) { return 0; }
    if (show == 0) {
        n.flags = n.flags | AUI_NAV_HIDE_UNSELECTED;
    } else if ((n.flags & AUI_NAV_HIDE_UNSELECTED) != 0) {
        n.flags = n.flags - AUI_NAV_HIDE_UNSELECTED;
    }
    return 0;
}

// v1.42：侧边导航栏（对照 HuxerUI NavigationPane）。收缩态 72 dp 只有图标，
// 展开态 256 dp 图标 + 文字；item 是 48 dp 高的等宽行，选中项有指示胶囊。
// selected 由应用控制，回调语义与 aui_nav_bar 相同（共用请求槽）。
fn aui_nav_pane(key: i32, selected: i32, expanded: i32, cb: fn(ptr) : i32, user: ptr) : i32 {
    let i: i32 = push_container(47, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.aux = selected;
    if (n.aux < 0) { n.aux = 0; }
    n.flags = 0;
    if (expanded != 0) { n.flags = AUI_NAV_PANE_EXPANDED; }
    n.cb = cb;
    n.user = user;
    return i;
}

// v1.42：侧边导航项（kind 48）。icon 是内置图形，label 只在展开态绘制；
// flags 仅 AUI_NAV_ITEM_DISABLED 有效。key 必须非 0（用于按压态）。
fn aui_nav_pane_item(key: i32, icon: i32, label: ptr, flags: i32) : i32 {
    let i: i32 = push_leaf(48, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.aux = icon;
    n.text = label;
    n.aux2 = 0;                 // 项下标，arrange 时写入
    n.flags = flags & AUI_NAV_ITEM_DISABLED;
    if (n.parent >= 0) {
        let pn: ptr<AuiNode> = node_at(n.parent);
        n.cb = pn.cb;
        n.user = pn.user;
    }
    return i;
}

// 应用翻转自己的状态后 aui_invalidate()，下一帧就按新状态绘制。
fn aui_switch(key: i32, on: i32, cb: fn(ptr) : i32, user: ptr) : i32 {
    let i: i32 = push_leaf(12, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.aux = 0;
    if (on != 0) { n.aux = 1; }
    n.cb = cb;
    n.user = user;
    return i;
}

// v1.17：进度条（kind 13）。value 是千分比 0..1000，越界自动夹紧。
fn aui_progress(key: i32, value: i32) : i32 {
    let i: i32 = push_leaf(13, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.aux = value;
    if (n.aux < 0) { n.aux = 0; }
    if (n.aux > 1000) { n.aux = 1000; }
    return i;
}

// v1.20：复选框（kind 14）。和开关一样，状态由应用持有：点按只调回调，
// 应用翻转自己的状态并 aui_invalidate()，下一帧按新状态绘制。
// 文字是内联标签（HuxerUI 的 Checkbox 也是 label + 控件一行）；
// aux 是标签长度（-1 = NUL 结尾），aux2 是勾选状态。
fn aui_checkbox(key: i32, text: ptr, checked: i32, cb: fn(ptr) : i32, user: ptr) : i32 {
    let i: i32 = push_leaf(14, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.text = text;
    n.aux = -1;
    n.aux2 = 0;
    if (checked != 0) { n.aux2 = 1; }
    n.cb = cb;
    n.user = user;
    return i;
}

// v1.20：单选框（kind 15）。单选组的互斥由应用维护 —— 回调里把同组其他项
// 置 0，再把自己的状态置 1；库不收集组信息，也不猜。理由同 HuxerUI：
// RadioButton 不拥有组，checked 由调用方控制。
fn aui_radio(key: i32, text: ptr, selected: i32, cb: fn(ptr) : i32, user: ptr) : i32 {
    let i: i32 = push_leaf(15, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.text = text;
    n.aux = -1;
    n.aux2 = 0;
    if (selected != 0) { n.aux2 = 1; }
    n.cb = cb;
    n.user = user;
    return i;
}

// v1.31：标签片（Chip，kind 30）。受控选中：selected != 0 画主色胶囊 +
// on_primary 文字；否则 surface 底 + on_surface 24% 1 dp 描边。点按只调
// cb(user)，应用翻转自己的状态再 aui_invalidate()。
// 尺寸是固有宽（文字 + 左右各 16 dp），高 = max(28 dp, 行高 + 8 dp)；
// 在行里并排，在列里按固有宽左对齐（不会像复选框那样撑满整行）。
fn aui_chip(key: i32, text: ptr, selected: i32, cb: fn(ptr) : i32, user: ptr) : i32 {
    let i: i32 = push_leaf(30, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.text = text;
    n.aux = -1;
    n.aux2 = 0;
    if (selected != 0) { n.aux2 = 1; }
    n.pad = dp2q(16);
    // v2.11：胶囊形状不由固定 14 dp 决定，绘制时取 h/2（见 paint_chip）。
    n.cb = cb;
    n.user = user;
    return i;
}

// v2.10：角标（对照 HuxerUI tree_view 例子里的 Badge：药丸形、文字居中）。
// 模式存 aux2：0 文字 / 1 数量 / 2 圆点；前景色存 flags，背景色存 bg；
// 数量模式的数量值存 gap。文字长度存 aux（-1 = NUL 结尾）。
let AUI_BADGE_RED: u32 = 0xFFE53935;
fn aui_badge(key: i32, text: ptr, fg: u32, bg: u32) : i32 {
    let i: i32 = push_leaf(60, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.text = text;
    n.aux = -1;
    n.aux2 = 0;
    n.bg = bg;
    n.flags = i32(fg);
    return i;
}

// 数量角标：count <= 0 不画（零尺寸）；1..99 显示数字；>= 100 显示 "99+"。
// 白字红底（AUI_BADGE_RED）。纯展示，不接收点击。
fn aui_badge_count(key: i32, count: i32) : i32 {
    let i: i32 = push_leaf(60, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.aux2 = 1;
    n.gap = count;
    n.bg = AUI_BADGE_RED;
    n.flags = i32(0xFFFFFFFF);
    if (count <= 0) {
        n.text = g_aui_null;
        n.aux = 0;
    } else if (count >= 100) {
        n.text = "99+";
        n.aux = 3;
    } else {
        n.text = i32_to_str(count);
        n.aux = -1;
    }
    return i;
}

// 8 dp 实心圆点（颜色自定），放在行尾或图标旁作未读提示。纯展示。
fn aui_badge_dot(key: i32, color: u32) : i32 {
    let i: i32 = push_leaf(60, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.aux2 = 2;
    n.bg = color;
    return i;
}

// ---- 可调分栏（v2.12，对照 HuxerUI SplitLayout）----
// 分隔条可见宽 4 dp，命中宽 24 dp（以条中心为准）。
let AUI_SPLIT_DIV_DP: i32 = 4;
let AUI_SPLIT_HIT_DP: i32 = 24;

// 登记表按 key 查：已有返回槽位；没有且有空槽时新建（ratio 用传入初值，
// min 48 dp）；key 为 0 或满表时返回 -1（匿名分栏/超表分栏只按传入
// ratio 布局，不持久、不回调）。
fn split_slot(key: i32, ratio: i32) : i32 {
    if (key == 0) { return -1; }
    let i: i32 = 0;
    while (i < AUI_SPLIT_CAP) {
        if (g_aui_split_key[i] == key) { return i; }
        i = i + 1;
    }
    let j: i32 = 0;
    while (j < AUI_SPLIT_CAP) {
        if (g_aui_split_key[j] == 0) {
            g_aui_split_key[j] = key;
            g_aui_split_ratio[j] = ratio;
            g_aui_split_min[j] = 48;
            g_aui_split_cb[j] = 0;
            g_aui_split_user[j] = 0;
            return j;
        }
        j = j + 1;
    }
    return -1;
}

// 只读查找（不新建）：measure/arrange/调试接口用。
fn split_find(key: i32) : i32 {
    if (key == 0) { return -1; }
    let i: i32 = 0;
    while (i < AUI_SPLIT_CAP) {
        if (g_aui_split_key[i] == key) { return i; }
        i = i + 1;
    }
    return -1;
}

// 比例夹取 0..1000。
fn split_clamp_ratio(r: i32) : i32 {
    if (r < 0) { return 0; }
    if (r > 1000) { return 1000; }
    return r;
}

// v2.12：可调分栏容器。horizontal != 0 左右排，否则上下排；ratio 是
// 首窗格占比（千分比），只作初值（同 key 再次构建沿用登记表的值，
// 拖动/写接口的结果不被覆盖）。节点 aux 存方向，aux2 存本次构建的
// 比例快照；cb/user 存登记表（不在节点上，分隔条不是点击目标）。
// 建完两个窗格后必须调 aui_end() 闭合（与列表同规则）。
fn aui_split(key: i32, horizontal: i32, ratio: i32,
             cb: fn(ptr) : i32, user: ptr) : i32 {
    let i: i32 = push_container(61, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    let h: i32 = 1;
    if (horizontal == 0) { h = 0; }
    n.aux = h;
    let r: i32 = split_clamp_ratio(ratio);
    let s: i32 = split_slot(key, r);
    if (s >= 0) {
        // 同 key 再次构建：沿用表里的比例（拖动/写接口的结果），不覆盖。
        r = g_aui_split_ratio[s];
        g_aui_split_cb[s] = cb;
        g_aui_split_user[s] = user;
    }
    n.aux2 = r;
    return i;
}

// 修饰器，紧跟 aui_split 调用（在第一个窗格之前）：设最小窗格 dp
// （0..200 夹取）。作用在最近创建的分栏节点上；不是分栏或无登记表
// （匿名分栏）时返回 -1。
fn aui_split_min(dp: i32) : i32 {
    let n: ptr<AuiNode> = modify_target();
    if (n == 0) { return -1; }
    if (n.kind != 61) { return -1; }
    let s: i32 = split_find(n.key);
    if (s < 0) { return -1; }
    let d: i32 = dp;
    if (d < 0) { d = 0; }
    if (d > 200) { d = 200; }
    g_aui_split_min[s] = d;
    return 0;
}

// 读当前比例（登记表值，拖动中读到的是实时值）；找不到返回 -1。
fn aui_split_ratio(key: i32) : i32 {
    let s: i32 = split_find(key);
    if (s < 0) { return -1; }
    return g_aui_split_ratio[s];
}

// 写比例（0..1000 夹取；只写登记表，不调 cb；下次布局生效——
// measure/arrange 直接读登记表，所以只重布局、不必重建）。
fn aui_split_set_ratio(key: i32, ratio: i32) : i32 {
    let s: i32 = split_find(key);
    if (s < 0) { return -1; }
    g_aui_split_ratio[s] = split_clamp_ratio(ratio);
    let r: i32 = aui_invalidate_layout();
    return 0;
}

// 按总长（Q16.16，主轴方向内容宽/高）、比例（千分比）、最小窗格
// （Q16.16）、分隔条宽（Q16.16）算两窗格尺寸（Q16.16），写进 out[0]/out[1]。
// 首窗格夹在 [min, total-div-min]；总长小于 2*min+div 时两窗格均分。
fn split_pane_sizes(total: i32, ratio: i32, minq: i32, divq: i32, out: ptr) : i32 {
    let avail: i32 = total - divq;
    if (avail <= 0) {
        *(out + 0) = 0;
        *(out + 4) = 0;
        return 0;
    }
    let first: i32 = 0;
    let second: i32 = 0;
    if (avail < minq * 2) {
        first = avail / 2;
        second = avail - first;
    } else {
        let raw: i32 = i32((i64(avail) * i64(ratio)) / 1000);
        first = raw;
        if (first < minq) { first = minq; }
        if (first > avail - minq) { first = avail - minq; }
        second = avail - first;
    }
    *(out + 0) = first;
    *(out + 4) = second;
    return 0;
}

// 本次布局的有效比例与最小窗格（登记表优先，匿名分栏用节点快照/默认）。
fn split_layout_params(n: ptr<AuiNode>, out: ptr) : i32 {
    let s: i32 = split_find(n.key);
    let r: i32 = n.aux2;
    let minq: i32 = dp2q(48);
    if (s >= 0) {
        r = g_aui_split_ratio[s];
        minq = dp2q(g_aui_split_min[s]);
    }
    *(out + 0) = r;
    *(out + 4) = minq;
    return 0;
}

fn measure_split(n: ptr<AuiNode>, avail: i32) : i32 {
    let c1: i32 = n.first_child;
    let c2: i32 = -1;
    if (c1 >= 0) { c2 = node_at(c1).next_sibling; }
    let inner: i32 = avail - n.pad * 2;
    if (inner < 0) { inner = 0; }
    if (c1 < 0) {
        n.w = avail;
        n.h = n.pad * 2;
        return n.h;
    }
    if (c2 < 0) {
        // 只有一个窗格：铺满，无分隔条。
        let h1: i32 = measure(c1, inner);
        n.w = avail;
        n.h = h1 + n.pad * 2;
        return n.h;
    }
    let prm: i32[2] = 0;
    let lp: i32 = split_layout_params(n, prm);
    let divq: i32 = dp2q(AUI_SPLIT_DIV_DP);
    if (n.aux == 1) {
        // 横向：宽由父级给，按比例分；高 = 两窗格内容高取大。
        let sz: i32[2] = 0;
        let ps: i32 = split_pane_sizes(inner, prm[0], prm[1], divq, sz);
        let h1: i32 = measure(c1, sz[0]);
        let h2: i32 = measure(c2, sz[1]);
        let h: i32 = h1;
        if (h2 > h) { h = h2; }
        n.w = avail;
        n.h = h + n.pad * 2;
        return n.h;
    }
    // 纵向：宽由父级给；高 = 两窗格内容高之和 + 分隔条（比例只分已给的
    // 高，量高时按内容和——与列容器同规则；父级给权重时 arrange 再按
    // 比例分）。
    let h1: i32 = measure(c1, inner);
    let h2: i32 = measure(c2, inner);
    n.w = avail;
    n.h = h1 + h2 + divq + n.pad * 2;
    return n.h;
}

fn arrange_split(n: ptr<AuiNode>) : i32 {
    let c1: i32 = n.first_child;
    let c2: i32 = -1;
    if (c1 >= 0) { c2 = node_at(c1).next_sibling; }
    let ix: i32 = n.x + n.pad;
    let iy: i32 = n.y + n.pad;
    let iw: i32 = n.w - n.pad * 2;
    let ih: i32 = n.h - n.pad * 2;
    if (iw < 0) { iw = 0; }
    if (ih < 0) { ih = 0; }
    if (c1 < 0) { return 0; }
    if (c2 < 0) {
        let a1: i32 = arrange(c1, ix, iy, iw, ih);
        return 0;
    }
    let prm: i32[2] = 0;
    let lp: i32 = split_layout_params(n, prm);
    let divq: i32 = dp2q(AUI_SPLIT_DIV_DP);
    if (n.aux == 1) {
        let sz: i32[2] = 0;
        let ps: i32 = split_pane_sizes(iw, prm[0], prm[1], divq, sz);
        let a1: i32 = arrange(c1, ix, iy, sz[0], ih);
        let a2: i32 = arrange(c2, ix + sz[0] + divq, iy, sz[1], ih);
        return 0;
    }
    let sz: i32[2] = 0;
    let ps: i32 = split_pane_sizes(ih, prm[0], prm[1], divq, sz);
    let a1: i32 = arrange(c1, ix, iy, iw, sz[0]);
    let a2: i32 = arrange(c2, ix, iy + sz[0] + divq, iw, sz[1]);
    return 0;
}

// v2.12：分栏分隔条。两个窗格时在窗格之间画 4 dp 竖/横条（文字色 12%，
// 与 aui_divider 同色）；少于两个窗格时不画。
fn paint_split_divider(n: ptr<AuiNode>) : i32 {
    let c1: i32 = n.first_child;
    if (c1 < 0) { return 0; }
    let c2: i32 = node_at(c1).next_sibling;
    if (c2 < 0) { return 0; }
    let t: i32 = i32(theme_text());
    let col: i32 = (31 << 24) | (t & 0x00FFFFFF);
    let divq: i32 = dp2q(AUI_SPLIT_DIV_DP);
    let n1: ptr<AuiNode> = node_at(c1);
    if (n.aux == 1) {
        let x: i32 = n1.x + n1.w;
        let lh: i32 = n.h - n.pad * 2;
        if (lh > 0) {
            let rv: i32 = cmd_add(1, x, n.y + n.pad, divq, lh, col, 0, g_aui_null, 0, 0);
        }
        return 0;
    }
    let y: i32 = n1.y + n1.h;
    let lw: i32 = n.w - n.pad * 2;
    if (lw > 0) {
        let rv: i32 = cmd_add(1, n.x + n.pad, y, lw, divq, col, 0, g_aui_null, 0, 0);
    }
    return 0;
}

// v1.32：环形进度（kind 31，对照 HuxerUI ProgressCircle）。value 是千分比
// 0..1000，负数表示不确定进度；size 是直径 dp（0 = 24）。描边和半径在
// 绘制时按尺寸推出来，节点只存 value（aux）和直径 dp（aux2）。不接收
// 点击，选中/按下态都不参与。
fn aui_progress_circle(key: i32, value: i32, size: i32) : i32 {
    let i: i32 = push_leaf(31, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.aux = value;
    if (n.aux > 1000) { n.aux = 1000; }
    let sdp: i32 = size;
    if (sdp <= 0) { sdp = 24; }
    if (sdp < 8) { sdp = 8; }
    if (sdp > 240) { sdp = 240; }
    n.aux2 = sdp;
    if (n.aux < 0) { g_aui_spin_live = g_aui_spin_live + 1; }
    return i;
}

// v1.33：树视图（对照 HuxerUI TreeView / TreeViewStyle）。容器 kind 32
// 是固定行高的纵向滚动区（行为与 aui_scroll 相同：拖动、fling、滚动条、
// 裁剪），行 kind 33 由应用按可见顺序逐个声明 —— 与 Chip/Switch 一样
// 是受控组件：展开/选中状态都在应用侧，点按行只调 cb(user)，应用改完
// 自己的状态再 aui_invalidate()。
let AUI_TREE_BRANCH: i32 = 1;      // 有子节点（可展开）
let AUI_TREE_EXPANDED: i32 = 2;    // 已展开（画下指三角）
let AUI_TREE_SELECTED: i32 = 4;    // 选中（14% 主色底）
let AUI_TREE_DISABLED: i32 = 8;    // 禁用（38% 文字、不派发点击）

// 行高 32 dp（HuxerUI item_extent）；索引缩进 20 dp、指示槽 24 dp、
// 左右内边距 8 dp（与 TreeViewStyle 的 indentation / indicator_size /
// item_padding 一致）。
fn aui_tree(key: i32) : i32 {
    let i: i32 = push_container(32, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.aux2 = dp2q(32);
    return i;
}

fn aui_tree_item(key: i32, text: ptr, depth: i32, flags: i32,
                 cb: fn(ptr) : i32, user: ptr) : i32 {
    let i: i32 = push_leaf(33, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    let d: i32 = depth;
    if (d < 0) { d = 0; }
    if (d > 32) { d = 32; }
    n.aux2 = d;
    n.gap = flags;
    n.text = text;
    n.aux = -1;
    n.cb = cb;
    n.user = user;
    if ((flags & AUI_TREE_DISABLED) != 0) { n.cb = 0; }
    return i;
}

// ---- Toast / SnackBar（v1.34）----
// 对照 HuxerUI presentation.h：Toast 是被动反馈（pointer pass-through，
// 多个并存），SnackBar 是窗口内唯一、带一个动作按钮的提示（内容层拦截
// 触摸）。二者都不进节点树：记录放在固定池里，布局与绘制是根树之后的
// 独立浮层，不参与页面/滚动/对话框布局。文本指针需在显示期间有效。
let AUI_TOAST_CAP: i32 = 4;
let g_aui_toast_on: i32[4] = 0;
let g_aui_toast_id: i32[4] = 0;
let g_aui_toast_text: ptr[4] = 0;
let g_aui_toast_start: i64[4] = 0;
let g_aui_toast_dur: i64[4] = 0;              // ns；< 0 = 常驻
let g_aui_toast_x: i32[4] = 0;                // Q16.16
let g_aui_toast_y: i32[4] = 0;
let g_aui_toast_w: i32[4] = 0;
let g_aui_toast_h: i32[4] = 0;
let g_aui_toast_seq: i32 = 0;

let g_aui_snack_on: i32 = 0;
let g_aui_snack_id: i32 = 0;
let g_aui_snack_seq: i32 = 0;
let g_aui_snack_key: i32 = 0;
let g_aui_snack_text: ptr = 0;
let g_aui_snack_action: ptr = 0;
let g_aui_snack_cb: fn(ptr) : i32;
let g_aui_snack_user: ptr = 0;
let g_aui_snack_rem: i64 = 0;                 // 剩余可见时间；< 0 = 常驻
let g_aui_snack_last: i64 = 0;
let g_aui_snack_paused: i32 = 0;              // 动作按钮按住期间暂停倒计时
let g_aui_snack_press: i32 = 0;
let g_aui_snack_down: i32 = 0;                // 0 无 / 1 表面 / 2 动作按钮
let g_aui_snack_dx: i32 = 0;
let g_aui_snack_dy: i32 = 0;
let g_aui_snack_x: i32 = 0;                   // Q16.16
let g_aui_snack_y: i32 = 0;
let g_aui_snack_w: i32 = 0;
let g_aui_snack_h: i32 = 0;
let g_aui_snack_ax: i32 = 0;                  // 动作按钮矩形
let g_aui_snack_ay: i32 = 0;
let g_aui_snack_aw: i32 = 0;
let g_aui_snack_ah: i32 = 0;
let g_aui_present_idx: i32[4] = 0;            // 布局临时：按 id 升序
let g_aui_present_clip: i32[4] = 0;           // 绘制临时：提示层裁剪

fn present_in(x: i32, y: i32, w: i32, h: i32, px: i32, py: i32) : i32 {
    if (w <= 0 || h <= 0) { return 0; }
    let qx: i32 = px << 16;
    let qy: i32 = py << 16;
    if (qx < x || qy < y) { return 0; }
    if (qx >= x + w || qy >= y + h) { return 0; }
    return 1;
}

fn aui_toast(text: ptr, duration_ms: i32) : i32 {
    if (text == 0) { return 0; }
    if (str_len(text) <= 0) { return 0; }
    let slot: i32 = -1;
    let i: i32 = 0;
    while (i < AUI_TOAST_CAP) {
        if (g_aui_toast_on[i] == 0) { slot = i; break; }
        i = i + 1;
    }
    if (slot < 0) {
        // 池满：最老的提示先让位（HuxerUI 的 Toast 各自独立，但这里
        // 固定池只保留最近 4 条）。
        slot = 0;
        let old: i32 = g_aui_toast_id[0];
        i = 1;
        while (i < AUI_TOAST_CAP) {
            if (g_aui_toast_id[i] < old) {
                old = g_aui_toast_id[i];
                slot = i;
            }
            i = i + 1;
        }
    }
    g_aui_toast_seq = g_aui_toast_seq + 1;
    if (g_aui_toast_seq <= 0) { g_aui_toast_seq = 1; }
    let dur: i64 = 2000000000;
    if (duration_ms < 0) { dur = -1; }
    else if (duration_ms > 0) { dur = i64(duration_ms) * 1000000; }
    g_aui_toast_on[slot] = 1;
    g_aui_toast_id[slot] = g_aui_toast_seq;
    g_aui_toast_text[slot] = text;
    g_aui_toast_start[slot] = anim_now();
    g_aui_toast_dur[slot] = dur;
    g_aui_need_layout = 1;
    g_aui_need_paint = 1;
    g_aui_pump_need = 1;
    let w: i32 = pump_wake();
    return g_aui_toast_seq;
}

fn aui_toast_dismiss(handle: i32) : i32 {
    if (handle <= 0) { return 0; }
    let i: i32 = 0;
    while (i < AUI_TOAST_CAP) {
        if (g_aui_toast_on[i] != 0 && g_aui_toast_id[i] == handle) {
            g_aui_toast_on[i] = 0;
            g_aui_toast_text[i] = 0;
            g_aui_need_paint = 1;
            g_aui_pump_need = 1;
            let w: i32 = pump_wake();
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn aui_snackbar(key: i32, text: ptr, action: ptr, duration_ms: i32,
                cb: fn(ptr) : i32, user: ptr) : i32 {
    if (text == 0 || str_len(text) <= 0) { return 0; }
    let act: ptr = action;
    if (act != 0 && str_len(act) <= 0) { act = 0; }
    if (act != 0 && cb == 0) { act = 0; }
    g_aui_snack_seq = g_aui_snack_seq + 1;
    if (g_aui_snack_seq <= 0) { g_aui_snack_seq = 1; }
    let rem: i64 = 4000000000;
    if (duration_ms < 0) { rem = -1; }
    else if (duration_ms > 0) { rem = i64(duration_ms) * 1000000; }
    let now: i64 = anim_now();
    g_aui_snack_on = 1;
    g_aui_snack_id = g_aui_snack_seq;
    g_aui_snack_key = key;
    g_aui_snack_text = text;
    g_aui_snack_action = act;
    g_aui_snack_cb = cb;
    g_aui_snack_user = user;
    g_aui_snack_rem = rem;
    g_aui_snack_last = now;
    g_aui_snack_paused = 0;
    g_aui_snack_press = 0;
    g_aui_snack_down = 0;
    g_aui_need_layout = 1;
    g_aui_need_paint = 1;
    g_aui_pump_need = 1;
    let w: i32 = pump_wake();
    return g_aui_snack_seq;
}

fn aui_snackbar_dismiss() : i32 {
    if (g_aui_snack_on == 0) { return 0; }
    g_aui_snack_on = 0;
    g_aui_snack_text = 0;
    g_aui_snack_action = 0;
    g_aui_snack_cb = 0;
    g_aui_snack_user = 0;
    g_aui_snack_press = 0;
    g_aui_snack_down = 0;
    g_aui_snack_paused = 0;
    g_aui_need_paint = 1;
    g_aui_pump_need = 1;
    let w: i32 = pump_wake();
    return 1;
}

// v1.20：滑块（kind 16）。value / step 都是千分比（0..1000），step 是吸附步长。
// 手势期间库把实时值放在全局里，回调可以用 aui_slider_value(key) 读到；
// 应用在回调里保存值并 aui_invalidate()，下一帧 build 传入新值即可。
// 应用不保存也能用：松手后库不再保留实时值，滑块回到 build 时的值。
fn aui_slider(key: i32, value: i32, step: i32, cb: fn(ptr) : i32, user: ptr) : i32 {
    let i: i32 = push_leaf(16, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.aux = value;
    if (n.aux < 0) { n.aux = 0; }
    if (n.aux > 1000) { n.aux = 1000; }
    n.aux2 = step;
    if (n.aux2 < 1) { n.aux2 = 1; }
    if (n.aux2 > 1000) { n.aux2 = 1000; }
    n.cb = cb;
    n.user = user;
    return i;
}

// v1.21：分段控件容器（kind 17，对照 HuxerUI 的 SegmentedButton）。
// 子节点必须是 aui_segment（kind 18），宽度在 arrange 阶段均分；
// selected 是当前选中段下标（0 起，越界在绘制时自然不匹配）。
// 背景固定 SURFACE + 8 dp 圆角 + 1 dp HINT 边框（HuxerUI 默认样式）。
fn aui_segmented(key: i32, selected: i32, cb: fn(ptr) : i32, user: ptr) : i32 {
    let i: i32 = push_container(17, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.aux = selected;
    if (n.aux < 0) { n.aux = 0; }
    n.bg = theme_surface();
    n.radius = shape_q(AUI_SHAPE_SMALL);
    n.cb = cb;
    n.user = user;
    return i;
}

// v1.21：分段控件里的一段（kind 18）。key 用于按压态与命中，必须非 0；
// 回调与 user 直接从父容器复制，点按走通用的 clickable 路径。
fn aui_segment(key: i32, text: ptr) : i32 {
    let i: i32 = push_leaf(18, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.text = text;
    n.aux = -1;                 // 标签长度
    n.aux2 = 0;                 // 下标，arrange 时写入
    if (n.parent >= 0) {
        let pn: ptr<AuiNode> = node_at(n.parent);
        n.cb = pn.cb;
        n.user = pn.user;
    }
    return i;
}

// v1.22：标签页容器（kind 19，对照 HuxerUI Tabs / TabsStyle）。
// 子节点必须是 aui_tab（kind 20），按固有宽度从左到右排；
// selected 是当前页下标（0 起，越界自然没有指示条）。
// 默认背景透明、无分隔线，选中页文字 PRIMARY，底部 2 dp 指示条。
fn aui_tabs(key: i32, selected: i32, cb: fn(ptr) : i32, user: ptr) : i32 {
    let i: i32 = push_container(19, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.aux = selected;
    if (n.aux < 0) { n.aux = 0; }
    n.cb = cb;
    n.user = user;
    return i;
}

// v1.22：标签页里的一页（kind 20）。左右各 12 dp 内边距、最少 48 dp 宽、
// 36 dp 高；回调与 user 从容器复制，点按走通用 clickable 路径。
fn aui_tab(key: i32, text: ptr) : i32 {
    let i: i32 = push_leaf(20, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.text = text;
    n.aux = -1;                 // 标签长度
    n.aux2 = 0;                 // 页下标，arrange 时写入
    n.pad = dp2q(12);           // 文字左边距（HuxerUI item_padding 12x8）
    if (n.parent >= 0) {
        let pn: ptr<AuiNode> = node_at(n.parent);
        n.cb = pn.cb;
        n.user = pn.user;
    }
    return i;
}

// v1.24：分页容器（kind 21，对照 HuxerUI Pager）。
// 子节点必须是 aui_page（kind 22），每页占满视口、横向排开并裁剪。
// selected 是当前页下标（0 起，越界夹紧）；左右拖动超过 8 dp 且横向
// 占优时接管手势，松手按位移（>= 35% 页宽）或速度（>= 600 px/s）
// 提议相邻页，只调 cb(user)。回调里用 aui_pager_value(容器 key) 读目标页。
fn aui_pager(key: i32, selected: i32, cb: fn(ptr) : i32, user: ptr) : i32 {
    let i: i32 = push_container(21, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.aux = selected;
    if (n.aux < 0) { n.aux = 0; }
    n.cb = cb;
    n.user = user;
    return i;
}

// v1.24：一页（kind 22）。本身是列容器（子项自上而下），默认无内边距；
// 背景/圆角/内边距都可用常规修饰器设置。每页宽度 = 分页视口宽度。
fn aui_page(key: i32) : i32 {
    let i: i32 = push_container(22, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.aux2 = 0;                 // 页下标，arrange 时写入
    return i;
}

// 点卡片空白处时吞掉点击：不能让事件冒泡到遮罩的关闭回调。
fn dialog_noop(user: ptr) : i32 { return 0; }

// v1.25：模态对话框（对照 HuxerUI Dialog）。
// 只在 open != 0 时调用；返回卡片节点，后续子项都放进卡片。
// 卡片不挂进根树，布局/绘制/命中都在根之后单独处理，因此不会影响
// 页面、滚动或分页。cb 在点遮罩或按 BACK 时调用，用
// aui_dialog_reason() 区分（1 遮罩 / 2 BACK），应用在回调里把 open 置 0。
// 只支持同时一层；key 必须 > 0（卡片用 key，遮罩用 -key）。
fn aui_dialog(key: i32, open: i32, cb: fn(ptr) : i32, user: ptr) : i32 {
    if (key <= 0 || open == 0) { return -1; }
    if (g_aui_dialog >= 0 || g_aui_sheet >= 0 || g_aui_popup >= 0 ||
        g_aui_combo_open >= 0) { return -1; }
    let d: i32 = node_alloc(23, 0 - key);
    if (d < 0) { return -1; }
    let c: i32 = node_alloc(24, key);
    if (c < 0) { return -1; }
    let dn: ptr<AuiNode> = node_at(d);
    dn.cb = cb;
    dn.user = user;
    dn.first_child = c;
    let cn: ptr<AuiNode> = node_at(c);
    cn.parent = d;
    cn.pad = dp2q(24);
    cn.gap = dp2q(12);
    cn.radius = shape_q(AUI_SHAPE_SMALL);        // v2.11：对话卡片 16 -> 8 dp
    cn.cb = dialog_noop;        // 卡片空白不关闭；按钮自己优先命中
    g_aui_dialog = d;
    g_aui_dialog_card = c;
    g_aui_dialog_reason = 0;
    // v1.27：模态层打开时收起残留的工具提示。
    let th: i32 = tip_dismiss();
    if (g_aui_depth < AUI_STACK_MAX) {
        g_aui_depth = g_aui_depth + 1;
        g_aui_stk_parent[g_aui_depth] = c;
        g_aui_stk_last[g_aui_depth] = -1;
    }
    g_aui_last_created = c;
    return c;
}

fn sheet_noop(user: ptr) : i32 { return 0; }

// v1.38：模态底部弹出层（对照 HuxerUI BottomSheet）。
// 只在 open != 0 时调用，返回表面节点（kind 42），后续子项都放进表面。
// 表面贴内容区底部、水平居中：宽度 = 内容区宽 - 32 dp，最大 640 dp；
// 高度取内容并夹到内容区 85%，超高部分裁剪。默认画 32x4 dp 拖拽把手，
// 顶部 32 dp 是拖拽区；向下拖过 1/4 高度（至少 96 dp）关闭。
// cb 在点遮罩、按 BACK 或拖拽关闭时调用，用 aui_sheet_reason() 区分
// （1 遮罩 / 2 BACK / 3 下拉）。同时只允许一层；key 必须 > 0。
// 与对话框互斥：已有对话框时返回 -1。
fn aui_sheet(key: i32, open: i32, cb: fn(ptr) : i32, user: ptr) : i32 {
    if (key <= 0 || open == 0) { return -1; }
    if (g_aui_sheet >= 0 || g_aui_dialog >= 0 || g_aui_popup >= 0 ||
        g_aui_combo_open >= 0) { return -1; }
    let d: i32 = node_alloc(41, 0 - key);
    if (d < 0) { return -1; }
    let c: i32 = node_alloc(42, key);
    if (c < 0) { return -1; }
    let dn: ptr<AuiNode> = node_at(d);
    dn.cb = cb;
    dn.user = user;
    dn.first_child = c;
    let cn: ptr<AuiNode> = node_at(c);
    cn.parent = d;
    cn.pad = dp2q(20);
    cn.gap = dp2q(12);
    cn.radius = shape_q(AUI_SHAPE_SMALL);        // v2.11：底部弹出层 14 -> 8 dp
    cn.cb = sheet_noop;         // 表面空白不关闭；子控件自己优先命中
    g_aui_sheet = d;
    g_aui_sheet_card = c;
    g_aui_sheet_reason = 0;
    if (g_aui_sheet_had == 0) {
        // 新打开：重置拖拽状态并安排滑入动画（高度在布局阶段才知道）。
        g_aui_sheet_drag = -1;
        g_aui_sheet_anim = 1;
        g_aui_sheet_until = 0;
    }
    // 模态层打开时收起残留的工具提示。
    let th: i32 = tip_dismiss();
    if (g_aui_depth < AUI_STACK_MAX) {
        g_aui_depth = g_aui_depth + 1;
        g_aui_stk_parent[g_aui_depth] = c;
        g_aui_stk_last[g_aui_depth] = -1;
    }
    g_aui_last_created = c;
    return c;
}

// v1.38：显示/隐藏拖拽把手（0 隐藏）。作用在刚创建的表面上。
fn aui_sheet_handle(show: i32) : i32 {
    let n: ptr<AuiNode> = modify_target();
    if (n == 0) { return 0; }
    if (n.kind != 42) { return 0; }
    if (show != 0) { n.flags = n.flags & (0 - 2); }
    else { n.flags = n.flags | 1; }
    return 0;
}

// v1.26：下拉选择（对照 HuxerUI Select）。触发器是普通布局里的容器，
// 选项始终作为子节点声明；只有 open != 0 时选项才在锚定浮层里布局。
// 展开时命中整体重定向：点选项回调 reason=1，点触发器/外部 reason=2
// （应用关闭），BACK reason=3；关闭状态点触发器 reason=0（应用展开）。
// 回调里用 aui_select_value(容器 key) 读刚点中的选项下标。
fn aui_select(key: i32, selected: i32, open: i32,
              placeholder: ptr, cb: fn(ptr) : i32, user: ptr) : i32 {
    let i: i32 = push_container(25, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.aux = selected;
    n.aux2 = 0;
    n.text = placeholder;
    n.radius = shape_q(AUI_SHAPE_SMALL);         // v2.11：下拉触发 10 -> 8 dp
    n.cb = cb;
    n.user = user;
    if (open != 0) {
        n.aux2 = 1;
        // v1.27：展开下拉时收起残留的工具提示。
        let th: i32 = tip_dismiss();
        // 同一时刻只展开一个：后声明的 open 选择器不再抢浮层。
        if (g_aui_select_open < 0 && g_aui_combo_open < 0) { g_aui_select_open = i; }
    }
    return i;
}

// v1.26：下拉里的一项。选项不单独回调，点中后统一走 select 的 cb。
fn aui_option(key: i32, text: ptr) : i32 {
    let i: i32 = push_leaf(26, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.text = text;
    n.aux = -1;
    return i;
}

fn select_opt_count(n: ptr<AuiNode>) : i32 {
    let cnt: i32 = 0;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        cnt = cnt + 1;
        c = cn.next_sibling;
    }
    return cnt;
}

fn select_opt_at(n: ptr<AuiNode>, idx: i32) : i32 {
    if (idx < 0) { return -1; }
    let k: i32 = 0;
    let c: i32 = n.first_child;
    while (c >= 0) {
        if (k == idx) { return c; }
        let cn: ptr<AuiNode> = node_at(c);
        k = k + 1;
        c = cn.next_sibling;
    }
    return -1;
}

fn aui_select_value(key: i32) : i32 {
    if (g_aui_select_key == key) { return g_aui_select_val; }
    let i: i32 = 0;
    while (i < g_aui_node_count) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.kind == 25 && n.key == key) { return n.aux; }
        i = i + 1;
    }
    return -1;
}

fn aui_select_reason() : i32 { return g_aui_select_reason; }

// v1.44：可编辑组合框（对照 HuxerUI ComboBox）。触发器是普通布局里的
// 容器（kind 49），文本存在按键文本池里（key 与触发器相同，所以
// aui_text_set / append / backspace / value 都能直接用）；hint 是空文本
// 时的占位符。open != 0 时把子建议项（aui_combo_suggestion）摆进锚定
// 浮层，其它时候它们不参与布局。
// 点击触发器：聚焦并回调 reason=0，应用负责把 open 置 1；展开时再点
// 触发器或点外部：reason=2，应用把 open 置 0；点建议项：reason=1，
// 回调里用 aui_combo_value(容器 key) 读下标；BACK：reason=3。
// 建议项由应用过滤后声明（库不做匹配）；展开期间是半模态，键盘键仍可点。
fn aui_combo(key: i32, hint: ptr, open: i32,
             cb: fn(ptr) : i32, user: ptr) : i32 {
    if (key <= 0) { return -1; }
    let i: i32 = push_container(49, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.text = hint;
    n.pad = dp2q(12);
    n.radius = shape_q(AUI_SHAPE_SMALL);         // v2.11：组合框触发 10 -> 8 dp
    n.aux = -1;
    n.aux2 = 0;
    n.cb = cb;
    n.user = user;
    if (open != 0) {
        let th: i32 = tip_dismiss();
        // 同一时刻只展开一个浮层：对话框/菜单/下拉/浮层/底部弹层优先。
        if (g_aui_combo_open < 0 &&
            g_aui_dialog < 0 && g_aui_sheet < 0 && g_aui_menu < 0 &&
            g_aui_select_open < 0 && g_aui_popup < 0) {
            n.aux2 = 1;
            g_aui_combo_open = i;
        }
    }
    return i;
}

// v1.44：组合框的一条建议。key 用于调试定位；下标由布局顺序决定。
fn aui_combo_suggestion(key: i32, text: ptr) : i32 {
    let i: i32 = push_leaf(50, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.text = text;
    n.aux = -1;
    n.aux2 = 0;
    return i;
}

fn combo_sug_count(n: ptr<AuiNode>) : i32 {
    let cnt: i32 = 0;
    let c: i32 = n.first_child;
    while (c >= 0) {
        cnt = cnt + 1;
        let cn: ptr<AuiNode> = node_at(c);
        c = cn.next_sibling;
    }
    return cnt;
}

fn combo_sug_at(n: ptr<AuiNode>, idx: i32) : i32 {
    if (idx < 0) { return -1; }
    let k: i32 = 0;
    let c: i32 = n.first_child;
    while (c >= 0) {
        if (k == idx) { return c; }
        let cn: ptr<AuiNode> = node_at(c);
        k = k + 1;
        c = cn.next_sibling;
    }
    return -1;
}

fn aui_combo_value(key: i32) : i32 {
    if (g_aui_combo_key == key) { return g_aui_combo_val; }
    return -1;
}

fn aui_combo_reason() : i32 { return g_aui_combo_reason; }

// v1.44：最近一次点中的建议 key（应用声明建议时传入的 key）。建议列表被
// 应用按前缀过滤后，下标不再是全量列表的位置，用 key 映射选项更稳。
fn aui_combo_pick_key() : i32 { return g_aui_combo_pick; }

// ===========================================================================
// 4.0 菜单（v1.35，对照 HuxerUI Menu）
// ===========================================================================

// 打开一层菜单浮层。at = 0 时锚在 anchor_key 对应节点，at = 1 时用
// px/py 作为菜单左上角（Q16.16）。菜单不挂根树，条目仍按构建顺序
// 追加到它的子节点里；返回菜单节点。
fn menu_open(key: i32, anchor_key: i32, at: i32, px: i32, py: i32,
             cb: fn(ptr) : i32, user: ptr) : i32 {
    if (key <= 0) { return -1; }
    if (g_aui_menu >= 0) { return -1; }
    // 对话框/下拉是更底层的模态层，同时存在时不创建菜单。
    if (g_aui_dialog >= 0 || g_aui_select_open >= 0 || g_aui_popup >= 0 ||
        g_aui_combo_open >= 0) { return -1; }
    let m: i32 = node_alloc(34, key);
    if (m < 0) { return -1; }
    let mn: ptr<AuiNode> = node_at(m);
    mn.pad = dp2q(4);            // HuxerUI content_padding 4
    mn.radius = shape_q(AUI_SHAPE_SMALL);
    mn.aux = anchor_key;
    mn.aux2 = at;
    mn.cb = cb;
    mn.user = user;
    g_aui_menu = m;
    g_aui_menu_key = key;
    g_aui_menu_anchor = anchor_key;
    g_aui_menu_reason = 0;
    g_aui_menu_item_key = 0;
    g_aui_menu_items = 0;
    // v1.35：按压/拖动/滚动属于输入状态。持续打开时重建（DOWN 触发的
    // pump 会重建整棵树）必须保留，否则刚按下的条目会被 next 帧抹掉；
    // 只有真正新开一层菜单才清空。
    if (g_aui_menu_had == 0) {
        g_aui_menu_press = -1;
        g_aui_menu_down = -3;
        g_aui_menu_drag = 0;
        g_aui_menu_off = 0;
    }
    if (at != 0) {
        g_aui_menu_at_x = px;
        g_aui_menu_at_y = py;
    }
    let th: i32 = tip_dismiss();
    if (g_aui_depth < AUI_STACK_MAX) {
        g_aui_depth = g_aui_depth + 1;
        g_aui_stk_parent[g_aui_depth] = m;
        g_aui_stk_last[g_aui_depth] = -1;
    }
    g_aui_last_created = m;
    return m;
}

// v1.35：菜单。open != 0 时创建，cb 在关闭时调用（reason 见 aui_menu_reason：
// 1 点中条目 / 2 点外部 / 3 BACK）。点中条目时先关闭菜单、先调这里的 cb，
// 再调条目自己的 cb；应用可在 cb 里把 open 置 0 并 aui_invalidate()。
fn aui_menu(key: i32, anchor_key: i32, open: i32,
            cb: fn(ptr) : i32, user: ptr) : i32 {
    if (open == 0) { return -1; }
    return menu_open(key, anchor_key, 0, 0, 0, cb, user);
}

// v1.35：以屏幕点（像素）为菜单左上角的变体。
fn aui_menu_at(key: i32, px: i32, py: i32, open: i32,
               cb: fn(ptr) : i32, user: ptr) : i32 {
    if (open == 0) { return -1; }
    return menu_open(key, 0, 1, px << 16, py << 16, cb, user);
}

// v1.35：菜单条目。flags 取 AUI_MENU_CHECKED / AUI_MENU_DISABLED；
// key 只用于调试/回读，同一菜单内建议唯一。
fn aui_menu_item(key: i32, text: ptr, flags: i32,
                 cb: fn(ptr) : i32, user: ptr) : i32 {
    if (g_aui_menu < 0) { return -1; }
    let i: i32 = push_leaf(35, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.flags = flags;
    n.text = text;
    n.cb = cb;
    n.user = user;
    n.aux2 = g_aui_menu_items;   // 条目下标（分隔线不占）
    n.pad = dp2q(12);            // HuxerUI item_padding 12/8
    n.gap = dp2q(8);             // 图标/文字间距
    g_aui_menu_items = g_aui_menu_items + 1;
    return i;
}

// v1.35：菜单分隔线（HuxerUI MenuSection，BetweenItems 模式）。
fn aui_menu_separator(key: i32) : i32 {
    if (g_aui_menu < 0) { return -1; }
    let i: i32 = push_leaf(36, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.aux2 = -1;
    return i;
}

fn aui_menu_reason() : i32 { return g_aui_menu_reason; }

// v1.35：最近一次点中条目的 key（关闭后仍保留到下一次打开）。
fn aui_menu_item_key() : i32 { return g_aui_menu_item_key; }

// v1.35：编程关闭菜单（等同点外部，reason = 2，走菜单 cb）。
fn aui_menu_dismiss() : i32 {
    if (g_aui_menu < 0) { return 0; }
    let r: i32 = menu_close(2);
    return 1;
}

// ===========================================================================
// 4.0b 锚定浮层（v1.39，对照 HuxerUI Popup）
// ===========================================================================

fn popup_open(key: i32, anchor_key: i32, at: i32, px: i32, py: i32,
              cb: fn(ptr) : i32, user: ptr) : i32 {
    if (key <= 0) { return -1; }
    if (g_aui_popup >= 0) { return -1; }
    if (g_aui_dialog >= 0 || g_aui_sheet >= 0 ||
        g_aui_menu >= 0 || g_aui_select_open >= 0 ||
        g_aui_combo_open >= 0) { return -1; }
    let m: i32 = node_alloc(43, key);
    if (m < 0) { return -1; }
    let mn: ptr<AuiNode> = node_at(m);
    mn.pad = dp2q(16);
    mn.gap = dp2q(12);
    mn.radius = shape_q(AUI_SHAPE_SMALL);        // v2.11：弹出菜单 12 -> 8 dp
    mn.aux = anchor_key;
    mn.aux2 = at;
    mn.cb = cb;
    mn.user = user;
    g_aui_popup = m;
    g_aui_popup_key = key;
    g_aui_popup_anchor = anchor_key;
    g_aui_popup_reason = 0;
    g_aui_popup_side = 0;
    g_aui_popup_align = 0;
    g_aui_popup_fixed = 0;
    g_aui_popup_at = at;
    if (at != 0) {
        g_aui_popup_ax = px;
        g_aui_popup_ay = py;
    }
    if (g_aui_popup_had == 0) {
        g_aui_popup_down = -3;
        g_aui_popup_px = 0;
        g_aui_popup_py = 0;
        g_aui_popup_pw = 0;
        g_aui_popup_ph = 0;
    }
    let th: i32 = tip_dismiss();
    if (g_aui_depth < AUI_STACK_MAX) {
        g_aui_depth = g_aui_depth + 1;
        g_aui_stk_parent[g_aui_depth] = m;
        g_aui_stk_last[g_aui_depth] = -1;
    }
    g_aui_last_created = m;
    return m;
}

// v1.39：任意内容的锚定浮层。open != 0 时创建，返回浮层节点；子项放进
// 浮层、用 aui_end() 收尾。cb 在关闭时调用，用 aui_popup_reason() 读原因
// （1 点外部 / 2 BACK / 3 aui_popup_dismiss）。只支持一层，且与
// dialog / sheet / menu / select 互斥；key 必须 > 0。
fn aui_popup(key: i32, anchor_key: i32, open: i32,
             cb: fn(ptr) : i32, user: ptr) : i32 {
    if (open == 0) { return -1; }
    return popup_open(key, anchor_key, 0, 0, 0, cb, user);
}

// v1.39：以屏幕点（像素）为锚点的变体；浮层默认在该点下方、左对齐。
fn aui_popup_at(key: i32, px: i32, py: i32, open: i32,
                cb: fn(ptr) : i32, user: ptr) : i32 {
    if (open == 0) { return -1; }
    return popup_open(key, 0, 1, px << 16, py << 16, cb, user);
}

// v1.39：首选方向与交叉轴对齐（0 下 / 1 上 / 2 右 / 3 左；0 起 / 1 中 /
// 2 末）。放不下时自动翻到反方向，最后夹在内容区 8 dp 边距内。
fn aui_popup_place(side: i32, align: i32) : i32 {
    if (g_aui_popup < 0) { return 0; }
    if (side < 0) { side = 0; }
    if (side > 3) { side = 3; }
    if (align < 0) { align = 0; }
    if (align > 2) { align = 2; }
    g_aui_popup_side = side;
    g_aui_popup_align = align;
    return 0;
}

// v1.39：固定宽度（dp）；<= 0 恢复自然宽（孩子最宽 + 左右内边距）。
fn aui_popup_width(dp: i32) : i32 {
    if (g_aui_popup < 0) { return 0; }
    if (dp <= 0) { g_aui_popup_fixed = 0; }
    else { g_aui_popup_fixed = dp2q(dp); }
    return 0;
}

fn aui_popup_reason() : i32 { return g_aui_popup_reason; }

// v1.39：关闭浮层并结算原因。先清状态再调 cb，回调里可安全重开。
fn popup_close(reason: i32) : i32 {
    if (g_aui_popup < 0) { return 0; }
    let pn: ptr<AuiNode> = node_at(g_aui_popup);
    let cb: fn(ptr) : i32 = pn.cb;
    let user: ptr = pn.user;
    g_aui_popup_reason = reason;
    g_aui_popup = -1;
    g_aui_popup_down = -3;
    g_aui_popup_px = 0;
    g_aui_popup_py = 0;
    g_aui_popup_pw = 0;
    g_aui_popup_ph = 0;
    if (cb != 0) { let r: i32 = cb(user); }
    return 1;
}

// v1.39：编程关闭（reason = 3）。
fn aui_popup_dismiss() : i32 {
    if (g_aui_popup < 0) { return 0; }
    let r: i32 = popup_close(3);
    return 1;
}

// ===========================================================================
// 4.1 日期选择（v1.28，对照 HuxerUI DatePicker）
// ===========================================================================

// ---- 日期数学：天数 ↔ 年月日（Howard Hinnant 的 civil 算法）----
// 天数以 1970-01-01 为 0；周几 0=周日。年份 1..9999，足够覆盖控件范围。
fn date_fdiv(a: i32, b: i32) : i32 {
    let q: i32 = a / b;
    let r: i32 = a - q * b;
    if (r < 0) { q = q - 1; }
    return q;
}

fn date_mod(a: i32, b: i32) : i32 {
    return a - date_fdiv(a, b) * b;
}

fn date_leap(y: i32) : i32 {
    if (date_mod(y, 400) == 0) { return 1; }
    if (date_mod(y, 100) == 0) { return 0; }
    if (date_mod(y, 4) == 0) { return 1; }
    return 0;
}

fn date_dim(y: i32, m: i32) : i32 {
    if (m == 2) {
        if (date_leap(y) != 0) { return 29; }
        return 28;
    }
    if (m == 4 || m == 6 || m == 9 || m == 11) { return 30; }
    return 31;
}

fn date_days(y: i32, m: i32, d: i32) : i32 {
    let yy: i32 = y;
    if (m <= 2) { yy = yy - 1; }
    let era: i32 = date_fdiv(yy, 400);
    let yoe: i32 = yy - era * 400;
    let mp: i32 = m;
    if (m > 2) { mp = m - 3; } else { mp = m + 9; }
    let doy: i32 = (153 * mp + 2) / 5 + d - 1;
    let doe: i32 = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    return era * 146097 + doe - 719468;
}

// 结果写 g_aui_date_cy/cm/cd。
fn date_civil(days: i32) : i32 {
    let z: i32 = days + 719468;
    let era: i32 = date_fdiv(z, 146097);
    let doe: i32 = z - era * 146097;
    let yoe: i32 = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let y: i32 = yoe + era * 400;
    let doy: i32 = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp: i32 = (5 * doy + 2) / 153;
    let d: i32 = doy - (153 * mp + 2) / 5 + 1;
    let m: i32 = mp;
    if (mp < 10) { m = mp + 3; } else { m = mp - 9; }
    if (m <= 2) { y = y + 1; }
    g_aui_date_cy = y;
    g_aui_date_cm = m;
    g_aui_date_cd = d;
    return 0;
}

fn date_y(days: i32) : i32 {
    date_civil(days);
    return g_aui_date_cy;
}

fn date_m(days: i32) : i32 {
    date_civil(days);
    return g_aui_date_cm;
}

fn date_d(days: i32) : i32 {
    date_civil(days);
    return g_aui_date_cd;
}

fn date_weekday(days: i32) : i32 {
    return date_mod(days + 4, 7);          // 1970-01-01 是周四
}

// 参数归一化（年 1..9999、月 1..12、日按当月天数夹紧）后返回天数。
fn date_parse(y: i32, m: i32, d: i32) : i32 {
    let yy: i32 = y;
    let mm: i32 = m;
    let dd: i32 = d;
    if (yy < 1) { yy = 1; }
    if (yy > 9999) { yy = 9999; }
    if (mm < 1) { mm = 1; }
    if (mm > 12) { mm = 12; }
    let dim: i32 = date_dim(yy, mm);
    if (dd < 1) { dd = 1; }
    if (dd > dim) { dd = dim; }
    return date_days(yy, mm, dd);
}

fn date_find(key: i32) : i32 {
    if (key <= 0) { return -1; }
    let i: i32 = 0;
    while (i < g_aui_date_used) {
        if (g_aui_date_key[i] == key) { return i; }
        i = i + 1;
    }
    return -1;
}

fn date_slot(key: i32) : i32 {
    let i: i32 = date_find(key);
    if (i >= 0) { return i; }
    if (key <= 0 || g_aui_date_used >= AUI_DATE_CAP) { return -1; }
    i = g_aui_date_used;
    g_aui_date_key[i] = key;
    g_aui_date_sel[i] = date_days(1970, 1, 1);
    g_aui_date_vy[i] = 1970;
    g_aui_date_vm[i] = 1;
    g_aui_date_mode[i] = 0;
    g_aui_date_min[i] = date_days(1, 1, 1);
    g_aui_date_max[i] = date_days(9999, 12, 31);
    g_aui_date_ws[i] = 0;
    g_aui_date_init[i] = 0;
    g_aui_date_used = g_aui_date_used + 1;
    return i;
}

// 每次布局前准备：范围合法、选中夹进范围、可见月夹到与范围有交集的月份。
fn date_prepare(slot: i32) : i32 {
    if (slot < 0 || slot >= g_aui_date_used) { return -1; }
    let mn: i32 = g_aui_date_min[slot];
    let mx: i32 = g_aui_date_max[slot];
    if (mn > mx) {
        let t: i32 = mn; mn = mx; mx = t;
        g_aui_date_min[slot] = mn;
        g_aui_date_max[slot] = mx;
    }
    let sel: i32 = g_aui_date_sel[slot];
    if (sel < mn) { sel = mn; }
    if (sel > mx) { sel = mx; }
    g_aui_date_sel[slot] = sel;
    let vy: i32 = g_aui_date_vy[slot];
    let vm: i32 = g_aui_date_vm[slot];
    if (vy < 1) { vy = 1; }
    if (vy > 9999) { vy = 9999; }
    if (vm < 1) { vm = 1; }
    if (vm > 12) { vm = 12; }
    if (g_aui_date_init[slot] != 0) {
        date_civil(sel);
        vy = g_aui_date_cy;
        vm = g_aui_date_cm;
        g_aui_date_init[slot] = 0;
    }
    let vf: i32 = date_days(vy, vm, 1);
    let vl: i32 = vf + date_dim(vy, vm) - 1;
    if (vl < mn) {
        date_civil(mn);
        vy = g_aui_date_cy;
        vm = g_aui_date_cm;
    } else if (vf > mx) {
        date_civil(mx);
        vy = g_aui_date_cy;
        vm = g_aui_date_cm;
    }
    g_aui_date_vy[slot] = vy;
    g_aui_date_vm[slot] = vm;
    return 0;
}

fn date_month_allowed(slot: i32, y: i32, m: i32) : i32 {
    if (y < 1 || y > 9999 || m < 1 || m > 12) { return 0; }
    let f: i32 = date_days(y, m, 1);
    let l: i32 = f + date_dim(y, m) - 1;
    if (l < g_aui_date_min[slot]) { return 0; }
    if (f > g_aui_date_max[slot]) { return 0; }
    return 1;
}

fn date_year_allowed(slot: i32, y: i32) : i32 {
    let mn: i32 = g_aui_date_min[slot];
    let mx: i32 = g_aui_date_max[slot];
    let a: i32 = date_y(mn);
    let b: i32 = date_y(mx);
    if (y < a || y > b) { return 0; }
    return 1;
}

// 年网格每页 20 年；1 年附近从 1 起，9999 附近从 9980 起。
fn date_page_start(y: i32) : i32 {
    let p: i32 = y - date_mod(y, 20);
    if (p < 1) { p = 1; }
    if (p > 9980) { p = 9980; }
    return p;
}

// 目标年可用时把可见年/月设过去（月按 min/max 的月份夹紧）。
fn date_goto_month(slot: i32, y: i32, m: i32) : i32 {
    if (date_year_allowed(slot, y) == 0) { return 0; }
    let mn: i32 = g_aui_date_min[slot];
    let mx: i32 = g_aui_date_max[slot];
    let a: i32 = date_y(mn);
    let am: i32 = date_m(mn);
    let b: i32 = date_y(mx);
    let bm: i32 = date_m(mx);
    let mm: i32 = m;
    if (mm < 1) { mm = 1; }
    if (mm > 12) { mm = 12; }
    if (y == a && mm < am) { mm = am; }
    if (y == b && mm > bm) { mm = bm; }
    if (date_month_allowed(slot, y, mm) == 0) { return 0; }
    g_aui_date_vy[slot] = y;
    g_aui_date_vm[slot] = mm;
    return 1;
}

fn date_in_range(slot: i32, days: i32) : i32 {
    if (days < g_aui_date_min[slot]) { return 0; }
    if (days > g_aui_date_max[slot]) { return 0; }
    return 1;
}

// dir: -1 上一页 / +1 下一页。日模式翻月，年模式翻 20 年。
fn date_nav(slot: i32, dir: i32) : i32 {
    if (slot < 0) { return 0; }
    let vy: i32 = g_aui_date_vy[slot];
    let vm: i32 = g_aui_date_vm[slot];
    if (g_aui_date_mode[slot] != 0) {
        let start: i32 = date_page_start(vy);
        let ns: i32 = start + dir * 20;
        if (ns < 1 || ns > 9980) { return 0; }
        let ne: i32 = ns + 19;
        let mn: i32 = g_aui_date_min[slot];
        let mx: i32 = g_aui_date_max[slot];
        let a: i32 = date_y(mn);
        let b: i32 = date_y(mx);
        if (ne < a || ns > b) { return 0; }
        let ny: i32 = vy + dir * 20;
        if (ny < ns) { ny = ns; }
        if (ny > ne) { ny = ne; }
        if (ny < a) { ny = a; }
        if (ny > b) { ny = b; }
        let mm: i32 = vm;
        let am: i32 = date_m(mn);
        let bm: i32 = date_m(mx);
        if (ny == a && mm < am) { mm = am; }
        if (ny == b && mm > bm) { mm = bm; }
        if (date_month_allowed(slot, ny, mm) == 0) { return 0; }
        g_aui_date_vy[slot] = ny;
        g_aui_date_vm[slot] = mm;
        return 1;
    }
    let ty: i32 = vy;
    let tm: i32 = vm + dir;
    if (tm < 1) { tm = 12; ty = ty - 1; }
    if (tm > 12) { tm = 1; ty = ty + 1; }
    if (ty < 1 || ty > 9999) { return 0; }
    if (date_month_allowed(slot, ty, tm) == 0) { return 0; }
    g_aui_date_vy[slot] = ty;
    g_aui_date_vm[slot] = tm;
    return 1;
}

fn date_grid_start(slot: i32) : i32 {
    let vy: i32 = g_aui_date_vy[slot];
    let vm: i32 = g_aui_date_vm[slot];
    let first: i32 = date_days(vy, vm, 1);
    let off: i32 = date_mod(date_weekday(first) - g_aui_date_ws[slot], 7);
    return first - off;
}

// ---- 几何 ----
// 头 44 dp；7 列日网格与 6 行周；单元最大 36 dp，宽容器里网格居中。
fn date_geom(n: ptr<AuiNode>) : i32 {
    let pad: i32 = n.pad;
    if (pad < 0) { pad = 0; }
    let gap: i32 = n.gap;
    if (gap < 0) { gap = 0; }
    let header: i32 = dp2q(44);
    let cx: i32 = n.x + pad;
    let cy: i32 = n.y + pad;
    let cw: i32 = n.w - pad * 2;
    if (cw < 0) { cw = 0; }
    let cell: i32 = (cw - gap * 6) / 7;
    if (cell < 0) { cell = 0; }
    let mx: i32 = dp2q(36);
    if (cell > mx) { cell = mx; }
    let gw: i32 = cell * 7 + gap * 6;
    let gx: i32 = cx + (cw - gw) / 2;
    g_aui_dg_cx = cx;
    g_aui_dg_cy = cy;
    g_aui_dg_cw = cw;
    g_aui_dg_gx = gx;
    g_aui_dg_gw = gw;
    g_aui_dg_cell = cell;
    g_aui_dg_gap = gap;
    g_aui_dg_header = header;
    g_aui_dg_weekday_y = cy + header;
    g_aui_dg_day_y = cy + header + cell + gap;
    g_aui_dg_gy = g_aui_dg_day_y;
    // 年网格 5 行比日网格矮两行，垂直居中，避免下半屏大片空白。
    let body: i32 = cell * 7 + gap * 6;
    let ybody: i32 = cell * 5 + gap * 4;
    g_aui_dg_year_y = g_aui_dg_weekday_y + (body - ybody) / 2;
    return 0;
}

fn date_hit(n: ptr<AuiNode>, px: i32, py: i32) : i32 {
    date_geom(n);
    let x: i32 = fx(px);
    let y: i32 = fx(py);
    let cx: i32 = g_aui_dg_cx;
    let cy: i32 = g_aui_dg_cy;
    let cw: i32 = g_aui_dg_cw;
    let hh: i32 = g_aui_dg_header;
    if (x >= cx && y >= cy && x < cx + cw && y < cy + hh) {
        if (x < cx + hh) { return 0; }
        if (x >= cx + cw - hh) { return 2; }
        return 1;
    }
    let slot: i32 = n.aux;
    if (slot < 0) { return -1; }
    let cell: i32 = g_aui_dg_cell;
    let gap: i32 = g_aui_dg_gap;
    let gx: i32 = g_aui_dg_gx;
    let gw: i32 = g_aui_dg_gw;
    if (g_aui_date_mode[slot] != 0) {
        let colw: i32 = (gw - gap * 3) / 4;
        let row: i32 = 0;
        while (row < 5) {
            let col: i32 = 0;
            while (col < 4) {
                let rx: i32 = gx + col * (colw + gap);
                let ry: i32 = g_aui_dg_year_y + row * (cell + gap);
                if (x >= rx && y >= ry && x < rx + colw && y < ry + cell) {
                    return 100 + row * 4 + col;
                }
                col = col + 1;
            }
            row = row + 1;
        }
        return -1;
    }
    let row2: i32 = 0;
    while (row2 < 6) {
        let col2: i32 = 0;
        while (col2 < 7) {
            let rx2: i32 = gx + col2 * (cell + gap);
            let ry2: i32 = g_aui_dg_day_y + row2 * (cell + gap);
            if (x >= rx2 && y >= ry2 && x < rx2 + cell && y < ry2 + cell) {
                return 10 + row2 * 7 + col2;
            }
            col2 = col2 + 1;
        }
        row2 = row2 + 1;
    }
    return -1;
}

// ---- 动态文本（每个 picker 独立的 512 B 区）----
let AUI_DATE_OFS_TITLE: i32 = 0;              // 32 B
let AUI_DATE_OFS_DAY: i32 = 96;               // 42 × 4 B
let AUI_DATE_OFS_YEAR: i32 = 264;             // 20 × 8 B

fn date_put_int(p: ptr, off: i32, v: i32) : i32 {
    let vv: i32 = v;
    if (vv < 0) { vv = 0; }
    let tmp: u8[12] = 0;
    let i: i32 = 0;
    if (vv == 0) {
        let w0: i32 = store_u8(tmp + 0, 48);
        i = 1;
    } else {
        while (vv > 0) {
            let d: i32 = vv - (vv / 10) * 10;
            let w1: i32 = store_u8(tmp + i, 48 + d);
            i = i + 1;
            vv = vv / 10;
        }
    }
    let k: i32 = 0;
    while (i > 0) {
        i = i - 1;
        let ch: i32 = load_u8(tmp + i);
        let w2: i32 = store_u8(p + off + k, ch);
        k = k + 1;
    }
    let w3: i32 = store_u8(p + off + k, 0);
    return k;
}

fn date_put_str(p: ptr, off: i32, s: ptr) : i32 {
    let n: i32 = str_len(s);
    let i: i32 = 0;
    while (i < n) {
        let ch: i32 = load_u8(s + i);
        let w: i32 = store_u8(p + off + i, ch);
        i = i + 1;
    }
    let w2: i32 = store_u8(p + off + n, 0);
    return n;
}

fn date_name3(off: i32, a: i32, b: i32, c: i32) : i32 {
    let p: ptr = g_aui_date_mon + off;
    let w0: i32 = store_u8(p + 0, a);
    let w1: i32 = store_u8(p + 1, b);
    let w2: i32 = store_u8(p + 2, c);
    let w3: i32 = store_u8(p + 3, 0);
    return 0;
}

fn date_name2(off: i32, a: i32, b: i32) : i32 {
    let p: ptr = g_aui_date_wd + off;
    let w0: i32 = store_u8(p + 0, a);
    let w1: i32 = store_u8(p + 1, b);
    let w2: i32 = store_u8(p + 2, 0);
    return 0;
}

fn date_names_init() : i32 {
    if (g_aui_date_names != 0) { return 0; }
    date_name3(0, 74, 97, 110);      // Jan
    date_name3(4, 70, 101, 98);      // Feb
    date_name3(8, 77, 97, 114);      // Mar
    date_name3(12, 65, 112, 114);    // Apr
    date_name3(16, 77, 97, 121);     // May
    date_name3(20, 74, 117, 110);    // Jun
    date_name3(24, 74, 117, 108);    // Jul
    date_name3(28, 65, 117, 103);    // Aug
    date_name3(32, 83, 101, 112);    // Sep
    date_name3(36, 79, 99, 116);     // Oct
    date_name3(40, 78, 111, 118);    // Nov
    date_name3(44, 68, 101, 99);     // Dec
    date_name2(0, 83, 117);          // Su
    date_name2(4, 77, 111);          // Mo
    date_name2(8, 84, 117);          // Tu
    date_name2(12, 87, 101);         // We
    date_name2(16, 84, 104);         // Th
    date_name2(20, 70, 114);         // Fr
    date_name2(24, 83, 97);          // Sa
    let ar: ptr = g_aui_date_arrow;
    let a0: i32 = store_u8(ar + 0, 60);   // '<'
    let a1: i32 = store_u8(ar + 1, 0);
    let a2: i32 = store_u8(ar + 2, 62);   // '>'
    let a3: i32 = store_u8(ar + 3, 0);
    g_aui_date_names = 1;
    return 0;
}

fn date_month_name(m: i32) : ptr {
    date_names_init();
    let mm: i32 = m;
    if (mm < 1) { mm = 1; }
    if (mm > 12) { mm = 12; }
    return g_aui_date_mon + (mm - 1) * 4;
}

fn date_wd_name(wd: i32) : ptr {
    date_names_init();
    let w: i32 = wd;
    if (w < 0) { w = 0; }
    if (w > 6) { w = 6; }
    return g_aui_date_wd + w * 4;
}

// 标题写进 base：日模式 "Oct 2026"，年模式 "2020-2039"。返回长度。
fn date_title_text(slot: i32, base: ptr) : i32 {
    let off: i32 = 0;
    if (g_aui_date_mode[slot] != 0) {
        let p0: i32 = date_page_start(g_aui_date_vy[slot]);
        off = date_put_int(base, off, p0);
        let d: i32 = store_u8(base + off, 45);
        off = off + 1;
        off = off + date_put_int(base, off, p0 + 19);
    } else {
        let name: ptr = date_month_name(g_aui_date_vm[slot]);
        off = date_put_str(base, off, name);
        let sp: i32 = store_u8(base + off, 32);
        off = off + 1;
        off = off + date_put_int(base, off, g_aui_date_vy[slot]);
    }
    let z: i32 = store_u8(base + off, 0);
    return off;
}

fn date_dim_color(c: i32) : i32 {
    return (c & 16777215) | 0x66000000;
}

// 在矩形内居中绘制一行文本，裁剪到矩形。所有日/年/标题都用它。
fn date_text_rect(x: i32, y: i32, w: i32, h: i32, color: i32, s: ptr, tlen: i32) : i32 {
    if (w <= 0 || h <= 0 || tlen <= 0) { return 0; }
    let tw: i32 = text_measure(s, tlen, 0);
    let lh: i32 = text_line_h();
    let gh: i32 = text_glyph_h();
    let tx: i32 = x + (w - tw) / 2;
    let ty: i32 = y + (h - gh) / 2;
    let sx: i32 = g_aui_clip_x;
    let sy: i32 = g_aui_clip_y;
    let sw: i32 = g_aui_clip_w;
    let sh: i32 = g_aui_clip_h;
    let x0: i32 = g_aui_clip_x;
    let y0: i32 = g_aui_clip_y;
    let x1: i32 = g_aui_clip_x + g_aui_clip_w;
    let y1: i32 = g_aui_clip_y + g_aui_clip_h;
    if (x < x0) { x0 = x; }
    if (y < y0) { y0 = y; }
    if (x + w < x1) { x1 = x + w; }
    if (y + h < y1) { y1 = y + h; }
    if (x1 < x0) { x1 = x0; }
    if (y1 < y0) { y1 = y0; }
    g_aui_clip_x = x0;
    g_aui_clip_y = y0;
    g_aui_clip_w = x1 - x0;
    g_aui_clip_h = y1 - y0;
    let rt: i32 = cmd_add(2, tx, ty, tw, lh, color, 0, s, tlen, text_cmd_aux());
    g_aui_clip_x = sx;
    g_aui_clip_y = sy;
    g_aui_clip_w = sw;
    g_aui_clip_h = sh;
    return 0;
}

// ---- 构建 API ----
// 对照 HuxerUI DatePicker：受控日期由应用保存，用户点中某天时只回调
// cb(user)，应用在回调里用 aui_date_selected(key, out) 读新日期并保存。
// 翻月/翻年/进入年网格只改库内可见状态，不回调。key > 0，容量 8。
fn aui_date_picker(key: i32, y: i32, m: i32, d: i32,
                   cb: fn(ptr) : i32, user: ptr) : i32 {
    if (key <= 0) { return -1; }
    let sel: i32 = date_parse(y, m, d);
    let fresh: i32 = 0;
    let slot: i32 = date_find(key);
    if (slot < 0) { fresh = 1; }
    let s2: i32 = date_slot(key);
    if (s2 < 0) { return -1; }
    slot = s2;
    let prev: i32 = g_aui_date_sel[slot];
    let changed: i32 = 0;
    if (sel != prev) { changed = 1; }
    g_aui_date_sel[slot] = sel;
    g_aui_date_min[slot] = date_days(1, 1, 1);
    g_aui_date_max[slot] = date_days(9999, 12, 31);
    g_aui_date_ws[slot] = 0;
    if (fresh != 0) {
        date_civil(sel);
        g_aui_date_vy[slot] = g_aui_date_cy;
        g_aui_date_vm[slot] = g_aui_date_cm;
        g_aui_date_mode[slot] = 0;
        g_aui_date_init[slot] = 0;
    } else if (changed != 0) {
        // 应用换了值（例如对话框再次打开）：下一次布局把可见月跟过去，
        // 并顺带修正被 min/max 夹过的日期。
        g_aui_date_init[slot] = 1;
    }
    let i: i32 = push_leaf(27, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.aux = slot;
    n.pad = dp2q(12);
    n.gap = dp2q(2);
    n.radius = shape_q(AUI_SHAPE_SMALL);         // v2.11：日期选择 12 -> 8 dp
    n.cb = cb;
    n.user = user;
    return i;
}

fn date_mod_target_slot() : i32 {
    let n: ptr<AuiNode> = modify_target();
    if (n == 0) { return -1; }
    if (n.kind != 27) { return -1; }
    return n.aux;
}

fn aui_date_min(y: i32, m: i32, d: i32) : i32 {
    let slot: i32 = date_mod_target_slot();
    if (slot < 0) { return -1; }
    g_aui_date_min[slot] = date_parse(y, m, d);
    return 0;
}

fn aui_date_max(y: i32, m: i32, d: i32) : i32 {
    let slot: i32 = date_mod_target_slot();
    if (slot < 0) { return -1; }
    g_aui_date_max[slot] = date_parse(y, m, d);
    return 0;
}

fn aui_date_week_start(wd: i32) : i32 {
    let slot: i32 = date_mod_target_slot();
    if (slot < 0) { return -1; }
    g_aui_date_ws[slot] = date_mod(wd, 7);
    return 0;
}

// out 写 i32[3] = 年/月/日；picker 不存在时返回 -1。
fn aui_date_selected(key: i32, out: ptr) : i32 {
    let slot: i32 = date_find(key);
    if (slot < 0 || out == 0) { return -1; }
    let sel: i32 = g_aui_date_sel[slot];
    let yy: i32 = date_y(sel);
    let mm: i32 = date_m(sel);
    let dd: i32 = date_d(sel);
    let p: ptr<i32> = out;
    p[0] = yy;
    p[1] = mm;
    p[2] = dd;
    return 0;
}

// ---- 绘制 ----
fn paint_date(n: ptr<AuiNode>) : i32 {
    let slot: i32 = n.aux;
    if (slot < 0) { return 0; }
    date_prepare(slot);
    let radius: i32 = n.radius;
    if (radius <= 0) { radius = shape_q(AUI_SHAPE_SMALL); }   // v2.11：默认 12 -> 8 dp
    let bgc: u32 = theme_surface();
    if (n.bg != 0) { bgc = n.bg; }
    let bd: i32 = dp2q(1);
    let r0: i32 = cmd_add(1, n.x, n.y, n.w, n.h, i32(theme_hint()),
                          radius, g_aui_null, 0, 0);
    let iw: i32 = n.w - bd * 2;
    let ih: i32 = n.h - bd * 2;
    if (iw > 0 && ih > 0) {
        let r1: i32 = cmd_add(1, n.x + bd, n.y + bd, iw, ih, i32(bgc),
                              radius - bd, g_aui_null, 0, 0);
    }
    date_geom(n);
    let cx: i32 = g_aui_dg_cx;
    let cy: i32 = g_aui_dg_cy;
    let cw: i32 = g_aui_dg_cw;
    let gx: i32 = g_aui_dg_gx;
    let gw: i32 = g_aui_dg_gw;
    let cell: i32 = g_aui_dg_cell;
    let gap: i32 = g_aui_dg_gap;
    let hh: i32 = g_aui_dg_header;
    let base: ptr = g_aui_date_text + slot * AUI_DATE_TEXT_STRIDE;
    let pressed: i32 = 0;
    if (g_aui_date_press_key == n.key) { pressed = 1; }
    let tgt: i32 = g_aui_date_press_tgt;
    let txt: i32 = i32(theme_text());
    date_names_init();

    // 头部按压底色：上月 / 标题 / 下月。
    let title_w: i32 = cw - hh * 2;
    if (title_w < 0) { title_w = 0; }
    if (pressed != 0) {
        if (tgt == 0) {
            let r2: i32 = cmd_add(1, cx + dp2q(4), cy + dp2q(4),
                                  hh - dp2q(8), hh - dp2q(8),
                                  i32(theme_pressed()), shape_q(AUI_SHAPE_SMALL), g_aui_null, 0, 0);
        }
        if (tgt == 1 && title_w > 0) {
            let r3: i32 = cmd_add(1, cx + hh, cy + dp2q(4),
                                  title_w, hh - dp2q(8),
                                  i32(theme_pressed()), shape_q(AUI_SHAPE_SMALL), g_aui_null, 0, 0);
        }
        if (tgt == 2) {
            let r4: i32 = cmd_add(1, cx + cw - hh + dp2q(4), cy + dp2q(4),
                                  hh - dp2q(8), hh - dp2q(8),
                                  i32(theme_pressed()), shape_q(AUI_SHAPE_SMALL), g_aui_null, 0, 0);
        }
    }
    let rp: i32 = date_text_rect(cx, cy, hh, hh, txt, g_aui_date_arrow, 1);
    let rn: i32 = date_text_rect(cx + cw - hh, cy, hh, hh, txt,
                                 g_aui_date_arrow + 2, 1);
    let tlen: i32 = date_title_text(slot, base);
    let rt: i32 = date_text_rect(cx + hh, cy, title_w, hh, txt, base, tlen);

    if (g_aui_date_mode[slot] != 0) {
        // 年网格：4 列 × 5 行，每页 20 年。
        let p0: i32 = date_page_start(g_aui_date_vy[slot]);
        g_aui_date_page0 = p0;
        let mn: i32 = g_aui_date_min[slot];
        let mx: i32 = g_aui_date_max[slot];
        let ay: i32 = date_y(mn);
        let by: i32 = date_y(mx);
        let colw: i32 = (gw - gap * 3) / 4;
        if (colw < 0) { colw = 0; }
        let row: i32 = 0;
        while (row < 5) {
            let col: i32 = 0;
            while (col < 4) {
                let idx: i32 = row * 4 + col;
                let yy: i32 = p0 + idx;
                let en: i32 = 0;
                if (yy >= ay && yy <= by) { en = 1; }
                let sl: i32 = 0;
                if (yy == g_aui_date_vy[slot]) { sl = 1; }
                let x: i32 = gx + col * (colw + gap);
                let y2: i32 = g_aui_dg_year_y + row * (cell + gap);
                if (sl != 0) {
                    let colf: u32 = theme_primary();
                    if (pressed != 0 && tgt == 100 + idx) { colf = theme_primary_dark(); }
                    let rf: i32 = cmd_add(1, x, y2, colw, cell, i32(colf),
                                          cell / 2, g_aui_null, 0, 0);
                } else if (pressed != 0 && tgt == 100 + idx && en != 0) {
                    let rq: i32 = cmd_add(1, x, y2, colw, cell,
                                          i32(theme_pressed()), shape_q(AUI_SHAPE_SMALL),
                                          g_aui_null, 0, 0);
                }
                let tc: i32 = txt;
                if (en == 0) { tc = date_dim_color(txt); }
                if (sl != 0) { tc = i32(theme_on_primary()); }
                let off: i32 = AUI_DATE_OFS_YEAR + idx * 8;
                let ylen: i32 = date_put_int(base, off, yy);
                let ry: i32 = date_text_rect(x, y2, colw, cell, tc,
                                             base + off, ylen);
                col = col + 1;
            }
            row = row + 1;
        }
        return 0;
    }

    // 星期行。
    let wcol: i32 = 0;
    while (wcol < 7) {
        let wd: i32 = date_mod(g_aui_date_ws[slot] + wcol, 7);
        let s: ptr = date_wd_name(wd);
        let x3: i32 = gx + wcol * (cell + gap);
        let rw: i32 = date_text_rect(x3, g_aui_dg_weekday_y, cell, cell,
                                     i32(theme_hint()), s, 2);
        wcol = wcol + 1;
    }
    // 6 × 7 日网格；相邻月显示为 HINT 色，范围外更淡。
    let gs: i32 = date_grid_start(slot);
    g_aui_date_grid0 = gs;
    let idx2: i32 = 0;
    while (idx2 < 42) {
        let days: i32 = gs + idx2;
        let dd: i32 = date_d(days);
        let mm: i32 = date_m(days);
        let yy: i32 = date_y(days);
        let en2: i32 = date_in_range(slot, days);
        let sl2: i32 = 0;
        if (days == g_aui_date_sel[slot]) { sl2 = 1; }
        let adj: i32 = 0;
        if (yy != g_aui_date_vy[slot] || mm != g_aui_date_vm[slot]) { adj = 1; }
        let row3: i32 = idx2 / 7;
        let col3: i32 = idx2 - row3 * 7;
        let x4: i32 = gx + col3 * (cell + gap);
        let y4: i32 = g_aui_dg_day_y + row3 * (cell + gap);
        let pt: i32 = 10 + idx2;
        if (sl2 != 0) {
            let colf2: u32 = theme_primary();
            if (pressed != 0 && tgt == pt) { colf2 = theme_primary_dark(); }
            let rf2: i32 = cmd_add(1, x4, y4, cell, cell, i32(colf2),
                                   cell / 2, g_aui_null, 0, 0);
        } else if (pressed != 0 && tgt == pt && en2 != 0) {
            let rq2: i32 = cmd_add(1, x4, y4, cell, cell,
                                   i32(theme_pressed()), shape_q(AUI_SHAPE_SMALL),
                                   g_aui_null, 0, 0);
        }
        let tc2: i32 = txt;
        if (en2 == 0) { tc2 = date_dim_color(i32(theme_hint())); }
        else if (adj != 0) { tc2 = i32(theme_hint()); }
        if (sl2 != 0) { tc2 = i32(theme_on_primary()); }
        let off2: i32 = AUI_DATE_OFS_DAY + idx2 * 4;
        let len2: i32 = date_put_int(base, off2, dd);
        let rd: i32 = date_text_rect(x4, y4, cell, cell, tc2, base + off2, len2);
        idx2 = idx2 + 1;
    }
    return 0;
}

// 点击激活（UP 且未拖动）。日选择：更新选中/可见月并只调一次 cb；
// 翻月、翻年页、进入/退出年网格都不回调。
fn date_activate(n: ptr<AuiNode>, tgt: i32) : i32 {
    if (tgt < 0) { return 0; }
    let slot: i32 = n.aux;
    if (slot < 0) { return 0; }
    if (tgt == 0 || tgt == 2) {
        let dir: i32 = -1;
        if (tgt == 2) { dir = 1; }
        let r: i32 = date_nav(slot, dir);
        return 1;
    }
    if (tgt == 1) {
        if (g_aui_date_mode[slot] != 0) { g_aui_date_mode[slot] = 0; }
        else { g_aui_date_mode[slot] = 1; }
        return 1;
    }
    if (tgt >= 100) {
        let idx: i32 = tgt - 100;
        if (idx < 0 || idx >= 20) { return 0; }
        let yy: i32 = date_page_start(g_aui_date_vy[slot]) + idx;
        let vm: i32 = g_aui_date_vm[slot];
        let ok: i32 = date_goto_month(slot, yy, vm);
        if (ok == 0) { return 0; }
        g_aui_date_mode[slot] = 0;
        return 1;
    }
    if (tgt < 10) { return 0; }
    let idx2: i32 = tgt - 10;
    if (idx2 < 0 || idx2 >= 42) { return 0; }
    let days: i32 = date_grid_start(slot) + idx2;
    if (date_in_range(slot, days) == 0) { return 0; }
    let old: i32 = g_aui_date_sel[slot];
    g_aui_date_sel[slot] = days;
    date_civil(days);
    g_aui_date_vy[slot] = g_aui_date_cy;
    g_aui_date_vm[slot] = g_aui_date_cm;
    if (days != old) {
        let cb: fn(ptr) : i32 = n.cb;
        if (cb != 0) {
            let r2: i32 = cb(n.user);
        }
    }
    return 1;
}

fn date_press_clear() : i32 {
    g_aui_date_press_key = 0;
    g_aui_date_press_tgt = -1;
    g_aui_date_drag = 0;
    return 0;
}

fn date_node(key: i32) : i32 {
    let i: i32 = 0;
    while (i < g_aui_node_count) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.kind == 27 && n.key == key) { return i; }
        i = i + 1;
    }
    return -1;
}

// ===========================================================================
// 时间选择（v1.29）
// ===========================================================================
// 对照 HuxerUI TimePicker：头部时/分两个字段 + AM/PM 组，下面是圆表盘。
// 12 小时制一圈 12 个标签；24 小时制外圈 1..12、内圈 00/13..23。分钟
// 表盘每 5 分钟一个标签、60 个逻辑角度；步长在发出提案前把角度量化。

// 12 个 30° 单位向量（从 12 点起顺时针）与 atan 表（t=i/8，单位
// Q16.16 分钟，满圈 = 60 分钟）。全局数组不能带非零初值，首次写入。
fn time_tab_init() : i32 {
    if (g_aui_time_tab != 0) { return 0; }
    g_aui_time_uvx[0] = 0;       g_aui_time_uvy[0] = -65536;
    g_aui_time_uvx[1] = 32768;   g_aui_time_uvy[1] = -56756;
    g_aui_time_uvx[2] = 56756;   g_aui_time_uvy[2] = -32768;
    g_aui_time_uvx[3] = 65536;   g_aui_time_uvy[3] = 0;
    g_aui_time_uvx[4] = 56756;   g_aui_time_uvy[4] = 32768;
    g_aui_time_uvx[5] = 32768;   g_aui_time_uvy[5] = 56756;
    g_aui_time_uvx[6] = 0;       g_aui_time_uvy[6] = 65536;
    g_aui_time_uvx[7] = -32768;  g_aui_time_uvy[7] = 56756;
    g_aui_time_uvx[8] = -56756;  g_aui_time_uvy[8] = 32768;
    g_aui_time_uvx[9] = -65536;  g_aui_time_uvy[9] = 0;
    g_aui_time_uvx[10] = -56756; g_aui_time_uvy[10] = -32768;
    g_aui_time_uvx[11] = -32768; g_aui_time_uvy[11] = -56756;
    g_aui_time_atan[0] = 0;
    g_aui_time_atan[1] = 77824;
    g_aui_time_atan[2] = 153313;
    g_aui_time_atan[3] = 224527;
    g_aui_time_atan[4] = 290161;
    g_aui_time_atan[5] = 349584;
    g_aui_time_atan[6] = 402718;
    g_aui_time_atan[7] = 449860;
    g_aui_time_atan[8] = 491520;
    g_aui_time_tab = 1;
    return 0;
}

fn time_find(key: i32) : i32 {
    if (key <= 0) { return -1; }
    let i: i32 = 0;
    while (i < g_aui_time_used) {
        if (g_aui_time_key[i] == key) { return i; }
        i = i + 1;
    }
    return -1;
}

fn time_slot(key: i32) : i32 {
    let i: i32 = time_find(key);
    if (i >= 0) { return i; }
    if (key <= 0 || g_aui_time_used >= AUI_TIME_CAP) { return -1; }
    i = g_aui_time_used;
    g_aui_time_key[i] = key;
    g_aui_time_sel[i] = 0;
    g_aui_time_step[i] = 1;
    g_aui_time_h12[i] = 0;
    g_aui_time_mode[i] = 0;
    g_aui_time_used = g_aui_time_used + 1;
    return i;
}

// 每次布局前准备：步长合法、选中分钟按步长量化（24h 取模）。
fn time_prepare(slot: i32) : i32 {
    if (slot < 0 || slot >= g_aui_time_used) { return -1; }
    let st: i32 = g_aui_time_step[slot];
    if (st < 1 || st > 60 || 60 % st != 0) {
        st = 1;
        g_aui_time_step[slot] = 1;
    }
    let sel: i32 = g_aui_time_sel[slot];
    if (sel < 0) { sel = 0; }
    if (sel > 1439) { sel = 1439; }
    // 受控值不在表盘输入时强制吸附：与 HuxerUI 一样保留应用给的值，
    // 只有点/拖表盘才按步长量化（否则库内值与应用值会悄悄分叉）。
    g_aui_time_sel[slot] = sel;
    let md: i32 = g_aui_time_mode[slot];
    if (md < 0 || md > 1) { g_aui_time_mode[slot] = 0; }
    if (g_aui_time_h12[slot] != 0) { g_aui_time_h12[slot] = 1; }
    return 0;
}

fn time_node(key: i32) : i32 {
    let i: i32 = 0;
    while (i < g_aui_node_count) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.kind == 28 && n.key == key) { return i; }
        i = i + 1;
    }
    return -1;
}

// ---- 构建 API ----
// 受控时刻由应用保存；用户改时/分/AM/PM/表盘后只回调 cb(user)，
// 应用在回调里用 aui_time_selected(key, out) 读取新值并保存。
// step 默认 1 分钟，12 小时制默认关，均需在 aui_time_picker 之后修饰。
fn aui_time_picker(key: i32, hour: i32, minute: i32,
                   cb: fn(ptr) : i32, user: ptr) : i32 {
    if (key <= 0) { return -1; }
    let h: i32 = hour;
    let m: i32 = minute;
    if (h < 0) { h = 0; }
    if (h > 23) { h = 23; }
    if (m < 0) { m = 0; }
    if (m > 59) { m = 59; }
    let slot: i32 = time_slot(key);
    if (slot < 0) { return -1; }
    g_aui_time_sel[slot] = h * 60 + m;
    g_aui_time_step[slot] = 1;
    g_aui_time_h12[slot] = 0;
    let i: i32 = push_leaf(28, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.aux = slot;
    n.pad = dp2q(12);
    n.radius = shape_q(AUI_SHAPE_SMALL);         // v2.11：时间选择 12 -> 8 dp
    n.cb = cb;
    n.user = user;
    return i;
}

fn time_mod_target_slot() : i32 {
    let n: ptr<AuiNode> = modify_target();
    if (n == 0) { return -1; }
    if (n.kind != 28) { return -1; }
    return n.aux;
}

fn aui_time_step(minutes: i32) : i32 {
    let slot: i32 = time_mod_target_slot();
    if (slot < 0) { return -1; }
    if (minutes < 1 || minutes > 60 || 60 % minutes != 0) { return -1; }
    g_aui_time_step[slot] = minutes;
    return 0;
}

fn aui_time_12h(on: i32) : i32 {
    let slot: i32 = time_mod_target_slot();
    if (slot < 0) { return -1; }
    let v: i32 = 0;
    if (on != 0) { v = 1; }
    g_aui_time_h12[slot] = v;
    return 0;
}

// out 写 i32[2] = 时/分；picker 不存在时返回 -1。
fn aui_time_selected(key: i32, out: ptr) : i32 {
    let slot: i32 = time_find(key);
    if (slot < 0 || out == 0) { return -1; }
    let sel: i32 = g_aui_time_sel[slot];
    let p: ptr<i32> = out;
    p[0] = sel / 60;
    p[1] = sel % 60;
    return 0;
}

// ---- 几何 ----
// 头 52 dp：64 dp 字段 ×2 + 16 dp 冒号（12 小时制再加 8 + 44 dp 周期组）；
// 内容间距 16 dp 后是直径至多 208 dp 的表盘。头部与表盘都水平居中。
fn time_geom(n: ptr<AuiNode>) : i32 {
    time_tab_init();
    let pad: i32 = n.pad;
    if (pad < 0) { pad = 0; }
    let cx: i32 = n.x + pad;
    let cy: i32 = n.y + pad;
    let cw: i32 = n.w - pad * 2;
    if (cw < 0) { cw = 0; }
    let hh: i32 = dp2q(52);
    let fw: i32 = dp2q(64);
    let sw: i32 = dp2q(16);
    let pw: i32 = dp2q(44);
    let ps: i32 = dp2q(8);
    let gap: i32 = dp2q(16);
    let slot: i32 = n.aux;
    let h12: i32 = 0;
    if (slot >= 0) { h12 = g_aui_time_h12[slot]; }
    let hw: i32 = fw * 2 + sw;
    if (h12 != 0) { hw = hw + ps + pw; }
    let hx: i32 = cx + (cw - hw) / 2;
    let dial: i32 = dp2q(208);
    if (dial > cw) { dial = cw; }
    let dy: i32 = cy + hh + gap;
    g_aui_tg_cx = cx;
    g_aui_tg_cy = cy;
    g_aui_tg_cw = cw;
    g_aui_tg_hx = hx;
    g_aui_tg_hw = hw;
    g_aui_tg_hh = hh;
    g_aui_tg_fw = fw;
    g_aui_tg_sw = sw;
    g_aui_tg_pw = pw;
    g_aui_tg_ps = ps;
    g_aui_tg_hfx = hx;
    g_aui_tg_mfx = hx + fw + sw;
    g_aui_tg_pfx = hx + fw * 2 + sw + ps;
    g_aui_tg_dial_y = dy;
    g_aui_tg_dcx = cx + cw / 2;
    g_aui_tg_dcy = dy + dial / 2;
    g_aui_tg_dr = dial / 2;
    return 0;
}

// 0 时 / 1 分 / 2 AM / 3 PM / 10 表盘 / -1 其他。
fn time_hit(n: ptr<AuiNode>, px: i32, py: i32) : i32 {
    time_geom(n);
    let x: i32 = px << 16;
    let y: i32 = py << 16;
    let hx: i32 = g_aui_tg_hfx;
    let mx: i32 = g_aui_tg_mfx;
    let cy: i32 = g_aui_tg_cy;
    let fw: i32 = g_aui_tg_fw;
    let hh: i32 = g_aui_tg_hh;
    if (y >= cy && y < cy + hh) {
        if (x >= hx && x < hx + fw) { return 0; }
        if (x >= mx && x < mx + fw) { return 1; }
        let slot: i32 = n.aux;
        if (slot >= 0 && g_aui_time_h12[slot] != 0) {
            let p0: i32 = g_aui_tg_pfx;
            if (x >= p0 && x < p0 + g_aui_tg_pw) {
                if (y < cy + hh / 2) { return 2; }
                return 3;
            }
        }
    }
    let dx: i32 = x - g_aui_tg_dcx;
    let dy: i32 = y - g_aui_tg_dcy;
    let r: i32 = g_aui_tg_dr;
    if (r <= 0) { return -1; }
    let d2: i64 = i64(dx) * i64(dx) + i64(dy) * i64(dy);
    if (d2 <= i64(r) * i64(r)) { return 10; }
    return -1;
}

// 从 12 点方向顺时针的角度，单位 Q16.16 分钟（3932160 = 一圈）。
// 八分区 + 每 1/8 段线性 atan；没有浮点与三角函数。
fn time_angle(dx: i32, dy: i32) : i32 {
    let ax: i32 = dx;
    if (ax < 0) { ax = -ax; }
    let ay: i32 = dy;
    if (ay < 0) { ay = -ay; }
    if (ax == 0 && ay == 0) { return 0; }
    let up: i32 = 0;
    if (dy < 0) { up = 1; }
    let right: i32 = 0;
    if (dx >= 0) { right = 1; }
    let oct: i32 = 0;
    let minor: i32 = 0;
    let major: i32 = 0;
    if (up != 0 && right != 0) {
        if (ax <= ay) { oct = 0; minor = ax; major = ay; }
        else { oct = 1; minor = ay; major = ax; }
    } else if (up == 0 && right != 0) {
        if (ay <= ax) { oct = 2; minor = ay; major = ax; }
        else { oct = 3; minor = ax; major = ay; }
    } else if (up == 0 && right == 0) {
        if (ax <= ay) { oct = 4; minor = ax; major = ay; }
        else { oct = 5; minor = ay; major = ax; }
    } else {
        if (ay <= ax) { oct = 6; minor = ay; major = ax; }
        else { oct = 7; minor = ax; major = ay; }
    }
    let t: i32 = 0;
    if (major > 0) {
        t = i32((i64(minor) << 16) / i64(major));
    }
    let idx: i32 = t >> 13;
    let base: i32 = 0;
    if (idx >= 8) {
        base = 491520;
    } else {
        let t0: i32 = g_aui_time_atan[idx];
        let t1: i32 = g_aui_time_atan[idx + 1];
        let frac: i32 = t - idx * 8192;
        base = t0 + i32((i64(t1 - t0) * i64(frac)) / 8192);
    }
    // 奇数八分区从 45° 向 90°/180°/270°/360° 回退：用 45° 减表值。
    if (oct == 1 || oct == 3 || oct == 5 || oct == 7) {
        base = 491520 - base;
    }
    return oct * 491520 + base;
}

// 角度四舍五入到 divisions 等分（0 = 12 点方向）。
fn time_round_div(angle: i32, divisions: i32) : i32 {
    let step: i32 = 3932160 / divisions;
    let v: i32 = (angle + step / 2) / step;
    return v % divisions;
}

fn time_lerp_v(a: i32, b: i32, frac: i32, den: i32) : i32 {
    return a + i32((i64(b - a) * i64(frac)) / i64(den));
}

// 当前选中点（表盘手柄末端）写 g_aui_time_ax / ay。
fn time_sel_point(slot: i32) : i32 {
    let sel: i32 = g_aui_time_sel[slot];
    let h: i32 = sel / 60;
    let m: i32 = sel % 60;
    let r: i32 = g_aui_tg_dr;
    let rr: i32 = (r * 78) / 100;
    let vx: i32 = 0;
    let vy: i32 = 0;
    if (g_aui_time_mode[slot] != 0) {
        let idx: i32 = m / 5;
        let frac: i32 = m - idx * 5;
        vx = time_lerp_v(g_aui_time_uvx[idx], g_aui_time_uvx[(idx + 1) % 12], frac, 5);
        vy = time_lerp_v(g_aui_time_uvy[idx], g_aui_time_uvy[(idx + 1) % 12], frac, 5);
    } else {
        if (g_aui_time_h12[slot] == 0 && (h == 0 || h >= 13)) { rr = (r * 52) / 100; }
        let pos: i32 = h % 12;
        vx = g_aui_time_uvx[pos];
        vy = g_aui_time_uvy[pos];
    }
    g_aui_time_ax = g_aui_tg_dcx + fx_mul(vx, rr);
    g_aui_time_ay = g_aui_tg_dcy + fx_mul(vy, rr);
    return 0;
}

// 值变化才写回并回调；返回 1 = 变了。
fn time_emit(slot: i32, v: i32) : i32 {
    if (slot < 0 || v < 0 || v >= 1440) { return 0; }
    if (v == g_aui_time_sel[slot]) { return 0; }
    g_aui_time_sel[slot] = v;
    let ni: i32 = time_node(g_aui_time_key[slot]);
    if (ni >= 0) {
        let n: ptr<AuiNode> = node_at(ni);
        let cb: fn(ptr) : i32 = n.cb;
        if (cb != 0) {
            let r: i32 = cb(n.user);
        }
    }
    return 1;
}

// 表盘取值：角度 → 时/分。按下即取一次，拖动中连续更新。
fn time_dial_apply(n: ptr<AuiNode>, px: i32, py: i32) : i32 {
    let slot: i32 = n.aux;
    if (slot < 0) { return 0; }
    time_geom(n);
    let x: i32 = px << 16;
    let y: i32 = py << 16;
    let dx: i32 = x - g_aui_tg_dcx;
    let dy: i32 = y - g_aui_tg_dcy;
    if (dx == 0 && dy == 0) { return 0; }
    let ang: i32 = time_angle(dx, dy);
    let sel: i32 = g_aui_time_sel[slot];
    let h: i32 = sel / 60;
    let m: i32 = sel % 60;
    let nv: i32 = sel;
    if (g_aui_time_mode[slot] != 0) {
        let raw: i32 = time_round_div(ang, 60);
        let st: i32 = g_aui_time_step[slot];
        if (st < 1) { st = 1; }
        let mm: i32 = ((raw + st / 2) / st) * st % 60;
        nv = h * 60 + mm;
    } else {
        let k: i32 = time_round_div(ang, 12);
        let hour: i32 = k;
        if (g_aui_time_h12[slot] != 0) {
            if (h >= 12) { hour = hour + 12; }
        } else {
            let r: i32 = g_aui_tg_dr;
            let lim: i32 = (r * 66) / 100;
            let d2: i64 = i64(dx) * i64(dx) + i64(dy) * i64(dy);
            if (d2 < i64(lim) * i64(lim)) {
                // 24 小时制内圈：00 与 13..23。
                if (k != 0) { hour = k + 12; }
            } else {
                if (k == 0) { hour = 12; }
            }
        }
        nv = hour * 60 + m;
    }
    return time_emit(slot, nv);
}

// 头部激活：字段切模式；AM/PM 只翻转当前 12 小时位置。
fn time_activate(n: ptr<AuiNode>, tgt: i32) : i32 {
    let slot: i32 = n.aux;
    if (slot < 0) { return 0; }
    if (tgt == 0) {
        g_aui_time_mode[slot] = 0;
        return 1;
    }
    if (tgt == 1) {
        g_aui_time_mode[slot] = 1;
        return 1;
    }
    if (tgt == 2 || tgt == 3) {
        let sel: i32 = g_aui_time_sel[slot];
        let h: i32 = sel / 60;
        let m: i32 = sel % 60;
        let nh: i32 = h;
        if (tgt == 2) {
            if (h < 12) { return 0; }
            nh = h - 12;
        } else {
            if (h >= 12) { return 0; }
            nh = h + 12;
        }
        let ch: i32 = time_emit(slot, nh * 60 + m);
        return 1;
    }
    return 0;
}

fn time_press_clear() : i32 {
    g_aui_time_press_key = 0;
    g_aui_time_press_tgt = -1;
    g_aui_time_drag = 0;
    g_aui_time_dial = 0;
    return 0;
}

// ---- 动态文本 ----
fn time_put2(p: ptr, off: i32, v: i32) : i32 {
    let vv: i32 = v;
    if (vv < 0) { vv = 0; }
    if (vv > 99) { vv = 99; }
    let t: i32 = vv / 10;
    let u: i32 = vv - t * 10;
    let w0: i32 = store_u8(p + off, 48 + t);
    let w1: i32 = store_u8(p + off + 1, 48 + u);
    let w2: i32 = store_u8(p + off + 2, 0);
    return 2;
}

// 表盘标签：选中时胶囊主色 + on_primary，未选中直接文本色。
// 胶囊宽度取文本宽与 28 dp 的较大者（同 HuxerUI 的 selection_radius*2）。
fn time_paint_label(base: ptr, off: i32, tlen: i32,
                    cx: i32, cy: i32, selected: i32) : i32 {
    let tw: i32 = text_measure(base + off, tlen, 0);
    let dw: i32 = dp2q(28);
    let w: i32 = tw;
    if (w < dw) { w = dw; }
    let h: i32 = dw;
    let x: i32 = cx - w / 2;
    let y: i32 = cy - h / 2;
    if (selected != 0) {
        let rf: i32 = cmd_add(1, x, y, w, h, i32(theme_primary()),
                              shape_radius(AUI_SHAPE_FULL, h), g_aui_null, 0, 0);
        let rt: i32 = date_text_rect(x, y, w, h, i32(theme_on_primary()),
                                     base + off, tlen);
    } else {
        let rt2: i32 = date_text_rect(x, y, w, h, i32(theme_text()),
                                      base + off, tlen);
    }
    return 0;
}

// ---- 绘制 ----
fn paint_time(n: ptr<AuiNode>) : i32 {
    let slot: i32 = n.aux;
    if (slot < 0) { return 0; }
    time_prepare(slot);
    time_geom(n);
    let radius: i32 = n.radius;
    if (radius <= 0) { radius = shape_q(AUI_SHAPE_SMALL); }   // v2.11：默认 12 -> 8 dp
    let bgc: u32 = theme_surface();
    if (n.bg != 0) { bgc = n.bg; }
    let bd: i32 = dp2q(1);
    let r0: i32 = cmd_add(1, n.x, n.y, n.w, n.h, i32(theme_hint()),
                          radius, g_aui_null, 0, 0);
    let iw: i32 = n.w - bd * 2;
    let ih: i32 = n.h - bd * 2;
    if (iw > 0 && ih > 0) {
        let r1: i32 = cmd_add(1, n.x + bd, n.y + bd, iw, ih, i32(bgc),
                              radius - bd, g_aui_null, 0, 0);
    }
    let sel: i32 = g_aui_time_sel[slot];
    let h: i32 = sel / 60;
    let m: i32 = sel % 60;
    let h12: i32 = g_aui_time_h12[slot];
    let mode: i32 = g_aui_time_mode[slot];
    let pressed: i32 = 0;
    if (g_aui_time_press_key == n.key) { pressed = 1; }
    let tgt: i32 = g_aui_time_press_tgt;
    let base: ptr = g_aui_time_text + slot * AUI_TIME_TEXT_STRIDE;
    let fx0: i32 = g_aui_tg_hfx;
    let mx0: i32 = g_aui_tg_mfx;
    let px0: i32 = g_aui_tg_pfx;
    let cy0: i32 = g_aui_tg_cy;
    let fw0: i32 = g_aui_tg_fw;
    let sw0: i32 = g_aui_tg_sw;
    let hh0: i32 = g_aui_tg_hh;

    // 头部字段：选中字段主色，另一个 tint；按压时换成更深的底色。
    let hcol: u32 = theme_tint();
    let mcol: u32 = theme_tint();
    if (mode == 0) { hcol = theme_primary(); } else { mcol = theme_primary(); }
    if (pressed != 0 && tgt == 0) {
        if (mode == 0) { hcol = theme_primary_dark(); }
        else { hcol = theme_pressed(); }
    }
    if (pressed != 0 && tgt == 1) {
        if (mode == 1) { mcol = theme_primary_dark(); }
        else { mcol = theme_pressed(); }
    }
    let rh: i32 = cmd_add(1, fx0, cy0, fw0, hh0, i32(hcol),
                          shape_q(AUI_SHAPE_SMALL), g_aui_null, 0, 0);
    let rm: i32 = cmd_add(1, mx0, cy0, fw0, hh0, i32(mcol),
                          shape_q(AUI_SHAPE_SMALL), g_aui_null, 0, 0);
    let dh: i32 = h;
    if (h12 != 0) {
        dh = h % 12;
        if (dh == 0) { dh = 12; }
    }
    let w0: i32 = time_put2(base, 0, dh);
    let w1: i32 = time_put2(base, 4, m);
    let w2: i32 = store_u8(base + 8, 58);   // ':'
    let w3: i32 = store_u8(base + 9, 0);
    let w4: i32 = store_u8(base + 16, 65);  // "AM"
    let w5: i32 = store_u8(base + 17, 77);
    let w6: i32 = store_u8(base + 18, 0);
    let w7: i32 = store_u8(base + 24, 80);  // "PM"
    let w8: i32 = store_u8(base + 25, 77);
    let w9: i32 = store_u8(base + 26, 0);
    let htc: i32 = i32(theme_text());
    if (mode == 0) { htc = i32(theme_on_primary()); }
    let mtc: i32 = i32(theme_text());
    if (mode == 1) { mtc = i32(theme_on_primary()); }
    let rz: i32 = date_text_rect(fx0, cy0, fw0, hh0, htc, base, 2);
    let rsep: i32 = date_text_rect(mx0 - sw0, cy0, sw0, hh0,
                                   i32(theme_text()), base + 8, 1);
    let rz2: i32 = date_text_rect(mx0, cy0, fw0, hh0, mtc, base + 4, 2);

    // AM/PM 周期组：一个圆角描边组，选中的半区填主色，中间一条分隔线。
    if (h12 != 0) {
        let pw0: i32 = g_aui_tg_pw;
        let rb0: i32 = cmd_add(1, px0, cy0, pw0, hh0, i32(theme_hint()),
                               shape_q(AUI_SHAPE_SMALL), g_aui_null, 0, 0);
        let rb1: i32 = cmd_add(1, px0 + bd, cy0 + bd, pw0 - bd * 2,
                               hh0 - bd * 2, i32(theme_tint()),
                               dp2q(7), g_aui_null, 0, 0);
        let half: i32 = (hh0 - bd * 2) / 2;
        let amsel: i32 = 0;
        if (h < 12) { amsel = 1; }
        let sy: i32 = cy0 + bd;
        if (amsel == 0) { sy = sy + half; }
        let rs: i32 = cmd_add(1, px0 + bd, sy, pw0 - bd * 2, half,
                              i32(theme_primary()), dp2q(7), g_aui_null, 0, 0);
        if (pressed != 0 && tgt == 2 && amsel == 0) {
            let rq1: i32 = cmd_add(1, px0 + bd, cy0 + bd, pw0 - bd * 2,
                                   half, i32(theme_pressed()), dp2q(7),
                                   g_aui_null, 0, 0);
        }
        if (pressed != 0 && tgt == 3 && amsel != 0) {
            let rq2: i32 = cmd_add(1, px0 + bd, cy0 + bd + half,
                                   pw0 - bd * 2, half, i32(theme_pressed()),
                                   dp2q(7), g_aui_null, 0, 0);
        }
        let dvy: i32 = cy0 + hh0 / 2 - bd / 2;
        let rd: i32 = cmd_add(1, px0 + dp2q(8), dvy, pw0 - dp2q(16), bd,
                              i32(theme_hint()), 0, g_aui_null, 0, 0);
        let atc: i32 = i32(theme_text());
        if (amsel != 0) { atc = i32(theme_on_primary()); }
        let ptc: i32 = i32(theme_text());
        if (amsel == 0) { ptc = i32(theme_on_primary()); }
        let ra: i32 = date_text_rect(px0, cy0, pw0, hh0 / 2, atc, base + 16, 2);
        let rp: i32 = date_text_rect(px0, cy0 + hh0 / 2, pw0, hh0 / 2,
                                     ptc, base + 24, 2);
    }

    // 表盘：tint 圆底 + 手柄（无画线原语，用 2 dp 小圆点连成线）+ 中心点 +
    // 选中点 14 dp 圆 + 标签。
    let dr: i32 = g_aui_tg_dr;
    let dcx: i32 = g_aui_tg_dcx;
    let dcy: i32 = g_aui_tg_dcy;
    if (dr > 0) {
        let rdb: i32 = cmd_add(1, dcx - dr, dcy - dr, dr * 2, dr * 2,
                               i32(theme_tint()), dr, g_aui_null, 0, 0);
        let sp: i32 = time_sel_point(slot);
        let axp: i32 = g_aui_time_ax;
        let ayp: i32 = g_aui_time_ay;
        let hd: i32 = dp2q(1);
        let i2: i32 = 1;
        while (i2 < 128) {
            let hx3: i32 = dcx + i32((i64(axp - dcx) * i64(i2)) / 128);
            let hy3: i32 = dcy + i32((i64(ayp - dcy) * i64(i2)) / 128);
            let rdot: i32 = cmd_add(1, hx3 - hd, hy3 - hd, hd * 2, hd * 2,
                                    i32(theme_primary()), hd, g_aui_null, 0, 0);
            i2 = i2 + 1;
        }
        let cdr: i32 = dp2q(2);
        let rcd: i32 = cmd_add(1, dcx - cdr, dcy - cdr, cdr * 2, cdr * 2,
                               i32(theme_primary()), cdr, g_aui_null, 0, 0);
        // v1.29.1：14 dp 选中圆约占 3 分钟弧长；1 分钟粒度下它会盖住相邻
        // 的 5 分钟标签（23/24 分看起来像 25 分，即用户反馈的“偏移”）。
        // 因此只有正好落在 5 分钟标签上时才画大圆（定位由标签胶囊给出），
        // 其余分钟只画 5 dp 圆头手柄，手柄中心始终对准真实角度。
        let sr: i32 = dp2q(14);
        if (mode != 0 && m % 5 != 0) { sr = dp2q(5); }
        let rsc: i32 = cmd_add(1, axp - sr, ayp - sr, sr * 2, sr * 2,
                               i32(theme_primary()), sr, g_aui_null, 0, 0);

        if (mode != 0) {
            let mi: i32 = 0;
            while (mi < 60) {
                let pos: i32 = mi / 5;
                let rr: i32 = (dr * 78) / 100;
                let lx: i32 = dcx + fx_mul(g_aui_time_uvx[pos], rr);
                let ly: i32 = dcy + fx_mul(g_aui_time_uvy[pos], rr);
                let off: i32 = 136 + pos * 4;
                let gl: i32 = time_put2(base, off, mi);
                let sl: i32 = 0;
                if (mi == m) { sl = 1; }
                let rl: i32 = time_paint_label(base, off, 2, lx, ly, sl);
                mi = mi + 5;
            }
        } else {
            let cnt: i32 = 24;
            if (h12 != 0) { cnt = 12; }
            let hi: i32 = 0;
            while (hi < cnt) {
                let pos2: i32 = hi % 12;
                let rr2: i32 = (dr * 78) / 100;
                if (h12 == 0 && (hi == 0 || hi >= 13)) { rr2 = (dr * 52) / 100; }
                let lx2: i32 = dcx + fx_mul(g_aui_time_uvx[pos2], rr2);
                let ly2: i32 = dcy + fx_mul(g_aui_time_uvy[pos2], rr2);
                let off2: i32 = 40 + hi * 4;
                let hv: i32 = hi;
                let tl: i32 = 2;
                if (h12 != 0) {
                    if (hi == 0) { hv = 12; }
                    else if (hi < 10) { tl = 1; }
                }
                if (tl == 2) {
                    let g2: i32 = time_put2(base, off2, hv);
                } else {
                    let g3: i32 = date_put_int(base, off2, hv);
                }
                let sl2: i32 = 0;
                if (h12 != 0) {
                    if (h % 12 == hi % 12) { sl2 = 1; }
                } else if (h == hi) {
                    sl2 = 1;
                }
                let rl2: i32 = time_paint_label(base, off2, tl, lx2, ly2, sl2);
                hi = hi + 1;
            }
        }
    }
    return 0;
}


fn aui_text_field(key: i32, hint: ptr) : i32 {
    let i: i32 = push_leaf(10, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    let idx: i32 = text_slot(key, 1);
    if (idx >= 0) {
        n.text = g_aui_text_pool + idx * AUI_TEXT_SLOT;
        n.aux = g_aui_text_len[idx];
    } else {
        n.text = g_aui_empty;
        n.aux = 0;
    }
    n.user = hint;
    n.pad = dp2q(12);
    n.radius = shape_q(AUI_SHAPE_SMALL);
    return i;
}

// 键盘键：kind 11，aux 是 ASCII 码或特殊键（8 DEL / 13 DONE / 16 SHIFT / 17 模式）。
fn aui_key(key: i32, code: i32) : i32 {
    let i: i32 = push_leaf(11, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.aux = code;
    n.radius = shape_q(AUI_SHAPE_SMALL);         // v2.11：键盘键 6 -> 8 dp
    return i;
}

fn aui_spacer(key: i32, dp: i32) : i32 {
    let i: i32 = push_leaf(7, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.aux = dp;
    return i;
}

fn aui_image(key: i32, rgba: ptr, w: i32, h: i32) : i32 {
    let i: i32 = push_leaf(8, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.text = rgba;
    n.aux = (h << 16) | (w & 65535);
    return i;
}

// v2.6：Canvas 自定义绘图节点（kind 57）。aux 沿用 image 的编码
// (h_dp<<16)|w_dp；w_dp == 0 表示无固有宽（配 aui_align(3) 撑满）。
// draw_fn 存在节点的 cb 槽里（与点击回调同槽——命中测试把 kind 57
// 排除在 find_clickable 之外，所以点按永远不会把它当点击回调叫）。
fn aui_canvas(key: i32, w_dp: i32, h_dp: i32,
              draw_fn: fn(ptr) : i32, user: ptr) : i32 {
    let i: i32 = push_leaf(57, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.aux = (h_dp << 16) | (w_dp & 65535);
    n.cb = draw_fn;
    n.user = user;
    return i;
}

// ---- 文本字段存储 ----
fn text_slot(key: i32, create: i32) : i32 {
    if (key == 0) { return -1; }
    let i: i32 = 0;
    while (i < g_aui_text_used) {
        if (g_aui_text_key[i] == key) { return i; }
        i = i + 1;
    }
    if (create == 0 || g_aui_text_used >= AUI_TEXT_CAP) { return -1; }
    let idx: i32 = g_aui_text_used;
    g_aui_text_key[idx] = key;
    g_aui_text_len[idx] = 0;
    store_u8(g_aui_text_pool + idx * AUI_TEXT_SLOT, 0);
    g_aui_text_used = idx + 1;
    return idx;
}

fn text_len_of(key: i32) : i32 {
    let idx: i32 = text_slot(key, 0);
    if (idx < 0) { return 0; }
    return g_aui_text_len[idx];
}

fn text_append(key: i32, ch: i32) : i32 {
    let idx: i32 = text_slot(key, 1);
    if (idx < 0) { return -1; }
    let n: i32 = g_aui_text_len[idx];
    // v1.16：ch 是 Unicode 码点，按 UTF-8 写入；中文可以直接通过 API
    // 追加（画不出来则取决于是否注入了回退字体）。
    let need: i32 = 1;
    if (ch >= 128) { need = 2; }
    if (ch >= 2048) { need = 3; }
    if (ch >= 65536) { need = 4; }
    if (n + need > AUI_TEXT_MAX) { return -1; }
    let base: ptr = g_aui_text_pool + idx * AUI_TEXT_SLOT;
    if (need == 1) {
        store_u8(base + n, ch & 255);
    } else if (need == 2) {
        store_u8(base + n + 0, 192 | ((ch >> 6) & 31));
        store_u8(base + n + 1, 128 | (ch & 63));
    } else if (need == 3) {
        store_u8(base + n + 0, 224 | ((ch >> 12) & 15));
        store_u8(base + n + 1, 128 | ((ch >> 6) & 63));
        store_u8(base + n + 2, 128 | (ch & 63));
    } else {
        store_u8(base + n + 0, 240 | ((ch >> 18) & 7));
        store_u8(base + n + 1, 128 | ((ch >> 12) & 63));
        store_u8(base + n + 2, 128 | ((ch >> 6) & 63));
        store_u8(base + n + 3, 128 | (ch & 63));
    }
    store_u8(base + n + need, 0);
    g_aui_text_len[idx] = n + need;
    return 0;
}

fn text_backspace(key: i32) : i32 {
    let idx: i32 = text_slot(key, 0);
    if (idx < 0) { return -1; }
    let n: i32 = g_aui_text_len[idx];
    if (n <= 0) { return -1; }
    let base: ptr = g_aui_text_pool + idx * AUI_TEXT_SLOT;
    // 删掉最后一个 UTF-8 码点的全部续字节，而不是只删 1 个字节。
    n = n - 1;
    while (n > 0 && (load_u8(base + n) & 192) == 128) {
        n = n - 1;
    }
    store_u8(base + n, 0);
    g_aui_text_len[idx] = n;
    return 0;
}

fn text_clear(key: i32) : i32 {
    let idx: i32 = text_slot(key, 0);
    if (idx < 0) { return -1; }
    g_aui_text_len[idx] = 0;
    store_u8(g_aui_text_pool + idx * AUI_TEXT_SLOT, 0);
    return 0;
}

fn text_set(key: i32, src: ptr, count: i32) : i32 {
    let idx: i32 = text_slot(key, 1);
    if (idx < 0) { return -1; }
    let base: ptr = g_aui_text_pool + idx * AUI_TEXT_SLOT;
    let n: i32 = 0;
    while (n < count && n < AUI_TEXT_MAX) {
        store_u8(base + n, load_u8(src + n));
        n = n + 1;
    }
    store_u8(base + n, 0);
    g_aui_text_len[idx] = n;
    return 0;
}

// ---- 自绘键盘（v1.7）----
// 所有标签都写成字节数组：库内不能出现字符串字面量，否则会和应用里的
// __aster_string_0 重名（Aster 的字符串符号按目标文件编号）。
fn kb_init() : i32 {
    if (g_aui_kb_ready != 0) { return 0; }
    store_u8(g_aui_kb_q1 + 0, 113); store_u8(g_aui_kb_q1 + 1, 119);
    store_u8(g_aui_kb_q1 + 2, 101); store_u8(g_aui_kb_q1 + 3, 114);
    store_u8(g_aui_kb_q1 + 4, 116); store_u8(g_aui_kb_q1 + 5, 121);
    store_u8(g_aui_kb_q1 + 6, 117); store_u8(g_aui_kb_q1 + 7, 105);
    store_u8(g_aui_kb_q1 + 8, 111); store_u8(g_aui_kb_q1 + 9, 112);
    store_u8(g_aui_kb_q1 + 10, 0);

    store_u8(g_aui_kb_q2 + 0, 97);  store_u8(g_aui_kb_q2 + 1, 115);
    store_u8(g_aui_kb_q2 + 2, 100); store_u8(g_aui_kb_q2 + 3, 102);
    store_u8(g_aui_kb_q2 + 4, 103); store_u8(g_aui_kb_q2 + 5, 104);
    store_u8(g_aui_kb_q2 + 6, 106); store_u8(g_aui_kb_q2 + 7, 107);
    store_u8(g_aui_kb_q2 + 8, 108); store_u8(g_aui_kb_q2 + 9, 0);

    store_u8(g_aui_kb_q3 + 0, 122); store_u8(g_aui_kb_q3 + 1, 120);
    store_u8(g_aui_kb_q3 + 2, 99);  store_u8(g_aui_kb_q3 + 3, 118);
    store_u8(g_aui_kb_q3 + 4, 98);  store_u8(g_aui_kb_q3 + 5, 110);
    store_u8(g_aui_kb_q3 + 6, 109); store_u8(g_aui_kb_q3 + 7, 0);

    store_u8(g_aui_kb_d1 + 0, 49); store_u8(g_aui_kb_d1 + 1, 50);
    store_u8(g_aui_kb_d1 + 2, 51); store_u8(g_aui_kb_d1 + 3, 52);
    store_u8(g_aui_kb_d1 + 4, 53); store_u8(g_aui_kb_d1 + 5, 54);
    store_u8(g_aui_kb_d1 + 6, 55); store_u8(g_aui_kb_d1 + 7, 56);
    store_u8(g_aui_kb_d1 + 8, 57); store_u8(g_aui_kb_d1 + 9, 48);
    store_u8(g_aui_kb_d1 + 10, 0);

    store_u8(g_aui_kb_d2 + 0, 45); store_u8(g_aui_kb_d2 + 1, 47);
    store_u8(g_aui_kb_d2 + 2, 58); store_u8(g_aui_kb_d2 + 3, 59);
    store_u8(g_aui_kb_d2 + 4, 40); store_u8(g_aui_kb_d2 + 5, 41);
    store_u8(g_aui_kb_d2 + 6, 36); store_u8(g_aui_kb_d2 + 7, 38);
    store_u8(g_aui_kb_d2 + 8, 64); store_u8(g_aui_kb_d2 + 9, 0);

    store_u8(g_aui_kb_d3 + 0, 46); store_u8(g_aui_kb_d3 + 1, 44);
    store_u8(g_aui_kb_d3 + 2, 63); store_u8(g_aui_kb_d3 + 3, 33);
    store_u8(g_aui_kb_d3 + 4, 39); store_u8(g_aui_kb_d3 + 5, 91);
    store_u8(g_aui_kb_d3 + 6, 93); store_u8(g_aui_kb_d3 + 7, 123);
    store_u8(g_aui_kb_d3 + 8, 125); store_u8(g_aui_kb_d3 + 9, 35);
    store_u8(g_aui_kb_d3 + 10, 0);

    store_u8(g_aui_kb_done + 0, 68); store_u8(g_aui_kb_done + 1, 79);
    store_u8(g_aui_kb_done + 2, 78); store_u8(g_aui_kb_done + 3, 69);
    store_u8(g_aui_kb_done + 4, 0);
    store_u8(g_aui_kb_abc + 0, 65); store_u8(g_aui_kb_abc + 1, 66);
    store_u8(g_aui_kb_abc + 2, 67); store_u8(g_aui_kb_abc + 3, 0);
    store_u8(g_aui_kb_num + 0, 49); store_u8(g_aui_kb_num + 1, 50);
    store_u8(g_aui_kb_num + 2, 51); store_u8(g_aui_kb_num + 3, 0);
    store_u8(g_aui_kb_space + 0, 83); store_u8(g_aui_kb_space + 1, 80);
    store_u8(g_aui_kb_space + 2, 65); store_u8(g_aui_kb_space + 3, 67);
    store_u8(g_aui_kb_space + 4, 69); store_u8(g_aui_kb_space + 5, 0);
    g_aui_kb_ready = 1;
    return 0;
}

fn kb_key_w(key: i32, code: i32, wgt: i32) : i32 {
    let k: i32 = aui_key(key, code);
    let w: i32 = aui_weight(wgt);
    return k;
}

fn kb_row_text(rkey: i32, s: ptr, n: i32, base: i32) : i32 {
    let r: i32 = aui_row(rkey);
    let g: i32 = aui_gap(4);
    let i: i32 = 0;
    while (i < n) {
        let k: i32 = kb_key_w(base + i, load_u8(s + i), 1);
        i = i + 1;
    }
    let e: i32 = aui_end();
    return 0;
}

fn kb_row_text_del(rkey: i32, s: ptr, n: i32, base: i32, dkey: i32) : i32 {
    let r: i32 = aui_row(rkey);
    let g: i32 = aui_gap(4);
    let i: i32 = 0;
    while (i < n) {
        let k: i32 = kb_key_w(base + i, load_u8(s + i), 1);
        i = i + 1;
    }
    let d: i32 = kb_key_w(dkey, 8, 1);
    let e: i32 = aui_end();
    return 0;
}

fn kb_row_letters3(rkey: i32) : i32 {
    let r: i32 = aui_row(rkey);
    let g: i32 = aui_gap(4);
    let sh: i32 = kb_key_w(9040, 16, 2);
    let i: i32 = 0;
    while (i < 7) {
        let k: i32 = kb_key_w(9041 + i, load_u8(g_aui_kb_q3 + i), 1);
        i = i + 1;
    }
    let c: i32 = kb_key_w(9048, 44, 1);
    let d: i32 = kb_key_w(9049, 46, 1);
    let e: i32 = aui_end();
    return 0;
}

fn kb_row_digits3(rkey: i32) : i32 {
    let r: i32 = aui_row(rkey);
    let g: i32 = aui_gap(4);
    let i: i32 = 0;
    while (i < 10) {
        let k: i32 = kb_key_w(9040 + i, load_u8(g_aui_kb_d3 + i), 1);
        i = i + 1;
    }
    let e: i32 = aui_end();
    return 0;
}

fn kb_row_bottom(rkey: i32) : i32 {
    let r: i32 = aui_row(rkey);
    let g: i32 = aui_gap(4);
    let m: i32 = kb_key_w(9060, 17, 2);
    let s: i32 = kb_key_w(9061, 32, 4);
    let d: i32 = kb_key_w(9062, 13, 2);
    let e: i32 = aui_end();
    return 0;
}

fn aui_keyboard(target: i32) : i32 {
    let init: i32 = kb_init();
    g_aui_kb_target = target;
    let c: i32 = aui_column(7000);
    let p: i32 = aui_pad(4);
    let g: i32 = aui_gap(4);
    let b: i32 = aui_bg(theme_kb_bg());
    if (g_aui_kb_mode == 0) {
        let r1: i32 = kb_row_text(7001, g_aui_kb_q1, 10, 9000);
        let r2: i32 = kb_row_text_del(7002, g_aui_kb_q2, 9, 9020, 9029);
        let r3: i32 = kb_row_letters3(7003);
    } else {
        let r1: i32 = kb_row_text(7001, g_aui_kb_d1, 10, 9000);
        let r2: i32 = kb_row_text_del(7002, g_aui_kb_d2, 9, 9020, 9029);
        let r3: i32 = kb_row_digits3(7003);
    }
    let r4: i32 = kb_row_bottom(7004);
    let e: i32 = aui_end();
    return 0;
}

fn kb_activate(code: i32) : i32 {
    let t: i32 = g_aui_kb_target;
    if (code == 8) {
        let r: i32 = text_backspace(t);
    } else if (code == 13) {
        let f: i32 = aui_focus(0);
    } else if (code == 16) {
        g_aui_kb_shift = 1 - g_aui_kb_shift;
        aui_invalidate_layout();
    } else if (code == 17) {
        g_aui_kb_mode = 1 - g_aui_kb_mode;
        aui_invalidate_layout();
    } else {
        let ch: i32 = code;
        if (g_aui_kb_mode == 0 && g_aui_kb_shift != 0 && ch >= 97 && ch <= 122) {
            ch = ch - 32;
        }
        let r: i32 = text_append(t, ch);
        aui_invalidate_layout();
    }
    return 0;
}

// ===========================================================================
// 5. 布局
// ===========================================================================

fn measure(i: i32, avail: i32) : i32 {
    let n: ptr<AuiNode> = node_at(i);
    let k: i32 = n.kind;
    // v2.15：按本节点的角色置排版样式（label/button 才读 aux2，其余
    // 种类按 Body；见 text_style_for_node）。子 measure 会在入口重设，
    // 本函数返回后调用者不再用文本函数，所以不用恢复。
    let rs: i32 = text_style_for_node(n);
    // D-2a：固定宽约束进量出输入（文本按固定宽换行）。
    if (g_d2a_size_w[i] >= 0) { avail = dp2q(g_d2a_size_w[i]); }
    let h: i32 = 0;
    let matched: i32 = 0;
    if (k == 5) { h = measure_text(n, avail); matched = 1; }
    if (k == 6) { h = measure_button(n, avail); matched = 1; }
    if (k == 10) { h = measure_field(n, avail); matched = 1; }
    if (k == 11) { h = measure_key(n, avail); matched = 1; }
    if (k == 12) { h = measure_switch(n, avail); matched = 1; }
    if (k == 13) { h = measure_progress(n, avail); matched = 1; }
    if (k == 14) { h = measure_check(n, avail); matched = 1; }
    if (k == 15) { h = measure_check(n, avail); matched = 1; }
    if (k == 30) { h = measure_chip(n, avail); matched = 1; }
    if (k == 31) { h = measure_circle(n, avail); matched = 1; }
    if (k == 16) { h = measure_slider(n, avail); matched = 1; }
    if (k == 17) { h = measure_segmented(n, avail); matched = 1; }
    if (k == 18) { h = measure_segment(n, avail); matched = 1; }
    if (k == 19) { h = measure_tabs(n, avail); matched = 1; }
    if (k == 20) { h = measure_tab(n, avail); matched = 1; }
    if (k == 21) { h = measure_pager(n, avail); matched = 1; }
    if (k == 22) { h = measure_page(n, avail); matched = 1; }
    if (k == 24) { h = measure_column(n, avail); matched = 1; }
    if (k == 25) { h = measure_select(n, avail); matched = 1; }
    if (k == 26) { n.w = 0; n.h = dp2q(48); h = n.h; matched = 1; }
    if (k == 27) { h = measure_date(n, avail); matched = 1; }
    if (k == 28) { h = measure_time(n, avail); matched = 1; }
    if (k == 7) { h = measure_spacer(n, avail); matched = 1; }
    if (k == 8) { h = measure_image(n, avail); matched = 1; }
    if (k == 3) { h = measure_row(n, avail); matched = 1; }
    if (k == 4) { h = measure_stack(n, avail); matched = 1; }
    if (k == 9) { h = measure_scroll(n, avail); matched = 1; }
    if (k == 29) { h = measure_scroll(n, avail); matched = 1; }
    if (k == 32) { h = measure_tree(n, avail); matched = 1; }
    if (k == 37) { h = measure_icon_button(n, avail); matched = 1; }
    if (k == 38) { h = measure_icon(n, avail); matched = 1; }
    if (k == 39) { h = measure_flow(n, avail); matched = 1; }
    if (k == 40) { h = measure_divider(n, avail); matched = 1; }
    if (k == 44) { h = measure_top_bar(n, avail); matched = 1; }
    if (k == 45) { h = measure_nav_bar(n, avail); matched = 1; }
    if (k == 46) { h = measure_nav_item(n, avail); matched = 1; }
    if (k == 47) { h = measure_nav_pane(n, avail); matched = 1; }
    if (k == 48) { h = measure_nav_pane_item(n, avail); matched = 1; }
    if (k == 49) { h = measure_combo(n, avail); matched = 1; }
    if (k == 50) { n.w = 0; n.h = dp2q(48); h = n.h; matched = 1; }
    if (k == 51) { h = measure_vlist(n, avail); matched = 1; }
    if (k == 52) { h = measure_vlist_row(n, avail); matched = 1; }
    if (k == 58) { h = measure_vlist_var(n, avail); matched = 1; }
    if (k == 59) { h = measure_vlist_var_row(n, avail); matched = 1; }
    if (k == 60) { h = measure_badge(n, avail); matched = 1; }
    if (k == 61) { h = measure_split(n, avail); matched = 1; }
    if (k == 53) { h = measure_vgrid(n, avail); matched = 1; }
    if (k == 54) { h = measure_vgrid_cell(n, avail); matched = 1; }
    if (k == 63) { h = measure_vtable(n, avail); matched = 1; }
    if (k == 64) { h = measure_vtable_cell(n, avail); matched = 1; }
    if (k == 55) { h = measure_hlist(n, avail); matched = 1; }
    if (k == 56) { h = measure_hlist_item(n, avail); matched = 1; }
    if (k == 57) { h = measure_canvas(n, avail); matched = 1; }
    if (matched == 0) { h = measure_column(n, avail); }
    // D-2a：固定尺寸出口覆写；未设置时与现行逐字节一致。
    if (g_d2a_size_w[i] >= 0) { n.w = dp2q(g_d2a_size_w[i]); }
    if (g_d2a_size_h[i] >= 0) { n.h = dp2q(g_d2a_size_h[i]); h = n.h; }
    return h;
}

fn measure_text(n: ptr<AuiNode>, avail: i32) : i32 {
    let tlen: i32 = n.aux;
    if (tlen < 0) { tlen = str_len(n.text); }
    let inner: i32 = avail - n.pad * 2;
    let w: i32 = text_measure(n.text, tlen, inner);
    n.w = w + n.pad * 2;
    n.h = text_line_h() * g_aui_mlines + n.pad * 2;
    return n.h;
}

fn measure_button(n: ptr<AuiNode>, avail: i32) : i32 {
    let tlen: i32 = str_len(n.text);
    let tw: i32 = text_measure(n.text, tlen, 0);
    n.w = tw + dp2q(aui_space(AUI_SPACE_LG)) + n.pad * 2;
    let th: i32 = text_line_h() + dp2q(aui_space(AUI_SPACE_MD));
    let mn: i32 = dp2q(44);
    if (th < mn) { th = mn; }
    n.h = th + n.pad * 2;
    return n.h;
}

// v1.36：图标按钮是正方形触控块（默认 40 dp），图形在绘制时按一半算。
fn measure_icon_button(n: ptr<AuiNode>, avail: i32) : i32 {
    let sz: i32 = n.aux2;
    if (sz <= 0) { sz = dp2q(40); }
    n.w = sz;
    n.h = sz;
    return n.h;
}

// v1.36：只读图标按 size + 内边距占位；长宽相等，便于行/列对齐。
fn measure_icon(n: ptr<AuiNode>, avail: i32) : i32 {
    let sz: i32 = n.aux2;
    if (sz <= 0) { sz = dp2q(20); }
    n.w = sz + n.pad * 2;
    n.h = sz + n.pad * 2;
    return n.h;
}

// v1.37：流式布局（对照 HuxerUI Flow）。子项先按“行内可用宽”测量，
// 依次往当前行放；放不下（已有子项）就换行。行高取本行最高子项，
// 容器高 = 各行高 + gap × (行数-1) + 上下内边距。宽度铺满可用宽度，
// 没有可用宽度时取最宽行（与 column/row 的规则一致）。
// 行数写入 aux，供 aui_debug_flow 使用。
fn measure_flow(n: ptr<AuiNode>, avail: i32) : i32 {
    let inner: i32 = avail - n.pad * 2;
    if (inner < 0) { inner = 0; }
    let gap: i32 = n.gap;
    if (gap < 0) { gap = 0; }
    let total: i32 = n.pad * 2;
    let line_w: i32 = 0;
    let line_h: i32 = 0;
    let line_n: i32 = 0;
    let lines: i32 = 0;
    let maxw: i32 = 0;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let ch: i32 = measure(c, inner);
        if (line_n > 0 && line_w + gap + cn.w > inner) {
            total = total + line_h;
            lines = lines + 1;
            if (line_w > maxw) { maxw = line_w; }
            line_w = 0;
            line_h = 0;
            line_n = 0;
        }
        if (line_n > 0) { line_w = line_w + gap; }
        line_w = line_w + cn.w;
        if (cn.h > line_h) { line_h = cn.h; }
        line_n = line_n + 1;
        c = cn.next_sibling;
    }
    if (line_n > 0) {
        total = total + line_h;
        lines = lines + 1;
        if (line_w > maxw) { maxw = line_w; }
    }
    if (lines > 1) { total = total + gap * (lines - 1); }
    n.aux = lines;
    n.h = total;
    if (avail > 0) { n.w = avail; } else { n.w = maxw + n.pad * 2; }
    return n.h;
}

// v1.37：分隔线。水平线铺满可用宽度；垂直线宽 = 粗细，固有高 24 dp
// （默认 align = 3，父容器会把它拉伸到行高/列宽）。
fn measure_divider(n: ptr<AuiNode>, avail: i32) : i32 {
    let th: i32 = n.aux2;
    if (th <= 0) { th = dp2q(1); }
    if (n.aux == 1) {
        n.w = th + n.pad * 2;
        n.h = dp2q(24) + n.pad * 2;
    } else {
        if (avail > 0) { n.w = avail; } else { n.w = th + n.pad * 2; }
        n.h = th + n.pad * 2;
    }
    return n.h;
}

// v1.40：顶部应用栏几何辅助。左右内边距默认 8 dp（aui_pad 可覆盖），
// 标题只取第一行（换行符之前）。leading 是自动创建、带 AUI_TB_LEADING
// 标记的图标按钮；其余子项都算右侧动作。
fn top_bar_hp(n: ptr<AuiNode>) : i32 {
    let hp: i32 = n.pad;
    if (hp <= 0) { hp = dp2q(8); }
    return hp;
}

fn top_bar_title_len(n: ptr<AuiNode>) : i32 {
    let tlen: i32 = n.aux;
    if (tlen < 0) { tlen = str_len(n.text); }
    let i: i32 = 0;
    while (i < tlen) {
        if (load_u8(n.text + i) == 10) { return i; }
        i = i + 1;
    }
    return tlen;
}

// 标题加粗用 1 个“半 dp”的重复描边（至少 1 px）。
fn top_bar_bold_off() : i32 {
    let b: i32 = dp2q(1) / 2;
    if (b < 65536) { b = 65536; }
    return b;
}

fn top_bar_leading(n: ptr<AuiNode>) : i32 {
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        if ((cn.flags & AUI_TB_LEADING) != 0) { return c; }
        c = cn.next_sibling;
    }
    return -1;
}

fn top_bar_action_count(n: ptr<AuiNode>) : i32 {
    let cnt: i32 = 0;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        if ((cn.flags & AUI_TB_LEADING) == 0) { cnt = cnt + 1; }
        c = cn.next_sibling;
    }
    return cnt;
}

// 动作总宽（子项测量之后调用）：子项宽 + gap × (个数-1)。
fn top_bar_actions_w(n: ptr<AuiNode>) : i32 {
    let total: i32 = 0;
    let cnt: i32 = 0;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        if ((cn.flags & AUI_TB_LEADING) == 0) {
            if (cnt > 0) { total = total + n.gap; }
            total = total + cn.w;
            cnt = cnt + 1;
        }
        c = cn.next_sibling;
    }
    return total;
}

// 标题可用区间 [xs, xe]（Q16.16）。无 leading 时左缩进 16 dp；有 leading
// 时紧跟其后 4 dp。右端在动作区左侧再留 4 dp。
fn top_bar_title_rect(n: ptr<AuiNode>, out: ptr) : i32 {
    let hp: i32 = top_bar_hp(n);
    let inner_x: i32 = n.x + hp;
    let inner_r: i32 = n.x + n.w - hp;
    let xs: i32 = inner_x + dp2q(16);
    let lead: i32 = top_bar_leading(n);
    if (lead >= 0) {
        let ln: ptr<AuiNode> = node_at(lead);
        xs = inner_x + ln.w + dp2q(4);
    }
    let xe: i32 = inner_r - top_bar_actions_w(n) - dp2q(4);
    if (xe < xs) { xe = xs; }
    let p: ptr<i32> = out;
    p[0] = xs;
    p[1] = xe;
    return 0;
}

fn measure_top_bar(n: ptr<AuiNode>, avail: i32) : i32 {
    let hp: i32 = top_bar_hp(n);
    let inner: i32 = avail - hp * 2;
    if (inner < 0) { inner = 0; }
    let hh: i32 = dp2q(48);
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let ch: i32 = measure(c, inner);
        if (cn.h > hh) { hh = cn.h; }
        c = cn.next_sibling;
    }
    let lead: i32 = top_bar_leading(n);
    let leadw: i32 = 0;
    if (lead >= 0) { leadw = node_at(lead).w; }
    let tlen: i32 = top_bar_title_len(n);
    let tw: i32 = text_measure(n.text, tlen, 0) + top_bar_bold_off();
    let after: i32 = dp2q(16);
    if (lead >= 0) { after = dp2q(4); }
    let actw: i32 = top_bar_actions_w(n);
    n.h = hh;
    if (avail > 0) { n.w = avail; } else { n.w = hp * 2 + leadw + after + tw + actw; }
    return n.h;
}

// v1.41：导航项的内容块 = 指示胶囊 32 dp + 间距 4 dp + 一行文字。
fn nav_block_h() : i32 {
    return dp2q(32) + dp2q(4) + text_line_h();
}

fn nav_item_natural_w(n: ptr<AuiNode>) : i32 {
    let tlen: i32 = str_len(n.text);
    let tw: i32 = text_measure(n.text, tlen, 0);
    let iw: i32 = dp2q(56);
    if (tw > iw) { iw = tw; }
    let w: i32 = iw + dp2q(8);
    if (w < dp2q(64)) { w = dp2q(64); }
    return w;
}

fn measure_nav_item(n: ptr<AuiNode>, avail: i32) : i32 {
    n.w = nav_item_natural_w(n);
    let hh: i32 = nav_block_h();
    if (hh < dp2q(64)) { hh = dp2q(64); }
    n.h = hh;
    return n.h;
}

fn measure_nav_bar(n: ptr<AuiNode>, avail: i32) : i32 {
    let inner: i32 = avail - n.pad * 2;
    if (inner < 0) { inner = 0; }
    let hh: i32 = dp2q(64);
    let sumw: i32 = 0;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let ch: i32 = measure(c, inner);
        if (ch > hh) { hh = ch; }
        sumw = sumw + cn.w;
        c = cn.next_sibling;
    }
    n.h = hh + n.pad * 2;
    if (avail > 0) { n.w = avail; } else { n.w = sumw + n.pad * 2; }
    return n.h;
}

// v1.42：侧边导航栏的水平内边距。默认 8 dp，可用 aui_pad 覆盖；垂直方向
// 直接用 n.pad（默认 0），这样贴边的栏不会多出空白。
fn nav_pane_hp(n: ptr<AuiNode>) : i32 {
    if (n.pad > 0) { return n.pad; }
    return dp2q(8);
}

// v1.42：侧边导航项固定 48 dp 高、宽度由 arrange 决定。
fn measure_nav_pane_item(n: ptr<AuiNode>, avail: i32) : i32 {
    n.w = avail;
    if (n.w < 0) { n.w = 0; }
    n.h = dp2q(48);
    return n.h;
}

// v1.42：收缩态 72 dp、展开态 256 dp；高度 = 垂直内边距 + 所有项 + 间距。
// 宽度不跟随可用宽，否则放进行里会被拉满。
fn measure_nav_pane(n: ptr<AuiNode>, avail: i32) : i32 {
    let pw: i32 = dp2q(72);
    if ((n.flags & AUI_NAV_PANE_EXPANDED) != 0) { pw = dp2q(256); }
    n.w = pw;
    let inner: i32 = n.w - nav_pane_hp(n) * 2;
    if (inner < 0) { inner = 0; }
    let total: i32 = n.pad * 2;
    let cnt: i32 = 0;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let ch: i32 = measure(c, inner);
        total = total + ch;
        cnt = cnt + 1;
        c = cn.next_sibling;
    }
    if (cnt > 1) { total = total + n.gap * (cnt - 1); }
    n.h = total;
    return n.h;
}

fn measure_field(n: ptr<AuiNode>, avail: i32) : i32 {    if (avail > 0) { n.w = avail; } else { n.w = dp2q(240); }
    let th: i32 = text_line_h() + dp2q(20);
    let mn: i32 = dp2q(48);
    if (th < mn) { th = mn; }
    n.h = th + n.pad * 2;
    return n.h;
}

// v1.26：下拉触发器。高度同输入框（至少 48 dp），纵向容器里铺满宽度；
// 行/栈里按“文本 + 左 16 + 右箭头 + 右 16”取固有宽度。选项不参与测量。
fn measure_select(n: ptr<AuiNode>, avail: i32) : i32 {
    let s: ptr = n.text;
    let oi: i32 = select_opt_at(n, n.aux);
    if (oi >= 0) {
        let on: ptr<AuiNode> = node_at(oi);
        s = on.text;
    }
    let tw: i32 = text_measure(s, str_len(s), 0);
    let iw: i32 = tw + dp2q(16) + dp2q(10) + dp2q(16) + n.pad * 2;
    let mnw: i32 = dp2q(160);
    if (iw < mnw) { iw = mnw; }
    let th: i32 = text_line_h() + dp2q(20);
    let mn: i32 = dp2q(48);
    if (th < mn) { th = mn; }
    n.h = th + n.pad * 2;
    let pk: i32 = -1;
    if (n.parent >= 0) {
        let pn: ptr<AuiNode> = node_at(n.parent);
        pk = pn.kind;
    }
    if (avail > 0 && (pk == 1 || pk == 2 || pk == 9 || pk == 52 || pk == 59 || pk == 53 || pk == 54 || pk == 55 || pk == 56)) { n.w = avail; } else { n.w = iw; }
    return n.h;
}

// v1.44：组合框触发器。高度同输入框（行高 + 20 dp，至少 48 dp，再加
// 上下 pad）；纵向容器/根/滚动里铺满宽度，行/栈里按“提示文字 + 左右
// 内边距 + 右侧 10 dp 箭头槽”取固有宽度（至少 160 dp）。建议项不参与
// 测量，只在展开时由 combo_layout 摆放。
fn combo_text_ptr(n: ptr<AuiNode>) : ptr {
    let idx: i32 = text_slot(n.key, 0);
    if (idx < 0) { return g_aui_empty; }
    return g_aui_text_pool + idx * AUI_TEXT_SLOT;
}

fn combo_text_len(n: ptr<AuiNode>) : i32 {
    let idx: i32 = text_slot(n.key, 0);
    if (idx < 0) { return 0; }
    return g_aui_text_len[idx];
}

fn measure_combo(n: ptr<AuiNode>, avail: i32) : i32 {
    let tlen: i32 = combo_text_len(n);
    let s: ptr = combo_text_ptr(n);
    if (tlen <= 0) {
        s = n.text;
        tlen = str_len(s);
    }
    let tw: i32 = text_measure(s, tlen, 0);
    let iw: i32 = tw + n.pad * 2 + dp2q(16) + dp2q(10) + dp2q(16);
    let mnw: i32 = dp2q(160);
    if (iw < mnw) { iw = mnw; }
    let th: i32 = text_line_h() + dp2q(20);
    let mn: i32 = dp2q(48);
    if (th < mn) { th = mn; }
    n.h = th + n.pad * 2;
    let pk: i32 = -1;
    if (n.parent >= 0) {
        let pn: ptr<AuiNode> = node_at(n.parent);
        pk = pn.kind;
    }
    if (avail > 0 && (pk == 1 || pk == 2 || pk == 9 || pk == 52 || pk == 59 || pk == 53 || pk == 54 || pk == 55 || pk == 56)) { n.w = avail; } else { n.w = iw; }
    return n.h;
}

// v1.28：日期选择。纵向容器/根/滚动里铺满可用宽度，行/栈里取固有
// 宽度（7×32 dp 单元 + 12 dp 内边距 + 2 dp 间隔 = 260 dp）。高度 = 上下
// 内边距 + 44 dp 头 + 7 行单元 + 6 个间隔；单元最大 36 dp。
fn measure_date(n: ptr<AuiNode>, avail: i32) : i32 {
    let slot: i32 = n.aux;
    date_prepare(slot);
    let gap: i32 = n.gap;
    if (gap < 0) { gap = 0; }
    let iw: i32 = n.pad * 2 + dp2q(32) * 7 + gap * 6;
    let pk: i32 = -1;
    if (n.parent >= 0) {
        let pn: ptr<AuiNode> = node_at(n.parent);
        pk = pn.kind;
    }
    if (avail > 0 && (pk == 1 || pk == 2 || pk == 9 || pk == 52 || pk == 59 || pk == 53 || pk == 54 || pk == 55 || pk == 56)) { n.w = avail; } else { n.w = iw; }
    let cw: i32 = n.w - n.pad * 2;
    if (cw < 0) { cw = 0; }
    let cell: i32 = (cw - gap * 6) / 7;
    if (cell < 0) { cell = 0; }
    let mx: i32 = dp2q(36);
    if (cell > mx) { cell = mx; }
    n.h = n.pad * 2 + dp2q(44) + cell * 7 + gap * 6;
    return n.h;
}

// v1.29：时间选择。固有宽度 = 12 dp 内边距 ×2 + 208 dp 表盘（12 小时制
// 头部 196 dp 仍在表盘内）；纵向容器/根/滚动里撑满可用宽度。高度 =
// 内边距 + 52 dp 头 + 16 dp 间距 + 表盘直径（表盘随内容宽收缩）。
fn measure_time(n: ptr<AuiNode>, avail: i32) : i32 {
    let slot: i32 = n.aux;
    time_prepare(slot);
    let iw: i32 = n.pad * 2 + dp2q(208);
    let pk: i32 = -1;
    if (n.parent >= 0) {
        let pn: ptr<AuiNode> = node_at(n.parent);
        pk = pn.kind;
    }
    if (avail > 0 && (pk == 1 || pk == 2 || pk == 9 || pk == 52 || pk == 59 || pk == 53 || pk == 54 || pk == 55 || pk == 56)) { n.w = avail; } else { n.w = iw; }
    let cw: i32 = n.w - n.pad * 2;
    if (cw < 0) { cw = 0; }
    let dial: i32 = dp2q(208);
    if (dial > cw) { dial = cw; }
    n.h = n.pad * 2 + dp2q(52) + dp2q(16) + dial;
    return n.h;
}

// v1.17：开关固定 44x24 dp；轨道是半高圆角的胶囊，拇指是内缩 3 dp 的圆。
fn measure_switch(n: ptr<AuiNode>, avail: i32) : i32 {
    n.w = dp2q(44);
    n.h = dp2q(24);
    return n.h;
}

// v1.17：进度条撑满可用宽度（或 200 dp 兜底），高 8 dp。
fn measure_progress(n: ptr<AuiNode>, avail: i32) : i32 {
    if (avail > 0) { n.w = avail; } else { n.w = dp2q(200); }
    n.h = dp2q(8);
    return n.h;
}

// v1.20：复选框 / 单选框一行 = 20 dp 控件 + 8 dp 间距 + 单行标签。
// 纵向容器（根 / column / scroll）里自动撑满宽度，整行都可点；行 / 栈里
// 保持固有宽度，方便并排。标签不换行（同 HuxerUI 的 NoWrap）。
fn measure_check(n: ptr<AuiNode>, avail: i32) : i32 {
    let box: i32 = dp2q(20);
    let gap: i32 = dp2q(8);
    let tlen: i32 = n.aux;
    if (tlen < 0) { tlen = str_len(n.text); }
    let tw: i32 = text_measure(n.text, tlen, 0);
    let lh: i32 = text_line_h();
    n.h = lh;
    if (n.h < box) { n.h = box; }
    n.h = n.h + n.pad * 2;
    let w: i32 = n.pad * 2 + box + gap + tw;
    let pk: i32 = -1;
    if (n.parent >= 0) {
        let pn: ptr<AuiNode> = node_at(n.parent);
        pk = pn.kind;
    }
    if (avail > 0 && (pk == 1 || pk == 2 || pk == 9 || pk == 52 || pk == 59 || pk == 53 || pk == 54 || pk == 55 || pk == 56)) { n.w = avail; } else { n.w = w; }
    return n.h;
}

// v1.31：标签片是固有尺寸控件：宽 = 文字宽 + 32 dp（左右各 16 dp），
// 高 = max(28 dp, 行高 + 8 dp)。不随父容器拉伸 —— 行里并排、列里左对齐。
fn measure_chip(n: ptr<AuiNode>, avail: i32) : i32 {
    let tlen: i32 = n.aux;
    if (tlen < 0) { tlen = str_len(n.text); }
    let tw: i32 = text_measure(n.text, tlen, 0);
    n.w = tw + n.pad * 2;
    let th: i32 = text_line_h() + dp2q(8);
    let mn: i32 = dp2q(28);
    if (th < mn) { th = mn; }
    n.h = th;
    return n.h;
}

// v2.10：角标测量。文字模式：宽 = 文字宽 + 18 dp（左右各 9 dp），
// 高 = 行高 + 8 dp（上下各 4 dp）；数量模式 count <= 0 时零尺寸（隐藏）；
// 圆点模式：8 dp 正方形。
fn measure_badge(n: ptr<AuiNode>, avail: i32) : i32 {
    if (n.aux2 == 1 && n.gap <= 0) {
        n.w = 0;
        n.h = 0;
        return 0;
    }
    if (n.aux2 == 2) {
        n.w = dp2q(8);
        n.h = n.w;
        return n.h;
    }
    let tlen: i32 = n.aux;
    if (tlen < 0) { tlen = str_len(n.text); }
    let tw: i32 = text_measure(n.text, tlen, 0);
    n.w = tw + dp2q(18);
    n.h = text_line_h() + dp2q(8);
    return n.h;
}

// v1.32：环形进度是固有正方形（size × size）。和 Chip 一样不随父容器
// 拉伸；列里靠 align 摆放，行里按方块尺寸并排。
fn measure_circle(n: ptr<AuiNode>, avail: i32) : i32 {
    let sdp: i32 = n.aux2;
    if (sdp < 8) { sdp = 24; }
    n.w = dp2q(sdp);
    n.h = n.w;
    return n.h;
}

// v1.20：滑块撑满可用宽度（或 160 dp 兜底），高 32 dp（HuxerUI 的
// SliderStyle：width 160 / height 32 / track 4 / thumb 16）。
fn measure_slider(n: ptr<AuiNode>, avail: i32) : i32 {
    if (avail > 0) { n.w = avail; } else { n.w = dp2q(160); }
    n.h = dp2q(32);
    return n.h;
}

// v1.21：一段的固有尺寸：文字 + 左右 14 dp padding，高度 = 文字行高 +
// 14 dp，至少 32 dp（HuxerUI SegmentedButtonStyle：padding 14x7 /
// min height 32 / min segment width 48）。
fn measure_segment(n: ptr<AuiNode>, avail: i32) : i32 {
    let tlen: i32 = n.aux;
    if (tlen < 0) { tlen = str_len(n.text); }
    let tw: i32 = text_measure(n.text, tlen, 0);
    n.w = tw + dp2q(28);
    if (n.w < dp2q(48)) { n.w = dp2q(48); }
    n.h = text_line_h() + dp2q(14);
    if (n.h < dp2q(32)) { n.h = dp2q(32); }
    return n.h;
}

// 容器：高度取最高的一段；纵向容器里铺满宽度，横排时保持固有宽度。
fn measure_segmented(n: ptr<AuiNode>, avail: i32) : i32 {
    let inner: i32 = avail - n.pad * 2;
    if (inner < 0) { inner = 0; }
    let maxh: i32 = 0;
    let sumw: i32 = 0;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let ch: i32 = measure(c, inner);
        sumw = sumw + cn.w;
        if (ch > maxh) { maxh = ch; }
        c = cn.next_sibling;
    }
    n.h = maxh + n.pad * 2;
    if (n.h < dp2q(32)) { n.h = dp2q(32); }
    let pk: i32 = -1;
    if (n.parent >= 0) {
        let pn: ptr<AuiNode> = node_at(n.parent);
        pk = pn.kind;
    }
    if (avail > 0 && (pk == 1 || pk == 2 || pk == 9 || pk == 52 || pk == 59 || pk == 53 || pk == 54 || pk == 55 || pk == 56)) {
        n.w = avail;
    } else {
        n.w = sumw + n.pad * 2;
    }
    return n.h;
}

// v1.22：一页的固有尺寸：文字 + 左右 12 dp，最少 48 dp 宽；
// 高度 = 文字行高 + 16 dp，最少 36 dp（HuxerUI TabsStyle 默认值）。
fn measure_tab(n: ptr<AuiNode>, avail: i32) : i32 {
    let tlen: i32 = n.aux;
    if (tlen < 0) { tlen = str_len(n.text); }
    let tw: i32 = text_measure(n.text, tlen, 0);
    n.w = tw + dp2q(24);
    if (n.w < dp2q(48)) { n.w = dp2q(48); }
    n.h = text_line_h() + dp2q(16);
    if (n.h < dp2q(36)) { n.h = dp2q(36); }
    return n.h;
}

// 容器：高度取最高一页；纵向容器里铺满，横排时保持固有宽度。
// 与 HuxerUI expand_items=false 一致：不会把剩余宽度摊给各页。
fn measure_tabs(n: ptr<AuiNode>, avail: i32) : i32 {
    let inner: i32 = avail - n.pad * 2;
    if (inner < 0) { inner = 0; }
    let maxh: i32 = 0;
    let sumw: i32 = 0;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let ch: i32 = measure(c, inner);
        sumw = sumw + cn.w;
        if (ch > maxh) { maxh = ch; }
        c = cn.next_sibling;
    }
    n.h = maxh + n.pad * 2;
    if (n.h < dp2q(36)) { n.h = dp2q(36); }
    let pk: i32 = -1;
    if (n.parent >= 0) {
        let pn: ptr<AuiNode> = node_at(n.parent);
        pk = pn.kind;
    }
    if (avail > 0 && (pk == 1 || pk == 2 || pk == 9 || pk == 52 || pk == 59 || pk == 53 || pk == 54 || pk == 55 || pk == 56)) {
        n.w = avail;
    } else {
        n.w = sumw + n.pad * 2;
    }
    return n.h;
}

// v1.24：一页按列容器测量；分页容器再把它撑到视口宽高。
fn measure_page(n: ptr<AuiNode>, avail: i32) : i32 {
    return measure_column(n, avail);
}

// v1.24：分页容器。宽度取可用宽（同滚动容器），高度取最高一页；
// 页宽在 arrange 阶段统一成视口宽，页与页之间没有间隙。
fn measure_pager(n: ptr<AuiNode>, avail: i32) : i32 {
    let inner: i32 = avail - n.pad * 2;
    if (inner < 0) { inner = 0; }
    let maxh: i32 = 0;
    let maxw: i32 = 0;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let ch: i32 = measure(c, inner);
        if (ch > maxh) { maxh = ch; }
        if (cn.w > maxw) { maxw = cn.w; }
        c = cn.next_sibling;
    }
    n.h = maxh + n.pad * 2;
    if (avail > 0) {
        n.w = avail;
    } else {
        n.w = maxw + n.pad * 2;
    }
    return n.h;
}

fn measure_key(n: ptr<AuiNode>, avail: i32) : i32 {
    n.w = 0;                          // 由 row 的 weight 分配
    let th: i32 = text_line_h() + dp2q(14);
    let mn: i32 = dp2q(42);
    if (th < mn) { th = mn; }
    n.h = th;
    return n.h;
}

fn measure_spacer(n: ptr<AuiNode>, avail: i32) : i32 {
    n.w = 0;
    n.h = dp2q(n.aux);
    return n.h;
}

fn measure_image(n: ptr<AuiNode>, avail: i32) : i32 {
    let wdp: i32 = n.aux & 65535;
    let hdp: i32 = (n.aux >> 16) & 65535;
    n.w = dp2q(wdp);
    n.h = dp2q(hdp);
    return n.h;
}

// v2.6：Canvas 与 image 同一套固有尺寸编码；w_dp == 0 时宽为 0，
// 由 arrange 的 align == 3（stretch）或父容器改写。
fn measure_canvas(n: ptr<AuiNode>, avail: i32) : i32 {
    let wdp: i32 = n.aux & 65535;
    let hdp: i32 = (n.aux >> 16) & 65535;
    n.w = dp2q(wdp);
    n.h = dp2q(hdp);
    return n.h;
}

fn measure_column(n: ptr<AuiNode>, avail: i32) : i32 {
    let inner: i32 = avail - n.pad * 2;
    if (inner < 0) { inner = 0; }
    let total: i32 = n.pad * 2;
    let maxw: i32 = 0;
    let cnt: i32 = 0;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let ch: i32 = measure(c, inner);
        if (cn.w > maxw) { maxw = cn.w; }
        if (cn.weight == 0) { total = total + ch; }
        if (cn.weight > 0 || (cn.flags & AUI_HAS_WEIGHT_DESC) != 0) { n.flags = n.flags | AUI_HAS_WEIGHT_DESC; }
        // B25：子树含 scroll（kind 9 scroll / kind 29 refresh 容器，或已带标记）→ 上卷。
        if (cn.kind == 9 || cn.kind == 29 || (cn.flags & AUI_HAS_SCROLL_DESC) != 0) { n.flags = n.flags | AUI_HAS_SCROLL_DESC; }
        cnt = cnt + 1;
        c = cn.next_sibling;
    }
    if (cnt > 1) { total = total + n.gap * (cnt - 1); }
    n.h = total;
    if (avail > 0) { n.w = avail; } else { n.w = maxw + n.pad * 2; }
    return n.h;
}

fn measure_row(n: ptr<AuiNode>, avail: i32) : i32 {
    let inner: i32 = avail - n.pad * 2;
    if (inner < 0) { inner = 0; }
    let total: i32 = n.pad * 2;
    let maxh: i32 = 0;
    let cnt: i32 = 0;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let ch: i32 = measure(c, inner);
        if (cn.weight == 0) { total = total + cn.w; }
        if (ch > maxh) { maxh = ch; }
        if (cn.weight > 0 || (cn.flags & AUI_HAS_WEIGHT_DESC) != 0) { n.flags = n.flags | AUI_HAS_WEIGHT_DESC; }
        // B25：子树含 scroll（kind 9 scroll / kind 29 refresh 容器，或已带标记）→ 上卷。
        if (cn.kind == 9 || cn.kind == 29 || (cn.flags & AUI_HAS_SCROLL_DESC) != 0) { n.flags = n.flags | AUI_HAS_SCROLL_DESC; }
        cnt = cnt + 1;
        c = cn.next_sibling;
    }
    if (cnt > 1) { total = total + n.gap * (cnt - 1); }
    n.w = avail;
    n.h = maxh + n.pad * 2;
    return n.h;
}

fn measure_scroll(n: ptr<AuiNode>, avail: i32) : i32 {
    // 内容按 column 测量；n.aux 存内容总高（含内边距），供 arrange 算最大偏移。
    // B25：本节点自身就是 scroll（kind 9）/ refresh（kind 29）视口容器，
    // 直接带“子树含 scroll”标记——否则 weight-0 的 scroll 作为列的直接子项
    // 时，F1 永远认不出它（今天它只凭 weight 标记入选，收紧后会被误排除）。
    n.flags = n.flags | AUI_HAS_SCROLL_DESC;
    let inner: i32 = avail - n.pad * 2;
    if (inner < 0) { inner = 0; }
    let total: i32 = n.pad * 2;
    let cnt: i32 = 0;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let ch: i32 = measure(c, inner);
        total = total + ch;
        if (cn.weight > 0 || (cn.flags & AUI_HAS_WEIGHT_DESC) != 0) { n.flags = n.flags | AUI_HAS_WEIGHT_DESC; }
        // B25：子树含 scroll（kind 9 scroll / kind 29 refresh 容器，或已带标记）→ 上卷。
        if (cn.kind == 9 || cn.kind == 29 || (cn.flags & AUI_HAS_SCROLL_DESC) != 0) { n.flags = n.flags | AUI_HAS_SCROLL_DESC; }
        cnt = cnt + 1;
        c = cn.next_sibling;
    }
    if (cnt > 1) { total = total + n.gap * (cnt - 1); }
    n.aux = total;
    n.w = avail;
    // 固有高度 = 内容高度；只有视口高经 F1 下传到达本列时，arrange 才把高度覆写为视口剩余高。
    n.h = total;
    return n.h;
}

// v1.45：虚拟列表容器。内容总高由 count × 行高算出（aux = count，
// aux2 = 行高），只有窗口内的行节点存在；行本身按固定高度测量。
fn measure_vlist(n: ptr<AuiNode>, avail: i32) : i32 {
    let inner: i32 = avail - n.pad * 2;
    if (inner < 0) { inner = 0; }
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let ch: i32 = measure(c, inner);
        c = cn.next_sibling;
    }
    n.w = avail;
    // 固有高度 = 内容总高。超长列表会超过 i32 Q16.16，这里饱和到
    // 约 32760 px；实际使用时虚拟列表通常由 weight/固定高度约束。
    let ch64: i64 = i64(n.pad) * 2 + i64(n.aux) * i64(n.aux2);
    let cap: i32 = 32760 << 16;
    if (ch64 > i64(cap)) { n.h = cap; } else { n.h = i32(ch64); }
    return n.h;
}

// 一行：高度固定（aux 存行高），子节点按列排列；宽度由父容器给。
fn measure_vlist_row(n: ptr<AuiNode>, avail: i32) : i32 {
    let inner: i32 = avail - n.pad * 2;
    if (inner < 0) { inner = 0; }
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let ch: i32 = measure(c, inner);
        c = cn.next_sibling;
    }
    n.w = avail;
    n.h = n.aux;
    return n.h;
}

// v2.10：不定高列表容器。先做宽度检查（内容宽变了整表失效，文字换行
// 变了旧高度无意义），再量各行（行量完把高度写回缓存），固有高度 =
// 内容总高（与固定列表同口径饱和到约 32760 px）。
fn measure_vlist_var(n: ptr<AuiNode>, avail: i32) : i32 {
    let inner: i32 = avail - n.pad * 2;
    if (inner < 0) { inner = 0; }
    let s: i32 = vlist_find(n.key);
    if (s >= 0) {
        if (g_aui_vlvar_w[s] == 0) {
            g_aui_vlvar_w[s] = avail;
        } else if (g_aui_vlvar_w[s] != avail) {
            let c: i32 = vlvar_clear(s);
            g_aui_vlvar_w[s] = avail;
        }
    }
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let ch: i32 = measure(c, inner);
        c = cn.next_sibling;
    }
    n.w = avail;
    let estpx: i32 = n.aux2 >> 16;
    if (estpx < 1) { estpx = 1; }
    let total: i32 = vlvar_total(s, n.aux, estpx);
    // 固有高度口径与固定列表一致：pad*2 + 内容总高，饱和到约 32760 px；
    // 实际使用时虚拟列表通常由 weight/固定高度约束。
    let ch64: i64 = i64(n.pad) * 2 + i64(total) * 65536;
    let cap: i32 = 32760 << 16;
    if (ch64 > i64(cap)) { n.h = cap; } else { n.h = i32(ch64); }
    return n.h;
}

// v2.10：不定高行：按列量内容（子节点高度和 + 间距 + 内边距），高度
// 写回缓存只写一次——已缓存的项不再重写（内容变了走 invalidate）。
// 行高取缓存值（本帧新量的等于刚写的值），保证布局稳定；最小 1 px。
fn measure_vlist_var_row(n: ptr<AuiNode>, avail: i32) : i32 {
    let inner: i32 = avail - n.pad * 2;
    if (inner < 0) { inner = 0; }
    let total: i32 = n.pad * 2;
    let cnt: i32 = 0;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let ch: i32 = measure(c, inner);
        if (cn.weight == 0) { total = total + ch; }
        cnt = cnt + 1;
        c = cn.next_sibling;
    }
    if (cnt > 1) { total = total + n.gap * (cnt - 1); }
    let hpx: i32 = total >> 16;
    if (hpx < 1) { hpx = 1; }
    // 写回缓存：父容器 key → 登记槽；只写未测量的项。
    let idx: i32 = n.aux2;
    let pn: i32 = n.parent;
    if (pn >= 0) {
        let pnod: ptr<AuiNode> = node_at(pn);
        let s: i32 = vlist_find(pnod.key);
        if (s >= 0 && idx >= 0 && idx < AUI_VLVAR_HCAP) {
            let base: i32 = s * AUI_VLVAR_HCAP + idx;
            if (g_aui_vlvar_h[base] <= 0) {
                g_aui_vlvar_h[base] = hpx;
                g_aui_vlvar_writes[s] = g_aui_vlvar_writes[s] + 1;
            }
            hpx = g_aui_vlvar_h[base];
        }
    }
    n.w = avail;
    n.h = hpx << 16;
    return n.h;
}

// v1.46：虚拟网格的列数/格宽/内容高。请求列数在 flags 低 16 位；
// 自适应时按最小格宽算，行/列间距都用节点 gap。
fn vgrid_req_cols(n: ptr<AuiNode>) : i32 { return n.flags & 65535; }
fn vgrid_min_dp(n: ptr<AuiNode>) : i32 { return (n.flags >> 16) & 65535; }

fn vgrid_cols_for(n: ptr<AuiNode>, inner: i32) : i32 {
    let req: i32 = vgrid_req_cols(n);
    if (req > 0) { return req; }
    let minpx: i32 = fx_px(dp2q(vgrid_min_dp(n)));
    let gappx: i32 = n.gap >> 16;
    if (gappx < 0) { gappx = 0; }
    let den: i32 = minpx + gappx;
    let inpx: i32 = inner >> 16;
    let base: i32 = inpx;
    if (base < 0) { base = 0; }
    if (den <= 0) { return 1; }
    let c: i32 = (base + gappx) / den;
    if (c < 1) { c = 1; }
    if (c > 4096) { c = 4096; }
    return c;
}

fn vgrid_cellw(n: ptr<AuiNode>, inner: i32, cols: i32) : i32 {
    if (cols < 1) { cols = 1; }
    let gaps: i32 = 0;
    if (cols > 1) { gaps = n.gap * (cols - 1); }
    let w: i32 = inner - gaps;
    if (w < 0) { w = 0; }
    return w / cols;
}

// 内容总高，Q16.16；超长时饱和到约 32760 px（与虚拟列表一致）。
fn vgrid_content_q(n: ptr<AuiNode>, cols: i32) : i32 {
    if (cols < 1) { cols = 1; }
    let rows: i32 = 0;
    if (n.aux > 0) { rows = (n.aux + cols - 1) / cols; }
    let g64: i64 = 0;
    if (rows > 1) { g64 = i64(rows - 1) * i64(n.gap); }
    let t: i64 = i64(n.pad) * 2 + i64(rows) * i64(n.aux2) + g64;
    let cap: i32 = 32760 << 16;
    if (t > i64(cap)) { return cap; }
    if (t < 0) { return 0; }
    return i32(t);
}

fn vgrid_content_px(n: ptr<AuiNode>, cols: i32) : i32 {
    let q: i32 = vgrid_content_q(n, cols);
    let p: i32 = q >> 16;
    if (p < 0) { p = 0; }
    return p;
}

// v1.46：虚拟网格容器。格子宽按列数均分；测量时用同一个格宽，
// 保证文本换行与最终布局一致。
fn measure_vgrid(n: ptr<AuiNode>, avail: i32) : i32 {
    let inner: i32 = avail - n.pad * 2;
    if (inner < 0) { inner = 0; }
    let cols: i32 = vgrid_cols_for(n, inner);
    let cw: i32 = vgrid_cellw(n, inner, cols);
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let ch: i32 = measure(c, cw);
        c = cn.next_sibling;
    }
    n.w = avail;
    n.h = vgrid_content_q(n, cols);
    return n.h;
}

// 一个格子：高度固定（aux 存行高），内容按列容器排。
fn measure_vgrid_cell(n: ptr<AuiNode>, avail: i32) : i32 {
    let inner: i32 = avail - n.pad * 2;
    if (inner < 0) { inner = 0; }
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let ch: i32 = measure(c, inner);
        c = cn.next_sibling;
    }
    n.w = avail;
    n.h = n.aux;
    return n.h;
}

// v2.17：虚拟表格容器。固有高度 = 表头 + 各行（行高固定），固有宽度
// 铺满可用宽；每个子格按自己那列的列宽量。
fn measure_vtable(n: ptr<AuiNode>, avail: i32) : i32 {
    let rows: i32 = n.aux;
    let rh: i32 = n.aux2;
    let s: i32 = vtable_find(n.key);
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let cw: i32 = vtable_colw_q(s, cn.aux2);
        let ch: i32 = measure(c, cw);
        c = cn.next_sibling;
    }
    n.w = avail;
    let cpx64: i64 = i64(rows + 1) * i64(rh);
    if (cpx64 > 2000000000 * 65536) { n.h = 2000000000 * 65536; }
    else { n.h = i32(cpx64); }
    return n.h;
}

// 一个表格格子：高度固定（flags 存行高，建格时写入），内容按列容器排。
fn measure_vtable_cell(n: ptr<AuiNode>, avail: i32) : i32 {
    let inner: i32 = avail - n.pad * 2;
    if (inner < 0) { inner = 0; }
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let ch: i32 = measure(c, inner);
        c = cn.next_sibling;
    }
    n.w = avail;
    n.h = n.flags;
    return n.h;
}

// v1.47：横向虚拟列表容器。项宽固定（aux2），项高 flags > 0 时固定，
// 否则取子项内容高的最大值；固有宽度铺满可用宽。
fn measure_hlist(n: ptr<AuiNode>, avail: i32) : i32 {
    let iw: i32 = n.aux2;
    let ih: i32 = n.flags;
    let inner: i32 = iw - n.pad * 2;
    if (inner < 0) { inner = 0; }
    let maxh: i32 = 0;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let ch: i32 = measure(c, inner);
        if (ch > maxh) { maxh = ch; }
        c = cn.next_sibling;
    }
    n.w = avail;
    if (ih > 0) {
        n.h = ih + n.pad * 2;
    } else {
        n.h = maxh + n.pad * 2;
    }
    return n.h;
}

// 一项：宽度固定（aux），高度 flags > 0 时固定，否则取内容高。
fn measure_hlist_item(n: ptr<AuiNode>, avail: i32) : i32 {
    let inner: i32 = n.aux - n.pad * 2;
    if (inner < 0) { inner = 0; }
    let maxh: i32 = 0;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let ch: i32 = measure(c, inner);
        if (ch > maxh) { maxh = ch; }
        c = cn.next_sibling;
    }
    n.w = n.aux;
    if (n.flags > 0) { n.h = n.flags; } else { n.h = maxh + n.pad * 2; }
    return n.h;
}
// 内容区，内容总高存 aux 供 arrange 算最大偏移；语义与 scroll 一致。
fn measure_tree(n: ptr<AuiNode>, avail: i32) : i32 {
    let ext: i32 = n.aux2;
    let inner: i32 = avail - n.pad * 2;
    if (inner < 0) { inner = 0; }
    let total: i32 = n.pad * 2;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        cn.w = inner;
        cn.h = ext;
        total = total + ext;
        c = cn.next_sibling;
    }
    n.aux = total;
    n.w = avail;
    n.h = total;
    return n.h;
}

fn measure_stack(n: ptr<AuiNode>, avail: i32) : i32 {
    let inner: i32 = avail - n.pad * 2;
    if (inner < 0) { inner = 0; }
    let maxw: i32 = 0;
    let maxh: i32 = 0;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let ch: i32 = measure(c, inner);
        if (cn.w > maxw) { maxw = cn.w; }
        if (ch > maxh) { maxh = ch; }
        c = cn.next_sibling;
    }
    n.w = avail;
    n.h = maxh + n.pad * 2;
    return n.h;
}

fn arrange(i: i32, x: i32, y: i32, w: i32, h: i32) : i32 {
    let n: ptr<AuiNode> = node_at(i);
    n.x = x;
    n.y = y;
    n.w = w;
    n.h = h;
    let k: i32 = n.kind;
    if (k == 1 || k == 2) { return arrange_column(n); }
    if (k == 3) { return arrange_row(n); }
    if (k == 4) { return arrange_stack(n); }
    if (k == 9) { return arrange_scroll(n); }
    if (k == 29) { return arrange_refresh(n); }
    if (k == 32) { return arrange_tree(n); }
    if (k == 17) { return arrange_segmented(n); }
    if (k == 19) { return arrange_tabs(n); }
    if (k == 21) { return arrange_pager(n); }
    if (k == 22) { return arrange_page(n); }
    if (k == 24) { return arrange_column(n); }
    if (k == 42) { return arrange_column(n); }
    if (k == 43) { return arrange_column(n); }
    if (k == 25) { return arrange_select(n); }
    if (k == 49) { return arrange_combo(n); }
    if (k == 51) { return arrange_vlist(n); }
    if (k == 52) { return arrange_column(n); }
    if (k == 58) { return arrange_vlist_var(n); }
    if (k == 59) { return arrange_column(n); }
    if (k == 61) { return arrange_split(n); }
    if (k == 62) { return arrange_column(n); }   // v2.15：Theme 容器透明包装
    if (k == 53) { return arrange_vgrid(n); }
    if (k == 54) { return arrange_column(n); }
    if (k == 63) { return arrange_vtable(n); }
    if (k == 64) { return arrange_column(n); }
    if (k == 55) { return arrange_hlist(n); }
    if (k == 56) { return arrange_column(n); }
    if (k == 39) { return arrange_flow(n); }
    if (k == 44) { return arrange_top_bar(n); }
    if (k == 45) { return arrange_nav_bar(n); }
    if (k == 47) { return arrange_nav_pane(n); }
    return 0;
}

fn arrange_scroll(n: ptr<AuiNode>) : i32 {
    // 视口 = 节点自身；内容整体上移 offset。超出视口的部分由绘制命令的
    // clip 裁掉（光栅阶段丢弃），命中测试则靠父节点边界先卡住。
    let maxoff: i32 = n.aux - n.h;
    scroll_store_max(n.key, maxoff);
    let off: i32 = scroll_get(n.key);
    let cx: i32 = n.x + n.pad;
    let cy: i32 = n.y + n.pad - off;
    let cw: i32 = n.w - n.pad * 2;
    if (cw < 0) { cw = 0; }
    let cursor: i32 = cy;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let ccw: i32 = cn.w;
        let ccx: i32 = cx;
        if (cn.align == 3) {
            ccw = cw;
        } else if (cn.align == 1) {
            ccx = cx + (cw - cn.w) / 2;
        } else if (cn.align == 2) {
            ccx = cx + cw - cn.w;
        }
        let r: i32 = arrange(c, ccx, cursor, ccw, cn.h);
        cursor = cursor + cn.h + n.gap;
        c = cn.next_sibling;
    }
    return 0;
}

// v1.33：树的滚动/裁剪与 scroll 相同，只是行高固定、行间无间距。
fn arrange_tree(n: ptr<AuiNode>) : i32 {
    let maxoff: i32 = n.aux - n.h;
    scroll_store_max(n.key, maxoff);
    let off: i32 = scroll_get(n.key);
    let ext: i32 = n.aux2;
    let cx: i32 = n.x + n.pad;
    let cw: i32 = n.w - n.pad * 2;
    if (cw < 0) { cw = 0; }
    let cursor: i32 = n.y + n.pad - off;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let r: i32 = arrange(c, cx, cursor, cw, ext);
        cursor = cursor + ext;
        c = cn.next_sibling;
    }
    return 0;
}

// v1.30：下拉刷新容器。滚动偏移沿用 scroll 表（下拉时恒为 0），
// 额外把内容整体下移 disp；指示圈画在内容之上。
fn arrange_refresh(n: ptr<AuiNode>) : i32 {
    let maxoff: i32 = n.aux - n.h;
    scroll_store_max(n.key, maxoff);
    let off: i32 = scroll_get(n.key);
    let disp: i32 = ref_disp(n.key);
    let cx: i32 = n.x + n.pad;
    let cy: i32 = n.y + n.pad - off + disp;
    let cw: i32 = n.w - n.pad * 2;
    if (cw < 0) { cw = 0; }
    let cursor: i32 = cy;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let ccw: i32 = cn.w;
        let ccx: i32 = cx;
        if (cn.align == 3) {
            ccw = cw;
        } else if (cn.align == 1) {
            ccx = cx + (cw - cn.w) / 2;
        } else if (cn.align == 2) {
            ccx = cx + cw - cn.w;
        }
        let r: i32 = arrange(c, ccx, cursor, ccw, cn.h);
        cursor = cursor + cn.h + n.gap;
        c = cn.next_sibling;
    }
    return 0;
}

// v1.45：虚拟列表。行按绝对下标定位：y = 视口顶 + pad + idx*行高 - 偏移。
// 布局末尾校正窗口：视口高与 build 时的估计不同、或当前偏移依赖到
// 尚未构建的行时，置 need_build，下一拍重建（不在这里递归 pump）。
fn arrange_vlist(n: ptr<AuiNode>) : i32 {
    let count: i32 = n.aux;
    let ih: i32 = n.aux2;
    let ihpx: i32 = ih >> 16;
    if (ihpx < 1) { ihpx = 1; }
    // 内容/偏移都用像素整数（不是 Q16.16）：长列表可达数十万 px。
    let padpx: i32 = n.pad >> 16;
    let cpx: i32 = i32((i64(count) * i64(ih)) / 65536) + padpx * 2;
    let hpx: i32 = n.h >> 16;
    let maxoff: i32 = cpx - hpx;
    if (maxoff < 0) { maxoff = 0; }
    scroll_store_max(n.key, maxoff);
    let off: i32 = scroll_get(n.key);
    let cx: i32 = n.x + n.pad;
    let cw: i32 = n.w - n.pad * 2;
    if (cw < 0) { cw = 0; }
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let idx: i32 = cn.aux2;
        let ry: i32 = i32(i64(n.y) + i64(n.pad) + i64(idx) * i64(ih) - i64(off) * 65536);
        let r: i32 = arrange(c, cx, ry, cw, cn.aux);
        c = cn.next_sibling;
    }
    let s: i32 = vlist_find(n.key);
    if (s >= 0 && n.h > 0 && ihpx > 0) {
        let used: i32 = g_aui_vlist_used_vp[s];
        g_aui_vlist_vp[s] = n.h;
        let all: i32 = 0;
        if (g_aui_vlist_first[s] <= 0 && g_aui_vlist_last[s] >= count - 1) {
            all = 1;                       // 所有行都已构建，无需窗口校正
        }
        if (all == 0) {
            let first: i32 = off / ihpx - 1;
            if (first < 0) { first = 0; }
            let last: i32 = (off + hpx) / ihpx + 1;
            if (last > count - 1) { last = count - 1; }
            let need: i32 = 0;
            if (n.h != used) { need = 1; }
            if (first < g_aui_vlist_first[s]) { need = 1; }
            if (last > g_aui_vlist_last[s]) { need = 1; }
            if (need != 0) {
                g_aui_need_build = 1;
                g_aui_need_layout = 1;
                g_aui_pump_need = 1;
            }
        }
    }
    return 0;
}

// v2.10：不定高虚拟列表。行按绝对下标定位：
//   y = 容器内容顶 + prefix(idx) - 偏移
// prefix 每次现算（行高数组是现场值，measure 刚写回的高度本帧就生效，
// 不用等下一拍）。布局末尾与固定列表同口径做窗口校正：视口变了或窗口
// 不够就下一拍重建。
fn arrange_vlist_var(n: ptr<AuiNode>) : i32 {
    let count: i32 = n.aux;
    let est: i32 = n.aux2;
    let estpx: i32 = est >> 16;
    if (estpx < 1) { estpx = 1; }
    // 内容/偏移都用像素整数（不是 Q16.16）：长列表可达数十万 px。
    let padpx: i32 = n.pad >> 16;
    let s: i32 = vlist_find(n.key);
    let total: i32 = vlvar_total(s, count, estpx);
    let cpx: i32 = total + padpx * 2;
    let hpx: i32 = n.h >> 16;
    let maxoff: i32 = cpx - hpx;
    if (maxoff < 0) { maxoff = 0; }
    scroll_store_max(n.key, maxoff);
    let off: i32 = scroll_get(n.key);
    let cx: i32 = n.x + n.pad;
    let cw: i32 = n.w - n.pad * 2;
    if (cw < 0) { cw = 0; }
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let idx: i32 = cn.aux2;
        let hh: i32 = vlvar_h(s, idx, estpx);
        let pre: i32 = vlvar_prefix(s, idx, count, estpx);
        let ry: i32 = i32(i64(n.y) + i64(n.pad) + i64(pre) * 65536 - i64(off) * 65536);
        let r: i32 = arrange(c, cx, ry, cw, hh << 16);
        c = cn.next_sibling;
    }
    if (s >= 0 && n.h > 0) {
        let used: i32 = g_aui_vlist_used_vp[s];
        g_aui_vlist_vp[s] = n.h;
        let all: i32 = 0;
        if (g_aui_vlist_first[s] <= 0 && g_aui_vlist_last[s] >= count - 1) {
            all = 1;                       // 所有行都已构建，无需窗口校正
        }
        if (all == 0) {
            let w: i32[2] = 0;
            let r2: i32 = vlvar_window(s, count, estpx, off, hpx, w);
            let need: i32 = 0;
            if (n.h != used) { need = 1; }
            if (w[0] < g_aui_vlist_first[s]) { need = 1; }
            if (w[1] > g_aui_vlist_last[s]) { need = 1; }
            if (need != 0) {
                g_aui_need_build = 1;
                g_aui_need_layout = 1;
                g_aui_pump_need = 1;
            }
        }
    }
    return 0;
}

// v1.46：虚拟网格。格子按绝对下标定位：
//   row = idx / cols, col = idx % cols
//   x = 容器内容左 + col*(格宽+间距)
//   y = 容器内容顶 + row*(行高+间距) - 偏移
// 布局末尾把实测列数/间距/视口高写回登记表；与 build 时估算不同就
// 置 need_build，下一拍按真实窗口重建。
fn arrange_vgrid(n: ptr<AuiNode>) : i32 {
    let count: i32 = n.aux;
    let rh: i32 = n.aux2;
    let inner: i32 = n.w - n.pad * 2;
    if (inner < 0) { inner = 0; }
    let cols: i32 = vgrid_cols_for(n, inner);
    let cw: i32 = vgrid_cellw(n, inner, cols);
    let rhpx: i32 = rh >> 16;
    if (rhpx < 1) { rhpx = 1; }
    let gappx: i32 = n.gap >> 16;
    if (gappx < 0) { gappx = 0; }
    let pitch: i32 = rhpx + gappx;
    if (pitch < 1) { pitch = 1; }
    let padpx: i32 = n.pad >> 16;
    let rows: i32 = 0;
    if (count > 0) { rows = (count + cols - 1) / cols; }
    let cpx64: i64 = i64(rows) * i64(rhpx);
    let cpx: i32 = 0;
    if (cpx64 > 2000000000) { cpx = 2000000000; } else { cpx = i32(cpx64); }
    if (rows > 1) { cpx = cpx + (rows - 1) * gappx; }
    cpx = cpx + padpx * 2;
    let hpx: i32 = n.h >> 16;
    let maxoff: i32 = cpx - hpx;
    if (maxoff < 0) { maxoff = 0; }
    scroll_store_max(n.key, maxoff);
    let off: i32 = scroll_get(n.key);
    let cx: i32 = n.x + n.pad;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let idx: i32 = cn.aux2;
        let row: i32 = idx / cols;
        let col: i32 = idx - row * cols;
        let rx: i32 = i32(i64(cx) + i64(col) * (i64(cw) + i64(n.gap)));
        let ry: i32 = i32(i64(n.y) + i64(n.pad) + i64(row) * i64(rh) +
                          i64(row) * i64(n.gap) - i64(off) * 65536);
        let r: i32 = arrange(c, rx, ry, cw, cn.aux);
        c = cn.next_sibling;
    }
    let s: i32 = vgrid_find(n.key);
    if (s >= 0 && n.h > 0) {
        let used: i32 = g_aui_vgrid_used_vp[s];
        let oldcols: i32 = g_aui_vgrid_cols[s];
        let oldgap: i32 = g_aui_vgrid_gap[s];
        g_aui_vgrid_vp[s] = n.h;
        g_aui_vgrid_cols[s] = cols;
        g_aui_vgrid_gap[s] = n.gap;
        let all: i32 = 0;
        if (g_aui_vgrid_first[s] <= 0 && g_aui_vgrid_last[s] >= count - 1) {
            all = 1;                       // 所有格子都已构建
        }
        if (all == 0) {
            let firstr: i32 = off / pitch - 1;
            if (firstr < 0) { firstr = 0; }
            let lastr: i32 = (off + hpx) / pitch + 1;
            let first: i32 = firstr * cols;
            if (first > count - 1) { first = count - 1; }
            if (first < 0) { first = 0; }
            let last: i32 = (lastr + 1) * cols - 1;
            if (last > count - 1) { last = count - 1; }
            let need: i32 = 0;
            if (n.h != used) { need = 1; }
            if (cols != oldcols) { need = 1; }
            if (n.gap != oldgap) { need = 1; }
            if (first < g_aui_vgrid_first[s]) { need = 1; }
            if (last > g_aui_vgrid_last[s]) { need = 1; }
            if (need != 0) {
                g_aui_need_build = 1;
                g_aui_need_layout = 1;
                g_aui_pump_need = 1;
            }
        }
    }
    return 0;
}

// v2.17：虚拟表格。格子按绝对 (行, 列) 定位：
//   表身行 r 的 y = 内容顶 + (r+1)*行高 - 纵向偏移（前面还有一行表头）；
//   列 c 的 x = 内容左 + 列左边界 - 横向偏移；
//   表头 y 固定在内容顶（纵向不跟随），首列 x 固定在内容左（横向不跟随）。
// 布局末尾回写实测视口，窗口不够时下一拍重建。
fn arrange_vtable(n: ptr<AuiNode>) : i32 {
    let rows: i32 = n.aux;
    let cols: i32 = n.flags;
    let rh: i32 = n.aux2;
    let rhpx: i32 = rh >> 16;
    if (rhpx < 1) { rhpx = 1; }
    let s: i32 = vtable_find(n.key);
    // 内容高 = 表头 + 各行；内容宽 = 各列宽之和。
    let cpx64: i64 = i64(rows + 1) * i64(rhpx);
    let cpx: i32 = 0;
    if (cpx64 > 2000000000) { cpx = 2000000000; } else { cpx = i32(cpx64); }
    let totw: i32 = 0;
    if (s >= 0) { totw = vtable_total_w(s, cols); }
    let hpx: i32 = n.h >> 16;
    let wpx: i32 = n.w >> 16;
    let maxoff: i32 = cpx - hpx;
    if (maxoff < 0) { maxoff = 0; }
    scroll_store_max(n.key, maxoff);
    let maxx: i32 = totw - wpx;
    if (maxx < 0) { maxx = 0; }
    let mxr: i32 = vtable_store_maxx(n.key, maxx);
    let off: i32 = scroll_get(n.key);
    let offx: i32 = vtable_off_x(n.key);
    let cx: i32 = n.x + n.pad;
    let cy: i32 = n.y + n.pad;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let row: i32 = cn.aux;
        let col: i32 = cn.aux2;
        let colx: i32 = 0;
        if (s >= 0) { colx = vtable_col_x(s, col); }
        let cwq: i32 = 0;
        if (s >= 0) { cwq = vtable_colw_q(s, col); }
        let rx: i32 = 0;
        if (col == 0) {
            // 首列横向固定（纵向仍跟随滚动）。
            rx = cx;
        } else {
            rx = i32(i64(cx) + i64(colx - offx) * 65536);
        }
        let ry: i32 = 0;
        if (row < 0) {
            // 表头纵向固定（横向仍跟随内容滚动）。
            ry = cy;
        } else {
            ry = i32(i64(cy) + i64(row + 1) * i64(rh) - i64(off) * 65536);
        }
        let r: i32 = arrange(c, rx, ry, cwq, rh);
        c = cn.next_sibling;
    }
    // 窗口校正：视口变了，或窗口盖不住可见范围，下一拍重建。
    if (s >= 0 && n.h > 0 && n.w > 0) {
        let used: i32 = g_aui_vtable_used_vp[s];
        let usedw: i32 = g_aui_vtable_used_vpw[s];
        g_aui_vtable_vp[s] = n.h;
        g_aui_vtable_vpw[s] = n.w;
        let all: i32 = 0;
        // v2.17：拆成嵌套，避免四项 && 链超编译器临时寄存器上限。
        if (g_aui_vtable_first_row[s] <= 0 && g_aui_vtable_last_row[s] >= rows - 1) {
            if (g_aui_vtable_first_col[s] <= 0 && g_aui_vtable_last_col[s] >= cols - 1) {
                all = 1;                   // 所有格子都已构建
            }
        }
        if (all == 0) {
            let firstr: i32 = off / rhpx - 1;
            if (firstr < 0) { firstr = 0; }
            let lastr: i32 = (off + hpx) / rhpx + 1;
            if (lastr > rows - 1) { lastr = rows - 1; }
            let firstc: i32 = vtable_col_at(s, offx, cols);
            let lastc: i32 = vtable_col_at(s, offx + wpx, cols);
            if (firstc > 0) { firstc = firstc - 1; }
            if (lastc < cols - 1) { lastc = lastc + 1; }
            let need: i32 = 0;
            if (n.h != used) { need = 1; }
            if (n.w != usedw) { need = 1; }
            if (firstr < g_aui_vtable_first_row[s]) { need = 1; }
            if (lastr > g_aui_vtable_last_row[s]) { need = 1; }
            if (firstc < g_aui_vtable_first_col[s]) { need = 1; }
            if (lastc > g_aui_vtable_last_col[s]) { need = 1; }
            if (need != 0) {
                g_aui_need_build = 1;
                g_aui_need_layout = 1;
                g_aui_pump_need = 1;
            }
        }
    }
    return 0;
}

// v1.47：横向虚拟列表。项按绝对下标定位：
//   x = 容器内容左 + idx*(项宽+间距) - 偏移
// 项高固定或撑满内容高；布局末尾回写实测间距/视口宽，窗口不够时
// 下一拍重建。
fn arrange_hlist(n: ptr<AuiNode>) : i32 {
    let count: i32 = n.aux;
    let iw: i32 = n.aux2;
    let ih: i32 = n.flags;
    let iwpx: i32 = iw >> 16;
    if (iwpx < 1) { iwpx = 1; }
    let gappx: i32 = n.gap >> 16;
    if (gappx < 0) { gappx = 0; }
    let pitch: i32 = iwpx + gappx;
    if (pitch < 1) { pitch = 1; }
    let padpx: i32 = n.pad >> 16;
    let cpx64: i64 = i64(count) * i64(iwpx);
    let cpx: i32 = 0;
    if (cpx64 > 2000000000) { cpx = 2000000000; } else { cpx = i32(cpx64); }
    if (count > 1) {
        let g64: i64 = i64(count - 1) * i64(gappx);
        if (g64 > 2000000000) { cpx = 2000000000; } else { cpx = cpx + i32(g64); }
    }
    cpx = cpx + padpx * 2;
    let wpx: i32 = n.w >> 16;
    let maxoff: i32 = cpx - wpx;
    if (maxoff < 0) { maxoff = 0; }
    scroll_store_max(n.key, maxoff);
    let off: i32 = scroll_get(n.key);
    let cy: i32 = n.y + n.pad;
    let inner_h: i32 = n.h - n.pad * 2;
    if (inner_h < 0) { inner_h = 0; }
    let ch: i32 = inner_h;
    if (ih > 0 && ih < inner_h) { ch = ih; }
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let idx: i32 = cn.aux2;
        let rx: i32 = i32(i64(n.x) + i64(n.pad) + i64(idx) * (i64(iw) + i64(n.gap)) -
                          i64(off) * 65536);
        let r: i32 = arrange(c, rx, cy, iw, ch);
        c = cn.next_sibling;
    }
    let s: i32 = hlist_find(n.key);
    if (s >= 0 && n.w > 0) {
        let used: i32 = g_aui_hlist_used_vp[s];
        let oldgap: i32 = g_aui_hlist_gap[s];
        g_aui_hlist_vp[s] = n.w;
        g_aui_hlist_gap[s] = n.gap;
        let all: i32 = 0;
        if (g_aui_hlist_first[s] <= 0 && g_aui_hlist_last[s] >= count - 1) {
            all = 1;                       // 所有项都已构建
        }
        if (all == 0) {
            let first: i32 = off / pitch - 1;
            if (first < 0) { first = 0; }
            let last: i32 = (off + wpx) / pitch + 1;
            if (last > count - 1) { last = count - 1; }
            let need: i32 = 0;
            if (n.w != used) { need = 1; }
            if (n.gap != oldgap) { need = 1; }
            if (first < g_aui_hlist_first[s]) { need = 1; }
            if (last > g_aui_hlist_last[s]) { need = 1; }
            if (need != 0) {
                g_aui_need_build = 1;
                g_aui_need_layout = 1;
                g_aui_pump_need = 1;
            }
        }
    }
    return 0;
}

// v1.26：下拉只记录选项下标，浮层位置由 select_layout 统一安排。
fn arrange_select(n: ptr<AuiNode>) : i32 {    let idx: i32 = 0;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        cn.aux2 = idx;
        idx = idx + 1;
        c = cn.next_sibling;
    }
    return 0;
}

// v1.44：组合框的建议不参与普通布局，只记录下标；浮层位置见
// combo_layout。
fn arrange_combo(n: ptr<AuiNode>) : i32 {
    let idx: i32 = 0;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        cn.aux2 = idx;
        idx = idx + 1;
        c = cn.next_sibling;
    }
    return 0;
}

fn arrange_column(n: ptr<AuiNode>) : i32 {
    let cx: i32 = n.x + n.pad;
    let cy: i32 = n.y + n.pad;
    let cw: i32 = n.w - n.pad * 2;
    if (cw < 0) { cw = 0; }
    // 第一遍：统计固定高度与权重总和
    let fixed: i32 = 0;
    let wsum: i32 = 0;
    let cnt: i32 = 0;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        if (cn.weight > 0) { wsum = wsum + cn.weight; } else { fixed = fixed + cn.h; }
        cnt = cnt + 1;
        c = cn.next_sibling;
    }
    let gaps: i32 = 0;
    if (cnt > 1) { gaps = n.gap * (cnt - 1); }
    let remain: i32 = n.h - n.pad * 2 - fixed - gaps;
    if (remain < 0) { remain = 0; }
    // B23 F1：remain 下传。恰好一个 weight-0 子项带“子树含 weight”
    // 标记且 remain > 0 时，把全部 remain 分给它（测量高 + remain）；
    // 本列自己的 weight 子项改从扣减后的 remain 里分；多个满足条件
    // 的子项时保持现状（不下传），不自创分配规则。
    // B25 收紧：候选子项还须带“子树含 scroll”标记（AUI_HAS_SCROLL_DESC；
    // kind 9 scroll / kind 29 refresh 容器自身带，沿 measure_column /
    // measure_row / measure_scroll 上卷）。否则键盘列（键带 weight、无
    // scroll 后代）会劫持全部 remain，scroll 分得 0（B25）。
    let pass_child: i32 = -1;
    let pass_cnt: i32 = 0;
    let pc: i32 = n.first_child;
    while (pc >= 0) {
        let pcn: ptr<AuiNode> = node_at(pc);
        // D-2a：定高子项不接 remain 下传——显式尺寸优先于启发式分配。
        if (pcn.weight == 0 && g_d2a_size_h[pc] < 0 && (pcn.flags & AUI_HAS_WEIGHT_DESC) != 0 && (pcn.flags & AUI_HAS_SCROLL_DESC) != 0) {
            pass_cnt = pass_cnt + 1;
            pass_child = pc;
        }
        pc = pcn.next_sibling;
    }
    let pass_h: i32 = 0;
    if (pass_cnt == 1 && remain > 0) { pass_h = remain; }
    let remain_w: i32 = remain - pass_h;
    let cursor: i32 = cy;
    c = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let ch: i32 = cn.h;
        if (c == pass_child && pass_h > 0) { ch = cn.h + pass_h; }
        else if (cn.weight > 0) {
            if (wsum > 0) { ch = remain_w * cn.weight / wsum; } else { ch = 0; }
        }
        let ccw: i32 = cn.w;
        let ccx: i32 = cx;
        if (cn.align == 3) {
            ccw = cw;
        } else if (cn.align == 1) {
            ccx = cx + (cw - cn.w) / 2;
        } else if (cn.align == 2) {
            ccx = cx + cw - cn.w;
        }
        let r: i32 = arrange(c, ccx, cursor, ccw, ch);
        cursor = cursor + ch + n.gap;
        c = cn.next_sibling;
    }
    return 0;
}

fn arrange_row(n: ptr<AuiNode>) : i32 {
    let cx: i32 = n.x + n.pad;
    let cy: i32 = n.y + n.pad;
    let ch_: i32 = n.h - n.pad * 2;
    if (ch_ < 0) { ch_ = 0; }
    let fixed: i32 = 0;
    let wsum: i32 = 0;
    let cnt: i32 = 0;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        if (cn.weight > 0) { wsum = wsum + cn.weight; } else { fixed = fixed + cn.w; }
        cnt = cnt + 1;
        c = cn.next_sibling;
    }
    let gaps: i32 = 0;
    if (cnt > 1) { gaps = n.gap * (cnt - 1); }
    let remain: i32 = n.w - n.pad * 2 - fixed - gaps;
    if (remain < 0) { remain = 0; }
    let cursor: i32 = cx;
    c = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let cw: i32 = cn.w;
        if (cn.weight > 0) {
            if (wsum > 0) { cw = remain * cn.weight / wsum; } else { cw = 0; }
        }
        let cch: i32 = cn.h;
        let ccy: i32 = cy;
        if (cn.align == 3) {
            cch = ch_;
        } else if (cn.align == 1) {
            ccy = cy + (ch_ - cn.h) / 2;
        } else if (cn.align == 2) {
            ccy = cy + ch_ - cn.h;
        }
        let r: i32 = arrange(c, cursor, ccy, cw, cch);
        cursor = cursor + cw + n.gap;
        c = cn.next_sibling;
    }
    return 0;
}

fn arrange_stack(n: ptr<AuiNode>) : i32 {
    let cx: i32 = n.x + n.pad;
    let cy: i32 = n.y + n.pad;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let r: i32 = arrange(c, cx, cy, cn.w, cn.h);
        c = cn.next_sibling;
    }
    return 0;
}

// v1.37：流式布局排布。按与 measure_flow 相同的换行规则重新分组，
// 每行先统计自然宽、最高子项与 weight 总和，再逐个落位：
//   - 有 weight 的子项按比例吃掉本行剩余宽度（没有剩余就不分）；
//   - 否则主轴对齐（aux2）分配剩余：居中、靠右或 space-between；
//   - 子项 align 控制行内垂直：0 顶 / 1 中 / 2 底 / 3 拉伸到行高。
fn arrange_flow(n: ptr<AuiNode>) : i32 {
    let inner: i32 = n.w - n.pad * 2;
    if (inner < 0) { inner = 0; }
    let gap: i32 = n.gap;
    if (gap < 0) { gap = 0; }
    let cx: i32 = n.x + n.pad;
    let cy: i32 = n.y + n.pad;
    let just: i32 = n.aux2;
    let start: i32 = n.first_child;
    while (start >= 0) {
        // 第一遍：确定本行成员与几何
        let line_w: i32 = 0;
        let line_h: i32 = 0;
        let line_n: i32 = 0;
        let wsum: i32 = 0;
        let next_start: i32 = -1;
        let c: i32 = start;
        while (c >= 0) {
            let cn: ptr<AuiNode> = node_at(c);
            if (line_n > 0 && line_w + gap + cn.w > inner) {
                next_start = c;
                c = -1;
            } else {
                if (line_n > 0) { line_w = line_w + gap; }
                line_w = line_w + cn.w;
                if (cn.h > line_h) { line_h = cn.h; }
                if (cn.weight > 0) { wsum = wsum + cn.weight; }
                line_n = line_n + 1;
                c = cn.next_sibling;
            }
        }
        let remain: i32 = inner - line_w;
        let extra: i32 = 0;
        let xoff: i32 = 0;
        if (wsum > 0) {
            if (remain < 0) { remain = 0; }
        } else if (remain > 0) {
            if (just == 1) { xoff = remain / 2; }
            else if (just == 2) { xoff = remain; }
            else if (just == 3 && line_n > 1) { extra = remain / (line_n - 1); }
        }
        // 第二遍：落位
        let x: i32 = cx + xoff;
        c = start;
        let idx: i32 = 0;
        while (idx < line_n) {
            let cn: ptr<AuiNode> = node_at(c);
            let cw: i32 = cn.w;
            if (wsum > 0 && cn.weight > 0) {
                cw = cw + i32((i64(remain) * i64(cn.weight)) / i64(wsum));
            }
            let ccy: i32 = cy;
            let cch: i32 = cn.h;
            if (cn.align == 3) { cch = line_h; }
            else if (cn.align == 1) { ccy = cy + (line_h - cn.h) / 2; }
            else if (cn.align == 2) { ccy = cy + line_h - cn.h; }
            let r: i32 = arrange(c, x, ccy, cw, cch);
            x = x + cw + gap + extra;
            idx = idx + 1;
            c = cn.next_sibling;
        }
        cy = cy + line_h + gap;
        start = next_start;
    }
    return 0;
}

// v1.40：顶部应用栏排列。leading 贴左、动作贴右、都垂直居中；标题不是
// 子节点，位置在绘制时由 top_bar_title_rect 计算。
fn arrange_top_bar(n: ptr<AuiNode>) : i32 {
    let hp: i32 = top_bar_hp(n);
    let inner_x: i32 = n.x + hp;
    let inner_r: i32 = n.x + n.w - hp;
    let lead: i32 = top_bar_leading(n);
    if (lead >= 0) {
        let ln: ptr<AuiNode> = node_at(lead);
        let ly: i32 = n.y + (n.h - ln.h) / 2;
        let rl: i32 = arrange(lead, inner_x, ly, ln.w, ln.h);
    }
    let actw: i32 = top_bar_actions_w(n);
    let ax: i32 = inner_r - actw;
    if (ax < inner_x) { ax = inner_x; }
    let cur: i32 = ax;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        if ((cn.flags & AUI_TB_LEADING) == 0) {
            let cy: i32 = n.y + (n.h - cn.h) / 2;
            let r: i32 = arrange(c, cur, cy, cn.w, cn.h);
            cur = cur + cn.w + n.gap;
        }
        c = cn.next_sibling;
    }
    return 0;
}

// v1.41：导航栏等宽排列；除不尽的余数给最后一项，项内下标写进 aux2。
fn arrange_nav_bar(n: ptr<AuiNode>) : i32 {
    let cx: i32 = n.x + n.pad;
    let cy: i32 = n.y + n.pad;
    let iw: i32 = n.w - n.pad * 2;
    let ih: i32 = n.h - n.pad * 2;
    if (iw < 0) { iw = 0; }
    if (ih < 0) { ih = 0; }
    let cnt: i32 = 0;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        cnt = cnt + 1;
        c = cn.next_sibling;
    }
    if (cnt <= 0) { return 0; }
    let cw: i32 = iw / cnt;
    let idx: i32 = 0;
    let x: i32 = cx;
    c = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let w: i32 = cw;
        if (idx == cnt - 1) { w = cx + iw - x; }
        if (w < 0) { w = 0; }
        cn.aux2 = idx;
        let r: i32 = arrange(c, x, cy, w, ih);
        x = x + w;
        idx = idx + 1;
        c = cn.next_sibling;
    }
    return 0;
}

// v1.42：侧边导航栏纵向排列；每项 48 dp 高、等宽，下标写进 aux2。
fn arrange_nav_pane(n: ptr<AuiNode>) : i32 {
    let hp: i32 = nav_pane_hp(n);
    let x: i32 = n.x + hp;
    let w: i32 = n.w - hp * 2;
    let cw: i32 = w;
    if (cw < 0) { cw = 0; }
    let y: i32 = n.y + n.pad;
    let idx: i32 = 0;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let hh: i32 = dp2q(48);
        cn.aux2 = idx;
        let r: i32 = arrange(c, x, y, cw, hh);
        y = y + hh + n.gap;
        idx = idx + 1;
        c = cn.next_sibling;
    }
    return 0;
}

// v1.21：等宽排列子段（最后一段吃掉除不尽的余数），并把下标写进 aux2，
// 点按回调据此告诉应用选中了哪一段。
fn arrange_segmented(n: ptr<AuiNode>) : i32 {
    let cx: i32 = n.x + n.pad;
    let cy: i32 = n.y + n.pad;
    let iw: i32 = n.w - n.pad * 2;
    let ih: i32 = n.h - n.pad * 2;
    if (iw < 0) { iw = 0; }
    if (ih < 0) { ih = 0; }
    let cnt: i32 = 0;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        cnt = cnt + 1;
        c = cn.next_sibling;
    }
    let cw: i32 = 0;
    if (cnt > 0) { cw = iw / cnt; }
    let idx: i32 = 0;
    let x: i32 = cx;
    c = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let w: i32 = cw;
        if (idx == cnt - 1) { w = cx + iw - x; }
        if (w < 0) { w = 0; }
        cn.aux2 = idx;
        let r: i32 = arrange(c, x, cy, w, ih);
        x = x + w;
        idx = idx + 1;
        c = cn.next_sibling;
    }
    return 0;
}

// v1.22：标签页按固有宽度从左到右排（不摊剩余宽度），把页下标写进
// aux2，点按回调据此告诉应用点中了哪一页。超出容器的部分由 clip 裁掉。
fn arrange_tabs(n: ptr<AuiNode>) : i32 {
    let cx: i32 = n.x + n.pad;
    let cy: i32 = n.y + n.pad;
    let iw: i32 = n.w - n.pad * 2;
    let ih: i32 = n.h - n.pad * 2;
    if (iw < 0) { iw = 0; }
    if (ih < 0) { ih = 0; }
    // v2.6.1：标签栏横向滚动。内容总宽是各页宽度之和；最大偏移登记
    // 到 keyed scroll 表（与 ScrollView 同一张表，Q16.16 px），拖动/
    // 惯性复用同一套机制。内容比视口窄时最大偏移为 0，不动。
    let sumw: i32 = 0;
    let c0: i32 = n.first_child;
    while (c0 >= 0) {
        let cn0: ptr<AuiNode> = node_at(c0);
        let w0: i32 = cn0.w;
        if (w0 < 0) { w0 = 0; }
        sumw = sumw + w0;
        c0 = cn0.next_sibling;
    }
    let off: i32 = 0;
    if (n.key != 0) {
        let maxoff: i32 = sumw - iw;
        scroll_store_max(n.key, maxoff);
        off = scroll_get(n.key);
    }
    let idx: i32 = 0;
    let x: i32 = cx - off;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let w: i32 = cn.w;
        if (w < 0) { w = 0; }
        cn.aux2 = idx;
        let r: i32 = arrange(c, x, cy, w, ih);
        x = x + w;
        idx = idx + 1;
        c = cn.next_sibling;
    }
    return 0;
}

// v1.26：下拉浮层。锚在触发器下方（空间不够时翻到上方），宽度跟触发器，
// 最多铺满内容区；选项按 48 dp 行高排列，放不下的部分不摆（无内部滚动）。
fn select_layout(cx: i32, cy: i32, cw: i32, ch: i32) : i32 {
    g_aui_select_px = 0;
    g_aui_select_py = 0;
    g_aui_select_pw = 0;
    g_aui_select_ph = 0;
    g_aui_select_vis = 0;
    if (g_aui_select_open < 0) { return 0; }
    let n: ptr<AuiNode> = node_at(g_aui_select_open);
    if (n.kind != 25) { return 0; }
    if (n.aux2 == 0) { return 0; }
    let cnt: i32 = select_opt_count(n);
    if (cnt <= 0) { return 0; }
    let item: i32 = dp2q(48);
    let pad: i32 = dp2q(6);
    let gap: i32 = dp2q(4);
    let margin: i32 = dp2q(8);
    let pw: i32 = n.w;
    let maxw: i32 = cw - margin * 2;
    if (pw > maxw) { pw = maxw; }
    if (pw < 0) { pw = 0; }
    let maxh: i32 = ch - margin * 2;
    let vis: i32 = cnt;
    if (vis * item + pad * 2 > maxh) {
        vis = (maxh - pad * 2) / item;
    }
    if (vis < 0) { vis = 0; }
    if (vis > cnt) { vis = cnt; }
    if (vis <= 0) { return 0; }
    let ph: i32 = vis * item + pad * 2;
    let px: i32 = n.x;
    if (px + pw > cx + cw - margin) { px = cx + cw - margin - pw; }
    if (px < cx + margin) { px = cx + margin; }
    let py: i32 = n.y + n.h + gap;
    if (py + ph > cy + ch - margin) {
        let up: i32 = n.y - ph - gap;
        if (up >= cy + margin) { py = up; } else { py = cy + ch - margin - ph; }
    }
    if (py < cy + margin) { py = cy + margin; }
    g_aui_select_px = px;
    g_aui_select_py = py;
    g_aui_select_pw = pw;
    g_aui_select_ph = ph;
    g_aui_select_vis = vis;
    let iw: i32 = pw - dp2q(8);
    if (iw < 0) { iw = 0; }
    let idx: i32 = 0;
    let c: i32 = n.first_child;
    while (c >= 0) {
        if (idx < vis) {
            let oy: i32 = py + pad + idx * item;
            let r: i32 = arrange(c, px + dp2q(4), oy, iw, item);
        } else {
            let r2: i32 = arrange(c, 0, 0, 0, 0);
        }
        idx = idx + 1;
        let cn: ptr<AuiNode> = node_at(c);
        c = cn.next_sibling;
    }
    return 0;
}

// v1.44：组合框浮层。与下拉一致：锚在触发器下方（空间不够翻到上方），
// 宽度跟触发器、最多铺满内容区；建议按 48 dp 行高排列，放不下的不摆
// （无内部滚动）。浮层不遮键盘——键盘仍走普通命中。
fn combo_layout(cx: i32, cy: i32, cw: i32, ch: i32) : i32 {
    g_aui_combo_px = 0;
    g_aui_combo_py = 0;
    g_aui_combo_pw = 0;
    g_aui_combo_ph = 0;
    g_aui_combo_vis = 0;
    if (g_aui_combo_open < 0) { return 0; }
    let n: ptr<AuiNode> = node_at(g_aui_combo_open);
    if (n.kind != 49) { return 0; }
    if (n.aux2 == 0) { return 0; }
    let cnt: i32 = combo_sug_count(n);
    if (cnt <= 0) { return 0; }
    let item: i32 = dp2q(48);
    let pad: i32 = dp2q(6);
    let gap: i32 = dp2q(4);
    let margin: i32 = dp2q(8);
    let pw: i32 = n.w;
    let maxw: i32 = cw - margin * 2;
    if (pw > maxw) { pw = maxw; }
    if (pw < 0) { pw = 0; }
    let maxh: i32 = ch - margin * 2;
    let vis: i32 = cnt;
    if (vis * item + pad * 2 > maxh) {
        vis = (maxh - pad * 2) / item;
    }
    if (vis < 0) { vis = 0; }
    if (vis > cnt) { vis = cnt; }
    if (vis <= 0) { return 0; }
    let ph: i32 = vis * item + pad * 2;
    let px: i32 = n.x;
    if (px + pw > cx + cw - margin) { px = cx + cw - margin - pw; }
    if (px < cx + margin) { px = cx + margin; }
    let py: i32 = n.y + n.h + gap;
    if (py + ph > cy + ch - margin) {
        let up: i32 = n.y - ph - gap;
        if (up >= cy + margin) { py = up; } else { py = cy + ch - margin - ph; }
    }
    if (py < cy + margin) { py = cy + margin; }
    g_aui_combo_px = px;
    g_aui_combo_py = py;
    g_aui_combo_pw = pw;
    g_aui_combo_ph = ph;
    g_aui_combo_vis = vis;
    let iw: i32 = pw - dp2q(8);
    if (iw < 0) { iw = 0; }
    let idx: i32 = 0;
    let c: i32 = n.first_child;
    while (c >= 0) {
        if (idx < vis) {
            let oy: i32 = py + pad + idx * item;
            let r: i32 = arrange(c, px + dp2q(4), oy, iw, item);
        } else {
            let r2: i32 = arrange(c, 0, 0, 0, 0);
        }
        idx = idx + 1;
        let cn: ptr<AuiNode> = node_at(c);
        c = cn.next_sibling;
    }
    return 0;
}

// v1.25：对话框布局。dialog 节点覆盖整窗（遮罩），卡片在内容区内居中；
// 卡片宽度默认 max 320 dp、两侧各留 24 dp，高度取内容并夹到可用高度，
// 超出部分由 kind 24 的绘制裁剪挡住。
fn dialog_layout(cx: i32, cy: i32, cw: i32, ch: i32) : i32 {
    if (g_aui_dialog < 0) { return 0; }
    let d: ptr<AuiNode> = node_at(g_aui_dialog);
    d.x = 0;
    d.y = 0;
    d.w = g_aui_sw;
    d.h = g_aui_sh;
    let margin: i32 = dp2q(24);
    let maxw: i32 = cw - margin * 2;
    let cap: i32 = dp2q(320);
    let w: i32 = maxw;
    if (w > cap) { w = cap; }
    if (w < 0) { w = 0; }
    let c: ptr<AuiNode> = node_at(g_aui_dialog_card);
    let h: i32 = measure(g_aui_dialog_card, w);
    let maxh: i32 = ch - margin * 2;
    if (h > maxh) { h = maxh; }
    if (h < 0) { h = 0; }
    let x: i32 = cx + (cw - w) / 2;
    let y: i32 = cy + (ch - h) / 2;
    let r: i32 = arrange(g_aui_dialog_card, x, y, w, h);
    return 0;
}

// v1.38：底部弹出层布局。遮罩覆盖整窗；表面贴内容区底部、水平居中，
// 宽 = 内容区宽 - 两侧 16 dp（最大 640 dp），高取内容但不超过内容区
// 85%。首次布局时按最终高度启动 240 ms 的滑入（TY 从高度 dp 到 0）。
fn sheet_layout(cx: i32, cy: i32, cw: i32, ch: i32) : i32 {
    if (g_aui_sheet < 0) { return 0; }
    let d: ptr<AuiNode> = node_at(g_aui_sheet);
    d.x = 0;
    d.y = 0;
    d.w = g_aui_sw;
    d.h = g_aui_sh;
    let margin: i32 = dp2q(16);
    let w: i32 = cw - margin * 2;
    let cap: i32 = dp2q(640);
    if (w > cap) { w = cap; }
    if (w < 0) { w = 0; }
    let c: ptr<AuiNode> = node_at(g_aui_sheet_card);
    let h: i32 = measure(g_aui_sheet_card, w);
    let maxh: i32 = i32((i64(ch) * 85) / 100);
    if (h > maxh) { h = maxh; }
    if (h < 0) { h = 0; }
    let x: i32 = cx + (cw - w) / 2;
    let y: i32 = cy + ch - h;
    let r: i32 = arrange(g_aui_sheet_card, x, y, w, h);
    if (g_aui_sheet_anim != 0) {
        g_aui_sheet_anim = 0;
        if (g_aui_density > 0 && h > 0) {
            let hdp: i32 = i32(i64(h) / i64(g_aui_density));
            if (hdp < 1) { hdp = 1; }
            let ar: i32 = aui_anim(c.key, AUI_ANIM_TY, hdp, 0, 240, AUI_EASE_OUT);
            g_aui_sheet_until = anim_now() + 280000000;
        }
    }
    return 0;
}

// v1.35：菜单布局。宽度取最宽条目（受最小 180 dp / 内容区限制），
// 高度取全部条目之和；超高时允许内部滚动。锚定菜单默认贴锚点下方，
// 放不下翻到上方，最后两个方向都夹在内容区 8 dp 边距内。
fn menu_item_h(n: ptr<AuiNode>) : i32 {
    if (n.kind == 36) {
        let sh: i32 = dp2q(1);
        if (sh < 65536) { sh = 65536; }
        return sh;
    }
    let h: i32 = text_line_h() + dp2q(16);       // item_padding 12/8
    let mn: i32 = dp2q(36);
    if (h < mn) { h = mn; }
    return h;
}

fn menu_find_anchor(key: i32) : i32 {
    if (key <= 0) { return -1; }
    let i: i32 = 0;
    while (i < g_aui_node_count) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.key == key && n.parent >= 0 &&
            n.kind != 34 && n.kind != 35 && n.kind != 36) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn menu_layout(cx: i32, cy: i32, cw: i32, ch: i32) : i32 {
    g_aui_menu_px = 0;
    g_aui_menu_py = 0;
    g_aui_menu_pw = 0;
    g_aui_menu_ph = 0;
    if (g_aui_menu < 0) { return 0; }
    let mn: ptr<AuiNode> = node_at(g_aui_menu);
    if (mn.kind != 34) { return 0; }
    let pad: i32 = mn.pad;
    let margin: i32 = dp2q(8);
    let gap: i32 = dp2q(4);
    let has_state: i32 = 0;
    let total: i32 = pad * 2;
    let textmax: i32 = 0;
    let c: i32 = mn.first_child;
    let see: i32 = 0;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        if (cn.kind == 35 && (cn.flags & AUI_MENU_CHECKED) != 0) { see = 1; }
        total = total + menu_item_h(cn);
        if (cn.kind == 35) {
            let tw: i32 = text_measure(cn.text, str_len(cn.text), 0);
            if (tw > textmax) { textmax = tw; }
        }
        c = cn.next_sibling;
    }
    // 勾选列只在存在勾选条目时保留（HuxerUI 只有带 icon/state 的条目才缩进）。
    let statew: i32 = 0;
    if (see != 0) { statew = dp2q(18) + dp2q(8); }
    mn.flags = see;                              // 绘制条目时复用
    let natural: i32 = textmax + pad * 2 + dp2q(24) + statew;
    let pw: i32 = natural;
    let minw: i32 = dp2q(180);
    if (pw < minw) { pw = minw; }
    let maxw: i32 = cw - margin * 2;
    if (maxw < 0) { maxw = 0; }
    if (pw > maxw) { pw = maxw; }
    let maxh: i32 = ch - margin * 2;
    if (maxh < 0) { maxh = 0; }
    let maxoff: i32 = 0;
    let ph: i32 = total;
    if (ph > maxh) {
        ph = maxh;
        maxoff = total - maxh;
    }
    if (ph < 0) { ph = 0; }
    g_aui_menu_max = maxoff;
    let off: i32 = g_aui_menu_off;
    if (off < 0) { off = 0; }
    if (off > maxoff) { off = maxoff; }
    g_aui_menu_off = off;
    let x: i32 = cx + margin;
    let y: i32 = cy + margin;
    if (mn.aux2 != 0) {
        x = g_aui_menu_at_x;
        y = g_aui_menu_at_y;
    } else {
        let ai: i32 = menu_find_anchor(mn.aux);
        if (ai >= 0) {
            let an: ptr<AuiNode> = node_at(ai);
            x = an.x;
            y = an.y + an.h + gap;
            if (y + ph > cy + ch - margin) {
                let up: i32 = an.y - ph - gap;
                if (up >= cy + margin) {
                    y = up;
                } else {
                    y = cy + ch - margin - ph;
                }
            }
        }
    }
    if (x + pw > cx + cw - margin) { x = cx + cw - margin - pw; }
    if (x < cx + margin) { x = cx + margin; }
    if (y + ph > cy + ch - margin) { y = cy + ch - margin - ph; }
    if (y < cy + margin) { y = cy + margin; }
    g_aui_menu_px = x;
    g_aui_menu_py = y;
    g_aui_menu_pw = pw;
    g_aui_menu_ph = ph;
    let iw: i32 = pw - pad * 2;
    if (iw < 0) { iw = 0; }
    let iy: i32 = y + pad - off;
    c = mn.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let ih: i32 = menu_item_h(cn);
        let r: i32 = arrange(c, x + pad, iy, iw, ih);
        iy = iy + ih;
        c = cn.next_sibling;
    }
    return 0;
}

// v1.35：菜单命中。条目返回节点下标；面/内边距返回 -2（吞掉点击）；
// 菜单外返回 -1（松手时关闭）。
fn menu_hit(px: i32, py: i32) : i32 {
    if (g_aui_menu < 0) { return -1; }
    let qx: i32 = px << 16;
    let qy: i32 = py << 16;
    if (qx < g_aui_menu_px || qy < g_aui_menu_py ||
        qx >= g_aui_menu_px + g_aui_menu_pw ||
        qy >= g_aui_menu_py + g_aui_menu_ph) {
        return -1;
    }
    let mn: ptr<AuiNode> = node_at(g_aui_menu);
    let c: i32 = mn.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        if (qx >= cn.x && qy >= cn.y &&
            qx < cn.x + cn.w && qy < cn.y + cn.h) {
            if (cn.kind == 35) { return c; }
            return -2;
        }
        c = cn.next_sibling;
    }
    return -2;
}

// v1.35：关闭菜单并结算原因。item_key 由点中条目路径填入；外部/BACK 为 0。
// 先改完所有状态再调 cb，回调里重入读取 reason/item_key 都是新值。
fn menu_finish(reason: i32, item_key: i32) : i32 {
    if (g_aui_menu < 0) { return 0; }
    let mn: ptr<AuiNode> = node_at(g_aui_menu);
    let cb: fn(ptr) : i32 = mn.cb;
    let user: ptr = mn.user;
    g_aui_menu_reason = reason;
    g_aui_menu_item_key = item_key;
    g_aui_menu = -1;
    g_aui_menu_press = -1;
    g_aui_menu_down = -3;
    g_aui_menu_drag = 0;
    g_aui_menu_off = 0;
    g_aui_menu_max = 0;
    g_aui_menu_px = 0;
    g_aui_menu_py = 0;
    g_aui_menu_pw = 0;
    g_aui_menu_ph = 0;
    if (cb != 0) { let r: i32 = cb(user); }
    return 1;
}

fn menu_close(reason: i32) : i32 {
    return menu_finish(reason, 0);
}

// v1.35：点中条目。菜单先关、菜单 cb 先走，再调条目自己的 cb
// （HuxerUI Activate 的顺序），条目回调里再开新菜单也不会被旧状态覆盖。
fn menu_activate(idx: i32) : i32 {
    if (g_aui_menu < 0) { return 0; }
    if (idx < 0 || idx >= g_aui_node_count) { return 0; }
    let n: ptr<AuiNode> = node_at(idx);
    if (n.kind != 35) { return 0; }
    if ((n.flags & AUI_MENU_DISABLED) != 0) { return 0; }
    let ikey: i32 = n.key;
    let icb: fn(ptr) : i32 = n.cb;
    let iuser: ptr = n.user;
    let r: i32 = menu_finish(AUI_MENU_REASON_ITEM, ikey);
    if (icb != 0) { let ri: i32 = icb(iuser); }
    return 1;
}

// v1.39：锚点查找。排除所有不挂树/浮层类节点，避免把浮层自己当锚点。
fn popup_find_anchor(key: i32) : i32 {
    if (key <= 0) { return -1; }
    let i: i32 = 0;
    while (i < g_aui_node_count) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.key == key && n.parent >= 0 && n.kind != 43 &&
            n.kind != 34 && n.kind != 35 && n.kind != 36 &&
            n.kind != 23 && n.kind != 24 && n.kind != 41 && n.kind != 42) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// v1.39：锚定浮层布局。宽度 = 孩子最宽 + 左右 pad（或 aui_popup_width
// 指定的固定宽），夹在 96..360 dp 与内容区内；高度按内容 measure。
// 方向 side 放不下时翻到反方向，交叉轴按 align 起/中/末，最后夹边距。
fn popup_layout(cx: i32, cy: i32, cw: i32, ch: i32) : i32 {
    g_aui_popup_px = 0;
    g_aui_popup_py = 0;
    g_aui_popup_pw = 0;
    g_aui_popup_ph = 0;
    if (g_aui_popup < 0) { return 0; }
    let pn: ptr<AuiNode> = node_at(g_aui_popup);
    if (pn.kind != 43) { return 0; }
    let pad: i32 = pn.pad;
    let margin: i32 = dp2q(8);
    let gap: i32 = dp2q(4);
    let maxw: i32 = cx + cw - margin * 2;
    if (maxw < 0) { maxw = 0; }
    let capw: i32 = dp2q(360);
    if (maxw > capw) { maxw = capw; }
    let inner_cap: i32 = maxw - pad * 2;
    if (inner_cap < 0) { inner_cap = 0; }
    let natural: i32 = 0;
    let c: i32 = pn.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let chh: i32 = measure(c, inner_cap);
        if (cn.w > natural) { natural = cn.w; }
        c = cn.next_sibling;
    }
    let pw: i32 = natural + pad * 2;
    if (g_aui_popup_fixed > 0) { pw = g_aui_popup_fixed; }
    let minw: i32 = dp2q(96);
    if (pw < minw) { pw = minw; }
    if (pw > maxw) { pw = maxw; }
    if (pw < 0) { pw = 0; }
    let ph: i32 = measure(g_aui_popup, pw);
    let maxh: i32 = ch - margin * 2;
    if (maxh < 0) { maxh = 0; }
    if (ph > maxh) { ph = maxh; }
    if (ph < 0) { ph = 0; }
    // 锚点矩形：节点锚或屏幕点（宽高为 0）。
    let ax: i32 = cx + margin;
    let ay: i32 = cy + margin;
    let aw: i32 = 0;
    let ah: i32 = 0;
    if (pn.aux2 != 0) {
        ax = g_aui_popup_ax;
        ay = g_aui_popup_ay;
    } else {
        let ai: i32 = popup_find_anchor(pn.aux);
        if (ai >= 0) {
            let an: ptr<AuiNode> = node_at(ai);
            ax = an.x;
            ay = an.y;
            aw = an.w;
            ah = an.h;
        }
    }
    let side: i32 = g_aui_popup_side;
    let align: i32 = g_aui_popup_align;
    let x: i32 = ax;
    let y: i32 = ay;
    let right_lim: i32 = cx + cw - margin;
    let bottom_lim: i32 = cy + ch - margin;
    if (side == 0) {
        y = ay + ah + gap;
        if (align == 1) { x = ax + (aw - pw) / 2; }
        else if (align == 2) { x = ax + aw - pw; }
        if (y + ph > bottom_lim) {
            let up: i32 = ay - ph - gap;
            if (up >= cy + margin) { y = up; }
            else { y = bottom_lim - ph; }
        }
    } else if (side == 1) {
        y = ay - ph - gap;
        if (align == 1) { x = ax + (aw - pw) / 2; }
        else if (align == 2) { x = ax + aw - pw; }
        if (y < cy + margin) {
            let dn: i32 = ay + ah + gap;
            if (dn + ph <= bottom_lim) { y = dn; }
            else { y = cy + margin; }
        }
    } else if (side == 2) {
        x = ax + aw + gap;
        if (align == 1) { y = ay + (ah - ph) / 2; }
        else if (align == 2) { y = ay + ah - ph; }
        if (x + pw > right_lim) {
            let lf: i32 = ax - pw - gap;
            if (lf >= cx + margin) { x = lf; }
            else { x = right_lim - pw; }
        }
    } else {
        x = ax - pw - gap;
        if (align == 1) { y = ay + (ah - ph) / 2; }
        else if (align == 2) { y = ay + ah - ph; }
        if (x < cx + margin) {
            let rt: i32 = ax + aw + gap;
            if (rt + pw <= right_lim) { x = rt; }
            else { x = cx + margin; }
        }
    }
    if (x + pw > right_lim) { x = right_lim - pw; }
    if (x < cx + margin) { x = cx + margin; }
    if (y + ph > bottom_lim) { y = bottom_lim - ph; }
    if (y < cy + margin) { y = cy + margin; }
    g_aui_popup_px = x;
    g_aui_popup_py = y;
    g_aui_popup_pw = pw;
    g_aui_popup_ph = ph;
    let r: i32 = arrange(g_aui_popup, x, y, pw, ph);
    return 0;
}

// v1.39：浮层命中。内容里的孩子返回自身下标，面/内边距 -2（吞掉），
// 浮层外 -1（松手时关闭）。
fn popup_hit(px: i32, py: i32) : i32 {
    if (g_aui_popup < 0) { return -1; }
    let qx: i32 = px << 16;
    let qy: i32 = py << 16;
    if (qx < g_aui_popup_px || qy < g_aui_popup_py ||
        qx >= g_aui_popup_px + g_aui_popup_pw ||
        qy >= g_aui_popup_py + g_aui_popup_ph) {
        return -1;
    }
    let h: i32 = hit_test(g_aui_popup, px, py);
    if (h == g_aui_popup) { return -2; }
    return h;
}

// v1.39：浮层底板。和菜单一样是 1 dp 描边 + 8 dp 圆角 + 偏移阴影近似，
// 内容用同一套 paint_node 画，所以按钮/开关/进度条在浮层里与页面一致。
fn paint_popup() : i32 {
    if (g_aui_popup < 0) { return 0; }
    let x: i32 = g_aui_popup_px;
    let y: i32 = g_aui_popup_py;
    let w: i32 = g_aui_popup_pw;
    let h: i32 = g_aui_popup_ph;
    if (w <= 0 || h <= 0) { return 0; }
    let sv: i32 = present_save_clip();
    present_clip_to(x, y, w, h);
    let rsh: i32 = cmd_add(1, x + dp2q(1), y + dp2q(2), w, h, 0x33000000,
                           shape_q(AUI_SHAPE_SMALL), g_aui_null, 0, 0);
    let bd: i32 = dp2q(1);
    if (bd < 65536) { bd = 65536; }
    let rb: i32 = cmd_add(1, x, y, w, h, i32(theme_hint()), shape_q(AUI_SHAPE_SMALL),
                          g_aui_null, 0, 0);
    let iw: i32 = w - bd * 2;
    let ih: i32 = h - bd * 2;
    let sx: i32 = x + bd;
    let sy: i32 = y + bd;
    if (iw > 0 && ih > 0) {
        let rs: i32 = cmd_add(1, sx, sy, iw, ih, i32(theme_surface()),
                              dp2q(7), g_aui_null, 0, 0);
    }
    let saved_bg: u32 = g_aui_paint_bg;
    g_aui_paint_bg = theme_surface();
    let pn: ptr<AuiNode> = node_at(g_aui_popup);
    let c: i32 = pn.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let rp: i32 = paint_node(c);
        c = cn.next_sibling;
    }
    g_aui_paint_bg = saved_bg;
    present_restore_clip();
    return 0;
}

// v1.24：一页按列容器排列；高度由分页容器固定，权重子项分剩余高度。
fn arrange_page(n: ptr<AuiNode>) : i32 {
    return arrange_column(n);
}

// ---- 菜单手势（v1.35）----
// DOWN 记录落点与条目；MOVE 超过 8 dp 进入拖动（取消按下态并按位移
// 滚动内部内容）；UP 以 DOWN 的条目为准，同一目标才激活。
fn menu_pointer_down(px: i32, py: i32) : i32 {
    g_aui_menu_dx = px;
    g_aui_menu_dy = py;
    g_aui_menu_drag = 0;
    g_aui_menu_press = -1;
    g_aui_menu_off0 = g_aui_menu_off;
    g_aui_menu_down = menu_hit(px, py);
    if (g_aui_menu_down >= 0) {
        let hn: ptr<AuiNode> = node_at(g_aui_menu_down);
        if ((hn.flags & AUI_MENU_DISABLED) == 0) {
            g_aui_menu_press = hn.aux2;
        }
    }
    return 0;
}

fn menu_pointer_move(px: i32, py: i32) : i32 {
    if (g_aui_menu < 0) { return 0; }
    let dx: i32 = px - g_aui_menu_dx;
    let dy: i32 = py - g_aui_menu_dy;
    let adx: i32 = iabs(dx);
    let ady: i32 = iabs(dy);
    let slop: i32 = dp2q(8) >> 16;
    if (g_aui_menu_drag == 0 && (adx > slop || ady > slop)) {
        g_aui_menu_drag = 1;
        g_aui_menu_press = -1;
        aui_invalidate();
    }
    if (g_aui_menu_drag != 0 && g_aui_menu_max > 0) {
        let nv: i32 = g_aui_menu_off0 - dy * 65536;
        if (nv < 0) { nv = 0; }
        if (nv > g_aui_menu_max) { nv = g_aui_menu_max; }
        if (nv != g_aui_menu_off) {
            g_aui_menu_off = nv;
            aui_invalidate_layout();
        }
    }
    return 0;
}

fn menu_pointer_up(px: i32, py: i32) : i32 {
    let dh: i32 = g_aui_menu_down;
    let dragged: i32 = g_aui_menu_drag;
    g_aui_menu_down = -3;
    g_aui_menu_drag = 0;
    g_aui_menu_press = -1;
    if (g_aui_menu < 0) { return 0; }
    if (dragged != 0) {
        aui_invalidate();
        return 0;
    }
    if (dh == -1) {
        let r: i32 = menu_close(AUI_MENU_REASON_OUTSIDE);
        aui_invalidate();
        return 0;
    }
    if (dh == -2) {
        // 菜单面/内边距：吞掉点击，不关闭。
        aui_invalidate();
        return 0;
    }
    if (dh >= 0) {
        let hit: i32 = menu_hit(px, py);
        if (hit == dh) {
            let a: i32 = menu_activate(dh);
        }
    }
    aui_invalidate();
    return 0;
}


// v1.24：分页容器。所有页并排，第 i 页 x = 视口 x + i*页宽 - offset。
// offset 按 key 跨帧保存；首次布局直接落到 selected，之后 selected
// 变化或拖动松手用 200 ms ease-out 过渡。裁剪在绘制阶段完成。
fn arrange_pager(n: ptr<AuiNode>) : i32 {
    let cx: i32 = n.x + n.pad;
    let cy: i32 = n.y + n.pad;
    let iw: i32 = n.w - n.pad * 2;
    let ih: i32 = n.h - n.pad * 2;
    if (iw < 0) { iw = 0; }
    if (ih < 0) { ih = 0; }
    let cnt: i32 = 0;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        cnt = cnt + 1;
        c = cn.next_sibling;
    }
    let sel: i32 = n.aux;
    if (sel < 0) { sel = 0; }
    if (cnt > 0 && sel >= cnt) { sel = cnt - 1; }
    let maxoff: i32 = 0;
    if (cnt > 1) { maxoff = (cnt - 1) * iw; }
    pager_store_max(n.key, maxoff);
    let si: i32 = pager_slot(n.key);
    let off: i32 = 0;
    if (si >= 0) {
        if (g_aui_pager_init[si] == 0) {
            g_aui_pager_off[si] = sel * iw;
            g_aui_pager_init[si] = 1;
            g_aui_pager_anim_on[si] = 0;
        } else {
            let target: i32 = sel * iw;
            if (g_aui_pager_drag_key != n.key &&
                g_aui_pager_anim_on[si] == 0 &&
                g_aui_pager_off[si] != target) {
                let a: i32 = pager_anim_to(n.key, target, 200);
            }
        }
        off = g_aui_pager_off[si];
    } else {
        // key 非法的容器也至少把 selected 页摆在视口里（没有拖动动画）。
        off = sel * iw;
    }
    n.aux2 = off;
    let idx: i32 = 0;
    c = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        cn.aux2 = idx;
        let x: i32 = cx + idx * iw - off;
        let r: i32 = arrange(c, x, cy, iw, ih);
        idx = idx + 1;
        c = cn.next_sibling;
    }
    return 0;
}

// ===========================================================================
// 6. 绘制列表
// ===========================================================================

fn cmd_add(op: i32, x: i32, y: i32, w: i32, h: i32,
           color: i32, radius: i32, text: ptr, tlen: i32, aux: i32) : i32 {
    if (g_aui_cmd_count >= AUI_CMD_CAP) { let e: i32 = aui_set_err(AUI_ERR_CMD_FULL); return -1; }
    let c: ptr<AuiCmd> = cmd_at(g_aui_cmd_count);
    // v1.10：绘制阶段的动画位移/透明度在这里统一叠加，节点子树自然继承。
    let col: i32 = color;
    if (g_aui_paint_alpha < 255) {
        let ca: i32 = (color >> 24) & 255;
        let na: i32 = (ca * g_aui_paint_alpha + 127) / 255;
        col = (na << 24) | (color & 0x00FFFFFF);
    }
    // v2.16：缩放变换（栈空时恒等，走原分支）。op 9/10 的 radius 是
    // 旋转角（度），不缩放；op 10 的 h 是字高（位图定尺寸），不缩放。
    let qx: i32 = x + g_aui_paint_dx;
    let qy: i32 = y + g_aui_paint_dy;
    let qw: i32 = w;
    let qh: i32 = h;
    let qr: i32 = radius;
    if (g_aui_paint_sc_d != 0) {
        qx = paint_scale_x(qx);
        qy = paint_scale_y(qy);
        qw = paint_scale_w(w);
        if (op != 10) { qh = paint_scale_w(h); }
        if (op != 9 && op != 10) { qr = paint_scale_w(radius); }
    }
    c.op = op;
    c.x = qx;
    c.y = qy;
    c.w = qw; c.h = qh;
    c.color = col;
    c.radius = qr;
    c.text = text;
    c.tlen = tlen;
    c.aux = aux;
    c.cx = g_aui_clip_x;
    c.cy = g_aui_clip_y;
    c.cw = g_aui_clip_w;
    c.ch = g_aui_clip_h;
    g_aui_cmd_count = g_aui_cmd_count + 1;
    return g_aui_cmd_count;
}

// v1.48.2：把整屏命令列表存进快照池。只在 build/layout 过的整屏帧后调用。
// 命令里的 text 指针保持原样：局部帧不重建节点树，文本地址稳定；真正改文本
// 的路径都会触发 build，快照随之更新。
fn cmd_snapshot() : i32 {
    let n: i32 = g_aui_cmd_count;
    if (n > AUI_CMD_CAP) { n = AUI_CMD_CAP; }
    let k: i32 = 0;
    let w: i32 = n * 8;                          // 每条命令 64 B = 8 个 i64
    while (k < w) {
        g_aui_snap_pool[k] = g_aui_cmd_pool[k];
        k = k + 1;
    }
    g_aui_snap_count = n;
    g_aui_snap_rs = g_aui_rip_cs;
    g_aui_snap_re = g_aui_rip_ce;
    // v2.16.1：快照已对上当前数字缓冲内容，清掉变化标记。
    g_aui_num_changed = 0;
    return n;
}

// 相对上一张整屏帧，是否只有波纹那一段命令变了。波纹命令条数会随半径变化，
// 所以前后缀按“波纹起止下标 + 长度差”对齐，而不是逐下标直接比。
fn cmd_only_ripple_changed() : i32 {
    if (g_aui_snap_count <= 0) { return 0; }
    let n: i32 = g_aui_cmd_count;
    let sn: i32 = g_aui_snap_count;
    let rs: i32 = g_aui_rip_cs;
    let re: i32 = g_aui_rip_ce;
    if (rs < 0 || re < rs) { return 0; }
    let srs: i32 = g_aui_snap_rs;
    let sre: i32 = g_aui_snap_re;
    if (srs < 0) { srs = rs; sre = rs; }         // 快照里没有波纹
    if (rs != srs) { return 0; }                 // 波纹换了节点/位置
    if (n - re != sn - sre) { return 0; }
    let k: i32 = 0;
    while (k < rs * 8) {                         // 前缀
        if (g_aui_cmd_pool[k] != g_aui_snap_pool[k]) { return 0; }
        k = k + 1;
    }
    let d8: i32 = (re - sre) * 8;
    let j: i32 = re * 8;
    let e: i32 = n * 8;
    while (j < e) {                              // 后缀
        if (g_aui_cmd_pool[j] != g_aui_snap_pool[j - d8]) { return 0; }
        j = j + 1;
    }
    return 1;
}

fn snap_at(i: i32) : ptr<AuiCmd> {
    return g_aui_snap_cmds + i * sizeof(AuiCmd);
}

// 把一条命令的裁剪后矩形（像素）并进 out[0..3]（[l, t, r, b]）。
// 命令的 x/y/w/h 与裁剪都是 Q16.16 屏幕坐标；矩形为空（完全被裁掉）
// 时不并入。out 初值应为 [大, 大, -1, -1]。
fn cmd_union_cmd_rect(c: ptr<AuiCmd>, out: ptr) : i32 {
    let x0: i32 = fx_px(c.x);
    let y0: i32 = fx_px(c.y);
    let x1: i32 = fx_px(c.x + c.w);
    let y1: i32 = fx_px(c.y + c.h);
    let cx0: i32 = fx_px(c.cx);
    let cy0: i32 = fx_px(c.cy);
    let cx1: i32 = fx_px(c.cx + c.cw);
    let cy1: i32 = fx_px(c.cy + c.ch);
    if (x0 < cx0) { x0 = cx0; }
    if (y0 < cy0) { y0 = cy0; }
    if (x1 > cx1) { x1 = cx1; }
    if (y1 > cy1) { y1 = cy1; }
    if (x1 <= x0 || y1 <= y0) { return 0; }
    if (x0 < *(out + 0)) { *(out + 0) = x0; }
    if (y0 < *(out + 4)) { *(out + 4) = y0; }
    if (x1 > *(out + 8)) { *(out + 8) = x1; }
    if (y1 > *(out + 12)) { *(out + 12) = y1; }
    return 1;
}

// v2.16.1：动画损伤矩形。比较当前命令表与上一张已呈现帧的快照，
// 返回 1 且 out 写 [l, t, r, b]（像素，已夹到屏幕、每边外扩 1 px）
// 时可走局部重画；否则返回 0（整屏重画）。build 帧也可以：快照是
// 上一张已呈现帧，重建后命令逐条比较 + 面积上限，安全；条数变化、
// 旋转命令（op 9/10，包围盒算不准）、损伤面积超 1/4 屏时都返回 0。
// op 3（图像）的像素缓冲可变，命令字节不变也可能换了内容，所以凡
// 是当前表里有的 op 3，一律并进损伤矩形。
fn cmd_anim_damage(out: ptr) : i32 {
    g_aui_dmg_why = 0;
    g_aui_dmg_diffn = 0;
    g_aui_dmg_first = -1;
    g_aui_dmg_firstop = -1;
    g_aui_dmg_word = -1;
    g_aui_dmg_old = 0;
    g_aui_dmg_new = 0;
    if (g_aui_snap_count <= 0) { g_aui_dmg_why = 1; return 0; }
    let n: i32 = g_aui_cmd_count;
    if (n <= 0) { g_aui_dmg_why = 2; return 0; }
    if (n != g_aui_snap_count) { g_aui_dmg_why = 3; return 0; }
    let acc: i32[4] = 0;
    acc[0] = 1000000;
    acc[1] = 1000000;
    acc[2] = -1;
    acc[3] = -1;
    let i: i32 = 0;
    while (i < n) {
        let base: i32 = i * 8;
        let c: ptr<AuiCmd> = cmd_at(i);
        let op: i32 = c.op;
        let diffw: i32 = -1;
        let diff: i32 = 0;
        let k: i32 = 0;
        while (k < 8) {
            if (g_aui_cmd_pool[base + k] != g_aui_snap_pool[base + k]) {
                diff = 1;
                if (diffw < 0) { diffw = k; }
                if ((op == 9 || op == 10) && g_aui_dmg_word < 0) {
                    g_aui_dmg_word = k;
                    g_aui_dmg_old = g_aui_snap_pool[base + k];
                    g_aui_dmg_new = g_aui_cmd_pool[base + k];
                }
            }
            k = k + 1;
        }
        if (diff != 0) {
            g_aui_dmg_diffn = g_aui_dmg_diffn + 1;
            if (g_aui_dmg_first < 0) {
                g_aui_dmg_first = i;
                g_aui_dmg_firstop = op;
            }
            if (op == 9 || op == 10) { g_aui_dmg_why = 4; return 0; }
            let u1: i32 = cmd_union_cmd_rect(c, acc);
            let sc: ptr<AuiCmd> = snap_at(i);
            let u2: i32 = cmd_union_cmd_rect(sc, acc);
        } else if (op == 3) {
            let u3: i32 = cmd_union_cmd_rect(c, acc);
        } else if (op == 2) {
            // v2.16.1：数字格式化文本（aui_text_i32）写共享 g_aui_num_buf，
            // 命令存的指针不变、内容原地改写，64 B 比较看不见。只在
            // g_aui_num_changed 置位（i32_to_str 比出内容真变了）时，
            // 才把指向该缓冲的文本矩形并进来；无变化时不并——否则读数
            // 标签每帧都被并入，损伤矩形从弹簧卡片一路拉到读数行，
            // 包围盒超 1/4 屏、损伤门永远不开。
            if (g_aui_num_changed != 0) {
                let tp: i64 = i64(c.text);
                let nb: i64 = i64(g_aui_num_buf);
                if (tp >= nb && tp < nb + 2048) {
                    let u4: i32 = cmd_union_cmd_rect(c, acc);
                }
            }
        }
        i = i + 1;
    }
    if (acc[2] < 0 || acc[3] < 0) { g_aui_dmg_why = 5; return 0; }
    let l: i32 = acc[0];
    let t: i32 = acc[1];
    let r: i32 = acc[2];
    let b: i32 = acc[3];
    if (l < 0) { l = 0; }
    if (t < 0) { t = 0; }
    if (r > g_aui_fb_w) { r = g_aui_fb_w; }
    if (b > g_aui_fb_h) { b = g_aui_fb_h; }
    if (r <= l || b <= t) { g_aui_dmg_why = 6; return 0; }
    // 每边外扩 1 px，防 Q16.16 取整在新旧矩形交界处留 1 px 缝。
    l = l - 1; if (l < 0) { l = 0; }
    t = t - 1; if (t < 0) { t = 0; }
    r = r + 1; if (r > g_aui_fb_w) { r = g_aui_fb_w; }
    b = b + 1; if (b > g_aui_fb_h) { b = g_aui_fb_h; }
    g_aui_dmg_try_l = l;
    g_aui_dmg_try_t = t;
    g_aui_dmg_try_r = r;
    g_aui_dmg_try_b = b;
    // 损伤面积超 1/4 屏就整屏（局部重画省得还不如整屏）。
    let area: i64 = i64(r - l) * i64(b - t);
    let full: i64 = i64(g_aui_fb_w) * i64(g_aui_fb_h);
    if (area * 4 > full) { g_aui_dmg_why = 7; return 0; }
    *(out + 0) = l;
    *(out + 4) = t;
    *(out + 8) = r;
    *(out + 12) = b;
    return 1;
}

// v1.32.1：圆环/圆弧命令（op 4）。x/y 是外接正方形左上角，d 是直径，
// radius 存内半径，aux 存“起点 | 跨度 << 16”（Q16.16 圈，0 = 12 点，
// 顺时针；跨度 65535 表示整圈）。角度与内外半径都交给光栅器逐像素求
// 覆盖率，所以一条命令就能画完整圈，也不会出现圆点重叠的波纹。
fn cmd_ring(x: i32, y: i32, d: i32, color: i32,
            rin: i32, start: i32, span: i32) : i32 {
    if (span <= 0) { return 0; }
    let sp: i32 = span;
    if (sp > 65535) { sp = 65535; }
    let st: i32 = start & 65535;
    let aux: i32 = st | (sp << 16);
    return cmd_add(4, x, y, d, d, color, rin, g_aui_null, 0, aux);
}

// v2.6.2：半圆填充命令（op 7）。x/y 是外接正方形左上角，d 是直径，
// aux 存方向（0 左 / 1 右 / 2 上 / 3 下，直径边含在内）。
fn cmd_half(x: i32, y: i32, d: i32, color: i32, dir: i32) : i32 {
    return cmd_add(7, x, y, d, d, color, 0, g_aui_null, 0, dir);
}

// v2.6.2：虚线环命令（op 8）。x/y/d/color/rin 与 cmd_ring 相同；
// aux 存“起点 | 虚线长 << 16”（Q16.16 圈），tlen 存周期；跨度恒整圈。
fn cmd_dashring(x: i32, y: i32, d: i32, color: i32,
                rin: i32, start: i32, dash_len: i32, period: i32) : i32 {
    if (dash_len <= 0 || period <= dash_len) { return 0; }
    let st: i32 = start & 65535;
    let dl: i32 = dash_len & 65535;
    let aux: i32 = st | (dl << 16);
    return cmd_add(8, x, y, d, d, color, rin, g_aui_null, period, aux);
}

// v1.33：三角形（op 5，用于树视图的展开指示）。dir = 0 右指（收起）、
// 1 下指（展开）。斜边按像素覆盖率过渡，避免 12 dp 小图标出现台阶。
fn cmd_tri(x: i32, y: i32, w: i32, h: i32, color: i32, dir: i32) : i32 {
    return cmd_add(5, x, y, w, h, color, 0, g_aui_null, 0, dir);
}

// ===========================================================================
// v2.6：Canvas 绘制原语。只在 draw_fn 执行期间（g_aui_in_cv != 0）
// 发命令；回调外调用返回 -1，不发命令、不静默兜底。坐标一律相对
// Canvas 左上角（dp），先换算成绝对 Q16.16 像素再进 cmd_add（cmd_add
// 会再加动画 paint 偏移，所以这里只加节点原点，不加 paint 偏移）。
// 超出 Canvas 矩形的部分由 paint_node 收窄后的裁剪挡住，不拒绝。
// ===========================================================================

fn aui_cv_size(out: ptr) : i32 {
    if (g_aui_in_cv == 0) { return -1; }
    let p: ptr<i32> = out;
    p[0] = g_aui_cv_w;
    p[1] = g_aui_cv_h;
    return 0;
}

fn aui_cv_rect(x: i32, y: i32, w: i32, h: i32, color: i32, radius_dp: i32) : i32 {
    if (g_aui_in_cv == 0) { return -1; }
    return cmd_add(1, g_aui_cv_ox + dp2q(x), g_aui_cv_oy + dp2q(y),
                   dp2q(w), dp2q(h), color, dp2q(radius_dp),
                   g_aui_null, 0, 0);
}

fn aui_cv_text(x: i32, y: i32, text: ptr, color: i32) : i32 {
    if (g_aui_in_cv == 0) { return -1; }
    // 与 emit_text_lines 同一套行框：行高 text_line_h()，字形在行框内
    // 垂直居中（(lh-gh)/2），所以 Canvas 文本与普通 Label 的基线一致。
    let tlen: i32 = str_len(text);
    let lw: i32 = text_measure(text, tlen, 0);
    let lh: i32 = text_line_h();
    let gh: i32 = text_glyph_h();
    let ty: i32 = g_aui_cv_oy + dp2q(y) + (lh - gh) / 2;
    return cmd_add(2, g_aui_cv_ox + dp2q(x), ty, lw, lh,
                   color, 0, text, tlen, 0);
}

fn aui_cv_image(x: i32, y: i32, w: i32, h: i32, rgba: ptr, iw: i32, ih: i32) : i32 {
    if (g_aui_in_cv == 0) { return -1; }
    return cmd_add(3, g_aui_cv_ox + dp2q(x), g_aui_cv_oy + dp2q(y),
                   dp2q(w), dp2q(h), 0xFF000000, 0, rgba, iw, ih);
}

fn aui_cv_ring(x: i32, y: i32, d: i32, color: i32, ring_dp: i32) : i32 {
    if (g_aui_in_cv == 0) { return -1; }
    // ring_dp is the THICKNESS (documented contract in aui.ast);
    // the display-list command stores the inner radius, so convert:
    // rin = outer radius - thickness. ring_dp == 0 -> filled disc
    // (rin 0); a thickness >= the radius also fills the disc.
    let orad: i32 = dp2q(d) / 2;
    let rin: i32 = 0;
    if (ring_dp > 0) {
        rin = orad - dp2q(ring_dp);
        if (rin < 0) { rin = 0; }
    }
    return cmd_ring(g_aui_cv_ox + dp2q(x), g_aui_cv_oy + dp2q(y),
                    dp2q(d), color, rin, 0, 65536);
}

fn aui_cv_tri(x: i32, y: i32, w: i32, h: i32, color: i32, dir: i32) : i32 {
    if (g_aui_in_cv == 0) { return -1; }
    return cmd_tri(g_aui_cv_ox + dp2q(x), g_aui_cv_oy + dp2q(y),
                   dp2q(w), dp2q(h), color, dir);
}

// v2.6.2：半圆填充。dir: 0 左 / 1 右 / 2 上 / 3 下（直径边含在内）；
// 其它 dir 不发命令，返回 0。
fn aui_cv_half(x: i32, y: i32, d: i32, color: i32, dir: i32) : i32 {
    if (g_aui_in_cv == 0) { return -1; }
    if (dir < 0 || dir > 3) { return 0; }
    return cmd_half(g_aui_cv_ox + dp2q(x), g_aui_cv_oy + dp2q(y),
                    dp2q(d), color, dir);
}

// 角度 → Q16.16 圈（0 = 12 点，顺时针），归一化到 [0, 360)。
fn cv_deg_q(deg: i32) : i32 {
    let d: i32 = deg % 360;
    if (d < 0) { d = d + 360; }
    return d * 65536 / 360;
}

// 跨度 → Q16.16 圈，钳在 [0, 65536]（65536 = 整圈，cmd_ring 再钳到 65535）。
fn cv_span_q(deg: i32) : i32 {
    if (deg <= 0) { return 0; }
    if (deg >= 360) { return 65536; }
    return deg * 65536 / 360;
}

// v2.6.2：弧线描边。start_deg/span_deg 为度数（0 = 12 点，顺时针；
// 与 HuxerUI 的 0 = 3 点不同，调用方换算）；thick_dp 为环厚，0 为
// 实心扇形。span <= 0 不发命令。
fn aui_cv_arc(x: i32, y: i32, d: i32, color: i32, thick_dp: i32,
              start_deg: i32, span_deg: i32) : i32 {
    if (g_aui_in_cv == 0) { return -1; }
    let orad: i32 = dp2q(d) / 2;
    let rin: i32 = 0;
    if (thick_dp > 0) {
        rin = orad - dp2q(thick_dp);
        if (rin < 0) { rin = 0; }
    }
    return cmd_ring(g_aui_cv_ox + dp2q(x), g_aui_cv_oy + dp2q(y),
                    dp2q(d), color, rin, cv_deg_q(start_deg), cv_span_q(span_deg));
}

// v2.6.2：虚线环（整圈）。dash_deg/gap_deg 为度数；无效虚线
// （dash <= 0 或 gap <= 0）不发命令，返回 0。
fn aui_cv_dashring(x: i32, y: i32, d: i32, color: i32, thick_dp: i32,
                   start_deg: i32, dash_deg: i32, gap_deg: i32) : i32 {
    if (g_aui_in_cv == 0) { return -1; }
    let orad: i32 = dp2q(d) / 2;
    let rin: i32 = 0;
    if (thick_dp > 0) {
        rin = orad - dp2q(thick_dp);
        if (rin < 0) { rin = 0; }
    }
    let dl: i32 = cv_span_q(dash_deg);
    let pd: i32 = cv_span_q(dash_deg + gap_deg);
    if (dl <= 0 || pd <= dl) { return 0; }
    return cmd_dashring(g_aui_cv_ox + dp2q(x), g_aui_cv_oy + dp2q(y),
                        dp2q(d), color, rin, cv_deg_q(start_deg), dl, pd);
}

fn aui_cv_line(x0: i32, y0: i32, x1: i32, y1: i32, color: i32, half_dp: i32) : i32 {
    if (g_aui_in_cv == 0) { return -1; }
    return cmd_seg(g_aui_cv_ox + dp2q(x0), g_aui_cv_oy + dp2q(y0),
                   g_aui_cv_ox + dp2q(x1), g_aui_cv_oy + dp2q(y1),
                   color, dp2q(half_dp));
}

let AUI_COLOR_BG: i32 = 0;
let AUI_COLOR_SURFACE: i32 = 1;
let AUI_COLOR_PRIMARY: i32 = 2;
let AUI_COLOR_PRIMARY_DARK: i32 = 3;
let AUI_COLOR_TEXT: i32 = 4;
let AUI_COLOR_ON_PRIMARY: i32 = 5;
let AUI_COLOR_HINT: i32 = 6;
let AUI_COLOR_PRESSED: i32 = 7;
let AUI_COLOR_TINT: i32 = 8;
let AUI_COLOR_SCROLLBAR: i32 = 9;
let AUI_COLOR_KEYBOARD_BG: i32 = 10;
let AUI_COLOR_SYSTEM_BAR: i32 = 11;

// ===========================================================================
// v2.15：主题令牌（ThemeSpec，对照 HuxerUI include/huxerui/theme.h）。
// ---------------------------------------------------------------------------
// 颜色令牌 16 个（0-11 与旧数字角色一一对应，12-15 新增）：
//   0 background / 1 surface / 2 primary / 3 primary_dark /
//   4 on_surface（旧名 text）/ 5 on_primary /
//   6 on_surface_variant（旧名 hint）/ 7 pressed /
//   8 primary_container（旧名 tint）/ 9 scrollbar / 10 keyboard_bg /
//   11 system_bar / 12 scrim / 13 error /
//   14 inverse_surface / 15 inverse_on_surface
// 浅/深两套调色板的值逐字取自 v2.14 的 theme_color（像素恒等，见
// theme_test）；新增令牌的值取自框架里已有的同义字面量：scrim =
// 底部弹出层遮罩 0x6B000000（42% 黑）、error = HuxerUI 错误红、
// inverse_surface/inverse_on_surface = DEBUG 面板底/标题字（面板在
// 两主题下都是固定深色，所以 inverse_surface 两套同值——面板是诊断
// 浮层，不是主题表面，见 ADOPTION-NOTES）。
// 令牌是唯一事实源：theme_color(role) 只做查表；旧的数字角色 0-11
// 继续有效（aui_theme_color 的兼容入口）。
// 局部主题（aui_theme_begin/set）：覆盖值存在 8 槽登记表里（与
// Split 的登记表同一模式），解析时从当前主题栈顶向下找第一个设过
// 该令牌的槽，找不到落到全局调色板；形状令牌同理。栈由 build
// （aui_theme_begin/aui_end）与 paint（paint_node 进出 kind 62）
// 各自维护，aui_root()/pump_ui() 绘制段入口各复位一次；不平衡的
// aui_end 漏调只影响当帧（下一帧 aui_root 复位）。
// ===========================================================================
let AUI_TOK_BACKGROUND: i32 = 0;
let AUI_TOK_SURFACE: i32 = 1;
let AUI_TOK_PRIMARY: i32 = 2;
let AUI_TOK_PRIMARY_DARK: i32 = 3;
let AUI_TOK_ON_SURFACE: i32 = 4;
let AUI_TOK_ON_PRIMARY: i32 = 5;
let AUI_TOK_ON_SURFACE_VARIANT: i32 = 6;
let AUI_TOK_PRESSED: i32 = 7;
let AUI_TOK_PRIMARY_CONTAINER: i32 = 8;
let AUI_TOK_SCROLLBAR: i32 = 9;
let AUI_TOK_KEYBOARD_BG: i32 = 10;
let AUI_TOK_SYSTEM_BAR: i32 = 11;
let AUI_TOK_SCRIM: i32 = 12;
let AUI_TOK_ERROR: i32 = 13;
let AUI_TOK_INVERSE_SURFACE: i32 = 14;
let AUI_TOK_INVERSE_ON_SURFACE: i32 = 15;
let AUI_TOK_COUNT: i32 = 16;

let g_aui_pal_light: u32[16] = 0;
let g_aui_pal_dark: u32[16] = 0;
let g_aui_pal_init: i32 = 0;

fn theme_pal_init() : i32 {
    if (g_aui_pal_init != 0) { return 0; }
    g_aui_pal_init = 1;
    g_aui_pal_light[0] = 0xFFF6F6F8;
    g_aui_pal_light[1] = 0xFFFFFFFF;
    g_aui_pal_light[2] = 0xFF3A6DF0;
    g_aui_pal_light[3] = 0xFF2B55C8;
    g_aui_pal_light[4] = 0xFF1A1A1E;
    g_aui_pal_light[5] = 0xFFFFFFFF;
    g_aui_pal_light[6] = 0xFF8A8A93;
    g_aui_pal_light[7] = 0xFFE8EEFF;
    g_aui_pal_light[8] = 0xFFEDF1FA;
    g_aui_pal_light[9] = 0xFFAEB8CC;
    g_aui_pal_light[10] = 0xFFE9E9EE;
    g_aui_pal_light[11] = 0xFFF6F6F8;
    g_aui_pal_light[12] = 0x6B000000;
    g_aui_pal_light[13] = 0xFFE53935;
    g_aui_pal_light[14] = 0xF711161F;
    g_aui_pal_light[15] = 0xFFFFFFFF;
    g_aui_pal_dark[0] = 0xFF121216;
    g_aui_pal_dark[1] = 0xFF1E1E24;
    g_aui_pal_dark[2] = 0xFF6E96FF;
    g_aui_pal_dark[3] = 0xFF4F79E8;
    g_aui_pal_dark[4] = 0xFFEFEFF4;
    g_aui_pal_dark[5] = 0xFF0B1020;
    g_aui_pal_dark[6] = 0xFF9A9AA6;
    g_aui_pal_dark[7] = 0xFF2A3550;
    g_aui_pal_dark[8] = 0xFF232A3D;
    g_aui_pal_dark[9] = 0xFF5A5A68;
    g_aui_pal_dark[10] = 0xFF17171C;
    g_aui_pal_dark[11] = 0xFF121216;
    g_aui_pal_dark[12] = 0x6B000000;
    g_aui_pal_dark[13] = 0xFFE57373;
    g_aui_pal_dark[14] = 0xF711161F;
    g_aui_pal_dark[15] = 0xFFFFFFFF;
    return 0;
}

// 全局调色板（不走局部主题栈）：系统栏条带等树外绘制用。
fn theme_token_raw(token: i32) : u32 {
    let r: i32 = theme_pal_init();
    if (token < 0 || token >= AUI_TOK_COUNT) { token = AUI_TOK_ON_SURFACE; }
    if (g_aui_dark != 0) { return g_aui_pal_dark[token]; }
    return g_aui_pal_light[token];
}

// 局部主题登记表：8 槽，槽 = 一套覆盖值（颜色 16 + 形状 6）+ 有效掩码。
let AUI_THEME_SLOTS: i32 = 8;
let g_aui_theme_key: i32[8] = 0;
let g_aui_theme_col: u32[128] = 0;
let g_aui_theme_cmask: i32[8] = 0;
let g_aui_theme_shp: i32[48] = 0;
let g_aui_theme_smask: i32[8] = 0;

// 当前主题栈（槽下标，栈顶 = 最近的祖先 Theme 节点）。
let g_aui_theme_stk: i32[16] = 0;
let g_aui_theme_depth: i32 = 0;

fn theme_slot_for_key(key: i32) : i32 {
    let i: i32 = 0;
    while (i < AUI_THEME_SLOTS) {
        if (g_aui_theme_key[i] == key) { return i; }
        i = i + 1;
    }
    i = 0;
    while (i < AUI_THEME_SLOTS) {
        if (g_aui_theme_key[i] == 0) {
            g_aui_theme_key[i] = key;
            return i;
        }
        i = i + 1;
    }
    // 槽满：复用 0 号槽（嵌套主题超过 8 个是应用错误，旧槽被顶掉）。
    g_aui_theme_key[0] = key;
    return 0;
}

fn theme_slot_clear(slot: i32) : i32 {
    let t: i32 = 0;
    while (t < AUI_TOK_COUNT) {
        g_aui_theme_col[slot * 16 + t] = 0;
        t = t + 1;
    }
    g_aui_theme_cmask[slot] = 0;
    let s: i32 = 0;
    while (s < 6) {
        g_aui_theme_shp[slot * 6 + s] = 0;
        s = s + 1;
    }
    g_aui_theme_smask[slot] = 0;
    return 0;
}

fn theme_push(slot: i32) : i32 {
    if (g_aui_theme_depth < 16) {
        g_aui_theme_stk[g_aui_theme_depth] = slot;
        g_aui_theme_depth = g_aui_theme_depth + 1;
    }
    return 0;
}

fn theme_pop() : i32 {
    if (g_aui_theme_depth > 0) { g_aui_theme_depth = g_aui_theme_depth - 1; }
    return 0;
}

// 栈顶起找第一个覆盖了该颜色令牌的槽；都没有则走全局调色板。
fn theme_resolve(token: i32) : u32 {
    let d: i32 = g_aui_theme_depth - 1;
    while (d >= 0) {
        let slot: i32 = g_aui_theme_stk[d];
        if (((g_aui_theme_cmask[slot] >> token) & 1) != 0) {
            return g_aui_theme_col[slot * 16 + token];
        }
        d = d - 1;
    }
    return theme_token_raw(token);
}

// 主题角色：应用也用 aui_theme_color(role) 取同一个调色板。
// 0 bg / 1 surface / 2 primary / 3 primary_dark / 4 text / 5 on_primary
// 6 hint / 7 pressed / 8 tint / 9 scrollbar / 10 keyboard_bg
// 11 system_bar（v2.13：跟主题底色走 = role 0 的值；图标颜色由 JNI 换）
// v2.15：角色 0-11 即颜色令牌 0-11；令牌表是唯一事实源，值与 v2.14
// 逐字相同。越界角色落到 on_surface（与 v2.14 的回落一致）。
fn theme_color(role: i32) : u32 {
    if (role < 0 || role >= AUI_TOK_COUNT) { role = AUI_TOK_ON_SURFACE; }
    return theme_resolve(role);
}

// 形状令牌（ShapeScheme）：默认值复现 v2.11 的 8 dp 外观——不是
// HuxerUI 的默认值（对话框 12 dp 等）。small=8 是按钮/对话框/弹出层/
// 选择器/日期时间/键盘键的半径；extra_small=4 是复选框；medium=12
// 是 DEBUG 面板；large=16、extra_large=28 目前只供示例卡片用；
// full=10000 表示“胶囊”（半径 = 高的一半，见 shape_radius）。
let AUI_SHAPE_XS: i32 = 0;
let AUI_SHAPE_SMALL: i32 = 1;
let AUI_SHAPE_MEDIUM: i32 = 2;
let AUI_SHAPE_LARGE: i32 = 3;
let AUI_SHAPE_XL: i32 = 4;
let AUI_SHAPE_FULL: i32 = 5;
let AUI_SHAPE_COUNT: i32 = 6;

let g_aui_shape_dp: i32[6] = 0;
let g_aui_shape_init: i32 = 0;

fn shape_init() : i32 {
    if (g_aui_shape_init != 0) { return 0; }
    g_aui_shape_init = 1;
    g_aui_shape_dp[0] = 4;
    g_aui_shape_dp[1] = 8;
    g_aui_shape_dp[2] = 12;
    g_aui_shape_dp[3] = 16;
    g_aui_shape_dp[4] = 28;
    g_aui_shape_dp[5] = 10000;
    return 0;
}

// 形状令牌 -> dp（含最近的局部主题覆盖）。越界落到 small（8）。
fn shape_dp(token: i32) : i32 {
    let r: i32 = shape_init();
    if (token < 0 || token >= AUI_SHAPE_COUNT) { token = AUI_SHAPE_SMALL; }
    let d: i32 = g_aui_theme_depth - 1;
    while (d >= 0) {
        let slot: i32 = g_aui_theme_stk[d];
        if (((g_aui_theme_smask[slot] >> token) & 1) != 0) {
            return g_aui_theme_shp[slot * 6 + token];
        }
        d = d - 1;
    }
    return g_aui_shape_dp[token];
}

// 形状令牌 -> Q16.16 半径（px，160 dpi 下 dp<<16）。
fn shape_q(token: i32) : i32 {
    return dp2q(shape_dp(token));
}

// 形状令牌 + 节点高 -> 实际半径。full（胶囊）= 高的一半；其余按令牌。
fn shape_radius(token: i32, h: i32) : i32 {
    if (token == AUI_SHAPE_FULL) { return h / 2; }
    return shape_q(token);
}

// 读一个形状令牌的 dp 值（应用/示例用）。
fn aui_shape(token: i32) : i32 {
    return shape_dp(token);
}

// 修饰器：给最近创建的节点按形状令牌设半径（紧跟组件调用）。
fn aui_shape_radius(token: i32) : i32 {
    let n: ptr<AuiNode> = modify_target();
    if (n == 0) { return 0; }
    n.radius = shape_q(token);
    return 0;
}

// 间距令牌（SpacingScheme）：4/8/16/24/32 dp。全局值，不进局部主题
// （HuxerUI 的间距也不随主题变）。应用读 aui_space 取值。
let AUI_SPACE_XS: i32 = 0;
let AUI_SPACE_SM: i32 = 1;
let AUI_SPACE_MD: i32 = 2;
let AUI_SPACE_LG: i32 = 3;
let AUI_SPACE_XL: i32 = 4;
let AUI_SPACE_COUNT: i32 = 5;

let g_aui_space_dp: i32[5] = 0;
let g_aui_space_init: i32 = 0;

fn space_init() : i32 {
    if (g_aui_space_init != 0) { return 0; }
    g_aui_space_init = 1;
    g_aui_space_dp[0] = 4;
    g_aui_space_dp[1] = 8;
    g_aui_space_dp[2] = 16;
    g_aui_space_dp[3] = 24;
    g_aui_space_dp[4] = 32;
    return 0;
}

fn aui_space(token: i32) : i32 {
    let r: i32 = space_init();
    if (token < 0 || token >= AUI_SPACE_COUNT) { token = AUI_SPACE_MD; }
    return g_aui_space_dp[token];
}

// 局部主题容器（kind 62）：在子树内覆盖令牌。用法：
//   aui_theme_begin(key);
//   aui_theme_set(AUI_TOK_SURFACE, 0xFF...);   // 颜色覆盖
//   aui_theme_shape(AUI_SHAPE_SMALL, 12);      // 形状覆盖（可选）
//   ... 子树 ...
//   aui_end();
// 覆盖只影响子树（含嵌套子主题——内层覆盖优先于外层）；兄弟与树外
// 不受影响。容器本身不画任何东西、不参与命中（透明包装，measure/
// arrange 走 column）。对话框/浮层是独立的树，不在 Theme 子树里，
// 所以不受覆盖影响；系统栏条带同样在树外。
fn aui_theme_begin(key: i32) : i32 {
    let slot: i32 = theme_slot_for_key(key);
    let rc: i32 = theme_slot_clear(slot);
    let i: i32 = push_container(62, key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    n.aux = slot;
    let rp: i32 = theme_push(slot);
    return i;
}

// 在最近打开的 Theme 容器上设一个颜色覆盖。没有打开的 Theme 时返回 -1。
fn aui_theme_set(token: i32, color: u32) : i32 {
    if (token < 0 || token >= AUI_TOK_COUNT) { return -1; }
    let d: i32 = g_aui_depth;
    while (d > 0) {
        let n: ptr<AuiNode> = node_at(g_aui_stk_parent[d]);
        if (n.kind == 62) {
            let slot: i32 = n.aux;
            g_aui_theme_col[slot * 16 + token] = color;
            g_aui_theme_cmask[slot] = g_aui_theme_cmask[slot] | (1 << token);
            return 0;
        }
        d = d - 1;
    }
    return -1;
}

// 在最近打开的 Theme 容器上设一个形状覆盖（dp）。没有打开的 Theme 时返回 -1。
fn aui_theme_shape(token: i32, dp: i32) : i32 {
    if (token < 0 || token >= AUI_SHAPE_COUNT) { return -1; }
    let d: i32 = g_aui_depth;
    while (d > 0) {
        let n: ptr<AuiNode> = node_at(g_aui_stk_parent[d]);
        if (n.kind == 62) {
            let slot: i32 = n.aux;
            g_aui_theme_shp[slot * 6 + token] = dp;
            g_aui_theme_smask[slot] = g_aui_theme_smask[slot] | (1 << token);
            return 0;
        }
        d = d - 1;
    }
    return -1;
}

// 当前解析出的令牌颜色（含最近的局部主题覆盖）。测试与应用读值用。
fn aui_token_color(token: i32) : u32 {
    if (token < 0 || token >= AUI_TOK_COUNT) { token = AUI_TOK_ON_SURFACE; }
    return theme_resolve(token);
}

// 测试探针：out = [dark, 主题栈深度, 已登记槽数]。
fn aui_debug_theme(out: ptr) : i32 {
    *(out + 0) = g_aui_dark;
    *(out + 4) = g_aui_theme_depth;
    let used: i32 = 0;
    let i: i32 = 0;
    while (i < AUI_THEME_SLOTS) {
        if (g_aui_theme_key[i] != 0) { used = used + 1; }
        i = i + 1;
    }
    *(out + 8) = used;
    return 0;
}

fn theme_bg() : u32 { return theme_color(0); }
fn theme_surface() : u32 { return theme_color(1); }
fn theme_primary() : u32 { return theme_color(2); }
fn theme_primary_dark() : u32 { return theme_color(3); }
fn theme_text() : u32 { return theme_color(4); }
fn theme_on_primary() : u32 { return theme_color(5); }
fn theme_hint() : u32 { return theme_color(6); }
fn theme_pressed() : u32 { return theme_color(7); }
fn theme_tint() : u32 { return theme_color(8); }
fn theme_scrollbar() : u32 { return theme_color(9); }
fn theme_kb_bg() : u32 { return theme_color(10); }
fn theme_system_bar() : u32 {
    if (g_aui_sysbar_fb != 0) {
        // v2.13 回落：图标颜色换不动，条带取与上次已知图标状态配套的
        // 安全色（深色图标配浅色条带，其余配深色），图标在任何主题下都看得见。
        if (g_aui_sysbar_icons == JNI_APPEARANCE_LIGHT_STATUS_BARS) { return 0xFFF6F6F8; }
        if (g_aui_dark != 0) { return 0xFF050507; }
        return 0xFF1B1B1F;
    }
    if (g_aui_sdk < 30) {
        // API 30 以下没有 WindowInsetsController，图标颜色换不动，
        // 条带保持 v1.15 深色（浅色图标落在深色上）。
        if (g_aui_dark != 0) { return 0xFF050507; }
        return 0xFF1B1B1F;
    }
    // v2.15：系统栏在树外，不走局部主题覆盖（theme_token_raw 而非
    // theme_color）；aui_set_system_bar 的显式覆盖仍优先（见调用处）。
    return theme_token_raw(11);
}

fn aui_theme_color(role: i32) : u32 { return theme_color(role); }
fn aui_dark() : i32 { return g_aui_dark; }
fn aui_set_dark(on: i32) : i32 {
    let d: i32 = 0;
    if (on != 0) { d = 1; }
    if (g_aui_dark == d) { return 0; }
    g_aui_dark = d;
    // v2.13：条带跟主题走（role 11 已改跟底色），图标颜色一起换；
    // 换不动时回落（见 theme_system_bar 的回落分支）。
    let sb: i32 = sysbar_apply_icons();
    let tm: i32 = trace_hex(109, g_aui_dark);   // m = 主题（0 浅 / 1 深）
    let r: i32 = aui_invalidate();
    return 0;
}

// 安全区按 dp 返回（向下取整），与布局 API 的单位一致。
// v1.14：返回值来自 calc_insets（系统内容区 + API 35 系统栏估算 +
// 应用最小安全区），不再是原始 onContentRectChanged。
fn px_to_dp(px: i32) : i32 {
    if (g_aui_density <= 0) { return 0; }
    return i32((i64(px) << 16) / i64(g_aui_density));
}
fn aui_safe_left() : i32 {
    return px_to_dp(fx_px(g_aui_inset_l));
}
fn aui_safe_top() : i32 {
    return px_to_dp(fx_px(g_aui_inset_t));
}
fn aui_safe_right() : i32 {
    return px_to_dp(fx_px(g_aui_inset_r));
}
fn aui_safe_bottom() : i32 {
    return px_to_dp(fx_px(g_aui_inset_b));
}

// v1.14：Android 15（API 35）起 targetSdk 35 强制 edge-to-edge，
// 系统内容区会等于整窗。NDK 没有 WindowInsets 查询接口，库按 24dp
// 估算上下系统栏；下面两个 API 让应用覆盖这个估算。
// aui_edge_to_edge(1)：关掉估算，内容按整窗布局（应用自己铺满）。
fn aui_edge_to_edge(on: i32) : i32 {
    g_aui_e2e = 0;
    if (on != 0) { g_aui_e2e = 1; }
    let r: i32 = aui_invalidate();
    return 0;
}

// aui_set_insets：指定最小安全区（dp），与系统/估算值取较大者。
// 例如刘海设备需要更高时传 top=32；传 0 恢复默认。
fn aui_set_insets(left: i32, top: i32, right: i32, bottom: i32) : i32 {
    g_aui_min_l = left;
    g_aui_min_t = top;
    g_aui_min_r = right;
    g_aui_min_b = bottom;
    if (g_aui_min_l < 0) { g_aui_min_l = 0; }
    if (g_aui_min_t < 0) { g_aui_min_t = 0; }
    if (g_aui_min_r < 0) { g_aui_min_r = 0; }
    if (g_aui_min_b < 0) { g_aui_min_b = 0; }
    let r: i32 = aui_invalidate();
    return 0;
}

// v2.13：系统栏条带。条带默认跟主题底色走，图标颜色由框架经 JNI
// 换（API 30+），与条带一起切换；API 30 以下或 JNI 失败时回落
// 深色条带（图标换不动时仍是浅色，落在深色上看得见）。
// 传 0 恢复主题角色。
fn aui_set_system_bar(color: u32) : i32 {
    g_aui_sysbar = color;
    let r: i32 = aui_invalidate();
    return 0;
}

fn aui_system_bar_color() : u32 {
    if (g_aui_sysbar != 0) { return g_aui_sysbar; }
    return theme_system_bar();
}

// ---- 系统栏图标（v2.13，JNI）----
// 运行时图标颜色：NDK 没有 WindowInsetsController 接口，但 NativeActivity
// 进程已有 JVM；从 ANativeActivity 取 JNIEnv（activity+16），再从 JNIEnv
// 表取函数指针调 framework 类（无 dex、无新 DT_NEEDED、无 Java 源码）。
// 调用链：activity clazz → getWindow() → Window → getInsetsController()
// → WindowInsetsController → setSystemBarsAppearance(appearance, mask)。
// appearance/mask：0x8/0x8 = 深色图标（浅色条带）；0/0x8 = 浅色图标
// （深色条带）。只用 ...A 形式（固定 4 参，jvalue 数组 8 字节一格；
// Aster 没有变长调用模型）。主线程调用（主题切换在主线程），本轮
// 不做 AttachCurrentThread。
// 每步都 ExceptionCheck，异常即 ExceptionClear + 回落（条带按上次已
// 知图标状态取安全色，见 theme_system_bar 的回落分支），绝不留浅色
// 条带配白色图标；env 缺失、controller 为空时静默回落，不崩。
// 表下标来源：AOSP libnativehelper include_jni/jni.h，
// JNINativeInterface 结构体顺序计数（见文件头的 JNI_TBL_* 常量）。

// JNI 环境来源：测试注入优先（aui_debug_set_jni_env），否则 activity+16。
fn sysbar_jni_env() : ptr {
    if (g_aui_jni_env != 0) { return g_aui_jni_env; }
    if (g_aui_activity == 0) { return 0; }
    return load_ptr(g_aui_activity + 16);
}

// activity 对象：测试注入优先，否则 activity+24（clazz）。
fn sysbar_jni_act() : ptr {
    if (g_aui_jni_act != 0) { return g_aui_jni_act; }
    if (g_aui_activity == 0) { return 0; }
    return load_ptr(g_aui_activity + 24);
}

// 有异常则清掉并返回 1，无异常返回 0。
fn sysbar_jni_exc(env: ptr, table: ptr) : i32 {
    let fec: fn(ptr) : i32 = load_ptr(table + JNI_TBL_EXCEPTION_CHECK * 8);
    let e: i32 = fec(env) & 255;
    if (e == 0) { return 0; }
    let fcl: fn(ptr) : i32 = load_ptr(table + JNI_TBL_EXCEPTION_CLEAR * 8);
    fcl(env);
    return 1;
}

// 删一个局部引用（0 不删）。
fn sysbar_delref(env: ptr, table: ptr, obj: ptr) : i32 {
    if (obj == 0) { return 0; }
    let fd: fn(ptr, ptr) : i32 = load_ptr(table + JNI_TBL_DELETE_LOCAL_REF * 8);
    fd(env, obj);
    return 0;
}

// 按当前主题调 setSystemBarsAppearance。返回 1 = 已换图标颜色，
// 0 = 回落（g_aui_sysbar_fb = 1，条带取安全色）。失败路径上已建的
// 局部引用在返回前删掉（每步只删已建的，后面的还没建）。
fn sysbar_apply_icons() : i32 {
    let d: i32 = 0;
    if (g_aui_sdk < 30) { g_aui_sysbar_fb = 1; g_aui_sysbar_jni = 2; return 0; }
    let env: ptr = sysbar_jni_env();
    if (env == 0) { g_aui_sysbar_fb = 1; g_aui_sysbar_jni = 2; return 0; }
    let table: ptr = load_ptr(env);
    if (table == 0) { g_aui_sysbar_fb = 1; g_aui_sysbar_jni = 2; return 0; }
    let act: ptr = sysbar_jni_act();
    if (act == 0) { g_aui_sysbar_fb = 1; g_aui_sysbar_jni = 2; return 0; }
    let fgc: fn(ptr, ptr) : ptr = load_ptr(table + JNI_TBL_GET_OBJECT_CLASS * 8);
    let acls: ptr = fgc(env, act);
    if (sysbar_jni_exc(env, table) != 0 || acls == 0) {
        g_aui_sysbar_fb = 1; g_aui_sysbar_jni = 2; return 0;
    }
    let fmid: fn(ptr, ptr, ptr, ptr) : ptr = load_ptr(table + JNI_TBL_GET_METHOD_ID * 8);
    let mwin: ptr = fmid(env, acls, "getWindow", "()Landroid/view/Window;");
    if (sysbar_jni_exc(env, table) != 0 || mwin == 0) {
        d = sysbar_delref(env, table, acls);
        g_aui_sysbar_fb = 1; g_aui_sysbar_jni = 2; return 0;
    }
    d = sysbar_delref(env, table, acls);
    let noargs: i64[2] = 0;
    let fobj: fn(ptr, ptr, ptr, ptr) : ptr = load_ptr(table + JNI_TBL_CALL_OBJECT_METHOD_A * 8);
    let win: ptr = fobj(env, act, mwin, noargs);
    if (sysbar_jni_exc(env, table) != 0 || win == 0) {
        g_aui_sysbar_fb = 1; g_aui_sysbar_jni = 2; return 0;
    }
    let wcls: ptr = fgc(env, win);
    if (sysbar_jni_exc(env, table) != 0 || wcls == 0) {
        d = sysbar_delref(env, table, win);
        g_aui_sysbar_fb = 1; g_aui_sysbar_jni = 2; return 0;
    }
    let mctl: ptr = fmid(env, wcls, "getInsetsController", "()Landroid/view/WindowInsetsController;");
    if (sysbar_jni_exc(env, table) != 0 || mctl == 0) {
        d = sysbar_delref(env, table, wcls);
        d = sysbar_delref(env, table, win);
        g_aui_sysbar_fb = 1; g_aui_sysbar_jni = 2; return 0;
    }
    d = sysbar_delref(env, table, wcls);
    let ctl: ptr = fobj(env, win, mctl, noargs);
    if (sysbar_jni_exc(env, table) != 0 || ctl == 0) {
        d = sysbar_delref(env, table, win);
        g_aui_sysbar_fb = 1; g_aui_sysbar_jni = 2; return 0;
    }
    d = sysbar_delref(env, table, win);
    let ccls: ptr = fgc(env, ctl);
    if (sysbar_jni_exc(env, table) != 0 || ccls == 0) {
        d = sysbar_delref(env, table, ctl);
        g_aui_sysbar_fb = 1; g_aui_sysbar_jni = 2; return 0;
    }
    let mset: ptr = fmid(env, ccls, "setSystemBarsAppearance", "(II)V");
    if (sysbar_jni_exc(env, table) != 0 || mset == 0) {
        d = sysbar_delref(env, table, ccls);
        d = sysbar_delref(env, table, ctl);
        g_aui_sysbar_fb = 1; g_aui_sysbar_jni = 2; return 0;
    }
    d = sysbar_delref(env, table, ccls);
    let appearance: i32 = JNI_APPEARANCE_LIGHT_STATUS_BARS;
    if (g_aui_dark != 0) { appearance = 0; }
    let args: i64[2] = 0;
    args[0] = i64(appearance);
    args[1] = i64(JNI_APPEARANCE_LIGHT_STATUS_BARS);
    let fvoid: fn(ptr, ptr, ptr, ptr) : i32 = load_ptr(table + JNI_TBL_CALL_VOID_METHOD_A * 8);
    fvoid(env, ctl, mset, args);
    if (sysbar_jni_exc(env, table) != 0) {
        d = sysbar_delref(env, table, ctl);
        g_aui_sysbar_fb = 1; g_aui_sysbar_jni = 2; return 0;
    }
    d = sysbar_delref(env, table, ctl);
    g_aui_sysbar_icons = appearance;
    g_aui_sysbar_fb = 0;
    g_aui_sysbar_jni = 1;
    return 1;
}

// 测试辅助：注入假 JNIEnv（headless 无 JVM 时用）。
fn aui_debug_set_jni_env(env: ptr) : i32 {
    g_aui_jni_env = env;
    return 0;
}

fn aui_debug_set_jni_act(act: ptr) : i32 {
    g_aui_jni_act = act;
    return 0;
}

// 测试辅助：上次成功换到的图标 appearance（0 浅色图标 / 8 深色图标）。
fn aui_debug_sysbar_icons() : i32 { return g_aui_sysbar_icons; }

// 测试辅助：JNI 状态（0 从未尝试 / 1 已换 / 2 回落）。
fn aui_debug_sysbar_jni() : i32 { return g_aui_sysbar_jni; }

// ---- 系统栏高度（v2.14，JNI）----
// 经 WindowInsets 读真实上下栏高，缓存后供 calc_insets 用（内容区是
// 整窗/未到时，代替 24dp 估算）。调用链：activity clazz → getWindow()
// → Window → getDecorView() → View → getRootWindowInsets()
// （API 23+；未布局前可能返回空——空是正常回落，不是错，等下一次
// 内容区/配置变化再测）→ API 30+：WindowInsets$Type.statusBars() /
// navigationBars() 取 type int → getInsets(type) → Insets.top/bottom；
// API 30 以下：getSystemWindowInsetTop()/getSystemWindowInsetBottom()
// （已废弃但仍可用）。只用 ...A 形式；每步 ExceptionCheck，异常即
// ExceptionClear + 回落；局部引用逐个删；失败不清除旧缓存（旧值仍
// 是最好信息）。成功且值变了（或首次成功）记一行
// `insets jni top=<px> bottom=<px>`。只在 attach/内容区/配置变化时
// 调，不走逐帧路径。主线程调用。返回 1 = 测到并缓存，0 = 回落。
fn sysbar_measure_insets() : i32 {
    let d: i32 = 0;
    let env: ptr = sysbar_jni_env();
    if (env == 0) { return 0; }
    let table: ptr = load_ptr(env);
    if (table == 0) { return 0; }
    let act: ptr = sysbar_jni_act();
    if (act == 0) { return 0; }
    let fgc: fn(ptr, ptr) : ptr = load_ptr(table + JNI_TBL_GET_OBJECT_CLASS * 8);
    let acls: ptr = fgc(env, act);
    if (sysbar_jni_exc(env, table) != 0 || acls == 0) {
        d = sysbar_delref(env, table, acls);
        return 0;
    }
    let fmid: fn(ptr, ptr, ptr, ptr) : ptr = load_ptr(table + JNI_TBL_GET_METHOD_ID * 8);
    let mwin: ptr = fmid(env, acls, "getWindow", "()Landroid/view/Window;");
    if (sysbar_jni_exc(env, table) != 0 || mwin == 0) {
        d = sysbar_delref(env, table, acls);
        return 0;
    }
    d = sysbar_delref(env, table, acls);
    let noargs: i64[2] = 0;
    let fobj: fn(ptr, ptr, ptr, ptr) : ptr = load_ptr(table + JNI_TBL_CALL_OBJECT_METHOD_A * 8);
    let win: ptr = fobj(env, act, mwin, noargs);
    if (sysbar_jni_exc(env, table) != 0 || win == 0) { return 0; }
    let wcls: ptr = fgc(env, win);
    if (sysbar_jni_exc(env, table) != 0 || wcls == 0) {
        d = sysbar_delref(env, table, win);
        return 0;
    }
    let mdecor: ptr = fmid(env, wcls, "getDecorView", "()Landroid/view/View;");
    if (sysbar_jni_exc(env, table) != 0 || mdecor == 0) {
        d = sysbar_delref(env, table, wcls);
        d = sysbar_delref(env, table, win);
        return 0;
    }
    d = sysbar_delref(env, table, wcls);
    let view: ptr = fobj(env, win, mdecor, noargs);
    if (sysbar_jni_exc(env, table) != 0 || view == 0) {
        d = sysbar_delref(env, table, win);
        return 0;
    }
    d = sysbar_delref(env, table, win);
    let vcls: ptr = fgc(env, view);
    if (sysbar_jni_exc(env, table) != 0 || vcls == 0) {
        d = sysbar_delref(env, table, view);
        return 0;
    }
    let mroot: ptr = fmid(env, vcls, "getRootWindowInsets", "()Landroid/view/WindowInsets;");
    if (sysbar_jni_exc(env, table) != 0 || mroot == 0) {
        d = sysbar_delref(env, table, vcls);
        d = sysbar_delref(env, table, view);
        return 0;
    }
    d = sysbar_delref(env, table, vcls);
    let wi: ptr = fobj(env, view, mroot, noargs);
    if (sysbar_jni_exc(env, table) != 0 || wi == 0) {
        d = sysbar_delref(env, table, view);
        return 0;
    }
    d = sysbar_delref(env, table, view);
    let top: i32 = -1;
    let bot: i32 = -1;
    if (g_aui_sdk >= 30) {
        let wicls: ptr = fgc(env, wi);
        if (sysbar_jni_exc(env, table) != 0 || wicls == 0) {
            d = sysbar_delref(env, table, wi);
            return 0;
        }
        let mg: ptr = fmid(env, wicls, "getInsets", "(I)Landroid/graphics/Insets;");
        if (sysbar_jni_exc(env, table) != 0 || mg == 0) {
            d = sysbar_delref(env, table, wicls);
            d = sysbar_delref(env, table, wi);
            return 0;
        }
        d = sysbar_delref(env, table, wicls);
        let ffind: fn(ptr, ptr) : ptr = load_ptr(table + JNI_TBL_FIND_CLASS * 8);
        let tcls: ptr = ffind(env, "android/view/WindowInsets$Type");
        if (sysbar_jni_exc(env, table) != 0 || tcls == 0) {
            d = sysbar_delref(env, table, wi);
            return 0;
        }
        let fsmid: fn(ptr, ptr, ptr, ptr) : ptr = load_ptr(table + JNI_TBL_GET_STATIC_METHOD_ID * 8);
        let mst: ptr = fsmid(env, tcls, "statusBars", "()I");
        if (sysbar_jni_exc(env, table) != 0 || mst == 0) {
            d = sysbar_delref(env, table, tcls);
            d = sysbar_delref(env, table, wi);
            return 0;
        }
        let mnav: ptr = fsmid(env, tcls, "navigationBars", "()I");
        if (sysbar_jni_exc(env, table) != 0 || mnav == 0) {
            d = sysbar_delref(env, table, tcls);
            d = sysbar_delref(env, table, wi);
            return 0;
        }
        let fsint: fn(ptr, ptr, ptr, ptr) : i32 = load_ptr(table + JNI_TBL_CALL_STATIC_INT_METHOD_A * 8);
        let ty_st: i32 = fsint(env, tcls, mst, noargs);
        if (sysbar_jni_exc(env, table) != 0) {
            d = sysbar_delref(env, table, tcls);
            d = sysbar_delref(env, table, wi);
            return 0;
        }
        let ty_nav: i32 = fsint(env, tcls, mnav, noargs);
        if (sysbar_jni_exc(env, table) != 0) {
            d = sysbar_delref(env, table, tcls);
            d = sysbar_delref(env, table, wi);
            return 0;
        }
        d = sysbar_delref(env, table, tcls);
        let targs: i64[2] = 0;
        targs[0] = i64(ty_st);
        let ins_st: ptr = fobj(env, wi, mg, targs);
        if (sysbar_jni_exc(env, table) != 0 || ins_st == 0) {
            d = sysbar_delref(env, table, wi);
            return 0;
        }
        targs[0] = i64(ty_nav);
        let ins_nav: ptr = fobj(env, wi, mg, targs);
        if (sysbar_jni_exc(env, table) != 0 || ins_nav == 0) {
            d = sysbar_delref(env, table, ins_st);
            d = sysbar_delref(env, table, wi);
            return 0;
        }
        let scls: ptr = fgc(env, ins_st);
        if (sysbar_jni_exc(env, table) != 0 || scls == 0) {
            d = sysbar_delref(env, table, ins_nav);
            d = sysbar_delref(env, table, ins_st);
            d = sysbar_delref(env, table, wi);
            return 0;
        }
        let fgfid: fn(ptr, ptr, ptr, ptr) : ptr = load_ptr(table + JNI_TBL_GET_FIELD_ID * 8);
        let fid_t: ptr = fgfid(env, scls, "top", "I");
        if (sysbar_jni_exc(env, table) != 0 || fid_t == 0) {
            d = sysbar_delref(env, table, scls);
            d = sysbar_delref(env, table, ins_nav);
            d = sysbar_delref(env, table, ins_st);
            d = sysbar_delref(env, table, wi);
            return 0;
        }
        let fid_b: ptr = fgfid(env, scls, "bottom", "I");
        if (sysbar_jni_exc(env, table) != 0 || fid_b == 0) {
            d = sysbar_delref(env, table, scls);
            d = sysbar_delref(env, table, ins_nav);
            d = sysbar_delref(env, table, ins_st);
            d = sysbar_delref(env, table, wi);
            return 0;
        }
        d = sysbar_delref(env, table, scls);
        let fgi: fn(ptr, ptr, ptr) : i32 = load_ptr(table + JNI_TBL_GET_INT_FIELD * 8);
        top = fgi(env, ins_st, fid_t);
        if (sysbar_jni_exc(env, table) != 0) {
            d = sysbar_delref(env, table, ins_nav);
            d = sysbar_delref(env, table, ins_st);
            d = sysbar_delref(env, table, wi);
            return 0;
        }
        bot = fgi(env, ins_nav, fid_b);
        if (sysbar_jni_exc(env, table) != 0) {
            d = sysbar_delref(env, table, ins_nav);
            d = sysbar_delref(env, table, ins_st);
            d = sysbar_delref(env, table, wi);
            return 0;
        }
        d = sysbar_delref(env, table, ins_nav);
        d = sysbar_delref(env, table, ins_st);
        d = sysbar_delref(env, table, wi);
    } else {
        let wicls: ptr = fgc(env, wi);
        if (sysbar_jni_exc(env, table) != 0 || wicls == 0) {
            d = sysbar_delref(env, table, wi);
            return 0;
        }
        let mtop: ptr = fmid(env, wicls, "getSystemWindowInsetTop", "()I");
        if (sysbar_jni_exc(env, table) != 0 || mtop == 0) {
            d = sysbar_delref(env, table, wicls);
            d = sysbar_delref(env, table, wi);
            return 0;
        }
        let mbot: ptr = fmid(env, wicls, "getSystemWindowInsetBottom", "()I");
        if (sysbar_jni_exc(env, table) != 0 || mbot == 0) {
            d = sysbar_delref(env, table, wicls);
            d = sysbar_delref(env, table, wi);
            return 0;
        }
        d = sysbar_delref(env, table, wicls);
        let fci: fn(ptr, ptr, ptr, ptr) : i32 = load_ptr(table + JNI_TBL_CALL_INT_METHOD_A * 8);
        top = fci(env, wi, mtop, noargs);
        if (sysbar_jni_exc(env, table) != 0) {
            d = sysbar_delref(env, table, wi);
            return 0;
        }
        bot = fci(env, wi, mbot, noargs);
        if (sysbar_jni_exc(env, table) != 0) {
            d = sysbar_delref(env, table, wi);
            return 0;
        }
        d = sysbar_delref(env, table, wi);
    }
    if (top < 0) { top = 0; }
    if (bot < 0) { bot = 0; }
    if (g_aui_insets_jni_ok == 0 || top != g_aui_insets_jni_t || bot != g_aui_insets_jni_b) {
        let lg: i32 = aui_log2(4, "insets jni top=", top, " bottom=", bot, "");
        // 量到的值变了（或首次测到），布局用的安全区过期，下一次泵重算。
        g_aui_need_layout = 1;
    }
    g_aui_insets_jni_t = top;
    g_aui_insets_jni_b = bot;
    g_aui_insets_jni_ok = 1;
    return 1;
}

// 测试辅助：手动触发一次 JNI 量栏高（attach/内容区/配置钩子之外，
// 供离屏测试直接驱动）。返回 sysbar_measure_insets() 的返回值。
fn aui_debug_measure_insets() : i32 { return sysbar_measure_insets(); }

// 测试辅助：当前安全区来源（0 无/铺满 / 1 内容区 / 2 JNI 实测 /
// 3 24dp 估算）。
fn aui_debug_insets_source() : i32 { return g_aui_insets_src; }

// 测试辅助：JNI 实测的上下栏高。out = [top_px, bottom_px, top_dp,
// bottom_dp]；未测到时四项均为 -1。dp 按当前密度换算（向下取整）。
fn aui_debug_insets_px(out: ptr) : i32 {
    *(out + 0) = g_aui_insets_jni_t;
    *(out + 4) = g_aui_insets_jni_b;
    let td: i32 = -1;
    let bd: i32 = -1;
    if (g_aui_insets_jni_t >= 0) { td = px_to_dp(g_aui_insets_jni_t); }
    if (g_aui_insets_jni_b >= 0) { bd = px_to_dp(g_aui_insets_jni_b); }
    *(out + 8) = td;
    *(out + 12) = bd;
    return g_aui_insets_jni_ok;
}

fn emit_text_lines(n: ptr<AuiNode>, color: i32, center: i32, ytop: i32) : i32 {
    // v2.15：按本节点的角色置排版样式（label/button 才读 aux2）。
    let rs: i32 = text_style_for_node(n);
    let s: ptr = n.text;
    let tlen: i32 = n.aux;
    if (tlen < 0) { tlen = str_len(s); }
    // v2.16.1：换行宽度按缩放后的度量算。字号已按完整缩放重算（上面的
    // text_style_for_node），行宽 lw 是缩放后的；inner 若还用未缩放的
    // 节点宽，1.15x 下一行放得下的文字会断成两行、第二行溢出按钮底边。
    // measure 时缩放栈恒为空，paint_scale_w 恒等，不影响布局。
    let inner: i32 = n.w - n.pad * 2;
    if (g_aui_paint_sc_d != 0) { inner = paint_scale_w(inner); }
    if (inner < 0) { inner = 0; }
    // 与测量共用同一份换行结果（v1.18），宽度和断行位置完全一致。
    let mw: i32 = layout_text(s, tlen, inner);
    let lh: i32 = text_line_h();
    let gh: i32 = text_glyph_h();
    let li: i32 = 0;
    while (li < g_aui_mlines) {
        let lw: i32 = g_aui_line_w[li];
        let st: i32 = g_aui_line_start[li];
        let ln: i32 = g_aui_line_len[li];
        let ty: i32 = ytop + li * lh + (lh - gh) / 2;
        let tx: i32 = n.x + n.pad;
        if (center != 0) {
            // v2.16.1：居中用未缩放的行宽算。lw 是缩放后字号的行宽
            // （已含缩放），n.w 是未缩放的节点宽；直接混算会把文字
            // 往左推约 (sx-1)*lw/2（1.15x 下实测 53 px）。先把 lw
            // 除回布局宽再算 tx，cmd_add 的仿射映射会把 tx 连同
            // 行宽一起缩放到位，屏上正好居中。无缩放时恒等。
            let lwl: i32 = lw;
            if (g_aui_paint_sc_d != 0) {
                let scw: i32 = paint_scale_w(65536);
                if (scw > 0) { lwl = i32((i64(lw) * 65536) / i64(scw)); }
            }
            tx = n.x + (n.w - lwl) / 2;
        }
        // v1.26.1：文本命令的裁剪高度用行高而不是字高。拉丁字体的 g/y/p
        // 下伸部会超出 em 框（48 px 字高、60 px 行高），按字高裁剪会把
        // “English” 的 g 勾切掉。行高正好贴到下一行，不影响布局和居中。
        let r: i32 = cmd_add(2, tx, ty, lw, lh, color, 0, s + st, ln, text_cmd_aux());
        li = li + 1;
    }
    return 0;
}

// v2.17：表格的底部横条，比例按内容宽/视口宽算，位置按横向偏移比例；
// 只在可横向滚动时出现。纵条走 paint_scrollbar 的通用分支。
fn paint_vtable_hbar(n: ptr<AuiNode>) : i32 {
    let s: i32 = vtable_find(n.key);
    if (s < 0) { return 0; }
    let cols: i32 = n.flags;
    let cwpx: i32 = vtable_total_w(s, cols);
    let wpx: i32 = n.w >> 16;
    let mx: i32 = vtable_maxx(n.key);
    if (mx <= 0 || n.w <= 0 || cwpx <= wpx) { return 0; }
    let off: i32 = vtable_off_x(n.key);
    let bh: i32 = dp2q(3);
    let mg: i32 = dp2q(3);
    let track_x: i32 = n.x + dp2q(4);
    let track_w: i32 = n.w - dp2q(8);
    if (track_w <= bh) { return 0; }
    let bar_w: i32 = i32((i64(n.w) * i64(wpx)) / i64(cwpx));
    let min_w: i32 = dp2q(24);
    if (bar_w < min_w) { bar_w = min_w; }
    if (bar_w > track_w) { bar_w = track_w; }
    let travel: i32 = track_w - bar_w;
    let bx: i32 = track_x + i32((i64(travel) * i64(off)) / i64(mx));
    let by: i32 = n.y + n.h - bh - mg;
    let r: i32 = cmd_add(1, bx, by, bar_w, bh, i32(theme_scrollbar()), shape_radius(AUI_SHAPE_FULL, bh), g_aui_null, 0, 0);
    return 0;
}

fn paint_scrollbar(n: ptr<AuiNode>) : i32 {
    // 细滚动条：高度按视口/内容比例，位置按偏移比例；只在可滚动时出现。
    // 虚拟列表的 aux 是行数、aux2 是行高（Q16.16），内容高要单独算。
    // v1.47：横向虚拟列表画底部横条，比例按宽度算。
    // v2.17：表格的底部横条（横向偏移走独立 off_x，纵条走下面的通用分支）。
    if (n.kind == 63) {
        let hb: i32 = paint_vtable_hbar(n);
    }
    if (n.kind == 55) {
        let count: i32 = n.aux;
        let iwpx: i32 = n.aux2 >> 16;
        let gappx: i32 = n.gap >> 16;
        let cw64: i64 = i64(count) * i64(iwpx);
        let cwpx: i32 = 0;
        if (cw64 > 2000000000) { cwpx = 2000000000; } else { cwpx = i32(cw64); }
        if (count > 1) { cwpx = cwpx + (count - 1) * gappx; }
        let wpx: i32 = n.w >> 16;
        let mx: i32 = scroll_max(n.key);
        if (mx <= 0 || n.w <= 0 || cwpx <= wpx) { return 0; }
        let off: i32 = scroll_get(n.key);
        let bh: i32 = dp2q(3);
        let mg: i32 = dp2q(3);
        let track_x: i32 = n.x + dp2q(4);
        let track_w: i32 = n.w - dp2q(8);
        if (track_w <= bh) { return 0; }
        let bar_w: i32 = i32((i64(n.w) * i64(wpx)) / i64(cwpx));
        let min_w: i32 = dp2q(24);
        if (bar_w < min_w) { bar_w = min_w; }
        if (bar_w > track_w) { bar_w = track_w; }
        let travel: i32 = track_w - bar_w;
        let bx: i32 = track_x + i32((i64(travel) * i64(off)) / i64(mx));
        let by: i32 = n.y + n.h - bh - mg;
        let r: i32 = cmd_add(1, bx, by, bar_w, bh, i32(theme_scrollbar()), shape_radius(AUI_SHAPE_FULL, bh), g_aui_null, 0, 0);
        return 0;
    }
    let chpx: i32 = 0;
    if (n.kind == 51) {
        chpx = i32((i64(n.aux) * i64(n.aux2)) / 65536);
    } else if (n.kind == 58) {
        // v2.10：不定高列表的内容总高 = 行高缓存和（未量项按估计高）。
        let vs: i32 = vlist_find(n.key);
        let vep: i32 = n.aux2 >> 16;
        if (vep < 1) { vep = 1; }
        chpx = vlvar_total(vs, n.aux, vep);
    } else if (n.kind == 53) {
        let inner: i32 = n.w - n.pad * 2;
        if (inner < 0) { inner = 0; }
        let cols: i32 = vgrid_cols_for(n, inner);
        chpx = vgrid_content_px(n, cols);
    } else if (n.kind == 63) {
        // v2.17：内容高 = 表头 + 各行。
        let rhpx: i32 = n.aux2 >> 16;
        if (rhpx < 1) { rhpx = 1; }
        let c64: i64 = i64(n.aux + 1) * i64(rhpx);
        if (c64 > 2000000000) { chpx = 2000000000; } else { chpx = i32(c64); }
    } else {
        chpx = n.aux >> 16;
    }
    let hpx: i32 = n.h >> 16;
    let mx: i32 = scroll_max(n.key);
    if (mx <= 0 || n.h <= 0 || chpx <= hpx) { return 0; }
    let off: i32 = scroll_get(n.key);
    let bw: i32 = dp2q(3);
    let mg: i32 = dp2q(3);
    let track_y: i32 = n.y + dp2q(4);
    let track_h: i32 = n.h - dp2q(8);
    if (track_h <= bw) { return 0; }
    let bar_h: i32 = i32((i64(n.h) * i64(hpx)) / i64(chpx));
    let min_h: i32 = dp2q(24);
    if (bar_h < min_h) { bar_h = min_h; }
    if (bar_h > track_h) { bar_h = track_h; }
    let travel: i32 = track_h - bar_h;
    let by: i32 = track_y + i32((i64(travel) * i64(off)) / i64(mx));
    let bx: i32 = n.x + n.w - bw - mg;
    let r: i32 = cmd_add(1, bx, by, bw, bar_h, i32(theme_scrollbar()), shape_radius(AUI_SHAPE_FULL, bw), g_aui_null, 0, 0);
    return 0;
}

fn text_fit_start(s: ptr, tlen: i32, maxw: i32) : i32 {
    let st: i32 = 0;
    while (st < tlen) {
        if (text_measure(s + st, tlen - st, 0) <= maxw) { break; }
        // 按完整 UTF-8 码点前进，避免从汉字中间截断后画出 U+FFFD。
        let cp: i32 = utf8_next(s, st, tlen);
        st = st + g_aui_utf8_adv;
    }
    return st;
}

fn paint_field(n: ptr<AuiNode>) : i32 {
    let focused: i32 = 0;
    if (n.key != 0 && n.key == g_aui_focus_key) { focused = 1; }
    let pressed: i32 = 0;
    if (g_aui_pressing != 0 && g_aui_press_key == n.key) { pressed = 1; }
    let bgc: u32 = theme_surface();
    if (pressed != 0) { bgc = theme_pressed(); }
    let r0: i32 = cmd_add(1, n.x, n.y, n.w, n.h, i32(bgc), n.radius, g_aui_null, 0, 0);
    if (focused != 0) {
        let bw: i32 = dp2q(2);
        let r1: i32 = cmd_add(1, n.x + n.pad, n.y + n.h - bw - dp2q(2),
                              n.w - n.pad * 2, bw, i32(theme_primary()), 0, g_aui_null, 0, 0);
    }
    let inner: i32 = n.w - n.pad * 2;
    if (inner < 0) { inner = 0; }
    let gh: i32 = text_glyph_h();
    let ty: i32 = n.y + (n.h - gh) / 2;
    let tlen: i32 = n.aux;
    let s: ptr = n.text;
    let real: i32 = tlen;              // 真实文本长度（占位符不算）
    let color: i32 = i32(theme_text());
    if (tlen <= 0) {
        s = n.user;
        tlen = str_len(s);
        color = i32(theme_hint());
    }
    // v1.44：空文本且聚焦时，光标在首位，占位符右移一个光标位。
    let tshift: i32 = 0;
    if (real <= 0 && focused != 0) { tshift = dp2q(4); }
    let st: i32 = 0;
    if (tlen > 0) {
        let avail: i32 = inner - tshift;
        if (avail < 0) { avail = 0; }
        st = text_fit_start(s, tlen, avail);
        let tw: i32 = text_measure(s + st, tlen - st, 0);
        let tx: i32 = n.x + n.pad;
        let r2: i32 = cmd_add(2, tx + tshift, ty, tw, text_line_h(), color, 0,
                              s + st, tlen - st, text_cmd_aux());
    }
    if (focused != 0) {
        let tw2: i32 = 0;
        if (real > 0) { tw2 = text_measure(s + st, tlen - st, 0); }
        let cx: i32 = n.x + n.pad + tw2;
        let lim: i32 = n.x + n.w - n.pad - dp2q(2);
        if (cx > lim) { cx = lim; }
        let ch: i32 = text_line_h();
        let r3: i32 = cmd_add(1, cx, n.y + (n.h - ch) / 2, dp2q(2), ch,
                              i32(theme_primary()), 0, g_aui_null, 0, 0);
    }
    return 0;
}

// v1.18：键盘上的 SHIFT / DEL 改成像素图标。24 px 字体按 2 倍画成 48 px 后，
// "SHIFT" 宽 130 px、"DEL" 宽 88 px，已经超过一个键宽（720 宽窗口每键 68 px），
// 文字会压到相邻键上。图标按键高的 1/3 换算，density 变化时跟着键走。
// 两个 helper 都接收整数像素坐标，内部再转回 Q16.16 命令。
fn paint_kb_tri(cx: i32, cy: i32, w: i32, h: i32, color: i32) : i32 {
    let i: i32 = 0;
    while (i < h) {
        let rw: i32 = w * (i + 1) / h;
        if (rw < 1) { rw = 1; }
        let r: i32 = cmd_add(1, fx(cx - rw / 2), fx(cy - h / 2 + i), fx(rw), fx(1),
                             color, 0, g_aui_null, 0, 0);
        i = i + 1;
    }
    return 0;
}

fn paint_kb_del(cx: i32, cy: i32, w: i32, h: i32, color: i32, bg: i32) : i32 {
    let half: i32 = h / 2;
    let x0: i32 = cx - w / 2;
    let y0: i32 = cy - half;
    let i: i32 = 0;
    while (i < h) {
        // 左边是尖角：上下两端缩进最多，中间行从 x0 开始。
        let inset: i32 = iabs(i * 2 - (h - 1)) / 2;
        let rw: i32 = w - inset;
        if (rw > 0) {
            let r: i32 = cmd_add(1, fx(x0 + inset), fx(y0 + i), fx(rw), fx(1),
                                 color, 0, g_aui_null, 0, 0);
        }
        i = i + 1;
    }
    // 中间用按键底色挖一个 ×；按下时底色换成主色，× 自动跟随。
    let s: i32 = half - 3;
    if (s < 4) { s = 4; }
    let t: i32 = s / 5;
    if (t < 2) { t = 2; }
    let bx: i32 = x0 + (half + w) / 2;
    let k: i32 = 0;
    while (k < s) {
        let r1: i32 = cmd_add(1, fx(bx - s / 2 + k), fx(cy - s / 2 + k), fx(t), fx(t),
                              bg, 0, g_aui_null, 0, 0);
        let r2: i32 = cmd_add(1, fx(bx + s / 2 - k - t), fx(cy - s / 2 + k), fx(t), fx(t),
                              bg, 0, g_aui_null, 0, 0);
        k = k + 1;
    }
    return 0;
}

fn paint_key(n: ptr<AuiNode>) : i32 {
    let pressed: i32 = 0;
    if (g_aui_pressing != 0 && g_aui_press_key == n.key) { pressed = 1; }
    let bgc: u32 = theme_surface();
    let fgc: u32 = theme_text();
    if (pressed != 0) { bgc = theme_primary(); fgc = theme_on_primary(); }
    let r0: i32 = cmd_add(1, n.x, n.y, n.w, n.h, i32(bgc), n.radius, g_aui_null, 0, 0);
    let code: i32 = n.aux;
    let kh: i32 = fx_px(n.h);
    let ih: i32 = kh / 3;
    if (ih < 10) { ih = 10; }
    let cx: i32 = fx_px(n.x) + fx_px(n.w) / 2;
    let cy: i32 = fx_px(n.y) + kh / 2;
    if (code == 8) {
        let iw: i32 = ih * 3 / 2;
        let r2: i32 = paint_kb_del(cx, cy, iw, ih, i32(fgc), i32(bgc));
        return 0;
    }
    if (code == 16) {
        // shift 打开时图标用主色，提示接着输入的是大写。
        let ic: u32 = fgc;
        if (pressed == 0 && g_aui_kb_shift != 0) { ic = theme_primary(); }
        let tw: i32 = ih * 4 / 5;
        let th: i32 = ih * 3 / 4;
        let top: i32 = cy - ih / 2;
        let r3: i32 = paint_kb_tri(cx, top + th / 2, tw, th, i32(ic));
        let sw: i32 = tw / 3;
        if (sw < 2) { sw = 2; }
        let r4: i32 = cmd_add(1, fx(cx - sw / 2), fx(top + th - 1), fx(sw), fx(ih - th + 1),
                              i32(ic), 0, g_aui_null, 0, 0);
        return 0;
    }
    let slot: i32 = n.key - 9000;
    if (slot < 0 || slot > 120) { slot = 120; }
    let lbl: ptr = g_aui_kb_glyphs + slot;
    let tlen: i32 = 1;
    store_u8(lbl + 0, code & 255);
    store_u8(lbl + 1, 0);
    if (code == 13) { lbl = g_aui_kb_done; tlen = 4; }
    else if (code == 17) {
        if (g_aui_kb_mode == 0) { lbl = g_aui_kb_num; tlen = 3; }
        else { lbl = g_aui_kb_abc; tlen = 3; }
    }
    else if (code == 32) { lbl = g_aui_kb_space; tlen = 5; }
    else if (g_aui_kb_shift != 0 && code >= 97 && code <= 122) {
        store_u8(lbl + 0, code - 32);
    }
    let tw: i32 = text_measure(lbl, tlen, 0);
    let gh: i32 = text_glyph_h();
    let tx: i32 = n.x + (n.w - tw) / 2;
    let ty: i32 = n.y + (n.h - gh) / 2;
    let r1: i32 = cmd_add(2, tx, ty, tw, text_line_h(), i32(fgc), 0, lbl, tlen, text_cmd_aux());
    return 0;
}

// v1.17：开关。关 = 灰色轨道 + 左侧拇指；开 = 主色轨道 + 右侧拇指；
// 按下时轨道再深一档。拇指用 surface 色，在浅色/深色主题里都和轨道分开。
fn paint_switch(n: ptr<AuiNode>) : i32 {
    let pressed: i32 = 0;
    if (g_aui_pressing != 0 && g_aui_press_key == n.key) { pressed = 1; }
    let on: i32 = n.aux;
    let track: u32 = theme_scrollbar();
    if (on != 0) { track = theme_primary(); }
    if (pressed != 0) {
        if (on != 0) { track = theme_primary_dark(); }
        else { track = theme_hint(); }
    }
    let r0: i32 = cmd_add(1, n.x, n.y, n.w, n.h, i32(track), shape_radius(AUI_SHAPE_FULL, n.h),
                          g_aui_null, 0, 0);
    let inset: i32 = dp2q(3);
    let d: i32 = n.h - inset * 2;
    if (d < 0) { d = 0; }
    let tx: i32 = n.x + inset;
    if (on != 0) { tx = n.x + n.w - inset - d; }
    let thumb: u32 = theme_surface();
    let r1: i32 = cmd_add(1, tx, n.y + inset, d, d, i32(thumb),
                          d / 2, g_aui_null, 0, 0);
    return 0;
}

// v1.17：进度条。轨道用滚动条灰，填充用主色；value 是千分比。
fn paint_progress(n: ptr<AuiNode>) : i32 {
    let r0: i32 = cmd_add(1, n.x, n.y, n.w, n.h, i32(theme_scrollbar()),
                          shape_radius(AUI_SHAPE_FULL, n.h), g_aui_null, 0, 0);
    let v: i32 = n.aux;
    if (v > 0) {
        // n.w 是 Q16.16，直接乘 500 会溢出 32 位；用 64 位中间值。
        let fw: i32 = i32((i64(n.w) * i64(v)) / 1000);
        let minw: i32 = n.h;
        if (fw < minw) { fw = minw; }
        if (fw > n.w) { fw = n.w; }
        let r1: i32 = cmd_add(1, n.x, n.y, fw, n.h, i32(theme_primary()),
                              shape_radius(AUI_SHAPE_FULL, n.h), g_aui_null, 0, 0);
    }
    return 0;
}

// v1.20：对勾的两段线。Bresenham 逐点盖 t×t 的小方块，坐标是整数像素；
// 40 px 的框最多几十步，512 步上限只是保险丝。
fn paint_line(x0: i32, y0: i32, x1: i32, y1: i32, t: i32, color: i32) : i32 {
    if (t < 1) { t = 1; }
    let dx: i32 = x1 - x0;
    let dy: i32 = y1 - y0;
    let adx: i32 = iabs(dx);
    let ady: i32 = iabs(dy);
    let sx: i32 = 1;
    if (dx < 0) { sx = -1; }
    let sy: i32 = 1;
    if (dy < 0) { sy = -1; }
    let err: i32 = adx - ady;
    let x: i32 = x0;
    let y: i32 = y0;
    let n: i32 = 0;
    while (n < 512) {
        let r: i32 = cmd_add(1, fx(x - t / 2), fx(y - t / 2), fx(t), fx(t),
                             color, 0, g_aui_null, 0, 0);
        if (x == x1 && y == y1) { return 0; }
        let e2: i32 = err * 2;
        if (e2 > 0 - ady) { err = err - ady; x = x + sx; }
        if (e2 < adx) { err = err + adx; y = y + sy; }
        n = n + 1;
    }
    return 0;
}

// v1.20：复选框 / 单选框的标签：单行，控件右侧 8 dp，整行垂直居中。
fn paint_check_text(n: ptr<AuiNode>) : i32 {
    let s: ptr = n.text;
    let tlen: i32 = n.aux;
    if (tlen < 0) { tlen = str_len(s); }
    if (tlen <= 0) { return 0; }
    let tw: i32 = text_measure(s, tlen, 0);
    let lh: i32 = text_line_h();
    let gh: i32 = text_glyph_h();
    let tx: i32 = n.x + n.pad + dp2q(20) + dp2q(8);
    let ty: i32 = n.y + (n.h - lh) / 2 + (lh - gh) / 2;
    let r: i32 = cmd_add(2, tx, ty, tw, lh, d2a_fg_or(n, i32(theme_text())), 0, s, tlen, text_cmd_aux());
    return 0;
}

// v1.20：复选框。勾选 = 主色圆角方块 + 白色对勾；未选 = hint 圆角描边；
// 按下时先铺一层整行浅主色状态层（和输入框的按压底色一致）。
fn paint_check(n: ptr<AuiNode>) : i32 {
    let pressed: i32 = 0;
    if (g_aui_pressing != 0 && g_aui_press_key == n.key) { pressed = 1; }
    if (pressed != 0) {
        let r0: i32 = cmd_add(1, n.x, n.y, n.w, n.h, i32(theme_pressed()),
                              shape_q(AUI_SHAPE_SMALL), g_aui_null, 0, 0);
    }
    let box: i32 = dp2q(20);
    let bxq: i32 = n.x + n.pad;
    let byq: i32 = n.y + (n.h - box) / 2;
    let x: i32 = fx_px(bxq);
    let y: i32 = fx_px(byq);
    let sp: i32 = fx_px(box);
    let on: i32 = n.aux2;
    if (on != 0) {
        let fill: u32 = theme_primary();
        if (pressed != 0) { fill = theme_primary_dark(); }
        let r1: i32 = cmd_add(1, bxq, byq, box, box, i32(fill),
                              shape_q(AUI_SHAPE_XS), g_aui_null, 0, 0);
        let t: i32 = sp / 8;
        if (t < 2) { t = 2; }
        let ax: i32 = x + sp * 23 / 100;
        let ay: i32 = y + sp * 54 / 100;
        let mx: i32 = x + sp * 43 / 100;
        let my: i32 = y + sp * 74 / 100;
        let cx: i32 = x + sp * 79 / 100;
        let cy: i32 = y + sp * 31 / 100;
        let c1: i32 = paint_line(ax, ay, mx, my, t, i32(theme_on_primary()));
        let c2: i32 = paint_line(mx, my, cx, cy, t, i32(theme_on_primary()));
    } else {
        let bd: i32 = dp2q(2);
        if (bd < 1) { bd = 1; }
        let r2: i32 = cmd_add(1, bxq, byq, box, box,
                              i32(theme_hint()), shape_q(AUI_SHAPE_XS), g_aui_null, 0, 0);
        // 内圈用当前背景色挖空，得到 2 dp 的描边（光栅器没有 stroke 原语）。
        let iw: i32 = box - bd * 2;
        if (iw > 0) {
            let r3: i32 = cmd_add(1, bxq + bd, byq + bd, iw, iw,
                                  i32(g_aui_paint_bg), dp2q(3), g_aui_null, 0, 0);
        }
    }
    let rt: i32 = paint_check_text(n);
    return 0;
}

// v1.31：标签片。选中 = 主色胶囊 + on_primary 文字；未选 = surface 胶囊 +
// on_surface 24% 描边 + on_surface 文字。按下未选时内层换成 pressed 底色；
// 选中按下时主色加深。文字水平/垂直居中（测量时宽度已按单行留足）。
fn paint_chip(n: ptr<AuiNode>) : i32 {
    let pressed: i32 = 0;
    if (g_aui_pressing != 0 && g_aui_press_key == n.key) { pressed = 1; }
    let on: i32 = n.aux2;
    // v2.11：胶囊半径 = 高的一半（不再是固定 14 dp）；aui_radius 不改它。
    let cr: i32 = shape_radius(AUI_SHAPE_FULL, n.h);
    let fg: u32 = theme_text();
    if (on != 0) {
        let fill: u32 = theme_primary();
        if (pressed != 0) { fill = theme_primary_dark(); }
        let r0: i32 = cmd_add(1, n.x, n.y, n.w, n.h, i32(fill),
                              cr, g_aui_null, 0, 0);
        fg = theme_on_primary();
    } else {
        // 光栅器没有描边原语：先铺整块 24% 文字色的圆角底，再内缩 1 dp
        // 用 surface（按下改成 pressed 层）挖空，留下 1 dp 边框。
        let bd: i32 = dp2q(1);
        if (bd < 1) { bd = 1; }
        let r1: i32 = cmd_add(1, n.x, n.y, n.w, n.h,
                              ref_alpha(theme_text(), 61), cr,
                              g_aui_null, 0, 0);
        let inw: i32 = n.w - bd * 2;
        let inh: i32 = n.h - bd * 2;
        let ir: i32 = cr - bd;
        if (ir < 0) { ir = 0; }
        if (inw > 0 && inh > 0) {
            let bg: u32 = theme_surface();
            if (pressed != 0) { bg = theme_pressed(); }
            let r2: i32 = cmd_add(1, n.x + bd, n.y + bd, inw, inh,
                                  i32(bg), ir, g_aui_null, 0, 0);
        }
    }
    let lh: i32 = text_line_h();
    let ty: i32 = n.y + (n.h - lh) / 2;
    // D-2a：前景色覆盖只用于未选态；选中态文字色是 on_primary（状态色）。
    let fgc: i32 = i32(fg);
    if (on == 0) { fgc = d2a_fg_or(n, fgc); }
    let rt: i32 = emit_text_lines(n, fgc, 1, ty);
    return 0;
}

// v2.10：角标绘制。满圆角药丸（半径 = 高的一半）+ 居中文字；
// 圆点是直径 8 dp 的实心圆（圆角矩形、半径 = 高的一半）。
fn paint_badge(n: ptr<AuiNode>) : i32 {
    if (n.aux2 == 1 && n.gap <= 0) { return 0; }
    let r: i32 = shape_radius(AUI_SHAPE_FULL, n.h);
    let rb: i32 = cmd_add(1, n.x, n.y, n.w, n.h, i32(n.bg), r, g_aui_null, 0, 0);
    if (n.aux2 == 2) { return 0; }
    let lh: i32 = text_line_h();
    let ty: i32 = n.y + (n.h - lh) / 2;
    let rt: i32 = emit_text_lines(n, n.flags, 1, ty);
    return 0;
}

// v1.32.1：环形进度改用解析圆环（op 4）。v1.32.0 是 72 个圆点沿圆周铺，
// 相邻点的抗锯齿边缘被混合两次，轨道上出现周期性波纹（24 dp 尤其明显），
// 而且每帧要发 144 条命令。现在一条命令覆盖整圈：逐像素按“到圆心的距离”
// 求内外半径覆盖率，再按角度求圆弧两端覆盖率，一次混合。
// 轨道是 on_surface 16% 压到底色上的不透明色，指示弧是主色；弧两端各补
// 一个直径 = 描边的圆点当圆头（HuxerUI 的弧也是圆头）。
// 确定进度从 12 点起顺时针扫 value/1000 圈；不确定进度固定 28% 弧，相位
// 由当前时钟算（900 ms 一圈），应用不需要定时器。
fn paint_circle(n: ptr<AuiNode>) : i32 {
    let sz: i32 = n.w;
    let mn: i32 = dp2q(8);
    if (sz < mn) { sz = mn; }
    let stroke: i32 = sz / 8;
    let mst: i32 = dp2q(1);
    if (mst < 1) { mst = 1; }
    if (stroke < mst) { stroke = mst; }
    let r: i32 = sz / 2 - stroke / 2;
    let cx: i32 = n.x + n.w / 2;
    let cy: i32 = n.y + n.h / 2;
    // 轨道：16% 压到当前背景色上，保持不透明（与圆头的混合无关）。
    let tcol: i32 = mix_bg(i32(g_aui_paint_bg), i32(theme_text()), 41, 0, 0);
    let outer: i32 = sz / 2;
    let rin: i32 = outer - stroke;
    let d0: i32 = cmd_ring(n.x, n.y, sz, tcol, rin, 0, 65536);
    let v: i32 = n.aux;
    let start: i32 = 0;
    let span: i32 = 0;
    if (v < 0) {
        start = spin_phase_now();
        span = 65536 * 28 / 100;
    } else {
        if (v > 1000) { v = 1000; }
        // v 最大 1000，先乘 65536 会溢出 i32；用 64 位中间值。
        span = i32((i64(v) * 65536) / 1000);
    }
    if (span <= 0) { return 0; }
    let icol: i32 = i32(theme_primary());
    let d1: i32 = cmd_ring(n.x, n.y, sz, icol, rin, start, span);
    if (span < 65536) {
        // 圆头：末端的点会被 cmd_ring 的角度覆盖率裁掉一半，正好补齐。
        let c0: i32 = ref_ring_dot(cx, cy, r, start, stroke, icol);
        let c1: i32 = ref_ring_dot(cx, cy, r, start + span, stroke, icol);
    }
    return 0;
}

// v1.20：单选框。圆环 + 选中圆点（HuxerUI：border 2 dp、dot 半径 5 dp）。
// 选中时环和点都是主色；未选是 hint 色环。
fn paint_radio(n: ptr<AuiNode>) : i32 {
    let pressed: i32 = 0;
    if (g_aui_pressing != 0 && g_aui_press_key == n.key) { pressed = 1; }
    if (pressed != 0) {
        let r0: i32 = cmd_add(1, n.x, n.y, n.w, n.h, i32(theme_pressed()),
                              shape_q(AUI_SHAPE_SMALL), g_aui_null, 0, 0);
    }
    let box: i32 = dp2q(20);
    let bxq: i32 = n.x + n.pad;
    let byq: i32 = n.y + (n.h - box) / 2;
    let on: i32 = n.aux2;
    let bd: i32 = dp2q(2);
    let ring: u32 = theme_hint();
    if (on != 0) { ring = theme_primary(); }
    let r1: i32 = cmd_add(1, bxq, byq, box, box, i32(ring),
                          box / 2, g_aui_null, 0, 0);
    let iw: i32 = box - bd * 2;
    if (iw > 0) {
        let r2: i32 = cmd_add(1, bxq + bd, byq + bd, iw, iw,
                              i32(g_aui_paint_bg), iw / 2, g_aui_null, 0, 0);
    }
    if (on != 0) {
        let dot: i32 = dp2q(10);
        let dx: i32 = bxq + (box - dot) / 2;
        let dy: i32 = byq + (box - dot) / 2;
        let r3: i32 = cmd_add(1, dx, dy, dot, dot,
                              i32(theme_primary()), dot / 2, g_aui_null, 0, 0);
    }
    let rt: i32 = paint_check_text(n);
    return 0;
}

// v1.20：滑块。轨道两端各缩进拇指半径（拖到端点时拇指不出界）；左侧已选
// 部分用主色，拇指是主色圆点，拖动时从 16 dp 长到 18 dp（HuxerUI 同款）。
fn paint_slider(n: ptr<AuiNode>) : i32 {
    let dragging: i32 = 0;
    if (g_aui_slider_key != 0 && g_aui_slider_key == n.key) { dragging = 1; }
    let v: i32 = n.aux;
    if (dragging != 0) { v = g_aui_slider_val; }
    if (v < 0) { v = 0; }
    if (v > 1000) { v = 1000; }
    let inset: i32 = dp2q(9);
    let tx: i32 = n.x + inset;
    let tw: i32 = n.w - inset * 2;
    if (tw < dp2q(24)) {
        tx = n.x;
        tw = n.w;
    }
    let trk: i32 = dp2q(4);
    let ty: i32 = n.y + (n.h - trk) / 2;
    let r0: i32 = cmd_add(1, tx, ty, tw, trk, i32(theme_scrollbar()),
                          shape_radius(AUI_SHAPE_FULL, trk), g_aui_null, 0, 0);
    let cx: i32 = tx + i32((i64(tw) * i64(v)) / 1000);
    let aw: i32 = cx - tx;
    if (aw > 0) {
        let r1: i32 = cmd_add(1, tx, ty, aw, trk, i32(theme_primary()),
                              shape_radius(AUI_SHAPE_FULL, trk), g_aui_null, 0, 0);
    }
    let td: i32 = dp2q(16);
    if (dragging != 0) { td = dp2q(18); }
    let cy: i32 = n.y + n.h / 2;
    let r2: i32 = cmd_add(1, cx - td / 2, cy - td / 2, td, td,
                          i32(theme_primary()), td / 2, g_aui_null, 0, 0);
    return 0;
}

// v1.21：分段控件的底：1 dp HINT 边框 + SURFACE 内层（圆角 8 / 7 dp）。
// 光栅器没有描边，和复选框一样用“外圈色 + 内缩底色”拼。
fn paint_segmented(n: ptr<AuiNode>) : i32 {
    let bd: i32 = dp2q(1);
    let bgc: u32 = n.bg;
    if (bgc == 0) { bgc = theme_surface(); }
    let r0: i32 = cmd_add(1, n.x, n.y, n.w, n.h, i32(theme_hint()),
                          n.radius, g_aui_null, 0, 0);
    let iw: i32 = n.w - bd * 2;
    let ih: i32 = n.h - bd * 2;
    if (iw > 0 && ih > 0) {
        let r1: i32 = cmd_add(1, n.x + bd, n.y + bd, iw, ih, i32(bgc),
                              n.radius - bd, g_aui_null, 0, 0);
    }
    return 0;
}

// v1.21：一段。选中段画主色胶囊（按下时 PRIMARY_DARK），未选中但按下的
// 段画 PRESSED 胶囊；标签单行居中，选中时用 ON_PRIMARY。
fn paint_segment(n: ptr<AuiNode>) : i32 {
    if (n.parent < 0) { return 0; }
    let pn: ptr<AuiNode> = node_at(n.parent);
    let sel: i32 = 0;
    if (pn.aux == n.aux2) { sel = 1; }
    let pressed: i32 = 0;
    if (g_aui_pressing != 0 && g_aui_press_key == n.key) { pressed = 1; }
    let inset: i32 = dp2q(2);
    let iw: i32 = n.w - inset * 2;
    let ih: i32 = n.h - inset * 2;
    if (iw > 0 && ih > 0 && (sel != 0 || pressed != 0)) {
        let col: u32 = theme_pressed();
        if (sel != 0) {
            col = theme_primary();
            if (pressed != 0) { col = theme_primary_dark(); }
        }
        let r0: i32 = cmd_add(1, n.x + inset, n.y + inset, iw, ih,
                              i32(col), shape_radius(AUI_SHAPE_FULL, ih), g_aui_null, 0, 0);
    }
    let tc: u32 = theme_text();
    if (sel != 0) { tc = theme_on_primary(); }
    let by: i32 = n.y + (n.h - text_line_h()) / 2;
    // D-2a：前景色覆盖只用于未选态；选中态文字色是 on_primary（状态色）。
    let tci: i32 = i32(tc);
    if (sel == 0) { tci = d2a_fg_or(n, tci); }
    let r1: i32 = emit_text_lines(n, tci, 1, by);
    return 0;
}

// v1.22：标签页容器。默认背景透明（只在设置了 bg 时画圆角底），
// 选中页底部一条 2 dp PRIMARY 指示条（宽度 = 该页宽度，HuxerUI
// TabIndicatorSizing::Item），圆角 1 dp。
fn paint_tabs(n: ptr<AuiNode>) : i32 {
    if (n.bg != 0) {
        let r0: i32 = cmd_add(1, n.x, n.y, n.w, n.h, i32(n.bg),
                              n.radius, g_aui_null, 0, 0);
    }
    let bh: i32 = dp2q(2);
    if (n.h < bh) { return 0; }
    let by: i32 = n.y + n.h - bh;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        if (cn.aux2 == n.aux && cn.w > 0) {
            let r1: i32 = cmd_add(1, cn.x, by, cn.w, bh,
                                  i32(theme_primary()), dp2q(1),
                                  g_aui_null, 0, 0);
            return 0;
        }
        c = cn.next_sibling;
    }
    return 0;
}

// v1.22：一页的标签。选中用 PRIMARY，其余 TEXT；单行，行内左侧
// 12 dp 内边距（与测量使用同一份文本宽度，不会换行）。
fn paint_tab(n: ptr<AuiNode>) : i32 {
    if (n.parent < 0) { return 0; }
    let pn: ptr<AuiNode> = node_at(n.parent);
    let sel: i32 = 0;
    if (pn.aux == n.aux2) { sel = 1; }
    let tc: u32 = theme_text();
    if (sel != 0) { tc = theme_primary(); }
    let by: i32 = n.y + (n.h - text_line_h()) / 2;
    // D-2a：前景色覆盖只用于未选态；选中态文字色是 PRIMARY（状态色）。
    let tci: i32 = i32(tc);
    if (sel == 0) { tci = d2a_fg_or(n, tci); }
    let r0: i32 = emit_text_lines(n, tci, 0, by);
    return 0;
}

// v1.26：下拉触发器。外圈 1 dp HINT + 内层 SURFACE（按下 PRESSED），
// 左侧选中项文字，右侧 10 dp 向下小三角（3 行 2 dp 矩形拼）。
fn paint_select(n: ptr<AuiNode>) : i32 {
    let pressed: i32 = 0;
    if (g_aui_pressing != 0 && g_aui_press_key == n.key) { pressed = 1; }
    let radius: i32 = n.radius;
    if (radius <= 0) { radius = shape_q(AUI_SHAPE_SMALL); }   // v2.11：默认 10 -> 8 dp
    let bgc: u32 = theme_surface();
    if (n.bg != 0) { bgc = n.bg; }
    if (pressed != 0) { bgc = theme_pressed(); }
    let bd: i32 = dp2q(1);
    let r0: i32 = cmd_add(1, n.x, n.y, n.w, n.h, i32(theme_hint()),
                          radius, g_aui_null, 0, 0);
    let iw: i32 = n.w - bd * 2;
    let ih: i32 = n.h - bd * 2;
    if (iw > 0 && ih > 0) {
        let r1: i32 = cmd_add(1, n.x + bd, n.y + bd, iw, ih, i32(bgc),
                              radius - bd, g_aui_null, 0, 0);
    }
    // 选中项文字；越界时显示 placeholder（HINT 色）。
    let s: ptr = n.text;
    let color: i32 = i32(theme_hint());
    let oi: i32 = select_opt_at(n, n.aux);
    if (oi >= 0) {
        let on: ptr<AuiNode> = node_at(oi);
        s = on.text;
        // D-2a：下拉触发器有选中项时（占位符 HINT 色时不覆盖）。
        color = d2a_fg_or(n, i32(theme_text()));
    }
    let tlen: i32 = str_len(s);
    let gh: i32 = text_glyph_h();
    let lh: i32 = text_line_h();
    let ty: i32 = n.y + (n.h - gh) / 2;
    let tx: i32 = n.x + n.pad + dp2q(16);
    let clip_r: i32 = n.x + n.w - n.pad - dp2q(16) - dp2q(10) - dp2q(8);
    let sx: i32 = g_aui_clip_x;
    let sy: i32 = g_aui_clip_y;
    let sw: i32 = g_aui_clip_w;
    let sh: i32 = g_aui_clip_h;
    let cx0: i32 = g_aui_clip_x;
    let cy0: i32 = g_aui_clip_y;
    let cx1: i32 = g_aui_clip_x + g_aui_clip_w;
    let cy1: i32 = g_aui_clip_y + g_aui_clip_h;
    if (tx > cx0) { cx0 = tx; }
    if (ty > cy0) { cy0 = ty; }
    if (clip_r < cx1) { cx1 = clip_r; }
    // v1.26.1：裁剪底用行高，给 g/y/p 的下伸部留出空间。
    if (ty + lh < cy1) { cy1 = ty + lh; }
    if (cx1 < cx0) { cx1 = cx0; }
    if (cy1 < cy0) { cy1 = cy0; }
    g_aui_clip_x = cx0;
    g_aui_clip_y = cy0;
    g_aui_clip_w = cx1 - cx0;
    g_aui_clip_h = cy1 - cy0;
    if (tlen > 0) {
        let rt: i32 = cmd_add(2, tx, ty, text_measure(s, tlen, 0), lh,
                              color, 0, s, tlen, text_cmd_aux());
    }
    g_aui_clip_x = sx;
    g_aui_clip_y = sy;
    g_aui_clip_w = sw;
    g_aui_clip_h = sh;
    // 右侧向下三角：3 行，宽 10 / 6 / 2 dp。
    let cw: i32 = dp2q(10);
    let chh: i32 = dp2q(6);
    let cx: i32 = n.x + n.w - n.pad - dp2q(16) - cw;
    let cy: i32 = n.y + (n.h - chh) / 2;
    let row: i32 = 0;
    while (row < 3) {
        let rw: i32 = cw - row * dp2q(4);
        let rx: i32 = cx + (cw - rw) / 2;
        let ry: i32 = cy + row * dp2q(2);
        let rr: i32 = cmd_add(1, rx, ry, rw, dp2q(2), i32(theme_hint()),
                              dp2q(1), g_aui_null, 0, 0);
        row = row + 1;
    }
    return 0;
}

// v1.44：组合框触发器。边框 1 dp HINT（聚焦时 2 dp PRIMARY），内部
// SURFACE（按下 PRESSED）；文本来自按键文本池，空时画 hint 色占位符；
// 聚焦时在文字末尾画 2 dp 主色光标；右侧 10 dp 向下箭头。
fn paint_combo(n: ptr<AuiNode>) : i32 {
    let focused: i32 = 0;
    if (n.key != 0 && n.key == g_aui_focus_key) { focused = 1; }
    let pressed: i32 = 0;
    if (g_aui_pressing != 0 && g_aui_press_key == n.key) { pressed = 1; }
    let radius: i32 = n.radius;
    if (radius <= 0) { radius = shape_q(AUI_SHAPE_SMALL); }   // v2.11：默认 10 -> 8 dp
    let bgc: u32 = theme_surface();
    if (n.bg != 0) { bgc = n.bg; }
    if (pressed != 0) { bgc = theme_pressed(); }
    let bw: i32 = dp2q(1);
    let bcol: u32 = theme_hint();
    if (focused != 0) { bw = dp2q(2); bcol = theme_primary(); }
    let r0: i32 = cmd_add(1, n.x, n.y, n.w, n.h, i32(bcol),
                          radius, g_aui_null, 0, 0);
    let iw: i32 = n.w - bw * 2;
    let ih: i32 = n.h - bw * 2;
    if (iw > 0 && ih > 0) {
        let r1: i32 = cmd_add(1, n.x + bw, n.y + bw, iw, ih, i32(bgc),
                              radius - bw, g_aui_null, 0, 0);
    }
    // 文本 / 占位符。
    let tlen: i32 = combo_text_len(n);
    let s: ptr = combo_text_ptr(n);
    let real: i32 = tlen;              // 真实文本长度（占位符不算）
    let color: i32 = i32(theme_text());
    if (tlen <= 0) {
        s = n.text;
        tlen = str_len(s);
        color = i32(theme_hint());
    }
    let tx: i32 = n.x + n.pad;
    // 聚焦且没有正文时，光标停在首位；占位符右移一个光标位，避免被光标压住。
    let tshift: i32 = 0;
    if (real <= 0 && focused != 0) { tshift = dp2q(4); }
    let clip_r: i32 = n.x + n.w - n.pad - dp2q(16) - dp2q(10) - dp2q(8);
    let gh: i32 = text_glyph_h();
    let lh: i32 = text_line_h();
    let ty: i32 = n.y + (n.h - gh) / 2;
    let draw_len: i32 = tlen;
    let st: i32 = 0;
    if (tlen > 0) {
        let inner: i32 = clip_r - tx - tshift;
        if (inner < 0) { inner = 0; }
        st = text_fit_start(s, tlen, inner);
        draw_len = tlen - st;
        if (draw_len < 0) { draw_len = 0; }
        let sx: i32 = g_aui_clip_x;
        let sy: i32 = g_aui_clip_y;
        let sw: i32 = g_aui_clip_w;
        let sh: i32 = g_aui_clip_h;
        let cx0: i32 = g_aui_clip_x;
        let cy0: i32 = g_aui_clip_y;
        let cx1: i32 = g_aui_clip_x + g_aui_clip_w;
        let cy1: i32 = g_aui_clip_y + g_aui_clip_h;
        if (tx > cx0) { cx0 = tx; }
        if (ty > cy0) { cy0 = ty; }
        if (clip_r < cx1) { cx1 = clip_r; }
        if (ty + lh < cy1) { cy1 = ty + lh; }
        if (cx1 < cx0) { cx1 = cx0; }
        if (cy1 < cy0) { cy1 = cy0; }
        g_aui_clip_x = cx0;
        g_aui_clip_y = cy0;
        g_aui_clip_w = cx1 - cx0;
        g_aui_clip_h = cy1 - cy0;
        if (draw_len > 0) {
            let rt: i32 = cmd_add(2, tx + tshift, ty,
                                  text_measure(s + st, draw_len, 0),
                                  lh, color, 0, s + st, draw_len, text_cmd_aux());
        }
        g_aui_clip_x = sx;
        g_aui_clip_y = sy;
        g_aui_clip_w = sw;
        g_aui_clip_h = sh;
    }
    if (focused != 0) {
        // v1.44：光标位置只看真实文本；空文本时光标在首位，不再被占位符顶到末尾。
        let tw2: i32 = 0;
        if (real > 0) { tw2 = text_measure(s + st, tlen - st, 0); }
        let cx: i32 = tx + tw2;
        let lim: i32 = n.x + n.w - n.pad - dp2q(16) - dp2q(4);
        if (cx > lim) { cx = lim; }
        let r3: i32 = cmd_add(1, cx, n.y + (n.h - lh) / 2, dp2q(2), lh,
                              i32(theme_primary()), 0, g_aui_null, 0, 0);
    }
    // 右侧向下三角：3 行，宽 10 / 6 / 2 dp。
    let cw: i32 = dp2q(10);
    let chh: i32 = dp2q(6);
    let cx2: i32 = n.x + n.w - n.pad - dp2q(16) - cw;
    let cy2: i32 = n.y + (n.h - chh) / 2;
    let row: i32 = 0;
    while (row < 3) {
        let rw: i32 = cw - row * dp2q(4);
        let rx: i32 = cx2 + (cw - rw) / 2;
        let ry: i32 = cy2 + row * dp2q(2);
        let rr: i32 = cmd_add(1, rx, ry, rw, dp2q(2), i32(theme_hint()),
                              dp2q(1), g_aui_null, 0, 0);
        row = row + 1;
    }
    return 0;
}

// v1.26：浮层里的一项。选中项用 TINT 底 + PRIMARY 文字；按下用 PRESSED。
fn paint_option(n: ptr<AuiNode>) : i32 {
    let selected: i32 = 0;
    if (n.parent >= 0) {
        let pn: ptr<AuiNode> = node_at(n.parent);
        if (pn.aux == n.aux2) { selected = 1; }
    }
    let pressed: i32 = 0;
    if (g_aui_select_press >= 0 && g_aui_select_press == n.aux2) { pressed = 1; }
    let inset: i32 = dp2q(4);
    if (selected != 0 || pressed != 0) {
        let col: u32 = theme_tint();
        if (pressed != 0) { col = theme_pressed(); }
        let bw: i32 = n.w - inset * 2;
        let bh: i32 = n.h - inset * 2;
        if (bw > 0 && bh > 0) {
            let r0: i32 = cmd_add(1, n.x + inset, n.y + inset, bw, bh,
                                  i32(col), shape_q(AUI_SHAPE_SMALL), g_aui_null, 0, 0);
        }
    }
    let s: ptr = n.text;
    let tlen: i32 = n.aux;
    if (tlen < 0) { tlen = str_len(s); }
    let color: i32 = i32(theme_text());
    if (selected != 0) { color = i32(theme_primary()); }
    // D-2a：前景色覆盖只用于未选态；选中态文字色是 PRIMARY（状态色）。
    if (selected == 0) { color = d2a_fg_or(n, color); }
    let gh: i32 = text_glyph_h();
    let lh: i32 = text_line_h();
    let tx: i32 = n.x + dp2q(12);
    let ty: i32 = n.y + (n.h - gh) / 2;
    let sx: i32 = g_aui_clip_x;
    let sy: i32 = g_aui_clip_y;
    let sw: i32 = g_aui_clip_w;
    let sh: i32 = g_aui_clip_h;
    let cx0: i32 = g_aui_clip_x;
    let cy0: i32 = g_aui_clip_y;
    let cx1: i32 = g_aui_clip_x + g_aui_clip_w;
    let cy1: i32 = g_aui_clip_y + g_aui_clip_h;
    if (tx > cx0) { cx0 = tx; }
    if (ty > cy0) { cy0 = ty; }
    if (n.x + n.w < cx1) { cx1 = n.x + n.w; }
    // v1.26.1：同触发器，裁剪底用行高。
    if (ty + lh < cy1) { cy1 = ty + lh; }
    if (cx1 < cx0) { cx1 = cx0; }
    if (cy1 < cy0) { cy1 = cy0; }
    g_aui_clip_x = cx0;
    g_aui_clip_y = cy0;
    g_aui_clip_w = cx1 - cx0;
    g_aui_clip_h = cy1 - cy0;
    if (tlen > 0) {
        let rt: i32 = cmd_add(2, tx, ty, text_measure(s, tlen, 0), lh,
                              color, 0, s, tlen, text_cmd_aux());
    }
    g_aui_clip_x = sx;
    g_aui_clip_y = sy;
    g_aui_clip_w = sw;
    g_aui_clip_h = sh;
    return 0;
}

// v1.44：组合框浮层里的一条建议。只有按下态有底色（TINT 的 PRESSED
// 代替），文字始终正文色；不做选中高亮——组合框的“选中”就是当前文本。
fn paint_combo_suggestion(n: ptr<AuiNode>) : i32 {
    let pressed: i32 = 0;
    if (g_aui_combo_press >= 0 && g_aui_combo_press == n.aux2) { pressed = 1; }
    let inset: i32 = dp2q(4);
    if (pressed != 0) {
        let bw: i32 = n.w - inset * 2;
        let bh: i32 = n.h - inset * 2;
        if (bw > 0 && bh > 0) {
            let r0: i32 = cmd_add(1, n.x + inset, n.y + inset, bw, bh,
                                  i32(theme_pressed()), shape_q(AUI_SHAPE_SMALL), g_aui_null, 0, 0);
        }
    }
    let s: ptr = n.text;
    let tlen: i32 = n.aux;
    if (tlen < 0) { tlen = str_len(s); }
    let gh: i32 = text_glyph_h();
    let lh: i32 = text_line_h();
    let tx: i32 = n.x + dp2q(12);
    let ty: i32 = n.y + (n.h - gh) / 2;
    let sx: i32 = g_aui_clip_x;
    let sy: i32 = g_aui_clip_y;
    let sw: i32 = g_aui_clip_w;
    let sh: i32 = g_aui_clip_h;
    let cx0: i32 = g_aui_clip_x;
    let cy0: i32 = g_aui_clip_y;
    let cx1: i32 = g_aui_clip_x + g_aui_clip_w;
    let cy1: i32 = g_aui_clip_y + g_aui_clip_h;
    if (tx > cx0) { cx0 = tx; }
    if (ty > cy0) { cy0 = ty; }
    if (n.x + n.w < cx1) { cx1 = n.x + n.w; }
    if (ty + lh < cy1) { cy1 = ty + lh; }
    if (cx1 < cx0) { cx1 = cx0; }
    if (cy1 < cy0) { cy1 = cy0; }
    g_aui_clip_x = cx0;
    g_aui_clip_y = cy0;
    g_aui_clip_w = cx1 - cx0;
    g_aui_clip_h = cy1 - cy0;
    if (tlen > 0) {
        let rt: i32 = cmd_add(2, tx, ty, text_measure(s, tlen, 0), lh,
                              i32(theme_text()), 0, s, tlen, text_cmd_aux());
    }
    g_aui_clip_x = sx;
    g_aui_clip_y = sy;
    g_aui_clip_w = sw;
    g_aui_clip_h = sh;
    return 0;
}

// v1.26：浮层底板 + 选项。画在根树之后、对话框之前；对话框打开时让位。
fn paint_select_popup() : i32 {
    if (g_aui_select_open < 0) { return 0; }
    if (g_aui_select_vis <= 0) { return 0; }
    if (g_aui_dialog >= 0) { return 0; }
    let x: i32 = g_aui_select_px;
    let y: i32 = g_aui_select_py;
    let w: i32 = g_aui_select_pw;
    let h: i32 = g_aui_select_ph;
    if (w <= 0 || h <= 0) { return 0; }
    let bd: i32 = dp2q(1);
    let r0: i32 = cmd_add(1, x, y, w, h, i32(theme_hint()),
                          shape_q(AUI_SHAPE_SMALL), g_aui_null, 0, 0);
    let iw: i32 = w - bd * 2;
    let ih: i32 = h - bd * 2;
    if (iw > 0 && ih > 0) {
        let r1: i32 = cmd_add(1, x + bd, y + bd, iw, ih,
                              i32(theme_surface()), dp2q(7), g_aui_null, 0, 0);
    }
    let sx: i32 = g_aui_clip_x;
    let sy: i32 = g_aui_clip_y;
    let sw: i32 = g_aui_clip_w;
    let sh: i32 = g_aui_clip_h;
    let cx0: i32 = g_aui_clip_x;
    let cy0: i32 = g_aui_clip_y;
    let cx1: i32 = g_aui_clip_x + g_aui_clip_w;
    let cy1: i32 = g_aui_clip_y + g_aui_clip_h;
    if (x > cx0) { cx0 = x; }
    if (y > cy0) { cy0 = y; }
    if (x + w < cx1) { cx1 = x + w; }
    if (y + h < cy1) { cy1 = y + h; }
    if (cx1 < cx0) { cx1 = cx0; }
    if (cy1 < cy0) { cy1 = cy0; }
    g_aui_clip_x = cx0;
    g_aui_clip_y = cy0;
    g_aui_clip_w = cx1 - cx0;
    g_aui_clip_h = cy1 - cy0;
    let sn: ptr<AuiNode> = node_at(g_aui_select_open);
    let idx: i32 = 0;
    let c: i32 = sn.first_child;
    while (c >= 0 && idx < g_aui_select_vis) {
        let rp: i32 = paint_option(node_at(c));
        idx = idx + 1;
        let cn: ptr<AuiNode> = node_at(c);
        c = cn.next_sibling;
    }
    g_aui_clip_x = sx;
    g_aui_clip_y = sy;
    g_aui_clip_w = sw;
    g_aui_clip_h = sh;
    return 0;
}

// v1.44：组合框浮层底板 + 建议。与下拉浮层同款：1 dp HINT 边框 +
// 11 dp 圆角 SURFACE 底；画在根树之后、对话框之前，对话框打开时让位。
fn paint_combo_popup() : i32 {
    if (g_aui_combo_open < 0) { return 0; }
    if (g_aui_combo_vis <= 0) { return 0; }
    if (g_aui_dialog >= 0) { return 0; }
    let x: i32 = g_aui_combo_px;
    let y: i32 = g_aui_combo_py;
    let w: i32 = g_aui_combo_pw;
    let h: i32 = g_aui_combo_ph;
    if (w <= 0 || h <= 0) { return 0; }
    let bd: i32 = dp2q(1);
    let r0: i32 = cmd_add(1, x, y, w, h, i32(theme_hint()),
                          shape_q(AUI_SHAPE_SMALL), g_aui_null, 0, 0);
    let iw: i32 = w - bd * 2;
    let ih: i32 = h - bd * 2;
    if (iw > 0 && ih > 0) {
        let r1: i32 = cmd_add(1, x + bd, y + bd, iw, ih,
                              i32(theme_surface()), dp2q(7), g_aui_null, 0, 0);
    }
    let sx: i32 = g_aui_clip_x;
    let sy: i32 = g_aui_clip_y;
    let sw: i32 = g_aui_clip_w;
    let sh: i32 = g_aui_clip_h;
    let cx0: i32 = g_aui_clip_x;
    let cy0: i32 = g_aui_clip_y;
    let cx1: i32 = g_aui_clip_x + g_aui_clip_w;
    let cy1: i32 = g_aui_clip_y + g_aui_clip_h;
    if (x > cx0) { cx0 = x; }
    if (y > cy0) { cy0 = y; }
    if (x + w < cx1) { cx1 = x + w; }
    if (y + h < cy1) { cy1 = y + h; }
    if (cx1 < cx0) { cx1 = cx0; }
    if (cy1 < cy0) { cy1 = cy0; }
    g_aui_clip_x = cx0;
    g_aui_clip_y = cy0;
    g_aui_clip_w = cx1 - cx0;
    g_aui_clip_h = cy1 - cy0;
    let sn: ptr<AuiNode> = node_at(g_aui_combo_open);
    let idx: i32 = 0;
    let c: i32 = sn.first_child;
    while (c >= 0 && idx < g_aui_combo_vis) {
        let rp: i32 = paint_combo_suggestion(node_at(c));
        idx = idx + 1;
        let cn: ptr<AuiNode> = node_at(c);
        c = cn.next_sibling;
    }
    g_aui_clip_x = sx;
    g_aui_clip_y = sy;
    g_aui_clip_w = sw;
    g_aui_clip_h = sh;
    return 0;
}

// v1.35：粗线段（op 6），给菜单勾选标记用。端点与半宽都是 Q16.16；
// 端点之外按圆帽处理，边缘用 1 px 过渡（距离平方的线性近似），
// 不需要开方，也不会出现锯齿。
fn cmd_seg(x0: i32, y0: i32, x1: i32, y1: i32, color: i32, half: i32) : i32 {
    if (half <= 0) { return 0; }
    return cmd_add(6, x0, y0, x1, y1, color, half, g_aui_null, 0, 0);
}

// v1.36：矢量图标。坐标用“半个图形边长 = 1000”的整数单位表示，
// 换算成绝对 Q16.16 时用 i64 中间值，避免大尺寸溢出。所有笔画都是
// op 6 圆头粗线段（与菜单勾选标记同一套抗锯齿），圆用 op 4，三角形
// 用 op 5；不依赖图片资源，任何 dpi 都按几何重算。
fn icon_px(c: i32, s: i32, u: i32) : i32 {
    return c + i32((i64(s) * i64(u)) / 2000);
}

fn icon_seg(cx: i32, cy: i32, s: i32,
            x0: i32, y0: i32, x1: i32, y1: i32,
            col: i32, hw: i32) : i32 {
    return cmd_seg(icon_px(cx, s, x0), icon_px(cy, s, y0),
                   icon_px(cx, s, x1), icon_px(cy, s, y1), col, hw);
}

fn icon_dot(cx: i32, cy: i32, s: i32, u: i32, v: i32,
            col: i32, hw: i32) : i32 {
    return icon_seg(cx, cy, s, u, v, u, v, col, hw);
}

// 图形边长 s（Q16.16）；center 是按钮/图标的中心。
fn paint_glyph(icon: i32, cx: i32, cy: i32, s: i32, col: i32) : i32 {
    if (s <= 0) { return 0; }
    let hw: i32 = s / 20;                 // 半宽 = 边长 1/20（20 dp → 2 dp 描边）
    if (hw < 1) { hw = 1; }
    let hd: i32 = s / 14;                 // “更多”/滑杆圆点稍粗
    if (hd < 1) { hd = 1; }
    if (icon == AUI_ICON_PLUS) {
        let a: i32 = icon_seg(cx, cy, s, -580, 0, 580, 0, col, hw);
        let b: i32 = icon_seg(cx, cy, s, 0, -580, 0, 580, col, hw);
        return 1;
    }
    if (icon == AUI_ICON_MINUS) {
        let a: i32 = icon_seg(cx, cy, s, -580, 0, 580, 0, col, hw);
        return 1;
    }
    if (icon == AUI_ICON_CHECK) {
        let a: i32 = icon_seg(cx, cy, s, -540, 40, -140, 440, col, hw);
        let b: i32 = icon_seg(cx, cy, s, -140, 440, 580, -400, col, hw);
        return 1;
    }
    if (icon == AUI_ICON_CLOSE) {
        let a: i32 = icon_seg(cx, cy, s, -460, -460, 460, 460, col, hw);
        let b: i32 = icon_seg(cx, cy, s, 460, -460, -460, 460, col, hw);
        return 1;
    }
    if (icon == AUI_ICON_CHEVRON_LEFT) {
        let a: i32 = icon_seg(cx, cy, s, 200, -460, -240, 0, col, hw);
        let b: i32 = icon_seg(cx, cy, s, -240, 0, 200, 460, col, hw);
        return 1;
    }
    if (icon == AUI_ICON_CHEVRON_RIGHT) {
        let a: i32 = icon_seg(cx, cy, s, -200, -460, 240, 0, col, hw);
        let b: i32 = icon_seg(cx, cy, s, 240, 0, -200, 460, col, hw);
        return 1;
    }
    if (icon == AUI_ICON_CHEVRON_UP) {
        let a: i32 = icon_seg(cx, cy, s, -460, 200, 0, -240, col, hw);
        let b: i32 = icon_seg(cx, cy, s, 0, -240, 460, 200, col, hw);
        return 1;
    }
    if (icon == AUI_ICON_CHEVRON_DOWN) {
        let a: i32 = icon_seg(cx, cy, s, -460, -200, 0, 240, col, hw);
        let b: i32 = icon_seg(cx, cy, s, 0, 240, 460, -200, col, hw);
        return 1;
    }
    if (icon == AUI_ICON_ARROW_LEFT) {
        let a: i32 = icon_seg(cx, cy, s, 560, 0, -560, 0, col, hw);
        let b: i32 = icon_seg(cx, cy, s, -200, -360, -560, 0, col, hw);
        let c: i32 = icon_seg(cx, cy, s, -560, 0, -200, 360, col, hw);
        return 1;
    }
    if (icon == AUI_ICON_ARROW_RIGHT) {
        let a: i32 = icon_seg(cx, cy, s, -560, 0, 560, 0, col, hw);
        let b: i32 = icon_seg(cx, cy, s, 200, -360, 560, 0, col, hw);
        let c: i32 = icon_seg(cx, cy, s, 560, 0, 200, 360, col, hw);
        return 1;
    }
    if (icon == AUI_ICON_SEARCH) {
        let d: i32 = s * 11 / 20;
        let rin: i32 = d / 2 - s / 10;
        if (rin < 0) { rin = 0; }
        let bx: i32 = icon_px(cx, s, -260) - d / 2;
        let by: i32 = icon_px(cy, s, -260) - d / 2;
        let a: i32 = cmd_ring(bx, by, d, col, rin, 0, 65535);
        let b: i32 = icon_seg(cx, cy, s, 100, 100, 600, 600, col, hw);
        return 1;
    }
    if (icon == AUI_ICON_MORE) {
        let a: i32 = icon_dot(cx, cy, s, -420, 0, col, hd);
        let b: i32 = icon_dot(cx, cy, s, 0, 0, col, hd);
        let c: i32 = icon_dot(cx, cy, s, 420, 0, col, hd);
        return 1;
    }
    if (icon == AUI_ICON_MENU) {
        let a: i32 = icon_seg(cx, cy, s, -560, -420, 560, -420, col, hw);
        let b: i32 = icon_seg(cx, cy, s, -560, 0, 560, 0, col, hw);
        let c: i32 = icon_seg(cx, cy, s, -560, 420, 560, 420, col, hw);
        return 1;
    }
    if (icon == AUI_ICON_PLAY) {
        let bx: i32 = icon_px(cx, s, -280);
        let by: i32 = icon_px(cy, s, -360);
        let bw: i32 = i32((i64(s) * 600) / 2000);
        let bh: i32 = i32((i64(s) * 720) / 2000);
        let a: i32 = cmd_tri(bx, by, bw, bh, col, 0);
        return 1;
    }
    if (icon == AUI_ICON_PAUSE) {
        let r: i32 = s * 4 / 100;
        let rw: i32 = i32((i64(s) * 220) / 2000);
        let rh: i32 = i32((i64(s) * 720) / 2000);
        let y0: i32 = icon_px(cy, s, -360);
        let x0: i32 = icon_px(cx, s, -360);
        let x1: i32 = icon_px(cx, s, 140);
        let a: i32 = cmd_add(1, x0, y0, rw, rh, col, r, g_aui_null, 0, 0);
        let b: i32 = cmd_add(1, x1, y0, rw, rh, col, r, g_aui_null, 0, 0);
        return 1;
    }
    if (icon == AUI_ICON_STAR) {
        let hws: i32 = s / 28;
        if (hws < 1) { hws = 1; }
        let a0: i32 = icon_seg(cx, cy, s, 0, -1000, 247, -340, col, hws);
        let a1: i32 = icon_seg(cx, cy, s, 247, -340, 951, -309, col, hws);
        let a2: i32 = icon_seg(cx, cy, s, 951, -309, 399, 130, col, hws);
        let a3: i32 = icon_seg(cx, cy, s, 399, 130, 588, 809, col, hws);
        let a4: i32 = icon_seg(cx, cy, s, 588, 809, 0, 420, col, hws);
        let a5: i32 = icon_seg(cx, cy, s, 0, 420, -588, 809, col, hws);
        let a6: i32 = icon_seg(cx, cy, s, -588, 809, -399, 130, col, hws);
        let a7: i32 = icon_seg(cx, cy, s, -399, 130, -951, -309, col, hws);
        let a8: i32 = icon_seg(cx, cy, s, -951, -309, -247, -340, col, hws);
        let a9: i32 = icon_seg(cx, cy, s, -247, -340, 0, -1000, col, hws);
        return 1;
    }
    if (icon == AUI_ICON_TRASH) {
        let a: i32 = icon_seg(cx, cy, s, -560, -380, 560, -380, col, hw);
        let b: i32 = icon_seg(cx, cy, s, -180, -620, 180, -620, col, hw);
        let c: i32 = icon_seg(cx, cy, s, -440, -340, -400, 620, col, hw);
        let d: i32 = icon_seg(cx, cy, s, -400, 620, 400, 620, col, hw);
        let e: i32 = icon_seg(cx, cy, s, 400, 620, 440, -340, col, hw);
        let f: i32 = icon_seg(cx, cy, s, -160, -200, -160, 520, col, hw);
        let g: i32 = icon_seg(cx, cy, s, 160, -200, 160, 520, col, hw);
        return 1;
    }
    if (icon == AUI_ICON_EDIT) {
        let a: i32 = icon_seg(cx, cy, s, -560, 560, -440, 220, col, hw);
        let b: i32 = icon_seg(cx, cy, s, -440, 220, 300, -520, col, hw);
        let c: i32 = icon_seg(cx, cy, s, 300, -520, 520, -300, col, hw);
        let d: i32 = icon_seg(cx, cy, s, 520, -300, -240, 480, col, hw);
        let e: i32 = icon_seg(cx, cy, s, -240, 480, -560, 560, col, hw);
        return 1;
    }
    if (icon == AUI_ICON_HOME) {
        let a: i32 = icon_seg(cx, cy, s, -600, 0, 0, -580, col, hw);
        let b: i32 = icon_seg(cx, cy, s, 0, -580, 600, 0, col, hw);
        let c: i32 = icon_seg(cx, cy, s, -440, -120, -440, 560, col, hw);
        let d: i32 = icon_seg(cx, cy, s, 440, -120, 440, 560, col, hw);
        let e: i32 = icon_seg(cx, cy, s, -440, 560, 440, 560, col, hw);
        return 1;
    }
    if (icon == AUI_ICON_SETTINGS) {
        let a: i32 = icon_seg(cx, cy, s, -600, -420, 600, -420, col, hw);
        let b: i32 = icon_seg(cx, cy, s, -600, 0, 600, 0, col, hw);
        let c: i32 = icon_seg(cx, cy, s, -600, 420, 600, 420, col, hw);
        let d: i32 = icon_dot(cx, cy, s, -220, -420, col, hd);
        let e: i32 = icon_dot(cx, cy, s, 260, 0, col, hd);
        let f: i32 = icon_dot(cx, cy, s, -60, 420, col, hd);
        return 1;
    }
    if (icon == AUI_ICON_CALENDAR) {
        let a: i32 = icon_seg(cx, cy, s, -520, -420, 520, -420, col, hw);
        let b: i32 = icon_seg(cx, cy, s, 520, -420, 520, 480, col, hw);
        let c: i32 = icon_seg(cx, cy, s, 520, 480, -520, 480, col, hw);
        let d: i32 = icon_seg(cx, cy, s, -520, 480, -520, -420, col, hw);
        let e: i32 = icon_seg(cx, cy, s, -260, -620, -260, -420, col, hw);
        let f: i32 = icon_seg(cx, cy, s, 260, -620, 260, -420, col, hw);
        let g: i32 = icon_seg(cx, cy, s, -520, -100, 520, -100, col, hw);
        let h: i32 = icon_dot(cx, cy, s, -260, 140, col, hd);
        let i: i32 = icon_dot(cx, cy, s, 0, 140, col, hd);
        let j: i32 = icon_dot(cx, cy, s, 260, 140, col, hd);
        return 1;
    }
    if (icon == AUI_ICON_DOWNLOAD) {
        let a: i32 = icon_seg(cx, cy, s, 0, -620, 0, 380, col, hw);
        let b: i32 = icon_seg(cx, cy, s, -300, 80, 0, 380, col, hw);
        let c: i32 = icon_seg(cx, cy, s, 0, 380, 300, 80, col, hw);
        let d: i32 = icon_seg(cx, cy, s, -520, 620, 520, 620, col, hw);
        return 1;
    }
    // 未知图标：画一个圆点，避免完全空白。
    return icon_dot(cx, cy, s, 0, 0, col, hd);
}

fn paint_icon_button(n: ptr<AuiNode>) : i32 {
    let sz: i32 = n.aux2;
    if (sz <= 0) { sz = dp2q(40); }
    let dis: i32 = n.flags & AUI_ICONBTN_DISABLED;
    let cx: i32 = n.x + n.w / 2;
    let cy: i32 = n.y + n.h / 2;
    if (n.bg != 0) {
        let r0: i32 = cmd_add(1, n.x, n.y, n.w, n.h, i32(n.bg),
                              n.radius, g_aui_null, 0, 0);
    }
    let pressed: i32 = 0;
    if (g_aui_pressing != 0 && g_aui_press_key == n.key) { pressed = 1; }
    if (pressed != 0 && dis == 0) {
        let st: i32 = sz * 4 / 5;
        let sr: i32 = dp2q(8);         // v2.11：图标按钮按下高亮 4 -> 8 dp
        if (sr > st / 2) { sr = st / 2; }
        let r1: i32 = cmd_add(1, cx - st / 2, cy - st / 2, st, st,
                              i32(theme_pressed()), sr, g_aui_null, 0, 0);
    }
    let col: i32 = i32(theme_text());
    if (dis != 0) { col = (97 << 24) | (col & 0x00FFFFFF); }
    let gs: i32 = sz / 2;
    return paint_glyph(n.aux, cx, cy, gs, col);
}

fn paint_icon(n: ptr<AuiNode>) : i32 {
    if (n.bg != 0) {
        let r0: i32 = cmd_add(1, n.x, n.y, n.w, n.h, i32(n.bg),
                              n.radius, g_aui_null, 0, 0);
    }
    let gs: i32 = n.aux2;
    if (gs <= 0) { gs = dp2q(20); }
    let cx: i32 = n.x + n.w / 2;
    let cy: i32 = n.y + n.h / 2;
    return paint_glyph(n.aux, cx, cy, gs, i32(theme_text()));
}

// v1.41：底部导航栏表面。子项等宽，选中指示胶囊/图标/文字由
// paint_nav_item 各自绘制。
fn paint_nav_bar(n: ptr<AuiNode>) : i32 {
    let surf: u32 = theme_surface();
    if (n.bg != 0) { surf = n.bg; }
    let r0: i32 = cmd_add(1, n.x, n.y, n.w, n.h, i32(surf),
                          n.radius, g_aui_null, 0, 0);
    return 0;
}

fn paint_nav_item(n: ptr<AuiNode>) : i32 {
    if (n.parent < 0) { return 0; }
    let pn: ptr<AuiNode> = node_at(n.parent);
    if (pn.kind != 45) { return 0; }
    let idx: i32 = n.aux2;
    let sel: i32 = 0;
    if (pn.aux == idx) { sel = 1; }
    let dis: i32 = n.flags & AUI_NAV_ITEM_DISABLED;
    let hide: i32 = pn.flags & AUI_NAV_HIDE_UNSELECTED;
    let pressed: i32 = 0;
    if (g_aui_pressing != 0 && g_aui_press_key == n.key && dis == 0) {
        pressed = 1;
    }
    let block: i32 = nav_block_h();
    let top: i32 = n.y + (n.h - block) / 2;
    let iw: i32 = dp2q(56);
    let ih: i32 = dp2q(32);
    let ix: i32 = n.x + (n.w - iw) / 2;
    let iy: i32 = top;
    // 选中指示胶囊：主色 12%；按下时未选中项加深、选中项再深一点。
    if (sel != 0 || pressed != 0) {
        let alpha: i32 = 0;
        let base: i32 = 0;
        if (sel != 0) {
            alpha = 31;
            base = i32(theme_primary());
            if (pressed != 0) { alpha = 51; }
        } else {
            alpha = 20;
            base = i32(theme_text());
        }
        let col: i32 = (alpha << 24) | (base & 0x00FFFFFF);
        if (iw > 0 && ih > 0) {
            let rp: i32 = cmd_add(1, ix, iy, iw, ih, col,
                                  dp2q(16), g_aui_null, 0, 0);
        }
    }
    let ic: i32 = i32(theme_hint());
    if (sel != 0) { ic = i32(theme_primary()); }
    if (dis != 0) { ic = (97 << 24) | (i32(theme_text()) & 0x00FFFFFF); }
    let gs: i32 = dp2q(24);
    let ri: i32 = paint_glyph(n.aux, ix + iw / 2, iy + ih / 2, gs, ic);
    let show: i32 = 1;
    if (hide != 0 && sel == 0) { show = 0; }
    if (show == 0 || n.text == 0) { return 0; }
    let tlen: i32 = str_len(n.text);
    if (tlen <= 0) { return 0; }
    let tw: i32 = text_measure(n.text, tlen, 0);
    let lh: i32 = text_line_h();
    let ty: i32 = top + dp2q(32) + dp2q(4);
    let tx: i32 = n.x + (n.w - tw) / 2;
    let lc: i32 = i32(theme_hint());
    if (sel != 0) { lc = i32(theme_primary()); }
    if (dis != 0) { lc = (97 << 24) | (i32(theme_text()) & 0x00FFFFFF); }
    // 文字只画在项自己的矩形里，超长时截断，避免盖到相邻项。
    let sx: i32 = g_aui_clip_x;
    let sy: i32 = g_aui_clip_y;
    let sw: i32 = g_aui_clip_w;
    let sh: i32 = g_aui_clip_h;
    let x0: i32 = n.x;
    let y0: i32 = n.y;
    let x1: i32 = n.x + n.w;
    let y1: i32 = n.y + n.h;
    if (x0 < sx) { x0 = sx; }
    if (y0 < sy) { y0 = sy; }
    if (x1 > sx + sw) { x1 = sx + sw; }
    if (y1 > sy + sh) { y1 = sy + sh; }
    if (x1 < x0) { x1 = x0; }
    if (y1 < y0) { y1 = y0; }
    g_aui_clip_x = x0;
    g_aui_clip_y = y0;
    g_aui_clip_w = x1 - x0;
    g_aui_clip_h = y1 - y0;
    let rt: i32 = cmd_add(2, tx, ty, tw, lh, lc, 0, n.text, tlen, text_cmd_aux());
    g_aui_clip_x = sx;
    g_aui_clip_y = sy;
    g_aui_clip_w = sw;
    g_aui_clip_h = sh;
    return 0;
}

// v1.42：侧边导航栏表面。子项纵向排列，选中胶囊/图标/文字由
// paint_nav_pane_item 各自绘制。
fn paint_nav_pane(n: ptr<AuiNode>) : i32 {
    let surf: u32 = theme_surface();
    if (n.bg != 0) { surf = n.bg; }
    let r0: i32 = cmd_add(1, n.x, n.y, n.w, n.h, i32(surf),
                          n.radius, g_aui_null, 0, 0);
    return 0;
}

fn paint_nav_pane_item(n: ptr<AuiNode>) : i32 {
    if (n.parent < 0) { return 0; }
    let pn: ptr<AuiNode> = node_at(n.parent);
    if (pn.kind != 47) { return 0; }
    let idx: i32 = n.aux2;
    let sel: i32 = 0;
    if (pn.aux == idx) { sel = 1; }
    let dis: i32 = n.flags & AUI_NAV_ITEM_DISABLED;
    let expanded: i32 = pn.flags & AUI_NAV_PANE_EXPANDED;
    let pressed: i32 = 0;
    if (g_aui_pressing != 0 && g_aui_press_key == n.key && dis == 0) {
        pressed = 1;
    }
    // 指示胶囊：收缩态固定 56×32 dp，展开态铺满项宽。
    let iw: i32 = dp2q(56);
    if (expanded != 0 || iw > n.w) { iw = n.w; }
    let ih: i32 = dp2q(32);
    let ix: i32 = n.x + (n.w - iw) / 2;
    let iy: i32 = n.y + (n.h - ih) / 2;
    if (sel != 0 || pressed != 0) {
        let alpha: i32 = 0;
        let base: i32 = 0;
        if (sel != 0) {
            alpha = 31;
            base = i32(theme_primary());
            if (pressed != 0) { alpha = 51; }
        } else {
            alpha = 20;
            base = i32(theme_text());
        }
        let col: i32 = (alpha << 24) | (base & 0x00FFFFFF);
        if (iw > 0 && ih > 0) {
            let rp: i32 = cmd_add(1, ix, iy, iw, ih, col,
                                  dp2q(16), g_aui_null, 0, 0);
        }
    }
    let ic: i32 = i32(theme_hint());
    if (sel != 0) { ic = i32(theme_primary()); }
    if (dis != 0) { ic = (97 << 24) | (i32(theme_text()) & 0x00FFFFFF); }
    let gs: i32 = dp2q(24);
    let icx: i32 = n.x + n.w / 2;
    if (expanded != 0) { icx = n.x + dp2q(24); }
    let ri: i32 = paint_glyph(n.aux, icx, n.y + n.h / 2, gs, ic);
    // 收缩态只有图标；展开态在图标右侧画一行文字。
    if (expanded == 0 || n.text == 0) { return 0; }
    let tlen: i32 = str_len(n.text);
    if (tlen <= 0) { return 0; }
    let tw: i32 = text_measure(n.text, tlen, 0);
    let lh: i32 = text_line_h();
    let tx: i32 = n.x + dp2q(48);
    let ty: i32 = n.y + (n.h - lh) / 2;
    let lc: i32 = i32(theme_hint());
    if (sel != 0) { lc = i32(theme_primary()); }
    if (dis != 0) { lc = (97 << 24) | (i32(theme_text()) & 0x00FFFFFF); }
    let sx: i32 = g_aui_clip_x;
    let sy: i32 = g_aui_clip_y;
    let sw: i32 = g_aui_clip_w;
    let sh: i32 = g_aui_clip_h;
    let x0: i32 = tx;
    let y0: i32 = n.y;
    let x1: i32 = n.x + n.w - dp2q(8);
    let y1: i32 = n.y + n.h;
    if (x0 < sx) { x0 = sx; }
    if (y0 < sy) { y0 = sy; }
    if (x1 > sx + sw) { x1 = sx + sw; }
    if (y1 > sy + sh) { y1 = sy + sh; }
    if (x1 < x0) { x1 = x0; }
    if (y1 < y0) { y1 = y0; }
    g_aui_clip_x = x0;
    g_aui_clip_y = y0;
    g_aui_clip_w = x1 - x0;
    g_aui_clip_h = y1 - y0;
    let rt: i32 = cmd_add(2, tx, ty, tw, lh, lc, 0, n.text, tlen, text_cmd_aux());
    g_aui_clip_x = sx;
    g_aui_clip_y = sy;
    g_aui_clip_w = sw;
    g_aui_clip_h = sh;
    return 0;
}

// v1.37：分隔线（对照 HuxerUI Divider）。默认文字色 12% 透明度，
// aui_bg 可覆盖；线在带内边距的盒子里居中，pad 因此表现为缩进。
// v1.40：顶部应用栏（对照 HuxerUI TopAppBar）。surface 底、标题单行居中、
// 右侧动作与 leading 由子节点自行绘制；标题用两次描边模拟 bold，并裁剪到
// leading 与动作之间的可用区间。
fn paint_top_bar(n: ptr<AuiNode>) : i32 {
    let surf: u32 = theme_surface();
    if (n.bg != 0) { surf = n.bg; }
    let rb: i32 = cmd_add(1, n.x, n.y, n.w, n.h, i32(surf),
                          n.radius, g_aui_null, 0, 0);
    if ((n.flags & AUI_TB_DIVIDER) != 0) {
        let t: i32 = i32(theme_text());
        let col: i32 = (31 << 24) | (t & 0x00FFFFFF);
        let th: i32 = 65536;
        let rd: i32 = cmd_add(1, n.x, n.y + n.h - th, n.w, th, col,
                              0, g_aui_null, 0, 0);
    }
    let tlen: i32 = top_bar_title_len(n);
    if (tlen <= 0) { return 0; }
    let boff: i32 = top_bar_bold_off();
    let tw: i32 = text_measure(n.text, tlen, 0) + boff;
    let rect: i32[4] = 0;
    let rr: i32 = top_bar_title_rect(n, rect);
    let xs: i32 = rect[0];
    let xe: i32 = rect[1];
    let tx: i32 = xs;
    if (n.aux2 == AUI_TOP_BAR_CENTER) {
        tx = xs + (xe - xs - tw) / 2;
        if (tx < xs) { tx = xs; }
    }
    let lh: i32 = text_line_h();
    let gh: i32 = text_glyph_h();
    let ty: i32 = n.y + (n.h - gh) / 2;
    // 只允许标题画在自己的区间里，并继承祖先的裁剪。
    let sx: i32 = g_aui_clip_x;
    let sy: i32 = g_aui_clip_y;
    let sw: i32 = g_aui_clip_w;
    let sh: i32 = g_aui_clip_h;
    let x0: i32 = xs;
    let y0: i32 = n.y;
    let x1: i32 = xe;
    let y1: i32 = n.y + n.h;
    if (x0 < sx) { x0 = sx; }
    if (y0 < sy) { y0 = sy; }
    if (x1 > sx + sw) { x1 = sx + sw; }
    if (y1 > sy + sh) { y1 = sy + sh; }
    if (x1 < x0) { x1 = x0; }
    if (y1 < y0) { y1 = y0; }
    g_aui_clip_x = x0;
    g_aui_clip_y = y0;
    g_aui_clip_w = x1 - x0;
    g_aui_clip_h = y1 - y0;
    let col: i32 = i32(theme_text());
    let r1: i32 = cmd_add(2, tx, ty, tw, lh, col, 0, n.text, tlen, text_cmd_aux());
    let r2: i32 = cmd_add(2, tx + boff, ty, tw, lh, col, 0, n.text, tlen, text_cmd_aux());
    g_aui_clip_x = sx;
    g_aui_clip_y = sy;
    g_aui_clip_w = sw;
    g_aui_clip_h = sh;
    return 0;
}

fn paint_divider(n: ptr<AuiNode>) : i32 {
    let th: i32 = n.aux2;
    if (th <= 0) { th = dp2q(1); }
    if (th < 65536) { th = 65536; }
    let col: i32 = 0;
    if (n.bg != 0) {
        col = i32(n.bg);
    } else {
        let t: i32 = i32(theme_text());
        col = (31 << 24) | (t & 0x00FFFFFF);   // 12% 不透明度
    }
    if (n.aux == 1) {
        let lx: i32 = n.x + (n.w - th) / 2;
        let ly: i32 = n.y + n.pad;
        let lh: i32 = n.h - n.pad * 2;
        if (lh > 0) {
            let rv: i32 = cmd_add(1, lx, ly, th, lh, col, 0, g_aui_null, 0, 0);
        }
    } else {
        let ly: i32 = n.y + (n.h - th) / 2;
        let lx: i32 = n.x + n.pad;
        let lw: i32 = n.w - n.pad * 2;
        if (lw > 0) {
            let rh: i32 = cmd_add(1, lx, ly, lw, th, col, 0, g_aui_null, 0, 0);
        }
    }
    return 0;
}

fn paint_menu_item(n: ptr<AuiNode>) : i32 {
    let dis: i32 = n.flags & AUI_MENU_DISABLED;
    let idx: i32 = n.aux2;
    if (idx >= 0 && g_aui_menu_press == idx) {
        let col: u32 = 0x1F000000;
        if (g_aui_dark != 0) { col = 0x1FFFFFFF; }
        let rp: i32 = cmd_add(1, n.x, n.y, n.w, n.h, i32(col), shape_q(AUI_SHAPE_SMALL),
                              g_aui_null, 0, 0);
    }
    let col: i32 = i32(theme_text());
    let mark: i32 = col;
    if (dis != 0) {
        let a: i32 = 97;                         // 38% 不透明度
        col = (a << 24) | (col & 0x00FFFFFF);
        mark = col;
    }
    let mn: ptr<AuiNode> = node_at(g_aui_menu);
    let statew: i32 = 0;
    if ((mn.flags & AUI_MENU_CHECKED) != 0) { statew = dp2q(18) + dp2q(8); }
    let padx: i32 = dp2q(12);
    if ((n.flags & AUI_MENU_CHECKED) != 0) {
        let ccx: i32 = n.x + padx + dp2q(9);
        let ccy: i32 = n.y + n.h / 2;
        let hw: i32 = dp2q(1);
        let s1: i32 = cmd_seg(ccx - dp2q(4), ccy, ccx - dp2q(1),
                              ccy + dp2q(3), mark, hw);
        let s2: i32 = cmd_seg(ccx - dp2q(1), ccy + dp2q(3), ccx + dp2q(4),
                              ccy - dp2q(3), mark, hw);
    }
    let s: ptr = n.text;
    if (s == 0) { return 0; }
    let tlen: i32 = str_len(s);
    if (tlen <= 0) { return 0; }
    let tw: i32 = text_measure(s, tlen, 0);
    let lh: i32 = text_line_h();
    let gh: i32 = text_glyph_h();
    let tx: i32 = n.x + padx + statew;
    let ty: i32 = n.y + (n.h - lh) / 2 + (lh - gh) / 2;
    let rt: i32 = cmd_add(2, tx, ty, tw, lh, col, 0, s, tlen, text_cmd_aux());
    return 0;
}

// v1.35：菜单浮层。白底/深色主题表面、8 dp 圆角、1 dp 描边 + 轻阴影，
// 条目按下 12% 指示、勾选列、1 dp BetweenItems 分隔线。
fn paint_menu() : i32 {
    if (g_aui_menu < 0) { return 0; }
    let x: i32 = g_aui_menu_px;
    let y: i32 = g_aui_menu_py;
    let w: i32 = g_aui_menu_pw;
    let h: i32 = g_aui_menu_ph;
    if (w <= 0 || h <= 0) { return 0; }
    let sv: i32 = present_save_clip();
    present_clip_to(x, y, w, h);
    // v2.15：菜单在树外绘制，排版样式取默认（不受子树残留 cell 影响）。
    let ts: i32 = text_style_default();
    // 轻阴影：没有高斯模糊，用偏移 1/2 dp 的半透明底近似。
    let rsh: i32 = cmd_add(1, x + dp2q(1), y + dp2q(2), w, h, 0x33000000,
                           shape_q(AUI_SHAPE_SMALL), g_aui_null, 0, 0);
    let bd: i32 = dp2q(1);
    if (bd < 65536) { bd = 65536; }
    let rb: i32 = cmd_add(1, x, y, w, h, i32(theme_hint()), shape_q(AUI_SHAPE_SMALL),
                          g_aui_null, 0, 0);
    let iw: i32 = w - bd * 2;
    let ih: i32 = h - bd * 2;
    if (iw > 0 && ih > 0) {
        let rs: i32 = cmd_add(1, x + bd, y + bd, iw, ih,
                              i32(theme_surface()), dp2q(7),
                              g_aui_null, 0, 0);
    }
    let mn: ptr<AuiNode> = node_at(g_aui_menu);
    let c: i32 = mn.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        if (cn.kind == 36) {
            let sh: i32 = dp2q(1);
            if (sh < 65536) { sh = 65536; }
            let sy: i32 = cn.y + (cn.h - sh) / 2;
            let sx: i32 = cn.x + dp2q(8);
            let sw: i32 = cn.w - dp2q(16);
            if (sw > 0) {
                let rsep: i32 = cmd_add(1, sx, sy, sw, sh, 0x1F1F2328, 0,
                                        g_aui_null, 0, 0);
            }
        } else if (cn.kind == 35) {
            let ri: i32 = paint_menu_item(cn);
        }
        c = cn.next_sibling;
    }
    present_restore_clip();
    return 0;
}

// v1.27：工具提示气泡。深色反表面 94% 不透明（HuxerUI Tooltip 默认
// #1F2328 / 0.94）、4 dp 圆角、8/4 dp 内边距、白色文本左对齐；
// 文本命令的裁剪用行高（v1.26.1 的下伸部规则），并夹在气泡内。
fn paint_tooltip() : i32 {
    if (g_aui_tip_on == 0) { return 0; }
    let s: ptr = g_aui_tip_text;
    if (s == 0) { return 0; }
    let x: i32 = g_aui_tip_x;
    let y: i32 = g_aui_tip_y;
    let w: i32 = g_aui_tip_w;
    let h: i32 = g_aui_tip_h;
    if (w <= 0 || h <= 0) { return 0; }
    // v2.15：提示在树外绘制，排版样式取默认。
    let ts: i32 = text_style_default();
    let r0: i32 = cmd_add(1, x, y, w, h, 0xF01F2328,
                          shape_q(AUI_SHAPE_XS), g_aui_null, 0, 0);
    let tlen: i32 = str_len(s);
    if (tlen <= 0) { return 0; }
    let padx: i32 = dp2q(8);
    let pady: i32 = dp2q(4);
    // 换行宽度必须与 tip_layout 一致：气泡宽度是最长行 + 内边距，
    // 若这里改用 w - padx * 2 重新换行，多行文本会被挤成更多行而截断。
    let inner: i32 = g_aui_tip_tw;
    if (inner <= 0) { inner = w - padx * 2; }
    if (inner < 0) { inner = 0; }
    let mw: i32 = layout_text(s, tlen, inner);
    let lh: i32 = text_line_h();
    let gh: i32 = text_glyph_h();
    let ty0: i32 = y + pady;
    let sx: i32 = g_aui_clip_x;
    let sy: i32 = g_aui_clip_y;
    let sw: i32 = g_aui_clip_w;
    let sh: i32 = g_aui_clip_h;
    let cx0: i32 = g_aui_clip_x;
    let cy0: i32 = g_aui_clip_y;
    let cx1: i32 = g_aui_clip_x + g_aui_clip_w;
    let cy1: i32 = g_aui_clip_y + g_aui_clip_h;
    if (x > cx0) { cx0 = x; }
    if (y > cy0) { cy0 = y; }
    if (x + w < cx1) { cx1 = x + w; }
    if (y + h < cy1) { cy1 = y + h; }
    if (cx1 < cx0) { cx1 = cx0; }
    if (cy1 < cy0) { cy1 = cy0; }
    g_aui_clip_x = cx0;
    g_aui_clip_y = cy0;
    g_aui_clip_w = cx1 - cx0;
    g_aui_clip_h = cy1 - cy0;
    let li: i32 = 0;
    while (li < g_aui_mlines) {
        let lw: i32 = g_aui_line_w[li];
        let st: i32 = g_aui_line_start[li];
        let ln: i32 = g_aui_line_len[li];
        let tx: i32 = x + padx;
        let ty: i32 = ty0 + li * lh + (lh - gh) / 2;
        let rt: i32 = cmd_add(2, tx, ty, lw, lh, 0xFFFFFFFF, 0,
                              s + st, ln, text_cmd_aux());
        li = li + 1;
    }
    g_aui_clip_x = sx;
    g_aui_clip_y = sy;
    g_aui_clip_w = sw;
    g_aui_clip_h = sh;
    return 0;
}

// v1.30：下拉刷新指示器。36 dp 圆形容器 + 20 dp / 3 dp 描边圆环。
// 没有画圆弧的原语，与时间表盘手柄一样用小圆点沿圆周铺：36 个 3 dp
// 圆点（间距约 1.5 dp）视觉上连成环；拉动时按位移画定长弧，刷新时
// 按 900 ms 一圈旋转 28% 的弧。
fn ref_alpha(color: u32, a: i32) : i32 {
    if (a <= 0) { return 0; }
    if (a >= 255) { return i32(color); }
    let rgb: i32 = i32(color) & 0x00FFFFFF;
    return (a << 24) | rgb;
}

fn ref_uv(a: i32) : i32 {
    time_tab_init();
    let u: i32 = a & 65535;
    let k: i32 = (u * 12) / 65536;
    if (k < 0) { k = 0; }
    if (k > 11) { k = 11; }
    let k2: i32 = k + 1;
    if (k2 > 11) { k2 = 0; }
    let rem: i32 = u - (k * 65536) / 12;
    let f: i32 = rem * 12;
    let x0: i32 = g_aui_time_uvx[k];
    let y0: i32 = g_aui_time_uvy[k];
    let dx: i32 = g_aui_time_uvx[k2] - x0;
    let dy: i32 = g_aui_time_uvy[k2] - y0;
    let xm: i64 = i64(dx) * i64(f);
    let ym: i64 = i64(dy) * i64(f);
    *(g_aui_ref_uv + 0) = x0 + i32(xm / 65536);
    *(g_aui_ref_uv + 4) = y0 + i32(ym / 65536);
    return 0;
}

fn ref_ring_dot(cx: i32, cy: i32, r: i32, a: i32, d: i32, color: i32) : i32 {
    let t: i32 = ref_uv(a);
    // 12 个锚点之间只是线性插值，直接拿来铺点会让圆环呈 12 边形（30°
    // 一个拐点）。这里把向量归一化到 Q16.16 单位长度，72 个点就落在
    // 真圆上。ux/uy 是 Q16.16，平方和是 Q32；先除以 4 再开方，避免 i32
    // 溢出，结果乘 2 回到 Q16.16。
    let ux0: i32 = g_aui_ref_uv[0];
    let uy0: i32 = g_aui_ref_uv[1];
    let ss: i32 = i32((i64(ux0) * i64(ux0) + i64(uy0) * i64(uy0)) / 4);
    let ln: i32 = isqrt(ss) * 2;
    let ux: i32 = ux0;
    let uy: i32 = uy0;
    if (ln > 0) {
        ux = i32((i64(ux0) * 65536) / i64(ln));
        uy = i32((i64(uy0) * 65536) / i64(ln));
    }
    let x: i32 = cx + fx_mul(r, ux) - d / 2;
    let y: i32 = cy + fx_mul(r, uy) - d / 2;
    let rr: i32 = cmd_add(1, x, y, d, d, color, d / 2, g_aui_null, 0, 0);
    return 0;
}

fn paint_refresh(n: ptr<AuiNode>) : i32 {
    let disp: i32 = ref_disp(n.key);
    if (disp <= 0) { return 0; }
    let s: i32 = ref_find(n.key);
    let size: i32 = dp2q(36);
    let cx: i32 = n.x + n.w / 2;
    let cy: i32 = n.y + disp - size / 2;
    // 位移与尺寸都是 Q16.16；先降到像素再算比例，避免 i32 溢出。
    let dpx: i32 = disp / 65536;
    let spx: i32 = size / 65536;
    if (spx < 1) { spx = 1; }
    let ca: i32 = dpx * 255 / spx;
    if (ca > 255) { ca = 255; }
    let circle: i32 = cmd_add(1, cx - size / 2, cy - size / 2, size, size,
                              ref_alpha(theme_surface(), ca), size / 2,
                              g_aui_null, 0, 0);
    let rs: i32 = dp2q(20);
    let stroke: i32 = dp2q(3);
    let outer: i32 = rs / 2;
    let rin: i32 = outer - stroke;
    let rmid: i32 = outer - stroke / 2;
    // 轨道：on_surface 16% alpha 再乘显示比例，现在是单次混合，不会叠加。
    let ta: i32 = (41 * ca) / 255;
    let tcol: i32 = ref_alpha(theme_text(), ta);
    let d0: i32 = cmd_ring(cx - outer, cy - outer, rs, tcol, rin, 0, 65536);
    if (s < 0) { return 0; }
    let start: i32 = 0;
    let span: i32 = 0;
    if (ref_spinning(s) != 0) {
        start = g_aui_ref_phase[s];
        span = 65536 * 28 / 100;
    } else {
        // 触发进度 = 位移 / 68dp，同样先换成像素再乘 65536。
        let tpx: i32 = dp2q(68) / 65536;
        if (tpx < 1) { tpx = 1; }
        span = dpx * 65536 / tpx;
        if (span > 65536) { span = 65536; }
    }
    if (span <= 0) { return 0; }
    let icol: i32 = ref_alpha(theme_primary(), ca);
    let d1: i32 = cmd_ring(cx - outer, cy - outer, rs, icol, rin, start, span);
    if (span < 65536) {
        let e0: i32 = ref_ring_dot(cx, cy, rmid, start, stroke, icol);
        let e1: i32 = ref_ring_dot(cx, cy, rmid, start + span, stroke, icol);
    }
    return 0;
}

// v1.33：树行（kind 33）。缩进 = 8 + depth*20 dp；有子节点时先在 24 dp
// 指示槽里居中画 12 dp 三角（收起右指、展开下指）。行底只在选中
// （14% 主色）或按下（8% 主色）时铺圆角层，其余保持透明（TreeViewStyle
// 的 background 也是 Transparent）。文本单行左对齐，右端留 8 dp 并裁剪，
// 超长文本不会压到滚动条上。
fn paint_tree_item(n: ptr<AuiNode>) : i32 {
    let f: i32 = n.gap;
    let dep: i32 = n.aux2;
    let inset: i32 = dp2q(8) + dep * dp2q(20);
    let pressed: i32 = 0;
    if (g_aui_pressing != 0 && g_aui_press_key == n.key) { pressed = 1; }
    let dis: i32 = 0;
    if ((f & AUI_TREE_DISABLED) != 0) { dis = 1; }
    // 选中行 14% 主色底、按下 8% 主色底（HuxerUI TreeViewStyle）。
    let a: i32 = 0;
    if ((f & AUI_TREE_SELECTED) != 0) { a = 36; }
    if (pressed != 0 && (f & AUI_TREE_SELECTED) == 0) { a = 20; }
    if (a > 0 && n.w > 0 && n.h > 0) {
        let col: u32 = ref_alpha(theme_primary(), a);
        let r0: i32 = cmd_add(1, n.x, n.y, n.w, n.h, i32(col),
                              shape_q(AUI_SHAPE_SMALL), g_aui_null, 0, 0);
    }
    let fg: i32 = i32(theme_text());
    if (dis != 0) { fg = ref_alpha(theme_text(), 97); } else { fg = d2a_fg_or(n, fg); }
    let ind: i32 = dp2q(24);
    if ((f & AUI_TREE_BRANCH) != 0) {
        let tri: i32 = dp2q(12);
        let tx: i32 = n.x + inset + (ind - tri) / 2;
        let ty: i32 = n.y + (n.h - tri) / 2;
        let dir: i32 = 0;
        if ((f & AUI_TREE_EXPANDED) != 0) { dir = 1; }
        let rt: i32 = cmd_tri(tx, ty, tri, tri, fg, dir);
    }
    let s: ptr = n.text;
    let tlen: i32 = n.aux;
    if (tlen < 0) { tlen = str_len(s); }
    if (tlen <= 0) { return 0; }
    let gh: i32 = text_glyph_h();
    let lh: i32 = text_line_h();
    let tx2: i32 = n.x + inset + ind;
    let ty2: i32 = n.y + (n.h - gh) / 2;
    let svx: i32 = g_aui_clip_x;
    let svy: i32 = g_aui_clip_y;
    let svw: i32 = g_aui_clip_w;
    let svh: i32 = g_aui_clip_h;
    let x0: i32 = svx;
    let y0: i32 = svy;
    let x1: i32 = svx + svw;
    let y1: i32 = svy + svh;
    let ex: i32 = n.x + n.w - dp2q(8);
    if (tx2 > x0) { x0 = tx2; }
    if (n.y > y0) { y0 = n.y; }
    if (ex < x1) { x1 = ex; }
    if (n.y + n.h < y1) { y1 = n.y + n.h; }
    if (x1 < x0) { x1 = x0; }
    if (y1 < y0) { y1 = y0; }
    g_aui_clip_x = x0;
    g_aui_clip_y = y0;
    g_aui_clip_w = x1 - x0;
    g_aui_clip_h = y1 - y0;
    let rt2: i32 = cmd_add(2, tx2, ty2, text_measure(s, tlen, 0), lh,
                           fg, 0, s, tlen, text_cmd_aux());
    g_aui_clip_x = svx;
    g_aui_clip_y = svy;
    g_aui_clip_w = svw;
    g_aui_clip_h = svh;
    return 0;
}

// v1.34：提示层布局与绘制。Toast 在底部居中向上堆叠，SnackBar 永远占
// 最底部一条；SnackBar 可见时 Toast 从它的上沿继续往上排。两者都留
// 24 dp 底边距、16 dp 左右边距（HuxerUI viewport_padding）。
fn present_toast_measure(i: i32, maxw: i32) : i32 {
    let s: ptr = g_aui_toast_text[i];
    g_aui_toast_w[i] = 0;
    g_aui_toast_h[i] = 0;
    if (s == 0 || maxw <= 0) { return 0; }
    let tlen: i32 = str_len(s);
    if (tlen <= 0) { return 0; }
    let padx: i32 = dp2q(16);
    let pady: i32 = dp2q(12);
    let tw: i32 = text_measure(s, tlen, 0);
    let w: i32 = tw + padx * 2;
    if (w > maxw) { w = maxw; }
    if (w <= padx * 2) { return 0; }
    let inner: i32 = w - padx * 2;
    let mw: i32 = layout_text(s, tlen, inner);
    let h: i32 = g_aui_mlines * text_line_h() + pady * 2;
    g_aui_toast_w[i] = w;
    g_aui_toast_h[i] = h;
    return h;
}

fn present_snack_layout(cx: i32, cy: i32, cw: i32, ch: i32) : i32 {
    g_aui_snack_x = 0;
    g_aui_snack_y = 0;
    g_aui_snack_w = 0;
    g_aui_snack_h = 0;
    g_aui_snack_ax = 0;
    g_aui_snack_ay = 0;
    g_aui_snack_aw = 0;
    g_aui_snack_ah = 0;
    if (g_aui_snack_on == 0) { return 0; }
    let s: ptr = g_aui_snack_text;
    if (s == 0) { return 0; }
    let tlen: i32 = str_len(s);
    if (tlen <= 0) { return 0; }
    let padx: i32 = dp2q(16);
    let pady: i32 = dp2q(8);
    let spacing: i32 = dp2q(8);
    let maxw: i32 = cw - dp2q(32);
    let cap: i32 = dp2q(600);
    if (maxw > cap) { maxw = cap; }
    if (maxw <= 0) { return 0; }
    let msgw: i32 = text_measure(s, tlen, 0);
    let aw0: i32 = 0;
    let a: ptr = g_aui_snack_action;
    if (a != 0) {
        let alen: i32 = str_len(a);
        if (alen > 0) {
            aw0 = text_measure(a, alen, 0) + dp2q(24);
            if (aw0 < dp2q(48)) { aw0 = dp2q(48); }
        }
    }
    let desired: i32 = msgw + padx * 2;
    if (aw0 > 0) { desired = desired + spacing + aw0; }
    let w: i32 = desired;
    if (w > maxw) { w = maxw; }
    if (w <= padx * 2) { return 0; }
    let inner: i32 = w - padx * 2;
    let aw: i32 = 0;
    let mw: i32 = inner;
    if (aw0 > 0) {
        aw = aw0;
        let acap: i32 = inner - spacing - dp2q(24);
        if (acap < dp2q(24)) { acap = dp2q(24); }
        if (aw > acap) { aw = acap; }
        mw = inner - spacing - aw;
    }
    if (mw < 0) { mw = 0; }
    let mmw: i32 = layout_text(s, tlen, mw);
    let lh: i32 = text_line_h();
    let mh: i32 = g_aui_mlines * lh;
    let ah: i32 = lh + dp2q(16);
    if (ah < dp2q(36)) { ah = dp2q(36); }
    let content: i32 = mh;
    if (ah > content) { content = ah; }
    let h: i32 = content + pady * 2;
    if (h < dp2q(48)) { h = dp2q(48); }
    let x: i32 = cx + (cw - w) / 2;
    let y: i32 = cy + ch - dp2q(24) - h;
    g_aui_snack_x = x;
    g_aui_snack_y = y;
    g_aui_snack_w = w;
    g_aui_snack_h = h;
    if (aw > 0) {
        g_aui_snack_aw = aw;
        g_aui_snack_ah = ah;
        g_aui_snack_ax = x + w - padx - aw;
        g_aui_snack_ay = y + (h - ah) / 2;
    }
    return h;
}

fn present_layout(cx: i32, cy: i32, cw: i32, ch: i32) : i32 {
    let sh: i32 = present_snack_layout(cx, cy, cw, ch);
    let gap: i32 = dp2q(8);
    let bottom: i32 = cy + ch - dp2q(24);
    let stop: i32 = bottom;
    if (g_aui_snack_on != 0 && sh > 0) { stop = g_aui_snack_y - gap; }
    let n: i32 = 0;
    let i: i32 = 0;
    while (i < AUI_TOAST_CAP) {
        if (g_aui_toast_on[i] != 0) {
            g_aui_present_idx[n] = i;
            n = n + 1;
        } else {
            g_aui_toast_x[i] = 0;
            g_aui_toast_y[i] = 0;
            g_aui_toast_w[i] = 0;
            g_aui_toast_h[i] = 0;
        }
        i = i + 1;
    }
    // 同一时刻最多 4 条：按 id 升序，新的在底部。
    let a: i32 = 1;
    while (a < n) {
        let key: i32 = g_aui_present_idx[a];
        let kid: i32 = g_aui_toast_id[key];
        let j: i32 = a - 1;
        while (j >= 0) {
            let p: i32 = g_aui_present_idx[j];
            if (g_aui_toast_id[p] <= kid) { break; }
            g_aui_present_idx[j + 1] = p;
            j = j - 1;
        }
        g_aui_present_idx[j + 1] = key;
        a = a + 1;
    }
    let maxw: i32 = cw - dp2q(32);
    let cap: i32 = dp2q(480);
    if (maxw > cap) { maxw = cap; }
    let k: i32 = n - 1;
    while (k >= 0) {
        let ti: i32 = g_aui_present_idx[k];
        let th: i32 = present_toast_measure(ti, maxw);
        if (th > 0) {
            let tw: i32 = g_aui_toast_w[ti];
            g_aui_toast_x[ti] = cx + (cw - tw) / 2;
            g_aui_toast_y[ti] = stop - th;
            stop = g_aui_toast_y[ti] - gap;
        }
        k = k - 1;
    }
    return 0;
}

fn present_text_block(s: ptr, tlen: i32, x: i32, y: i32, w: i32,
                      color: i32, center: i32) : i32 {
    if (s == 0 || tlen <= 0) { return 0; }
    // v2.15：Toast/SnackBar 文本在树外绘制，排版样式取默认。
    let ts: i32 = text_style_default();
    let inner: i32 = w;
    if (inner < 0) { inner = 0; }
    let mw: i32 = layout_text(s, tlen, inner);
    let lh: i32 = text_line_h();
    let gh: i32 = text_glyph_h();
    let li: i32 = 0;
    while (li < g_aui_mlines) {
        let lw: i32 = g_aui_line_w[li];
        let st: i32 = g_aui_line_start[li];
        let ln: i32 = g_aui_line_len[li];
        let tx: i32 = x;
        if (center != 0) { tx = x + (w - lw) / 2; }
        let ty: i32 = y + li * lh + (lh - gh) / 2;
        let r: i32 = cmd_add(2, tx, ty, lw, lh, color, 0, s + st, ln, text_cmd_aux());
        li = li + 1;
    }
    return 0;
}

fn present_save_clip() : i32 {
    g_aui_present_clip[0] = g_aui_clip_x;
    g_aui_present_clip[1] = g_aui_clip_y;
    g_aui_present_clip[2] = g_aui_clip_w;
    g_aui_present_clip[3] = g_aui_clip_h;
    return 0;
}

fn present_restore_clip() : i32 {
    g_aui_clip_x = g_aui_present_clip[0];
    g_aui_clip_y = g_aui_present_clip[1];
    g_aui_clip_w = g_aui_present_clip[2];
    g_aui_clip_h = g_aui_present_clip[3];
    return 0;
}

fn present_clip_to(x: i32, y: i32, w: i32, h: i32) : i32 {
    let x0: i32 = g_aui_clip_x;
    let y0: i32 = g_aui_clip_y;
    let x1: i32 = g_aui_clip_x + g_aui_clip_w;
    let y1: i32 = g_aui_clip_y + g_aui_clip_h;
    let ex: i32 = x + w;
    let ey: i32 = y + h;
    if (x > x0) { x0 = x; }
    if (y > y0) { y0 = y; }
    if (ex < x1) { x1 = ex; }
    if (ey < y1) { y1 = ey; }
    if (x1 < x0) { x1 = x0; }
    if (y1 < y0) { y1 = y0; }
    g_aui_clip_x = x0;
    g_aui_clip_y = y0;
    g_aui_clip_w = x1 - x0;
    g_aui_clip_h = y1 - y0;
    return 0;
}

fn paint_snackbar() : i32 {
    if (g_aui_snack_on == 0) { return 0; }
    let x: i32 = g_aui_snack_x;
    let y: i32 = g_aui_snack_y;
    let w: i32 = g_aui_snack_w;
    let h: i32 = g_aui_snack_h;
    if (w <= 0 || h <= 0) { return 0; }
    let sv: i32 = present_save_clip();
    present_clip_to(x, y, w, h);
    // v2.15：SnackBar 在树外绘制，排版样式取默认。
    let ts: i32 = text_style_default();
    let r0: i32 = cmd_add(1, x, y, w, h, 0xFF1F2328, shape_q(AUI_SHAPE_SMALL),
                          g_aui_null, 0, 0);
    let padx: i32 = dp2q(16);
    let pady: i32 = dp2q(8);
    let spacing: i32 = dp2q(8);
    let aw: i32 = g_aui_snack_aw;
    let ax: i32 = g_aui_snack_ax;
    let ay: i32 = g_aui_snack_ay;
    let ah: i32 = g_aui_snack_ah;
    if (aw > 0 && ah > 0) {
        if (g_aui_snack_press != 0) {
            let rp: i32 = cmd_add(1, ax, ay, aw, ah, 0x2BFFFFFF,
                                  shape_q(AUI_SHAPE_SMALL), g_aui_null, 0, 0);
        }
        let a: ptr = g_aui_snack_action;
        if (a != 0) {
            let alen: i32 = str_len(a);
            let atw: i32 = text_measure(a, alen, 0);
            let lh: i32 = text_line_h();
            let gh: i32 = text_glyph_h();
            let atx: i32 = ax + (aw - atw) / 2;
            let aty: i32 = ay + (ah - gh) / 2;
            let ra: i32 = cmd_add(2, atx, aty, atw, lh, 0xFF79C0FF,
                                  0, a, alen, text_cmd_aux());
        }
    }
    let mw: i32 = w - padx * 2;
    if (aw > 0) { mw = mw - spacing - aw; }
    if (mw < 0) { mw = 0; }
    let s: ptr = g_aui_snack_text;
    if (s != 0) {
        let tlen: i32 = str_len(s);
        let mmw: i32 = layout_text(s, tlen, mw);
        let lines: i32 = g_aui_mlines;
        let lh2: i32 = text_line_h();
        let mh2: i32 = lines * lh2;
        let ty: i32 = y + (h - mh2) / 2;
        let rt: i32 = present_text_block(s, tlen, x + padx, ty, mw,
                                         0xFFFFFFFF, 0);
    }
    present_restore_clip();
    return 0;
}

fn paint_toast(i: i32) : i32 {
    if (g_aui_toast_on[i] == 0) { return 0; }
    let x: i32 = g_aui_toast_x[i];
    let y: i32 = g_aui_toast_y[i];
    let w: i32 = g_aui_toast_w[i];
    let h: i32 = g_aui_toast_h[i];
    if (w <= 0 || h <= 0) { return 0; }
    let sv: i32 = present_save_clip();
    present_clip_to(x, y, w, h);
    // v2.11：Toast 是胶囊（半径 = 高的一半），不再是固定 8 dp。
    let r0: i32 = cmd_add(1, x, y, w, h, 0xF01F2328, shape_radius(AUI_SHAPE_FULL, h),
                          g_aui_null, 0, 0);
    let s: ptr = g_aui_toast_text[i];
    if (s != 0) {
        let tlen: i32 = str_len(s);
        let padx: i32 = dp2q(16);
        let pady: i32 = dp2q(12);
        let rt: i32 = present_text_block(s, tlen, x + padx, y + pady,
                                         w - padx * 2, 0xFFFFFFFF, 0);
    }
    present_restore_clip();
    return 0;
}

// ===========================================================================
// DEBUG overlay（v2.8；对照 HuxerUI AppOptions.show_debug_overlay /
// DebugOverlayInstaller::Install / DebugOverlayLayout / DebugRibbon /
// DebugPanel，机制逐项照搬，见 REPORT-v28.md）。
// 框架级内置：应用根节点之上的顶层 System 级图层——全屏、忽略 SafeArea、
// 点按穿透（仅缎带/面板接管点按）。开关语义：APK（真机窗口创建时）
// 默认开；headless 默认关（不污染任何 harness 基线）；API 双向覆盖。
// 指标只放框架真实测量的值：FPS / 帧光栅 ms / 直搬占比 / 命令数 /
// 视口。HuxerUI 的 CPU/MEMORY 两卡框架测不到（Aster 内无进程统计
// 接口），不编数字，直接省掉。
// 阴影：框架光栅器没有阴影原语，缎带/面板的阴影本轮不画（见报告）。
// ===========================================================================
let g_dbg_on: i32 = 0;            // 1 = overlay 显示
let g_dbg_explicit: i32 = 0;      // 1 = 应用/API 显式设置过开关
let g_dbg_expanded: i32 = 0;      // 1 = 指标面板展开
let g_dbg_down: i32 = 0;          // 1 = 本次按下落在缎带上（待抬起切换）
let g_dbg_moved: i32 = 0;         // 1 = 缎带按下后移出 8 dp（本次不切换）
let g_dbg_panel_down: i32 = 0;    // 1 = 本次按下落在面板上（面板独占）
let g_dbg_dx: i32 = 0;            // 按下点（像素）
let g_dbg_dy: i32 = 0;
// 指标采样（只在真机 present_now 里记；headless 不走，面板显示 Idle/--）。
let g_dbg_win_start: i64 = 0;     // 当前采样窗起点（ms）
let g_dbg_win_frames: i32 = 0;    // 窗内已呈现帧数
let g_dbg_win_blit: i32 = 0;      // 窗内直搬帧数
let g_dbg_total_frames: i32 = 0;  // 累计已呈现帧数（0 = 从未有帧）
let g_dbg_frame_last: i32 = 0;    // 上一帧光栅 ms
let g_dbg_frame_max: i32 = 0;     // 当前窗内最大光栅 ms
let g_dbg_frame_max_last: i32 = 0;// 上一完整窗的最大光栅 ms
let g_dbg_fps: i32 = 0;           // 上一完整窗的 fps
let g_dbg_blit_pct: i32 = 0;      // 上一完整窗的直搬占比
let g_dbg_cmds_last: i32 = 0;     // 上一帧命令数
// 面板数字格式化：不用共享 g_aui_num_buf（paint 期调用、build 不重置），
// 用 overlay 自己的缓冲；值变时采样器置 force_full 保像素正确。
let g_dbg_buf_fps: u8[16] = 0;
let g_dbg_buf_frame: u8[16] = 0;
let g_dbg_buf_frame_d: u8[24] = 0;
let g_dbg_buf_blit: u8[16] = 0;
let g_dbg_buf_cmds: u8[16] = 0;
let g_dbg_buf_vp: u8[40] = 0;

fn dbg_dp(n: i32) : i32 { return fx_px(dp2q(n)); }

// 缎带几何（dp，与 HuxerUI DebugOverlayLayout 一致）：104×16 dp，
// 中心在 (W-30, 30)，即右上角角点内收 30 dp。out = [cx, cy, w, h] 像素。
fn dbg_ribbon_geo(out: ptr) : i32 {
    if (g_aui_sw <= 0 || g_aui_sh <= 0) { return -1; }
    let wpx: i32 = fx_px(g_aui_sw);
    *(out + 0) = wpx - dbg_dp(30);
    *(out + 4) = dbg_dp(30);
    *(out + 8) = dbg_dp(104);
    *(out + 12) = dbg_dp(16);
    return 0;
}

// 面板高（dp）：12 pad + 18 头 + 8 + 64 卡 + 8 + 64 卡 + 8 + 14 脚 + 12 pad。
fn dbg_panel_h_dp() : i32 { return 208; }

// 面板几何：288 dp 宽，右下角 16 dp 边距。收起返回 -1。
// out = [x, y, w, h] 像素。
fn dbg_panel_geo(out: ptr) : i32 {
    if (g_dbg_expanded == 0) { return -1; }
    if (g_aui_sw <= 0 || g_aui_sh <= 0) { return -1; }
    let wpx: i32 = fx_px(g_aui_sw);
    let hpx: i32 = fx_px(g_aui_sh);
    let pw: i32 = dbg_dp(288);
    let ph: i32 = dbg_dp(dbg_panel_h_dp());
    let px: i32 = wpx - dbg_dp(16) - pw;
    let py: i32 = hpx - dbg_dp(16) - ph;
    if (px < 0) { px = 0; }
    if (py < 0) { py = 0; }
    *(out + 0) = px;
    *(out + 4) = py;
    *(out + 8) = pw;
    *(out + 12) = ph;
    return 0;
}

// 点 (px, py) 是否落在旋转后的缎带矩形内：逆旋转回未旋转坐标再测。
fn dbg_ribbon_hit(px: i32, py: i32) : i32 {
    if (g_dbg_on == 0) { return 0; }
    let g: i32[4] = 0;
    if (dbg_ribbon_geo(g) != 0) { return 0; }
    let cs: i32[2] = 0;
    let r0: i32 = rot_sin_cos(45, cs);
    let co: i32 = cs[0];
    let si: i32 = cs[1];
    let dx: i32 = px - g[0];
    let dy: i32 = py - g[1];
    let rx: i32 = i32((i64(co) * i64(dx) + i64(si) * i64(dy)) / 65536);
    let ry: i32 = i32((i64(0 - si) * i64(dx) + i64(co) * i64(dy)) / 65536);
    let hw: i32 = g[2] / 2;
    let hh: i32 = g[3] / 2;
    if (rx < 0 - hw || rx > hw) { return 0; }
    if (ry < 0 - hh || ry > hh) { return 0; }
    return 1;
}

// 点 (px, py) 是否落在展开的面板内。
fn dbg_panel_hit(px: i32, py: i32) : i32 {
    if (g_dbg_on == 0) { return 0; }
    let g: i32[4] = 0;
    if (dbg_panel_geo(g) != 0) { return 0; }
    if (px < g[0] || px >= g[0] + g[2]) { return 0; }
    if (py < g[1] || py >= g[1] + g[3]) { return 0; }
    return 1;
}

// 十进制写进 buf（NUL 终结），返回长度（不含 NUL）。
fn dbg_fmt_i32_at(v: i32, buf: ptr, off: i32) : i32 {
    let neg: i32 = 0;
    let n: i32 = v;
    if (n < 0) { neg = 1; n = 0 - n; }
    let tmp: u8[12] = 0;
    let i: i32 = 0;
    if (n == 0) {
        let w0: i32 = store_u8(tmp + 0, 48);
        i = 1;
    } else {
        while (n > 0) {
            let d: i32 = n - (n / 10) * 10;
            let w1: i32 = store_u8(tmp + i, 48 + d);
            i = i + 1;
            n = n / 10;
        }
    }
    let nlen: i32 = i + neg;
    let k: i32 = 0;
    while (k < i) {
        let w2: i32 = store_u8(buf + off + neg + k, load_u8(tmp + i - 1 - k));
        k = k + 1;
    }
    if (neg != 0) {
        let w3: i32 = store_u8(buf + off + 0, 45);
    }
    let w4: i32 = store_u8(buf + off + nlen, 0);
    return off + nlen;
}

fn dbg_fmt_i32(v: i32, buf: ptr) : i32 {
    return dbg_fmt_i32_at(v, buf, 0);
}

// 把 src 的前 slen 字节追加到 dst+off，返回新偏移（不写 NUL）。
fn dbg_cat(dst: ptr, off: i32, src: ptr, slen: i32) : i32 {
    let k: i32 = 0;
    while (k < slen) {
        let w: i32 = store_u8(dst + off + k, load_u8(src + k));
        k = k + 1;
    }
    return off + slen;
}

// 行宽（像素）：s 的总 advance 按 size_px / 48 缩放。不光栅化。
fn dbg_text_w(s: ptr, tlen: i32, size_px: i32) : i32 {
    if (s == 0 || tlen <= 0 || size_px <= 0) { return 0; }
    // v2.16.1：按固定 48 em 算 advance。aui_rt_advance 按当前 cell 等比
    // 缩放，而当前 cell 是树绘制残留的 ambient 状态（最后一个画的节点
    // 的角色，Body 48 / Title 64 不定），缎带/panel 的文字宽会随帧变，
    // 命令字节每帧不同、动画损伤比较永远命中旋转命令而回落整屏。
    // 固定 48 后宽度只取决于文本与尺寸，与绘制顺序无关。
    let saved: i32 = aui_rt_pixel();
    let sc0: i32 = aui_rt_set_cell(48);
    let tot48: i32 = 0;
    let i: i32 = 0;
    while (i < tlen) {
        let cp: i32 = utf8_next(s, i, tlen);
        let advb: i32 = g_aui_utf8_adv;
        tot48 = tot48 + aui_rt_advance(cp);
        i = i + advb;
    }
    let sc1: i32 = aui_rt_set_cell(saved);
    return tot48 * size_px / 48;
}

// 按左上角 (x_q, y_q)（Q16.16 px）放一行定尺寸文字（angle=0 为水平）。
fn dbg_emit_text_at(x_q: i32, y_q: i32, s: ptr, tlen: i32, color: i32,
                    size_px: i32, angle: i32) : i32 {
    if (s == 0 || tlen <= 0) { return 0; }
    let w: i32 = dbg_text_w(s, tlen, size_px);
    if (w <= 0) { return 0; }
    let cx: i32 = x_q + fx(w) / 2;
    let cy: i32 = y_q + fx(size_px) / 2;
    return cmd_add(10, cx, cy, fx(w), fx(size_px), color, angle, s, tlen, 0);
}

// 开关 API：on != 0 开，== 0 关。关掉时面板一并收起。显式设置后
// 真机窗口重建也不改回默认值。返回当前开关状态。
fn aui_debug_overlay(on: i32) : i32 {
    g_dbg_explicit = 1;
    if (on != 0) { g_dbg_on = 1; } else { g_dbg_on = 0; }
    if (on == 0) { g_dbg_expanded = 0; }
    let r: i32 = aui_invalidate();
    return g_dbg_on;
}

fn aui_debug_overlay_on() : i32 { return g_dbg_on; }

// 仅测试：out[0]=on，[1]=expanded，[2..5]=缎带 cx,cy,w,h（像素），
// [6..9]=面板 x,y,w,h（收起为 -1），[10]=fps 快照，[11]=上一帧光栅 ms。
fn aui_debug_overlay_state(out: ptr) : i32 {
    *(out + 0) = g_dbg_on;
    *(out + 4) = g_dbg_expanded;
    let g: i32[4] = 0;
    if (dbg_ribbon_geo(g) == 0) {
        *(out + 8) = g[0];
        *(out + 12) = g[1];
        *(out + 16) = g[2];
        *(out + 20) = g[3];
    } else {
        *(out + 8) = -1;
        *(out + 12) = -1;
        *(out + 16) = -1;
        *(out + 20) = -1;
    }
    if (dbg_panel_geo(g) == 0) {
        *(out + 24) = g[0];
        *(out + 28) = g[1];
        *(out + 32) = g[2];
        *(out + 36) = g[3];
    } else {
        *(out + 24) = -1;
        *(out + 28) = -1;
        *(out + 32) = -1;
        *(out + 36) = -1;
    }
    *(out + 40) = g_dbg_fps;
    *(out + 44) = g_dbg_frame_last;
    return 0;
}

// FPS 是否显示 Idle：从未有帧，或当前窗空闲超过 1.5 s。
fn dbg_fps_idle() : i32 {
    if (g_dbg_total_frames == 0) { return 1; }
    if (g_dbg_win_frames == 0) {
        let now: i64 = aui_log_now_ms();
        if (now - g_dbg_win_start > 1500) { return 1; }
    }
    return 0;
}

// 每呈现一帧记一次（present_now 调用）。1 s 窗口关闭时快照 fps /
// 直搬占比 / 窗内最大帧耗时；值变了就强制整帧重画一次并约 1 Hz 刷新
// 面板（面板数字变了但命令指针不变时，直搬会把旧数字留在面板区）。
fn dbg_sample_frame(cost_ms: i32, blit: i32) : i32 {
    let now: i64 = aui_log_now_ms();
    if (g_dbg_win_start == 0) { g_dbg_win_start = now; }
    g_dbg_total_frames = g_dbg_total_frames + 1;
    g_dbg_win_frames = g_dbg_win_frames + 1;
    if (blit != 0) { g_dbg_win_blit = g_dbg_win_blit + 1; }
    g_dbg_frame_last = cost_ms;
    if (cost_ms > g_dbg_frame_max) { g_dbg_frame_max = cost_ms; }
    g_dbg_cmds_last = g_aui_cmd_count;
    let el: i64 = now - g_dbg_win_start;
    if (el >= 1000) {
        let f: i32 = 0;
        if (el > 0) { f = i32(i64(g_dbg_win_frames) * 1000 / el); }
        let bp: i32 = 0;
        if (g_dbg_win_frames > 0) { bp = g_dbg_win_blit * 100 / g_dbg_win_frames; }
        let changed: i32 = 0;
        if (f != g_dbg_fps || bp != g_dbg_blit_pct ||
            g_dbg_frame_max != g_dbg_frame_max_last) { changed = 1; }
        g_dbg_fps = f;
        g_dbg_blit_pct = bp;
        g_dbg_frame_max_last = g_dbg_frame_max;
        if (changed != 0) {
            g_aui_force_full = 1;
            g_aui_need_paint = 1;
            g_aui_pump_need = 1;
        }
        g_dbg_win_start = now;
        g_dbg_win_frames = 0;
        g_dbg_win_blit = 0;
        g_dbg_frame_max = 0;
    }
    return 0;
}

// 缎带：104×16 dp 红底 + 白字 DEBUG（11 dp），绕中心 +45°。
fn dbg_paint_ribbon() : i32 {
    let g: i32[4] = 0;
    if (dbg_ribbon_geo(g) != 0) { return 0; }
    let cx: i32 = fx(g[0]);
    let cy: i32 = fx(g[1]);
    let w: i32 = fx(g[2]);
    let h: i32 = fx(g[3]);
    let r0: i32 = cmd_add(9, cx, cy, w, h, 0xFF9B2634, 45, g_aui_null, 0, 0);
    let sz: i32 = dbg_dp(11);
    let tw: i32 = dbg_text_w("DEBUG", 5, sz);
    if (tw > 0) {
        let r1: i32 = cmd_add(10, cx, cy, fx(tw), fx(sz), 0xFFFFFFFF, 45, "DEBUG", 5, 0);
    }
    return 0;
}

// 指标卡：x/y/w/h 为像素；label 10 dp（accent 色），value 18 dp（白），
// detail 10 dp（次要色）。卡内边距 8 dp，圆角 8 dp。
fn dbg_paint_card(x: i32, y: i32, w: i32, h: i32, label: ptr, llen: i32,
                  accent: i32, value: ptr, vlen: i32,
                  detail: ptr, dlen: i32) : i32 {
    let r0: i32 = cmd_add(1, fx(x), fx(y), fx(w), fx(h), 0x11FFFFFF,
                          shape_q(AUI_SHAPE_SMALL), g_aui_null, 0, 0);
    let pad: i32 = dbg_dp(8);
    let sz_l: i32 = dbg_dp(10);
    let sz_v: i32 = dbg_dp(18);
    let lx: i32 = x + pad;
    let r1: i32 = dbg_emit_text_at(fx(lx), fx(y + pad), label, llen, accent, sz_l, 0);
    let r2: i32 = dbg_emit_text_at(fx(lx), fx(y + pad + sz_l + dbg_dp(2)), value, vlen,
                                   0xFFFFFFFF, sz_v, 0);
    let r3: i32 = dbg_emit_text_at(fx(lx), fx(y + pad + sz_l + dbg_dp(2) + sz_v + dbg_dp(2)),
                                   detail, dlen, 0xFFA4AEBE, sz_l, 0);
    return 0;
}

// 指标面板：288 dp 宽，右下角 16 dp 边距；头（绿点 + 标题 + LIVE）+
// 2×2 指标卡（FPS / FRAME / BLIT / CMDS）+ 脚注。只放框架实测值。
fn dbg_paint_panel() : i32 {
    if (g_dbg_expanded == 0) { return 0; }
    let g: i32[4] = 0;
    if (dbg_panel_geo(g) != 0) { return 0; }
    let px: i32 = g[0];
    let py: i32 = g[1];
    let pw: i32 = g[2];
    let ph: i32 = g[3];
    let r0: i32 = cmd_add(1, fx(px), fx(py), fx(pw), fx(ph), i32(theme_color(AUI_TOK_INVERSE_SURFACE)),
                          shape_q(AUI_SHAPE_MEDIUM), g_aui_null, 0, 0);
    let pad: i32 = dbg_dp(12);
    let hy: i32 = py + pad;
    // 头：绿点 8×8（圆角 4 dp）+ 标题 14 dp + 右侧 LIVE 9 dp。
    let dot: i32 = dbg_dp(8);
    let r1: i32 = cmd_add(1, fx(px + pad), fx(hy + dbg_dp(5)), fx(dot), fx(dot),
                          0xFF43D17D, dp2q(4), g_aui_null, 0, 0);
    let sz_t: i32 = dbg_dp(14);
    let r2: i32 = dbg_emit_text_at(fx(px + pad + dot + dbg_dp(7)), fx(hy),
                                   "AsterUI Performance", str_len("AsterUI Performance"),
                                   i32(theme_color(AUI_TOK_INVERSE_ON_SURFACE)), sz_t, 0);
    let sz_live: i32 = dbg_dp(9);
    let lw: i32 = dbg_text_w("LIVE", 4, sz_live);
    let r3: i32 = dbg_emit_text_at(fx(px + pw - pad - lw), fx(hy + dbg_dp(4)),
                                   "LIVE", 4, 0xFF43D17D, sz_live, 0);
    // ---- 指标值（写进 overlay 自有缓冲）----
    let v_fps: ptr = g_dbg_buf_fps;
    let l_fps: i32 = 0;
    if (dbg_fps_idle() != 0) {
        let o0: i32 = dbg_cat(g_dbg_buf_fps, 0, "Idle", 4);
        let w0: i32 = store_u8(g_dbg_buf_fps + o0, 0);
        l_fps = 4;
    } else {
        l_fps = dbg_fmt_i32(g_dbg_fps, g_dbg_buf_fps);
    }
    let v_frame: ptr = g_dbg_buf_frame;
    let l_frame: i32 = 0;
    let v_framed: ptr = g_dbg_buf_frame_d;
    let l_framed: i32 = 0;
    if (g_dbg_total_frames == 0) {
        v_frame = "--";
        l_frame = 2;
        v_framed = "No painted frames";
        l_framed = str_len("No painted frames");
    } else {
        let o1: i32 = dbg_fmt_i32(g_dbg_frame_last, g_dbg_buf_frame);
        let o2: i32 = dbg_cat(g_dbg_buf_frame, o1, " ms", 3);
        let w1: i32 = store_u8(g_dbg_buf_frame + o2, 0);
        l_frame = o2;
        let mx: i32 = g_dbg_frame_max_last;
        if (g_dbg_frame_max > mx) { mx = g_dbg_frame_max; }
        let o3: i32 = dbg_cat(g_dbg_buf_frame_d, 0, "Max ", 4);
        let o4: i32 = dbg_fmt_i32_at(mx, g_dbg_buf_frame_d, o3);
        let o5: i32 = dbg_cat(g_dbg_buf_frame_d, o4, " ms", 3);
        let w2: i32 = store_u8(g_dbg_buf_frame_d + o5, 0);
        l_framed = o5;
    }
    let o6: i32 = dbg_fmt_i32(g_dbg_blit_pct, g_dbg_buf_blit);
    let o7: i32 = dbg_cat(g_dbg_buf_blit, o6, "%", 1);
    let w3: i32 = store_u8(g_dbg_buf_blit + o7, 0);
    let l_blit: i32 = o7;
    let l_cmds: i32 = dbg_fmt_i32(g_dbg_cmds_last, g_dbg_buf_cmds);
    // 脚注：Blit N% / W x H（像素）。
    let o8: i32 = dbg_cat(g_dbg_buf_vp, 0, "Blit ", 5);
    let o9: i32 = dbg_fmt_i32_at(g_dbg_blit_pct, g_dbg_buf_vp, o8);
    let oa: i32 = dbg_cat(g_dbg_buf_vp, o9, "% / ", 4);
    let ob: i32 = dbg_fmt_i32_at(fx_px(g_aui_sw), g_dbg_buf_vp, oa);
    let oc: i32 = dbg_cat(g_dbg_buf_vp, ob, " x ", 3);
    let od: i32 = dbg_fmt_i32_at(fx_px(g_aui_sh), g_dbg_buf_vp, oc);
    let w4: i32 = store_u8(g_dbg_buf_vp + od, 0);
    let l_vp: i32 = od;
    // ---- 卡片行 ----
    let gap: i32 = dbg_dp(8);
    let cw: i32 = (pw - pad * 2 - gap) / 2;
    let ch: i32 = dbg_dp(64);
    let cy1: i32 = py + pad + dbg_dp(18) + gap;
    let cy2: i32 = cy1 + ch + gap;
    let c1: i32 = dbg_paint_card(px + pad, cy1, cw, ch,
                                 "FPS", 3, 0xFF43D17D,
                                 v_fps, l_fps,
                                 "Painted frames/s", str_len("Painted frames/s"));
    let c2: i32 = dbg_paint_card(px + pad + cw + gap, cy1, cw, ch,
                                 "FRAME", 5, 0xFF5C9EFF,
                                 v_frame, l_frame,
                                 v_framed, l_framed);
    let c3: i32 = dbg_paint_card(px + pad, cy2, cw, ch,
                                 "BLIT", 4, 0xFFFFB74D,
                                 g_dbg_buf_blit, l_blit,
                                 "blit frames", str_len("blit frames"));
    let c4: i32 = dbg_paint_card(px + pad + cw + gap, cy2, cw, ch,
                                 "CMDS", 4, 0xFFBA84FF,
                                 g_dbg_buf_cmds, l_cmds,
                                 "draw commands", str_len("draw commands"));
    // 脚注 10 dp。
    let fy: i32 = cy2 + ch + gap;
    let r4: i32 = dbg_emit_text_at(fx(px + pad), fx(fy), g_dbg_buf_vp, l_vp,
                                   0xFFA4AEBE, dbg_dp(10), 0);
    return 0;
}

// 顶层绘制：全屏裁剪（忽略 SafeArea），在提示层之上画缎带 + 面板。
fn paint_debug_overlay() : i32 {
    if (g_dbg_on == 0) { return 0; }
    if (g_aui_sw <= 0 || g_aui_sh <= 0) { return 0; }
    let sv: i32 = present_save_clip();
    present_clip_to(0, 0, g_aui_sw, g_aui_sh);
    let r0: i32 = dbg_paint_ribbon();
    let r1: i32 = dbg_paint_panel();
    present_restore_clip();
    return 0;
}

fn present_paint() : i32 {
    let i: i32 = 0;
    while (i < AUI_TOAST_CAP) {
        if (g_aui_toast_on[i] != 0) {
            let rt: i32 = paint_toast(i);
        }
        i = i + 1;
    }
    let rs: i32 = paint_snackbar();
    return 0;
}

// 帧节拍：到点自动收起。Toast 不暂停；SnackBar 在动作按钮按住时
// 暂停（HuxerUI SnackBarPauseState），松手后从剩余时间继续。
fn present_tick() : i32 {
    let now: i64 = anim_now();
    let changed: i32 = 0;
    let i: i32 = 0;
    while (i < AUI_TOAST_CAP) {
        if (g_aui_toast_on[i] != 0 && g_aui_toast_dur[i] >= 0) {
            let el: i64 = now - g_aui_toast_start[i];
            if (el >= g_aui_toast_dur[i]) {
                g_aui_toast_on[i] = 0;
                g_aui_toast_text[i] = 0;
                changed = 1;
            }
        }
        i = i + 1;
    }
    if (g_aui_snack_on != 0 && g_aui_snack_rem >= 0) {
        if (g_aui_snack_paused != 0) {
            g_aui_snack_last = now;
        } else {
            let dt: i64 = now - g_aui_snack_last;
            if (dt < 0) { dt = 0; }
            g_aui_snack_last = now;
            g_aui_snack_rem = g_aui_snack_rem - dt;
            if (g_aui_snack_rem <= 0) {
                g_aui_snack_on = 0;
                g_aui_snack_text = 0;
                g_aui_snack_action = 0;
                g_aui_snack_cb = 0;
                g_aui_snack_user = 0;
                g_aui_snack_press = 0;
                g_aui_snack_down = 0;
                g_aui_snack_paused = 0;
                changed = 1;
            }
        }
    }
    if (changed != 0) {
        g_aui_need_paint = 1;
        g_aui_pump_need = 1;
    }
    return changed;
}

fn present_busy() : i32 {
    let i: i32 = 0;
    while (i < AUI_TOAST_CAP) {
        if (g_aui_toast_on[i] != 0 && g_aui_toast_dur[i] >= 0) { return 1; }
        i = i + 1;
    }
    if (g_aui_snack_on != 0 && g_aui_snack_rem >= 0 &&
        g_aui_snack_paused == 0) {
        return 1;
    }
    return 0;
}

fn present_reset() : i32 {
    let i: i32 = 0;
    while (i < AUI_TOAST_CAP) {
        g_aui_toast_on[i] = 0;
        g_aui_toast_text[i] = 0;
        g_aui_toast_dur[i] = 0;
        i = i + 1;
    }
    g_aui_snack_on = 0;
    g_aui_snack_text = 0;
    g_aui_snack_action = 0;
    g_aui_snack_cb = 0;
    g_aui_snack_user = 0;
    g_aui_snack_press = 0;
    g_aui_snack_down = 0;
    g_aui_snack_paused = 0;
    return 0;
}

fn present_snack_hit(px: i32, py: i32) : i32 {
    if (g_aui_snack_on == 0) { return 0; }
    if (present_in(g_aui_snack_ax, g_aui_snack_ay, g_aui_snack_aw,
                   g_aui_snack_ah, px, py) != 0) {
        return 2;
    }
    if (present_in(g_aui_snack_x, g_aui_snack_y, g_aui_snack_w,
                   g_aui_snack_h, px, py) != 0) {
        return 1;
    }
    return 0;
}

// v2.10：背景矩形适用的容器 kind（行/列/栈/滚动区/虚拟容器等）。
// 写成辅助函数而不用一条 16 项的 ||：编译器对单个表达式的临时
// 寄存器有限，14 项的链已到上限，再加两项就报“expression too complex”。
fn bg_rect_kind(k: i32) : i32 {
    if (k == 2 || k == 3 || k == 4) { return 1; }
    if (k == 9 || k == 21 || k == 22) { return 1; }
    if (k == 29 || k == 39) { return 1; }
    if (k >= 51 && k <= 56) { return 1; }
    if (k == 58 || k == 59) { return 1; }
    if (k == 61) { return 1; }
    if (k == 63 || k == 64) { return 1; }
    return 0;
}

// v2.17：需要收窄裁剪的 kind（滚动容器/标签/叶子等，v2.16.1 起
// label/button 也收窄）。拆成独立函数，避免一条 16 项 || 链超编译器
// 临时寄存器上限。
fn paint_clip_narrow_kind(k: i32) : i32 {
    if (k == 5 || k == 6 || k == 9 || k == 19) { return 1; }
    if (k == 21 || k == 24 || k == 29 || k == 32) { return 1; }
    if (k == 42 || k == 51 || k == 53 || k == 55) { return 1; }
    if (k == 57 || k == 58 || k == 63 || k == 64) { return 1; }
    return 0;
}

// v2.17：参与滚动直搬视口记录 / 滚动条绘制的容器 kind。拆开写，避免
// 长 || 链超编译器临时寄存器上限。
fn scroll_container_kind(k: i32) : i32 {
    if (k == 9 || k == 32 || k == 51) { return 1; }
    if (k == 53 || k == 55 || k == 58) { return 1; }
    if (k == 63) { return 1; }
    return 0;
}

// v2.19.1：参与滚动直搬视口记录的容器 kind（与上面分开）。标签栏
// （kind 19）横向滚动也要直搬，但它没有滚动条——画滚动条仍只认上面
// 那张表（paint_scrollbar 由 scroll_container_kind 门控）；视口记录
// 与子树范围（sg_start/sg_end）认这张表。两张表分开，免得给标签栏
// 画出一条不存在的滚动条。
fn scroll_blit_container_kind(k: i32) : i32 {
    if (scroll_container_kind(k) != 0) { return 1; }
    if (k == 19) { return 1; }
    return 0;
}

// v2.19.1：按 key 找节点 kind（直搬轴向判定用；未找到返回 0）。
fn scroll_node_kind(key: i32) : i32 {
    let i: i32 = 0;
    while (i < g_aui_node_count) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.key == key) { return n.kind; }
        i = i + 1;
    }
    return 0;
}

// v2.17.1：首列右沿（裁剪坐标，Q16.16）= 内容左 + 首列宽。表身
// （非首列）画到首列下面会从透明的奇数行首列格透出来（重影），
// 绘制时必须把表身裁剪收到这条沿；直搬视口也用它。
fn vtable_sticky_edge(n: ptr<AuiNode>) : i32 {
    let s: i32 = vtable_find(n.key);
    let w0: i32 = 0;
    if (s >= 0) { w0 = vtable_colw_q(s, 0); }
    let e: i32 = n.x + n.pad + w0 + g_aui_paint_dx;
    if (g_aui_paint_sc_d != 0) { e = paint_scale_x(e); }
    return e;
}

// v2.17：表格子格按（首列，表头）分四遍画：表身非首列 → 表头非首列 →
// 表身首列 → 表头首列。表头盖住滑到它下面的表身行，首列盖住滑到它
// 下面的其余列，角上的表头首列最后画。建树顺序不影响遮盖。
fn paint_vtable_children(n: ptr<AuiNode>) : i32 {
    // v2.17.1：表身（pass 0/1）的裁剪左沿收到首列右沿；首列
    // （pass 2/3）用完整裁剪。子格自己的裁剪会再与这条沿求交。
    let edge: i32 = vtable_sticky_edge(n);
    let scx: i32 = g_aui_clip_x;
    let scw: i32 = g_aui_clip_w;
    let pass: i32 = 0;
    while (pass < 4) {
        if (pass == 0) {
            if (edge > g_aui_clip_x) {
                g_aui_clip_w = g_aui_clip_x + g_aui_clip_w - edge;
                if (g_aui_clip_w < 0) { g_aui_clip_w = 0; }
                g_aui_clip_x = edge;
            }
        }
        if (pass == 2) {
            g_aui_clip_x = scx;
            g_aui_clip_w = scw;
        }
        let c: i32 = n.first_child;
        while (c >= 0) {
            let cn: ptr<AuiNode> = node_at(c);
            let is_head: i32 = 0;
            if (cn.aux < 0) { is_head = 1; }
            let is_c0: i32 = 0;
            if (cn.aux2 == 0) { is_c0 = 1; }
            let want: i32 = 0;
            if (pass == 0 && is_head == 0 && is_c0 == 0) { want = 1; }
            if (pass == 1 && is_head != 0 && is_c0 == 0) { want = 1; }
            if (pass == 2 && is_head == 0 && is_c0 != 0) { want = 1; }
            if (pass == 3 && is_head != 0 && is_c0 != 0) { want = 1; }
            if (want != 0) { let r7: i32 = paint_node(c); }
            c = cn.next_sibling;
        }
        pass = pass + 1;
    }
    g_aui_clip_x = scx;
    g_aui_clip_w = scw;
    return 0;
}

fn paint_node(i: i32) : i32 {
    let n: ptr<AuiNode> = node_at(i);
    let k: i32 = n.kind;
    // 进入滚动容器时把裁剪矩形收窄到视口，子树的每条命令都带上它。
    let saved_x: i32 = g_aui_clip_x;
    let saved_y: i32 = g_aui_clip_y;
    let saved_w: i32 = g_aui_clip_w;
    let saved_h: i32 = g_aui_clip_h;
    // v1.10：节点的 alpha/tx/ty 只影响绘制，不参与 build/layout。
    let saved_pa: i32 = g_aui_paint_alpha;
    let saved_pdx: i32 = g_aui_paint_dx;
    let saved_pdy: i32 = g_aui_paint_dy;
    // v2.16：缩放栈深度（与 alpha/dx/dy 同一存取模式）。
    let saved_scd: i32 = g_aui_paint_sc_d;
    // v1.20：维护“当前位置的背景色”，子树的描边控件靠它挖空内圈。
    let saved_bg: u32 = g_aui_paint_bg;
    // v2.15：排版样式与局部主题随节点进出（与 clip/背景同一存取模式）。
    let saved_cell: i32 = g_aui_text_cell;
    let saved_bold: i32 = g_aui_text_bold;
    let rst: i32 = text_style_for_node(n);
    let theme_pushed: i32 = 0;
    if (k == 62) {
        let rp: i32 = theme_push(n.aux);
        theme_pushed = 1;
    }
    if (k == 1) { g_aui_paint_bg = theme_bg(); }
    if (n.bg != 0) { g_aui_paint_bg = n.bg; }
    if (k == 24) { g_aui_paint_bg = theme_surface(); }
    let ra: i32 = anim_apply(n.key, &g_aui_anim_out);
    if (g_aui_anim_out[0] < 255) {
        g_aui_paint_alpha = (saved_pa * g_aui_anim_out[0] + 127) / 255;
    }
    g_aui_paint_dx = saved_pdx + dp2q(g_aui_anim_out[1]);
    g_aui_paint_dy = saved_pdy + dp2q(g_aui_anim_out[2]);
    // v2.16：节点缩放（HuxerUI Scale 默认锚点：节点中心）。绕本节点
    // 中心（外层变换后的屏幕坐标，含本节点位移）压一层缩放；子树的
    // 命令与字号都走它，布局矩形与命中测试不受影响。
    let sc_q: i32 = g_aui_anim_out[3];
    if (sc_q < 655) { sc_q = 655; }
    if (sc_q > 262144) { sc_q = 262144; }
    if (sc_q != 65536 && g_aui_paint_sc_d < 32) {
        let ccx: i32 = n.x + n.w / 2 + g_aui_paint_dx;
        let ccy: i32 = n.y + n.h / 2 + g_aui_paint_dy;
        let ocx: i32 = paint_scale_x(ccx);
        let ocy: i32 = paint_scale_y(ccy);
        g_aui_paint_sc_sx[g_aui_paint_sc_d] = sc_q;
        g_aui_paint_sc_ox[g_aui_paint_sc_d] = ocx;
        g_aui_paint_sc_oy[g_aui_paint_sc_d] = ocy;
        g_aui_paint_sc_d = g_aui_paint_sc_d + 1;
        // 本节点的字号按完整缩放重算（子节点入口与 emit 时还会再算）。
        let rst2: i32 = text_style_for_node(n);
    }
    // v2.16.1：label(5)/button(6) 也收窄裁剪。缩放下文字按缩放后的字号
    // 断行（emit_text_lines），万一仍溢出（旧快照、多行、极端字号），
    // 文字会被裁在节点矩形内，不再画到按钮外面。label/button 是叶子，
    // 收窄只影响本节点自己的命令；滚动视口记录的内层 kind 表不变。
    if (paint_clip_narrow_kind(k) != 0) {
        let x0: i32 = n.x + g_aui_paint_dx;
        let y0: i32 = n.y + g_aui_paint_dy;
        let x1: i32 = n.x + n.w + g_aui_paint_dx;
        let y1: i32 = n.y + n.h + g_aui_paint_dy;
        // v2.16：缩放时先把矩形穿过缩放栈变到屏幕坐标，再与父裁剪求交。
        if (g_aui_paint_sc_d != 0) {
            x0 = paint_scale_x(x0);
            y0 = paint_scale_y(y0);
            x1 = paint_scale_x(x1);
            y1 = paint_scale_y(y1);
        }
        let sx1: i32 = saved_x + saved_w;
        let sy1: i32 = saved_y + saved_h;
        if (x0 < saved_x) { x0 = saved_x; }
        if (y0 < saved_y) { y0 = saved_y; }
        if (x1 > sx1) { x1 = sx1; }
        if (y1 > sy1) { y1 = sy1; }
        if (x1 < x0) { x1 = x0; }
        if (y1 < y0) { y1 = y0; }
        g_aui_clip_x = x0;
        g_aui_clip_y = y0;
        g_aui_clip_w = x1 - x0;
        g_aui_clip_h = y1 - y0;
        // v1.48.6：本帧被拖动/惯性滚动的容器，记下可见视口与子树命令
        // 起点，供纯滚动直搬使用。sg_end 在子树（含滚动条）画完后回填。
        // v2.16：缩放激活时不记视口（滚动位移按布局坐标，直搬按屏幕
        // 像素，两者在缩放下不对齐）→ 该容器回落整屏重画，不直搬。
        if (g_aui_paint_sc_d == 0 && g_aui_frame_scroll_key != 0 && n.key == g_aui_frame_scroll_key &&
            scroll_blit_container_kind(k) != 0) {
            g_aui_scroll_vp_ok = 1;
            g_aui_scroll_vp_l = fx_px(x0);
            g_aui_scroll_vp_t = fx_px(y0);
            g_aui_scroll_vp_r = fx_px(x1);
            g_aui_scroll_vp_b = fx_px(y1);
            // v2.17：表头不随纵向滚动，直搬只搬表身区域（表头像素原地
            // 不动，纵向滚动时它的命令本来就没变；横向滚动不直搬）。
            if (k == 63) {
                g_aui_scroll_vp_t = g_aui_scroll_vp_t + (n.aux2 >> 16);
                // v2.17.1：表格横向直搬用另一张视口：左沿收到首列右沿
                // （首列横向固定不搬），上下全高（含表头——表头非首列
                // 随横向滚动）。纵向直搬仍用上面那张（上沿收到表头底，
                // 全宽，含首列）。
                g_aui_scroll_vp_h_ok = 1;
                let vhl: i32 = fx_px(vtable_sticky_edge(n));
                if (vhl < g_aui_scroll_vp_l) { vhl = g_aui_scroll_vp_l; }
                g_aui_scroll_vp_hl = vhl;
                g_aui_scroll_vp_ht = fx_px(y0);
                g_aui_scroll_vp_hr = fx_px(x1);
                g_aui_scroll_vp_hb = fx_px(y1);
            }
            g_aui_scroll_vp_rad = n.radius;
            g_aui_sg_start = g_aui_cmd_count;
            g_aui_sg_end = -2;
        }
    }
    if (k == 1) {
        let r0: i32 = cmd_add(1, n.x, n.y, n.w, n.h, i32(theme_bg()), 0, g_aui_null, 0, 0);
    }
    if (k == 23) {
        // v1.25：整窗遮罩；卡片在子节点里最后绘制。
        let rs: i32 = cmd_add(1, 0, 0, g_aui_sw, g_aui_sh, 0x99000000, 0,
                              g_aui_null, 0, 0);
    }
    if (k == 41) {
        // v1.38：底部弹出层遮罩（42% 黑，同 HuxerUI BottomSheet）。
        let rs2: i32 = cmd_add(1, 0, 0, g_aui_sw, g_aui_sh, i32(theme_color(AUI_TOK_SCRIM)), 0,
                               g_aui_null, 0, 0);
    }
    if (k == 42) {
        // v1.38：表面只圆上面两角：先画整块圆角矩形，再用同色方块盖住
        // 底部 radius 高的两个下角。把手画在表面之上、内容之下。
        let scol: u32 = theme_surface();
        if (n.bg != 0) { scol = n.bg; }
        let rs3: i32 = cmd_add(1, n.x, n.y, n.w, n.h, i32(scol), n.radius,
                               g_aui_null, 0, 0);
        let rad: i32 = n.radius;
        if (rad > n.h) { rad = n.h; }
        if (rad > 0) {
            let rs4: i32 = cmd_add(1, n.x, n.y + n.h - rad, n.w, rad,
                                   i32(scol), 0, g_aui_null, 0, 0);
        }
        if ((n.flags & 1) == 0) {
            let hw: i32 = dp2q(32);
            let hh: i32 = dp2q(4);
            if (hw > n.w) { hw = n.w; }
            let hx: i32 = n.x + (n.w - hw) / 2;
            let hy: i32 = n.y + dp2q(10);
            let hc: i32 = (77 << 24) | (i32(theme_text()) & 0x00FFFFFF);
            let rs5: i32 = cmd_add(1, hx, hy, hw, hh, hc, hh / 2,
                                   g_aui_null, 0, 0);
        }
    }
    if (k == 24) {
        let col: u32 = theme_surface();
        if (n.bg != 0) { col = n.bg; }
        let rc: i32 = cmd_add(1, n.x, n.y, n.w, n.h, i32(col), n.radius,
                              g_aui_null, 0, 0);
    }
    if (k == 5 || k == 7 || k == 8 || k == 14 || k == 15 || k == 16 || k == 57) {
        if (n.bg != 0) {
            let r1: i32 = cmd_add(1, n.x, n.y, n.w, n.h, i32(n.bg), n.radius, g_aui_null, 0, 0);
        }
    }
    if (bg_rect_kind(k) != 0) {
        if (n.bg != 0) {
            let r2: i32 = cmd_add(1, n.x, n.y, n.w, n.h, i32(n.bg), n.radius, g_aui_null, 0, 0);
        }
    }
    if (k == 5) {
        // D-2a：选区底色块画在文字之前；文字颜色走 aui_fg 覆盖链。
        if (g_d2a_sel_node == i) { let sr: i32 = d2a_sel_paint(n, i); }
        let r3: i32 = emit_text_lines(n, d2a_fg_or(n, i32(theme_text())), 0, n.y + n.pad);
    }
    if (k == 6) {
        let col: u32 = theme_primary();
        if (g_aui_pressing != 0 && g_aui_press_key == n.key) { col = theme_primary_dark(); }
        // v2.11：按钮默认 8 dp 圆角（HuxerUI ButtonStyle CornerRadii{8}）；
        // 未调 aui_radius 时不再是直角。显式 aui_radius 仍优先。
        let br: i32 = n.radius;
        if (br <= 0) { br = shape_q(AUI_SHAPE_SMALL); }
        let r4: i32 = cmd_add(1, n.x, n.y, n.w, n.h, i32(col), br, g_aui_null, 0, 0);
        // 按钮文字在按钮内垂直居中（44 dp 最小高度时不再贴顶）。
        let by: i32 = n.y + (n.h - text_line_h()) / 2;
        let r5: i32 = emit_text_lines(n, d2a_fg_or(n, i32(theme_on_primary())), 1, by);
    }
    if (k == 10) {
        let rf: i32 = paint_field(n);
    }
    if (k == 11) {
        let rk: i32 = paint_key(n);
    }
    if (k == 12) {
        let rs: i32 = paint_switch(n);
    }
    if (k == 13) {
        let rp: i32 = paint_progress(n);
    }
    if (k == 14) {
        let rc: i32 = paint_check(n);
    }
    if (k == 15) {
        let rr: i32 = paint_radio(n);
    }
    if (k == 30) {
        let rchip: i32 = paint_chip(n);
    }
    if (k == 60) {
        let rbdg: i32 = paint_badge(n);
    }
    if (k == 31) {
        let rpc: i32 = paint_circle(n);
    }
    if (k == 33) {
        let rti: i32 = paint_tree_item(n);
    }
    if (k == 37) {
        let rib: i32 = paint_icon_button(n);
    }
    if (k == 38) {
        let ric: i32 = paint_icon(n);
    }
    if (k == 40) {
        let rdv: i32 = paint_divider(n);
    }
    if (k == 61) {
        let rsd: i32 = paint_split_divider(n);
    }
    if (k == 44) {
        let rtb: i32 = paint_top_bar(n);
    }
    if (k == 45) {
        let rnb: i32 = paint_nav_bar(n);
    }
    if (k == 46) {
        let rni: i32 = paint_nav_item(n);
    }
    if (k == 47) {
        let rnp: i32 = paint_nav_pane(n);
    }
    if (k == 48) {
        let rnpi: i32 = paint_nav_pane_item(n);
    }
    if (k == 16) {
        let rs: i32 = paint_slider(n);
    }
    if (k == 17) {
        let rg: i32 = paint_segmented(n);
    }
    if (k == 18) {
        let rq: i32 = paint_segment(n);
    }
    if (k == 19) {
        let rt: i32 = paint_tabs(n);
    }
    if (k == 20) {
        let ru: i32 = paint_tab(n);
    }
    if (k == 25) {
        let rsel: i32 = paint_select(n);
    }
    if (k == 26) {
        let ropt: i32 = paint_option(n);
    }
    if (k == 49) {
        let rcombo: i32 = paint_combo(n);
    }
    if (k == 50) {
        let rsug: i32 = paint_combo_suggestion(n);
    }
    if (k == 27) {
        let rdate: i32 = paint_date(n);
    }
    if (k == 28) {
        let rtime: i32 = paint_time(n);
    }
    if (k == 8) {
        let wdp: i32 = n.aux & 65535;
        let hdp: i32 = (n.aux >> 16) & 65535;
        let r6: i32 = cmd_add(3, n.x, n.y, n.w, n.h, 0xFF000000, 0, n.text, wdp, hdp);
    }
    if (k == 57) {
        // v2.6：Canvas——在节点矩形内调用应用的 draw_fn。裁剪已在上
        // 面收窄到节点矩形（含动画 paint 偏移），所以回调发的每条命
        // 令都带上它；函数尾恢复裁剪。原点是节点绝对位置（cmd_add
        // 自己加 paint 偏移）；尺寸是布局后的实际尺寸（dp）。回调
        // 返回值忽略；回调里建节点会被 node_alloc 拒绝（见上）。
        g_aui_cv_ox = n.x;
        g_aui_cv_oy = n.y;
        g_aui_cv_w = q2dp(n.w);
        g_aui_cv_h = q2dp(n.h);
        g_aui_in_cv = 1;
        if (n.cb != 0) {
            let r8: i32 = n.cb(n.user);
        }
        g_aui_in_cv = 0;
    }
    // v1.38：拖拽中的底部弹出层整体下移（只影响绘制，不影响命中/布局）。
    if (k == 41 && g_aui_sheet_drag > 0) {
        g_aui_paint_dy = g_aui_paint_dy + g_aui_sheet_drag;
    }
    // v1.48：按压水波纹画在节点自身内容之上、子树内容之下。
    if (g_aui_ripple_phase != 0 && n.key == g_aui_ripple_key) {
        let rrp: i32 = ripple_paint(n);
    }
    let c: i32 = n.first_child;
    if (k == 63) {
        let pv: i32 = paint_vtable_children(n);
    } else {
        while (c >= 0 && k != 25 && k != 49) {
            let cn: ptr<AuiNode> = node_at(c);
            let r7: i32 = paint_node(c);
            c = cn.next_sibling;
        }
    }
    if (scroll_container_kind(k) != 0) {
        let sb: i32 = paint_scrollbar(n);
    }
    if (k == 29) {
        let rr: i32 = paint_refresh(n);
    }
    if (paint_clip_narrow_kind(k) != 0) {
        // v1.48.6：滚动条已经画完，子树命令范围到此为止（只认被跟踪的
        // 那个容器，嵌套滚动容器不会误收尾）。
        if (g_aui_sg_end == -2 && g_aui_frame_scroll_key != 0 &&
            n.key == g_aui_frame_scroll_key &&
            scroll_blit_container_kind(k) != 0) {
            g_aui_sg_end = g_aui_cmd_count;
        }
        // v2.16.1：裁剪恢复与收窄用同一张 kind 表（label/button 也收窄，
        // 就必须也恢复；否则收窄后的裁剪漏给后面的兄弟节点，命令的裁剪
        // 矩形变 0，损伤比较永远算不出矩形）。
        g_aui_clip_x = saved_x;
        g_aui_clip_y = saved_y;
        g_aui_clip_w = saved_w;
        g_aui_clip_h = saved_h;
    }
    g_aui_paint_alpha = saved_pa;
    g_aui_paint_dx = saved_pdx;
    g_aui_paint_dy = saved_pdy;
    g_aui_paint_sc_d = saved_scd;
    g_aui_paint_bg = saved_bg;
    // v2.15：恢复排版样式（含运行时 cell），弹出本节点的主题覆盖。
    g_aui_text_cell = saved_cell;
    g_aui_text_bold = saved_bold;
    let rc2: i32 = aui_rt_set_cell(saved_cell);
    if (theme_pushed != 0) {
        let rp2: i32 = theme_pop();
    }
    return 0;
}

// ===========================================================================
// 7. 软件光栅
// ===========================================================================

fn isqrt(v: i32) : i32 {
    if (v <= 0) { return 0; }
    let x: i32 = v;
    let y: i32 = (x + 1) / 2;
    while (y < x) {
        x = y;
        y = (x + v / x) / 2;
    }
    return x;
}

fn pack_color(color: i32, fmt: i32) : i32 {
    let a: i32 = (color >> 24) & 255;
    let r: i32 = (color >> 16) & 255;
    let g: i32 = (color >> 8) & 255;
    let b: i32 = color & 255;
    if (fmt == 4) {
        return ((r >> 3) << 11) | ((g >> 2) << 5) | (b >> 3);
    }
    return (a << 24) | (b << 16) | (g << 8) | r;
}

fn blend_px(bits: ptr, off: i32, r: i32, g: i32, b: i32, a: i32, fmt: i32) : i32 {
    if (a <= 0) { return 0; }
    let ia: i32 = 255 - a;
    if (fmt == 4) {
        let v: i32 = load_u16(bits + off);
        let dr: i32 = ((v >> 11) & 31) * 255 / 31;
        let dg: i32 = ((v >> 5) & 63) * 255 / 63;
        let db: i32 = (v & 31) * 255 / 31;
        let nr: i32 = (r * a + dr * ia + 127) / 255;
        let ng: i32 = (g * a + dg * ia + 127) / 255;
        let nb: i32 = (b * a + db * ia + 127) / 255;
        let nv: i32 = ((nr >> 3) << 11) | ((ng >> 2) << 5) | (nb >> 3);
        let w: i32 = store_u16(bits + off, nv);
        return 0;
    }
    let dv: i32 = *(bits + off);
    let dr: i32 = dv & 255;
    let dg: i32 = (dv >> 8) & 255;
    let db: i32 = (dv >> 16) & 255;
    let nr: i32 = (r * a + dr * ia + 127) / 255;
    let ng: i32 = (g * a + dg * ia + 127) / 255;
    let nb: i32 = (b * a + db * ia + 127) / 255;
    let nv: i32 = (255 << 24) | (nb << 16) | (ng << 8) | nr;
    *(bits + off) = nv;
    return 0;
}

fn fill_run(bits: ptr, stride: i32, fmt: i32, x: i32, y: i32, tlen: i32, color: i32) : i32 {
    if (tlen <= 0) { return 0; }
    let a: i32 = (color >> 24) & 255;
    let i: i32 = 0;
    // v2.7.1：行首地址一次算好（分块帧缓冲的行可能不在第 0 块）；行内
    // 再用“行首 + x*bpp”寻址，与原来逐字节相同。
    let rowbpp: i32 = 4;
    if (fmt == 4) { rowbpp = 2; }
    let row: ptr = fb_row_ptr(bits, stride, rowbpp, y);
    if (a < 255) {
        // 半透明填充（v1.10 动画）：逐像素混合，alpha 0 直接跳过。
        if (a <= 0) { return 0; }
        let r: i32 = (color >> 16) & 255;
        let g: i32 = (color >> 8) & 255;
        let b: i32 = color & 255;
        if (fmt == 4) {
            while (i < tlen) {
                let w: i32 = blend_px(row, x * 2 + i * 2, r, g, b, a, 4);
                i = i + 1;
            }
        } else {
            while (i < tlen) {
                let w: i32 = blend_px(row, x * 4 + i * 4, r, g, b, a, 1);
                i = i + 1;
            }
        }
        return 0;
    }
    let v: i32 = pack_color(color, fmt);
    // v1.48.4：不透明整行填充是最常见的光栅操作（页面底色、卡片、列表行）。
    // 逐像素写 32 位在真机上每帧要跑几百万次循环；这里一次写 4 个像素
    // （RGBA8888 用两次 64 位存，RGB565 用两次 32 位存），循环开销降到 1/4。
    // 指针对齐不影响 AArch64 的普通 STR，行首可能是任意像素列。
    if (fmt == 4) {
        let v2: i32 = v | (v << 16);
        while (i + 4 <= tlen) {
            *(row + x * 2 + i * 2) = v2;
            *(row + x * 2 + i * 2 + 4) = v2;
            i = i + 4;
        }
        while (i + 2 <= tlen) {
            *(row + x * 2 + i * 2) = v2;
            i = i + 2;
        }
        while (i < tlen) {
            let w: i32 = store_u16(row + x * 2 + i * 2, v);
            i = i + 1;
        }
    } else {
        let lo: i64 = i64(v) & 0xFFFFFFFF;
        let v64: i64 = lo | (lo << 32);
        while (i + 4 <= tlen) {
            let w0: i64 = store_i64(row + x * 4 + i * 4, v64);
            let w1: i64 = store_i64(row + x * 4 + i * 4 + 8, v64);
            i = i + 4;
        }
        while (i + 2 <= tlen) {
            let w2: i64 = store_i64(row + x * 4 + i * 4, v64);
            i = i + 2;
        }
        while (i < tlen) {
            *(row + x * 4 + i * 4) = v;
            i = i + 1;
        }
    }
    return 0;
}

// v1.23：形状抗锯齿的覆盖率。按像素中心到圆心的距离估算，单位 1/16 px；
// 距离每往里 1/16 px 覆盖率加 16/255，于是边界两侧各 0.5 px 内从 0 过渡
// 到 255。只对圆角/圆的边缘调用，直边仍是整数像素对齐、不需要过渡。
fn corner_cov(px: i32, py: i32, cx: i32, cy: i32, r: i32) : i32 {
    let dx: i32 = px * 16 + 8 - cx * 16;
    let dy: i32 = py * 16 + 8 - cy * 16;
    let d: i32 = isqrt(dx * dx + dy * dy);
    let cov: i32 = 128 + (r * 16 - d) * 16;
    if (cov < 0) { cov = 0; }
    if (cov > 255) { cov = 255; }
    return cov;
}

// v1.23：单个像素按覆盖率混合。颜色自身的 alpha 与覆盖率相乘，半透明
// 形状（按压态、动画）不会因为 AA 变成两次混合。
fn fill_px_cov(bits: ptr, stride: i32, fmt: i32, x: i32, y: i32,
               color: i32, cov: i32) : i32 {
    if (cov <= 0) { return 0; }
    let ca: i32 = (color >> 24) & 255;
    let a: i32 = (ca * cov + 127) / 255;
    if (a <= 0) { return 0; }
    let r: i32 = (color >> 16) & 255;
    let g: i32 = (color >> 8) & 255;
    let b: i32 = color & 255;
    if (fmt == 4) {
        // v2.7.1：行首一次算好（分块帧缓冲），行内再加 x*2。
        let row4: ptr = fb_row_ptr(bits, stride, 2, y);
        let w4: i32 = blend_px(row4, x * 2, r, g, b, a, 4);
    } else {
        let row8: ptr = fb_row_ptr(bits, stride, 4, y);
        let w8: i32 = blend_px(row8, x * 4, r, g, b, a, 1);
    }
    return 0;
}

// ===========================================================================
// 旋转原语（v2.8：DEBUG overlay 缎带；对照 HuxerUI Rotation{45}）。
// 角度约定与 HuxerUI 一致：Transform2D 字段顺序 {m11, m12, m21, m22}，
// Apply 为 x' = m11*x + m21*y、y' = m12*x + m22*y；RotationExtension
// 造的是 {cos, sin, -sin, cos}，即 m11=cos、m12=sin、m21=-sin、
// m22=cos。屏幕坐标 y 向下；+θ 为顺时针（文字沿带子向右下行，
// 缎带 +45° 为下行 \）。
//   局部 → 屏幕：x' = cos*x - sin*y；y' = sin*x + cos*y
//   屏幕 → 局部：x = cos*x' + sin*y'；y = -sin*x' + cos*y'
// （v2.8.1 修正：v2.8 按转置映射 x' = cos*x + sin*y、
// y' = -sin*x + cos*y 实现，缎带画反成 /；四处公式同翻。）
// sin 表：0..90° 每 5° 一项，Q16.16；段内线性插值，最大误差 0.0009
// （60 px 字形上 < 0.06 px），肉眼不可见。通用整度角，不只 45°。
// ===========================================================================
let g_rot_sin_tab: i32[19] = 0;
let g_rot_sin_init: i32 = 0;

fn rot_sin_init() : i32 {
    if (g_rot_sin_init != 0) { return 0; }
    g_rot_sin_tab[0] = 0;
    g_rot_sin_tab[1] = 5712;
    g_rot_sin_tab[2] = 11380;
    g_rot_sin_tab[3] = 16962;
    g_rot_sin_tab[4] = 22415;
    g_rot_sin_tab[5] = 27697;
    g_rot_sin_tab[6] = 32768;
    g_rot_sin_tab[7] = 37590;
    g_rot_sin_tab[8] = 42126;
    g_rot_sin_tab[9] = 46341;
    g_rot_sin_tab[10] = 50203;
    g_rot_sin_tab[11] = 53684;
    g_rot_sin_tab[12] = 56756;
    g_rot_sin_tab[13] = 59396;
    g_rot_sin_tab[14] = 61584;
    g_rot_sin_tab[15] = 63303;
    g_rot_sin_tab[16] = 64540;
    g_rot_sin_tab[17] = 65287;
    g_rot_sin_tab[18] = 65536;
    g_rot_sin_init = 1;
    return 0;
}

// 0..90° 的 sin（Q16.16），段内线性插值。
fn rot_sin90(a: i32) : i32 {
    if (a <= 0) { return 0; }
    if (a >= 90) { return 65536; }
    let i: i32 = a / 5;
    let f: i32 = a - i * 5;
    let s0: i32 = g_rot_sin_tab[i];
    let s1: i32 = g_rot_sin_tab[i + 1];
    return s0 + (s1 - s0) * f / 5;
}

// 整度角 → out[0] = cos，out[1] = sin（Q16.16）。任意整数角（含负角）。
fn rot_sin_cos(deg: i32, out: ptr) : i32 {
    let ri: i32 = rot_sin_init();
    let d: i32 = deg;
    while (d < 0) { d = d + 360; }
    while (d >= 360) { d = d - 360; }
    if (d < 90) {
        *(out + 0) = rot_sin90(90 - d);
        *(out + 4) = rot_sin90(d);
    } else if (d < 180) {
        *(out + 0) = 0 - rot_sin90(d - 90);
        *(out + 4) = rot_sin90(180 - d);
    } else if (d < 270) {
        *(out + 0) = 0 - rot_sin90(270 - d);
        *(out + 4) = 0 - rot_sin90(d - 180);
    } else {
        *(out + 0) = rot_sin90(d - 270);
        *(out + 4) = 0 - rot_sin90(360 - d);
    }
    return 0;
}

// 旋转矩形扫描线填充。cx/cy/w/h 为 Q16.16 px（cx/cy 是旋转中心），
// angle 为整度角。做法：四个角正向旋转求包围盒，逐行与四条边求交
// （1/16 px 精度），行内整段 fill_run，两端像素按覆盖率混合。
// 旋转矩形没有“圆角”概念，radius 字段即角度，不另设圆角。
fn fill_rot_rect(bits: ptr, stride: i32, fmt: i32, cx: i32, cy: i32,
                 w: i32, h: i32, angle: i32, color: i32,
                 cl: i32, ct: i32, cr: i32, cb: i32) : i32 {
    let ca: i32 = (color >> 24) & 255;
    if (ca <= 0) { return 0; }
    let wpx: i32 = fx_px(w);
    let hpx: i32 = fx_px(h);
    if (wpx <= 0 || hpx <= 0) { return 0; }
    let cs: i32[2] = 0;
    let r0: i32 = rot_sin_cos(angle, cs);
    let co: i32 = cs[0];
    let si: i32 = cs[1];
    // 半宽/半高（1/16 px）：cx/cy 先换算成 1/16 px 整数。
    let ccx: i32 = fx_px(cx) * 16;
    let ccy: i32 = fx_px(cy) * 16;
    let hw: i32 = wpx * 8;
    let hh: i32 = hpx * 8;
    // 四个角（相对中心，1/16 px）正向旋转：x' = c*x - s*y，y' = s*x + c*y。
    let x0: i32 = i32((i64(co) * i64(0 - hw) - i64(si) * i64(0 - hh)) / 65536) + ccx;
    let y0: i32 = i32((i64(si) * i64(0 - hw) + i64(co) * i64(0 - hh)) / 65536) + ccy;
    let x1: i32 = i32((i64(co) * i64(hw) - i64(si) * i64(0 - hh)) / 65536) + ccx;
    let y1: i32 = i32((i64(si) * i64(hw) + i64(co) * i64(0 - hh)) / 65536) + ccy;
    let x2: i32 = i32((i64(co) * i64(hw) - i64(si) * i64(hh)) / 65536) + ccx;
    let y2: i32 = i32((i64(si) * i64(hw) + i64(co) * i64(hh)) / 65536) + ccy;
    let x3: i32 = i32((i64(co) * i64(0 - hw) - i64(si) * i64(hh)) / 65536) + ccx;
    let y3: i32 = i32((i64(si) * i64(0 - hw) + i64(co) * i64(hh)) / 65536) + ccy;
    // 包围盒（像素行范围）。
    let minx: i32 = x0;
    if (x1 < minx) { minx = x1; }
    if (x2 < minx) { minx = x2; }
    if (x3 < minx) { minx = x3; }
    let maxx: i32 = x0;
    if (x1 > maxx) { maxx = x1; }
    if (x2 > maxx) { maxx = x2; }
    if (x3 > maxx) { maxx = x3; }
    let miny: i32 = y0;
    if (y1 < miny) { miny = y1; }
    if (y2 < miny) { miny = y2; }
    if (y3 < miny) { miny = y3; }
    let maxy: i32 = y0;
    if (y1 > maxy) { maxy = y1; }
    if (y2 > maxy) { maxy = y2; }
    if (y3 > maxy) { maxy = y3; }
    let rlo: i32 = miny / 16;
    let rhi: i32 = maxy / 16;
    if (rlo < 0) { rlo = 0; }
    if (rhi >= g_aui_fb_h) { rhi = g_aui_fb_h - 1; }
    if (rlo < ct) { rlo = ct; }
    if (rhi >= cb) { rhi = cb - 1; }
    if (rhi < rlo) { return 0; }
    // 边表：四条边 (ex0,ey0)-(ex1,ey1)，1/16 px。
    let ex0: i32[4] = 0;
    let ey0: i32[4] = 0;
    let ex1: i32[4] = 0;
    let ey1: i32[4] = 0;
    ex0[0] = x0; ey0[0] = y0; ex1[0] = x1; ey1[0] = y1;
    ex0[1] = x1; ey0[1] = y1; ex1[1] = x2; ey1[1] = y2;
    ex0[2] = x2; ey0[2] = y2; ex1[2] = x3; ey1[2] = y3;
    ex0[3] = x3; ey0[3] = y3; ex1[3] = x0; ey1[3] = y0;
    let row: i32 = rlo;
    while (row <= rhi) {
        let yc: i32 = row * 16 + 8;
        // 本行与四条边的交点（1/16 px），至多 2 个有效交点。
        let xa: i32 = 0;
        let xb: i32 = 0;
        let n: i32 = 0;
        let e: i32 = 0;
        while (e < 4) {
            let ya: i32 = ey0[e];
            let yb: i32 = ey1[e];
            if ((ya <= yc && yb > yc) || (yb <= yc && ya > yc)) {
                let xa0: i32 = ex0[e];
                let xb0: i32 = ex1[e];
                let xx: i32 = i32(i64(xa0) + i64(xb0 - xa0) * i64(yc - ya) / i64(yb - ya));
                if (n == 0) { xa = xx; n = 1; }
                else if (n == 1) { xb = xx; n = 2; }
            }
            e = e + 1;
        }
        if (n == 2) {
            if (xa > xb) {
                let tmp: i32 = xa;
                xa = xb;
                xb = tmp;
            }
            // 裁剪到 clip 与帧缓冲（1/16 px）。
            let l16: i32 = xa;
            let r16: i32 = xb;
            if (l16 < cl * 16) { l16 = cl * 16; }
            if (r16 > cr * 16) { r16 = cr * 16; }
            if (l16 < 0) { l16 = 0; }
            if (r16 > g_aui_fb_w * 16) { r16 = g_aui_fb_w * 16; }
            if (r16 > l16) {
                let p0: i32 = l16 / 16;
                let p1: i32 = (r16 - 1) / 16;
                if (p1 >= p0) {
                    if (p1 == p0) {
                        let cov: i32 = (r16 - l16) * 255 / 16;
                        let b0: i32 = fill_px_cov(bits, stride, fmt, p0, row, color, cov);
                    } else {
                        // 左端像素覆盖率：(p0+1)*16 - l16 个 1/16。
                        let covl: i32 = ((p0 + 1) * 16 - l16) * 255 / 16;
                        let bl: i32 = fill_px_cov(bits, stride, fmt, p0, row, color, covl);
                        // 右端像素覆盖率：r16 - p1*16 个 1/16。
                        let covr: i32 = (r16 - p1 * 16) * 255 / 16;
                        let br: i32 = fill_px_cov(bits, stride, fmt, p1, row, color, covr);
                        if (p1 - p0 > 1) {
                            let fr: i32 = fill_run(bits, stride, fmt, p0 + 1, row, p1 - p0 - 1, color);
                        }
                    }
                }
            }
        }
        row = row + 1;
    }
    return 0;
}

// 单字形旋转 + 缩放 blit：把 48 px 元字形位图（bm，bw×bh）按
// (cw×ch) 目标尺寸、绕 (cxp, cyp) 旋转后画出。目标矩形左上角为
// (gx, gy)（未旋转时），旋转角 angle 的 cos/sin 由调用方算好传入。
// 采样用逆旋转 + 2×2 超采样（每像素 4 个子采样点取平均），45° 下
// 锯齿肉眼不可见；覆盖率与文字 alpha 相乘后按像素混合。
fn draw_glyph_rot(bits: ptr, stride: i32, fmt: i32, bm: ptr, bw: i32, bh: i32,
                  gx: i32, gy: i32, cw: i32, ch: i32, cxp: i32, cyp: i32,
                  co: i32, si: i32, color: i32,
                  cl: i32, ct: i32, cr: i32, cb: i32) : i32 {
    let ca: i32 = (color >> 24) & 255;
    if (ca <= 0) { return 0; }
    if (bw <= 0 || bh <= 0 || cw <= 0 || ch <= 0) { return 0; }
    let r: i32 = (color >> 16) & 255;
    let g: i32 = (color >> 8) & 255;
    let b: i32 = color & 255;
    // 四个角相对旋转中心，1/16 px；正向旋转求包围盒。
    let cxs: i32[4] = 0;
    let cys: i32[4] = 0;
    cxs[0] = (gx - cxp) * 16; cys[0] = (gy - cyp) * 16;
    cxs[1] = (gx + cw - cxp) * 16; cys[1] = (gy - cyp) * 16;
    cxs[2] = (gx - cxp) * 16; cys[2] = (gy + ch - cyp) * 16;
    cxs[3] = (gx + cw - cxp) * 16; cys[3] = (gy + ch - cyp) * 16;
    let minx: i32 = 0;
    let maxx: i32 = 0;
    let miny: i32 = 0;
    let maxy: i32 = 0;
    let k: i32 = 0;
    while (k < 4) {
        let lx: i32 = cxs[k];
        let ly: i32 = cys[k];
        let px16: i32 = i32((i64(co) * i64(lx) - i64(si) * i64(ly)) / 65536) + cxp * 16;
        let py16: i32 = i32((i64(si) * i64(lx) + i64(co) * i64(ly)) / 65536) + cyp * 16;
        if (k == 0) {
            minx = px16; maxx = px16; miny = py16; maxy = py16;
        } else {
            if (px16 < minx) { minx = px16; }
            if (px16 > maxx) { maxx = px16; }
            if (py16 < miny) { miny = py16; }
            if (py16 > maxy) { maxy = py16; }
        }
        k = k + 1;
    }
    let x0: i32 = minx / 16;
    let x1: i32 = maxx / 16;
    let y0: i32 = miny / 16;
    let y1: i32 = maxy / 16;
    if (x0 < 0) { x0 = 0; }
    if (y0 < 0) { y0 = 0; }
    if (x1 >= g_aui_fb_w) { x1 = g_aui_fb_w - 1; }
    if (y1 >= g_aui_fb_h) { y1 = g_aui_fb_h - 1; }
    if (x0 < cl) { x0 = cl; }
    if (y0 < ct) { y0 = ct; }
    if (x1 >= cr) { x1 = cr - 1; }
    if (y1 >= cb) { y1 = cb - 1; }
    if (x1 < x0 || y1 < y0) { return 0; }
    // 源位图采样步长（Q16.16）：目标 1 px 对应 bw/cw 个源像素。
    let stepx: i32 = (bw << 16) / cw;
    let stepy: i32 = (bh << 16) / ch;
    let yy: i32 = y0;
    while (yy <= y1) {
        let rowbpp: i32 = 4;
        if (fmt == 4) { rowbpp = 2; }
        let grow: ptr = fb_row_ptr(bits, stride, rowbpp, yy);
        let xx: i32 = x0;
        while (xx <= x1) {
            // 2×2 超采样：目标像素中心 ±1/4 px 的 4 个点。
            let cov_sum: i32 = 0;
            let s: i32 = 0;
            while (s < 4) {
                let ox: i32 = 0;
                let oy: i32 = 0;
                if (s == 0) { ox = -4; oy = -4; }
                else if (s == 1) { ox = 4; oy = -4; }
                else if (s == 2) { ox = -4; oy = 4; }
                else { ox = 4; oy = 4; }
                // 子采样点（1/16 px）逆旋转回未旋转的 run 坐标。
                let dx16: i32 = (xx - cxp) * 16 + ox;
                let dy16: i32 = (yy - cyp) * 16 + oy;
                let rx16: i32 = i32((i64(co) * i64(dx16) + i64(si) * i64(dy16)) / 65536);
                let ry16: i32 = i32((i64(0 - si) * i64(dx16) + i64(co) * i64(dy16)) / 65536);
                // 局部 cell 坐标（1/16 px）→ 源位图坐标（Q16.16）。
                let lx16: i32 = rx16 - (gx - cxp) * 16;
                let ly16: i32 = ry16 - (gy - cyp) * 16;
                let sxq: i32 = i32(i64(lx16) * i64(stepx) / 16);
                let syq: i32 = i32(i64(ly16) * i64(stepy) / 16);
                let sxi: i32 = sxq / 65536;
                let syi: i32 = syq / 65536;
                if (sxi >= 0 && sxi < bw && syi >= 0 && syi < bh) {
                    cov_sum = cov_sum + load_u8(bm + syi * bw + sxi);
                }
                s = s + 1;
            }
            let cov: i32 = cov_sum / 4;
            if (cov > 0) {
                let a: i32 = (cov * ca + 127) / 255;
                if (fmt == 4) {
                    let q4: i32 = blend_px(grow, xx * 2, r, g, b, a, 4);
                } else {
                    let q8: i32 = blend_px(grow, xx * 4, r, g, b, a, 1);
                }
            }
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    return 0;
}

// 定尺寸旋转文本行：整行以 (cx, cy)（Q16.16 px）为中心、按 angle
// 整度角旋转绘制；字高 size_px（设备像素，em 高）。字形一律取 48 px
// 元位图（aui_rt_glyph，与正常文本同一份字形缓存，不新增缓存压力），
// 在 blit 里缩放到目标尺寸；回退字体（ASCII/CJK 图集）同路。
// angle=0 时即“定尺寸文本”，面板的 9/10/14/18 dp 文字都走这里。
fn draw_text_run_sz_rot(bits: ptr, stride: i32, fmt: i32, cx: i32, cy: i32,
                        s: ptr, tlen: i32, color: i32, size_px: i32,
                        angle_deg: i32,
                        cl: i32, ct: i32, cr: i32, cb: i32) : i32 {
    if (s == 0 || tlen <= 0 || size_px <= 0) { return 0; }
    let ca: i32 = (color >> 24) & 255;
    if (ca <= 0) { return 0; }
    // 先量行宽（48 px em 下的总 advance），不光栅化。
    let tot48: i32 = 0;
    let i: i32 = 0;
    while (i < tlen) {
        let cp: i32 = utf8_next(s, i, tlen);
        let advb: i32 = g_aui_utf8_adv;
        tot48 = tot48 + aui_rt_advance(cp);
        i = i + advb;
    }
    if (tot48 <= 0) { return 0; }
    let totw: i32 = tot48 * size_px / 48;
    let cxp: i32 = fx_px(cx);
    let cyp: i32 = fx_px(cy);
    let cs: i32[2] = 0;
    let r0: i32 = rot_sin_cos(angle_deg, cs);
    let co: i32 = cs[0];
    let si: i32 = cs[1];
    let x0: i32 = cxp - totw / 2;
    let y0: i32 = cyp - size_px / 2;
    let pen48: i32 = 0;
    i = 0;
    while (i < tlen) {
        let cp: i32 = utf8_next(s, i, tlen);
        let advb: i32 = g_aui_utf8_adv;
        let adv48: i32 = aui_rt_advance(cp);
        let ok: i32 = aui_rt_glyph(cp);
        if (ok == 1) {
            let bm: ptr = aui_rt_bm();
            let bw: i32 = aui_rt_bw();
            let bh: i32 = aui_rt_bh();
            let gx: i32 = x0 + pen48 * size_px / 48;
            let gy: i32 = y0;
            let cw: i32 = bw * size_px / 48;
            let ch: i32 = bh * size_px / 48;
            if (cw < 1) { cw = 1; }
            if (ch < 1) { ch = 1; }
            let r1: i32 = draw_glyph_rot(bits, stride, fmt, bm, bw, bh,
                                         gx, gy, cw, ch, cxp, cyp,
                                         co, si, color, cl, ct, cr, cb);
        }
        pen48 = pen48 + adv48;
        i = i + advb;
    }
    return 0;
}

fn fill_rect(bits: ptr, stride: i32, fmt: i32, sx: i32, sy: i32,
             sw: i32, sh: i32, color: i32, radius: i32,
             cl: i32, ct: i32, cr: i32, cb: i32) : i32 {
    // 绘制列表里是 Q16.16，光栅器按像素工作，统一在这里换算。
    let x0: i32 = fx_px(sx);
    let y0: i32 = fx_px(sy);
    let x1: i32 = fx_px(sx + sw);
    let y1: i32 = fx_px(sy + sh);
    if (x1 <= x0 || y1 <= y0) { return 0; }
    // 圆角必须按未裁剪的原始矩形计算，否则被滚出视口的行会在切口处
    // 重新长出圆角。
    let top: i32 = y0;
    let bot: i32 = y1;
    let r: i32 = fx_px(radius);
    if (r > (x1 - x0) / 2) { r = (x1 - x0) / 2; }
    if (r > (y1 - y0) / 2) { r = (y1 - y0) / 2; }
    if (x0 < 0) { x0 = 0; }
    if (y0 < 0) { y0 = 0; }
    if (x1 > g_aui_fb_w) { x1 = g_aui_fb_w; }
    if (y1 > g_aui_fb_h) { y1 = g_aui_fb_h; }
    if (x0 < cl) { x0 = cl; }
    if (y0 < ct) { y0 = ct; }
    if (x1 > cr) { x1 = cr; }
    if (y1 > cb) { y1 = cb; }
    if (x1 <= x0 || y1 <= y0) { return 0; }
    let r16: i32 = r * 16;
    let cx: i32 = x0 + r;
    let cxr: i32 = x1 - r;
    let row: i32 = y0;
    while (row < y1) {
        // v1.23：圆角带里的行按“像素中心到圆心的距离”求左右边界，
        // 边界两侧各 1 个像素按覆盖率混合；中间仍是整行填充。
        let band: i32 = 0;
        if (r > 0 && row < top + r) { band = 1; }
        else if (r > 0 && row >= bot - r) { band = 2; }
        if (band == 0) {
            let w0: i32 = fill_run(bits, stride, fmt, x0, row, x1 - x0, color);
            row = row + 1;
        } else {
            let cy: i32 = top + r;
            if (band == 2) { cy = bot - r; }
            let dy16: i32 = row * 16 + 8 - cy * 16;
            let q: i32 = r16 * r16 - dy16 * dy16;
            if (q < 0) { q = 0; }
            let s: i32 = isqrt(q);
            let xb16: i32 = cx * 16 - s;
            let xr16: i32 = (x1 - r) * 16 + s;
            let pl: i32 = xb16 / 16;
            let pr: i32 = xr16 / 16;
            if (pr > pl) {
                let c0: i32 = pl + 1;
                let c1: i32 = pr;
                if (c0 < x0) { c0 = x0; }
                if (c1 > x1) { c1 = x1; }
                if (c1 > c0) {
                    let w1: i32 = fill_run(bits, stride, fmt, c0, row, c1 - c0, color);
                }
                if (pl >= x0 && pl < x1) {
                    let cv1: i32 = corner_cov(pl, row, cx, cy, r);
                    let b1: i32 = fill_px_cov(bits, stride, fmt, pl, row, color, cv1);
                }
                if (pr >= x0 && pr < x1) {
                    let cv2: i32 = corner_cov(pr, row, cxr, cy, r);
                    let b2: i32 = fill_px_cov(bits, stride, fmt, pr, row, color, cv2);
                }
            } else {
                // 水平方向被裁得很窄（或圆角比可见宽度还大）：整行填充。
                let w2: i32 = fill_run(bits, stride, fmt, x0, row, x1 - x0, color);
            }
            row = row + 1;
        }
    }
    return 0;
}

// v1.32.1：解析圆环/圆弧（op 4）。外半径 = sw/2，内半径 = rin，角度用
// 圈为单位（0 = 12 点，顺时针）。逐像素：
//   1. 半径方向：外边界覆盖率 × 内边界覆盖率（各 0.5 px 过渡）；
//   2. 角度方向：先判是否落在 [start, start+span] 内，再按到两端的角距离
//      换算成弧长像素做过渡——两端的过渡各 0.5 px，弧外侧 0.25 px 就归零；
//   3. 三者相乘后只混合一次。整圈（span = 65535）跳过角度计算。
// 这样圆头/圆环的外缘都是一次覆盖率混合，不会像圆点那样叠出波纹。
// v2.6.2：定点除法辅助（fill_ring / fill_half 扫描线用）。Aster 的 /
// 向零截断；这里要数学意义上的 floor/ceil（除数 16 恒正）。
fn floor_div16(a: i32) : i32 {
    if (a >= 0) { return a / 16; }
    return (a - 15) / 16;
}

fn ceil_div16(a: i32) : i32 {
    if (a >= 0) { return (a + 15) / 16; }
    return a / 16;
}

// v2.6.2：单个像素的径向覆盖率（0..255）。与旧逐像素循环的 co/ci
// 公式逐字相同：co = 128 + (ro16-d16)*16，ci = 128 + (d16-ri16)*16，
// cv0 = min(co,255) * min(ci,255) / 255。d16 仍是 isqrt（只对边缘
// 像素调用，内核像素走 fill_run）。
fn ring_px_radial(dx16: i32, dy2: i32, ro16: i32, ri16: i32) : i32 {
    let d16: i32 = isqrt(dx16 * dx16 + dy2);
    let co: i32 = 128 + (ro16 - d16) * 16;
    if (co <= 0) { return 0; }
    let ci: i32 = 128 + (d16 - ri16) * 16;
    if (ci <= 0) { return 0; }
    let con: i32 = 255;
    if (co < 255) { con = co; }
    let cin: i32 = 255;
    if (ci < 255) { cin = ci; }
    return con * cin / 255;
}

// v2.6.2：单个像素的角度覆盖率（0..255）。a = time_angle(dx16, dy16)。
// 实线弧（period == 0）：sg = 到最近一个端点的有符号角距离（正 =
// 弧内）；虚线环：sg = 到最近一条虚线边界的距离。|sg| < lim（5.6°）
// 内按弧长做 0.25 px 端部过渡（ca = 128 + ap16*32），与旧公式一致。
fn arc_cov(dx16: i32, dy16: i32, st: i32, sp: i32, dash: i32, period: i32,
           lim: i32, c16: i32, T: i32) : i32 {
    let a: i32 = time_angle(dx16, dy16);
    let rel: i32 = a - st;
    if (rel < 0) { rel = rel + T; }
    let sg: i32 = 0;
    if (period == 0) {
        if (rel <= sp) {
            let de: i32 = sp - rel;
            sg = rel;
            if (de < sg) { sg = de; }
        } else {
            let d1: i32 = rel - sp;
            let d2: i32 = T - rel;
            sg = 0 - d1;
            if (d2 < d1) { sg = 0 - d2; }
        }
    } else {
        if (rel >= sp) { return 0; }
        let ph: i32 = rel % period;
        if (ph < dash) {
            sg = ph;
            let de: i32 = dash - ph;
            if (de < sg) { sg = de; }
        } else {
            let d1: i32 = ph - dash;
            let d2: i32 = period - ph;
            sg = 0 - d1;
            if (d2 < d1) { sg = 0 - d2; }
        }
    }
    if (sg <= 0 - lim) { return 0; }
    if (sg >= lim) { return 255; }
    let ap16: i32 = i32((i64(sg) * i64(c16)) / i64(T));
    let ca: i32 = 128 + ap16 * 32;
    if (ca < 0) { ca = 0; }
    if (ca > 255) { ca = 255; }
    return ca;
}

// v2.6.2：圆环扫描线的行边界（1/16 px 单位），d16 = isqrt(dx16²+dy2)。
// 着色 ⟺ co>0 ⟺ d16<=ro16+7；外缘全覆盖 ⟺ co>=255 ⟺ d16<=ro16-8；
// 内缘全覆盖 ⟺ ci>=255 ⟺ d16>=ri16+8；洞 ⟺ ci<=0 ⟺ d16<=ri16-8。
// isqrt(v)<=K ⟺ v<=(K+1)²-1，isqrt(v)>=K ⟺ v>=K²，由此换算（K<0 时
// 无解：ro16<8 无外缘全覆盖，ri16<8 无洞）。
// out[0]=dxp（着色外 bound，-1 表示本行无着色像素），out[1]=dxo
// （全覆盖外 bound，-1 表示无），out[2]=din（全覆盖内 bound，0
// 表示整行都在内半径外），out[3]=dxh（洞 bound，-1 表示无洞）。
// 返回 0 = 本行无着色像素，1 = 有。
fn ring_row_bounds(dy2: i32, ro16: i32, ri16: i32, out: ptr) : i32 {
    let p: i32 = (ro16 + 8) * (ro16 + 8) - 1 - dy2;
    if (p < 0) { return 0; }
    let dxp: i32 = isqrt(p);
    let dxo: i32 = -1;
    if (ro16 >= 8) {
        let o: i32 = (ro16 - 7) * (ro16 - 7) - 1 - dy2;
        if (o >= 0) { dxo = isqrt(o); }
    }
    let din: i32 = 0;
    let ii: i32 = (ri16 + 8) * (ri16 + 8) - dy2;
    if (ii > 0) {
        din = isqrt(ii);
        if (din * din < ii) { din = din + 1; }
    }
    let dxh: i32 = -1;
    if (ri16 >= 8) {
        let hh: i32 = (ri16 - 7) * (ri16 - 7) - 1 - dy2;
        if (hh >= 0) { dxh = isqrt(hh); }
    }
    *(out + 0) = dxp;
    *(out + 4) = dxo;
    *(out + 8) = din;
    *(out + 12) = dxh;
    return 1;
}

// v2.6.2：一段列的精确径向公式（扫描线的边缘部分）。与旧逐像素
// 循环逐像素等价；c1 < c0 时不画。
fn ring_edge(bits: ptr, stride: i32, fmt: i32, c0: i32, c1: i32, row: i32,
             cx16: i32, dy2: i32, ro16: i32, ri16: i32, color: i32) : i32 {
    if (c1 < c0) { return 0; }
    let col: i32 = c0;
    while (col <= c1) {
        let dx16: i32 = col * 16 + 8 - cx16;
        let cv0: i32 = ring_px_radial(dx16, dy2, ro16, ri16);
        if (cv0 > 0) {
            let w0: i32 = fill_px_cov(bits, stride, fmt, col, row, color, cv0);
        }
        col = col + 1;
    }
    return 0;
}

fn fill_ring(bits: ptr, stride: i32, fmt: i32, sx: i32, sy: i32, sw: i32,
             color: i32, rin: i32, start: i32, span: i32, dash: i32, period: i32,
             cl: i32, ct: i32, cr: i32, cb: i32) : i32 {
    let x0: i32 = fx_px(sx);
    let y0: i32 = fx_px(sy);
    let x1: i32 = fx_px(sx + sw);
    let y1: i32 = fx_px(sy + sw);
    if (x1 <= x0 || y1 <= y0) { return 0; }
    let cx16: i32 = (sx + sw / 2) / 4096;
    let cy16: i32 = (sy + sw / 2) / 4096;
    let ro16: i32 = (sw / 2) / 4096;
    let ri16: i32 = rin / 4096;
    if (ri16 < 0) { ri16 = 0; }
    if (x0 < 0) { x0 = 0; }
    if (y0 < 0) { y0 = 0; }
    if (x1 > g_aui_fb_w) { x1 = g_aui_fb_w; }
    if (y1 > g_aui_fb_h) { y1 = g_aui_fb_h; }
    if (x0 < cl) { x0 = cl; }
    if (y0 < ct) { y0 = ct; }
    if (x1 > cr) { x1 = cr; }
    if (y1 > cb) { y1 = cb; }
    if (x1 <= x0 || y1 <= y0) { return 0; }
    // v2.6.2：start/span/dash/period 均为 Q16.16 圈（0 = 12 点，顺时针）。
    // 整圈且非虚线时跳过角度测试；虚线环的 span 恒为整圈。
    let full: i32 = 0;
    if (span >= 65535 && dash == 0) { full = 1; }
    let T: i32 = 3932160;                 // time_angle 的满圈单位（60 × 65536）
    let st: i32 = (start & 65535) * 60;
    let sp: i32 = span * 60;
    if (sp > T) { sp = T; }
    let dsh: i32 = dash * 60;
    let prd: i32 = period * 60;
    let lim: i32 = T / 64;                // 超过 5.6° 就不必再算端部过渡
    let c16: i32 = 0;
    if (full == 0) {
        time_tab_init();
        c16 = i32((i64(ro16) * 6283) / 1000);   // 周长，单位 1/16 px
    }
    let row: i32 = y0;
    while (row < y1) {
        let dy16: i32 = row * 16 + 8 - cy16;
        let dy2: i32 = dy16 * dy16;
        let bd: i32[4] = 0;
        if (ring_row_bounds(dy2, ro16, ri16, bd) == 0) { row = row + 1; continue; }
        let dxp: i32 = bd[0];
        let dxo: i32 = bd[1];
        let din: i32 = bd[2];
        let dxh: i32 = bd[3];
        let plo: i32 = ceil_div16(cx16 - dxp - 8);
        let phi: i32 = floor_div16(cx16 + dxp - 8);
        if (plo < x0) { plo = x0; }
        if (phi > x1) { phi = x1; }
        if (phi < plo) { row = row + 1; continue; }
        // 径向全覆盖区间（cv0=255）：|dx16| ∈ [din, dxo]。实心圆盘
        // （din==0）一段；圆环两段（中间是洞的过渡带，走精确公式）。
        // 圆盘中心 0.5 px 内 ci<255（单像素 dimple），仍走精确公式，
        // 与旧逐像素路径一致。
        let ilo: i32 = 0;
        let ihi: i32 = -1;
        let ilo2: i32 = 0;
        let ihi2: i32 = -1;
        if (dxo >= 0 && din <= dxo) {
            if (din == 0) {
                ilo = ceil_div16(cx16 - dxo - 8);
                ihi = floor_div16(cx16 + dxo - 8);
            } else {
                ilo = ceil_div16(cx16 - dxo - 8);
                ihi = floor_div16(cx16 - din - 8);
                ilo2 = ceil_div16(cx16 + din - 8);
                ihi2 = floor_div16(cx16 + dxo - 8);
            }
            if (ilo < plo) { ilo = plo; }
            if (ihi > phi) { ihi = phi; }
            if (ilo2 < plo) { ilo2 = plo; }
            if (ihi2 > phi) { ihi2 = phi; }
        }
        if (full != 0) {
            // 整圈：边缘走精确公式，内核走 fill_run（与逐像素
            // fill_px_cov(255) 逐像素等价：不透明时同值写入，半透明
            // 时同 blend_px）。
            if (ilo > ihi && ilo2 > ihi2) {
                let e0: i32 = ring_edge(bits, stride, fmt, plo, phi, row, cx16, dy2, ro16, ri16, color);
            } else if (din == 0) {
                let e1: i32 = ring_edge(bits, stride, fmt, plo, ilo - 1, row, cx16, dy2, ro16, ri16, color);
                let f0: i32 = fill_run(bits, stride, fmt, ilo, row, ihi - ilo + 1, color);
                let e2: i32 = ring_edge(bits, stride, fmt, ihi + 1, phi, row, cx16, dy2, ro16, ri16, color);
            } else {
                // 圆环：左缘 + 左核 + 中缘 + 右核 + 右缘。中缘是洞的
                // 过渡带：洞本身 [hlo,hhi]（公式本就返回 0）直接跳过，
                // 不逐像素走；没有洞像素的行（dxh<0）中缘即整段。
                let e3: i32 = ring_edge(bits, stride, fmt, plo, ilo - 1, row, cx16, dy2, ro16, ri16, color);
                let f1: i32 = fill_run(bits, stride, fmt, ilo, row, ihi - ilo + 1, color);
                if (dxh >= 0) {
                    let hlo: i32 = ceil_div16(cx16 - dxh - 8);
                    let hhi: i32 = floor_div16(cx16 + dxh - 8);
                    if (hlo < ihi + 1) { hlo = ihi + 1; }
                    if (hhi > ilo2 - 1) { hhi = ilo2 - 1; }
                    let e4a: i32 = ring_edge(bits, stride, fmt, ihi + 1, hlo - 1, row, cx16, dy2, ro16, ri16, color);
                    let e4b: i32 = ring_edge(bits, stride, fmt, hhi + 1, ilo2 - 1, row, cx16, dy2, ro16, ri16, color);
                } else {
                    let e4: i32 = ring_edge(bits, stride, fmt, ihi + 1, ilo2 - 1, row, cx16, dy2, ro16, ri16, color);
                }
                let f2: i32 = fill_run(bits, stride, fmt, ilo2, row, ihi2 - ilo2 + 1, color);
                let e5: i32 = ring_edge(bits, stride, fmt, ihi2 + 1, phi, row, cx16, dy2, ro16, ri16, color);
            }
        } else {
            // 弧 / 虚线环：只扫环带（[plo,phi] 去掉洞），带内像素先算
            // 角度覆盖（无 isqrt），为 0 直接跳过；径向全覆盖的像素
            // cv0=255，其余用精确公式。虚线环的大部分带内像素落在
            // 间隙里，角度测试一过就跳过，不碰 isqrt。
            let hlo: i32 = 0;
            let hhi: i32 = -1;
            if (dxh >= 0) {
                hlo = ceil_div16(cx16 - dxh - 8);
                hhi = floor_div16(cx16 + dxh - 8);
                if (hlo < plo) { hlo = plo; }
                if (hhi > phi) { hhi = phi; }
            }
            let s: i32 = 0;
            while (s < 2) {
                let b0: i32 = plo;
                let b1: i32 = phi;
                if (dxh >= 0) {
                    if (s == 0) { b1 = hlo - 1; }
                    else { b0 = hhi + 1; }
                } else {
                    if (s == 1) { s = 2; continue; }
                }
                let col: i32 = b0;
                while (col <= b1) {
                    let dx16: i32 = col * 16 + 8 - cx16;
                    let ac: i32 = arc_cov(dx16, dy16, st, sp, dsh, prd, lim, c16, T);
                    if (ac > 0) {
                        let in_iv: i32 = 0;
                        if (col >= ilo && col <= ihi) { in_iv = 1; }
                        if (col >= ilo2 && col <= ihi2) { in_iv = 1; }
                        if (in_iv != 0) {
                            let w0: i32 = fill_px_cov(bits, stride, fmt, col, row, color, ac);
                        } else {
                            let cv0: i32 = ring_px_radial(dx16, dy2, ro16, ri16);
                            if (cv0 > 0) {
                                let cv: i32 = cv0 * ac / 255;
                                if (cv > 0) {
                                    let w1: i32 = fill_px_cov(bits, stride, fmt, col, row, color, cv);
                                }
                            }
                        }
                    }
                    col = col + 1;
                }
                s = s + 1;
            }
        }
        row = row + 1;
    }
    return 0;
}

// v2.6.2：半圆填充（op 7）。圆盘 + 半平面：直径边按像素中心取整
// （无抗锯齿，与直边的处理一致，直径边含在内）；圆弧边沿用与
// fill_ring 相同的径向 AA（扫描线 + 精确公式，像素等价）。
// dir: 0 左 (dx16<=0) / 1 右 (dx16>=0) / 2 上 (dy16<=0) / 3 下 (dy16>=0)。
fn fill_half(bits: ptr, stride: i32, fmt: i32, sx: i32, sy: i32, sw: i32,
             color: i32, dir: i32, cl: i32, ct: i32, cr: i32, cb: i32) : i32 {
    let x0: i32 = fx_px(sx);
    let y0: i32 = fx_px(sy);
    let x1: i32 = fx_px(sx + sw);
    let y1: i32 = fx_px(sy + sw);
    if (x1 <= x0 || y1 <= y0) { return 0; }
    let cx16: i32 = (sx + sw / 2) / 4096;
    let cy16: i32 = (sy + sw / 2) / 4096;
    let ro16: i32 = (sw / 2) / 4096;
    if (x0 < 0) { x0 = 0; }
    if (y0 < 0) { y0 = 0; }
    if (x1 > g_aui_fb_w) { x1 = g_aui_fb_w; }
    if (y1 > g_aui_fb_h) { y1 = g_aui_fb_h; }
    if (x0 < cl) { x0 = cl; }
    if (y0 < ct) { y0 = ct; }
    if (x1 > cr) { x1 = cr; }
    if (y1 > cb) { y1 = cb; }
    if (x1 <= x0 || y1 <= y0) { return 0; }
    // 上/下半圆：直接收窄行范围（直径边含在内）。
    if (dir == 2) {
        let rmax: i32 = floor_div16(cy16 - 8);
        if (rmax < y1 - 1) { y1 = rmax + 1; }
    }
    if (dir == 3) {
        let rmin: i32 = ceil_div16(cy16 - 8);
        if (rmin > y0) { y0 = rmin; }
    }
    if (y1 <= y0) { return 0; }
    let row: i32 = y0;
    while (row < y1) {
        let dy16: i32 = row * 16 + 8 - cy16;
        let dy2: i32 = dy16 * dy16;
        let bd: i32[4] = 0;
        if (ring_row_bounds(dy2, ro16, 0, bd) == 0) { row = row + 1; continue; }
        let dxp: i32 = bd[0];
        let dxo: i32 = bd[1];
        let din: i32 = bd[2];
        let plo: i32 = ceil_div16(cx16 - dxp - 8);
        let phi: i32 = floor_div16(cx16 + dxp - 8);
        // 左/右半圆：收窄列范围（直径边含在内）。
        if (dir == 0) {
            let ph2: i32 = floor_div16(cx16 - 8);
            if (ph2 < phi) { phi = ph2; }
        }
        if (dir == 1) {
            let pl2: i32 = ceil_div16(cx16 - 8);
            if (pl2 > plo) { plo = pl2; }
        }
        if (plo < x0) { plo = x0; }
        if (phi > x1) { phi = x1; }
        if (phi < plo) { row = row + 1; continue; }
        let ilo: i32 = 0;
        let ihi: i32 = -1;
        let ilo2: i32 = 0;
        let ihi2: i32 = -1;
        if (dxo >= 0 && din <= dxo) {
            if (din == 0) {
                ilo = ceil_div16(cx16 - dxo - 8);
                ihi = floor_div16(cx16 + dxo - 8);
            } else {
                ilo = ceil_div16(cx16 - dxo - 8);
                ihi = floor_div16(cx16 - din - 8);
                ilo2 = ceil_div16(cx16 + din - 8);
                ihi2 = floor_div16(cx16 + dxo - 8);
            }
            if (ilo < plo) { ilo = plo; }
            if (ihi > phi) { ihi = phi; }
            if (ilo2 < plo) { ilo2 = plo; }
            if (ihi2 > phi) { ihi2 = phi; }
        }
        if (ilo > ihi && ilo2 > ihi2) {
            let e0: i32 = ring_edge(bits, stride, fmt, plo, phi, row, cx16, dy2, ro16, 0, color);
        } else if (din == 0) {
            let e1: i32 = ring_edge(bits, stride, fmt, plo, ilo - 1, row, cx16, dy2, ro16, 0, color);
            let f0: i32 = fill_run(bits, stride, fmt, ilo, row, ihi - ilo + 1, color);
            let e2: i32 = ring_edge(bits, stride, fmt, ihi + 1, phi, row, cx16, dy2, ro16, 0, color);
        } else {
            let e3: i32 = ring_edge(bits, stride, fmt, plo, ilo - 1, row, cx16, dy2, ro16, 0, color);
            let f1: i32 = fill_run(bits, stride, fmt, ilo, row, ihi - ilo + 1, color);
            let e4: i32 = ring_edge(bits, stride, fmt, ihi + 1, ilo2 - 1, row, cx16, dy2, ro16, 0, color);
            let f2: i32 = fill_run(bits, stride, fmt, ilo2, row, ihi2 - ilo2 + 1, color);
            let e5: i32 = ring_edge(bits, stride, fmt, ihi2 + 1, phi, row, cx16, dy2, ro16, 0, color);
        }
        row = row + 1;
    }
    return 0;
}

// v1.33：直角三角形/等腰三角形的覆盖率填充（op 5）。dir = 0 右指：
// 底边贴左边、顶点在右边中线上；dir = 1 下指：底边贴上边、顶点在
// 下边中线上。每个像素取斜边到像素左界的 1/16 px 距离做 0..1 的覆盖率，
// 直边仍是整像素，不需要过渡。
fn fill_tri(bits: ptr, stride: i32, fmt: i32, sx: i32, sy: i32, sw: i32, sh: i32,
            color: i32, dir: i32,
            cl: i32, ct: i32, cr: i32, cb: i32) : i32 {
    let x0: i32 = fx_px(sx);
    let y0: i32 = fx_px(sy);
    let x1: i32 = fx_px(sx + sw);
    let y1: i32 = fx_px(sy + sh);
    if (x1 <= x0 || y1 <= y0) { return 0; }
    if (x0 < 0) { x0 = 0; }
    if (y0 < 0) { y0 = 0; }
    if (x1 > g_aui_fb_w) { x1 = g_aui_fb_w; }
    if (y1 > g_aui_fb_h) { y1 = g_aui_fb_h; }
    if (x0 < cl) { x0 = cl; }
    if (y0 < ct) { y0 = ct; }
    if (x1 > cr) { x1 = cr; }
    if (y1 > cb) { y1 = cb; }
    if (x1 <= x0 || y1 <= y0) { return 0; }
    let w16: i32 = (x1 - x0) * 16;
    let h16: i32 = (y1 - y0) * 16;
    let cx16: i32 = x0 * 16 + w16 / 2;
    let cy16: i32 = y0 * 16 + h16 / 2;
    let row: i32 = y0;
    while (row < y1) {
        // 每行先把斜边位置算好，再逐像素求覆盖率。
        let edge16: i32 = 0;
        let left16: i32 = 0;
        let right16: i32 = 0;
        if (dir == 0) {
            let d16: i32 = row * 16 + 8 - cy16;
            let ad: i32 = d16;
            if (ad < 0) { ad = 0 - ad; }
            edge16 = x0 * 16 + w16 - (ad * w16) / (h16 / 2);
        } else {
            let d16: i32 = row * 16 + 8 - y0 * 16;
            let ad: i32 = d16;
            if (ad < 0) { ad = 0 - ad; }
            let hw: i32 = (w16 / 2) - (ad * (w16 / 2)) / h16;
            left16 = cx16 - hw;
            right16 = cx16 + hw;
        }
        let col: i32 = x0;
        while (col < x1) {
            let cv: i32 = 0;
            if (dir == 0) {
                let r16: i32 = edge16 - col * 16;
                cv = r16 * 16;
            } else {
                let r16: i32 = right16 - col * 16;
                let l16: i32 = col * 16 + 16 - left16;
                cv = r16;
                if (l16 < cv) { cv = l16; }
                cv = cv * 16;
            }
            if (cv < 0) { cv = 0; }
            if (cv > 255) { cv = 255; }
            if (cv > 0) {
                let w0: i32 = fill_px_cov(bits, stride, fmt, col, row, color, cv);
            }
            col = col + 1;
        }
        row = row + 1;
    }
    return 0;
}

// v1.44：8bpp（覆盖度）字形。每行 w 字节，逐像素把覆盖度当作 alpha 与
// 文字颜色相乘后混合，得到和系统 UI 字体相当的抗锯齿边缘；1bpp 老图集
// 仍走 draw_glyph 的按位展开路径。
fn draw_glyph_aa(bits: ptr, stride: i32, fmt: i32, pen: i32, top: i32,
                 f: ptr, base: i32, bw: i32, bh: i32, xo: i32, yo: i32,
                 sc: i32, color: i32, cl: i32, ct: i32, cr: i32, cb: i32) : i32 {
    let r: i32 = (color >> 16) & 255;
    let g: i32 = (color >> 8) & 255;
    let b: i32 = color & 255;
    let ca: i32 = (color >> 24) & 255;
    if (ca <= 0) { return 0; }
    // v2.7.3：字形盒与裁剪框无交时直接返回。之前即使字形完全在带外，
    // 也要跑完 bh×bw 的整字形循环（逐像素才测裁剪），直搬每帧 4 次
    // 重放 ×124 条文本命令全是这种浪费。
    let gx0: i32 = pen + xo * sc;
    let gy0: i32 = top + yo * sc;
    let gx1: i32 = gx0 + bw * sc;
    let gy1: i32 = gy0 + bh * sc;
    if (gx1 <= cl || gx0 >= cr || gy1 <= ct || gy0 >= cb) { return 0; }
    let yy: i32 = 0;
    while (yy < bh) {
        let rowp: i32 = base + yy * bw;
        let xx: i32 = 0;
        while (xx < bw) {
            let cov: i32 = load_u8(f + rowp + xx);
            if (cov > 0) {
                let a: i32 = (cov * ca + 127) / 255;
                let sy: i32 = 0;
                while (sy < sc) {
                    let py: i32 = top + (yo + yy) * sc + sy;
                    // v2.7.1：行首一次算好（分块帧缓冲），行内再加 px*bpp。
                    let gbpp: i32 = 4;
                    if (fmt == 4) { gbpp = 2; }
                    let grow: ptr = fb_row_ptr(bits, stride, gbpp, py);
                    let sx: i32 = 0;
                    while (sx < sc) {
                        let px: i32 = pen + (xo + xx) * sc + sx;
                        if (px >= cl && py >= ct && px < cr && py < cb &&
                            px >= 0 && py >= 0 && px < g_aui_fb_w && py < g_aui_fb_h) {
                            if (fmt == 4) {
                                let q4: i32 = blend_px(grow, px * 2, r, g, b, a, 4);
                            } else {
                                let q8: i32 = blend_px(grow, px * 4, r, g, b, a, 1);
                            }
                        }
                        sx = sx + 1;
                    }
                    sy = sy + 1;
                }
            }
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    return 0;
}

fn draw_glyph(bits: ptr, stride: i32, fmt: i32, pen: i32, top: i32,
              f: ptr, goff: i32, sc: i32,
              color: i32, cl: i32, ct: i32, cr: i32, cb: i32) : i32 {
    let bw: i32 = load_u8(f + goff + 5);
    let bh: i32 = load_u8(f + goff + 6);
    let xo: i32 = load_u8(f + goff + 7);
    let yo: i32 = load_u8(f + goff + 8);
    if (xo > 127) { xo = xo - 256; }
    if (yo > 127) { yo = yo - 256; }
    let boff: i32 = *(f + goff + 12);
    let base: i32 = font_at_u32(f, 20) + boff;
    // 字形级 flags bit0 与文件头一致：1 = 8bpp 覆盖度，0 = 1bpp。
    let gfl: i32 = load_u8(f + goff + 9);
    if ((gfl & 1) != 0 && bw > 0 && bh > 0) {
        return draw_glyph_aa(bits, stride, fmt, pen, top, f, base,
                             bw, bh, xo, yo, sc, color, cl, ct, cr, cb);
    }
    // 每行字节数由字宽决定：ceil(w/8)，1bpp，最高位是最左像素。
    // v1.19：不再假设 1..3 字节。48px 字体一行 6 字节，超过 i32 的
    // 移位范围，所以按字节取位（一行最多 6 次装载，代价可以忽略）。
    // xoff/yoff 是相对笔位与行顶的有符号偏移，供比例字体使用。
    let rb: i32 = (bw + 7) / 8;
    let r: i32 = (color >> 16) & 255;
    let g: i32 = (color >> 8) & 255;
    let b: i32 = color & 255;
    let ca: i32 = (color >> 24) & 255;
    if (ca <= 0) { return 0; }
    // v2.7.3：与 draw_glyph_aa 同款字形盒早退（见上）。
    let gx0: i32 = pen + xo * sc;
    let gy0: i32 = top + yo * sc;
    let gx1: i32 = gx0 + bw * sc;
    let gy1: i32 = gy0 + bh * sc;
    if (gx1 <= cl || gx0 >= cr || gy1 <= ct || gy0 >= cb) { return 0; }
    let yy: i32 = 0;
    while (yy < bh) {
        let rowp: i32 = base + yy * rb;
        let xx: i32 = 0;
        // 每个字节装载一次，覆盖 8 个像素；48px 字一行 6 次装载。
        // 行是按小端整数写的：最左像素在行内最后一个字节的最高位，
        // 所以字节下标是 rb-1-(xx>>3)。
        while (xx < bw) {
            let bytev: i32 = load_u8(f + rowp + rb - 1 - (xx >> 3));
            let bi: i32 = 0;
            while (bi < 8 && xx < bw) {
                if (((bytev >> (7 - bi)) & 1) != 0) {
                    let sy: i32 = 0;
                    while (sy < sc) {
                        let py: i32 = top + (yo + yy) * sc + sy;
                        // v2.7.1：行首一次算好（分块帧缓冲），行内再加 px*bpp。
                        let gbpp: i32 = 4;
                        if (fmt == 4) { gbpp = 2; }
                        let grow: ptr = fb_row_ptr(bits, stride, gbpp, py);
                        let sx: i32 = 0;
                        while (sx < sc) {
                            let px: i32 = pen + (xo + xx) * sc + sx;
                            if (px >= cl && py >= ct && px < cr && py < cb &&
                                px >= 0 && py >= 0 && px < g_aui_fb_w && py < g_aui_fb_h) {
                                if (fmt == 4) {
                                    let q: i32 = blend_px(grow, px * 2, r, g, b, ca, 4);
                                } else {
                                    let q: i32 = blend_px(grow, px * 4, r, g, b, ca, 1);
                                }
                            }
                            sx = sx + 1;
                        }
                        sy = sy + 1;
                    }
                }
                bi = bi + 1;
                xx = xx + 1;
            }
        }
        yy = yy + 1;
    }
    return 0;
}

// W2: runtime-font draw loop. Per code point the adapter stages an
// 8bpp coverage bitmap (TrueType em box, or the hand-drawn fallback
// upscaled x3); it is blitted with the existing draw_glyph_aa, which
// reads coverage bytes from a base pointer -- passing the staged
// bitmap with base 0 reuses it unchanged. The pen advances by the
// adapter advance, so measure (glyph_advance) and draw agree exactly.
// A code point with no glyph anywhere advances and draws nothing
// (the reference's old missing-glyph behaviour); the miss is
// counted inside aui_rt_glyph. The bitmap pointer is only valid
// until the next aui_rt_glyph call, so each glyph is blitted
// before the next one is staged.
fn aui_rt_draw_text_run(bits: ptr, stride: i32, fmt: i32, x: i32, y: i32,
                        s: ptr, tlen: i32, color: i32,
                        cl: i32, ct: i32, cr: i32, cb: i32) : i32 {
    let i: i32 = 0;
    let pen: i32 = fx_px(x);
    let top: i32 = fx_px(y);
    let sc: i32 = g_aui_text_scale;
    while (i < tlen) {
        let cp: i32 = utf8_next(s, i, tlen);
        let advb: i32 = g_aui_utf8_adv;
        let ok: i32 = aui_rt_glyph(cp);
        if (ok == 1) {
            let bm: ptr = aui_rt_bm();
            let bw: i32 = aui_rt_bw();
            let bh: i32 = aui_rt_bh();
            let xo: i32 = aui_rt_xo();
            let yo: i32 = aui_rt_yo();
            let r: i32 = draw_glyph_aa(bits, stride, fmt, pen, top, bm, 0,
                                       bw, bh, xo, yo, sc,
                                       color, cl, ct, cr, cb);
            // v2.15：仿粗——同一字形再画一次，右移 1 设备 px（与顶栏
            // 标题的 top_bar_bold_off() 同一手法）。
            if (g_aui_text_bold != 0) {
                let r2: i32 = draw_glyph_aa(bits, stride, fmt, pen + 1, top, bm, 0,
                                           bw, bh, xo, yo, sc,
                                           color, cl, ct, cr, cb);
            }
        } else {
        }
        let adv: i32 = aui_rt_advance(cp);
        pen = pen + adv * sc;
        i = i + advb;
    }
    return 0;
}

fn draw_text_run(bits: ptr, stride: i32, fmt: i32, x: i32, y: i32,
                 s: ptr, tlen: i32, color: i32,
                 cl: i32, ct: i32, cr: i32, cb: i32) : i32 {
    // W2: runtime-font path. The AUF branch below is reference-only
    // (g_aui_rt_mode is always 1; no .auf blob exists to draw from).
    if (g_aui_rt_mode == 1) {
        return aui_rt_draw_text_run(bits, stride, fmt, x, y, s, tlen,
                                    color, cl, ct, cr, cb);
    } else {
    }
    if (g_aui_font == 0 && g_aui_font2 == 0) { return 0; }
    let i: i32 = 0;
    let pen: i32 = fx_px(x);
    let top: i32 = fx_px(y);
    while (i < tlen) {
        let cp: i32 = utf8_next(s, i, tlen);
        let advb: i32 = g_aui_utf8_adv;
        let f: ptr = g_aui_font;
        let sc: i32 = g_aui_text_scale;
        let goff: i32 = glyph_find_in(f, cp);
        if (goff < 0 && g_aui_font2 != 0) {
            f = g_aui_font2;
            sc = g_aui_text_scale2;
            goff = glyph_find_in(f, cp);
        }
        if (goff >= 0) {
            let r: i32 = draw_glyph(bits, stride, fmt, pen, top, f, goff, sc,
                                    color, cl, ct, cr, cb);
            pen = pen + load_u8(f + goff + 4) * sc;
        } else {
            pen = pen + 8 * g_aui_text_scale;
        }
        i = i + advb;
    }
    return 0;
}

fn draw_image(bits: ptr, stride: i32, fmt: i32, x: i32, y: i32,
              dw: i32, dh: i32, rgba: ptr, iw: i32, ih: i32, ca: i32,
              cl: i32, ct: i32, cr: i32, cb: i32) : i32 {
    if (rgba == 0 || ca <= 0) { return 0; }
    // Q16.16 → 像素，并夹到 framebuffer，避免异常尺寸导致长循环。
    let x0: i32 = fx_px(x);
    let y0: i32 = fx_px(y);
    let w: i32 = fx_px(dw);
    let h: i32 = fx_px(dh);
    if (iw <= 0 || ih <= 0 || w <= 0 || h <= 0) { return 0; }
    let cx0: i32 = x0;
    let cy0: i32 = y0;
    let cx1: i32 = x0 + w;
    let cy1: i32 = y0 + h;
    if (cx0 < 0) { cx0 = 0; }
    if (cy0 < 0) { cy0 = 0; }
    if (cx1 > g_aui_fb_w) { cx1 = g_aui_fb_w; }
    if (cy1 > g_aui_fb_h) { cy1 = g_aui_fb_h; }
    if (cx0 < cl) { cx0 = cl; }
    if (cy0 < ct) { cy0 = ct; }
    if (cx1 > cr) { cx1 = cr; }
    if (cy1 > cb) { cy1 = cb; }
    if (cx1 <= cx0 || cy1 <= cy0) { return 0; }
    let j: i32 = cy0;
    while (j < cy1) {
        let sy: i32 = (j - y0) * ih / h;
        // v2.7.1：行首一次算好（分块帧缓冲），行内再加 i*bpp。
        let ibpp: i32 = 4;
        if (fmt == 4) { ibpp = 2; }
        let irow: ptr = fb_row_ptr(bits, stride, ibpp, j);
        let i: i32 = cx0;
        while (i < cx1) {
            let sx: i32 = (i - x0) * iw / w;
            let so: i32 = (sy * iw + sx) * 4;
            let r: i32 = load_u8(rgba + so);
            let g: i32 = load_u8(rgba + so + 1);
            let b: i32 = load_u8(rgba + so + 2);
            let a: i32 = load_u8(rgba + so + 3);
            if (ca < 255) {
                a = (a * ca + 127) / 255;
            }
            if (fmt == 4) {
                let q: i32 = blend_px(irow, i * 2, r, g, b, a, 4);
            } else {
                let q: i32 = blend_px(irow, i * 4, r, g, b, a, 1);
            }
            i = i + 1;
        }
        j = j + 1;
    }
    return 0;
}

// v1.35：粗线段（op 6）。端点 (sx0,sy0)-(sx1,sy1)、半宽 half 都是 Q16.16。
// 逐像素求到线段的距离（投影夹在两端内，即圆帽），用距离平方在
// [r-0.5px, r+0.5px] 之间线性过渡，边缘 1 px 抗锯齿；不需要开方。
fn fill_seg(bits: ptr, stride: i32, fmt: i32,
            sx0: i32, sy0: i32, sx1: i32, sy1: i32,
            color: i32, half: i32,
            cl: i32, ct: i32, cr: i32, cb: i32) : i32 {
    let r: i32 = half;
    if (r <= 0) { return 0; }
    let pad: i32 = r + 65536;
    let bx0: i32 = sx0;
    let by0: i32 = sy0;
    let bx1: i32 = sx0;
    let by1: i32 = sy0;
    if (sx1 < bx0) { bx0 = sx1; }
    if (sx1 > bx1) { bx1 = sx1; }
    if (sy1 < by0) { by0 = sy1; }
    if (sy1 > by1) { by1 = sy1; }
    let x0: i32 = fx_px(bx0 - pad);
    let y0: i32 = fx_px(by0 - pad);
    let x1: i32 = fx_px(bx1 + pad);
    let y1: i32 = fx_px(by1 + pad);
    if (x1 <= x0 || y1 <= y0) { return 0; }
    if (x0 < 0) { x0 = 0; }
    if (y0 < 0) { y0 = 0; }
    if (x1 > g_aui_fb_w) { x1 = g_aui_fb_w; }
    if (y1 > g_aui_fb_h) { y1 = g_aui_fb_h; }
    if (x0 < cl) { x0 = cl; }
    if (y0 < ct) { y0 = ct; }
    if (x1 > cr) { x1 = cr; }
    if (y1 > cb) { y1 = cb; }
    if (x1 <= x0 || y1 <= y0) { return 0; }
    // 1/16 px 定点足以表达亚像素端点，且所有平方/投影都在 i64 内。
    let ax: i32 = sx0 >> 12;
    let ay: i32 = sy0 >> 12;
    let wxx: i32 = (sx1 >> 12) - ax;
    let wyy: i32 = (sy1 >> 12) - ay;
    let len2: i64 = i64(wxx) * i64(wxx) + i64(wyy) * i64(wyy);
    let r4: i32 = r >> 12;
    if (r4 < 1) { r4 = 1; }
    let rin: i64 = i64(r4) - 8;
    if (rin < 0) { rin = 0; }
    let rout: i64 = i64(r4) + 8;
    let in2: i64 = rin * rin;
    let out2: i64 = rout * rout;
    let den: i64 = out2 - in2;
    if (den <= 0) { den = 1; }
    let row: i32 = y0;
    while (row < y1) {
        let cyp: i64 = i64(row * 16 + 8);
        let col: i32 = x0;
        while (col < x1) {
            let cxp: i64 = i64(col * 16 + 8);
            let px: i64 = cxp - i64(ax);
            let py: i64 = cyp - i64(ay);
            let dot: i64 = px * i64(wxx) + py * i64(wyy);
            let t: i64 = 0;
            if (dot > 0) {
                if (dot >= len2) { t = len2; } else { t = dot; }
            }
            let prx: i64 = 0;
            let pry: i64 = 0;
            if (len2 > 0) {
                prx = (t * i64(wxx)) / len2;
                pry = (t * i64(wyy)) / len2;
            }
            let dx: i64 = px - prx;
            let dy: i64 = py - pry;
            let d2: i64 = dx * dx + dy * dy;
            let cv: i32 = 0;
            if (d2 <= in2) {
                cv = 255;
            } else if (d2 < out2) {
                cv = i32(((out2 - d2) * 255) / den);
                if (cv > 255) { cv = 255; }   // 保护：alpha 不能越过 255
            }
            if (cv > 0) {
                let q: i32 = fill_px_cov(bits, stride, fmt, col, row, color, cv);
            }
            col = col + 1;
        }
        row = row + 1;
    }
    return 0;
}

fn draw_cmd_list_from(bits: ptr, stride: i32, fmt: i32, cmds: ptr<AuiCmd>,
                      count: i32, i0: i32, alpha: i32, dx: i32, dy: i32) : i32 {
    let i: i32 = i0;
    while (i < count) {
        let c: ptr<AuiCmd> = cmds + i * sizeof(AuiCmd);
        let cl: i32 = fx_px(c.cx + dx);
        let ct: i32 = fx_px(c.cy + dy);
        let cr: i32 = fx_px(c.cx + c.cw + dx);
        let cb: i32 = fx_px(c.cy + c.ch + dy);
        // v1.48.2：局部呈现时把所有命令再裁到 damage 矩形；根节点的满屏
        // 底色命令也会被裁成这一块，先铺底再叠行背景/文字/波纹。
        if (g_aui_draw_on != 0) {
            if (cl < g_aui_draw_l) { cl = g_aui_draw_l; }
            if (ct < g_aui_draw_t) { ct = g_aui_draw_t; }
            if (cr > g_aui_draw_r) { cr = g_aui_draw_r; }
            if (cb > g_aui_draw_b) { cb = g_aui_draw_b; }
        }
        // v2.7.3：裁剪框再夹到帧缓冲（已知尺寸时）；与裁剪框无交的命令
        // 一个像素都不画——直接跳过光栅器调用。之前每个重放（直搬每帧
        // 4 次）都要为全部 188 条命令跑一遍字形查找与逐像素裁剪测试，
        // 其中 124 条文本命令在带外也照做全套字形循环；qemu 探针：
        // 10 px 带与 100 px 带、顶部 4 px、滚动条带四次重放耗时相同
        // （约 50 ms/次），与裁剪面积无关，只与命令表大小有关。
        if (g_aui_fb_w > 0 && g_aui_fb_h > 0) {
            if (cl < 0) { cl = 0; }
            if (ct < 0) { ct = 0; }
            if (cr > g_aui_fb_w) { cr = g_aui_fb_w; }
            if (cb > g_aui_fb_h) { cb = g_aui_fb_h; }
        }
        if (cr <= cl || cb <= ct) { i = i + 1; continue; }
        let col: i32 = c.color;
        if (alpha < 255) {
            let ca: i32 = (col >> 24) & 255;
            let na: i32 = (ca * alpha + 127) / 255;
            col = (na << 24) | (col & 0x00FFFFFF);
        }
        if (c.op == 1) {
            let r0: i32 = fill_rect(bits, stride, fmt, c.x + dx, c.y + dy, c.w, c.h, col, c.radius,
                                    cl, ct, cr, cb);
        } else if (c.op == 2) {
            // v2.15：TEXT 命令的 aux 带 (cell | bold<<16)；aux==0 的旧命令
            // 按默认 48/不粗回放（Canvas 文本、历史快照）。
            let cell: i32 = c.aux & 65535;
            if (cell <= 0) { cell = 48; }
            g_aui_text_cell = cell;
            g_aui_text_bold = (c.aux >> 16) & 65535;
            let rc: i32 = aui_rt_set_cell(cell);
            let r1: i32 = draw_text_run(bits, stride, fmt, c.x + dx, c.y + dy, c.text, c.tlen, col,
                                        cl, ct, cr, cb);
        } else if (c.op == 3) {
            let ia: i32 = (col >> 24) & 255;
            let r2: i32 = draw_image(bits, stride, fmt, c.x + dx, c.y + dy, c.w, c.h, c.text,
                                     c.aux, c.tlen, ia, cl, ct, cr, cb);
        } else if (c.op == 4) {
            let r3: i32 = fill_ring(bits, stride, fmt, c.x + dx, c.y + dy, c.w,
                                    col, c.radius, c.aux & 65535, (c.aux >> 16) & 65535, 0, 0,
                                    cl, ct, cr, cb);
        } else if (c.op == 5) {
            let r4: i32 = fill_tri(bits, stride, fmt, c.x + dx, c.y + dy, c.w, c.h,
                                   col, c.aux, cl, ct, cr, cb);
        } else if (c.op == 6) {
            let r5: i32 = fill_seg(bits, stride, fmt, c.x + dx, c.y + dy,
                                   c.w + dx, c.h + dy, col, c.radius,
                                   cl, ct, cr, cb);
        } else if (c.op == 7) {
            // v2.6.2：半圆填充（aux = 方向）。
            let r6: i32 = fill_half(bits, stride, fmt, c.x + dx, c.y + dy, c.w,
                                    col, c.aux, cl, ct, cr, cb);
        } else if (c.op == 8) {
            // v2.6.2：虚线环（aux = 起点 | 虚线长 << 16，tlen = 周期；
            // 跨度恒为整圈）。
            let r7: i32 = fill_ring(bits, stride, fmt, c.x + dx, c.y + dy, c.w,
                                    col, c.radius, c.aux & 65535, 65536,
                                    (c.aux >> 16) & 65535, c.tlen,
                                    cl, ct, cr, cb);
        } else if (c.op == 9) {
            // v2.8：旋转矩形（x/y 为旋转中心，radius 为整度角）。
            let r8: i32 = fill_rot_rect(bits, stride, fmt, c.x + dx, c.y + dy,
                                        c.w, c.h, c.radius, col,
                                        cl, ct, cr, cb);
        } else if (c.op == 10) {
            // v2.8：定尺寸旋转文本行（x/y 为行中心，h 为字高，radius
            // 为整度角；angle=0 即定尺寸文本，面板文字都走这里）。
            let r9: i32 = draw_text_run_sz_rot(bits, stride, fmt, c.x + dx, c.y + dy,
                                               c.text, c.tlen, col, fx_px(c.h),
                                               c.radius, cl, ct, cr, cb);
        }
        i = i + 1;
    }
    return count;
}

fn draw_cmd_list(bits: ptr, stride: i32, fmt: i32, cmds: ptr<AuiCmd>,
                 count: i32, alpha: i32, dx: i32, dy: i32) : i32 {
    return draw_cmd_list_from(bits, stride, fmt, cmds, count, 0, alpha, dx, dy);
}

// 判断一条命令是否“不透明、无圆角”的底色填充，用于转场快路径。
fn is_bg_fill(c: ptr<AuiCmd>) : i32 {
    if (c.op != 1) { return 0; }
    if (c.radius != 0) { return 0; }
    if (((c.color >> 24) & 255) != 255) { return 0; }
    return 1;
}

// 返回开头连续、同色的不透明底色命令条数，并且要求第一条（未位移时）真正
// 铺满整屏。只有“全程单色满屏底”的页面才能在转场里把两层底色合成成一次
// 不透明填充；否则返回 0，调用方继续走逐像素混合的旧路径。
// 转场位移最多 20dp，位移后边缘会露出几十像素的缝，快路径用合成色补上，
// 两页底色相同时（常态）与原效果完全一致。
fn fs_bg_run(cmds: ptr<AuiCmd>, count: i32) : i32 {
    if (count <= 0) { return 0; }
    let c0: ptr<AuiCmd> = cmds;
    if (is_bg_fill(c0) == 0) { return 0; }
    if (fx_px(c0.x) > 0 || fx_px(c0.y) > 0) { return 0; }
    if (fx_px(c0.x + c0.w) < g_aui_fb_w) { return 0; }
    if (fx_px(c0.y + c0.h) < g_aui_fb_h) { return 0; }
    if (fx_px(c0.cx) > 0 || fx_px(c0.cy) > 0) { return 0; }
    if (fx_px(c0.cx + c0.cw) < g_aui_fb_w) { return 0; }
    if (fx_px(c0.cy + c0.ch) < g_aui_fb_h) { return 0; }
    let col: i32 = c0.color;
    let k: i32 = 0;
    while (k < count) {
        let c: ptr<AuiCmd> = cmds + k * sizeof(AuiCmd);
        if (is_bg_fill(c) == 0) { break; }
        if (c.color != col) { return 0; }
        k = k + 1;
    }
    return k;
}

// 逐通道把两层底色压成一个颜色：结果 = c_new(a_new) over [c_old(a_old) over theme]。
fn mix_ch(t: i32, c1: i32, a1: i32, c2: i32, a2: i32) : i32 {
    let v: i32 = t + ((c1 - t) * a1 + 127) / 255;
    return v + ((c2 - v) * a2 + 127) / 255;
}

fn mix_bg(theme: i32, c_old: i32, a_old: i32, c_new: i32, a_new: i32) : i32 {
    let r: i32 = mix_ch((theme >> 16) & 255, (c_old >> 16) & 255, a_old, (c_new >> 16) & 255, a_new);
    let g: i32 = mix_ch((theme >> 8) & 255, (c_old >> 8) & 255, a_old, (c_new >> 8) & 255, a_new);
    let b: i32 = mix_ch(theme & 255, c_old & 255, a_old, c_new & 255, a_new);
    return (255 << 24) | (r << 16) | (g << 8) | b;
}

// 当前帧 + 页面转场。旧页来自命令快照，新页是当前命令列表；两层都用
// 统一的 alpha/水平位移绘制。先铺一条不透明底色，避免半透明层叠加到
// 上一帧留下拖影。
fn draw_frame(bits: ptr, stride: i32, fmt: i32) : i32 {
    if (g_aui_page_on == 0 || g_aui_page_count <= 0) {
        return draw_cmd_list(bits, stride, fmt, g_aui_cmds, g_aui_cmd_count, 255, 0, 0);
    }
    let p: i32 = page_progress(anim_now());
    if (p >= 65536) {
        let f: i32 = page_finish(3, 0);
        return draw_cmd_list(bits, stride, fmt, g_aui_cmds, g_aui_cmd_count, 255, 0, 0);
    }
    let e: i32 = anim_ease(p, AUI_EASE_OUT);
    let a_old: i32 = 255 - (255 * e) / 65536;
    let a_new: i32 = (255 * e) / 65536;
    let dist: i32 = dp2q(20);
    let dx_old: i32 = 0;
    let dx_new: i32 = 0;
    if (g_aui_page_dir > 0) {
        dx_old = 0 - fx_mul(dist, e);
        dx_new = fx_mul(dist, 65536 - e);
    } else if (g_aui_page_dir < 0) {
        dx_old = fx_mul(dist, e);
        dx_new = 0 - fx_mul(dist, 65536 - e);
    }
    let bg: i32 = i32(theme_bg());
    // v1.12.3 快路径：两页的开头都是“同色不透明满屏底”时，两层的底色可以
    // 先解析地压成一个颜色，整屏只做一次不透明填充；随后只画文字/卡片等
    // 内容。旧路径每帧要做三次全屏逐像素混合（3 次 3 百万像素的除法），
    // 真机上单帧就要 100 ms 以上，转场只剩 1~2 帧。快路径下每帧的开销
    // 与普通整页帧相当。
    let k_old: i32 = fs_bg_run(g_aui_page_cmds, g_aui_page_count);
    let k_new: i32 = fs_bg_run(g_aui_cmds, g_aui_cmd_count);
    if (k_old > 0 && k_new > 0) {
        let po: ptr<AuiCmd> = g_aui_page_cmds;
        let pn: ptr<AuiCmd> = g_aui_cmds;
        let c_old: i32 = po.color;
        let c_new: i32 = pn.color;
        let base: i32 = mix_bg(bg, c_old, a_old, c_new, a_new);
        let fb0: i32 = fill_rect(bits, stride, fmt, 0, 0, fx(g_aui_fb_w), fx(g_aui_fb_h),
                                 base, 0, 0, 0, g_aui_fb_w, g_aui_fb_h);
        // 旧内容位于新底色之下，按 (1 - a_new) 再衰减一次；新底色与旧底色
        // 无重叠区域时这就是精确的合成结果。
        let a_oe: i32 = (a_old * (255 - a_new) + 127) / 255;
        let f1: i32 = 0;
        if (a_oe >= 6) {
            f1 = draw_cmd_list_from(bits, stride, fmt, g_aui_page_cmds,
                                    g_aui_page_count, k_old, a_oe, dx_old, 0);
        }
        let f2: i32 = 0;
        if (a_new >= 3) {
            f2 = draw_cmd_list_from(bits, stride, fmt, g_aui_cmds,
                                    g_aui_cmd_count, k_new, a_new, dx_new, 0);
        }
        return f1 + f2;
    }
    // 先铺一层不透明底色：旧页在新页之下淡出，两页都半透明时不会留下拖影。
    let fb: i32 = fill_rect(bits, stride, fmt, 0, 0, fx(g_aui_fb_w), fx(g_aui_fb_h), bg, 0,
                            0, 0, g_aui_fb_w, g_aui_fb_h);
    let r1: i32 = draw_cmd_list(bits, stride, fmt, g_aui_page_cmds,
                                g_aui_page_count, a_old, dx_old, 0);
    let r2: i32 = draw_cmd_list(bits, stride, fmt, g_aui_cmds,
                                g_aui_cmd_count, a_new, dx_new, 0);
    return r1 + r2;
}

fn draw_cmds(bits: ptr, stride: i32, fmt: i32) : i32 {
    return draw_frame(bits, stride, fmt);
}

// ===========================================================================
// 8. 泵帧 / 呈现
// ===========================================================================

// v1.14：算出本轮实际使用的四边安全区（Q16.16），写进 g_aui_inset_*。
// 来源优先级：系统内容区 > API 35+ 整窗时的系统栏估算 > 应用指定的最小 dp。
// 估算只在“内容区就是整窗、应用没要求铺满”时生效；API 35 以下不猜，
// 因为那时系统已经把 surface 缩到系统栏之内。
fn calc_insets() : i32 {
    let swp: i32 = fx_px(g_aui_sw);
    let shp: i32 = fx_px(g_aui_sh);
    if (swp <= 0) { swp = 720; }
    if (shp <= 0) { shp = 1280; }
    let sl: i32 = 0;
    let st: i32 = 0;
    let sr: i32 = 0;
    let sb: i32 = 0;
    let full: i32 = 1;
    if (g_aui_ct_valid != 0) {
        let l: i32 = g_aui_ct_l;
        let t: i32 = g_aui_ct_t;
        let r: i32 = g_aui_ct_r;
        let b: i32 = g_aui_ct_b;
        // v2.6.2 横屏：已存的内容区若装不进当前窗口（旧方向残留，
        // 如竖屏矩形留在横屏窗口里），视为无内容区，退回 24 dp
        // 估算，等新回调再取。装得进的矩形（密度/夜间等配置变化
        // 后仍有效）继续用。
        if (r <= swp && b <= shp) {
            if (l < 0) { l = 0; }
            if (t < 0) { t = 0; }
            if (r > swp) { r = swp; }
            if (b > shp) { b = shp; }
            if (r > l) { sl = fx(l); sr = fx(swp - r); }
            if (b > t) { st = fx(t); sb = fx(shp - b); }
            if (l > 0 || t > 0 || r < swp || b < shp) { full = 0; }
        }
    }
    // W3：24 dp 系统栏估算的适用条件。v1.14 只在 API 35+ 且内容区
    // 是整窗时估算；自研 M1.1 的规则是“没有更好信息时永远估算”——
    // 内容区回调还没到（g_aui_ct_valid == 0）时，不估算就意味着内容
    // 顶到状态栏下面，首帧就错。合并后的条件：edge-to-edge 未关时，
    // 内容区是整窗、或根本还没有内容区，都按 24 dp 估算上下栏；内
    // 容区已给出非整窗值时以它为准（下面再与手动最小值取较大者）。
    // v2.14：上面那句“都按 24 dp 估算”改成“优先用 JNI 实测值，取不
    // 到才按 24 dp 估算”。优先级：内容区实测 > JNI 实测 > 24dp 估算；
    // 应用最小值仍与结果取较大者。src 记录本次来源，供调试接口与
    // trace 71（G）读。
    let guessed: i32 = 0;
    let src: i32 = 0;
    if (g_aui_ct_valid != 0 && full == 0) { src = 1; }
    if (g_aui_e2e == 0 && (full != 0 || g_aui_ct_valid == 0)) {
        if (g_aui_insets_jni_ok != 0) {
            let tq: i32 = fx(g_aui_insets_jni_t);
            let bq: i32 = fx(g_aui_insets_jni_b);
            if (tq > st) { st = tq; }
            if (bq > sb) { sb = bq; }
            src = 2;
        } else {
            let gq: i32 = dp2q(24);
            if (gq > st) { st = gq; }
            if (gq > sb) { sb = gq; }
            guessed = 1;
            src = 3;
        }
    }
    // 应用指定的最小安全区（dp）与上面的值取较大者，避免叠加。
    let ml: i32 = dp2q(g_aui_min_l);
    let mt: i32 = dp2q(g_aui_min_t);
    let mr: i32 = dp2q(g_aui_min_r);
    let mb: i32 = dp2q(g_aui_min_b);
    if (ml > sl) { sl = ml; }
    if (mt > st) { st = mt; }
    if (mr > sr) { sr = mr; }
    if (mb > sb) { sb = mb; }
    let wq: i32 = fx(swp);
    let hq: i32 = fx(shp);
    if (sl + sr >= wq || st + sb >= hq) {
        sl = 0; st = 0; sr = 0; sb = 0;
        guessed = 0;
        src = 0;
    }
    g_aui_inset_l = sl;
    g_aui_inset_t = st;
    g_aui_inset_r = sr;
    g_aui_inset_b = sb;
    if (guessed != g_aui_inset_guess) {
        g_aui_inset_guess = guessed;
        // E + 估算出的上/下安全区（各 16 位，像素）；0 = 关掉了估算。
        let tp: i32 = fx_px(st);
        let bp: i32 = fx_px(sb);
        let packed: i32 = (tp << 16) | (bp & 65535);
        let te: i32 = trace_hex(69, packed);
    }
    if (src != g_aui_insets_src) {
        g_aui_insets_src = src;
        // G + 安全区来源（0 无/铺满 / 1 内容区 / 2 JNI 实测 / 3 24dp 估算）。
        let tg: i32 = trace_hex(71, src);
    }
    return 0;
}

fn pump_ui() : i32 {
    // v1.34：Toast / SnackBar 的自动收起计时（与工具提示共用帧泵节拍）。
    let pt0: i32 = present_tick();
    // v1.27：每帧先推进工具提示计时（长按 500 ms 显示 / 停留到期收起）。
    let tt0: i32 = tip_tick();
    // v2.7：长按计时与工具提示共用帧泵节拍（DOWN 后 500 ms 不动触发一次）。
    let lt0: i32 = lp_tick();
    // v2.9：延时任务计时同样靠泵节拍推进（与 tip/lp 同级）。
    let tk0: i32 = task_tick();
    // v1.48.4：轻布局只在“这一帧开始时没有 build 需求”时有效。build 之后
    // 节点尺寸都是新的，必须完整 measure 一遍。
    let had_build: i32 = g_aui_need_build;
    let llight: i32 = g_aui_layout_light;
    g_aui_layout_light = 0;
    if (had_build != 0) { llight = 0; }
    // v1.48.6：有些变化（波纹被手势取消、按压态取消）不算滚动，必须整屏
    // 重画一次，否则直搬会把视口外的旧像素留下来。
    if (g_aui_force_full != 0) { llight = 0; g_aui_force_full = 0; }
    // v1.48.6：直搬只跟“本轮真的重画了命令”的帧。没有 paint 的呈现（空闲
    // 帧的整屏重画）命令与上一张相同，视口信息保持不动；否则会把帧缓冲
    // 状态误清掉，下一帧明明能直搬却退回整屏。
    g_aui_frame_light = 0;
    if (g_aui_need_paint != 0) {
        if (llight != 0) { g_aui_frame_light = 1; }
        g_aui_frame_scroll_key = active_scroll_key();
        g_aui_scroll_vp_ok = 0;
        g_aui_scroll_vp_h_ok = 0;
        g_aui_sg_start = -1;
        g_aui_sg_end = -1;
    }
    // v1.48.2：这一帧只要经历了 build/layout，就必须整屏重画；只有纯
    // 波纹重绘（need_paint）才允许按节点矩形局部呈现。
    let wf: i32 = 0;
    if (g_aui_need_build != 0 || g_aui_need_layout != 0) { wf = 1; }
    if (g_aui_need_build != 0) {
        if (g_aui_build == 0) { return 0; }
        // 先在 build 前算一次安全区，应用在 build 里调 aui_safe_* 时
        // 拿到的就是这一帧要用的值（而不是上一帧的）。
        let cib: i32 = calc_insets();
        g_aui_in_build = 1;
        g_aui_anim_seq = g_aui_anim_seq + 1;     // 标记本轮 build 的代数
        g_aui_build_count = g_aui_build_count + 1;
        let b: fn(ptr) : i32 = g_aui_build;
        let r0: i32 = b(g_aui_user);
        g_aui_in_build = 0;
        g_aui_need_build = 0;
        g_aui_need_layout = 1;
        let tb: i32 = trace_hex(78, g_aui_node_count);   // N + 节点数
    }
    if (g_aui_root < 0) { return 0; }
    if (g_aui_need_layout != 0) {
        if (g_aui_sw <= 0) { g_aui_sw = fx(720); }
        if (g_aui_sh <= 0) { g_aui_sh = fx(1280); }
        // v1.9：根节点排在系统内容区内（状态栏/导航栏/刘海之外）。
        // v1.14：内容区是整窗时（Android 15 edge-to-edge）由 calc_insets
        // 按 24dp 估算系统栏；条带本身由下面的一条全屏底色命令填充。
        let ci: i32 = calc_insets();
        let sl: i32 = g_aui_inset_l;
        let st: i32 = g_aui_inset_t;
        let sr: i32 = g_aui_inset_r;
        let sb: i32 = g_aui_inset_b;
        let cw: i32 = g_aui_sw - sl - sr;
        let ch: i32 = g_aui_sh - st - sb;
        if (cw <= 0 || ch <= 0) {
            sl = 0; st = 0; sr = 0; sb = 0;
            cw = g_aui_sw; ch = g_aui_sh;
            g_aui_inset_l = 0; g_aui_inset_t = 0;
            g_aui_inset_r = 0; g_aui_inset_b = 0;
        }
        let h0: i32 = 0;
        if (llight == 0) { h0 = measure(g_aui_root, cw); }
        let r1: i32 = arrange(g_aui_root, sl, st, cw, ch);
        if (g_aui_select_open >= 0) {
            let rs: i32 = select_layout(sl, st, cw, ch);
        }
        if (g_aui_combo_open >= 0) {
            let rc: i32 = combo_layout(sl, st, cw, ch);
        }
        if (g_aui_sheet >= 0) {
            let rs: i32 = sheet_layout(sl, st, cw, ch);
        }
        if (g_aui_dialog >= 0) {
            let rd: i32 = dialog_layout(sl, st, cw, ch);
        }
        // v1.35：菜单浮层在对话框之后布局（锚点矩形已就绪）。
        if (g_aui_menu >= 0) {
            let rm: i32 = menu_layout(sl, st, cw, ch);
        }
        // v1.39：锚定浮层在菜单之后布局（锚点矩形已就绪）。
        if (g_aui_popup >= 0) {
            let rpp: i32 = popup_layout(sl, st, cw, ch);
        }
        // v1.27：工具提示是独立浮层，布局在对话框之后（锚点矩形已就绪）。
        if (g_aui_tip_on != 0) {
            let rt: i32 = tip_layout(sl, st, cw, ch);
        }
        // v1.34：Toast / SnackBar 浮层最后布局，叠在底部。
        let rp: i32 = present_layout(sl, st, cw, ch);
        g_aui_need_layout = 0;
        g_aui_need_paint = 1;
        let tl: i32 = trace_mark(76);                    // L = 布局完成
    }
    if (g_aui_need_paint != 0) {
        g_aui_cmd_count = 0;
        // v2.15：绘制段开始，主题栈从空开始（条带与树外浮层读全局调色板）。
        g_aui_theme_depth = 0;
        g_aui_paint_full = wf;
        g_aui_dmg_valid = 0;
        g_aui_dmg_gen = 0;
        g_aui_paint_gen = g_aui_paint_gen + 1;
        g_aui_rip_cs = -1;
        g_aui_rip_ce = -1;
        g_aui_clip_x = 0;
        g_aui_clip_y = 0;
        g_aui_clip_w = g_aui_sw;
        g_aui_clip_h = g_aui_sh;
        g_aui_paint_alpha = 255;
        g_aui_paint_dx = 0;
        g_aui_paint_dy = 0;
        // 有安全区时根节点不覆盖整屏，先铺一条全屏底色；正常全屏时
        // 根节点自己的底色已经覆盖，无需重复命令。
        if (g_aui_inset_l > 0 || g_aui_inset_t > 0 ||
            g_aui_inset_r > 0 || g_aui_inset_b > 0) {
            if (g_aui_sdk >= 35) {
                // v2.13：条带跟主题走（浅色主题浅条带 + JNI 换深色图标，
                // 深色主题深条带 + 浅色图标）；回落时条带取安全色。
                // 条带颜色可由 aui_set_system_bar 覆盖。
                let sbc: u32 = g_aui_sysbar;
                if (sbc == 0) { sbc = theme_system_bar(); }
                let rb0: i32 = cmd_add(1, 0, 0, g_aui_sw, g_aui_sh,
                                       i32(sbc), 0, g_aui_null, 0, 0);
                let cw: i32 = g_aui_sw - g_aui_inset_l - g_aui_inset_r;
                let ch: i32 = g_aui_sh - g_aui_inset_t - g_aui_inset_b;
                if (cw > 0 && ch > 0) {
                    let rb1: i32 = cmd_add(1, g_aui_inset_l, g_aui_inset_t,
                                           cw, ch, i32(theme_bg()), 0,
                                           g_aui_null, 0, 0);
                }
            } else {
                let rb: i32 = cmd_add(1, 0, 0, g_aui_sw, g_aui_sh,
                                      i32(theme_bg()), 0, g_aui_null, 0, 0);
            }
        }
        let r2: i32 = paint_node(g_aui_root);
        if (g_aui_select_open >= 0) {
            let rs: i32 = paint_select_popup();
        }
        if (g_aui_combo_open >= 0) {
            let rc: i32 = paint_combo_popup();
        }
        if (g_aui_dialog >= 0) {
            let rd: i32 = paint_node(g_aui_dialog);
        }
        if (g_aui_sheet >= 0) {
            let rsh: i32 = paint_node(g_aui_sheet);
        }
        // v1.35：菜单画在对话框之上、工具提示/提示层之下。
        if (g_aui_menu >= 0) {
            let rm: i32 = paint_menu();
        }
        // v1.39：锚定浮层画在菜单之上、工具提示之下。
        if (g_aui_popup >= 0) {
            let rpu: i32 = paint_popup();
        }
        // v1.27：工具提示画在所有层之上（HuxerUI 的 Notification 层级）。
        if (g_aui_tip_on != 0) {
            let rtp: i32 = paint_tooltip();
        }
        // v1.34：提示层最高；Toast 在 SnackBar 上方排开，互不遮挡。
        let rpp: i32 = present_paint();
        // v2.8：DEBUG overlay 画在提示层之上（System 级，最顶层）。
        let rdbg: i32 = paint_debug_overlay();
        g_aui_need_paint = 0;
        if (wf != 0) { g_aui_snap_pending = 1; }
        let tp: i32 = trace_hex(80, g_aui_cmd_count);    // P + 命令数
    }
    return g_aui_cmd_count;
}

// ===========================================================================
// 7b. 持久帧缓冲与纯滚动直搬（v1.48.6）
// ===========================================================================

fn fb_bpp(fmt: i32) : i32 {
    if (fmt == 4) { return 2; }                  // RGB_565
    return 4;                                    // RGBA_8888
}

// v2.7.1：帧缓冲是 8 块 × 1M 个 i32、按行对齐；能装下的行数是
// 8 * (1048576 / stride)，不是 w*h <= 1048576（v2.7 的判据在
// 1216×2688 上恒假）。stride<=0 或行数超限都退回直接画窗口。
fn fb_fits(w: i32, h: i32, stride: i32) : i32 {
    if (w <= 0 || h <= 0 || stride <= 0) { return 0; }
    let rpc: i32 = 1048576 / stride;
    if (rpc <= 0) { return 0; }
    if (h > 8 * rpc) { return 0; }
    return 1;
}

// v2.7.1：帧缓冲第 y 行的行首地址。bits == g_aui_fbuf0 时是分块帧缓冲
// （按行对齐，块 = y / 每块行数，块内行 = y % 每块行数）；否则是普通
// 连续缓冲（窗口位图、headless 输出），与原来逐字节相同。调用方只在
// 行内用“行首 + x*bpp”寻址，行永不跨块。
fn fb_row_ptr(bits: ptr, stride: i32, bpp: i32, y: i32) : ptr {
    if (bits != g_aui_fbuf0) { return bits + y * stride * bpp; }
    let rpc: i32 = g_aui_fb_rows_per_chunk;
    if (rpc <= 0) { return g_aui_fbuf0 + y * stride * bpp; }
    let c: i32 = y / rpc;
    let r: i32 = y - c * rpc;
    let off: i32 = r * stride * bpp;
    if (c == 0) { return g_aui_fbuf0 + off; }
    if (c == 1) { return g_aui_fbuf1 + off; }
    if (c == 2) { return g_aui_fbuf2 + off; }
    if (c == 3) { return g_aui_fbuf3 + off; }
    if (c == 4) { return g_aui_fbuf4 + off; }
    if (c == 5) { return g_aui_fbuf5 + off; }
    if (c == 6) { return g_aui_fbuf6 + off; }
    return g_aui_fbuf7 + off;
}

// v2.7.1：帧缓冲的字节偏移地址（调试 helper 用；每块固定 4 MiB）。
// 超限钳到最后一块末尾，不越界。
fn fb_byte_ptr(off: i32) : ptr {
    let c: i32 = off >> 22;
    let r: i32 = off & 4194303;
    if (c == 0) { return g_aui_fbuf0 + r; }
    if (c == 1) { return g_aui_fbuf1 + r; }
    if (c == 2) { return g_aui_fbuf2 + r; }
    if (c == 3) { return g_aui_fbuf3 + r; }
    if (c == 4) { return g_aui_fbuf4 + r; }
    if (c == 5) { return g_aui_fbuf5 + r; }
    if (c == 6) { return g_aui_fbuf6 + r; }
    return g_aui_fbuf7 + r;
}

// v2.7.2：大段拷贝走 libc memcpy（NEON）。旧实现是 8 字节 Aster 循环，
// 真机 1216×2688 帧上每帧两段 13 MB（移位 + 窗口拷贝）约占 c 的 2/3
// （c 中位 20 ms）；qemu 下同机对比：Aster 循环 4 MiB 11.6 ms，
// glibc memcpy 13 MB 0.95 ms（约 38 倍）。调用方保证不重叠
// （fb_shift_rows/fb_copy_win 的 dst/src 区间无交叠，见各处注释）。
fn mem_copy_fwd(dst: ptr, src: ptr, n: i32) : i32 {
    if (n <= 0) { return 0; }
    let r: ptr = memcpy(dst, src, i64(n));
    return 0;
}

// v2.7.2：重叠拷贝走 libc memmove（语义不变：dst>src 时向后搬）。
fn mem_copy_bwd(dst: ptr, src: ptr, n: i32) : i32 {
    if (n <= 0) { return 0; }
    let r: ptr = memmove(dst, src, i64(n));
    return 0;
}

// 视口 [x0,x1) 内整行搬移。back != 0 时按行倒序（内容下移，dst > src）。
fn fb_shift_rows(fb: ptr, stride: i32, bpp: i32, x0: i32, x1: i32,
                 dsty: i32, srcy: i32, nrows: i32, back: i32) : i32 {
    if (nrows <= 0 || x1 <= x0) { return 0; }
    let nbytes: i32 = (x1 - x0) * bpp;
    let i: i32 = 0;
    while (i < nrows) {
        let k: i32 = i;
        if (back != 0) { k = nrows - 1 - i; }
        // v2.7.1：源/目的行首各算一次（分块帧缓冲），行内再加 x0*bpp。
        let d: ptr = fb_row_ptr(fb, stride, bpp, dsty + k) + x0 * bpp;
        let s: ptr = fb_row_ptr(fb, stride, bpp, srcy + k) + x0 * bpp;
        let rc: i32 = mem_copy_fwd(d, s, nbytes);
        i = i + 1;
    }
    return 0;
}

// 横向滚动：同一像素行内搬移 [srcx, srcx+ncols) 到 dstx。
fn fb_shift_cols(fb: ptr, stride: i32, bpp: i32, y0: i32, y1: i32,
                 dstx: i32, srcx: i32, ncols: i32, back: i32) : i32 {
    if (y1 <= y0 || ncols <= 0) { return 0; }
    let nbytes: i32 = ncols * bpp;
    let y: i32 = y0;
    while (y < y1) {
        // v2.7.1：源/目的行首各算一次（分块帧缓冲），行内再加 x*bpp。
        let d: ptr = fb_row_ptr(fb, stride, bpp, y) + dstx * bpp;
        let s: ptr = fb_row_ptr(fb, stride, bpp, y) + srcx * bpp;
        if (back != 0) { let r1: i32 = mem_copy_bwd(d, s, nbytes); }
        else { let r2: i32 = mem_copy_fwd(d, s, nbytes); }
        y = y + 1;
    }
    return 0;
}

// 把整屏命令按矩形裁剪后重放进帧缓冲（暴露带 / 固定装饰条）。
fn fb_replay(fb: ptr, stride: i32, fmt: i32, l: i32, t: i32, r: i32, b: i32) : i32 {
    if (r <= l || b <= t) { return 0; }
    g_aui_draw_on = 1;
    g_aui_draw_l = l;
    g_aui_draw_t = t;
    g_aui_draw_r = r;
    g_aui_draw_b = b;
    let n: i32 = draw_cmd_list_from(fb, stride, fmt, g_aui_cmds, g_aui_cmd_count,
                                    0, 255, 0, 0);
    g_aui_draw_on = 0;
    return n;
}

// 命令的可见像素外接矩形（已和命令自带 clip 相交）。op 6 的 w/h 是终点，
// 这里按包络 box 处理，只用于 z 序/覆盖检查，保守即可。
fn cmd_box(c: ptr<AuiCmd>, out: ptr) : i32 {
    let x0: i32 = fx_px(c.x);
    let y0: i32 = fx_px(c.y);
    let x1: i32 = fx_px(c.x + c.w);
    let y1: i32 = fx_px(c.y + c.h);
    if (c.op == 6) {
        // v2.19.2：op 6 是粗线段，(x,y) 是起点、(w,h) 是终点（见 cmd_seg /
        // fill_seg），不是宽高。包围盒取两端点的 min/max 再加半宽 + 2 px
        // 圆帽。旧代码先按宽高算 x1 = x+w、y1 = y+h（终点坐标被当成尺寸），
        // 再与端点取 min/max——x1/y1 永远偏大：顶栏返回箭头那三条线段的
        // 盒子午下到 y≈387，压住标签栏视口 [0,263,1216,380]，fb_cmds_ok
        // 第 5 阶段（视口前无覆盖命令）每帧失败，直搬全灭——v2.19.1 在真机
        // 上 226 帧 blit=0 就是它（最小树没有顶栏箭头，headless 全绿）。
        let e0: i32 = fx_px(c.w);
        let e1: i32 = fx_px(c.h);
        let sx: i32 = fx_px(c.x);
        let sy: i32 = fx_px(c.y);
        if (e0 < sx) { x0 = e0; x1 = sx; } else { x0 = sx; x1 = e0; }
        if (e1 < sy) { y0 = e1; y1 = sy; } else { y0 = sy; y1 = e1; }
        let pad: i32 = fx_px(c.radius) + 2;
        x0 = x0 - pad;
        y0 = y0 - pad;
        x1 = x1 + pad;
        y1 = y1 + pad;
    }
    // v2.8：op 9/10 的 x/y 是旋转中心（不是左上角），外接矩形是旋转后
    // 的包围盒：半宽 = |cos|*hw + |sin|*hh，半高 = |sin|*hw + |cos|*hh。
    // 直搬的安全检查（fb_cmds_ok）靠它判断 overlay 命令是否碰到滚动
    // 视口，算小了会把缎带/面板错当成“视口外”而直搬拖花。
    if (c.op == 9 || c.op == 10) {
        let cs: i32[2] = 0;
        let rr: i32 = rot_sin_cos(c.radius, cs);
        let co: i32 = cs[0];
        if (co < 0) { co = 0 - co; }
        let si: i32 = cs[1];
        if (si < 0) { si = 0 - si; }
        let hw: i32 = fx_px(c.w) / 2;
        let hh: i32 = fx_px(c.h) / 2;
        let bx: i32 = (co * hw + si * hh) / 65536 + 1;
        let by: i32 = (si * hw + co * hh) / 65536 + 1;
        x0 = fx_px(c.x) - bx;
        y0 = fx_px(c.y) - by;
        x1 = fx_px(c.x) + bx;
        y1 = fx_px(c.y) + by;
    }
    let cl: i32 = fx_px(c.cx);
    let ct: i32 = fx_px(c.cy);
    let cr: i32 = fx_px(c.cx + c.cw);
    let cb: i32 = fx_px(c.cy + c.ch);
    if (x0 < cl) { x0 = cl; }
    if (y0 < ct) { y0 = ct; }
    if (x1 > cr) { x1 = cr; }
    if (y1 > cb) { y1 = cb; }
    *(out + 0) = x0;
    *(out + 4) = y0;
    *(out + 8) = x1;
    *(out + 12) = y1;
    return 0;
}

fn cmd_hits(c: ptr<AuiCmd>, l: i32, t: i32, r: i32, b: i32) : i32 {
    let q: i32[4] = 0;
    let rb: i32 = cmd_box(c, q);
    if (q[2] <= q[0] || q[3] <= q[1]) { return 0; }
    if (q[2] <= l || q[0] >= r) { return 0; }
    if (q[3] <= t || q[1] >= b) { return 0; }
    return 1;
}

// 不透明、直角、且完整盖住矩形。
fn cmd_covers(c: ptr<AuiCmd>, l: i32, t: i32, r: i32, b: i32) : i32 {
    if (c.op != 1 || c.radius != 0) { return 0; }
    if (((c.color >> 24) & 255) != 255) { return 0; }
    let q: i32[4] = 0;
    let rb: i32 = cmd_box(c, q);
    if (q[0] <= l && q[1] <= t && q[2] >= r && q[3] >= b) { return 1; }
    return 0;
}

// 文本命令的墨迹命中：行框底部去掉 trim 像素的空行高再测。
// emit_text_lines 把字形框在行高中居中（(lh-gh)/2），命令框比节点底
// 多出这几像素，框内并无墨迹；只有墨迹真碰到矩形才算命中。
fn cmd_hits_ink(c: ptr<AuiCmd>, l: i32, t: i32, r: i32, b: i32, trim: i32) : i32 {
    let q: i32[4] = 0;
    let rb: i32 = cmd_box(c, q);
    if (q[2] <= q[0] || q[3] - trim <= q[1]) { return 0; }
    if (q[2] <= l || q[0] >= r) { return 0; }
    if (q[3] - trim <= t || q[1] >= b) { return 0; }
    return 1;
}

// 直搬前确认：视口子树之外的命令与上一张快照逐字节一致（命令条数也要
// 一样），子树之后画的东西不压到视口，子树之前紧邻视口的是一条不透明
// 直角底色（整块搬移对纯色是恒等操作）。
fn fb_cmds_ok(l: i32, t: i32, r: i32, b: i32) : i32 {
    let n: i32 = g_aui_cmd_count;
    if (n <= 0 || n != g_aui_snap_count) { return 0; }
    let sg0: i32 = g_aui_sg_start;
    let sg1: i32 = g_aui_sg_end;
    if (sg0 < 0 || sg1 <= sg0 || sg1 > n) { return 0; }
    let k: i32 = 0;
    while (k < n) {
        if (k < sg0 || k >= sg1) {
            let base: i32 = k * 8;
            let j: i32 = 0;
            while (j < 8) {
                if (g_aui_cmd_pool[base + j] != g_aui_snap_pool[base + j]) { return 0; }
                j = j + 1;
            }
        }
        k = k + 1;
    }
    k = sg1;
    while (k < n) {
        let c: ptr<AuiCmd> = cmd_at(k);
        if (cmd_hits(c, l, t, r, b) != 0) { return 0; }
        k = k + 1;
    }
    k = sg0 - 1;
    let found: i32 = 0;
    // v2.7：倒查找覆盖底色时，跳过“只有行框下沿空行高擦到视口”的文本
    // 命令：emit_text_lines 把字形框在行高中居中（(lh-gh)/2），命令框比
    // 节点底多出这几像素，框内并无墨迹；墨迹（框底去掉这几像素）没碰到
    // 视口就不算命中，继续往前找底色。其它命中但不覆盖的命令仍按旧规则
    // 失败——它们的墨迹真在视口里，直搬会拖花。顶部 4 px 重放会把边界
    // 行按命令表重画，1 px 的取整误差也在兜底范围里。
    let trim: i32 = fx_px((text_line_h() - text_glyph_h()) / 2);
    while (k >= 0) {
        let c: ptr<AuiCmd> = cmd_at(k);
        if (cmd_hits(c, l, t, r, b) != 0) {
            if (cmd_covers(c, l, t, r, b) != 0) { found = 1; k = -1; }
            else if (c.op == 2 && cmd_hits_ink(c, l, t, r, b, trim) == 0) { k = k - 1; }
            else { k = -1; }
        } else {
            k = k - 1;
        }
    }
    if (found == 0) { return 0; }
    return 1;
}

// v2.7：测试辅助：取一条命令的字段（像素）。
// out = [op, x, y, w, h, radius, color, tlen]。
fn aui_debug_cmd_at(idx: i32, out: ptr) : i32 {
    if (out == 0) { return -1; }
    if (idx < 0 || idx >= g_aui_cmd_count) { return -1; }
    let c: ptr<AuiCmd> = cmd_at(idx);
    *(out + 0) = c.op;
    *(out + 4) = fx_px(c.x);
    *(out + 8) = fx_px(c.y);
    *(out + 12) = fx_px(c.w);
    *(out + 16) = fx_px(c.h);
    *(out + 20) = c.radius;
    *(out + 24) = c.color;
    *(out + 28) = c.tlen;
    return 0;
}

// v2.7：测试辅助：fb_cmds_ok 失败定位。
// out[0] = fb_cmds_ok 结果；out[1] = 失败阶段（0 通过，1 条数，2 范围，
// 3 子树外命令逐字节不同，4 子树后命令压到视口，5 视口前无覆盖命令）；
// out[2] = 阶段 3 的命令下标或阶段 4 的命令下标；out[3] = 阶段 3 的字下标；
// out[4] = 当前值（低 32）；out[5] = 快照值（低 32）。
fn aui_debug_cmds_why(out: ptr) : i32 {
    if (out == 0) { return -1; }
    let l: i32 = g_aui_scroll_vp_l;
    let t: i32 = g_aui_scroll_vp_t;
    let r: i32 = g_aui_scroll_vp_r;
    let b: i32 = g_aui_scroll_vp_b;
    *(out + 0) = fb_cmds_ok(l, t, r, b);
    *(out + 4) = 0;
    *(out + 8) = -1;
    *(out + 12) = -1;
    *(out + 16) = 0;
    *(out + 20) = 0;
    let n: i32 = g_aui_cmd_count;
    if (n <= 0 || n != g_aui_snap_count) { *(out + 4) = 1; return 0; }
    let sg0: i32 = g_aui_sg_start;
    let sg1: i32 = g_aui_sg_end;
    if (sg0 < 0 || sg1 <= sg0 || sg1 > n) { *(out + 4) = 2; return 0; }
    let k: i32 = 0;
    while (k < n) {
        if (k < sg0 || k >= sg1) {
            let base: i32 = k * 8;
            let j: i32 = 0;
            while (j < 8) {
                if (g_aui_cmd_pool[base + j] != g_aui_snap_pool[base + j]) {
                    *(out + 4) = 3;
                    *(out + 8) = k;
                    *(out + 12) = j;
                    *(out + 16) = i32(g_aui_cmd_pool[base + j]);
                    *(out + 20) = i32(g_aui_snap_pool[base + j]);
                    return 0;
                }
                j = j + 1;
            }
        }
        k = k + 1;
    }
    k = sg1;
    while (k < n) {
        let c: ptr<AuiCmd> = cmd_at(k);
        if (cmd_hits(c, l, t, r, b) != 0) {
            *(out + 4) = 4;
            *(out + 8) = k;
            return 0;
        }
        k = k + 1;
    }
    k = sg0 - 1;
    let found: i32 = 0;
    // 与 fb_cmds_ok 同步（v2.7）：跳过墨迹没碰到视口的文本命令。
    let trim: i32 = fx_px((text_line_h() - text_glyph_h()) / 2);
    while (k >= 0) {
        let c: ptr<AuiCmd> = cmd_at(k);
        if (cmd_hits(c, l, t, r, b) != 0) {
            if (cmd_covers(c, l, t, r, b) != 0) { found = 1; k = -1; }
            else if (c.op == 2 && cmd_hits_ink(c, l, t, r, b, trim) == 0) { k = k - 1; }
            else { k = -1; }
        } else {
            k = k - 1;
        }
    }
    if (found == 0) { *(out + 4) = 5; return 0; }
    return 0;
}

// 视口内容整体搬移 d 像素（d>0 = 内容上移/左移），再补画暴露带、
// 顶部 4 行与滚动条。帧缓冲已在窗口格式、窗口 stride 下。
fn fb_do_blit(fb: ptr, stride: i32, bpp: i32, fmt: i32,
              l: i32, t: i32, r: i32, b: i32, d: i32, horiz: i32) : i32 {
    if (horiz != 0) {
        let band: i32[2] = 0;
        // v2.7.3：移位与重放分开计时（sh/re），供 scroll frame 日志。
        let sh0: i64 = clock_ns();
        // v2.17.2：右沿条带宽（纵向滚动条拇指横向固定，约 23px）。
        // 拇指在条带内；条带不参与平移，由下面的 rb3 按命令重放。
        // 之前整张视口一起平移：拇指每帧在原位重画，但平移出去的旧
        // 拇指只在条带内才被擦掉，条带外每帧留一个副本（真机 f014）。
        let bw: i32 = dp2q(3) + dp2q(3);
        let bwp: i32 = (bw >> 16) + 4;
        let sh_r: i32 = r - bwp;
        if (sh_r - l <= iabs(d)) {
            // 可平移区太窄（位移几乎盖过整个视口）：整视口按命令重放。
            // v2.20.4：从 x=0 起（不是 l）——横向滚动条拇指在小 offx
            // 时落在粘性首列右沿（l）以左，[l, ...) 的重放盖不到它，
            // 会冻在旧位（见 rb2 处注释）；粘性列是静止内容，重放无害。
            let rf: i32 = fb_replay(fb, stride, fmt, 0, t, r, b);
            let sh1d: i64 = clock_ns();
            g_aui_diag_sh_ms = g_aui_diag_sh_ms + i32((sh1d - sh0) / 1000000);
            return 0;
        }
        if (d > 0) {
            let ncols: i32 = (sh_r - l) - d;
            let rs1: i32 = fb_shift_cols(fb, stride, bpp, t, b, l, l + d, ncols, 0);
            band[0] = sh_r - d;
            band[1] = sh_r;
        } else {
            let dd: i32 = 0 - d;
            let ncols: i32 = (sh_r - l) - dd;
            let rs2: i32 = fb_shift_cols(fb, stride, bpp, t, b, l + dd, l, ncols, 1);
            band[0] = l;
            band[1] = l + dd;
        }
        let sh1: i64 = clock_ns();
        g_aui_diag_sh_ms = g_aui_diag_sh_ms + i32((sh1 - sh0) / 1000000);
        let re0: i64 = clock_ns();
        let rb1: i32 = fb_replay(fb, stride, fmt, band[0], t, band[1], b);
        // 横向滚动条在底部：上下两条固定装饰都补一遍。
        let rt1: i32 = fb_replay(fb, stride, fmt, l, t, r, t + 4);
        let bh: i32 = dp2q(3) + dp2q(3);
        let bhp: i32 = (bh >> 16) + 4;
        let y0: i32 = b - bhp;
        if (y0 < t) { y0 = t; }
        // v2.20.4：底部条带从 x=0 起重放（不是 l）。横向滚动条拇指
        // 在小 offx 时落在粘性首列右沿（l）以左：它不随内容平移（平
        // 移区从 l 起），也不在 [l, ...) 的重放区里，直搬帧里会冻在
        // 上次整屏重画的位置、落后真位置（每 30px 内容步进约 1px，
        // 累积可达 13px；见 REPORT-v2204-hbar-lag.md）。条带是固定
        // 装饰，按当前命令表全宽重放只多画粘性列底格，代价可忽略。
        // 平移区与 plan 视口一律不动——粘性列绝不能动。
        let rb2: i32 = fb_replay(fb, stride, fmt, 0, y0, r, b);
        // v2.17.1：表格还有纵向滚动条在右沿：它随纵向偏移走，横向直搬
        // 会把它平移错位，按命令重放补回（hlist 没有纵条，重放同一批像
        // 素，无害）。
        // v2.17.2：条带 [r-bwp, r) 本轮不参与平移（见上），rb3 按命令
        // 重放它：拇指与条带内的滚动内容都按当前命令表画回原位。
        let x0: i32 = r - bwp;
        if (x0 < l) { x0 = l; }
        let rb3: i32 = fb_replay(fb, stride, fmt, x0, t, r, b);
        let re1: i64 = clock_ns();
        g_aui_diag_re_ms = g_aui_diag_re_ms + i32((re1 - re0) / 1000000);
    } else {
        let band: i32[2] = 0;
        let sh2: i64 = clock_ns();
        // v2.17.3：底部条带宽（横向滚动条拇指纵向固定，约 23px）。
        // 拇指在条带内；条带不参与平移，由下面的 rr2 按命令重放。
        // 之前整张视口一起平移：拇指每帧在原位重画，但平移出去的旧
        // 拇指只在条带内才被擦掉，条带外每帧留一个副本（与 v2.17.2
        // 的纵条拇指横向涂抹同一机理，轴向互换；真机快甩每帧位移
        // 100–200px，远超 23px 条带）。
        let bbh0: i32 = dp2q(3) + dp2q(3);
        let bbhp0: i32 = (bbh0 >> 16) + 4;
        let sh_b: i32 = b - bbhp0;
        if (sh_b - t <= iabs(d)) {
            // 可平移区太窄（位移几乎盖过整个视口）：整视口按命令重放。
            let rf: i32 = fb_replay(fb, stride, fmt, l, t, r, b);
            let sh3d: i64 = clock_ns();
            g_aui_diag_sh_ms = g_aui_diag_sh_ms + i32((sh3d - sh2) / 1000000);
            return 0;
        }
        if (d > 0) {
            // v2.7.4：内容上移（dst < src）必须按行正序搬移。倒序会先把
            // 靠下的源行当成目的行写掉，之后再读它时读到的是已搬过的
            // 内容——底行（最后一行）被一路向上涂抹，行内文字全变成
            // 最后一行的号、行背景被拉成 155 px 间距的碎块。fb_shift_rows
            // 的注释也写明倒序只用于“内容下移（dst > src）”，即 d<0 分支。
            let nrows: i32 = (sh_b - t) - d;
            let rs3: i32 = fb_shift_rows(fb, stride, bpp, l, r, t, t + d, nrows, 0);
            band[0] = sh_b - d;
            band[1] = sh_b;
        } else {
            let dd: i32 = 0 - d;
            let nrows: i32 = (sh_b - t) - dd;
            let rs4: i32 = fb_shift_rows(fb, stride, bpp, l, r, t + dd, t, nrows, -1);
            band[0] = t;
            band[1] = t + dd;
        }
        let sh3: i64 = clock_ns();
        g_aui_diag_sh_ms = g_aui_diag_sh_ms + i32((sh3 - sh2) / 1000000);
        let re2: i64 = clock_ns();
        let rr1: i32 = fb_replay(fb, stride, fmt, l, band[0], r, band[1]);
        // 顶部固定装饰、底部边缘、右侧滚动条（位置随偏移变化，不参与搬移）。
        let rt2: i32 = fb_replay(fb, stride, fmt, l, t, r, t + 4);
        // v2.17：底部重放按横滚动条高度算（表格的横条约 23 px，只补 4 px
        // 会在纵向直搬后把它带偏；其余纵向容器多补几行也是当前命令内容）。
        // v2.17.3：条带 [sh_b, b) 本轮不参与平移（见上），rr2 按命令
        // 重放它：拇指与条带内的滚动内容都按当前命令表画回原位。
        let bbh: i32 = dp2q(3) + dp2q(3);
        let bbhp: i32 = (bbh >> 16) + 4;
        let y1: i32 = b - bbhp;
        if (y1 < t) { y1 = t; }
        let rr2: i32 = fb_replay(fb, stride, fmt, l, y1, r, b);
        let bw: i32 = dp2q(3) + dp2q(3);
        let bwp: i32 = (bw >> 16) + 4;
        let x0: i32 = r - bwp;
        if (x0 < l) { x0 = l; }
        let rr3: i32 = fb_replay(fb, stride, fmt, x0, t, r, b);
        let re3: i64 = clock_ns();
        g_aui_diag_re_ms = g_aui_diag_re_ms + i32((re3 - re2) / 1000000);
    }
    return 0;
}

fn fb_copy_win(fb: ptr, bits: ptr, stride: i32, bpp: i32, w: i32,
               l: i32, t: i32, r: i32, b: i32) : i32 {
    if (r <= l || b <= t) { return 0; }
    let rowb: i32 = stride * bpp;
    if (l <= 0 && r >= w) {
        if (fb != g_aui_fbuf0) {
            // 连续缓冲：整段一次拷。
            let rc: i32 = mem_copy_fwd(bits + t * rowb, fb + t * rowb, (b - t) * rowb);
            return 0;
        }
        // 分块帧缓冲：按块分段拷（每段整段一次，不跨块；最多 8 段）。
        let rpc: i32 = g_aui_fb_rows_per_chunk;
        if (rpc > 0) {
            let y: i32 = t;
            while (y < b) {
                let c: i32 = y / rpc;
                let seg_end: i32 = (c + 1) * rpc;
                if (seg_end > b) { seg_end = b; }
                let n: i32 = (seg_end - y) * rowb;
                let rc2: i32 = mem_copy_fwd(bits + y * rowb,
                                            fb_row_ptr(fb, stride, bpp, y), n);
                y = seg_end;
            }
            return 0;
        }
        // rpc 未设（不应发生）：退回逐行拷。
    }
    let nbytes: i32 = (r - l) * bpp;
    let y: i32 = t;
    while (y < b) {
        let rc: i32 = mem_copy_fwd(bits + y * rowb + l * bpp,
                                   fb_row_ptr(fb, stride, bpp, y) + l * bpp, nbytes);
        y = y + 1;
    }
    return 0;
}

// 记录这张帧缓冲对应的滚动状态，供下一帧判断能否直搬。
fn fb_state_store() : i32 {
    let key: i32 = g_aui_frame_scroll_key;
    if (key != 0 && g_aui_scroll_vp_ok != 0) {
        g_aui_fb_key = key;
        g_aui_fb_off = scroll_get(key);
        g_aui_fb_vp_ok = 1;
        g_aui_fb_vp_l = g_aui_scroll_vp_l;
        g_aui_fb_vp_t = g_aui_scroll_vp_t;
        g_aui_fb_vp_r = g_aui_scroll_vp_r;
        g_aui_fb_vp_b = g_aui_scroll_vp_b;
        // v2.19.1：标签栏（kind 19）也是横向滚动，直搬沿横轴。
        if (hlist_idx(key) >= 0 || scroll_node_kind(key) == 19) { g_aui_fb_horiz = 1; } else { g_aui_fb_horiz = 0; }
        // v2.17.1：表格另存横向直搬视口与横向偏移（纵向仍走上面的字段）。
        if (vtable_idx(key) >= 0 && g_aui_scroll_vp_h_ok != 0) {
            g_aui_fb_vp_h_ok = 1;
            g_aui_fb_vp_hl = g_aui_scroll_vp_hl;
            g_aui_fb_vp_ht = g_aui_scroll_vp_ht;
            g_aui_fb_vp_hr = g_aui_scroll_vp_hr;
            g_aui_fb_vp_hb = g_aui_scroll_vp_hb;
            g_aui_fb_offx = vtable_off_x(key);
        } else {
            g_aui_fb_vp_h_ok = 0;
        }
    } else {
        g_aui_fb_key = 0;
        g_aui_fb_vp_ok = 0;
        g_aui_fb_horiz = 0;
        g_aui_fb_vp_h_ok = 0;
    }
    return 0;
}

// v1.48.6：纯滚动直搬的判定。本帧只有滚动偏移变化（轻布局）、帧缓冲可
// 用且几何一致、视口与上一帧完全相同、位移是整数像素且小于视口时，返回
// 1，并把视口四边和像素位移写进 out（l,t,r,b,delta）。
// 命令层面再由 fb_cmds_ok 确认视口子树之外一个像素都没变、子树之后没有
// 浮层压住视口。
fn scroll_blit_plan(out: ptr) : i32 {
    g_aui_blit_fail = 0; g_aui_blit_dbg[7] = 0;
    if (g_aui_blit_off != 0) { g_aui_blit_fail = 99; return 0; }
    g_aui_blit_dbg[0] = g_aui_frame_light;
    g_aui_blit_dbg[1] = g_aui_fbuf_ok;
    g_aui_blit_dbg[2] = g_aui_fb_vp_ok;
    g_aui_blit_dbg[3] = g_aui_scroll_vp_ok;
    g_aui_blit_dbg[4] = g_aui_frame_scroll_key;
    g_aui_blit_dbg[5] = g_aui_fb_key;
    g_aui_blit_dbg[6] = 0;
    g_aui_blit_dbg[7] = 0;
    if (g_aui_frame_light == 0) { g_aui_blit_fail = 1; g_aui_blit_dbg[7] = 1; return 0; }
    if (g_aui_fbuf_ok == 0) { g_aui_blit_fail = 2; g_aui_blit_dbg[7] = 2; return 0; }
    if (g_aui_fbuf_w != g_aui_fb_w || g_aui_fbuf_h != g_aui_fb_h) {
        g_aui_blit_fail = 3; g_aui_blit_dbg[7] = 3; return 0;
    }
    if (g_aui_fb_vp_ok == 0 || g_aui_scroll_vp_ok == 0) {
        g_aui_blit_fail = 4; g_aui_blit_dbg[7] = 4; return 0;
    }
    if (g_aui_frame_scroll_key == 0 ||
        g_aui_frame_scroll_key != g_aui_fb_key) { g_aui_blit_fail = 5; g_aui_blit_dbg[7] = 5; return 0; }
    if (g_aui_scroll_vp_rad != 0) { g_aui_blit_fail = 6; g_aui_blit_dbg[7] = 6; return 0; }
    if (g_aui_scroll_vp_l != g_aui_fb_vp_l ||
        g_aui_scroll_vp_t != g_aui_fb_vp_t ||
        g_aui_scroll_vp_r != g_aui_fb_vp_r ||
        g_aui_scroll_vp_b != g_aui_fb_vp_b) { g_aui_blit_fail = 7; g_aui_blit_dbg[7] = 7; return 0; }
    if (g_aui_page_on != 0 || g_aui_ripple_phase != 0) {
        g_aui_blit_fail = 8; g_aui_blit_dbg[7] = 8; return 0;
    }
    if (anim_active_count() != 0 || pager_anim_count() != 0 ||
        refresh_busy() != 0 || present_busy() != 0 || tip_busy() != 0 || lp_busy() != 0 || d2a_sel_busy() != 0 || task_busy() != 0) {
        g_aui_blit_fail = 9; g_aui_blit_dbg[7] = 9; return 0;
    }
    if (g_aui_select_open >= 0 || g_aui_combo_open >= 0 || g_aui_dialog >= 0 ||
        g_aui_sheet >= 0 || g_aui_menu >= 0 || g_aui_popup >= 0 ||
        g_aui_tip_on != 0) { g_aui_blit_fail = 10; g_aui_blit_dbg[7] = 10; return 0; }
    let key: i32 = g_aui_frame_scroll_key;
    // v2.17.1：表格纵横双向：纵向差走 scroll（fb_off），横向差走 off_x
    // （fb_offx）。恰一个方向变才直搬；双向同变（对角）整屏重画。
    // 非表格沿用旧逻辑（hlist 横向、其余纵向）。
    let dif: i32 = scroll_get(key) - g_aui_fb_off;
    let bd: i32 = 0;
    let is_vt: i32 = 0;
    if (vtable_idx(key) >= 0) { is_vt = 1; }
    if (is_vt != 0) {
        let dx: i32 = vtable_off_x(key) - g_aui_fb_offx;
        let dy: i32 = dif;
        if (dx != 0 && dy != 0) { g_aui_blit_fail = 15; g_aui_blit_dbg[7] = 15; return 0; }
        if (dx != 0) {
            // 横向：视口改用横向那张（首列右沿起，全高）；位移即横向差。
            if (g_aui_scroll_vp_h_ok == 0 || g_aui_fb_vp_h_ok == 0) {
                g_aui_blit_fail = 14; g_aui_blit_dbg[7] = 14; return 0;
            }
            if (g_aui_scroll_vp_hl != g_aui_fb_vp_hl ||
                g_aui_scroll_vp_ht != g_aui_fb_vp_ht ||
                g_aui_scroll_vp_hr != g_aui_fb_vp_hr ||
                g_aui_scroll_vp_hb != g_aui_fb_vp_hb) {
                g_aui_blit_fail = 14; g_aui_blit_dbg[7] = 14; return 0;
            }
            g_aui_fb_horiz = 1;
            bd = dx;
            dif = dx;
        } else {
            g_aui_fb_horiz = 0;
            bd = dy;
        }
    } else {
        // 只有整像素位移才能整块搬移；亚像素（普通滚动的小数部分）这一帧退回
        // 整屏重画，位置仍然精确。
        if (virtual_key(key) != 0) {
            bd = dif;
        } else if ((dif & 65535) == 0) {
            bd = dif >> 16;
        }
    }
    g_aui_blit_dif = dif;
    g_aui_blit_bd = bd;
    g_aui_blit_dbg[6] = dif;
    if (bd == 0) { g_aui_blit_fail = 11; g_aui_blit_dbg[7] = 11; return 0; }
    let l: i32 = g_aui_scroll_vp_l;
    let t: i32 = g_aui_scroll_vp_t;
    let r: i32 = g_aui_scroll_vp_r;
    let b: i32 = g_aui_scroll_vp_b;
    if (is_vt != 0 && g_aui_fb_horiz != 0) {
        l = g_aui_scroll_vp_hl;
        t = g_aui_scroll_vp_ht;
        r = g_aui_scroll_vp_hr;
        b = g_aui_scroll_vp_hb;
    }
    if (l < 0) { l = 0; }
    if (t < 0) { t = 0; }
    if (r > g_aui_fb_w) { r = g_aui_fb_w; }
    if (b > g_aui_fb_h) { b = g_aui_fb_h; }
    let lim: i32 = b - t;
    if (g_aui_fb_horiz != 0) { lim = r - l; }
    if (lim <= 0 || iabs(bd) >= lim) { g_aui_blit_fail = 12; g_aui_blit_dbg[7] = 12; return 0; }
    if (fb_cmds_ok(l, t, r, b) == 0) { g_aui_blit_fail = 13; g_aui_blit_dbg[7] = 13; return 0; }
    *(out + 0) = l;
    *(out + 4) = t;
    *(out + 8) = r;
    *(out + 12) = b;
    *(out + 16) = bd;
    return 1;
}

fn present_now() : i32 {
    if (g_aui_have_win == 0) { return 0; }
    if (g_aui_win == 0) { return 0; }
    let pd: i32 = 0;                             // 局部呈现（仅波纹）
    let bp: i32[5] = 0;
    let bl: i32 = scroll_blit_plan(bp);          // 纯滚动直搬
    let bd: i32 = bp[4];                         // 直搬位移（像素）
    let vpl: i32 = bp[0];
    let vpt: i32 = bp[1];
    let vpr: i32 = bp[2];
    let vpb: i32 = bp[3];
    g_aui_frame_blit = 0;
    g_aui_frame_dmg = 0;
    g_aui_frame_dmg_l = -1;
    g_aui_frame_dmg_t = -1;
    g_aui_frame_dmg_r = -1;
    g_aui_frame_dmg_b = -1;
    g_aui_draw_on = 0;
    g_aui_dirty[0] = 0;
    g_aui_dirty[1] = 0;
    g_aui_dirty[2] = 0;
    g_aui_dirty[3] = 0;
    // v1.48.2：波纹是唯一变化时只重画它所在的节点矩形。
    // inOutDirty 有两个作用：告诉 Surface 本轮只改这一块；让 Surface 把
    // 未重画的部分从上一帧拷回新缓冲（BufferQueue 轮转时缓冲区内容可能
    // 是两帧前的）。它还可能把矩形扩大——上一帧内容不可用时甚至扩到全屏，
    // 所以锁之后必须按返回的矩形重画，不能只信自己的 dmg。
    // 前提：这一帧没 build/layout、没有转场/惯性/刷新/Toast/工具提示等
    // 其它动画。这些层任意一个在动就整屏画。
    // 首帧还没有窗口尺寸，就不做局部。
    if (bl == 0 && g_aui_fb_w > 0 && g_aui_fb_h > 0 &&
        g_aui_page_on == 0 && g_aui_paint_full == 0 && g_aui_dmg_valid != 0 &&
        g_aui_dmg_gen == g_aui_paint_gen && g_aui_ripple_phase != 0 &&
        anim_active_count() == 0 && pager_anim_count() == 0 &&
        refresh_busy() == 0 && present_busy() == 0 && tip_busy() == 0 &&
        cmd_only_ripple_changed() != 0) {
        let dl: i32 = g_aui_dmg_l;
        let dt: i32 = g_aui_dmg_t;
        let dr: i32 = g_aui_dmg_r;
        let db: i32 = g_aui_dmg_b;
        if (dl < 0) { dl = 0; }
        if (dt < 0) { dt = 0; }
        if (dr > g_aui_fb_w) { dr = g_aui_fb_w; }
        if (db > g_aui_fb_h) { db = g_aui_fb_h; }
        if (dr > dl && db > dt) {
            pd = 1;
            g_aui_dirty[0] = dl;
            g_aui_dirty[1] = dt;
            g_aui_dirty[2] = dr;
            g_aui_dirty[3] = db;
            g_aui_draw_on = 1;
            g_aui_draw_l = dl;
            g_aui_draw_t = dt;
            g_aui_draw_r = dr;
            g_aui_draw_b = db;
        }
    }
    // v2.16.1：动画损伤重画（与波纹局部呈现同一条 pd 路径）。波纹门要求
    // anim_active_count()==0；动画在跑时每一帧都是整屏重画（~25 ms），
    // 16 ms 的泵跟不上，脉冲/弹簧/滑杆全卡成跳变。当前命令表与上一张
    // 已呈现帧的快照逐条 64 B 比较，变化的命令（旧+新矩形）并成损伤
    // 矩形，只重画那一块。条数变化、旋转命令、损伤超 1/4 屏时回落
    // 整屏；DEBUG 面板展开时数字每帧变，文本缓冲原地改写、64 B 比较
    // 看不见，跳过损伤。build 帧也不排除：滑杆每步 MOVE 都触发
    // build，若只认纯绘制帧，拖动全程仍是整屏重画；build 帧的快照
    // 是上一张已呈现帧，重建后命令逐条比较 + 面积上限，安全。
    let ad: i32 = 0;
    let adrect: i32[4] = 0;
    if (pd == 0 && bl == 0 && g_aui_fb_w > 0 && g_aui_fb_h > 0 &&
        g_aui_page_on == 0 &&
        anim_active_count() != 0 && pager_anim_count() == 0 &&
        refresh_busy() == 0 && present_busy() == 0 && tip_busy() == 0 &&
        g_dbg_expanded == 0 &&
        cmd_anim_damage(adrect) != 0) {
        ad = 1;
        pd = 1;
        g_aui_dirty[0] = adrect[0];
        g_aui_dirty[1] = adrect[1];
        g_aui_dirty[2] = adrect[2];
        g_aui_dirty[3] = adrect[3];
        g_aui_draw_on = 1;
        g_aui_draw_l = adrect[0];
        g_aui_draw_t = adrect[1];
        g_aui_draw_r = adrect[2];
        g_aui_draw_b = adrect[3];
    }
    if (bl != 0) {
        g_aui_dirty[0] = vpl;
        g_aui_dirty[1] = vpt;
        g_aui_dirty[2] = vpr;
        g_aui_dirty[3] = vpb;
        // v2.20.4：横向直搬的 rb2/rf 从 x=0 起重放底部条带（底边拇
        // 指在粘性沿以左），脏矩形须盖住它——否则 fb_copy_win 只拷
        // plan 视口，帧缓冲里画好的新拇指到不了窗口，修了等于没修。
        // 纵向直搬的 plan 视口左沿本就是 0，不用扩。
        if (g_aui_fb_horiz != 0) { g_aui_dirty[0] = 0; }
        g_aui_draw_on = 1;
        g_aui_draw_l = vpl;
        g_aui_draw_t = vpt;
        g_aui_draw_r = vpr;
        g_aui_draw_b = vpb;
    }
    // v1.48.4：窗口锁等待（w）、光栅耗时（C）、提交耗时（t）无条件记录，
    // 这样普通滚动帧也能直接看出卡在“等缓冲”、CPU 绘制还是合成器提交。
    // 旧版本只在转场时记 w，滚动问题没有数据可查。
    let z0: i64 = clock_ns();
    let locked: i32 = ANativeWindow_lock(g_aui_win, g_aui_winbuf, g_aui_dirty);
    let z1: i64 = clock_ns();
    let zd: i32 = i32((z1 - z0) / 1000000);
    let tw: i32 = trace_hex(119, zd);            // w + 窗口锁等待(ms)
    if (locked != 0) { return -1; }
    let w: i32 = g_aui_winbuf[0];
    let h: i32 = g_aui_winbuf[1];
    let stride: i32 = g_aui_winbuf[2];
    let fmt: i32 = g_aui_winbuf[3];
    let bits: ptr = load_ptr(g_aui_winbuf + 16);
    g_aui_fb_w = w;
    g_aui_fb_h = h;
    let bpp: i32 = fb_bpp(fmt);
    let fits: i32 = fb_fits(w, h, stride);
    // v2.7.1：帧缓冲是 8 块 × 1M 个 i32（fbp 指第 0 块，行首由 fb_row_ptr
    // 按“块 = y / 每块行数”算）；每块行数随 stride 定，锁后才能算。
    let fbp: ptr = g_aui_fbuf0;
    if (fits != 0) { g_aui_fb_rows_per_chunk = 1048576 / stride; }
    let same: i32 = 0;
    if (fits != 0 && g_aui_fbuf_ok != 0 && g_aui_fbuf_w == w &&
        g_aui_fbuf_h == h && g_aui_fbuf_stride == stride &&
        g_aui_fbuf_fmt == fmt) { same = 1; }
    if (fits != 0 && same == 0) {
        g_aui_fbuf_w = w;
        g_aui_fbuf_h = h;
        g_aui_fbuf_stride = stride;
        g_aui_fbuf_fmt = fmt;
        g_aui_fbuf_ok = 0;
    }
    let n: i32 = 0;
    let d0: i64 = clock_ns();
    g_aui_diag_rp_ms = 0;
    g_aui_diag_cp_ms = 0;
    g_aui_diag_sh_ms = 0;
    g_aui_diag_re_ms = 0;
    if (bits != 0 && w > 0 && h > 0) {
        if (bl != 0 && same != 0) {
            // Surface 返回的矩形可能扩大（上一帧内容不可用）也可能为空；
            // 帧缓冲始终是完整一帧，取并集拷回去就行。
            let cl: i32 = g_aui_dirty[0];
            let ct: i32 = g_aui_dirty[1];
            let cr: i32 = g_aui_dirty[2];
            let cb: i32 = g_aui_dirty[3];
            if (cl > vpl) { cl = vpl; }
            if (ct > vpt) { ct = vpt; }
            if (cr < vpr) { cr = vpr; }
            if (cb < vpb) { cb = vpb; }
            if (cl < 0) { cl = 0; }
            if (ct < 0) { ct = 0; }
            if (cr > w) { cr = w; }
            if (cb > h) { cb = h; }
            // v2.7.2：两阶段计时（rp = 直搬移位+暴露带重放，cp = 窗口拷贝）。
            let rp0: i64 = clock_ns();
            let rb0: i32 = fb_do_blit(fbp, stride, bpp, fmt, vpl, vpt, vpr, vpb,
                                      bd, g_aui_fb_horiz);
            let rp1: i64 = clock_ns();
            g_aui_diag_rp_ms = i32((rp1 - rp0) / 1000000);
            g_aui_fbuf_ok = 1;
            let cp0: i64 = clock_ns();
            let rbc: i32 = fb_copy_win(fbp, bits, stride, bpp, w, cl, ct, cr, cb);
            let cp1: i64 = clock_ns();
            g_aui_diag_cp_ms = i32((cp1 - cp0) / 1000000);
            g_aui_frame_blit = 1;
            let tb: i32 = trace_hex(68, bd);         // D + 直搬像素位移
            let pv: i32 = ((vpr - vpl) << 12) | ((vpb - vpt) & 4095);
            let tx: i32 = trace_hex(88, pv);         // X + 局部呈现尺寸
        } else if (pd != 0 && same != 0) {
            // Surface 返回的才是本轮必须重画的区域；空矩形说明它不接受
            // 局部，保守退回整屏。
            let rl: i32 = g_aui_dirty[0];
            let rt: i32 = g_aui_dirty[1];
            let rr: i32 = g_aui_dirty[2];
            let rb: i32 = g_aui_dirty[3];
            if (rl < 0) { rl = 0; }
            if (rt < 0) { rt = 0; }
            if (rr > w) { rr = w; }
            if (rb > h) { rb = h; }
            if (rr > rl && rb > rt) {
                g_aui_draw_on = 1;
                g_aui_draw_l = rl;
                g_aui_draw_t = rt;
                g_aui_draw_r = rr;
                g_aui_draw_b = rb;
                let rp2: i64 = clock_ns();
                n = draw_cmds(fbp, stride, fmt);
                let rp3: i64 = clock_ns();
                g_aui_diag_rp_ms = i32((rp3 - rp2) / 1000000);
                g_aui_diag_sh_ms = 0;
                g_aui_diag_re_ms = g_aui_diag_rp_ms;
                g_aui_fbuf_ok = 1;
                let cp2: i64 = clock_ns();
                let rc: i32 = fb_copy_win(fbp, bits, stride, bpp, w, rl, rt, rr, rb);
                let cp3: i64 = clock_ns();
                g_aui_diag_cp_ms = i32((cp3 - cp2) / 1000000);
                // v2.16.1：pd 来自动画损伤门时，记下实际重画的矩形（锁后
                // Surface 可能把它扩大）。波纹 pd 不记（ad==0）。
                if (ad != 0) {
                    g_aui_frame_dmg = 1;
                    g_aui_frame_dmg_l = rl;
                    g_aui_frame_dmg_t = rt;
                    g_aui_frame_dmg_r = rr;
                    g_aui_frame_dmg_b = rb;
                }
            } else {
                g_aui_draw_on = 0;
                let rp4: i64 = clock_ns();
                n = draw_cmds(fbp, stride, fmt);
                let rp5: i64 = clock_ns();
                g_aui_diag_rp_ms = i32((rp5 - rp4) / 1000000);
                g_aui_diag_sh_ms = 0;
                g_aui_diag_re_ms = g_aui_diag_rp_ms;
                g_aui_fbuf_ok = 1;
                let cp4: i64 = clock_ns();
                let rc: i32 = fb_copy_win(fbp, bits, stride, bpp, w, 0, 0, w, h);
                let cp5: i64 = clock_ns();
                g_aui_diag_cp_ms = i32((cp5 - cp4) / 1000000);
            }
            // v1.48.4：X = 本轮局部呈现实际重画的宽高（宽 << 12 | 高，像素）。
            let pw: i32 = g_aui_dirty[2] - g_aui_dirty[0];
            let ph: i32 = g_aui_dirty[3] - g_aui_dirty[1];
            if (pw < 0) { pw = 0; }
            if (ph < 0) { ph = 0; }
            let pv2: i32 = (pw << 12) | (ph & 4095);
            let tx2: i32 = trace_hex(88, pv2);
        } else if (fits != 0) {
            // 整屏帧：画进帧缓冲再整块拷给窗口，帧缓冲从此与窗口一致。
            g_aui_draw_on = 0;
            let rp6: i64 = clock_ns();
            n = draw_cmds(fbp, stride, fmt);
            let rp7: i64 = clock_ns();
            g_aui_diag_rp_ms = i32((rp7 - rp6) / 1000000);
            g_aui_diag_sh_ms = 0;
            g_aui_diag_re_ms = g_aui_diag_rp_ms;
            g_aui_fbuf_ok = 1;
            let cp6: i64 = clock_ns();
            let rc2: i32 = fb_copy_win(fbp, bits, stride, bpp, w, 0, 0, w, h);
            let cp7: i64 = clock_ns();
            g_aui_diag_cp_ms = i32((cp7 - cp6) / 1000000);
        } else {
            // 分辨率超过帧缓冲上限：维持旧路径，直接画进窗口。
            g_aui_draw_on = 0;
            let rp8: i64 = clock_ns();
            n = draw_cmds(bits, stride, fmt);
            let rp9: i64 = clock_ns();
            g_aui_diag_rp_ms = i32((rp9 - rp8) / 1000000);
            g_aui_diag_sh_ms = 0;
            g_aui_diag_re_ms = g_aui_diag_rp_ms;
            g_aui_diag_cp_ms = 0;
            g_aui_fbuf_ok = 0;
        }
    }
    let d1: i64 = clock_ns();
    let dd: i32 = i32((d1 - d0) / 1000000);
    let tc: i32 = trace_hex(67, dd);                     // C + 光栅耗时(ms)
    g_aui_draw_on = 0;
    // v1.48.6：命令快照改到呈现之后拍，代表“屏幕上的这一帧”，直搬比较
    // 的基线才是准的。
    // v2.16.1：每张已呈现帧都补拍（不只 build 帧），否则动画损伤重画
    // 没有上一帧基线可比。快照是命令表拷贝（~200 条 × 64 B），相对
    // 一次整屏重画可忽略；直搬/波纹的比较基线仍是“上一张已呈现帧”，
    // 语义不变。没画出来（锁不到缓冲）时不拍，基线仍是上一张已呈现帧。
    if (bits != 0 && w > 0 && h > 0) {
        let sn: i32 = cmd_snapshot();
        g_aui_snap_pending = 0;
    }
    let st: i32 = fb_state_store();
    let u0: i64 = clock_ns();
    let up: i32 = ANativeWindow_unlockAndPost(g_aui_win);
    let u1: i64 = clock_ns();
    let ud: i32 = i32((u1 - u0) / 1000000);
    let tu: i32 = trace_hex(116, ud);                    // t + 提交耗时(ms)
    g_aui_paint_seq = g_aui_paint_seq + 1;               // 供帧源自检排除“别的回调在画”
    // v2.8：DEBUG overlay 指标采样（只在真机呈现路径记；headless 不走）。
    let dbg_sm: i32 = dbg_sample_frame(dd, g_aui_frame_blit);
    let tf: i32 = trace_mark(70);                        // F = 首帧/帧呈现完成
    // v2.7.1-diag：滚动帧摘要（只在拖动/惯性滚动进行时记一行；w=锁等
    // 待ms，c=光栅ms，t=提交ms，bl=直搬计划，blit=实际直搬，same=帧
    // 缓冲匹配，miss/evict=字形缓存累计，off=当前滚动偏移px，mv=自
    // 上帧的 MOVE 事件数）。v2.7.2 加 rp/cp；v2.7.3 加 sh/re
    // （sh=直搬移位ms，re=命令重放ms；直搬帧 sh+re≈rp，整屏帧 re=rp）。
    let skey: i32 = active_scroll_key();
    if (skey != 0) {
        let soff: i32 = aui_debug_scroll(skey);
        let smv: i32 = g_aui_diag_moves - g_aui_diag_moves_last;
        g_aui_diag_moves_last = g_aui_diag_moves;
        let sb0: i32 = aui_log_msg_begin();
        let ss0: i32 = aui_log_msg_str("scroll frame w=");
        let si0: i32 = aui_log_msg_i32(zd);
        let ss1: i32 = aui_log_msg_str("ms c=");
        let si1: i32 = aui_log_msg_i32(dd);
        let ss10: i32 = aui_log_msg_str("ms rp=");
        let si10: i32 = aui_log_msg_i32(g_aui_diag_rp_ms);
        let ss11: i32 = aui_log_msg_str("ms cp=");
        let si11: i32 = aui_log_msg_i32(g_aui_diag_cp_ms);
        let ss12: i32 = aui_log_msg_str("ms sh=");
        let si12: i32 = aui_log_msg_i32(g_aui_diag_sh_ms);
        let ss13: i32 = aui_log_msg_str("ms re=");
        let si13: i32 = aui_log_msg_i32(g_aui_diag_re_ms);
        let ss2: i32 = aui_log_msg_str("ms t=");
        let si2: i32 = aui_log_msg_i32(ud);
        let ss3: i32 = aui_log_msg_str("ms bl=");
        let si3: i32 = aui_log_msg_i32(bl);
        let ss4: i32 = aui_log_msg_str(" blit=");
        let si4: i32 = aui_log_msg_i32(g_aui_frame_blit);
        // v2.19.2：计划 fail 码（0 = 直搬成功；1 轻布局、4 视口未登记、
        // 5 滚动键、11 无位移、12 位移超视口、13 命令检查，余见
        // scroll_blit_plan）：v2.19.1 的真机 verdict 226 帧全 blit=0 却
        // 无 fail 码，钉不死失败检查；此后真机日志直接读码。
        let ss17: i32 = aui_log_msg_str(" fail=");
        let si17: i32 = aui_log_msg_i32(g_aui_blit_fail);
        let ss5: i32 = aui_log_msg_str(" same=");
        let si5: i32 = aui_log_msg_i32(same);
        let ss6: i32 = aui_log_msg_str(" miss=");
        let si6: i32 = aui_log_msg_i32(ui_tt_cache_misses());
        let ss7: i32 = aui_log_msg_str(" evict=");
        let si7: i32 = aui_log_msg_i32(ui_tt_cache_evictions());
        let ss8: i32 = aui_log_msg_str(" off=");
        let si8: i32 = aui_log_msg_i32(soff);
        let ss9: i32 = aui_log_msg_str(" mv=");
        let si9: i32 = aui_log_msg_i32(smv);
        // v2.17.1：横向偏移 + 惯性/拖动标志（非表格时 offx=0）。松手后泵
        // 空转的那轮日志缺横向偏移，分不清“惯性还在跑”还是“手指没抬”。
        let ss14: i32 = aui_log_msg_str(" offx=");
        let si14: i32 = aui_log_msg_i32(vtable_off_x(skey));
        let ss15: i32 = aui_log_msg_str(" fl=");
        let si15: i32 = aui_log_msg_i32(g_aui_fling_active);
        let ss16: i32 = aui_log_msg_str(" dg=");
        let si16: i32 = aui_log_msg_i32(g_aui_dragging);
        let sm: ptr = aui_log_msg_end();
        let sl: i32 = aui_log(4, sm);
    }
    // v2.19.2：启动版本号行（只记一次）：与 Gallery System 标签页读同
    // 一份常量（aui_set_app_version 登记的值）。放在 present 末尾：首帧
    // 的 build 已跑过，应用的版本号已登记；attach 时 build 还没跑。
    if (g_aui_ver_logged == 0) {
        g_aui_ver_logged = 1;
        let vb0: i32 = aui_log_msg_begin();
        let vs0: i32 = aui_log_msg_str("aui: version ");
        if (g_aui_app_ver_name != 0) {
            let vs1: i32 = aui_log_msg_str(g_aui_app_ver_name);
        } else {
            let vs1b: i32 = aui_log_msg_str("?");
        }
        let vs2: i32 = aui_log_msg_str(" code ");
        let vi2: i32 = aui_log_msg_i32(g_aui_app_ver_code);
        let vm: ptr = aui_log_msg_end();
        let vl: i32 = aui_log(4, vm);
    }
    // Phase 0：提交完成，封存帧区（下一 build 开始时由 aui_root 清零）。
    g_aui_frame_sealed = 1;
    return n;
}

fn aui_frame(now_ns: i64) : i32 {
    // 定时器/测试可以显式给时间；普通 onRedraw 传 0，由这里补当前时钟。
    let t: i64 = now_ns;
    if (g_aui_anim_fake != 0) {
        g_aui_anim_now = t;
    } else if (t <= 0 && (g_aui_fling_active != 0 || anim_active_count() != 0 ||
                          ripple_busy() != 0 ||
                          g_aui_page_on != 0 || pager_anim_count() != 0 ||
                          refresh_busy() != 0 || present_busy() != 0)) {
        t = clock_ns();
        g_aui_anim_now = t;
    } else if (t > 0) {
        g_aui_anim_now = t;
    }
    if (t > 0 || g_aui_anim_fake != 0) {
        let f: i32 = fling_step(t);
        let p: i32 = pager_step(t);
        let a: i32 = anim_step(t);
        let g: i32 = page_step(t);
        let rf: i32 = ref_step(t);
        let sp: i32 = spin_step(t);
        let rp: i32 = ripple_step(t);
    }
    let c: i32 = pump_ui();
    let p: i32 = present_now();
    return c;
}

// ===========================================================================
// 8b. 惯性滚动（v1.6）
// ===========================================================================

fn clock_ns() : i64 {
    let r: i32 = clock_gettime(1, &g_aui_ts);   // CLOCK_MONOTONIC
    if (r != 0) { return 0; }
    return g_aui_ts.sec * 1000000000 + g_aui_ts.nsec;
}

// ===========================================================================
// 8c. 动画槽（v1.10）
// ===========================================================================

fn anim_now() : i64 {
    if (g_aui_anim_fake != 0) { return g_aui_anim_now; }
    let t: i64 = clock_ns();
    return t;
}

// v1.32：不确定进度圈的相位。900 ms 一圈；用整型减法取模，避免依赖
// i64 取模。假时钟（aui_debug_set_time）下同样有效，测试可精确断言。
fn spin_phase_at(t: i64) : i32 {
    let ms: i64 = t / 1000000;
    let q: i64 = ms / 900;
    let m: i64 = ms - q * 900;
    if (m < 0) { m = m + 900; }
    return i32((m * 65536) / 900);
}

fn spin_phase_now() : i32 {
    return spin_phase_at(anim_now());
}

// 每帧推进一次：相位变了就标脏，让帧泵持续出帧。和下拉刷新的旋转
// 一样，只有存在不确定进度圈时才工作。
fn spin_step(now: i64) : i32 {
    if (g_aui_spin_live == 0) { return 0; }
    let p: i32 = spin_phase_at(now);
    if (p != g_aui_spin_phase) {
        g_aui_spin_phase = p;
        g_aui_need_paint = 1;
        return 1;
    }
    return 0;
}

fn anim_lerp(a: i32, b: i32, t: i32) : i32 {
    let d: i64 = i64(b) - i64(a);
    let p: i64 = d * i64(t);
    let q: i64 = p + 32768;
    return a + i32(q >> 16);
}

fn anim_ease(t: i32, curve: i32) : i32 {
    if (t <= 0) { return 0; }
    if (t >= 65536) { return 65536; }
    if (curve == 1) {                         // ease-out quad
        let inv: i64 = i64(65536 - t);
        let sq: i64 = inv * inv;
        let q: i64 = sq >> 16;
        return 65536 - i32(q);
    }
    if (curve == 2) {                         // smoothstep
        let ti: i64 = i64(t);
        let sq: i64 = ti * ti;
        let q: i64 = sq >> 16;
        let u: i64 = i64(196608 - t * 2);
        let p: i64 = q * u;
        return i32(p >> 16);
    }
    if (curve == 3) {                         // ease-in quad t^2
        let ti: i64 = i64(t);
        let sq: i64 = ti * ti;
        return i32(sq >> 16);
    }
    return t;
}

fn anim_find(key: i32, prop: i32) : i32 {
    let i: i32 = 0;
    while (i < g_aui_anim_used) {
        if (g_aui_anim_key[i] == key && g_aui_anim_prop[i] == prop) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn anim_alloc() : i32 {
    let i: i32 = 0;
    while (i < AUI_ANIM_CAP) {
        if (g_aui_anim_key[i] == 0) { return i; }
        i = i + 1;
    }
    // 全满：淘汰一个已经结束、且最久没在本轮 build 出现的槽。
    let best: i32 = -1;
    let bs: i32 = 2147483647;
    i = 0;
    while (i < AUI_ANIM_CAP) {
        if (g_aui_anim_on[i] == 0 && g_aui_anim_seen[i] < bs) {
            bs = g_aui_anim_seen[i];
            best = i;
        }
        i = i + 1;
    }
    if (best >= 0) { return best; }
    return -1;                                // 64 个都在跑：拒绝新动画
}

fn anim_active_count() : i32 {
    let n: i32 = 0;
    let i: i32 = 0;
    while (i < g_aui_anim_used) {
        if (g_aui_anim_on[i] != 0) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

// 每个节点绘制前调用一次：把该 key 的 alpha/tx/ty/scale 写进 out[4]。
// scale 为 Q16.16（65536 = 1.0x）；VALUE 属性不画，忽略。
fn anim_apply(key: i32, out: ptr) : i32 {
    *(out + 0) = 255;
    *(out + 4) = 0;
    *(out + 8) = 0;
    *(out + 12) = 65536;
    if (key == 0 || g_aui_anim_used == 0) { return 0; }
    let i: i32 = 0;
    while (i < g_aui_anim_used) {
        if (g_aui_anim_key[i] == key) {
            let p: i32 = g_aui_anim_prop[i];
            if (p == AUI_ANIM_ALPHA) { *(out + 0) = g_aui_anim_val[i]; }
            if (p == AUI_ANIM_TX) { *(out + 4) = g_aui_anim_val[i]; }
            if (p == AUI_ANIM_TY) { *(out + 8) = g_aui_anim_val[i]; }
            if (p == AUI_ANIM_SCALE) { *(out + 12) = g_aui_anim_val[i]; }
        }
        i = i + 1;
    }
    return 0;
}

// v2.16：整数开方（牛顿迭代，i64；k<<16 的平方根，供弹簧阻尼系数用）。
fn anim_isqrt(n: i64) : i64 {
    if (n <= 0) { return 0; }
    let x: i64 = n;
    let y: i64 = (x + 1) / 2;
    while (y < x) {
        x = y;
        y = (x + n / x) / 2;
    }
    return x;
}

// SCALE 属性值域（Q16.16）：0.01x..4x；0 会压扁成点，禁止。
fn anim_scale_clamp(v: i32) : i32 {
    if (v < 655) { return 655; }
    if (v > 262144) { return 262144; }
    return v;
}

// 槽的当前默认值（无槽时）：ALPHA 255，SCALE 1.0x，其余 0。
fn anim_default_value(prop: i32) : i32 {
    if (prop == AUI_ANIM_ALPHA) { return 255; }
    if (prop == AUI_ANIM_SCALE) { return 65536; }
    return 0;
}

// 槽自然结束：落到终值、停表、把完成回调排进本拍待调队列（anim_step
// 循环结束后再调，避免回调里改表撞上正在进行的遍历）。
fn anim_finish_slot(i: i32, end_value: i32) : i32 {
    g_aui_anim_val[i] = end_value;
    g_aui_anim_on[i] = 0;
    g_aui_anim_spr_v[i] = 0;
    // v2.16.2-diag：完成行（真机 slide-in 消失排查：重播行 + 完成行
    // 成对出现才证明动画在真机上跑完；量小，只有自然结束的槽才记）。
    let dl: i32 = aui_log3(4, "anim done key=", g_aui_anim_key[i], " prop=", g_aui_anim_prop[i], " val=", end_value, "");
    if (g_aui_anim_cb[i] != 0 && g_aui_anim_done_n < 64) {
        g_aui_anim_done_cb[g_aui_anim_done_n] = g_aui_anim_cb[i];
        g_aui_anim_done_user[g_aui_anim_done_n] = g_aui_anim_cb_user[i];
        g_aui_anim_done_n = g_aui_anim_done_n + 1;
    }
    g_aui_anim_cb[i] = 0;
    g_aui_anim_cb_user[i] = 0;
    g_aui_need_paint = 1;
    return 0;
}

fn anim_fire_done() : i32 {
    let k: i32 = 0;
    while (k < g_aui_anim_done_n) {
        let cb: fn(ptr) : i32 = g_aui_anim_done_cb[k];
        let user: ptr = g_aui_anim_done_user[k];
        g_aui_anim_done_cb[k] = 0;
        g_aui_anim_done_user[k] = 0;
        if (cb != 0) {
            let r: i32 = cb(user);
        }
        k = k + 1;
    }
    g_aui_anim_done_n = 0;
    return 0;
}

// 改道/重定向统一清完成回调：新动画的完成归新回调管，旧回调不再触发。
fn anim_clear_cb(i: i32) : i32 {
    g_aui_anim_cb[i] = 0;
    g_aui_anim_cb_user[i] = 0;
    return 0;
}

fn anim_begin(key: i32, prop: i32, from: i32, to: i32,
              ms: i32, curve: i32) : i32 {
    if (key <= 0) { return -1; }
    if (prop < AUI_ANIM_ALPHA || prop > AUI_ANIM_VALUE) { return -1; }
    if (prop == AUI_ANIM_ALPHA) {
        if (from < 0) { from = 0; }
        if (from > 255) { from = 255; }
        if (to < 0) { to = 0; }
        if (to > 255) { to = 255; }
    }
    if (prop == AUI_ANIM_SCALE) {
        from = anim_scale_clamp(from);
        to = anim_scale_clamp(to);
    }
    if (curve < 0 || curve > 3) { curve = 0; }
    let i: i32 = anim_find(key, prop);
    if (i >= 0) {
        g_aui_anim_seen[i] = g_aui_anim_seq;
        // 补间目标没变：保持进度（v1.10 行为）——只对还在跑的槽。
        // v2.16.2：已结束的槽（on==0）必须重播；旧条件不看 on，第一次
        // 滑入结束后每次点 Replay 都命中这支路直接 return 0，什么都
        // 不重启动（Gallery 2435 真机问题）。
        if (g_aui_anim_mode[i] == AUI_ANIM_MODE_TWEEN &&
            g_aui_anim_to[i] == to && g_aui_anim_on[i] != 0) { return 0; }
        if (g_aui_anim_on[i] != 0) {
            from = g_aui_anim_val[i];               // 运行中：从当前值改道
        } else {
            // 已结束：保留请求的 from（重播）；若改用当前值（== 旧 to），
            // 当新 to 也等于它时 from==to，动画会直接落点不播放。
            let dl: i32 = aui_log3(4, "anim replay key=", key, " prop=", prop, " from=", from, "");
        }
        let cc: i32 = anim_clear_cb(i);
    } else {
        i = anim_alloc();
        if (i < 0) { return -1; }
        g_aui_anim_key[i] = key;
        g_aui_anim_prop[i] = prop;
        if (i >= g_aui_anim_used) { g_aui_anim_used = i + 1; }
    }
    g_aui_anim_mode[i] = AUI_ANIM_MODE_TWEEN;
    g_aui_anim_from[i] = from;
    g_aui_anim_to[i] = to;
    g_aui_anim_val[i] = from;
    g_aui_anim_curve[i] = curve;
    g_aui_anim_seen[i] = g_aui_anim_seq;
    let dur: i64 = i64(ms) * 1000000;
    if (dur <= 0 || from == to || g_aui_reduced_motion != 0) {
        g_aui_anim_val[i] = to;
        g_aui_anim_on[i] = 0;
    } else {
        g_aui_anim_start[i] = anim_now();
        g_aui_anim_dur[i] = dur;
        g_aui_anim_on[i] = 1;
        let ar: i32 = frame_timer_arm();
    }
    g_aui_need_paint = 1;
    return 0;
}

// v2.16：弹簧（HuxerUI SpringSpec：stiffness 劲度 1/s^2，damping_ratio
// 阻尼比；默认值 320 / 0.82 与 HuxerUI 相同）。从当前值、当前速度出发；
// 已在跑的弹簧改目标时保留速度（手势交接）。减弱动效时直接落到终值。
fn anim_begin_spring(key: i32, prop: i32, target: i32,
                     stiffness: i32, damping_pm: i32) : i32 {
    if (key <= 0) { return -1; }
    if (prop < AUI_ANIM_ALPHA || prop > AUI_ANIM_VALUE) { return -1; }
    if (prop == AUI_ANIM_ALPHA) {
        if (target < 0) { target = 0; }
        if (target > 255) { target = 255; }
    }
    if (prop == AUI_ANIM_SCALE) { target = anim_scale_clamp(target); }
    if (stiffness < 1) { stiffness = 1; }
    if (stiffness > 2000) { stiffness = 2000; }
    if (damping_pm < 0) { damping_pm = 0; }
    if (damping_pm > 2000) { damping_pm = 2000; }
    let start_val: i32 = anim_default_value(prop);
    let i: i32 = anim_find(key, prop);
    if (i >= 0) {
        g_aui_anim_seen[i] = g_aui_anim_seq;
        start_val = g_aui_anim_val[i];
        // 同目标、同参数、已在跑：不动。
        if (g_aui_anim_mode[i] == AUI_ANIM_MODE_SPRING &&
            g_aui_anim_to[i] == target &&
            g_aui_anim_stiff[i] == stiffness &&
            g_aui_anim_damp[i] == damping_pm &&
            g_aui_anim_on[i] != 0) { return 0; }
        let cc: i32 = anim_clear_cb(i);
        // 弹簧改道保留位置与速度；从补间/关键帧切过来时速度清零。
        if (g_aui_anim_mode[i] != AUI_ANIM_MODE_SPRING) {
            g_aui_anim_spr_x[i] = i64(start_val) << 16;
            g_aui_anim_spr_v[i] = 0;
        }
    } else {
        i = anim_alloc();
        if (i < 0) { return -1; }
        g_aui_anim_key[i] = key;
        g_aui_anim_prop[i] = prop;
        if (i >= g_aui_anim_used) { g_aui_anim_used = i + 1; }
        g_aui_anim_spr_x[i] = i64(start_val) << 16;
        g_aui_anim_spr_v[i] = 0;
    }
    g_aui_anim_mode[i] = AUI_ANIM_MODE_SPRING;
    g_aui_anim_from[i] = start_val;
    g_aui_anim_to[i] = target;
    g_aui_anim_val[i] = start_val;
    g_aui_anim_stiff[i] = stiffness;
    g_aui_anim_damp[i] = damping_pm;
    g_aui_anim_seen[i] = g_aui_anim_seq;
    if (start_val == target || g_aui_reduced_motion != 0) {
        g_aui_anim_val[i] = target;
        g_aui_anim_spr_x[i] = i64(target) << 16;
        g_aui_anim_spr_v[i] = 0;
        g_aui_anim_on[i] = 0;
    } else {
        g_aui_anim_start[i] = anim_now();
        g_aui_anim_last[i] = g_aui_anim_start[i];
        g_aui_anim_dur[i] = 0;
        g_aui_anim_on[i] = 1;
        let ar: i32 = frame_timer_arm();
    }
    g_aui_need_paint = 1;
    return 0;
}

// v2.16：关键帧（HuxerUI KeyframeSpec：duration + 有序关键帧，
// fraction/progress 均为千分比，端点固定 0 → 1000）。repeat：0 一次，
// >0 指定次数，-1 无限；rmode：0 每轮重起，1 往返。改道时 from 取当前值
// （与补间/弹簧一致），传入的 from 只用于新建槽。
fn anim_begin_keyframe(key: i32, prop: i32, from: i32, to: i32,
                       ms: i32, n: i32, fracs: ptr, progs: ptr,
                       curves: ptr, repeat: i32, rmode: i32) : i32 {
    if (key <= 0) { return -1; }
    if (prop < AUI_ANIM_ALPHA || prop > AUI_ANIM_VALUE) { return -1; }
    if (n < 2 || n > 8) { return -1; }
    if (fracs == 0 || progs == 0 || curves == 0) { return -1; }
    if (repeat < -1) { repeat = -1; }
    if (rmode != 0 && rmode != 1) { rmode = 0; }
    // 逐项校验关键帧表（端点 + 严格递增 + 进度范围）。
    let j: i32 = 0;
    while (j < n) {
        let f: i32 = *(fracs + j * 4);
        let p: i32 = *(progs + j * 4);
        let c: i32 = *(curves + j * 4);
        if (p < 0 || p > 1000) { return -1; }
        if (c < 0 || c > 3) { return -1; }
        if (j == 0 && (f != 0 || p != 0)) { return -1; }
        if (j == n - 1 && (f != 1000 || p != 1000)) { return -1; }
        if (j > 0 && f <= *(fracs + (j - 1) * 4)) { return -1; }
        j = j + 1;
    }
    if (prop == AUI_ANIM_ALPHA) {
        if (from < 0) { from = 0; }
        if (from > 255) { from = 255; }
        if (to < 0) { to = 0; }
        if (to > 255) { to = 255; }
    }
    if (prop == AUI_ANIM_SCALE) {
        from = anim_scale_clamp(from);
        to = anim_scale_clamp(to);
    }
    let i: i32 = anim_find(key, prop);
    if (i >= 0) {
        g_aui_anim_seen[i] = g_aui_anim_seq;
        // v2.16.2：改道从当前值起只对还在跑的槽；已结束的槽用请求的
        // from 重播，否则 from==旧终值==to，动画直接落点不播放
        // （与补间同一类问题；脉冲 Stop 后 Start 因 reset 删槽不受影响）。
        if (g_aui_anim_on[i] != 0) {
            from = g_aui_anim_val[i];
        }
        let cc: i32 = anim_clear_cb(i);
    } else {
        i = anim_alloc();
        if (i < 0) { return -1; }
        g_aui_anim_key[i] = key;
        g_aui_anim_prop[i] = prop;
        if (i >= g_aui_anim_used) { g_aui_anim_used = i + 1; }
    }
    g_aui_anim_mode[i] = AUI_ANIM_MODE_KEYFRAME;
    g_aui_anim_from[i] = from;
    g_aui_anim_to[i] = to;
    g_aui_anim_val[i] = from;
    g_aui_anim_kf_n[i] = n;
    g_aui_anim_repeat[i] = repeat;
    g_aui_anim_rmode[i] = rmode;
    j = 0;
    while (j < n) {
        g_aui_anim_kf_frac[i * 8 + j] = *(fracs + j * 4);
        g_aui_anim_kf_prog[i * 8 + j] = *(progs + j * 4);
        g_aui_anim_kf_curve[i * 8 + j] = *(curves + j * 4);
        j = j + 1;
    }
    g_aui_anim_seen[i] = g_aui_anim_seq;
    let dur: i64 = i64(ms) * 1000000;
    if (dur <= 0 || from == to || g_aui_reduced_motion != 0) {
        g_aui_anim_val[i] = to;
        g_aui_anim_on[i] = 0;
    } else {
        g_aui_anim_start[i] = anim_now();
        g_aui_anim_dur[i] = dur;
        g_aui_anim_on[i] = 1;
        let ar: i32 = frame_timer_arm();
    }
    g_aui_need_paint = 1;
    return 0;
}

// 关键帧单轮求值：elapsed_ns 为本轮内已过时间（0..dur），返回插值。
fn anim_kf_value(i: i32, elapsed_ns: i64) : i32 {
    let dur: i64 = g_aui_anim_dur[i];
    let t_pm: i64 = 0;
    if (dur > 0) { t_pm = (elapsed_ns * 1000) / dur; }
    if (t_pm < 0) { t_pm = 0; }
    if (t_pm > 1000) { t_pm = 1000; }
    let n: i32 = g_aui_anim_kf_n[i];
    let j: i32 = 0;
    while (j < n - 1 && t_pm >= i64(g_aui_anim_kf_frac[i * 8 + j + 1])) {
        j = j + 1;
    }
    let f0: i64 = i64(g_aui_anim_kf_frac[i * 8 + j]);
    let f1: i64 = i64(g_aui_anim_kf_frac[i * 8 + j + 1]);
    let p0: i64 = i64(g_aui_anim_kf_prog[i * 8 + j]);
    let p1: i64 = i64(g_aui_anim_kf_prog[i * 8 + j + 1]);
    let u_pm: i64 = 0;
    if (f1 > f0) { u_pm = (t_pm - f0) * 1000 / (f1 - f0); }
    let u: i32 = i32(u_pm * 65536 / 1000);
    let e: i32 = anim_ease(u, g_aui_anim_kf_curve[i * 8 + j]);
    let prog: i64 = p0 + ((p1 - p0) * i64(e) >> 16);
    let from: i64 = i64(g_aui_anim_from[i]);
    let to: i64 = i64(g_aui_anim_to[i]);
    return i32(from + (to - from) * prog / 1000);
}

fn anim_step(now: i64) : i32 {
    if (g_aui_anim_used == 0) { return 0; }
    let changed: i32 = 0;
    let live: i32 = 0;
    let i: i32 = 0;
    while (i < g_aui_anim_used) {
        if (g_aui_anim_on[i] != 0) {
            // 减弱动效：运行中的动画立刻落到终值（关键帧也落到 to），
            // 完成回调照常触发一次。
            if (g_aui_reduced_motion != 0) {
                let oldv: i32 = g_aui_anim_val[i];
                let fs: i32 = anim_finish_slot(i, g_aui_anim_to[i]);
                if (g_aui_anim_val[i] != oldv) { changed = 1; }
                i = i + 1;
                continue;
            }
            if (g_aui_anim_mode[i] == AUI_ANIM_MODE_SPRING) {
                // ---- 弹簧：半隐式欧拉，dt 取帧间隔（夹 [0, 64 ms]）----
                // 大步长要分子步：单步 64 ms 时 ω·dt ≈ 1.1（劲度 320），
                // 一步就冲过目标 30% 以上；按 ≤ 16 ms 切分（最多 4 子步），
                // 每子步 ω·dt ≤ 0.29，积分才准。帧卡顿也不炸。
                let dt_ns: i64 = now - g_aui_anim_last[i];
                if (dt_ns < 0) { dt_ns = 0; }
                if (dt_ns > 64000000) { dt_ns = 64000000; }
                g_aui_anim_last[i] = now;
                let k: i64 = i64(g_aui_anim_stiff[i]);
                // √k 的定点：isqrt(k<<16) 得 √k 的 Q8.8，×256 才是
                // Q16.16；阻尼 c = 2ζ√k 也取 Q16.16（写错一位会让
                // 阻尼弱 256 倍、弹簧近乎无阻尼振荡）。
                let sq: i64 = anim_isqrt(k << 16);
                let c_q: i64 = (2 * i64(g_aui_anim_damp[i]) * sq * 256) / 1000;
                let tgt: i64 = i64(g_aui_anim_to[i]) << 16;
                let xmax: i64 = i64(2147483647) << 16;
                let rem: i64 = dt_ns;
                while (rem > 0) {
                    let h_ns: i64 = rem;
                    if (h_ns > 16000000) { h_ns = 16000000; }
                    rem = rem - h_ns;
                    let dt_q: i64 = (h_ns * 65536) / 1000000000;
                    let x: i64 = g_aui_anim_spr_x[i];
                    let v: i64 = g_aui_anim_spr_v[i];
                    let a: i64 = -(k * (x - tgt) + ((c_q * v) >> 16));
                    let v2: i64 = v + ((a * dt_q) >> 16);
                    let x2: i64 = x + ((v2 * dt_q) >> 16);
                    // 防溢出夹（VALUE 属性值域大时）：钳住位置、速度清零。
                    let x3: i64 = x2;
                    let v3: i64 = v2;
                    if (x3 > xmax) { x3 = xmax; v3 = 0; }
                    if (x3 < -xmax) { x3 = -xmax; v3 = 0; }
                    g_aui_anim_spr_x[i] = x3;
                    g_aui_anim_spr_v[i] = v3;
                    let nv: i32 = i32(x3 >> 16);
                    if (nv != g_aui_anim_val[i]) {
                        g_aui_anim_val[i] = nv;
                        changed = 1;
                    }
                    let dx: i64 = x3 - tgt;
                    if (dx < 0) { dx = -dx; }
                    let av: i64 = v3;
                    if (av < 0) { av = -av; }
                    if (dx <= 256 && av <= 8192) {
                        let fs: i32 = anim_finish_slot(i, g_aui_anim_to[i]);
                        rem = 0;
                    } else if (now - g_aui_anim_start[i] >= 5000000000) {
                        // 5 s 硬上限：数值不收敛时强制落到终值，不无限跑。
                        let fs2: i32 = anim_finish_slot(i, g_aui_anim_to[i]);
                        rem = 0;
                    }
                }
            } else if (g_aui_anim_mode[i] == AUI_ANIM_MODE_KEYFRAME) {
                // ---- 关键帧：按轮次/方向求值 ----
                let el: i64 = now - g_aui_anim_start[i];
                if (el < 0) { el = 0; }
                let dur: i64 = g_aui_anim_dur[i];
                let total: i32 = g_aui_anim_repeat[i];
                if (total == 0) { total = 1; }
                if (total < 0) {
                    // 无限重复：只求本轮值，永不结束。
                    let iter: i64 = el / dur;
                    let within: i64 = el - iter * dur;
                    let fwd: i32 = 1;
                    if (g_aui_anim_rmode[i] == 1 && (iter % 2) != 0) { fwd = 0; }
                    let tt: i64 = within;
                    if (fwd == 0) { tt = dur - within; }
                    let nv: i32 = anim_kf_value(i, tt);
                    if (nv != g_aui_anim_val[i]) {
                        g_aui_anim_val[i] = nv;
                        changed = 1;
                    }
                } else {
                    let total_ns: i64 = dur * i64(total);
                    if (el >= total_ns) {
                        // 最后一轮方向决定终值：正向 → to，往返 → from。
                        let last: i32 = total - 1;
                        let fwd: i32 = 1;
                        if (g_aui_anim_rmode[i] == 1 && (last % 2) != 0) { fwd = 0; }
                        let endv: i32 = g_aui_anim_to[i];
                        if (fwd == 0) { endv = g_aui_anim_from[i]; }
                        let oldv: i32 = g_aui_anim_val[i];
                        let fs: i32 = anim_finish_slot(i, endv);
                        if (g_aui_anim_val[i] != oldv) { changed = 1; }
                    } else {
                        let iter: i64 = el / dur;
                        let within: i64 = el - iter * dur;
                        let fwd: i32 = 1;
                        if (g_aui_anim_rmode[i] == 1 && (iter % 2) != 0) { fwd = 0; }
                        let tt: i64 = within;
                        if (fwd == 0) { tt = dur - within; }
                        let nv: i32 = anim_kf_value(i, tt);
                        if (nv != g_aui_anim_val[i]) {
                            g_aui_anim_val[i] = nv;
                            changed = 1;
                        }
                    }
                }
            } else {
                // ---- 补间（v1.10 逻辑不变）----
                let v: i32 = g_aui_anim_val[i];
                if (now <= g_aui_anim_start[i]) {
                    v = g_aui_anim_from[i];
                } else {
                    let el: i64 = now - g_aui_anim_start[i];
                    if (el >= g_aui_anim_dur[i]) {
                        let oldv: i32 = g_aui_anim_val[i];
                        v = g_aui_anim_to[i];
                        let fs: i32 = anim_finish_slot(i, v);
                        if (v != oldv) { changed = 1; }
                    } else {
                        let t: i32 = i32((el * 65536) / g_aui_anim_dur[i]);
                        let e: i32 = anim_ease(t, g_aui_anim_curve[i]);
                        v = anim_lerp(g_aui_anim_from[i], g_aui_anim_to[i], e);
                    }
                }
                if (v != g_aui_anim_val[i]) {
                    g_aui_anim_val[i] = v;
                    changed = 1;
                }
            }
            if (g_aui_anim_on[i] != 0) { live = live + 1; }
        }
        i = i + 1;
    }
    if (changed != 0) { g_aui_need_paint = 1; }
    if (live == 0 && g_aui_fling_active == 0 && g_aui_page_on == 0 &&
        pager_anim_count() == 0 && refresh_busy() == 0) {
        let d: i32 = frame_timer_disarm();
    }
    // 完成回调在本拍遍历结束后再调：回调里建新动画不会撞上遍历。
    if (g_aui_anim_done_n != 0) {
        let fd: i32 = anim_fire_done();
    }
    return changed;
}

fn anim_reset(key: i32, prop: i32) : i32 {
    let i: i32 = anim_find(key, prop);
    if (i < 0) { return 0; }
    // 取消：停表、删槽、丢掉待触发的完成回调（不调它）；槽删掉后
    // 读值走默认值（VALUE/TX/TY 为 0，ALPHA 255，SCALE 65536），
    // 这是 v1.10 的既有约定（aui_anim_value 无槽时返回默认）。
    g_aui_anim_on[i] = 0;
    g_aui_anim_key[i] = 0;
    g_aui_anim_prop[i] = 0;
    g_aui_anim_val[i] = 0;
    g_aui_anim_seen[i] = 0;
    g_aui_anim_mode[i] = 0;
    g_aui_anim_stiff[i] = 0;
    g_aui_anim_damp[i] = 0;
    g_aui_anim_last[i] = 0;
    g_aui_anim_spr_x[i] = 0;
    g_aui_anim_spr_v[i] = 0;
    g_aui_anim_kf_n[i] = 0;
    g_aui_anim_repeat[i] = 0;
    g_aui_anim_rmode[i] = 0;
    g_aui_anim_cb[i] = 0;
    g_aui_anim_cb_user[i] = 0;
    // 动画只影响绘制，删除槽不需要重建节点树。
    g_aui_need_paint = 1;
    if (anim_active_count() == 0 && g_aui_fling_active == 0 &&
        g_aui_page_on == 0 && pager_anim_count() == 0 && refresh_busy() == 0) {
        let d: i32 = frame_timer_disarm();
    }
    return 0;
}

fn aui_anim(key: i32, prop: i32, from: i32, to: i32,
            duration_ms: i32, curve: i32) : i32 {
    return anim_begin(key, prop, from, to, duration_ms, curve);
}

fn aui_anim_spring(key: i32, prop: i32, target: i32,
                   stiffness: i32, damping_pm: i32) : i32 {
    return anim_begin_spring(key, prop, target, stiffness, damping_pm);
}

fn aui_anim_keyframe(key: i32, prop: i32, from: i32, to: i32,
                     ms: i32, n: i32, fracs: ptr, progs: ptr,
                     curves: ptr, repeat: i32, rmode: i32) : i32 {
    return anim_begin_keyframe(key, prop, from, to, ms, n,
                               fracs, progs, curves, repeat, rmode);
}

// 挂完成回调：动画自然结束时调一次（改道/取消会丢掉它，需重挂）。
// 槽已结束（val 已到终值）时立即调一次；无槽返回 -1。回调里不要调
// aui_frame（anim_step 遍历中/遍历后调用，帧循环在外层）。
fn aui_anim_on_done(key: i32, prop: i32, cb: fn(ptr) : i32,
                    user: ptr) : i32 {
    if (cb == 0) { return -1; }
    let i: i32 = anim_find(key, prop);
    if (i < 0) { return -1; }
    if (g_aui_anim_on[i] == 0 && g_aui_anim_val[i] == g_aui_anim_to[i]) {
        let r: i32 = cb(user);
        return 0;
    }
    g_aui_anim_cb[i] = cb;
    g_aui_anim_cb_user[i] = user;
    return 0;
}

fn aui_set_reduced_motion(on: i32) : i32 {
    let prev: i32 = g_aui_reduced_motion;
    if (on != 0) { g_aui_reduced_motion = 1; } else { g_aui_reduced_motion = 0; }
    // 打开后下一拍 anim_step 把运行中的动画一次落到终值（并触发完成
    // 回调）；帧泵因 anim_active_count 仍 > 0 会继续出帧直到落点。
    return prev;
}

fn aui_reduced_motion() : i32 {
    return g_aui_reduced_motion;
}

fn aui_anim_value(key: i32, prop: i32) : i32 {
    let i: i32 = anim_find(key, prop);
    if (i < 0) { return anim_default_value(prop); }
    return g_aui_anim_val[i];
}

fn aui_anim_active() : i32 { return anim_active_count(); }

fn aui_anim_reset(key: i32, prop: i32) : i32 {
    return anim_reset(key, prop);
}

// 仅测试：读回槽状态。out[4] = [value, on, mode, velocity]，
// velocity 为弹簧速度（属性单位/s，Q16.16 的高 16 位即整数部分取整）；
// 无槽返回 -1（out 不动）。
fn aui_debug_anim(key: i32, prop: i32, out: ptr) : i32 {
    let i: i32 = anim_find(key, prop);
    if (i < 0) { return -1; }
    *(out + 0) = g_aui_anim_val[i];
    *(out + 4) = g_aui_anim_on[i];
    *(out + 8) = g_aui_anim_mode[i];
    *(out + 12) = i32(g_aui_anim_spr_v[i] >> 16);
    return 0;
}

fn anim_reset_all() : i32 {
    let i: i32 = 0;
    while (i < AUI_ANIM_CAP) {
        g_aui_anim_key[i] = 0;
        g_aui_anim_prop[i] = 0;
        g_aui_anim_from[i] = 0;
        g_aui_anim_to[i] = 0;
        g_aui_anim_val[i] = 0;
        g_aui_anim_start[i] = 0;
        g_aui_anim_dur[i] = 0;
        g_aui_anim_curve[i] = 0;
        g_aui_anim_on[i] = 0;
        g_aui_anim_seen[i] = 0;
        g_aui_anim_mode[i] = 0;
        g_aui_anim_stiff[i] = 0;
        g_aui_anim_damp[i] = 0;
        g_aui_anim_last[i] = 0;
        g_aui_anim_spr_x[i] = 0;
        g_aui_anim_spr_v[i] = 0;
        g_aui_anim_kf_n[i] = 0;
        g_aui_anim_repeat[i] = 0;
        g_aui_anim_rmode[i] = 0;
        g_aui_anim_cb[i] = 0;
        g_aui_anim_cb_user[i] = 0;
        i = i + 1;
    }
    let j: i32 = 0;
    while (j < 512) {
        g_aui_anim_kf_frac[j] = 0;
        g_aui_anim_kf_prog[j] = 0;
        g_aui_anim_kf_curve[j] = 0;
        j = j + 1;
    }
    g_aui_anim_done_n = 0;
    g_aui_anim_used = 0;
    g_aui_anim_seq = 0;
    g_aui_anim_fake = 0;
    g_aui_anim_now = 0;
    g_aui_paint_alpha = 255;
    g_aui_paint_dx = 0;
    g_aui_paint_dy = 0;
    g_aui_paint_sc_d = 0;
    return 0;
}


// ===========================================================================
// 8d. 页面转场快照（v1.11）
// ===========================================================================

fn page_at(i: i32) : ptr<AuiCmd> {
    return g_aui_page_cmds + i * sizeof(AuiCmd);
}

// 结束一次转场，保留当前（新）页面。reason 只写轨迹：
// 1 = 定时器帧到点，2 = 输入看门狗到点，3 = 绘制路径发现已到点，4 = 取消。
// repaint=1 时立刻重画最终页面（看门狗路径用，避免屏幕上停在中间帧）。
fn page_finish(reason: i32, repaint: i32) : i32 {
    let was_armed: i32 = g_aui_page_armed;
    let nframes: i64 = g_aui_timer_ticks - g_aui_page_ticks0;
    g_aui_page_on = 0;
    g_aui_page_armed = 0;
    g_aui_page_count = 0;
    g_aui_page_text_used = 0;
    let te: i32 = trace_hex(101, reason);       // e + 结束原因
    if (was_armed != 0) {
        let tz: i32 = trace_hex(90, i32(nframes));   // Z + 本次转场实际帧数
    }
    if (anim_active_count() == 0 && g_aui_fling_active == 0 &&
        pager_anim_count() == 0 && refresh_busy() == 0) {
        let d: i32 = frame_timer_disarm();
    }
    if (repaint != 0) {
        g_aui_need_paint = 1;
        let r: i32 = aui_invalidate();
    }
    return 0;
}

fn page_cancel() : i32 {
    if (g_aui_page_on != 0) {
        let f: i32 = page_finish(4, 0);
    }
    g_aui_page_count = 0;
    g_aui_page_text_used = 0;
    g_aui_page_armed = 0;
    g_aui_need_paint = 1;
    if (anim_active_count() == 0 && g_aui_fling_active == 0 &&
        pager_anim_count() == 0 && refresh_busy() == 0) {
        let d: i32 = frame_timer_disarm();
    }
    return 0;
}

// 把当前帧的命令列表复制到快照池。文字命令指向节点文本池/临时缓冲，
// 新页面 build 会覆盖它们，所以逐条把 UTF-8 字节也复制出来；图片指针
// 指向应用持有的 RGBA，保持原样。超过容量时返回 -1，调用方放弃转场。
fn page_capture() : i32 {
    g_aui_page_count = 0;
    g_aui_page_text_used = 0;
    if (g_aui_cmd_count <= 0) { return -1; }
    if (g_aui_cmd_count > AUI_PAGE_CMD_CAP) { return -1; }
    let i: i32 = 0;
    while (i < g_aui_cmd_count) {
        let s: ptr<AuiCmd> = cmd_at(i);
        let d: ptr<AuiCmd> = page_at(i);
        d.op = s.op;
        d.x = s.x;
        d.y = s.y;
        d.w = s.w;
        d.h = s.h;
        d.color = s.color;
        d.radius = s.radius;
        d.text = s.text;
        d.tlen = s.tlen;
        d.aux = s.aux;
        d.cx = s.cx;
        d.cy = s.cy;
        d.cw = s.cw;
        d.ch = s.ch;
        if (s.op == 2 && s.tlen > 0 && s.text != 0) {
            let n: i32 = s.tlen;
            if (g_aui_page_text_used + n > AUI_PAGE_TEXT_CAP) {
                g_aui_page_count = 0;
                g_aui_page_text_used = 0;
                return -1;
            }
            let k: i32 = 0;
            let dst: ptr = g_aui_page_text + g_aui_page_text_used;
            while (k < n) {
                store_u8(dst + k, load_u8(s.text + k));
                k = k + 1;
            }
            d.text = dst;
            g_aui_page_text_used = g_aui_page_text_used + n;
        }
        i = i + 1;
    }
    g_aui_page_count = i;
    return 0;
}

// dir: 1 = push（旧页左移，新页从右进）；-1 = pop（反向）；0 = 纯淡入淡出。
fn page_begin(dir: i32, ms: i32) : i32 {
    page_cancel();
    if (ms <= 0) { return 0; }
    // 之前已经证实这台设备的 16 ms 帧回调根本不触发：转场只会停在中间帧，
    // 直接降级为直切（页面立即切换，不做动画）。
    if (g_aui_timer_dead != 0) {
        let t9: i32 = trace_hex(97, 6);         // a + 6 = 已降级为直切
        return 0;
    }
    // v1.12：帧泵是独立线程，只要它已经跑出过至少一帧就认为帧源可用；
    // 线程起不来（pipe/线程创建失败）时导航一律直切，绝不停在半截转场。
    if (g_aui_anim_fake == 0) {
        let pe: i32 = frame_pump_ensure();
        if (pe < 0) {
            let t8: i32 = trace_hex(97, 7);     // a + 7 = 帧源不可用，直切
            return 0;
        }
        if (g_aui_pump_frames < 1) {
            g_aui_pump_need = 1;
            let pw: i32 = pump_wake();
            let t7: i32 = trace_hex(97, 7);     // 首帧还没出来，先直切一次
            return 0;
        }
    }
    if (page_capture() != 0) {
        let t0: i32 = trace_hex(97, 5);         // a + 5 = 快照超限，直切
        return 0;
    }
    g_aui_page_dir = dir;
    g_aui_page_start = anim_now();
    g_aui_page_dur = i64(ms) * 1000000;
    g_aui_page_on = 1;
    g_aui_page_armed = 0;
    g_aui_page_ticks0 = g_aui_timer_ticks;
    // 转场期间不派发输入，进行中的按压/拖动一起作废，避免残留按压态。
    g_aui_press_key = 0;
    g_aui_pressing = 0;
    g_aui_drag_key = 0;
    g_aui_dragging = 0;
    pager_drag_clear();
    g_aui_need_paint = 1;
    let ar: i32 = frame_timer_arm();
    // 没有可用的帧驱动（looper 缺失 / timerfd 创建、注册、设时失败）时绝不
    // 进入转场：否则屏幕上会停在半透明的中间帧，输入也被 page_on 吞掉。
    // 无宿主测试用假时钟手动喂帧，不需要定时器。
    if (g_aui_anim_fake == 0 && ar < 0) {
        let t1: i32 = trace_hex(97, 0 - ar);    // a + 1..4 = 定时器不可用
        let f: i32 = page_finish(4, 0);
        return 0;
    }
    g_aui_page_armed = 1;
    let t2: i32 = trace_hex(97, 0);             // a + 0 = 转场已启动
    return 0;
}

fn page_progress(now: i64) : i32 {
    if (g_aui_page_on == 0) { return 65536; }
    if (g_aui_page_dur <= 0) { return 65536; }
    let el: i64 = now - g_aui_page_start;
    if (el <= 0) { return 0; }
    if (el >= g_aui_page_dur) { return 65536; }
    let p: i64 = (el * 65536) / g_aui_page_dur;
    return i32(p);
}

fn page_step(now: i64) : i32 {
    if (g_aui_page_on == 0) { return 0; }
    let p: i32 = page_progress(now);
    if (p >= 65536) {
        let f: i32 = page_finish(1, 0);
        g_aui_need_paint = 1;
        return 1;
    }
    g_aui_need_paint = 1;
    return 0;
}

// 看门狗收尾时判断帧源是否真的停了：转场开始后一帧都没来，而且已经
// 超过时长 250 ms，才认定这台设备的 ALooper/timerfd 不工作并永久降级。
fn page_note_stall(now: i64) : i32 {
    if (g_aui_timer_ticks != g_aui_page_ticks0) { return 0; }
    let late: i64 = now - g_aui_page_start;
    if (late <= g_aui_page_dur + 250000000) { return 0; }
    g_aui_timer_dead = 1;
    return 0;
}

// 输入/恢复时的兜底推进。即使帧定时器因为 ROM 或 looper 的原因一次都
// 没触发，转场也不会把输入永久锁死：按单调时钟到点就直接结束并放行
// 本次事件；万一帧定时器没挂上，这里还会再试一次。
fn page_refresh() : i32 {
    if (g_aui_page_on == 0) { return 0; }
    let now: i64 = anim_now();
    if (g_aui_anim_fake == 0 && now <= 0) {
        let n0: i32 = page_note_stall(now);
        let f0: i32 = page_finish(2, 1);        // 时钟不可用也不能锁死界面
        return 0;
    }
    let p: i32 = page_progress(now);
    if (p >= 65536) {
        let n1: i32 = page_note_stall(now);
        let f1: i32 = page_finish(2, 1);
        return 0;
    }
    if (g_aui_anim_fake == 0 && g_aui_page_armed == 0) {
        let ar: i32 = frame_timer_arm();
        if (ar < 0) {
            let f2: i32 = page_finish(2, 1);
            return 0;
        }
        g_aui_page_armed = 1;
    }
    return 1;
}


// ===========================================================================
// 8d. 按压水波纹 Indication（v1.48）
// ===========================================================================
// 对照 HuxerUI 的 indication.cpp：按住时状态层从触点扩散到覆盖整个控件，
// 松手后淡出。这里用固定几何（圆）而不是额外节点：波纹 key 就是当前按下
// 的节点 key，绘制时按节点矩形与圆角裁剪，alpha 固定 12%（同 HuxerUI
// 默认 ripple 颜色）。只对走通用 find_clickable 路径的控件生效。
let AUI_RIPPLE_EXPAND_MS: i64 = 320;
let AUI_RIPPLE_FADE_MS: i64 = 220;
let AUI_RIPPLE_ALPHA: i32 = 31;               // 12% of 255

// 这些容器有自己的按压/展开逻辑（或只是点击占位），不画波纹。
fn ripple_allowed(kind: i32) : i32 {
    if (kind == 1 || kind == 19 || kind == 21 || kind == 22 || kind == 23 ||
        kind == 24 || kind == 25 || kind == 29 || kind == 41 || kind == 42 ||
        kind == 49 || kind == 51 || kind == 53 || kind == 55) { return 0; }
    return 1;
}

fn ripple_press(n: ptr<AuiNode>, px: i32, py: i32) : i32 {
    if (g_aui_ripple_on == 0) { return 0; }
    if (ripple_allowed(n.kind) == 0) { return 0; }
    let nx: i32 = n.x >> 16;
    let ny: i32 = n.y >> 16;
    let nw: i32 = n.w >> 16;
    let nh: i32 = n.h >> 16;
    if (nw <= 0 || nh <= 0) { return 0; }
    // 半径取触点到最远角的距离，扩散完刚好盖住整个控件。
    let ex: i32 = px - nx;
    let ex2: i32 = nx + nw - px;
    if (ex2 > ex) { ex = ex2; }
    let ey: i32 = py - ny;
    let ey2: i32 = ny + nh - py;
    if (ey2 > ey) { ey = ey2; }
    if (ex < 0) { ex = 0; }
    if (ey < 0) { ey = 0; }
    g_aui_ripple_key = n.key;
    g_aui_ripple_x = px;
    g_aui_ripple_y = py;
    g_aui_ripple_t0 = anim_now();
    g_aui_ripple_up = 0;
    g_aui_ripple_phase = 1;
    g_aui_ripple_rad = 0;
    g_aui_ripple_age = 0;
    g_aui_ripple_alpha = AUI_RIPPLE_ALPHA;
    g_aui_ripple_maxr = isqrt(ex * ex + ey * ey);
    if (g_aui_ripple_maxr < 1) { g_aui_ripple_maxr = 1; }
    // 列表行/格子/横向项没有自己的 key（都是 0），用 (容器 key, 项下标) 定位，
    // 这样点击引起的重建或滚动不会把波纹画到别的项上。
    g_aui_ripple_vkind = 0;
    g_aui_ripple_vidx = -1;
    g_aui_ripple_vbase = 0;
    if (n.kind == 52 || n.kind == 54 || n.kind == 56) {
        if (n.parent >= 0) {
            let pn: ptr<AuiNode> = node_at(n.parent);
            g_aui_ripple_vkind = n.kind;
            g_aui_ripple_vidx = n.aux2;
            g_aui_ripple_vbase = pn.key;
        }
    }
    g_aui_need_paint = 1;
    let ar: i32 = frame_timer_arm();           // 扩散/淡出要靠 16 ms 节拍
    return 1;
}

// 还有动画要做吗：按住时只在扩散阶段需要出帧，松手后到淡出结束都需要。
fn ripple_busy() : i32 {
    if (g_aui_ripple_phase == 0) { return 0; }
    if (g_aui_ripple_up != 0) { return 1; }
    if (g_aui_ripple_rad < g_aui_ripple_maxr) { return 1; }
    return 0;
}

// v1.48.3：立即清除，不淡出。手势被拖动/滚动取消时用：列表一开始滚，波纹
// 继续跟着行滑或原地淡出都不对，而且滚动帧会多画上百条扫描带命令。
fn ripple_clear() : i32 {
    g_aui_ripple_phase = 0;
    g_aui_ripple_key = 0;
    g_aui_ripple_rad = 0;
    g_aui_ripple_alpha = 0;
    g_aui_ripple_vkind = 0;
    g_aui_ripple_vidx = -1;
    g_aui_ripple_vbase = 0;
    g_aui_ripple_age = 0;
    g_aui_ripple_up = 0;
    // v1.48.6：波纹消失不能混在纯滚动帧里直搬，必须整屏重画一次。
    g_aui_force_full = 1;
    return 0;
}

fn ripple_step(now: i64) : i32 {
    if (g_aui_ripple_phase == 0) { return 0; }
    // v1.48.3：手势已经变成拖动/滚动，按压态被取消——直接消失，不在滚动
    // 期间继续扩散/淡出（泵侧兜底，主要路径在 ripple_release_now）。
    // v1.48.4：淡出阶段（相位 2）也一样。快速“点一下再滑”时旧波纹原本还
    // 会在滚动帧里画 220 ms 的扫描带；现在拖动/惯性一开始就清掉。
    if (g_aui_ripple_phase != 0 &&
        (g_aui_dragging != 0 || g_aui_fling_active != 0)) {
        let c: i32 = ripple_clear();
        g_aui_need_paint = 1;
        return 0;
    }
    // 松手（或按压被拖动/重建取消）后开始淡出。
    if (g_aui_ripple_up == 0 &&
        (g_aui_pressing == 0 || g_aui_press_key != g_aui_ripple_key)) {
        g_aui_ripple_up = now;
        g_aui_ripple_phase = 2;
    }
    let age_ms: i64 = (now - g_aui_ripple_t0) / 1000000;
    if (age_ms < 0) { age_ms = 0; }
    g_aui_ripple_age = i32(age_ms);
    let p: i32 = 65536;
    if (age_ms < AUI_RIPPLE_EXPAND_MS) {
        p = i32(age_ms * 65536 / AUI_RIPPLE_EXPAND_MS);
    }
    // 扩散用线性（同 HuxerUI 默认 expansion easing: Linear）。早前用
    // ease-out，半径在前 1/3 时间就跑完一半，后半段几乎不动，看起来像
    // “冲一下又停住”，在 320 ms 的短动画里很像掉帧。
    let rad: i32 = i32(i64(g_aui_ripple_maxr) * i64(p) / 65536);
    let alpha: i32 = AUI_RIPPLE_ALPHA;
    if (g_aui_ripple_up != 0) {
        let up_ms: i64 = (now - g_aui_ripple_up) / 1000000;
        if (up_ms >= AUI_RIPPLE_FADE_MS) {
            let c: i32 = ripple_clear();
            g_aui_need_paint = 1;
            return 0;
        }
        if (up_ms < 0) { up_ms = 0; }
        alpha = AUI_RIPPLE_ALPHA -
                i32(up_ms * i64(AUI_RIPPLE_ALPHA) / AUI_RIPPLE_FADE_MS);
    }
    if (rad != g_aui_ripple_rad || alpha != g_aui_ripple_alpha) {
        g_aui_ripple_rad = rad;
        g_aui_ripple_alpha = alpha;
        g_aui_need_paint = 1;
    }
    return 0;
}

// 松手（或手势取消）时立刻转入淡出并叫醒帧泵。只靠 ripple_step 在下一帧
// 里比对 g_aui_pressing 不够：如果按住超过 320 ms，扩散已经结束、帧泵已
// 停，UP 之后要等 poll 的 250 ms 兜底才出下一帧，看起来就是“松手后卡一下
// 才开始淡出”。
fn ripple_release_now() : i32 {
    if (g_aui_ripple_phase != 1) { return 0; }
    if (g_aui_pressing != 0 && g_aui_press_key == g_aui_ripple_key) { return 0; }
    // v1.48.3：没有 UP 就结束的按压 = 被拖动/滚动/别的手势取消。直接清除，
    // 不再淡出 220 ms——否则整个滚动过程都要额外画上百条扫描带命令。
    if (g_aui_ripple_up_seen == 0) {
        let c: i32 = ripple_clear();
        g_aui_need_paint = 1;
        let ar: i32 = frame_timer_arm();       // 让泵把清掉波纹的那一帧画出来
        return 1;
    }
    g_aui_ripple_up = anim_now();
    g_aui_ripple_phase = 2;
    g_aui_need_paint = 1;
    let ar: i32 = frame_timer_arm();
    return 1;
}

// 按行扫描圆，再与节点矩形/圆角/当前裁剪求交；行高随半径放大，避免
// 大控件上产生几千条矩形命令。绘制在节点自身内容之上、子树内容之下。
fn ripple_paint(n: ptr<AuiNode>) : i32 {
    if (g_aui_ripple_phase == 0) { return 0; }
    let hit: i32 = 0;
    if (g_aui_ripple_key != 0 && n.key == g_aui_ripple_key) {
        hit = 1;
    } else if (g_aui_ripple_vkind != 0 && n.kind == g_aui_ripple_vkind &&
               n.aux2 == g_aui_ripple_vidx && n.parent >= 0) {
        let pn: ptr<AuiNode> = node_at(n.parent);
        if (pn.key == g_aui_ripple_vbase) { hit = 1; }
    }
    if (hit == 0) { return 0; }
    let r: i32 = g_aui_ripple_rad;
    let a: i32 = g_aui_ripple_alpha;
    if (r <= 0 || a <= 0) { return 0; }
    let nx: i32 = (n.x + g_aui_paint_dx) >> 16;
    let ny: i32 = (n.y + g_aui_paint_dy) >> 16;
    let nw: i32 = n.w >> 16;
    let nh: i32 = n.h >> 16;
    if (nw <= 0 || nh <= 0) { return 0; }
    let x0: i32 = nx;
    let y0: i32 = ny;
    let x1: i32 = nx + nw;
    let y1: i32 = ny + nh;
    let cx0: i32 = g_aui_clip_x >> 16;
    let cy0: i32 = g_aui_clip_y >> 16;
    let cx1: i32 = (g_aui_clip_x + g_aui_clip_w) >> 16;
    let cy1: i32 = (g_aui_clip_y + g_aui_clip_h) >> 16;
    if (x0 < cx0) { x0 = cx0; }
    if (y0 < cy0) { y0 = cy0; }
    if (x1 > cx1) { x1 = cx1; }
    if (y1 > cy1) { y1 = cy1; }
    if (x1 <= x0 || y1 <= y0) { return 0; }
    // v1.48.2：这一帧的波纹只会改这块矩形；present 可以只重画它。
    g_aui_dmg_l = x0;
    g_aui_dmg_t = y0;
    g_aui_dmg_r = x1;
    g_aui_dmg_b = y1;
    g_aui_dmg_valid = 1;
    g_aui_dmg_gen = g_aui_paint_gen;
    let rad: i32 = n.radius >> 16;
    let lim: i32 = nw;
    if (nh < lim) { lim = nh; }
    lim = lim / 2;
    if (rad > lim) { rad = lim; }
    let cx: i32 = g_aui_ripple_x;
    let cy: i32 = g_aui_ripple_y;
    let color: i32 = (a << 24) | (i32(theme_primary()) & 0x00FFFFFF);
    // 圆边按 1–2 px 一条扫描带绘制；早前按 r/96（最大 7 px）分带，
    // 420 dpi 上边缘有明显台阶，动画推进时像一跳一跳。带高封顶 2 px，
    // 一屏最多 ~1280 条命令，仍远低于 4096 的命令池。
    let step: i32 = r / 320;
    if (step < 1) { step = 1; }
    if (step > 2) { step = 2; }
    let yy: i32 = cy - r;
    if (yy < y0) { yy = y0; }
    let ymax: i32 = cy + r;
    if (ymax > y1) { ymax = y1; }
    g_aui_rip_cs = g_aui_cmd_count;
    while (yy < ymax) {
        let dy: i32 = yy + step / 2 - cy;
        let q: i32 = r * r - dy * dy;
        if (q > 0) {
            let hw: i32 = isqrt(q);
            let sx0: i32 = cx - hw;
            let sx1: i32 = cx + hw;
            let ins: i32 = 0;
            if (rad > 0) {
                if (yy < ny + rad) {
                    let d: i32 = ny + rad - yy;
                    ins = rad - isqrt(rad * rad - d * d);
                } else if (yy >= ny + nh - rad) {
                    let d: i32 = yy - (ny + nh - rad);
                    ins = rad - isqrt(rad * rad - d * d);
                }
            }
            let lx: i32 = sx0;
            let rx: i32 = sx1;
            if (lx < x0 + ins) { lx = x0 + ins; }
            if (rx > x1 - ins) { rx = x1 - ins; }
            if (rx > lx) {
                let hh: i32 = step;
                if (yy + hh > ymax) { hh = ymax - yy; }
                let c: i32 = cmd_add(1, lx << 16, yy << 16, (rx - lx) << 16,
                                     hh << 16, color, 0, g_aui_null, 0, 0);
            }
        }
        yy = yy + step;
    }
    g_aui_rip_ce = g_aui_cmd_count;
    return 0;
}

fn aui_ripple(on: i32) : i32 {
    let v: i32 = 0;
    if (on != 0) { v = 1; }
    g_aui_ripple_on = v;
    if (v == 0) {
        g_aui_force_full = 1;
        g_aui_ripple_phase = 0;
        g_aui_ripple_key = 0;
        g_aui_ripple_rad = 0;
        g_aui_ripple_alpha = 0;
        g_aui_ripple_vkind = 0;
        g_aui_ripple_vidx = -1;
        g_aui_ripple_vbase = 0;
        g_aui_ripple_age = 0;
        g_aui_need_paint = 1;
    }
    return v;
}

fn aui_ripple_active() : i32 { return g_aui_ripple_phase; }

fn aui_debug_ripple(out: ptr) : i32 {
    if (out == 0) { return -1; }
    *(out + 0) = g_aui_ripple_key;
    *(out + 4) = g_aui_ripple_x;
    *(out + 8) = g_aui_ripple_y;
    *(out + 12) = g_aui_ripple_rad;
    *(out + 16) = g_aui_ripple_alpha;
    *(out + 20) = g_aui_ripple_phase;
    *(out + 24) = g_aui_ripple_maxr;
    *(out + 28) = g_aui_ripple_age;
    return 0;
}

// ===========================================================================
// 8e. 帧泵（v1.12）
// ===========================================================================
// 所有绘制入口（UI 线程回调 / 帧泵线程）都必须先拿这把锁；窗口创建/销毁、
// 输入处理也拿同一把锁，保证节点池、命令池、滚动表只有一个人在用。
fn aui_lock() : i32 { return pthread_mutex_lock(g_aui_lock); }
fn aui_unlock() : i32 { return pthread_mutex_unlock(g_aui_lock); }

// 脏帧/动效开始时叫醒泵线程（帧泵空闲时阻塞在管道上，零唤醒）。
fn pump_wake() : i32 {
    if (g_aui_pump_w < 0) { return -1; }
    store_u8(g_aui_pump_byte + 0, 1);
    let n: i32 = write(g_aui_pump_w, g_aui_pump_byte, 1);
    return n;
}

fn pump_drain() : i32 {
    if (g_aui_pump_r < 0) { return -1; }
    let k: i32 = 0;
    while (k < 16) {
        let n: i32 = read(g_aui_pump_r, g_aui_pump_byte, 8);
        if (n <= 0) { return 0; }
        k = k + 1;
    }
    return 0;
}

// 调用方持锁。只有“有动效”或“有脏帧”才画；都没有就回到挂起状态。
fn pump_frame_once() : i32 {
    if (g_aui_have_win == 0 || g_aui_win == 0) {
        g_aui_pump_need = 0;
        return 0;
    }
    // v1.27：工具提示的计时要靠泵节拍推进；即使这拍不画，也要先推进。
    let tt: i32 = tip_tick();
    // v1.34：Toast / SnackBar 到点移除，同样先推进再决定这一拍画不画。
    let pt: i32 = present_tick();
    // v2.7.1：长按计时同样靠泵节拍推进。v2.7 只把它挂在 pump_ui()（headless
    // 路径）里，真机泵线程只调 pump_frame_once()，静按 1729 ms ticks=0，
    // 长按永远不触发；这里补上，位置与 tip/present 同级。
    let lt: i32 = lp_tick();
    // v2.9：延时任务计时同样靠泵节拍推进，与 lp_tick 同级——v2.7 的教训：
    // 只挂 pump_ui() 里真机上永远不触发；这里必须也有。
    let tk: i32 = task_tick();
    let active: i32 = 0;
    if (g_aui_fling_active != 0 || g_aui_page_on != 0) { active = 1; }
    if (anim_active_count() != 0) { active = 1; }
    if (ripple_busy() != 0) { active = 1; }
    if (pager_anim_count() != 0) { active = 1; }
    if (refresh_busy() != 0) { active = 1; }
    let dirty: i32 = 0;
    if (g_aui_need_build != 0 || g_aui_need_layout != 0 || g_aui_need_paint != 0) {
        dirty = 1;
    }
    // 首帧必须无条件画一次：启动时 UI 线程的 aui_invalidate 已经把
    // need_* 清掉，如果这里还按 dirty 判断，泵会一直“无事可做”，
    // g_aui_pump_frames 永远是 0，页面转场就永远过不了首帧门（a7）。
    let seed: i32 = 0;
    if (g_aui_pump_frames < 1) { seed = 1; }
    if (active == 0 && dirty == 0 && seed == 0) {
        // 待定长按 / 停留倒计时期间保持 16 ms 轮询（不画帧）。
        let li0: i32 = lp_diag_idle();
        // v2.7.1：待定长按也是保活任务；不含 lp_busy() 时泵在波纹跑完后
        // 立刻回空闲，lp_tick() 再也不跑（真机静按 ticks=0 的另一半）。
        if (tip_busy() != 0 || present_busy() != 0 || ripple_busy() != 0 || lp_busy() != 0 || d2a_sel_busy() != 0 || task_busy() != 0) { g_aui_pump_need = 1; }
        else { g_aui_pump_need = 0; }
        return 0;
    }
    let now: i64 = clock_ns();
    // 只有真的 present 成功才算一帧：窗口锁失败时既不能骗过首帧门，
    // 也不能让看门狗误以为帧源还在跑。
    let ps0: i32 = g_aui_paint_seq;
    let was_pg: i32 = g_aui_page_on;
    let m0: i64 = 0;
    if (was_pg != 0) { m0 = clock_ns(); }
    let c: i32 = aui_frame(now);
    if (was_pg != 0) {
        let m1: i64 = clock_ns();
        let md: i32 = i32((m1 - m0) / 1000000);
        let tq: i32 = trace_hex(113, md);        // q + 本帧绘制+呈现耗时(ms)
    }
    if (g_aui_paint_seq != ps0) {
        if (g_aui_pump_frames == 0) {
            let ty0: i32 = trace_hex(89, 0);     // Y + 0 = 帧泵首帧成功
        }
        g_aui_pump_frames = g_aui_pump_frames + 1;
        // 沿用 v1.11 的帧计数：输入看门狗 / 转场停滞判定都看它。
        g_aui_timer_ticks = g_aui_timer_ticks + 1;
        g_aui_pump_failn = 0;
    } else {
        if (g_aui_pump_lfail == 0) {
            g_aui_pump_lfail = 1;
            let ty1: i32 = trace_hex(89, 1);     // Y + 1 = present 失败（首次）
        }
        g_aui_pump_failn = g_aui_pump_failn + 1;
        if (g_aui_pump_failn >= 120) {
            // 连续 ~2 s 都锁不上窗口：判定泵不可用，永久直切，停止空转。
            if (g_aui_pump_fail == 0) {
                g_aui_pump_fail = 1;
                let ty2: i32 = trace_hex(89, 2); // Y + 2 = 连续失败，永久直切
            }
            g_aui_pump_need = 0;
        } else {
            // 瞬时失败（比如 Surface 正在重建）下一拍重试。
            g_aui_need_paint = 1;
            g_aui_pump_need = 1;
        }
    }
    if (g_aui_fling_active == 0 && g_aui_page_on == 0 &&
        anim_active_count() == 0 && pager_anim_count() == 0 &&
        refresh_busy() == 0 && ripple_busy() == 0) {
        if (g_aui_need_build == 0 && g_aui_need_layout == 0 && g_aui_need_paint == 0 &&
            tip_busy() == 0 && present_busy() == 0 && lp_busy() == 0 && task_busy() == 0) {
            let li1: i32 = lp_diag_idle();
            g_aui_pump_need = 0;
        }
    }
    return c;
}

fn aui_pump_thread(arg: ptr) : ptr {
    let live: i32 = 1;
    g_aui_pump_tick = clock_ns();
    while (live != 0) {
        // 有动效时 16 ms 一帧；空闲时靠管道唤醒，250 ms 只是兜底。
        // v1.48.2：tick 记的是“本次帧开始”的时刻，等待只补足到开始后
        // 16 ms。v1.48.1 误把 tick 记在帧结束，等于画完仍睡满 16 ms，
        // 周期还是“绘制耗时 + 16 ms”，这次真正修掉。
        let to: i32 = 250;
        if (g_aui_pump_need != 0) {
            let el: i32 = i32((clock_ns() - g_aui_pump_tick) / 1000000);
            to = 16 - el;
            if (to < 0) { to = 0; }
        }
        let pr: i32 = poll(g_aui_pump_pfd, 1, to);
        let dr: i32 = pump_drain();
        let stop: i32 = 0;
        aui_lock();
        if (g_aui_pump_run == 0) {
            stop = 1;
        } else {
            // v1.48.4：输入事件（拖动/波纹按下）会把泵从管道叫醒；如果离
            // 上一帧开始还不到 16 ms，就只把脏标志留在原地，下一拍再画。
            // 否则一次拖动里每个 MOVE（最高 120 Hz）都会立刻出一帧，
            // 既超过屏幕刷新率，也和泵的 16 ms 节拍重复。
            let draw_now: i32 = 1;
            if (pr > 0 && g_aui_pump_need != 0) {
                let el: i32 = i32((clock_ns() - g_aui_pump_tick) / 1000000);
                if (el >= 0 && el < 15) { draw_now = 0; }
            }
            if (draw_now != 0) {
                g_aui_pump_tick = clock_ns();
                let f: i32 = pump_frame_once();
            }
        }
        aui_unlock();
        if (stop != 0) { live = 0; }
    }
    return g_aui_null;
}

// 调用方持锁。返回 0 = 线程就绪；负数 = 不可用（此后页面一律直切）。
fn frame_pump_ensure() : i32 {
    if (g_aui_anim_fake != 0) { return 0; }
    if (g_aui_pump_on != 0) { return 0; }
    if (g_aui_pump_fail != 0) { return -1; }
    let p: i32 = pipe2(g_aui_pump_fds, 2048);    // O_NONBLOCK
    if (p != 0) {
        g_aui_pump_fail = 1;
        let t0: i32 = trace_hex(74, 1);          // J + 1 = 管道创建失败
        return -1;
    }
    g_aui_pump_r = g_aui_pump_fds[0];
    g_aui_pump_w = g_aui_pump_fds[1];
    g_aui_pump_pfd[0] = g_aui_pump_r;
    store_u16(g_aui_pump_pfd + 4, 1);            // POLLIN
    g_aui_pump_run = 1;
    g_aui_pump_need = 0;
    let e: i32 = pthread_create(g_aui_pump_tid, 0, aui_pump_thread, 0);
    if (e != 0) {
        g_aui_pump_run = 0;
        g_aui_pump_fail = 1;
        let c0: i32 = close(g_aui_pump_r);
        let c1: i32 = close(g_aui_pump_w);
        g_aui_pump_r = -1;
        g_aui_pump_w = -1;
        let t1: i32 = trace_hex(74, 2);          // J + 2 = 线程创建失败
        return -1;
    }
    g_aui_pump_on = 1;
    // 新泵重新从“还没有任何一帧”开始：首帧会无条件 present 一次（Y0），
    // 之后才恢复按 active/dirty 出帧。
    g_aui_pump_frames = 0;
    g_aui_pump_failn = 0;
    g_aui_pump_lfail = 0;
    // 让泵先画一帧，既是“帧源已通”的证据，也把启动画面补齐。
    g_aui_need_paint = 1;
    g_aui_pump_need = 1;
    let w0: i32 = pump_wake();
    let t2: i32 = trace_hex(74, 0);              // J + 0 = 帧泵就绪
    return 0;
}

// 只能在没持锁时调用（要 join）。
fn frame_pump_stop() : i32 {
    if (g_aui_pump_on == 0) { return 0; }
    g_aui_pump_run = 0;
    let w: i32 = pump_wake();
    let j: i32 = pthread_join(g_aui_pump_tid[0], 0);
    if (g_aui_pump_r >= 0) { let c0: i32 = close(g_aui_pump_r); }
    if (g_aui_pump_w >= 0) { let c1: i32 = close(g_aui_pump_w); }
    g_aui_pump_r = -1;
    g_aui_pump_w = -1;
    g_aui_pump_on = 0;
    g_aui_pump_need = 0;
    return 0;
}

// 返回 0 = 已启动；负数 = 帧源不可用（页面转场据此直切）。
// 无宿主测试用假时钟手动喂帧，不启线程。
fn frame_timer_arm() : i32 {
    if (g_aui_anim_fake != 0) { return 0; }
    let e: i32 = frame_pump_ensure();
    if (e < 0) { return -2; }
    g_aui_pump_need = 1;
    let w: i32 = pump_wake();
    return 0;
}

fn frame_timer_disarm() : i32 {
    if (g_aui_anim_fake != 0) { return 0; }
    if (g_aui_fling_active != 0 || g_aui_page_on != 0) { return 0; }
    if (anim_active_count() != 0) { return 0; }
    if (pager_anim_count() != 0) { return 0; }
    if (refresh_busy() != 0) { return 0; }
    if (ripple_busy() != 0) { return 0; }
    g_aui_pump_need = 0;
    return 0;
}

fn frame_timer_sync() : i32 {
    if (g_aui_fling_active != 0 || anim_active_count() != 0 ||
        g_aui_page_on != 0 || pager_anim_count() != 0 || refresh_busy() != 0 ||
        ripple_busy() != 0) {
        return frame_timer_arm();
    }
    return frame_timer_disarm();
}

fn fling_stop() : i32 {
    if (g_aui_fling_active == 0) { return 0; }
    g_aui_fling_active = 0;
    g_aui_fling_key = 0;
    g_aui_fling_vel = 0;
    if (anim_active_count() == 0 && g_aui_page_on == 0 &&
        pager_anim_count() == 0 && refresh_busy() == 0 &&
        ripple_busy() == 0) { frame_timer_disarm(); }
    let th: i32 = trace_hex(104, 0);             // h = 惯性结束
    return 0;
}

fn fling_start(key: i32, vel: i32, now: i64) : i32 {
    return fling_start_axis(key, vel, now, 0);
}

// v2.17：带方向的惯性启动。axis 1 只对表格有效（横向走 off_x）；
// 其余容器（hlist 含）纵向/横向偏移本来就走 scroll_get/set，
// axis 在这里只影响表格的 max/off 取值。
fn fling_start_axis(key: i32, vel: i32, now: i64, axis: i32) : i32 {
    fling_stop();
    let mx: i32 = scroll_max(key);
    let off: i32 = scroll_get(key);
    if (axis == 1 && vtable_idx(key) >= 0) {
        mx = vtable_maxx(key);
        off = vtable_off_x(key);
    }
    let av: i32 = iabs(vel);
    if (mx <= 0 || av < 200000) { return 0; }     // < ~3 px/s 不启动
    if (vel > 0 && off >= mx) { return 0; }
    if (vel < 0 && off <= 0) { return 0; }
    g_aui_fling_key = key;
    g_aui_fling_vel = vel;
    g_aui_fling_t = now;
    g_aui_fling_active = 1;
    g_aui_fling_axis = axis;
    let tg: i32 = trace_hex(103, vel);           // g = 惯性开始 + 初速度
    let ar: i32 = frame_timer_arm();
    if (ar < 0 && g_aui_looper != 0) {
        fling_stop();                            // 定时器不可用就不假装在滑
        return 0;
    }
    return 1;
}

fn fling_step(now: i64) : i32 {
    if (g_aui_fling_active == 0) { return 0; }
    if (now <= 0) { return 0; }
    if (g_aui_fling_t <= 0) { g_aui_fling_t = now; return 0; }
    let dt: i64 = now - g_aui_fling_t;
    if (dt <= 0) { return 0; }
    if (dt > 32000000) { dt = 32000000; }        // 卡帧时最多积 32 ms
    g_aui_fling_t = now;
    let old: i32 = 0;
    if (vtable_idx(g_aui_fling_key) >= 0 && g_aui_fling_axis == 1) {
        // v2.17：表格横向惯性走 off_x。
        old = vtable_off_x(g_aui_fling_key);
    } else {
        old = scroll_get(g_aui_fling_key);
    }
    let dvq: i32 = i32((i64(g_aui_fling_vel) * dt) / 1000000000);
    let dv: i32 = dvq;
    // 虚拟列表/网格偏移按像素存，惯性步长也要从 Q16.16 px 换算成 px。
    if (virtual_key(g_aui_fling_key) != 0) { dv = dvq >> 16; }
    let nv: i32 = old + dv;
    // v1.48.6：普通滚动的偏移对齐到整像素，纯滚动直搬才能整块平移。
    // 1 px 的量化在这个密度下肉眼看不出来，换来的是滚动的整帧搬移。
    if (virtual_key(g_aui_fling_key) == 0) { nv = (nv >> 16) << 16; }
    let got: i32 = 0;
    if (vtable_idx(g_aui_fling_key) >= 0 && g_aui_fling_axis == 1) {
        got = vtable_set_x(g_aui_fling_key, nv);
    } else {
        got = scroll_set(g_aui_fling_key, nv);
    }
    // 每 16 ms 衰减 1/16（0.9375），60 Hz 下 1 秒剩约 2%。
    let steps: i32 = i32(dt / 16000000);
    if (steps < 1) { steps = 1; }
    let v: i32 = g_aui_fling_vel;
    let i: i32 = 0;
    while (i < steps) {
        v = v - v / 16;
        i = i + 1;
    }
    g_aui_fling_vel = v;
    if (got != old) {
        let tv: i32 = trace_hex(118, got);       // v = 当前偏移
        let md: i32 = mark_scroll_dirty();       // v1.48.4：惯性帧不 measure、不强制重建
    }
    if (got == old && dv != 0) { fling_stop(); return 0; }   // 撞边界
    if (iabs(v) < 200000) { fling_stop(); return 0; }
    return got - old;
}

fn drag_sample(py: i32, now: i64) : i32 {
    if (now <= 0 || g_aui_last_t <= 0) {
        g_aui_last_y = py;
        g_aui_last_t = now;
        return 0;
    }
    let dt: i64 = now - g_aui_last_t;
    if (dt <= 0) { return 0; }
    if (dt > 100000000) {                        // 停顿超过 100 ms，重新采样
        g_aui_last_y = py;
        g_aui_last_t = now;
        g_aui_vel = 0;
        return 0;
    }
    let dy: i32 = py - g_aui_last_y;
    // 偏移速度 = -dy/dt；先夹紧再转 i32，避免溢出。
    let inst64: i64 = (i64(0 - dy) * 65536 * 1000000000) / dt;
    let lim: i64 = 12000 * 65536;
    if (inst64 > lim) { inst64 = lim; }
    if (inst64 < 0 - lim) { inst64 = 0 - lim; }
    let inst: i32 = i32(inst64);
    let f: i64 = i64(g_aui_vel) * 3 + i64(inst);
    g_aui_vel = i32(f / 4);
    g_aui_last_y = py;
    g_aui_last_t = now;
    return 0;
}

// v1.47：横向拖动采样，语义与 drag_sample 相同，速度写进同一个
// g_aui_vel，松手时沿用同一条 fling 路径。
fn drag_sample_x(px: i32, now: i64) : i32 {
    if (now <= 0 || g_aui_last_t <= 0) {
        g_aui_last_x = px;
        g_aui_last_t = now;
        return 0;
    }
    let dt: i64 = now - g_aui_last_t;
    if (dt <= 0) { return 0; }
    if (dt > 100000000) {
        g_aui_last_x = px;
        g_aui_last_t = now;
        g_aui_vel = 0;
        return 0;
    }
    let dx: i32 = px - g_aui_last_x;
    let inst64: i64 = (i64(0 - dx) * 65536 * 1000000000) / dt;
    let lim: i64 = 12000 * 65536;
    if (inst64 > lim) { inst64 = lim; }
    if (inst64 < 0 - lim) { inst64 = 0 - lim; }
    let inst: i32 = i32(inst64);
    let f: i64 = i64(g_aui_vel) * 3 + i64(inst);
    g_aui_vel = i32(f / 4);
    g_aui_last_x = px;
    g_aui_last_t = now;
    return 0;
}

// v1.12.3：转场进行中且帧泵健康时，UI 线程只标脏并叫醒泵，不再同步画一帧。
// 之前输入线程在分发事件时持锁同步 present，会和泵抢同一把锁、白画 1~2 帧，
// 每个导航因此浪费 100 ms 以上；把绘制交给泵后，转场帧数直接翻倍。
fn draw_defer_to_pump() : i32 {
    if (g_aui_anim_fake != 0) { return 0; }
    // v1.48.3：只要有动效在跑（转场/惯性/波纹/属性动画/分页/刷新），输入
    // 线程就只标脏并叫醒泵，不再自己同步画一帧。旧逻辑只对转场这样做：
    // 波纹期间帧泵每 16 ms 出一帧，输入（例如列表滚动的 MOVE）又各画一帧，
    // 同一画面被画两遍，滚动直接卡顿。
    let defer: i32 = 0;
    if (g_aui_page_on != 0) { defer = 1; }
    if (g_aui_fling_active != 0) { defer = 1; }
    if (g_aui_dragging != 0) { defer = 1; }     // v1.48.4：手指拖动中也只让泵画
    if (ripple_busy() != 0) { defer = 1; }
    if (anim_active_count() != 0) { defer = 1; }
    if (pager_anim_count() != 0) { defer = 1; }
    if (refresh_busy() != 0) { defer = 1; }
    if (defer == 0) { return 0; }
    if (g_aui_pump_on == 0 || g_aui_pump_fail != 0) { return 0; }
    g_aui_pump_need = 1;
    let w: i32 = pump_wake();
    return 1;
}

fn aui_invalidate() : i32 {
    g_aui_need_build = 1;
    g_aui_need_layout = 1;
    g_aui_need_paint = 1;
    g_aui_layout_light = 0;                     // 完整重建：必须 measure
    if (g_aui_in_build != 0) { return 0; }
    if (g_aui_attached == 0) { return 0; }
    if (draw_defer_to_pump() != 0) { return 0; }
    let c: i32 = pump_ui();
    let p: i32 = present_now();
    return 0;
}

fn aui_invalidate_layout() : i32 {
    g_aui_need_layout = 1;
    g_aui_need_paint = 1;
    g_aui_layout_light = 0;                     // 尺寸可能变了：完整 measure
    if (g_aui_in_build != 0) { return 0; }
    if (g_aui_attached == 0) { return 0; }
    if (draw_defer_to_pump() != 0) { return 0; }
    let c: i32 = pump_ui();
    let p: i32 = present_now();
    return 0;
}

// v1.48.4：滚动专用失效。只改偏移，跳过 measure 直接 arrange；拖动期间
// 输入线程不自己画，交给帧泵按 16 ms 节拍出帧。
fn aui_invalidate_scroll() : i32 {
    let md: i32 = mark_scroll_dirty();
    if (g_aui_in_build != 0) { return 0; }
    if (g_aui_attached == 0) { return 0; }
    if (draw_defer_to_pump() != 0) { return 0; }
    let c: i32 = pump_ui();
    let p: i32 = present_now();
    return 0;
}

// ===========================================================================
// 9. 输入
// ===========================================================================

// v1.44：展开中的组合框是“半模态”。浮层之外通常返回 -1（关闭），
// 但屏幕键盘的键必须继续可用，否则打字会先关掉建议列表。键盘键是
// kind 11 的叶子，这里按几何直接找（键盘可能挂在根树的任意位置）。
fn hit_keyboard(px: i32, py: i32) : i32 {
    let qx: i32 = px << 16;
    let qy: i32 = py << 16;
    let i: i32 = g_aui_node_count - 1;
    while (i >= 0) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.kind == 11) {
            if (qx >= n.x && qy >= n.y &&
                qx < n.x + n.w && qy < n.y + n.h) {
                return i;
            }
        }
        i = i - 1;
    }
    return -1;
}

fn hit_test(i: i32, px: i32, py: i32) : i32 {
    if (i < 0) { return -1; }
    // v1.25：对话框打开时整棵树都被遮罩挡住，只命中对话框自己。
    // v1.38：底部弹出层同理，且优先级高于对话框（两者互斥）。
    if (i == g_aui_root && g_aui_sheet >= 0) {
        return hit_test(g_aui_sheet, px, py);
    }
    if (i == g_aui_root && g_aui_dialog >= 0) {
        return hit_test(g_aui_dialog, px, py);
    }
    // v1.44：组合框展开时命中触发器、浮层与建议；浮层 padding 返回 -2，
    // 屏幕键盘仍可命中，其余位置 -1（外部点击关闭）。
    if (i == g_aui_root && g_aui_combo_open >= 0) {
        let qx: i32 = px << 16;
        let qy: i32 = py << 16;
        let sn: ptr<AuiNode> = node_at(g_aui_combo_open);
        let px0: i32 = g_aui_combo_px;
        let py0: i32 = g_aui_combo_py;
        if (qx >= px0 && qy >= py0 &&
            qx < px0 + g_aui_combo_pw && qy < py0 + g_aui_combo_ph) {
            let idx: i32 = 0;
            let c: i32 = sn.first_child;
            while (c >= 0 && idx < g_aui_combo_vis) {
                let cn: ptr<AuiNode> = node_at(c);
                if (qx >= cn.x && qy >= cn.y &&
                    qx < cn.x + cn.w && qy < cn.y + cn.h) {
                    return c;
                }
                idx = idx + 1;
                c = cn.next_sibling;
            }
            return -2;
        }
        if (qx >= sn.x && qy >= sn.y &&
            qx < sn.x + sn.w && qy < sn.y + sn.h) {
            return g_aui_combo_open;
        }
        let hk: i32 = hit_keyboard(px, py);
        if (hk >= 0) { return hk; }
        return -1;
    }
    // v1.26：下拉展开时只命中触发器、浮层和选项；其余位置返回 -1
    // （外部点击关闭），浮层 padding 返回 -2（吞掉，不关闭）。
    if (i == g_aui_root && g_aui_select_open >= 0) {
        let qx: i32 = px << 16;
        let qy: i32 = py << 16;
        let sn: ptr<AuiNode> = node_at(g_aui_select_open);
        let px0: i32 = g_aui_select_px;
        let py0: i32 = g_aui_select_py;
        if (qx >= px0 && qy >= py0 &&
            qx < px0 + g_aui_select_pw && qy < py0 + g_aui_select_ph) {
            let idx: i32 = 0;
            let c: i32 = sn.first_child;
            while (c >= 0 && idx < g_aui_select_vis) {
                let cn: ptr<AuiNode> = node_at(c);
                if (qx >= cn.x && qy >= cn.y &&
                    qx < cn.x + cn.w && qy < cn.y + cn.h) {
                    return c;
                }
                idx = idx + 1;
                c = cn.next_sibling;
            }
            return -2;
        }
        if (qx >= sn.x && qy >= sn.y &&
            qx < sn.x + sn.w && qy < sn.y + sn.h) {
            return g_aui_select_open;
        }
        return -1;
    }
    // v1.35：菜单展开时是模态浮层：条目返回自身，面/内边距 -2，
    // 菜单外 -1（松手时关闭）。
    if (i == g_aui_root && g_aui_menu >= 0) {
        return menu_hit(px, py);
    }
    // v1.39：锚定浮层同样接管命中：内容返回自身，面/内边距 -2，
    // 浮层外 -1（松手时关闭）。
    if (i == g_aui_root && g_aui_popup >= 0) {
        return popup_hit(px, py);
    }
    let n: ptr<AuiNode> = node_at(i);
    let x: i32 = px << 16;
    let y: i32 = py << 16;
    if (x < n.x || y < n.y) { return -1; }
    if (x >= n.x + n.w || y >= n.y + n.h) { return -1; }
    // v1.26：下拉的选项不在普通布局里，关闭状态只命中触发器本身。
    if (n.kind == 25) { return i; }
    // v1.44：组合框同理，建议项不参与普通命中。
    if (n.kind == 49) { return i; }
    let c: i32 = n.first_child;
    if (n.kind == 21) {
        // v1.24：分页只让当前页接收命中；拖动中露出的邻页只是画面，
        // 不能误触上面的按钮。点在空白处则返回容器本身（用于起手拖动）。
        while (c >= 0) {
            let cn: ptr<AuiNode> = node_at(c);
            if (cn.aux2 == n.aux) {
                let hit: i32 = hit_test(c, px, py);
                if (hit >= 0) { return hit; }
                return i;
            }
            c = cn.next_sibling;
        }
        return i;
    }
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        let hit: i32 = hit_test(c, px, py);
        if (hit >= 0) { return hit; }
        c = cn.next_sibling;
    }
    return i;
}

fn find_clickable(i: i32) : i32 {
    let cur: i32 = i;
    while (cur >= 0) {
        let n: ptr<AuiNode> = node_at(cur);
        // v1.36：禁用的图标按钮不是点击目标（也不把点击冒泡给父容器）。
        if (n.kind == 37 && (n.flags & AUI_ICONBTN_DISABLED) != 0) { return -1; }
        // v1.30：刷新容器的回调属于下拉手势，不是点击目标。
        // v2.6：Canvas 的 cb 是 draw_fn，不是点击回调，同样排除。
        if (n.cb != 0 && n.kind != 29 && n.kind != 57) { return cur; }
        cur = n.parent;
    }
    return -1;
}

fn find_scroll(i: i32) : i32 {
    let cur: i32 = i;
    while (cur >= 0) {
        let n: ptr<AuiNode> = node_at(cur);
        // v2.17：拆成两行，避免长 || 链超编译器临时寄存器上限。
        if (n.kind == 9 || n.kind == 32 || n.kind == 51) { return cur; }
        if (n.kind == 53 || n.kind == 55 || n.kind == 58 || n.kind == 63) { return cur; }
        cur = n.parent;
    }
    return -1;
}

// v1.30：最近的纵向滚动祖先（普通滚动或下拉刷新）。两者手势不同：
// 刷新容器在顶部时继续下拖变成位移，不写进滚动偏移。
// v2.6.1：标签栏（kind 19）也是滚动祖先，横向（拖动轴由 DOWN 处按
// kind 置 1，与 hlist 同模式）；Gallery 的 7 标签栏溢出 276 px，
// 不加这一行横向拖动无人认领。
fn find_scrollable(i: i32) : i32 {
    let cur: i32 = i;
    while (cur >= 0) {
        let n: ptr<AuiNode> = node_at(cur);
        // v2.17：拆成两行，避免长 || 链超编译器临时寄存器上限。
        if (n.kind == 9 || n.kind == 19 || n.kind == 29 || n.kind == 32) { return cur; }
        if (n.kind == 51 || n.kind == 53 || n.kind == 55 || n.kind == 58 || n.kind == 63) { return cur; }
        cur = n.parent;
    }
    return -1;
}

fn ref_begin(key: i32, py: i32) : i32 {
    if (key <= 0) { return 0; }
    g_aui_ref_drag_key = key;
    g_aui_ref_y0 = py;
    g_aui_ref_off0 = scroll_get(key);
    g_aui_ref_moved = 0;
    g_aui_drag_key = 0;
    g_aui_dragging = 0;
    return 0;
}

fn ref_clear_drag() : i32 {
    g_aui_ref_drag_key = 0;
    g_aui_ref_moved = 0;
    return 0;
}

// v1.24：命中的节点是否在分页容器里；返回最近的分页容器。
fn find_pager(i: i32) : i32 {
    let cur: i32 = i;
    while (cur >= 0) {
        let n: ptr<AuiNode> = node_at(cur);
        if (n.kind == 21) { return cur; }
        cur = n.parent;
    }
    return -1;
}

// ---- 分页手势（v1.24）----
fn pager_page_count(n: ptr<AuiNode>) : i32 {
    let cnt: i32 = 0;
    let c: i32 = n.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        cnt = cnt + 1;
        c = cn.next_sibling;
    }
    return cnt;
}

fn pager_begin(n: ptr<AuiNode>, px: i32, py: i32, now: i64) : i32 {
    if (n.key <= 0) { return 0; }
    let cnt: i32 = pager_page_count(n);
    if (cnt <= 1) { return 0; }
    let w: i32 = n.w - n.pad * 2;
    if (w <= 0) { return 0; }
    let idx: i32 = n.aux;
    if (idx < 0) { idx = 0; }
    if (idx >= cnt) { idx = cnt - 1; }
    g_aui_pager_drag_key = n.key;
    g_aui_pager_drag_x0 = px;
    g_aui_pager_drag_y0 = py;
    g_aui_pager_drag_off0 = pager_get(n.key);
    g_aui_pager_dragging = 0;
    g_aui_pager_lock = 0;
    g_aui_pager_vel = 0;
    g_aui_pager_last_x = px;
    g_aui_pager_last_t = now;
    g_aui_pager_drag_idx = idx;
    g_aui_pager_drag_cnt = cnt;
    g_aui_pager_drag_w = w;
    g_aui_pager_drag_cb = n.cb;
    g_aui_pager_drag_user = n.user;
    // 新一轮手势接管当前画面：不追上一轮尚未完成的吸附动画。
    pager_anim_stop(n.key);
    return 1;
}

// 同 drag_sample，只是水平方向；偏移速度 = -dx/dt，单位 Q16.16 px/s。
fn pager_sample(px: i32, now: i64) : i32 {
    if (now <= 0 || g_aui_pager_last_t <= 0) {
        g_aui_pager_last_x = px;
        g_aui_pager_last_t = now;
        return 0;
    }
    let dt: i64 = now - g_aui_pager_last_t;
    if (dt <= 0) { return 0; }
    if (dt > 100000000) {
        g_aui_pager_last_x = px;
        g_aui_pager_last_t = now;
        g_aui_pager_vel = 0;
        return 0;
    }
    let dx: i32 = px - g_aui_pager_last_x;
    let inst64: i64 = (i64(0 - dx) * 65536 * 1000000000) / dt;
    let lim: i64 = 12000 * 65536;
    if (inst64 > lim) { inst64 = lim; }
    if (inst64 < 0 - lim) { inst64 = 0 - lim; }
    let inst: i32 = i32(inst64);
    let f: i64 = i64(g_aui_pager_vel) * 3 + i64(inst);
    g_aui_pager_vel = i32(f / 4);
    g_aui_pager_last_x = px;
    g_aui_pager_last_t = now;
    return 0;
}

// 松手提案：速度 >= 600 px/s 时速度说话，否则看位移是否达到 35% 页宽。
// 与 HuxerUI pager 一致，一次只提议相邻页；首尾不会越界。
fn pager_proposal() : i32 {
    let idx: i32 = g_aui_pager_drag_idx;
    let cnt: i32 = g_aui_pager_drag_cnt;
    let w: i32 = g_aui_pager_drag_w;
    let off: i32 = pager_get(g_aui_pager_drag_key);
    let disp: i32 = off - idx * w;
    let dir: i32 = 0;
    let av: i32 = iabs(g_aui_pager_vel);
    if (av >= 600 * 65536) {
        if (g_aui_pager_vel > 0) { dir = 1; }
        if (g_aui_pager_vel < 0) { dir = -1; }
    } else {
        let th: i64 = (i64(w) * 35) / 100;
        if (i64(disp) >= th) { dir = 1; }
        if (i64(disp) <= 0 - th) { dir = -1; }
    }
    if (dir > 0 && idx + 1 < cnt) { return idx + 1; }
    if (dir < 0 && idx > 0) { return idx - 1; }
    return idx;
}

fn pager_release() : i32 {
    let key: i32 = g_aui_pager_drag_key;
    if (key == 0) { return 0; }
    let proposal: i32 = pager_proposal();
    let target: i32 = proposal * g_aui_pager_drag_w;
    pager_anim_to(key, target, 200);
    if (proposal != g_aui_pager_drag_idx) {
        g_aui_pager_prop_key = key;
        g_aui_pager_prop_val = proposal;
        let cb: fn(ptr) : i32 = g_aui_pager_drag_cb;
        let user: ptr = g_aui_pager_drag_user;
        if (cb != 0) {
            let r: i32 = cb(user);
        }
    }
    pager_drag_clear();
    return proposal;
}

// 取消/轻点收尾：回到按下时所在页，不提案、不回调。
fn pager_gesture_end() : i32 {
    let key: i32 = g_aui_pager_drag_key;
    if (key != 0) {
        let target: i32 = g_aui_pager_drag_idx * g_aui_pager_drag_w;
        pager_anim_to(key, target, 200);
    }
    pager_drag_clear();
    return 0;
}

fn find_kind(i: i32, kind: i32) : i32 {
    let cur: i32 = i;
    while (cur >= 0) {
        let n: ptr<AuiNode> = node_at(cur);
        if (n.kind == kind) { return cur; }
        cur = n.parent;
    }
    return -1;
}

// ---- 滑块手势（v1.20）----
// 值域固定 0..1000（千分比）。吸附规则同 HuxerUI：首尾值总是可达，
// 中间值取最近的 step 倍数（step=0 或 1 表示不吸附）。
fn slider_snap(v: i32, step: i32) : i32 {
    if (v <= 0) { return 0; }
    if (v >= 1000) { return 1000; }
    if (step <= 1) { return v; }
    let h: i32 = step / 2;
    let q: i32 = ((v + h) / step) * step;
    if (q < 0) { q = 0; }
    if (q > 1000) { q = 1000; }
    return q;
}

// 按屏幕 x 求新值；有变化就调回调。返回 1 = 值变了。
fn slider_apply(px: i32) : i32 {
    if (g_aui_slider_key == 0 || g_aui_slider_w <= 0) { return 0; }
    let xq: i32 = fx(px) - g_aui_slider_x;
    let raw: i32 = i32((i64(xq) * 1000) / i64(g_aui_slider_w));
    let v: i32 = slider_snap(raw, g_aui_slider_step);
    if (v == g_aui_slider_val) { return 0; }
    g_aui_slider_val = v;
    if (g_aui_slider_cb != 0) {
        let r: i32 = g_aui_slider_cb(g_aui_slider_user);
    }
    return 1;
}

// 按下：记下按下时的矩形（Q16.16）与步长。拖动中用按下时矩形换算，
// 布局在拖动期间变化也不会让拇指跳动。
fn slider_begin(n: ptr<AuiNode>, px: i32) : i32 {
    g_aui_slider_key = n.key;
    g_aui_slider_val = n.aux;
    if (g_aui_slider_val < 0) { g_aui_slider_val = 0; }
    if (g_aui_slider_val > 1000) { g_aui_slider_val = 1000; }
    g_aui_slider_step = n.aux2;
    if (g_aui_slider_step < 1) { g_aui_slider_step = 1; }
    let inset: i32 = dp2q(9);
    g_aui_slider_x = n.x + inset;
    g_aui_slider_w = n.w - inset * 2;
    if (g_aui_slider_w < dp2q(24)) {
        g_aui_slider_x = n.x;
        g_aui_slider_w = n.w;
    }
    g_aui_slider_cb = n.cb;
    g_aui_slider_user = n.user;
    let ch: i32 = slider_apply(px);
    return ch;
}

fn slider_end() : i32 {
    g_aui_slider_key = 0;
    g_aui_slider_cb = 0;
    g_aui_slider_user = 0;
    return 0;
}

// ---- 分隔条拖动（v2.12）----
// 分隔条中心沿主轴的绝对像素坐标（命中判断与拖动换算共用）；
// 少于两个窗格时无分隔条，返回 -1。
fn split_div_center(n: ptr<AuiNode>) : i32 {
    let c1: i32 = n.first_child;
    if (c1 < 0) { return -1; }
    let c2: i32 = node_at(c1).next_sibling;
    if (c2 < 0) { return -1; }
    let n1: ptr<AuiNode> = node_at(c1);
    if (n.aux == 1) {
        return (n1.x + n1.w + dp2q(AUI_SPLIT_DIV_DP) / 2) >> 16;
    }
    return (n1.y + n1.h + dp2q(AUI_SPLIT_DIV_DP) / 2) >> 16;
}

// 点是否落在分隔条命中区（中心 ±12 dp，且沿另一轴在节点范围内）。
fn split_hit(n: ptr<AuiNode>, px: i32, py: i32) : i32 {
    let c: i32 = split_div_center(n);
    if (c < 0) { return 0; }
    let half: i32 = dp2q(12) >> 16;
    if (n.aux == 1) {
        if (py < n.y >> 16 || py > (n.y + n.h) >> 16) { return 0; }
        let d: i32 = iabs(px - c);
        if (d <= half) { return 1; }
        return 0;
    }
    if (px < n.x >> 16 || px > (n.x + n.w) >> 16) { return 0; }
    let d: i32 = iabs(py - c);
    if (d <= half) { return 1; }
    return 0;
}

// 按下：快照按下时的比例/指针位置/可用总长/最小窗格（像素），拖动中
// 用快照换算（与滑块同模式）。返回 1 = 抢到拖动。
fn split_begin(n: ptr<AuiNode>, px: i32, py: i32) : i32 {
    if (n.key == 0) { return 0; }
    let s: i32 = split_find(n.key);
    if (s < 0) { return 0; }
    if (split_hit(n, px, py) == 0) { return 0; }
    g_aui_split_drag_key = n.key;
    g_aui_split_drag_ratio0 = g_aui_split_ratio[s];
    g_aui_split_drag_horiz = n.aux;
    if (n.aux == 1) {
        g_aui_split_drag_pos0 = px;
        let total: i32 = (n.w - n.pad * 2 - dp2q(AUI_SPLIT_DIV_DP)) >> 16;
        g_aui_split_drag_total = total;
    } else {
        g_aui_split_drag_pos0 = py;
        let total: i32 = (n.h - n.pad * 2 - dp2q(AUI_SPLIT_DIV_DP)) >> 16;
        g_aui_split_drag_total = total;
    }
    let minpx: i32 = dp2q(g_aui_split_min[s]) >> 16;
    g_aui_split_drag_min = minpx;
    g_aui_split_drag_cb = g_aui_split_cb[s];
    g_aui_split_drag_user = g_aui_split_user[s];
    g_aui_split_drag_live = g_aui_split_drag_ratio0;
    return 1;
}

// 按指针位置求新比例；有变化就写登记表并调回调。返回 1 = 比例变了。
fn split_apply(px: i32, py: i32) : i32 {
    if (g_aui_split_drag_key == 0) { return 0; }
    if (g_aui_split_drag_total <= 0) { return 0; }
    let pos: i32 = px;
    if (g_aui_split_drag_horiz == 0) { pos = py; }
    let d: i32 = pos - g_aui_split_drag_pos0;
    let raw: i32 = g_aui_split_drag_ratio0 + i32((i64(d) * 1000) / i64(g_aui_split_drag_total));
    // 最小窗格边界：比例夹在 [min*1000/total, 1000-min*1000/total]；
    // 总长小于 2*min 时布局均分，拖动也锁在 500（与布局一致）。
    let lo: i32 = 0;
    let hi: i32 = 1000;
    if (g_aui_split_drag_total >= g_aui_split_drag_min * 2) {
        lo = i32((i64(g_aui_split_drag_min) * 1000) / i64(g_aui_split_drag_total));
        hi = 1000 - lo;
    } else {
        lo = 500;
        hi = 500;
    }
    let v: i32 = raw;
    if (v < lo) { v = lo; }
    if (v > hi) { v = hi; }
    if (v == g_aui_split_drag_live) { return 0; }
    g_aui_split_drag_live = v;
    let s: i32 = split_find(g_aui_split_drag_key);
    if (s >= 0) { g_aui_split_ratio[s] = v; }
    if (g_aui_split_drag_cb != 0) {
        let r: i32 = g_aui_split_drag_cb(g_aui_split_drag_user);
    }
    return 1;
}

fn split_end() : i32 {
    g_aui_split_drag_key = 0;
    g_aui_split_drag_cb = 0;
    g_aui_split_drag_user = 0;
    return 0;
}

fn event_x(ev: ptr) : i32 {
    let junk: i32 = AMotionEvent_getX(ev, 0);
    return lrintf();
}

fn event_y(ev: ptr) : i32 {
    let junk: i32 = AMotionEvent_getY(ev, 0);
    return lrintf();
}

// v2.18：任意 pointer index 的坐标（与 event_x/y 同一 lrintf 桥；
// getX/getY 与 lrintf 必须紧邻，中间不插 Aster 调用）。
fn event_xi(ev: ptr, idx: i32) : i32 {
    let junk: i32 = AMotionEvent_getX(ev, idx);
    return lrintf();
}

fn event_yi(ev: ptr, idx: i32) : i32 {
    let junk: i32 = AMotionEvent_getY(ev, idx);
    return lrintf();
}

// v1.8：只接管 KEYCODE_BACK。返回 1 = 已消费（DOWN/UP 都消费，避免系统
// 在 UP 时再 finish 一次）；其他按键返回 0，交给系统处理音量等。
fn handle_key(ev: ptr) : i32 {
    let code: i32 = AKeyEvent_getKeyCode(ev);
    let act: i32 = AKeyEvent_getAction(ev);
    if (code != 4) { return 0; }
    // 转场期间吞掉 BACK，避免连跳；到点则先结束转场再处理这一下。
    let pr: i32 = page_refresh();
    if (pr != 0) { return 1; }
    // 动作放在 UP：长按 BACK 会重复发 DOWN，若在 DOWN 里 pop 会连跳多页。
    if (act == 0) {
        let tk: i32 = trace_hex(107, code);   // k + keycode
    } else if (act == 1) {
        // v1.27：气泡可见时 BACK 只收起气泡，不关对话框/页面、不退出。
        if (g_aui_tip_on != 0 || g_aui_tip_pend != 0) {
            let th: i32 = tip_dismiss();
            let ti: i32 = aui_invalidate();
            return 1;
        }
        // v2.7：长按待定/已触发时 BACK 只取消长按，不关对话框/页面、不退出。
        // D-2a：可选中待定同样只取消待定（已建立的选区不受影响）。
        if (g_aui_lp_pend != 0 || g_aui_lp_fired != 0 || g_d2a_sel_pend != 0) {
            let lc3: i32 = lp_cancel_why(2);
            let li: i32 = aui_invalidate();
            return 1;
        }
        // v1.35：菜单优先吃 BACK（浮层层级最高），不 pop 页面、不退出。
        if (g_aui_menu >= 0) {
            let mr: i32 = menu_close(AUI_MENU_REASON_BACK);
            let mi: i32 = aui_invalidate();
            return 1;
        }
        // v1.38：底部弹出层优先吃 BACK（在对话框之前；两者互斥）。
        if (g_aui_sheet >= 0) {
            let sn: ptr<AuiNode> = node_at(g_aui_sheet);
            g_aui_sheet_drag = -1;
            if (sn.cb != 0) {
                g_aui_sheet_reason = 2;
                let sc: i32 = sn.cb(sn.user);
            }
            let si: i32 = aui_invalidate();
            return 1;
        }
        // v1.39：锚定浮层吃 BACK（reason=2），不 pop 页面、不退出。
        if (g_aui_popup >= 0) {
            let pc: i32 = popup_close(2);
            let pi: i32 = aui_invalidate();
            return 1;
        }
        // v1.25：对话框优先吃 BACK；应用在回调里把 open 置 0。
        if (g_aui_dialog >= 0) {
            let dn: ptr<AuiNode> = node_at(g_aui_dialog);
            if (dn.cb != 0) {
                g_aui_dialog_reason = 2;
                let dc: i32 = dn.cb(dn.user);
            }
            let di: i32 = aui_invalidate();
            return 1;
        }
        // v1.44：组合框展开时 BACK 关闭建议列表，不 pop 页面、不退出。
        if (g_aui_combo_open >= 0) {
            let cn: ptr<AuiNode> = node_at(g_aui_combo_open);
            g_aui_combo_press = -1;
            g_aui_combo_down = -3;
            g_aui_combo_drag = 0;
            if (cn.cb != 0) {
                g_aui_combo_reason = 3;
                let cc: i32 = cn.cb(cn.user);
            }
            let ci: i32 = aui_invalidate();
            return 1;
        }
        // v1.26：下拉展开时 BACK 关闭浮层，不 pop 页面、不退出。
        if (g_aui_select_open >= 0) {
            let sn: ptr<AuiNode> = node_at(g_aui_select_open);
            g_aui_select_press = -1;
            g_aui_select_down = -3;
            g_aui_select_drag = 0;
            if (sn.cb != 0) {
                g_aui_select_reason = 3;
                let sc: i32 = sn.cb(sn.user);
            }
            let si: i32 = aui_invalidate();
            return 1;
        }
        if (g_aui_focus_key != 0) {
            let f: i32 = aui_focus(0);
            let r: i32 = aui_invalidate();
        } else if (g_aui_nav_depth > 1) {
            let p: i32 = aui_nav_pop();
        } else {
            let q: i32 = aui_finish();
        }
    }
    return 1;
}

fn handle_motion(ev: ptr) : i32 {
    let act: i32 = AMotionEvent_getAction(ev);
    let a: i32 = act & 255;
    let px: i32 = event_x(ev);
    let py: i32 = event_y(ev);
    let now: i64 = clock_ns();
    if (a == 0 || a == 1) {
        let tt: i32 = trace_hex(84, a);                  // T + action
        let tx: i32 = trace_hex(120, px);                // x + 像素 x
        let ty: i32 = trace_hex(121, py);                // y + 像素 y
    }
    // 转场期间不派发点击；到点（或帧定时器不可用）就先结束转场，
    // 让这一次手势照常生效 —— 界面永远不会被半截转场锁死。
    let pr: i32 = page_refresh();
    if (pr != 0) { return 0; }
    // v2.18：多指（转场守卫之后：转场期间的按下不建手势，第二指也
    // 不接管）。动作高字节是 pointer index（设计文档 §10.2，用 /256
    // 拆分）；a==5/6 是第二指按下/抬起，旧代码不进任何分支、静默消费。
    // 第一指 id 在 DOWN 时记、UP/CANCEL 时清，供捏合按 id 跟踪两指
    // （index 会随抬起变化，id 稳定）。
    let pidx: i32 = act / 256;
    if (a == 0) {
        if (g_aui_pn_state == 1) { let px2: i32 = pn_end(1); }
        g_aui_pn_p0id = AMotionEvent_getPointerId(ev, 0);
        g_aui_pn_p0x = px;
        g_aui_pn_p0y = py;
    }
    if (a == 1 || a == 3) {
        g_aui_pn_p0id = -1;
    }
    if (a == 5) {
        let pd: i32 = pn_pointer_down(ev, pidx);
        return 0;
    }
    if (a == 6) {
        let pu: i32 = pn_pointer_up(ev, pidx);
        return 0;
    }
    if (g_aui_pn_state == 1) {
        if (a == 2) {
            let pm: i32 = pn_move(ev);
            return 0;
        }
        if (a == 1) {
            let pe: i32 = pn_end(0);
            return 0;
        }
        if (a == 3) {
            let pc: i32 = pn_end(1);
            return 0;
        }
    }
    if (a == 0) {
        // v1.27：任何新的按下先收起已有气泡/待定长按。
        let th: i32 = tip_dismiss();
        // v2.7：新的按下先取消已有长按待定/已触发。
        let lc: i32 = lp_cancel_why(1);
        let fz: i32 = fling_stop();                  // 新手势打断惯性
        // v1.39：浮层的 DOWN 落点每次按下重新记录（-3 = 本次未落到浮层）。
        g_aui_popup_down = -3;
        pager_drag_clear();
        date_press_clear();
        time_press_clear();
        g_aui_vel = 0;
        g_aui_last_y = py;
        g_aui_last_t = now;
        // v2.8：DEBUG overlay 是 System 级最顶层（HuxerUI 的层级），
        // 命中先于菜单/弹窗/页面；缎带和面板之外的点按原样穿透到底层。
        if (dbg_ribbon_hit(px, py) != 0) {
            g_dbg_down = 1;
            g_dbg_moved = 0;
            g_dbg_dx = px;
            g_dbg_dy = py;
            let ir: i32 = aui_invalidate();
            return 0;
        }
        if (dbg_panel_hit(px, py) != 0) {
            g_dbg_panel_down = 1;
            g_dbg_dx = px;
            g_dbg_dy = py;
            let ir2: i32 = aui_invalidate();
            return 0;
        }
        // v1.35：菜单是内容层模态浮层，优先于 SnackBar 和页面。
        if (g_aui_menu >= 0) {
            g_aui_pressing = 0;
            g_aui_press_key = 0;
            g_aui_drag_key = 0;
            g_aui_dragging = 0;
            let md: i32 = menu_pointer_down(px, py);
            aui_invalidate();
            return 0;
        }
        // v1.38：底部弹出层。滑入期间吞掉按下；顶部 32 dp 是拖拽区，
        // 从这里起手不进入滚动/点击，直接接管为下拉手势。
        if (g_aui_sheet >= 0) {
            if (g_aui_sheet_until != 0 && anim_now() < g_aui_sheet_until) {
                g_aui_pressing = 0;
                g_aui_press_key = 0;
                g_aui_drag_key = 0;
                g_aui_dragging = 0;
                return 0;
            }
            let scn: ptr<AuiNode> = node_at(g_aui_sheet_card);
            let grz: i32 = dp2q(32);
            let qx: i32 = px << 16;
            let qy: i32 = py << 16;
            if (qx >= scn.x && qx < scn.x + scn.w &&
                qy >= scn.y && qy < scn.y + grz) {
                g_aui_sheet_drag = 0;
                g_aui_sheet_dy0 = py;
                g_aui_pressing = 0;
                g_aui_press_key = 0;
                g_aui_drag_key = 0;
                g_aui_dragging = 0;
                aui_invalidate();
                return 0;
            }
        }
        // v1.34：SnackBar 是内容层浮层：按下动作按钮/表面都先由它接管，
        // 不让点击穿透到底下的页面。Toast 是 pass-through，不在这里处理。
        let sh: i32 = present_snack_hit(px, py);
        if (sh != 0) {
            g_aui_snack_down = sh;
            g_aui_snack_dx = px;
            g_aui_snack_dy = py;
            g_aui_pressing = 0;
            g_aui_press_key = 0;
            g_aui_drag_key = 0;
            g_aui_dragging = 0;
            if (sh == 2) {
                g_aui_snack_press = 1;
                g_aui_snack_paused = 1;
                g_aui_snack_last = anim_now();
            }
            aui_invalidate();
            return 0;
        }
        let hit: i32 = hit_test(g_aui_root, px, py);
        // D-2a：点按其它处清除已有选区（点在已选节点本身上时保留）。
        // 模态层（菜单/弹出层/SnackBar）在前面已提前返回，不经过这里。
        if (g_d2a_sel_node >= 0 && hit != g_d2a_sel_node) { let sc: i32 = d2a_sel_clear(); }
        // v1.39：锚定浮层记录 DOWN 落点。外部/内边距由浮层独占，不进入
        // 滚动/分页/按钮通用路径；内容里的孩子照常走下面的控件分支。
        if (g_aui_popup >= 0) {
            g_aui_popup_down = popup_hit(px, py);
            g_aui_popup_dx = px;
            g_aui_popup_dy = py;
            if (g_aui_popup_down == -1 || g_aui_popup_down == -2) {
                g_aui_pressing = 0;
                g_aui_press_key = 0;
                g_aui_drag_key = 0;
                g_aui_dragging = 0;
                aui_invalidate();
                return 0;
            }
        }
        // v1.44：组合框展开时是半模态。只拦触发器、浮层和建议；屏幕
        // 键盘键继续走普通路径（否则没法继续打字）。
        if (g_aui_combo_open >= 0 && find_kind(hit, 11) < 0) {
            let cn: ptr<AuiNode> = node_at(g_aui_combo_open);
            g_aui_combo_press = -1;
            g_aui_combo_down = hit;
            g_aui_combo_dx = px;
            g_aui_combo_dy = py;
            g_aui_combo_drag = 0;
            if (hit == -2 || hit < 0) {
                g_aui_pressing = 0;
                g_aui_press_key = 0;
                return 0;
            }
            if (hit == g_aui_combo_open) {
                g_aui_press_key = cn.key;
                g_aui_pressing = 1;
                aui_invalidate();
                return 0;
            }
            let hn: ptr<AuiNode> = node_at(hit);
            if (hn.kind == 50) {
                g_aui_combo_press = hn.aux2;
                g_aui_pressing = 0;
                g_aui_press_key = 0;
                aui_invalidate();
                return 0;
            }
            return 0;
        }
        // v1.26：下拉展开时是模态层，不进入滚动/分页/按钮通用路径。
        if (g_aui_select_open >= 0) {
            let sn: ptr<AuiNode> = node_at(g_aui_select_open);
            g_aui_select_press = -1;
            g_aui_select_down = hit;
            g_aui_select_dx = px;
            g_aui_select_dy = py;
            g_aui_select_drag = 0;
            if (hit == -2) {
                g_aui_pressing = 0;
                g_aui_press_key = 0;
                return 0;
            }
            if (hit < 0) {
                g_aui_pressing = 0;
                g_aui_press_key = 0;
                return 0;
            }
            if (hit == g_aui_select_open) {
                g_aui_press_key = sn.key;
                g_aui_pressing = 1;
                aui_invalidate();
                return 0;
            }
            let hn: ptr<AuiNode> = node_at(hit);
            if (hn.kind == 26) {
                g_aui_select_press = hn.aux2;
                g_aui_pressing = 0;
                g_aui_press_key = 0;
                aui_invalidate();
                return 0;
            }
            return 0;
        }
        // v1.27：命中有工具提示的节点（含祖先）：先记为待定，500 ms 不动
        // 才显示。文本快照与锚点矩形在这里固定，之后重建不受影响。
        let tk: i32 = find_tip(hit);
        if (tk >= 0) {
            let tn: ptr<AuiNode> = node_at(g_aui_tips_node[tk]);
            g_aui_tip_pend = 1;
            g_aui_tip_pend_idx = tk;
            g_aui_tip_start = now;
            g_aui_tip_downx = px;
            g_aui_tip_downy = py;
            g_aui_tip_text = g_aui_tips_text[tk];
            g_aui_tip_side = g_aui_tips_side[tk];
            g_aui_tip_align = g_aui_tips_align[tk];
            g_aui_tip_ax = tn.x;
            g_aui_tip_ay = tn.y;
            g_aui_tip_aw = tn.w;
            g_aui_tip_ah = tn.h;
            g_aui_pump_need = 1;
            let tw0: i32 = pump_wake();
        }
        // v2.7：命中有长按回调的节点（含祖先）：先记为待定，500 ms 不动
        // 才触发。回调与 key 在触发时从登记表取，节点 key 在按下时快照。
        let lk: i32 = find_lp(hit);
        if (lk >= 0) {
            let ln: ptr<AuiNode> = node_at(g_aui_lp_node[lk]);
            g_aui_lp_pend = 1;
            g_aui_lp_pend_idx = lk;
            g_aui_lp_pend_key = ln.key;
            g_aui_lp_start = now;
            g_aui_lp_downx = px;
            g_aui_lp_downy = py;
            g_aui_pump_need = 1;
            let lw0: i32 = pump_wake();
        }
        // D-2a：无回调登记的可选中文本节点：记为选中待定（与长按同阈值）。
        // 有回调的节点走上面的长按路径，不产生选区；命中节点本身须是
        // 文本节点（label），祖先的可选中标记不继承（与 find_lp 的祖先
        // 走查不同，见 D2A-SCHEMA.md）。
        if (lk < 0 && hit >= 0) {
            let hn2: ptr<AuiNode> = node_at(hit);
            if (hn2.kind == 5 && g_d2a_sel[hit] != 0) {
                g_d2a_sel_pend = 1;
                g_d2a_sel_pend_idx = hit;
                g_d2a_sel_pend_key = hn2.key;
                g_d2a_sel_start_ns = now;
                g_d2a_sel_downx = px;
                g_d2a_sel_downy = py;
                g_aui_pump_need = 1;
                let sw0: i32 = pump_wake();
            }
        }
        // v2.7.1-diag：按下行（key=-1 表示未命中长按节点；tip=工具提示待定）。
        let ldk: i32 = -1;
        if (lk >= 0) {
            ldk = g_aui_lp_pend_key;
            g_aui_lp_diag_ticks = 0;
            g_aui_lp_diag_idle = 0;
        }
        let dl: i32 = aui_log3(4, "lp down key=", ldk, " lk=", lk, " tip=", g_aui_tip_pend, "");
        // 文本字段 / 键盘键自己处理按压，不进入滚动与按钮回调。
        let fk: i32 = find_kind(hit, 10);
        let kk: i32 = find_kind(hit, 11);
        if (fk >= 0 || kk >= 0) {
            let sn: i32 = fk;
            if (sn < 0) { sn = kk; }
            let snn: ptr<AuiNode> = node_at(sn);
            g_aui_press_key = snn.key;
            g_aui_pressing = 1;
            g_aui_drag_key = 0;
            g_aui_dragging = 0;
            aui_invalidate();
            return 0;
        }
        // 滑块自己接管整个手势（按下即跳到该位置），不进入滚动与点击。
        let sk: i32 = find_kind(hit, 16);
        if (sk >= 0) {
            let snn: ptr<AuiNode> = node_at(sk);
            g_aui_press_key = 0;
            g_aui_pressing = 0;
            g_aui_drag_key = 0;
            g_aui_dragging = 0;
            let ch: i32 = slider_begin(snn, px);
            aui_invalidate();
            return 0;
        }
        // v2.12：分栏分隔条自己接管拖动（与滑块同模式）：DOWN 落在命中区
        // 才抢，不落则继续走滚动/点击（窗格里的按钮照常点）。
        let spk: i32 = find_kind(hit, 61);
        if (spk >= 0) {
            let snn: ptr<AuiNode> = node_at(spk);
            let got: i32 = split_begin(snn, px, py);
            if (got != 0) {
                g_aui_press_key = 0;
                g_aui_pressing = 0;
                g_aui_drag_key = 0;
                g_aui_dragging = 0;
                aui_invalidate();
                return 0;
            }
        }
        // v1.28：日期选择自己接管按下：记录子目标（翻月/标题/日/年），
        // 松手时只有同一目标才激活。仍记录滚动候选，移动超过 8 dp 后
        // 取消按压并让父滚动容器接管纵向拖动。
        let dk: i32 = find_kind(hit, 27);
        if (dk >= 0) {
            let dnn: ptr<AuiNode> = node_at(dk);
            g_aui_date_press_key = dnn.key;
            g_aui_date_press_tgt = date_hit(dnn, px, py);
            g_aui_date_down_x = px;
            g_aui_date_down_y = py;
            g_aui_date_drag = 0;
            g_aui_press_key = 0;
            g_aui_pressing = 0;
            g_aui_drag_key = 0;
            g_aui_dragging = 0;
            // 仍登记分页候选：横向滑页可以从日期网格上开始。
            let dpn: i32 = find_pager(hit);
            if (dpn >= 0) {
                let dpnn: ptr<AuiNode> = node_at(dpn);
                let dpb: i32 = pager_begin(dpnn, px, py, now);
            }
            let dsn: i32 = find_scroll(hit);
            if (dsn >= 0) {
                let dsnn: ptr<AuiNode> = node_at(dsn);
                g_aui_drag_key = dsnn.key;
                g_aui_drag_axis = 0;
                g_aui_drag_y0 = py;
                g_aui_drag_off0 = scroll_get(dsnn.key);
            }
            aui_invalidate();
            return 0;
        }
        // v1.29：时间选择按下。头部字段/AM/PM 只记录目标，松手时同目标
        // 才切换；表盘立即捕获并取值，拖动中连续更新，松手后若还在选时
        // 自动进入选分。表盘捕获期间不让父滚动容器抢手势。
        let tmk: i32 = find_kind(hit, 28);
        if (tmk >= 0) {
            let tmnn: ptr<AuiNode> = node_at(tmk);
            g_aui_time_press_key = tmnn.key;
            g_aui_time_press_tgt = time_hit(tmnn, px, py);
            g_aui_time_down_x = px;
            g_aui_time_down_y = py;
            g_aui_time_drag = 0;
            g_aui_time_dial = 0;
            g_aui_press_key = 0;
            g_aui_pressing = 0;
            g_aui_drag_key = 0;
            g_aui_dragging = 0;
            if (g_aui_time_press_tgt == 10) {
                g_aui_time_dial = 1;
                let tmch: i32 = time_dial_apply(tmnn, px, py);
                aui_invalidate();
                return 0;
            }
            // 头部按压仍登记分页/滚动候选，拖动超过 8 dp 后交给父容器。
            let tmpn: i32 = find_pager(hit);
            if (tmpn >= 0) {
                let tmpnn: ptr<AuiNode> = node_at(tmpn);
                let tmpb: i32 = pager_begin(tmpnn, px, py, now);
            }
            let tmsn: i32 = find_scroll(hit);
            if (tmsn >= 0) {
                let tmsnn: ptr<AuiNode> = node_at(tmsn);
                g_aui_drag_key = tmsnn.key;
                g_aui_drag_axis = 0;
                g_aui_drag_y0 = py;
                g_aui_drag_off0 = scroll_get(tmsnn.key);
            }
            aui_invalidate();
            return 0;
        }
        // v1.24：分页与滚动都先记为候选，MOVE 的第一个 8 dp 决定方向。
        let pn: i32 = find_pager(hit);
        if (pn >= 0) {
            let pnn: ptr<AuiNode> = node_at(pn);
            let pb: i32 = pager_begin(pnn, px, py, now);
        }
        // 记录拖动起点：只有命中的节点在滚动容器里才可能滚动。
        g_aui_drag_key = 0;
        g_aui_dragging = 0;
        ref_clear_drag();
        let sn: i32 = find_scrollable(hit);
        if (sn >= 0) {
            let snn: ptr<AuiNode> = node_at(sn);
            if (snn.kind == 29) {
                let rb: i32 = ref_begin(snn.key, py);
            } else {
                g_aui_drag_key = snn.key;
                g_aui_drag_axis = 0;
                if (snn.kind == 55 || snn.kind == 19) { g_aui_drag_axis = 1; }
                // v2.17：表格双向滚动——DOWN 时不定轴，MOVE 首个超容差
                // 方向定轴；同时快照横向偏移。
                if (snn.kind == 63) {
                    g_aui_drag_axis = 2;
                    g_aui_drag_offx0 = vtable_off_x(snn.key);
                }
                g_aui_drag_y0 = py;
                g_aui_drag_x0 = px;
                g_aui_last_x = px;
                g_aui_drag_off0 = scroll_get(snn.key);
            }
        }
        let cbnode: i32 = find_clickable(hit);
        if (cbnode >= 0) {
            let n: ptr<AuiNode> = node_at(cbnode);
            g_aui_press_key = n.key;
            g_aui_pressing = 1;
            // v2.7：记下 DOWN 点；MOVE 移出 8 dp 即取消点按（Android touch slop）。
            g_aui_press_downx = px;
            g_aui_press_downy = py;
            let rpr: i32 = ripple_press(n, px, py);   // v1.48：从触点起波纹
            aui_invalidate();
        }
        return 0;
    }
    if (a == 2) {
        // v2.7.1-diag：MOVE 事件计数（滚动帧日志里看后端是否合并/节流）。
        g_aui_diag_moves = g_aui_diag_moves + 1;
        // v1.35：菜单手势独占（滚动内部条目），不传给底层。
        if (g_aui_menu >= 0) {
            let mm: i32 = menu_pointer_move(px, py);
            return 0;
        }
        // v2.8：DEBUG overlay 手势独占。缎带上移出 8 dp 记 moved（本
        // 次抬起不切换）；面板上起手的移动直接吞掉，不带动底层滚动。
        if (g_dbg_down != 0) {
            let ddx: i32 = px - g_dbg_dx;
            let ddy: i32 = py - g_dbg_dy;
            let dadx: i32 = iabs(ddx);
            let dady: i32 = iabs(ddy);
            let dslop: i32 = dp2q(8) >> 16;
            if (dadx > dslop || dady > dslop) { g_dbg_moved = 1; }
            return 0;
        }
        if (g_dbg_panel_down != 0) { return 0; }
        // v1.39：浮层外/内边距起手的移动直接吞掉，避免带动底层滚动；
        // 浮层内容里的滑块/日期/时间/滚动仍走下面的通用分支。
        if (g_aui_popup >= 0) {
            if (g_aui_popup_down == -1 || g_aui_popup_down == -2) { return 0; }
        }
        // v1.38：底部弹出层拖拽。只重排不重建，偏移按 Q16.16 记录。
        if (g_aui_sheet_drag >= 0) {
            let sdd: i32 = py - g_aui_sheet_dy0;
            if (sdd < 0) { sdd = 0; }
            g_aui_sheet_drag = sdd << 16;
            aui_invalidate_layout();
            return 0;
        }
        // v1.34：SnackBar 手势独占；动作按钮上移动超过 8 dp 取消按下态，
        // 但本次手势仍然不传给底层。
        if (g_aui_snack_down != 0) {
            if (g_aui_snack_down == 2) {
                let sdx: i32 = px - g_aui_snack_dx;
                let sdy: i32 = py - g_aui_snack_dy;
                let sadx: i32 = iabs(sdx);
                let sady: i32 = iabs(sdy);
                let sslop: i32 = dp2q(8) >> 16;
                if (sadx > sslop || sady > sslop) {
                    if (g_aui_snack_press != 0) {
                        g_aui_snack_press = 0;
                        aui_invalidate();
                    }
                }
            }
            return 0;
        }
        // v1.27：长按待定在移动超过 8 dp 时取消（HuxerUI 手势 slop）。
        if (g_aui_tip_pend != 0) {
            let tdx: i32 = px - g_aui_tip_downx;
            let tdy: i32 = py - g_aui_tip_downy;
            let tadx: i32 = iabs(tdx);
            let tady: i32 = iabs(tdy);
            let tslop: i32 = dp2q(8) >> 16;
            if (tadx > tslop || tady > tslop) {
                g_aui_tip_pend = 0;
                g_aui_tip_pend_idx = -1;
            }
        }
        // v2.7：长按待定在移动超过 8 dp 时取消（与工具提示同 slop；
        // 滚动拖拽起手即超过 slop，所以拖拽天然取消长按）。
        if (g_aui_lp_pend != 0) {
            let ldx: i32 = px - g_aui_lp_downx;
            let ldy: i32 = py - g_aui_lp_downy;
            let ladx: i32 = iabs(ldx);
            let lady: i32 = iabs(ldy);
            let lslop: i32 = dp2q(8) >> 16;
            if (ladx > lslop || lady > lslop) {
                g_aui_lp_pend = 0;
                g_aui_lp_pend_idx = -1;
                g_aui_lp_pend_key = 0;
                // v2.7.1-diag：移动超 8 dp 取消（why=5）。
                let mel: i32 = i32((clock_ns() - g_aui_lp_start) / 1000000);
                let ml: i32 = aui_log3(4, "lp cancel why=", 5, " el=", mel, "ms ticks=", g_aui_lp_diag_ticks, "");
            }
        }
        // D-2a：可选中待定同样在移动超过 8 dp 时取消（与长按同 slop）。
        if (g_d2a_sel_pend != 0) {
            let sdx: i32 = px - g_d2a_sel_downx;
            let sdy: i32 = py - g_d2a_sel_downy;
            let sadx: i32 = iabs(sdx);
            let sady: i32 = iabs(sdy);
            let sslop: i32 = dp2q(8) >> 16;
            if (sadx > sslop || sady > sslop) {
                let sc2: i32 = d2a_sel_cancel_pend();
            }
        }
        // v1.26.2：下拉是模态层，MOVE 只用来判定拖动。超过 8 dp 就取消
        // 按压视觉，松手时不再按 UP 所在选项选中。
        if (g_aui_select_open >= 0) {
            let sdx: i32 = px - g_aui_select_dx;
            let sdy: i32 = py - g_aui_select_dy;
            let sadx: i32 = iabs(sdx);
            let sady: i32 = iabs(sdy);
            let sslop: i32 = dp2q(8) >> 16;
            if (g_aui_select_drag == 0 && (sadx > sslop || sady > sslop)) {
                g_aui_select_drag = 1;
                g_aui_select_press = -1;
                g_aui_pressing = 0;
                g_aui_press_key = 0;
                aui_invalidate();
            }
            return 0;
        }
        // v1.28：日期按压超过 8 dp 视为拖动，取消按压视觉并让父滚动
        // 容器继续处理这次 MOVE；未超过阈值时吞掉移动，保持按压。
        if (g_aui_date_press_key != 0) {
            let ddx: i32 = px - g_aui_date_down_x;
            let ddy: i32 = py - g_aui_date_down_y;
            let dadx: i32 = iabs(ddx);
            let dady: i32 = iabs(ddy);
            let dslop: i32 = dp2q(8) >> 16;
            if (dadx <= dslop && dady <= dslop) { return 0; }
            g_aui_date_press_tgt = -1;
            g_aui_date_drag = 1;
            aui_invalidate();
        }
        // v1.29：表盘捕获后连续取值，并吞掉移动不让父容器滚动；
        // 头部按压超过 8 dp 则取消目标，继续走下面的滚动/分页分支。
        if (g_aui_time_press_key != 0) {
            if (g_aui_time_dial != 0) {
                let tdi: i32 = time_node(g_aui_time_press_key);
                if (tdi >= 0) {
                    let tnn: ptr<AuiNode> = node_at(tdi);
                    let tch: i32 = time_dial_apply(tnn, px, py);
                    if (tch != 0) { aui_invalidate(); }
                }
                return 0;
            }
            let tdx: i32 = px - g_aui_time_down_x;
            let tdy: i32 = py - g_aui_time_down_y;
            let tadx: i32 = iabs(tdx);
            let tady: i32 = iabs(tdy);
            let tslop: i32 = dp2q(8) >> 16;
            if (tadx <= tslop && tady <= tslop) { return 0; }
            g_aui_time_press_tgt = -1;
            g_aui_time_drag = 1;
            aui_invalidate();
        }
        if (g_aui_slider_key != 0) {
            let ch: i32 = slider_apply(px);
            if (ch != 0) { aui_invalidate(); }
            return 0;
        }
        // v2.12：分栏分隔条拖动（与滑块同模式，紧跟滑块分支）。
        if (g_aui_split_drag_key != 0) {
            let ch: i32 = split_apply(px, py);
            if (ch != 0) { aui_invalidate(); }
            return 0;
        }
        if (g_aui_pager_drag_key != 0) {
            let dx: i32 = px - g_aui_pager_drag_x0;
            let dy: i32 = py - g_aui_pager_drag_y0;
            let adx: i32 = iabs(dx);
            let ady: i32 = iabs(dy);
            let slop: i32 = dp2q(8) >> 16;
            if (g_aui_pager_lock == 0 && (adx > slop || ady > slop)) {
                if (adx > ady) {
                    g_aui_pager_lock = 1;
                    g_aui_pager_dragging = 1;
                    g_aui_pressing = 0;      // 开始横向拖动：取消按压，也不再算点击
                    g_aui_drag_key = 0;      // 不让纵向滚动抢同一手势
                    g_aui_dragging = 0;
                } else {
                    g_aui_pager_lock = 2;
                    g_aui_pressing = 0;  // 纵向拖动超过 8 dp：不再算点击
                }
            }
            if (g_aui_pager_lock == 1) {
                let ds: i32 = pager_sample(px, now);
                let nv: i32 = g_aui_pager_drag_off0 - dx * 65536;
                let old: i32 = pager_get(g_aui_pager_drag_key);
                let got: i32 = pager_set(g_aui_pager_drag_key, nv);
                if (got != old) {
                    aui_invalidate_layout();
                }
                return 0;
            }
            if (g_aui_pager_lock == 0) { return 0; }
            // lock == 2：纵向意图，继续走下面的滚动分支。
        }
        // v1.30：下拉刷新。内容在顶部时，继续下拖的位移不写进滚动
        // 偏移，而是按 0.45 阻尼变成内容下移（最多 96 dp）；向上拖回
        // 到顶部后恢复普通滚动。整个手势由这里接管，避免父容器抢。
        if (g_aui_ref_drag_key != 0) {
            let rk: i32 = g_aui_ref_drag_key;
            let rdy: i32 = py - g_aui_ref_y0;
            let rady: i32 = rdy;
            if (rady < 0) { rady = 0 - rady; }
            let rslop: i32 = dp2q(8) >> 16;
            if (rady > rslop && g_aui_ref_moved == 0) {
                g_aui_ref_moved = 1;
                g_aui_pressing = 0;
                g_aui_press_key = 0;
            }
            if (g_aui_ref_moved == 0) { return 0; }
            let rds: i32 = drag_sample(py, now);
            let rdes: i32 = g_aui_ref_off0 - rdy * 65536;
            let rmax: i32 = scroll_max(rk);
            if (rdes >= 0) {
                if (rdes > rmax) { rdes = rmax; }
                let rold: i32 = scroll_get(rk);
                let rgot: i32 = scroll_set(rk, rdes);
                if (ref_disp(rk) > 0) { let rz: i32 = ref_set_disp(rk, 0); }
                if (rgot != rold) {
                    let rv: i32 = trace_hex(118, rgot);
                    aui_invalidate_layout();
                } else if (ref_disp(rk) == 0) {
                    aui_invalidate_layout();
                }
            } else {
                let rz0: i32 = scroll_set(rk, 0);
                let rs: i32 = ref_find(rk);
                if (rs >= 0 && g_aui_ref_on[rs] == 0 && g_aui_ref_ack[rs] == 0) {
                    // Q16.16 位移先除 100 再乘 45：长距离下拉（dy 超过约
                    // 728 px）时 (0-rdes)*45 会溢出 i32，算出的 rd 变负，
                    // 指示圈会突然消失、松手还会被当成 fling。
                    let rm: i32 = 0 - rdes;
                    let rd: i32 = rm / 100 * 45;
                    let rmx: i32 = dp2q(96);
                    if (rd > rmx) { rd = rmx; }
                    if (rd != g_aui_ref_disp[rs]) {
                        g_aui_ref_anim[rs] = 0;
                        g_aui_ref_disp[rs] = rd;
                        let rt: i32 = trace_hex(82, rd);   // R = 下拉位移
                        aui_invalidate_layout();
                    }
                }
            }
            return 0;
        }
        if (g_aui_drag_key != 0) {
            let ax: i32 = g_aui_drag_axis;
            // v2.17：表格双向滚动——第一个超 8 dp 的方向定轴，定轴前
            // 不滚动；定横向时把纵向基准换成 DOWN 时快照的横向偏移。
            if (ax == 2) {
                let ddx: i32 = px - g_aui_drag_x0;
                let ddy: i32 = py - g_aui_drag_y0;
                let axx: i32 = ddx;
                if (axx < 0) { axx = 0 - axx; }
                let ayy: i32 = ddy;
                if (ayy < 0) { ayy = 0 - ayy; }
                let sl2: i32 = dp2q(8) >> 16;
                if (axx > sl2 || ayy > sl2) {
                    if (axx > ayy) {
                        ax = 1;
                        g_aui_drag_axis = 1;
                        g_aui_drag_off0 = g_aui_drag_offx0;
                    } else {
                        ax = 0;
                        g_aui_drag_axis = 0;
                    }
                }
            }
            let dy: i32 = py - g_aui_drag_y0;
            let dmain: i32 = dy;
            if (ax != 0) { dmain = px - g_aui_drag_x0; }
            let ady: i32 = dmain;
            if (ady < 0) { ady = 0 - ady; }
            let slop: i32 = dp2q(8) >> 16;
            if (ady > slop) {
                if (g_aui_dragging == 0) {
                    g_aui_dragging = 1;
                    g_aui_pressing = 0;      // 开始滚动就取消按压态，也不再算点击
                    g_aui_force_full = 1;    // v1.48.6：按压态底色要清掉，整屏重画一次
                }
            }
            if (g_aui_dragging != 0) {
                let ds: i32 = 0;
                if (ax != 0) { ds = drag_sample_x(px, now); } else { ds = drag_sample(py, now); }
                let nv: i32 = g_aui_drag_off0 - dmain * 65536;
                // 虚拟列表/网格/横向列表偏移按像素存：拖动位移不乘 65536。
                if (virtual_key(g_aui_drag_key) != 0) { nv = g_aui_drag_off0 - dmain; }
                let old: i32 = 0;
                let got: i32 = 0;
                if (vtable_idx(g_aui_drag_key) >= 0 && ax == 1) {
                    // v2.17：表格横向走独立 off_x，不写纵向偏移。
                    old = vtable_off_x(g_aui_drag_key);
                    got = vtable_set_x(g_aui_drag_key, nv);
                } else {
                    old = scroll_get(g_aui_drag_key);
                    got = scroll_set(g_aui_drag_key, nv);
                }
                if (got != old) {
                    let tv: i32 = trace_hex(118, got);   // v = 当前滚动偏移（Q16.16）
                    let vs: i32 = aui_invalidate_scroll();  // v1.48.4：轻布局 + 交给泵
                }
            }
        }
        // v2.7：没有滚动/分页接管时，手指移出 8 dp 也取消点按（Android
        // touch slop：移出容差的手势不再是点按；HuxerUI 里移动超容差
        // 同样拒绝 tap 识别）。只清按压态并记 dragging，UP 的通用派发
        // 要求 was_drag == 0，自然跳过；波纹由 ripple_step 在下一帧清掉。
        if (g_aui_pressing != 0 && g_aui_dragging == 0 && g_aui_drag_key == 0) {
            let pdx: i32 = px - g_aui_press_downx;
            let pdy: i32 = py - g_aui_press_downy;
            let pslop: i32 = dp2q(8) >> 16;
            if (iabs(pdx) > pslop || iabs(pdy) > pslop) {
                g_aui_pressing = 0;
                g_aui_press_key = 0;
                g_aui_dragging = 1;
                aui_invalidate();
            }
        }
        return 0;
    }
    if (a == 1) {
        g_aui_ripple_up_seen = 1;                // v1.48.3：正常松手 -> 淡出
        // v2.8：DEBUG overlay 结算。缎带上 DOWN+UP（8 dp 内）切换面板；
        // 面板上起手的抬起直接吞掉，不触发底层点按。
        if (g_dbg_down != 0) {
            let du: i32 = g_dbg_moved;
            g_dbg_down = 0;
            g_dbg_moved = 0;
            if (du == 0) {
                if (g_dbg_expanded != 0) { g_dbg_expanded = 0; }
                else { g_dbg_expanded = 1; }
            }
            let iv: i32 = aui_invalidate();
            return 0;
        }
        if (g_dbg_panel_down != 0) {
            g_dbg_panel_down = 0;
            let iv2: i32 = aui_invalidate();
            return 0;
        }
        // v1.38：底部弹出层拖拽结算。超过 1/4 高度（至少 96 dp）视为下拉
        // 关闭，回调 reason=3 由应用置 open=0；不足则吸附回原位。
        if (g_aui_sheet_drag >= 0) {
            let scn: ptr<AuiNode> = node_at(g_aui_sheet_card);
            let thr: i32 = scn.h / 4;
            let minthr: i32 = dp2q(96);
            if (thr < minthr) { thr = minthr; }
            let sdr: i32 = g_aui_sheet_drag;
            g_aui_sheet_drag = -1;
            if (sdr > thr) {
                let sdn: ptr<AuiNode> = node_at(g_aui_sheet);
                g_aui_sheet_reason = 3;
                if (sdn.cb != 0) {
                    let sdc: i32 = sdn.cb(sdn.user);
                }
            }
            aui_invalidate();
            return 0;
        }
        // v1.35：菜单结算（点条目/外部/面内），整次手势都不下传。
        if (g_aui_menu >= 0 || g_aui_menu_down != -3) {
            let mu: i32 = menu_pointer_up(px, py);
            return 0;
        }
        // v1.34：SnackBar 结算。动作按钮只在 DOWN/UP 命中同一按钮时触发；
        // 先收起提示再调回调（HuxerUI Activate 的顺序），旧 id 的迟到路径
        // 不会影响回调里新开的提示。
        if (g_aui_snack_down != 0) {
            let was: i32 = g_aui_snack_down;
            let now_hit: i32 = present_snack_hit(px, py);
            g_aui_snack_down = 0;
            g_aui_snack_press = 0;
            g_aui_snack_paused = 0;
            g_aui_snack_last = anim_now();
            if (was == 2 && now_hit == 2) {
                let cb: fn(ptr) : i32 = g_aui_snack_cb;
                let user: ptr = g_aui_snack_user;
                g_aui_snack_on = 0;
                g_aui_snack_text = 0;
                g_aui_snack_action = 0;
                g_aui_snack_cb = 0;
                g_aui_snack_user = 0;
                g_aui_need_paint = 1;
                if (cb != 0) { let cr: i32 = cb(user); }
            }
            aui_invalidate();
            return 0;
        }
        // v1.39：浮层结算。DOWN 在浮层外 -> 关闭 reason=1；内边距 -> 吞掉；
        // 内容里的点击继续走下面的通用派发。没有 DOWN（重建后补发的 UP）
        // 时按 UP 位置判断内外。
        if (g_aui_popup >= 0) {
            let pd: i32 = g_aui_popup_down;
            g_aui_popup_down = -3;
            if (pd == -3) {
                let uh: i32 = popup_hit(px, py);
                if (uh == -1) { pd = -1; }
                else if (uh == -2) { pd = -2; }
            }
            if (pd == -1) {
                let pc: i32 = popup_close(1);
                aui_invalidate();
                return 0;
            }
            if (pd == -2) {
                aui_invalidate();
                return 0;
            }
        }
        // v1.27：长按已显示 -> 本次抬起被提示认领：不触发点击，气泡转入
        // 1.5 s 停留（再 0.1 s 退出）。未到 500 ms 的待定直接作废，
        // 短按照常派发。
        if (g_aui_tip_on != 0 && g_aui_tip_hold != 0) {
            g_aui_tip_hold = 0;
            g_aui_tip_until = now + 1600000000;
            g_aui_pressing = 0;
            g_aui_press_key = 0;
            g_aui_dragging = 0;
            g_aui_drag_key = 0;
            pager_drag_clear();
            date_press_clear();
            time_press_clear();
            if (g_aui_slider_key != 0) {
                let se0: i32 = slider_end();
            }
            // v2.7：同一节点若同时挂了长按，抬起已被提示认领，长按的
            // 已触发状态一并清掉（回调已在 500 ms 时调过）。
            let lc0: i32 = lp_cancel_why(3);
            g_aui_pump_need = 1;
            let tw1: i32 = pump_wake();
            aui_invalidate();
            return 0;
        }
        if (g_aui_tip_pend != 0) {
            g_aui_tip_pend = 0;
            g_aui_tip_pend_idx = -1;
        }
        // v2.7：长按已触发 -> 本次抬起被长按认领：不触发点击。
        // （触发时已清按压态，通用派发本来也不会走；这里提前返回，
        // 顺带把拖动/分页/日期/时间/滑条的按压态一并清掉，与提示
        // 认领分支对称。）
        if (g_aui_lp_fired != 0) {
            // v2.7.1-diag：抬起时已触发，点按被认领。
            let fu: i32 = aui_log1(4, "lp up fired key=", g_aui_lp_key, "");
            g_aui_lp_fired = 0;
            g_aui_lp_key = 0;
            g_aui_pressing = 0;
            g_aui_press_key = 0;
            g_aui_dragging = 0;
            g_aui_drag_key = 0;
            pager_drag_clear();
            date_press_clear();
            time_press_clear();
            if (g_aui_slider_key != 0) {
                let se1: i32 = slider_end();
            }
            g_aui_pump_need = 1;
            let tw2: i32 = pump_wake();
            aui_invalidate();
            return 0;
        }
        // v2.7：未到 500 ms 的长期待定直接作废，短按照常派发。
        if (g_aui_lp_pend != 0) {
            g_aui_lp_pend = 0;
            g_aui_lp_pend_idx = -1;
            g_aui_lp_pend_key = 0;
            // v2.7.1-diag：提前抬起取消（why=6）。
            let uel: i32 = i32((clock_ns() - g_aui_lp_start) / 1000000);
            let ul: i32 = aui_log3(4, "lp cancel why=", 6, " el=", uel, "ms ticks=", g_aui_lp_diag_ticks, "");
        }
        // D-2a：可选中待定同样在提前抬起时作废（已建立的选区不受影响）。
        if (g_d2a_sel_pend != 0) {
            let sc3: i32 = d2a_sel_cancel_pend();
        }
        // v1.30：下拉刷新结算。超过 68 dp 触发回调一次；不足则吸附回 0。
        // 回调后即使应用立刻清除 refreshing，也保留 700 ms 旋转反馈。
        if (g_aui_ref_drag_key != 0) {
            let rk: i32 = g_aui_ref_drag_key;
            let rmoved: i32 = g_aui_ref_moved;
            let rvel: i32 = g_aui_vel;
            let rt: i64 = g_aui_last_t;
            ref_clear_drag();
            let rs: i32 = ref_find(rk);
            let rd: i32 = 0;
            if (rs >= 0) { rd = g_aui_ref_disp[rs]; }
            // 只有本次手势真的产生过下拉位移才结算；指示器已在刷新位时
            // 的普通点按要照常落到按钮上（HuxerUI 内容仍可交互）。
            if (rd > 0 && rmoved != 0) {
                let trig: i32 = dp2q(68);
                if (rs >= 0 && g_aui_ref_on[rs] != 0) {
                    // 应用正在刷新，保持指示器，不因松手收起。
                } else if (rd >= trig && g_aui_ref_ack[rs] == 0) {
                    g_aui_ref_ack[rs] = now + AUI_REF_ACK_NS;
                    ref_anim_to(rs, dp2q(52), 150000000);
                    let rni: i32 = ref_node(rk);
                    if (rni >= 0) {
                        let rn: ptr<AuiNode> = node_at(rni);
                        let rcb: fn(ptr) : i32 = rn.cb;
                        let ruser: ptr = rn.user;
                        let rf: i32 = trace_hex(70, rk);   // F = 触发刷新
                        if (rcb != 0) { let rr: i32 = rcb(ruser); }
                    }
                    let ra: i32 = frame_timer_arm();
                } else {
                    ref_anim_to(rs, 0, 200000000);
                }
                aui_invalidate();
                return 0;
            }
            if (rmoved != 0) {
                if (now > 0 && rt > 0) {
                    let rage: i64 = now - rt;
                    if (rage >= 0 && rage < 80000000 && iabs(rvel) > 200000) {
                        let rfs: i32 = fling_start(rk, rvel, now);
                    }
                }
                aui_invalidate();
                return 0;
            }
        }
        // v1.29：时间按压结算。表盘：最后一次取值 + 选时态松手自动进选分；
        // 头部：DOWN/UP 同目标才切换字段/AM/PM。拖动只保留父滚动惯性。
        if (g_aui_time_press_key != 0) {
            let tkey: i32 = g_aui_time_press_key;
            let ttgt: i32 = g_aui_time_press_tgt;
            let tdrag: i32 = g_aui_time_drag;
            let tcap: i32 = g_aui_time_dial;
            let tscrolled: i32 = g_aui_dragging;
            let tskey: i32 = g_aui_drag_key;
            let tsvel: i32 = g_aui_vel;
            let tst: i64 = g_aui_last_t;
            time_press_clear();
            g_aui_pressing = 0;
            g_aui_press_key = 0;
            if (tscrolled != 0 && tskey != 0 && now > 0 && tst > 0) {
                let tage: i64 = now - tst;
                if (tage >= 0 && tage < 80000000 && iabs(tsvel) > 200000) {
                    let tfs: i32 = fling_start(tskey, tsvel, now);
                }
            }
            g_aui_dragging = 0;
            g_aui_drag_key = 0;
            let tni: i32 = time_node(tkey);
            if (tni >= 0) {
                let tnn: ptr<AuiNode> = node_at(tni);
                if (tcap != 0 && tdrag == 0) {
                    let tch2: i32 = time_dial_apply(tnn, px, py);
                    let tslot: i32 = tnn.aux;
                    if (tslot >= 0 && g_aui_time_mode[tslot] == 0) {
                        g_aui_time_mode[tslot] = 1;
                    }
                } else if (tdrag == 0 && ttgt >= 0) {
                    let tcur: i32 = time_hit(tnn, px, py);
                    if (tcur == ttgt) {
                        let ta: i32 = time_activate(tnn, ttgt);
                    }
                }
            }
            aui_invalidate();
            return 0;
        }
        // v1.28：日期按压在抬起时结算。只有 DOWN/UP 落在同一个子目标、
        // 且位移未超过 8 dp 才激活；拖动则只保留父滚动/惯性。
        if (g_aui_date_press_key != 0) {
            let dkey: i32 = g_aui_date_press_key;
            let dtgt: i32 = g_aui_date_press_tgt;
            let ddrag: i32 = g_aui_date_drag;
            let dscrolled: i32 = g_aui_dragging;
            let dskey: i32 = g_aui_drag_key;
            let dsvel: i32 = g_aui_vel;
            let dst: i64 = g_aui_last_t;
            date_press_clear();
            g_aui_pressing = 0;
            g_aui_press_key = 0;
            if (dscrolled != 0 && dskey != 0 && now > 0 && dst > 0) {
                let dage: i64 = now - dst;
                if (dage >= 0 && dage < 80000000 && iabs(dsvel) > 200000) {
                    let dfs: i32 = fling_start(dskey, dsvel, now);
                }
            }
            g_aui_dragging = 0;
            g_aui_drag_key = 0;
            if (ddrag == 0 && dtgt >= 0) {
                let dni: i32 = date_node(dkey);
                if (dni >= 0) {
                    let dnn: ptr<AuiNode> = node_at(dni);
                    let cur: i32 = date_hit(dnn, px, py);
                    if (cur == dtgt) {
                        let da: i32 = date_activate(dnn, dtgt);
                    }
                }
            }
            aui_invalidate();
            return 0;
        }
        if (g_aui_slider_key != 0) {
            let ch: i32 = slider_apply(px);
            slider_end();
            aui_invalidate();
            return 0;
        }
        // v2.12：分栏分隔条拖动结束（与滑块同模式，紧跟滑块分支）。
        if (g_aui_split_drag_key != 0) {
            let ch: i32 = split_apply(px, py);
            split_end();
            aui_invalidate();
            return 0;
        }
        let was_drag: i32 = g_aui_dragging;
        let drag_key: i32 = g_aui_drag_key;
        let drag_vel: i32 = g_aui_vel;
        let drag_t: i64 = g_aui_last_t;
        g_aui_dragging = 0;
        g_aui_drag_key = 0;
        // v1.24：横向拖动由分页接管。提案回调只在这里触发一次；无论
        // 应用是否接受提案，先把偏移动画吸到提案页。
        if (g_aui_pager_dragging != 0) {
            let pg: i32 = pager_release();
            g_aui_pressing = 0;
            g_aui_press_key = 0;
            aui_invalidate();
            return 0;
        }
        // 轻点/纵向手势结束：若按下时打断了吸附动画，回到当前页。
        if (g_aui_pager_drag_key != 0) {
            let pe: i32 = pager_gesture_end();
        }
        let hit: i32 = hit_test(g_aui_root, px, py);
        // v1.44：组合框展开时，先结算触发器/建议/外部点击；键盘键跳过，
        // 交给下面的通用派发继续输入。
        if (g_aui_combo_open >= 0 && find_kind(hit, 11) < 0) {
            let cn: ptr<AuiNode> = node_at(g_aui_combo_open);
            let ccb: fn(ptr) : i32 = cn.cb;
            let cuser: ptr = cn.user;
            g_aui_pressing = 0;
            g_aui_press_key = 0;
            g_aui_combo_press = -1;
            let dh: i32 = g_aui_combo_down;
            g_aui_combo_down = -3;
            let cdx: i32 = px - g_aui_combo_dx;
            let cdy: i32 = py - g_aui_combo_dy;
            let cadx: i32 = iabs(cdx);
            let cady: i32 = iabs(cdy);
            let cslop: i32 = dp2q(8) >> 16;
            let cdragged: i32 = g_aui_combo_drag;
            g_aui_combo_drag = 0;
            if (cadx > cslop || cady > cslop) { cdragged = 1; }
            if (cdragged != 0) {
                aui_invalidate();
                return 0;
            }
            let dec: i32 = dh;
            if (dec == -3) { dec = hit; }
            if (dec == -2) {
                aui_invalidate();
                return 0;
            }
            if (dec < 0) {
                g_aui_combo_reason = 2;
                if (ccb != 0) { let r: i32 = ccb(cuser); }
                aui_invalidate();
                return 0;
            }
            if (dec == g_aui_combo_open) {
                g_aui_combo_reason = 2;
                if (ccb != 0) { let r2: i32 = ccb(cuser); }
                aui_invalidate();
                return 0;
            }
            let hn: ptr<AuiNode> = node_at(dec);
            if (hn.kind == 50) {
                g_aui_combo_key = cn.key;
                g_aui_combo_val = hn.aux2;
                g_aui_combo_pick = hn.key;
                g_aui_combo_reason = 1;
                if (ccb != 0) { let r3: i32 = ccb(cuser); }
                aui_invalidate();
                return 0;
            }
            return 0;
        }
        // v1.26：下拉的点击在通用派发之前处理，保证外部点击不会穿透。
        if (g_aui_select_open >= 0) {
            let sn: ptr<AuiNode> = node_at(g_aui_select_open);
            let scb: fn(ptr) : i32 = sn.cb;
            let suser: ptr = sn.user;
            g_aui_pressing = 0;
            g_aui_press_key = 0;
            g_aui_select_press = -1;
            // v1.26.2：以 DOWN 的目标为准；位移超过 8 dp 视为拖动，整次手势
            // 作废（不选中、不关闭）。没有 DOWN（窗口重建后补发的 UP）时才
            // 退回按 UP 位置判断。
            let dh: i32 = g_aui_select_down;
            g_aui_select_down = -3;
            let sdx: i32 = px - g_aui_select_dx;
            let sdy: i32 = py - g_aui_select_dy;
            let sadx: i32 = iabs(sdx);
            let sady: i32 = iabs(sdy);
            let sslop: i32 = dp2q(8) >> 16;
            let dragged: i32 = g_aui_select_drag;
            g_aui_select_drag = 0;
            if (sadx > sslop || sady > sslop) { dragged = 1; }
            if (dragged != 0) {
                aui_invalidate();
                return 0;
            }
            let dec: i32 = dh;
            if (dec == -3) { dec = hit; }
            if (dec == -2) {
                aui_invalidate();
                return 0;
            }
            if (dec < 0) {
                g_aui_select_reason = 2;
                if (scb != 0) { let r: i32 = scb(suser); }
                aui_invalidate();
                return 0;
            }
            if (dec == g_aui_select_open) {
                g_aui_select_reason = 2;
                if (scb != 0) { let r2: i32 = scb(suser); }
                aui_invalidate();
                return 0;
            }
            let hn: ptr<AuiNode> = node_at(dec);
            if (hn.kind == 26) {
                g_aui_select_key = sn.key;
                g_aui_select_val = hn.aux2;
                g_aui_select_reason = 1;
                if (scb != 0) { let r3: i32 = scb(suser); }
                aui_invalidate();
                return 0;
            }
            return 0;
        }
        let cbnode: i32 = find_clickable(hit);
        let key: i32 = 0;
        let has: i32 = 0;
        if (cbnode >= 0) {
            let n: ptr<AuiNode> = node_at(cbnode);
            key = n.key;
            has = 1;
        }
        let was: i32 = g_aui_press_key;
        let down: i32 = g_aui_pressing;
        g_aui_pressing = 0;
        let fk: i32 = find_kind(hit, 10);
        let kk: i32 = find_kind(hit, 11);
        if (fk >= 0 || kk >= 0) {
            let sn: i32 = fk;
            if (sn < 0) { sn = kk; }
            let snn: ptr<AuiNode> = node_at(sn);
            if (down != 0 && was_drag == 0 && snn.key == was) {
                if (fk >= 0) {
                    let fr: i32 = aui_focus(snn.key);
                } else {
                    let kr: i32 = kb_activate(snn.aux);
                }
            }
            aui_invalidate();
            return 0;
        }
        if (has != 0 && down != 0 && key == was && was_drag == 0) {
            let n2: ptr<AuiNode> = node_at(cbnode);
            // v1.22：标签页容器本身不接收点击（页右侧的空白区域不算选中）。
            // v1.24：分页容器同理，空白处只用于起手拖动。
            if (n2.kind != 19 && n2.kind != 21 && n2.kind != 22) {
                // v1.21：点在分段控件上，把父 key 与段下标放进全局，回调里用
                // aui_segmented_value(parent_key) 读取。
                if (n2.kind == 18 && n2.parent >= 0) {
                    let pn2: ptr<AuiNode> = node_at(n2.parent);
                    g_aui_seg_key = pn2.key;
                    g_aui_seg_val = n2.aux2;
                }
                // v1.22：标签页同理，aui_tabs_value(容器 key) 回读点中的页。
                if (n2.kind == 20 && n2.parent >= 0) {
                    let pn2: ptr<AuiNode> = node_at(n2.parent);
                    g_aui_tab_key = pn2.key;
                    g_aui_tab_val = n2.aux2;
                }
                // v1.25：点遮罩（对话框自身）关闭；卡片空白由 noop 吞掉。
                if (n2.kind == 23) { g_aui_dialog_reason = 1; }
                // v1.38：点底部弹出层遮罩关闭，reason=1。
                if (n2.kind == 41) { g_aui_sheet_reason = 1; }
                // v1.26：关闭状态点下拉触发器 = 请求展开。
                if (n2.kind == 25) {
                    g_aui_select_key = n2.key;
                    g_aui_select_val = n2.aux;
                    g_aui_select_reason = 0;
                }
                // v1.44：关闭状态点组合框 = 聚焦并请求展开。
                if (n2.kind == 49) {
                    let cf: i32 = aui_focus(n2.key);
                    g_aui_combo_key = n2.key;
                    g_aui_combo_val = -1;
                    g_aui_combo_reason = 0;
                }
                // v1.45：虚拟列表行。先写 (容器 key, 行下标)，回调里用
                // aui_vlist_tap_index() 读取；行 key 为 0，按压态不参与。
                // v2.10：不定高列表行（kind 59）语义相同，共用同一对全局。
                if ((n2.kind == 52 || n2.kind == 59) && n2.parent >= 0) {
                    let pn5: ptr<AuiNode> = node_at(n2.parent);
                    g_aui_vlist_tap_key = pn5.key;
                    g_aui_vlist_tap_idx = n2.aux2;
                }
                // v1.46：虚拟网格格子，语义与虚拟列表行相同。
                if (n2.kind == 54 && n2.parent >= 0) {
                    let pn6: ptr<AuiNode> = node_at(n2.parent);
                    g_aui_vgrid_tap_key = pn6.key;
                    g_aui_vgrid_tap_idx = n2.aux2;
                }
                // v2.17：虚拟表格格子：(容器 key, 行, 列)，表头行 = -1。
                if (n2.kind == 64 && n2.parent >= 0) {
                    let pn8: ptr<AuiNode> = node_at(n2.parent);
                    g_aui_vtable_tap_key = pn8.key;
                    g_aui_vtable_tap_row = n2.aux;
                    g_aui_vtable_tap_col = n2.aux2;
                }
                // v1.47：横向虚拟列表项，同上。
                if (n2.kind == 56 && n2.parent >= 0) {
                    let pn7: ptr<AuiNode> = node_at(n2.parent);
                    g_aui_hlist_tap_key = pn7.key;
                    g_aui_hlist_tap_idx = n2.aux2;
                }
                // v1.41：导航项。点已选中项或禁用项不回调；其余把
                // (容器 key, 项下标) 放进全局，回调里用 aui_nav_value 读取。
                let allow_cb: i32 = 1;
                if (n2.kind == 46 && n2.parent >= 0) {
                    let pn3: ptr<AuiNode> = node_at(n2.parent);
                    if ((n2.flags & AUI_NAV_ITEM_DISABLED) != 0 ||
                        pn3.aux == n2.aux2) {
                        allow_cb = 0;
                    } else {
                        g_aui_nav_key = pn3.key;
                        g_aui_nav_val = n2.aux2;
                    }
                }
                // v1.42：侧边导航项，语义与底部导航项相同，共用请求槽。
                if (n2.kind == 48 && n2.parent >= 0) {
                    let pn4: ptr<AuiNode> = node_at(n2.parent);
                    if ((n2.flags & AUI_NAV_ITEM_DISABLED) != 0 ||
                        pn4.aux == n2.aux2) {
                        allow_cb = 0;
                    } else {
                        g_aui_nav_key = pn4.key;
                        g_aui_nav_val = n2.aux2;
                    }
                }
                let cb: fn(ptr) : i32 = n2.cb;
                let user: ptr = n2.user;
                if (allow_cb != 0) {
                    let r: i32 = cb(user);
                }
            }
        }
        // 松手时速度足够、且最后一次采样足够新，才启动惯性。
        if (was_drag != 0 && drag_key != 0 && now > 0 && drag_t > 0) {
            let age: i64 = now - drag_t;
            if (age >= 0 && age < 80000000 && iabs(drag_vel) > 200000) {
                // v2.17：表格横向拖动的惯性走 off_x（纵向仍走 scroll）。
                let fs: i32 = fling_start_axis(drag_key, drag_vel, now, g_aui_drag_axis);
            }
        }
        aui_invalidate();
        return 0;
    }
    if (a == 3) {
        let th2: i32 = tip_dismiss();
        // v2.7：系统取消手势时，长按待定/已触发一并作废。
        let lc2: i32 = lp_cancel_why(4);
        let fz: i32 = fling_stop();
        // v2.8：取消 overlay 手势（缎带/面板都不切换）。
        g_dbg_down = 0;
        g_dbg_moved = 0;
        g_dbg_panel_down = 0;
        // v1.35：取消菜单手势：不激活条目，保留当前滚动位置。
        g_aui_menu_down = -3;
        g_aui_menu_drag = 0;
        g_aui_menu_press = -1;
        // v1.38：取消底部弹出层拖拽，吸附回原位。
        g_aui_sheet_drag = -1;
        // v1.39：取消浮层手势：不关闭，也不触发内容点击。
        g_aui_popup_down = -3;
        // v1.34：取消 SnackBar 手势：不触发动作，恢复倒计时。
        if (g_aui_snack_down != 0) {
            g_aui_snack_down = 0;
            g_aui_snack_press = 0;
            g_aui_snack_paused = 0;
            g_aui_snack_last = anim_now();
        }
        date_press_clear();
        time_press_clear();
        if (g_aui_slider_key != 0) {
            let se: i32 = slider_end();
        }
        if (g_aui_split_drag_key != 0) {
            let spe: i32 = split_end();
        }
        if (g_aui_pager_drag_key != 0) {
            let pe: i32 = pager_gesture_end();
        }
        g_aui_pressing = 0;
        g_aui_dragging = 0;
        g_aui_drag_key = 0;
        if (g_aui_ref_drag_key != 0) {
            let rk2: i32 = g_aui_ref_drag_key;
            let rs2: i32 = ref_find(rk2);
            ref_clear_drag();
            if (rs2 >= 0) {
                if (g_aui_ref_on[rs2] != 0) {
                    ref_anim_to(rs2, dp2q(52), 150000000);
                } else {
                    ref_anim_to(rs2, 0, 200000000);
                }
            }
        }
        g_aui_select_press = -1;
        aui_invalidate();
        return 0;
    }
    return 0;
}

fn aui_on_input(ident: i32, events: i32, data: ptr) : i32 {
    aui_lock();
    g_aui_ripple_up_seen = 0;
    let got: i32 = AInputQueue_getEvent(g_aui_queue, g_aui_ev);
    while (got >= 0) {
        let ev: ptr = load_ptr(g_aui_ev);
        // 帧源自检用：每条事件都推进序号，定时器回调之间若序号变了，
        // 说明那一帧不是定时器把空闲 looper 唤醒的。
        g_aui_input_seq = g_aui_input_seq + 1;
        let pre: i32 = AInputQueue_preDispatchEvent(g_aui_queue, ev);
        if (pre == 0) {
            // AINPUT_EVENT_TYPE_KEY=1, AINPUT_EVENT_TYPE_MOTION=2。
            // 触摸事件是 MOTION；v1.3 曾误写成 1，导致所有点按都被丢弃。
            let typ: i32 = AInputEvent_getType(ev);
            let handled: i32 = 1;
            if (typ == 2) {
                let r0: i32 = handle_motion(ev);
            } else if (typ == 1) {
                handled = handle_key(ev);
            }
            let fin: i32 = AInputQueue_finishEvent(g_aui_queue, ev, handled);
        }
        got = AInputQueue_getEvent(g_aui_queue, g_aui_ev);
    }
    // v1.48.1：同一批事件处理完再统一看按压是否结束，覆盖所有松手/取消
    // 分支（拖动、滑动取消、控件抢手势等），只在这里叫醒一次帧泵。
    let rl: i32 = ripple_release_now();
    aui_unlock();
    return 1;
}

// ===========================================================================
// 10. Android 宿主
// ===========================================================================

// ---- 启动轨迹：/sdcard/Android/data/<pkg>/files/trace.txt ----
// 每个里程碑一行：单字母（可选加 8 位十六进制）。无 adb 时用它定位崩溃阶段。
fn trace_strlen(p: ptr) : i32 {
    let i: i32 = 0;
    if (p == 0) { return 0; }
    let b: i32 = load_u8(p + i);
    while (b != 0 && i < 240) {
        i = i + 1;
        b = load_u8(p + i);
    }
    return i;
}

fn trace_mark(tag: i32) : i32 {
    if (g_aui_trace_fd < 0) { return -1; }
    store_u8(g_aui_trace_buf + 0, tag);
    store_u8(g_aui_trace_buf + 1, 10);
    let bp: ptr = g_aui_trace_buf;
    let n: i32 = write(g_aui_trace_fd, bp, 2);
    return n;
}

fn trace_hex(tag: i32, v: i32) : i32 {
    if (g_aui_trace_fd < 0) { return -1; }
    store_u8(g_aui_trace_buf + 0, tag);
    let i: i32 = 0;
    while (i < 8) {
        let sh: i32 = (7 - i) * 4;
        let nib: i32 = (v >> sh) & 15;
        let c: i32 = 48;
        if (nib > 9) { c = 55; }
        store_u8(g_aui_trace_buf + 1 + i, c + nib);
        i = i + 1;
    }
    store_u8(g_aui_trace_buf + 9, 10);
    let bp: ptr = g_aui_trace_buf;
    let n: i32 = write(g_aui_trace_fd, bp, 10);
    return n;
}

fn trace_init(ext: ptr) : i32 {
    if (ext == 0) { return -1; }
    let n: i32 = trace_strlen(ext);
    if (n <= 0 || n > 240) { return -1; }
    let i: i32 = 0;
    while (i < n) {
        store_u8(g_aui_trace_path + i, load_u8(ext + i));
        i = i + 1;
    }
    // 追加 "/trace.txt"
    store_u8(g_aui_trace_path + n + 0, 47);
    store_u8(g_aui_trace_path + n + 1, 116);
    store_u8(g_aui_trace_path + n + 2, 114);
    store_u8(g_aui_trace_path + n + 3, 97);
    store_u8(g_aui_trace_path + n + 4, 99);
    store_u8(g_aui_trace_path + n + 5, 101);
    store_u8(g_aui_trace_path + n + 6, 46);
    store_u8(g_aui_trace_path + n + 7, 116);
    store_u8(g_aui_trace_path + n + 8, 120);
    store_u8(g_aui_trace_path + n + 9, 116);
    store_u8(g_aui_trace_path + n + 10, 0);
    let pp: ptr = g_aui_trace_path;
    // O_WRONLY|O_CREAT|O_TRUNC = 577，0666 = 438
    let fd: i32 = openat(-100, pp, 577, 438);
    if (fd < 0) { return fd; }
    g_aui_trace_fd = fd;
    trace_mark(83);   // S = attach 开始
    // v1.11.2：第二行就写版本，避免“旧包在跑、却以为在测新包”。
    let tv: i32 = trace_hex(86, 14806);   // V + 版本号 0x000039D6
    return 0;
}

// ---- 文件日志（W3 合并，见 g_aui_log_* 注释）----
// 与 trace.txt 分工：trace 记里程碑字母（启动阶段定位），这里记
// 带 i64 时间戳的完整行为行。调用方用 aui_log / aui_log1 /
// aui_log2；aui_log_tail 供应用内日志查看器回读文件尾部。

// 十进制 i64 写进 buf（不依赖 i64 取模：用 /10 + 减法，与
// i32_to_str 同一写法）。返回写出的字节数（不含 NUL）。
fn aui_log_fmt_i64(buf: ptr, v: i64) : i32 {
    let neg: i32 = 0;
    let n: i64 = v;
    if (n < 0) { neg = 1; n = 0 - n; }
    let tmp: u8[24] = 0;
    let i: i32 = 0;
    if (n == 0) {
        let w0: i32 = store_u8(tmp + 0, 48);
        i = 1;
    } else {
        while (n > 0) {
            let q: i64 = n / 10;
            let d: i64 = n - q * 10;
            let w1: i32 = store_u8(tmp + i, 48 + i32(d));
            i = i + 1;
            n = q;
        }
    }
    let at: i32 = 0;
    if (neg != 0) {
        let w2: i32 = store_u8(buf + at, 45);
        at = at + 1;
    }
    while (i > 0) {
        i = i - 1;
        let ch: i32 = load_u8(tmp + i);
        let w3: i32 = store_u8(buf + at, ch);
        at = at + 1;
    }
    return at;
}

// 优先级字母（Android prio：2 V，3 D，4 I，5 W，6 E）。
fn aui_log_level_letter(level: i32) : i32 {
    if (level == 2) { return 86; }
    if (level == 3) { return 68; }
    if (level == 4) { return 73; }
    if (level == 5) { return 87; }
    if (level == 6) { return 69; }
    return 63;
}

// 单调时钟毫秒（i64；clock_ns 是纳秒，/1000000 不溢出）。
fn aui_log_now_ms() : i64 {
    let ns: i64 = clock_ns();
    if (ns < 0) { return 0; }
    return ns / 1000000;
}

// 把 dir + "/aui.log" 写进 out（256 字节缓冲，超长截断）。返回 0。
fn aui_log_join(out: ptr, dir: ptr) : i32 {
    if (dir == 0) { return -1; }
    let n: i32 = str_len(dir);
    if (n <= 0 || n > 240) { return -1; }
    let i: i32 = 0;
    while (i < n) {
        let s0: i32 = store_u8(out + i, load_u8(dir + i));
        i = i + 1;
    }
    let suf: ptr = "/aui.log";
    let m: i32 = 0;
    while (m < 8) {
        let s1: i32 = store_u8(out + n + m, load_u8(suf + m));
        m = m + 1;
    }
    let z: i32 = store_u8(out + n + 8, 0);
    return 0;
}

// 初始化日志路径：内部 + 外部 files 目录各一份。attach 时调一次；
// 任一目录为空时只设另一份；两份都空则日志保持关闭（返回 -1）。
fn aui_log_init(internal: ptr, ext: ptr) : i32 {
    let ok: i32 = 0;
    let p1: ptr = g_aui_log_path1;
    let r1: i32 = aui_log_join(p1, internal);
    if (r1 == 0) { ok = 1; }
    let p2: ptr = g_aui_log_path2;
    let r2: i32 = aui_log_join(p2, ext);
    if (r2 == 0) { ok = 1; }
    if (ok != 0) { g_aui_log_set = 1; return 0; }
    return -1;
}

// 测试/无宿主路径：只设主文件（aui_log_tail 回读的就是它）。
fn aui_log_set_file(path: ptr) : i32 {
    if (path == 0) { return -1; }
    let n: i32 = str_len(path);
    if (n <= 0 || n > 240) { return -1; }
    let p1: ptr = g_aui_log_path1;
    let i: i32 = 0;
    while (i < n) {
        let s0: i32 = store_u8(p1 + i, load_u8(path + i));
        i = i + 1;
    }
    let z: i32 = store_u8(p1 + n, 0);
    g_aui_log_set = 1;
    return 0;
}

// 自 attach 起写入的行数。
fn aui_log_lines() : i32 {
    return g_aui_log_lines;
}

// 文件大小（字节），-1 = 打不开或读不到（与 stdlib file_size 同写）。
fn aui_log_file_size(path: ptr) : i64 {
    let fd: i32 = openat(-100, path, 0, 0);
    if (fd < 0) { return 0 - 1; }
    let st: u8[128] = 0;
    let r: i32 = fstat(fd, &st);
    let c: i32 = close(fd);
    if (r != 0) { return 0 - 1; }
    return load_i64(&st + 48);
}

// 把已格式化的行（g_aui_log_line，g_aui_log_line_len）写进一个文件：
// 超过 128 KiB 先截断再追加；写不满一行就按实际写出的算。返回写出
// 的字节数，路径未设置或打不开返回 0。
fn aui_log_append_one(path: ptr) : i32 {
    if (path == 0) { return 0; }
    if (load_u8(path + 0) == 0) { return 0; }
    let sz: i64 = aui_log_file_size(path);
    if (sz > 131072) {
        let tf: i32 = openat(-100, path, 577, 420);
        if (tf >= 0) {
            let tc: i32 = close(tf);
        }
    }
    let fd: i32 = openat(-100, path, 1089, 420);
    if (fd < 0) { return 0; }
    let done: i32 = 0;
    let n: i32 = g_aui_log_line_len;
    while (done < n) {
        let w: i32 = write(fd, g_aui_log_line + done, n - done);
        if (w <= 0) { break; }
        done = done + w;
    }
    let c: i32 = close(fd);
    return done;
}

// "[<ms>] <L> AUI: <msg>\n" 写进 g_aui_log_line；超长消息截断到
// 512 字节行缓冲内。返回行长度。
fn aui_log_format(level: i32, msg: ptr) : i32 {
    let at: i32 = 0;
    let c0: i32 = store_u8(g_aui_log_line + at, 91);
    at = at + 1;
    let n0: i32 = aui_log_fmt_i64(g_aui_log_line + at, aui_log_now_ms());
    at = at + n0;
    let c1: i32 = store_u8(g_aui_log_line + at, 93);
    at = at + 1;
    let c2: i32 = store_u8(g_aui_log_line + at, 32);
    at = at + 1;
    let c3: i32 = store_u8(g_aui_log_line + at, aui_log_level_letter(level));
    at = at + 1;
    let c4: i32 = store_u8(g_aui_log_line + at, 32);
    at = at + 1;
    let tag: ptr = "AUI: ";
    let i: i32 = 0;
    while (i < 5) {
        let c5: i32 = store_u8(g_aui_log_line + at, load_u8(tag + i));
        at = at + 1;
        i = i + 1;
    }
    let mlen: i32 = str_len(msg);
    let room: i32 = 512 - at - 1;
    if (mlen > room) { mlen = room; }
    if (mlen > 0) {
        let j: i32 = 0;
        while (j < mlen) {
            let c6: i32 = store_u8(g_aui_log_line + at, load_u8(msg + j));
            at = at + 1;
            j = j + 1;
        }
    }
    let c7: i32 = store_u8(g_aui_log_line + at, 10);
    at = at + 1;
    let c8: i32 = store_u8(g_aui_log_line + at, 0);
    g_aui_log_line_len = at;
    return at;
}

// 写一行日志：文件（两个路径）+ logcat 镜像。msg 里不要出现 %
// （它原样进 __android_log_print 的 fmt 参数）。永不让调用方失败。
fn aui_log(level: i32, msg: ptr) : i32 {
    if (msg == 0) { return 0; }
    let n: i32 = aui_log_format(level, msg);
    if (g_aui_log_set != 0) {
        let w1: i32 = aui_log_append_one(g_aui_log_path1);
        let w2: i32 = aui_log_append_one(g_aui_log_path2);
    }
    let s: i32 = __android_log_print(level, "AsterUI", msg);
    g_aui_log_lines = g_aui_log_lines + 1;
    return 0;
}

// --- 消息拼接："<p0><v><p1>"（aui_log1）与 "<p0><a><p1><b><p2>"（aui_log2）---
// Aster 不能把数字格式化进字面量，所以数字先拼进 g_aui_log_msg。

fn aui_log_msg_begin() : i32 {
    g_aui_log_msg_len = 0;
    return 0;
}

fn aui_log_msg_str(s: ptr) : i32 {
    let n: i32 = str_len(s);
    if (g_aui_log_msg_len + n > 255) { n = 255 - g_aui_log_msg_len; }
    if (n > 0) {
        let i: i32 = 0;
        while (i < n) {
            let c: i32 = store_u8(g_aui_log_msg + g_aui_log_msg_len, load_u8(s + i));
            g_aui_log_msg_len = g_aui_log_msg_len + 1;
            i = i + 1;
        }
    }
    return 0;
}

fn aui_log_msg_i32(v: i32) : i32 {
    let tmp: u8[24] = 0;
    let n: i32 = aui_log_fmt_i64(tmp, i64(v));
    if (g_aui_log_msg_len + n > 255) { n = 255 - g_aui_log_msg_len; }
    if (n > 0) {
        let i: i32 = 0;
        while (i < n) {
            let c: i32 = store_u8(g_aui_log_msg + g_aui_log_msg_len, load_u8(tmp + i));
            g_aui_log_msg_len = g_aui_log_msg_len + 1;
            i = i + 1;
        }
    }
    return 0;
}

fn aui_log_msg_end() : ptr {
    let z: i32 = store_u8(g_aui_log_msg + g_aui_log_msg_len, 0);
    return g_aui_log_msg;
}

fn aui_log1(level: i32, p0: ptr, v: i32, p1: ptr) : i32 {
    let b: i32 = aui_log_msg_begin();
    let s0: i32 = aui_log_msg_str(p0);
    let s1: i32 = aui_log_msg_i32(v);
    let s2: i32 = aui_log_msg_str(p1);
    let m: ptr = aui_log_msg_end();
    return aui_log(level, m);
}

fn aui_log2(level: i32, p0: ptr, a: i32, p1: ptr, b: i32, p2: ptr) : i32 {
    let bb: i32 = aui_log_msg_begin();
    let s0: i32 = aui_log_msg_str(p0);
    let s1: i32 = aui_log_msg_i32(a);
    let s2: i32 = aui_log_msg_str(p1);
    let s3: i32 = aui_log_msg_i32(b);
    let s4: i32 = aui_log_msg_str(p2);
    let m: ptr = aui_log_msg_end();
    return aui_log(level, m);
}

// v2.7.1-diag：三值日志 "<p0><a><p1><b><p2><c><p3>"（与 aui_log1/aui_log2 同模式）。
fn aui_log3(level: i32, p0: ptr, a: i32, p1: ptr, b: i32, p2: ptr, c: i32, p3: ptr) : i32 {
    let bb: i32 = aui_log_msg_begin();
    let s0: i32 = aui_log_msg_str(p0);
    let s1: i32 = aui_log_msg_i32(a);
    let s2: i32 = aui_log_msg_str(p1);
    let s3: i32 = aui_log_msg_i32(b);
    let s4: i32 = aui_log_msg_str(p2);
    let s5: i32 = aui_log_msg_i32(c);
    let s6: i32 = aui_log_msg_str(p3);
    let m: ptr = aui_log_msg_end();
    return aui_log(level, m);
}

// 回读主日志文件的尾部（查看器用）：最多 cap 字节写进 out，返回
// 实际写出的字节数；文件不存在返回 0，没有设置路径返回 -1。文件
// 比 cap 大时跳过前面的字节，只留最后 cap 字节。
fn aui_log_tail(out: ptr, cap: i32) : i32 {
    if (g_aui_log_set == 0) { return -1; }
    let path: ptr = g_aui_log_path1;
    if (load_u8(path + 0) == 0) { return -1; }
    let sz: i64 = aui_log_file_size(path);
    if (sz <= 0) { return 0; }
    let skip: i64 = 0;
    if (sz > i64(cap)) { skip = sz - i64(cap); }
    let fd: i32 = openat(-100, path, 0, 0);
    if (fd < 0) { return -1; }
    let scratch: u8[256] = 0;
    let left: i64 = skip;
    while (left > 0) {
        let want: i32 = 256;
        if (left < 256) { want = i32(left); }
        let r: i32 = read(fd, scratch, want);
        if (r <= 0) {
            let c0: i32 = close(fd);
            return -1;
        }
        left = left - i64(r);
    }
    let got: i32 = 0;
    while (got < cap) {
        let r2: i32 = read(fd, out + got, cap - got);
        if (r2 <= 0) { break; }
        got = got + r2;
    }
    let c1: i32 = close(fd);
    return got;
}

fn set_screen_from_window(win: ptr) : i32 {
    let w: i32 = ANativeWindow_getWidth(win);
    let h: i32 = ANativeWindow_getHeight(win);
    if (w > 0 && h > 0) {
        g_aui_sw = fx(w);
        g_aui_sh = fx(h);
    }
    return 0;
}

// 读取 density 与夜间模式；配置变化回调会再次调用。
// 返回 0 表示配置对象读取成功，-1 表示只能沿用旧值。
fn config_refresh() : i32 {
    let ok: i32 = -1;
    if (g_aui_activity != 0) {
        let assets: ptr = load_ptr(g_aui_activity + 64);
        if (assets != 0) {
            let cfg: ptr = AConfiguration_new();
            if (cfg != 0) {
                // NDK 里 AConfiguration_fromAssetManager 返回 void；不能检查
                // 返回值，否则真机上 x0 的残留值会让配置读取被整段跳过。
                AConfiguration_fromAssetManager(cfg, assets);
                let dpi: i32 = AConfiguration_getDensity(cfg);
                if (dpi > 0) { g_aui_density = (dpi << 16) / 160; }
                // NDK 只提供 getUiModeNight：0=ANY，1=NO，2=YES。
                g_aui_night = AConfiguration_getUiModeNight(cfg);
                if (g_aui_night == 2) { g_aui_dark = 1; }
                else { g_aui_dark = 0; }
                ok = 0;
                let dl: i32 = AConfiguration_delete(cfg);
            }
        }
    }
    let td: i32 = trace_hex(100, g_aui_density);         // d + density
    let tu: i32 = trace_hex(117, g_aui_night);           // u + night(0/1/2)
    return ok;
}

fn aui_cb_start(a: ptr) : i32 { return 0; }
fn aui_cb_resume(a: ptr) : i32 {
    aui_lock();
    // 系统深浅色/density 可能在后台变化，某些 ROM 不会补发
    // onConfigurationChanged；恢复时再读一次，只有变化才重建。
    let oldd: i32 = g_aui_dark;
    let oldu: i32 = g_aui_night;
    let oldden: i32 = g_aui_density;
    let c: i32 = config_refresh();
    if (oldd != g_aui_dark || oldu != g_aui_night ||
        oldden != g_aui_density) {
        let r: i32 = aui_invalidate();
    }
    // 后台期间不该继续转场：到点就收尾，没到点也直接收尾（后台没有帧）。
    if (g_aui_page_on != 0) {
        let pc: i32 = page_cancel();
        let rp: i32 = aui_invalidate();
    }
    // 后台期间暂停的动画/惯性滚动恢复驱动。
    let ts: i32 = frame_timer_sync();
    aui_unlock();
    return 0;
}
fn aui_cb_pause(a: ptr) : i32 {
    aui_lock();
    let f: i32 = fling_stop();
    // 切后台时帧泵不再出帧，转场不能留在半截状态。
    if (g_aui_page_on != 0) {
        let pc: i32 = page_cancel();
    }
    // 后台不再走 16 ms 帧；动画槽保留，恢复后按目标值继续。
    let d: i32 = frame_timer_disarm();
    aui_unlock();
    return 0;
}
fn aui_cb_stop(a: ptr) : i32 {
    aui_lock();
    let f: i32 = fling_stop();
    let d: i32 = frame_timer_disarm();
    aui_unlock();
    return 0;
}

fn aui_cb_save(a: ptr, out_state: ptr, out_size: ptr) : i32 {
    return 0;
}

fn aui_cb_destroy(a: ptr) : i32 {
    let r: i32 = aui_shutdown();
    return 0;
}
fn aui_cb_focus(a: ptr, focused: i32) : i32 { return 0; }

fn aui_cb_win_created(a: ptr, win: ptr) : i32 {
    aui_lock();
    let tw: i32 = trace_mark(87);                        // W = 窗口创建
    g_aui_win = win;
    g_aui_have_win = 1;
    g_aui_ct_valid = 0;                                  // 等新的内容区回调
    let s: i32 = set_screen_from_window(win);
    let g: i32 = ANativeWindow_setBuffersGeometry(win, 0, 0, 1);
    let rw: i32 = trace_hex(114, fx_px(g_aui_sw));       // r + 宽（像素）
    let rh: i32 = trace_hex(115, fx_px(g_aui_sh));       // s + 高
    // v2.8：DEBUG overlay 默认开（HuxerUI：debug 构建默认开）。只有
    // 未显式设置过开关时才默认开；API 关过就不再自动开回来。
    // headless 不走这里，所以默认关、不污染 harness 基线。
    if (g_dbg_explicit == 0) { g_dbg_on = 1; }
    let lw: i32 = aui_log2(4, "aui: window ", fx_px(g_aui_sw), "x", fx_px(g_aui_sh), "");
    // v1.12：窗口就绪就启动帧泵（真机）；测试走假时钟，不启线程。
    let pe: i32 = frame_pump_ensure();
    let r: i32 = aui_invalidate();
    aui_unlock();
    return 0;
}

fn aui_cb_win_resized(a: ptr, win: ptr) : i32 {
    aui_lock();
    g_aui_win = win;
    g_aui_have_win = 1;
    g_aui_ct_valid = 0;                                  // 旋转/分屏后重新等内容区
    let s: i32 = set_screen_from_window(win);
    let rw: i32 = trace_hex(114, fx_px(g_aui_sw));       // r + 宽
    let rh: i32 = trace_hex(115, fx_px(g_aui_sh));       // s + 高
    // 应用可能在 build 里按宽高分支，所以这里整棵树重建而不是只布局。
    let r: i32 = aui_invalidate();
    aui_unlock();
    return 0;
}

fn aui_cb_win_redraw(a: ptr, win: ptr) : i32 {
    aui_lock();
    let tr: i32 = trace_mark(82);                        // R = 重绘请求
    let r: i32 = aui_frame(0);
    aui_unlock();
    return 0;
}

fn aui_cb_win_destroyed(a: ptr, win: ptr) : i32 {
    aui_lock();
    let f: i32 = fling_stop();
    g_aui_have_win = 0;
    g_aui_win = 0;
    g_aui_fbuf_ok = 0;                           // 窗口没了，帧缓冲内容不可信
    g_aui_pump_need = 0;
    aui_unlock();
    // 窗口没了就不该继续出帧；下次窗口创建再起一个新泵。
    let s: i32 = frame_pump_stop();
    return 0;
}

fn aui_cb_iq_created(a: ptr, q: ptr) : i32 {
    aui_lock();
    g_aui_queue = q;
    // NativeActivity 的 Java UI 线程不一定注册过 NDK ALooper；
    // onInputQueueCreated 里 forThread 可能返回 0，必须先 prepare，
    // 否则 attachLooper 解引用空指针（或静默失败，点按全部丢失）。
    let looper: ptr = ALooper_forThread();
    let have: i32 = 0;
    if (looper != 0) { have = 1; }
    let ta: i32 = trace_hex(65, have);                   // A + 1 = 线程已有 looper
    if (looper == 0) {
        looper = ALooper_prepare(1);                     // ALLOW_NON_CALLBACKS
        let tb: i32 = trace_hex(66, 1);                  // B = 已 prepare
    }
    if (looper == 0) {
        let tz: i32 = trace_hex(66, 0);                  // prepare 也失败
        aui_unlock();
        return 0;
    }
    g_aui_looper = looper;
    let r: i32 = AInputQueue_attachLooper(q, looper, 1, aui_on_input, g_aui_null);
    let tq: i32 = trace_hex(81, r);                      // Q + attach 返回值
    // 动画可能在窗口/输入就绪前启动，这里补一次驱动。
    let ts: i32 = frame_timer_sync();
    aui_unlock();
    return 0;
}

fn aui_cb_iq_destroyed(a: ptr, q: ptr) : i32 {
    aui_lock();
    let f: i32 = fling_stop();
    g_aui_looper = 0;
    let r: i32 = AInputQueue_detachLooper(q);
    g_aui_queue = 0;
    aui_unlock();
    return 0;
}

fn aui_cb_rect(a: ptr, rect: ptr) : i32 {
    aui_lock();
    let l: i32 = *(rect + 0);
    let t: i32 = *(rect + 4);
    let rt: i32 = *(rect + 8);
    let bt: i32 = *(rect + 12);
    // v2.6.2 横屏：内容区回调可能先于窗口 resize 到达（或晚于它、
    // 带着旧方向的矩形）。先重读窗口尺寸，再校验矩形是否装得进
    // 当前窗口：装不进说明它是旧方向的残留，直接丢弃（ct_valid=0，
    // 布局退回 24 dp 估算 + 新窗口尺寸），等下一次回调再取。合法的
    // 内容区恒在窗口内（r <= 窗宽，b <= 窗高），丢弃不会误伤。
    if (g_aui_win != 0) {
        let s: i32 = set_screen_from_window(g_aui_win);
        let swp: i32 = fx_px(g_aui_sw);
        let shp: i32 = fx_px(g_aui_sh);
        if (swp > 0 && shp > 0 && (rt > swp || bt > shp)) {
            g_aui_ct_valid = 0;
            let tz: i32 = trace_hex(105, rt);           // i + 丢弃的右边缘
            let r: i32 = aui_invalidate();
            aui_unlock();
            return 0;
        }
    }
    g_aui_ct_l = l;
    g_aui_ct_t = t;
    g_aui_ct_r = rt;
    g_aui_ct_b = bt;
    if (rt > l && bt > t) { g_aui_ct_valid = 1; }
    else { g_aui_ct_valid = 0; }
    // v2.14：内容区到了（窗口已布局），顺手量一次真实栏高；下次内容
    // 区变化时再量。量不到时保持旧缓存/估算。
    let im1: i32 = sysbar_measure_insets();
    let ti: i32 = trace_hex(105, l);                     // i + content left
    let tj: i32 = trace_hex(106, t);                     // j + content top
    let to: i32 = trace_hex(111, rt);                    // o + content right
    let tp: i32 = trace_hex(112, bt);                    // p + content bottom
    let r: i32 = aui_invalidate();
    aui_unlock();
    return 0;
}

fn aui_cb_config(a: ptr) : i32 {
    aui_lock();
    let c: i32 = config_refresh();
    // 某些 ROM 的 orientation 配置变化可能早于 window resize 回调；
    // 这里顺手再读一次窗口尺寸，保证首次重建就用新的宽高。
    if (g_aui_win != 0) {
        let s: i32 = set_screen_from_window(g_aui_win);
    }
    // v2.14：配置变化（旋转/分屏/夜间）可能改栏高，重新量一次。
    let im2: i32 = sysbar_measure_insets();
    let r: i32 = aui_invalidate();
    aui_unlock();
    return 0;
}

fn aui_cb_lowmem(a: ptr) : i32 {
    let l: i32 = aui_log(5, "aui: onLowMemory");
    return 0;
}

// Font probe (font fix, 2026-11-14): eager system-font init at
// attach + a diagnosable outcome in aui.log. The runtime font used
// to load lazily on first text draw and never logged its outcome,
// so a device whose font file matched none of the three hardcoded
// paths rendered the bitmap fallback forever with nothing in the
// log to say why. The probe runs the (now discovery-based) init
// here, in onCreate, and logs: one summary line, one line per
// candidate path tried, one rasterize probe (A + U+6F22 漢), and a
// fallback line when the system font is not active. Read it in the
// in-app log viewer; on a healthy device the summary says
// "sysfont ok 1 err 0 face 2 ... wght 400" (wght is the fvar default
// weight of the loaded face; -1 when the face has no fvar/wght axis).
fn aui_sysfont_probe() : i32 {
    let e: i32 = aui_rt_ensure();
    let ok: i32 = ui_sysfont_ok();
    let er: i32 = ui_sysfont_err();
    let fc: i32 = ui_sysfont_face();
    let cf: i32 = ui_sysfont_is_cff();
    let gl: i32 = ui_sysfont_is_glyf();
    let c2: i32 = ui_sysfont_is_cff2();
    let cm: i32 = ui_sysfont_cmap_fmt();
    let ng: i32 = ui_sysfont_glyphs();
    let up: i32 = ui_sysfont_upm();
    let b0: i32 = aui_log_msg_begin();
    let s0: i32 = aui_log_msg_str("sysfont ok ");
    let s1: i32 = aui_log_msg_i32(ok);
    let s2: i32 = aui_log_msg_str(" err ");
    let s3: i32 = aui_log_msg_i32(er);
    let s4: i32 = aui_log_msg_str(" face ");
    let s5: i32 = aui_log_msg_i32(fc);
    let s6: i32 = aui_log_msg_str(" cff ");
    let s7: i32 = aui_log_msg_i32(cf);
    let sg: i32 = aui_log_msg_str(" glyf ");
    let sh: i32 = aui_log_msg_i32(gl);
    let s8: i32 = aui_log_msg_str(" cff2 ");
    let s9: i32 = aui_log_msg_i32(c2);
    let sa: i32 = aui_log_msg_str(" cmap ");
    let sb: i32 = aui_log_msg_i32(cm);
    let sc: i32 = aui_log_msg_str(" glyphs ");
    let sd: i32 = aui_log_msg_i32(ng);
    let se: i32 = aui_log_msg_str(" upm ");
    let sf: i32 = aui_log_msg_i32(up);
    let wg: i32 = ui_sysfont_fvar_wght();
    let sw: i32 = aui_log_msg_str(" wght ");
    let sx: i32 = aui_log_msg_i32(wg);
    let m0: ptr = aui_log_msg_end();
    let l0: i32 = aui_log(4, m0);
    let n: i32 = ui_sysfont_probe_n();
    let i: i32 = 0;
    while (i < n) {
        let pp: ptr = ui_sysfont_probe_path(i);
        let ps: i32 = ui_sysfont_probe_size(i);
        let pe: i32 = ui_sysfont_probe_err(i);
        let b1: i32 = aui_log_msg_begin();
        let t0: i32 = aui_log_msg_str("sysfont try ");
        let t1: i32 = aui_log_msg_i32(i);
        let t2: i32 = aui_log_msg_str(" size ");
        let t3: i32 = aui_log_msg_i32(ps);
        let t4: i32 = aui_log_msg_str(" err ");
        let t5: i32 = aui_log_msg_i32(pe);
        let t6: i32 = aui_log_msg_str(" ");
        let t7: i32 = aui_log_msg_str(pp);
        let m1: ptr = aui_log_msg_end();
        let l1: i32 = aui_log(4, m1);
        i = i + 1;
    }
    // Raster probe: 'A' and U+6F22 alone could not catch the
    // v2.1 bowl corruption (neither uses a multi-curve flex
    // operator), so 'e' and 'o' are probed too -- a -1 slot or a
    // rising decodefail here means the interpreter still mangles
    // round glyphs. The slots are the glyph-cache indices.
    let ra: i32 = ui_tt_rasterize(65, 48, 48);
    let rh: i32 = ui_tt_rasterize(28450, 48, 48);
    let re: i32 = ui_tt_rasterize(101, 48, 48);
    let ro: i32 = ui_tt_rasterize(111, 48, 48);
    let df: i32 = ui_tt_decode_failures();
    let b2: i32 = aui_log_msg_begin();
    let r0: i32 = aui_log_msg_str("sysfont raster A ");
    let r1: i32 = aui_log_msg_i32(ra);
    let r2: i32 = aui_log_msg_str(" han ");
    let r3: i32 = aui_log_msg_i32(rh);
    let r4: i32 = aui_log_msg_str(" e ");
    let r5: i32 = aui_log_msg_i32(re);
    let r6: i32 = aui_log_msg_str(" o ");
    let r7: i32 = aui_log_msg_i32(ro);
    let r8: i32 = aui_log_msg_str(" decodefail ");
    let r9: i32 = aui_log_msg_i32(df);
    let m2: ptr = aui_log_msg_end();
    let l2: i32 = aui_log(4, m2);
    if (aui_rt_active() == 0) {
        let fe: i32 = aui_rt_fallback_events();
        let fr: i32 = aui_rt_fallback_reason();
        let b3: i32 = aui_log_msg_begin();
        let f0: i32 = aui_log_msg_str("sysfont fallback reason ");
        let f1: i32 = aui_log_msg_i32(fr);
        let f2: i32 = aui_log_msg_str(" events ");
        let f3: i32 = aui_log_msg_i32(fe);
        let m3: ptr = aui_log_msg_end();
        let l3: i32 = aui_log(4, m3);
    } else {
    }
    return 0;
}

fn aui_android_attach(activity: ptr, saved: ptr, saved_size: i64,
                      build: fn(ptr) : i32, user: ptr,
                      init: fn(ptr) : i32, flags: i32) : i32 {
    g_aui_activity = activity;
    g_aui_build = build;
    g_aui_user = user;
    g_aui_init = init;
    g_aui_attached = 1;
    // 外部数据目录在 ANativeActivity 偏移 40：先打开 trace.txt。
    let ext: ptr = load_ptr(activity + 40);
    g_aui_ext_dir = ext;
    let tr: i32 = trace_init(ext);
    // W3：内部数据目录在偏移 32；文件日志（aui.log）内外各一份。
    let internal: ptr = load_ptr(activity + 32);
    let li: i32 = aui_log_init(internal, ext);
    let la: i32 = aui_log(4, "aui: attach");
    // sdkVersion 在 ANativeActivity 偏移 48（i32）；只取低 16 位足够。
    // v1.14：API 35+ 用它对 edge-to-edge 的整窗内容区做系统栏估算。
    let sd: i32 = load_u16(activity + 48);
    g_aui_sdk = sd;
    let tos: i32 = trace_hex(79, g_aui_sdk);             // O + sdkVersion
    // 资源管理器在 ANativeActivity 偏移 64；density/night 决定 dp→px 与主题。
    let cr: i32 = config_refresh();
    if (init != 0) {
        let i0: fn(ptr) : i32 = init;
        let r0: i32 = i0(user);
    }
    // Font probe (2026-11-14): eager system-font init + outcome in
    // aui.log, so a device that falls back says why (see
    // aui_sysfont_probe). Runs after app init; idempotent.
    // v2.5.2 (ms=0): inject the monotonic log clock into the TrueType
    // engine, so aui_rt_custom_load_ms() measures real load time
    // instead of (-1)-(-1)=0. ui_tt_set_clock lives in
    // font_runtime.ast via render/truetype.ast (extern decl above);
    // aui_log_now_ms is CLOCK_MONOTONIC ms, signature fn() -> i64.
    let tc: i32 = ui_tt_set_clock(aui_log_now_ms);
    let fp: i32 = aui_sysfont_probe();
    let ti: i32 = trace_mark(73);                        // I = 应用 init 完成
    // ANativeActivityCallbacks：窗口 56/64/72/80，输入队列 88/96，其余 0..120。
    let cb: ptr = load_ptr(activity);
    if (cb != 0) {
        *(cb + 0) = aui_cb_start;
        *(cb + 8) = aui_cb_resume;
        *(cb + 16) = aui_cb_save;
        *(cb + 24) = aui_cb_pause;
        *(cb + 32) = aui_cb_stop;
        *(cb + 40) = aui_cb_destroy;
        *(cb + 48) = aui_cb_focus;
        *(cb + 56) = aui_cb_win_created;
        *(cb + 64) = aui_cb_win_resized;
        *(cb + 72) = aui_cb_win_redraw;
        *(cb + 80) = aui_cb_win_destroyed;
        *(cb + 88) = aui_cb_iq_created;
        *(cb + 96) = aui_cb_iq_destroyed;
        *(cb + 104) = aui_cb_rect;
        *(cb + 112) = aui_cb_config;
        *(cb + 120) = aui_cb_lowmem;
    }
    let tk: i32 = trace_mark(75);                        // K = 回调表装好
    // v2.13：启动时按启动主题换一次系统栏图标颜色（与条带一起）。
    let sb0: i32 = sysbar_apply_icons();
    // v2.14：启动时量一次真实栏高（未布局前可能取不到，返回 0；
    // 内容区回调到后再测一次）。
    let im0: i32 = sysbar_measure_insets();
    return 0;
}

// v2.20.0: Linux fbdev attach -- aui_android_attach 的 Linux 对应物。
// build/user 事先由应用的 *_headless_init() 注册（extern 调用；extern
// 函数不可取地址，所以 build/app_init 不经过这里），app_init 由应用
// 入口直接调；这里只做平台一半。密度/edge-to-edge/内容区/字体路径由
// 适配器在调它之前经公开 setter 定好。win/queue 是适配器的会话指针。
// Android 路径一行不动；本函数在 Android .so 里只是死代码。
fn aui_fbdev_attach(win: ptr, queue: ptr, logdir: ptr) : i32 {
    g_aui_attached = 1;
    let tr: i32 = trace_init(logdir);
    // v2.20.0：只设主文件——传 (logdir, logdir) 会让 aui_log 把每行写两
    // 遍进同一个 aui.log（aui_log 总是同时写 path1 与 path2）。
    let li: i32 = aui_log_init(logdir, 0);
    let la: i32 = aui_log(4, "aui: fbdev attach");
    let tc: i32 = ui_tt_set_clock(aui_log_now_ms);
    let fp: i32 = aui_sysfont_probe();
    // 窗口：与 aui_cb_win_created 同样的几步（设窗口、读尺寸、DEBUG
    // 默认开、起泵、首帧）。set_screen_from_window 调适配器的
    // ANativeWindow_getWidth/Height，返回 fb 几何。
    g_aui_win = win;
    g_aui_have_win = 1;
    let s: i32 = set_screen_from_window(win);
    // 内容区 = 整窗（Linux 无系统栏；edge-to-edge 已由适配器打开，
    // calc_insets 的 24dp 估算不触发）。
    g_aui_ct_l = 0;
    g_aui_ct_t = 0;
    g_aui_ct_r = fx_px(g_aui_sw);
    g_aui_ct_b = fx_px(g_aui_sh);
    g_aui_ct_valid = 1;
    if (g_dbg_explicit == 0) { g_dbg_on = 1; }
    let lw: i32 = aui_log2(4, "aui: window ", fx_px(g_aui_sw), "x", fx_px(g_aui_sh), "");
    // 输入队列：与 aui_cb_iq_created 同样的几步（looper + attach）。
    g_aui_queue = queue;
    let looper: ptr = ALooper_forThread();
    if (looper == 0) { looper = ALooper_prepare(1); }
    g_aui_looper = looper;
    let r: i32 = AInputQueue_attachLooper(queue, looper, 1, aui_on_input, g_aui_null);
    // v1.12：窗口就绪就启动帧泵（真机）；Linux runner 是单线程，
    // pthread 桩返回 -1 → pump_fail → 直切，runner 驱动 pump_frame_once。
    let pe: i32 = frame_pump_ensure();
    let iv: i32 = aui_invalidate();
    return 0;
}

// v2.20.0: Linux runner 的空闲判断——1 = 近期有帧要出，0 = 可阻塞等输入。
fn aui_pump_need() : i32 {
    return g_aui_pump_need;
}

// v2.5: the app's external files dir (ANativeActivity offset 40),
// or 0 when no Android attach has run (headless). The Gallery's
// default custom-font folder is <ext>/fonts.
fn aui_ext_dir() : ptr {
    return g_aui_ext_dir;
}

fn aui_shutdown() : i32 {
    aui_lock();
    let tx: i32 = trace_mark(88);                        // X = 正常销毁
    let lx: i32 = aui_log(4, "aui: shutdown");
    let f: i32 = fling_stop();
    let ar: i32 = anim_reset_all();
    pager_drag_clear();
    // Phase 0：Window 退休——先禁新回调注册，再注销并释放全部回调槽位。
    let cr: i32 = aui_cb_retire_all();
    g_aui_looper = 0;
    g_aui_attached = 0;
    g_aui_have_win = 0;
    g_aui_win = 0;
    g_aui_fbuf_ok = 0;
    g_aui_queue = 0;
    g_aui_node_count = 0;
    g_aui_root = -1;
    let pr: i32 = present_reset();
    aui_unlock();
    // join 必须在锁外：泵线程可能正等这把锁。
    let tc: i32 = frame_pump_stop();
    return 0;
}

// ===========================================================================
// 11. 状态 / 焦点 / 公共杂项
// ===========================================================================

fn aui_state_get(key: i32) : i32 {
    let i: i32 = 0;
    while (i < g_aui_state_used) {
        if (g_aui_state_key[i] == key) { return g_aui_state_val[i]; }
        i = i + 1;
    }
    return 0;
}

fn aui_state_set(key: i32, value: i32) : i32 {
    let i: i32 = 0;
    while (i < g_aui_state_used) {
        if (g_aui_state_key[i] == key) {
            g_aui_state_val[i] = value;
            return 0;
        }
        i = i + 1;
    }
    if (g_aui_state_used < AUI_STATE_CAP) {
        g_aui_state_key[g_aui_state_used] = key;
        g_aui_state_val[g_aui_state_used] = value;
        g_aui_state_used = g_aui_state_used + 1;
    } else {
        // Phase 0：满表不再静默丢弃，记可诊断错误 A-103。
        let e: i32 = aui_set_err(AUI_ERR_TABLE_FULL);
    }
    return 0;
}

// Phase 0：显式释放一个 state 槽位（末尾槽换位填补，1 = 释放了一个，
// 0 = key 不存在）。state 表其余语义不变。
fn aui_state_release(key: i32) : i32 {
    let i: i32 = 0;
    while (i < g_aui_state_used) {
        if (g_aui_state_key[i] == key) {
            let last: i32 = g_aui_state_used - 1;
            g_aui_state_key[i] = g_aui_state_key[last];
            g_aui_state_val[i] = g_aui_state_val[last];
            g_aui_state_key[last] = 0;
            g_aui_state_val[last] = 0;
            g_aui_state_used = g_aui_state_used - 1;
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn aui_focus(key: i32) : i32 {
    g_aui_focus_key = key;
    g_aui_need_build = 1;
    g_aui_need_layout = 1;
    g_aui_need_paint = 1;
    return 0;
}

fn aui_focus_get() : i32 { return g_aui_focus_key; }

// v1.20：滑块实时值（千分比）。拖动期间读全局（布局/重建不打断手势），
// 否则读当前节点；没有这个 key 的滑块返回 -1。
fn aui_slider_value(key: i32) : i32 {
    if (g_aui_slider_key != 0 && g_aui_slider_key == key) { return g_aui_slider_val; }
    let i: i32 = 0;
    while (i < g_aui_node_count) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.kind == 16 && n.key == key) { return n.aux; }
        i = i + 1;
    }
    return -1;
}

// v1.21：刚点的分段下标（同一帧重建后仍可读）；否则回读容器节点的 aux。
fn aui_segmented_value(key: i32) : i32 {
    if (g_aui_seg_key != 0 && g_aui_seg_key == key) { return g_aui_seg_val; }
    let i: i32 = 0;
    while (i < g_aui_node_count) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.kind == 17 && n.key == key) { return n.aux; }
        i = i + 1;
    }
    return -1;
}

// v1.22：刚点的标签页下标（同一帧重建后仍可读）；否则回读容器 aux。
fn aui_tabs_value(key: i32) : i32 {
    if (g_aui_tab_key != 0 && g_aui_tab_key == key) { return g_aui_tab_val; }
    let i: i32 = 0;
    while (i < g_aui_node_count) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.kind == 19 && n.key == key) { return n.aux; }
        i = i + 1;
    }
    return -1;
}

// v1.24：刚松手提议的分页下标（同一帧重建后仍可读）；否则回读容器 aux。
fn aui_pager_value(key: i32) : i32 {
    if (g_aui_pager_prop_key != 0 && g_aui_pager_prop_key == key) {
        return g_aui_pager_prop_val;
    }
    let i: i32 = 0;
    while (i < g_aui_node_count) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.kind == 21 && n.key == key) { return n.aux; }
        i = i + 1;
    }
    return -1;
}

// v1.25：对话框关闭原因，只在 aui_dialog 的 cb 里有效：
// 1 = 点遮罩，2 = 系统 BACK，0 = 其他（按钮回调）。
fn aui_dialog_reason() : i32 { return g_aui_dialog_reason; }

// v1.38：底部弹出层关闭原因，只在 aui_sheet 的 cb 里有效：
// 1 = 点遮罩，2 = 系统 BACK，3 = 下拉越过阈值，0 = 其他（按钮回调）。
fn aui_sheet_reason() : i32 { return g_aui_sheet_reason; }

// ---- 页面栈（v1.8）----
// 路由值由应用解释（通常 >0）。push/pop/reset 都会清焦点并同步重建，
// 所以在按钮回调里直接调用即可，不需要再 aui_invalidate。
fn nav_ready() : i32 {
    if (g_aui_nav_ready == 0) {
        g_aui_nav_stack[0] = 1;
        g_aui_nav_depth = 1;
        g_aui_route_key = 1;
        g_aui_nav_ready = 1;
    }
    return 0;
}

fn nav_changed(dir: i32) : i32 {
    // v1.27：换页时收起工具提示（旧页的锚点已失效）。
    let th: i32 = tip_dismiss();
    if (g_aui_nav_ms > 0) {
        let pb: i32 = page_begin(dir, g_aui_nav_ms);
    }
    g_aui_focus_key = 0;
    let tn: i32 = trace_hex(110, g_aui_route_key);   // n + 当前路由
    let r: i32 = aui_invalidate();
    return 0;
}

fn aui_route() : i32 {
    nav_ready();
    return g_aui_route_key;
}

fn aui_nav_depth() : i32 {
    nav_ready();
    return g_aui_nav_depth;
}

// 页面转场时长（毫秒），0 = 关闭（默认）。只在 push/pop/reset 时生效；
// 旧页用命令快照保留，新页由正常 build 产生。
fn aui_nav_transition(ms: i32) : i32 {
    if (ms < 0) { ms = 0; }
    if (ms > 1000) { ms = 1000; }
    g_aui_nav_ms = ms;
    if (ms == 0) {
        let was: i32 = g_aui_page_on;
        let c: i32 = page_cancel();
        if (was != 0) {
            let r: i32 = aui_invalidate();
        }
    }
    return 0;
}

fn aui_nav_busy() : i32 {
    let pr: i32 = page_refresh();
    return g_aui_page_on;
}

fn aui_nav_push(route: i32) : i32 {
    nav_ready();
    if (g_aui_nav_depth >= AUI_NAV_MAX) { return -1; }
    g_aui_nav_stack[g_aui_nav_depth] = route;
    g_aui_nav_depth = g_aui_nav_depth + 1;
    g_aui_route_key = route;
    nav_changed(1);
    return 0;
}

fn aui_nav_pop() : i32 {
    nav_ready();
    if (g_aui_nav_depth <= 1) { return -1; }
    g_aui_nav_depth = g_aui_nav_depth - 1;
    g_aui_route_key = g_aui_nav_stack[g_aui_nav_depth - 1];
    nav_changed(-1);
    return 0;
}

fn aui_nav_reset(route: i32) : i32 {
    nav_ready();
    g_aui_nav_depth = 1;
    g_aui_nav_stack[0] = route;
    g_aui_route_key = route;
    nav_changed(0);
    return 0;
}

// 根页面按返回键时调用。先置位防止重复 finish，再交给 NativeActivity。
fn aui_finish() : i32 {
    if (g_aui_finished != 0) { return 0; }
    g_aui_finished = 1;
    let tb: i32 = trace_mark(98);        // b = 请求结束 Activity
    if (g_aui_activity == 0) { return -1; }
    return ANativeActivity_finish(g_aui_activity);
}

fn aui_text_value(key: i32) : ptr {
    let idx: i32 = text_slot(key, 0);
    if (idx < 0) { return g_aui_empty; }
    return g_aui_text_pool + idx * AUI_TEXT_SLOT;
}

fn aui_text_len(key: i32) : i32 { return text_len_of(key); }

fn aui_text_append(key: i32, ch: i32) : i32 {
    let r: i32 = text_append(key, ch);
    g_aui_need_layout = 1;
    g_aui_need_paint = 1;
    return r;
}

fn aui_text_backspace(key: i32) : i32 {
    let r: i32 = text_backspace(key);
    g_aui_need_layout = 1;
    g_aui_need_paint = 1;
    return r;
}

fn aui_text_clear(key: i32) : i32 {
    let r: i32 = text_clear(key);
    g_aui_need_layout = 1;
    g_aui_need_paint = 1;
    return r;
}

fn aui_text_set(key: i32, src: ptr, count: i32) : i32 {
    let r: i32 = text_set(key, src, count);
    g_aui_need_layout = 1;
    g_aui_need_paint = 1;
    return r;
}

// W2: the font pointer is ignored -- there is no .auf blob in the
// repo to inject. Glyphs come from the runtime adapter
// (font_runtime.ast): the device system font, else the hand-drawn
// fallback. Only the scale is recorded (native em 48 px at scale 1,
// matching the old font_latin48/font_cjk48 size). Pass font=0.
fn aui_set_font(font: ptr, scale: i32) : i32 {
    g_aui_font = 0;
    g_aui_rt_mode = 1;
    if (scale > 0) { g_aui_text_scale = scale; }
    g_aui_need_layout = 1;
    g_aui_need_paint = 1;
    return 0;
}

// v1.16：回退字体（通常是 16x16 CJK 图集）。主字体找不到的码点在这里
// 再查一次；两套字体各自带缩放，拉丁 8x8 常用 2，汉字 16x16 常用 1。
// 传 font=0 关闭回退。
// W2: kept for API compatibility only. The fallback now lives inside
// the runtime adapter (hand-drawn 56-glyph atlas when no system font
// is present); the pointer is ignored and the scale is recorded but
// unused by the runtime path.
fn aui_set_fallback_font(font: ptr, scale: i32) : i32 {
    g_aui_font2 = 0;
    g_aui_rt_mode = 1;
    if (scale > 0) { g_aui_text_scale2 = scale; }
    g_aui_need_layout = 1;
    g_aui_need_paint = 1;
    return 0;
}

fn aui_version() : i32 { return 14806; }   // 1.48.6

// v2.19.2：应用版本（与框架版本 aui_version 区分：这是 APK 的版本名 +
// code）。启动日志行与 Gallery System 标签页共用同一份常量：应用在
// build 里调 aui_set_app_version 一次登记，框架只存、只读，不再写第
// 二份。登记点放 build 而不用 app_init——app_init 只存进 g_aui_init
// 从未被调用（全仓库无调用方，见 REPORT-v2192），build 是设备与
// headless 两条路径上首帧前必跑的钩子。未登记时名字为 0、code 为 0。
let g_aui_app_ver_name: ptr = 0;
let g_aui_app_ver_code: i32 = 0;
let g_aui_ver_logged: i32 = 0;

fn aui_set_app_version(name: ptr, code: i32) : i32 {
    g_aui_app_ver_name = name;
    g_aui_app_ver_code = code;
    return 0;
}

fn aui_app_version_name() : ptr { return g_aui_app_ver_name; }

fn aui_app_version_code() : i32 { return g_aui_app_ver_code; }

// 无宿主渲染：build + layout + paint + 光栅到调用方缓冲区（RGBA8888）。
fn aui_headless_init(build: fn(ptr) : i32, user: ptr) : i32 {
    g_aui_build = build;
    g_aui_user = user;
    g_aui_need_build = 1;
    g_aui_need_layout = 1;
    g_aui_need_paint = 1;
    return 0;
}

fn aui_headless_render(w: i32, h: i32, out: ptr) : i32 {
    g_aui_sw = fx(w);
    g_aui_sh = fx(h);
    g_aui_fb_w = w;
    g_aui_fb_h = h;
    let c: i32 = pump_ui();
    let n: i32 = draw_cmds(out, w, 1);
    // Phase 0：提交完成，封存帧区（下一 build 开始时由 aui_root 清零）。
    g_aui_frame_sealed = 1;
    return n;
}

// 测试辅助：按 key 查节点矩形（像素，x/y/w/h 各 4 字节，向下取整）。
// 找到返回 0，找不到返回 -1。只给离屏/qemu 测试用，渲染路径不依赖。
// 测试辅助：模拟 onContentRectChanged 的内容区（像素）。不依赖 Activity，
// 供离屏测试验证安全区布局与整屏底色。
fn aui_debug_set_content(l: i32, t: i32, r: i32, b: i32) : i32 {
    g_aui_ct_l = l;
    g_aui_ct_t = t;
    g_aui_ct_r = r;
    g_aui_ct_b = b;
    if (r > l && b > t) { g_aui_ct_valid = 1; }
    else { g_aui_ct_valid = 0; }
    g_aui_need_build = 1;
    g_aui_need_layout = 1;
    g_aui_need_paint = 1;
    return 0;
}

// 测试辅助：模拟 ANativeActivity.sdkVersion（0 = 未知，35 = Android 15）。
fn aui_debug_set_sdk(v: i32) : i32 {
    g_aui_sdk = v;
    g_aui_need_build = 1;
    g_aui_need_layout = 1;
    g_aui_need_paint = 1;
    return 0;
}

fn aui_debug_spin_phase() : i32 { return spin_phase_now(); }

fn aui_debug_progress_circle(key: i32, out: ptr) : i32 {
    let i: i32 = 0;
    while (i < g_aui_node_count) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.kind == 31 && n.key == key) {
            *(out + 0) = n.aux;
            *(out + 4) = n.aux2;
            return 0;
        }
        i = i + 1;
    }
    return -1;
}

// v1.33：树行的测试辅助。out[0] = 缩进层级，out[1] = 标志位。
fn aui_debug_tree_item(key: i32, out: ptr) : i32 {
    let i: i32 = 0;
    while (i < g_aui_node_count) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.kind == 33 && n.key == key) {
            *(out + 0) = n.aux2;
            *(out + 4) = n.gap;
            return 0;
        }
        i = i + 1;
    }
    return -1;
}

// v1.34：Toast 几何（像素）。out = [x,y,w,h,id,active]；找不到返回 -1。
fn aui_debug_toast(handle: i32, out: ptr) : i32 {
    let i: i32 = 0;
    while (i < AUI_TOAST_CAP) {
        if (g_aui_toast_on[i] != 0 && g_aui_toast_id[i] == handle) {
            *(out + 0) = g_aui_toast_x[i] >> 16;
            *(out + 4) = g_aui_toast_y[i] >> 16;
            *(out + 8) = g_aui_toast_w[i] >> 16;
            *(out + 12) = g_aui_toast_h[i] >> 16;
            *(out + 16) = handle;
            *(out + 20) = 1;
            return 0;
        }
        i = i + 1;
    }
    return -1;
}

fn aui_debug_toast_count() : i32 {
    let n: i32 = 0;
    let i: i32 = 0;
    while (i < AUI_TOAST_CAP) {
        if (g_aui_toast_on[i] != 0) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

// v1.34：SnackBar 几何/状态。out = [x,y,w,h,ax,ay,aw,ah,id,rem_ms,state]，
// state: 0 无 / 1 可见 / 2 动作按钮按下。没有时返回 -1。
fn aui_debug_snackbar(out: ptr) : i32 {
    if (g_aui_snack_on == 0) { return -1; }
    *(out + 0) = g_aui_snack_x >> 16;
    *(out + 4) = g_aui_snack_y >> 16;
    *(out + 8) = g_aui_snack_w >> 16;
    *(out + 12) = g_aui_snack_h >> 16;
    *(out + 16) = g_aui_snack_ax >> 16;
    *(out + 20) = g_aui_snack_ay >> 16;
    *(out + 24) = g_aui_snack_aw >> 16;
    *(out + 28) = g_aui_snack_ah >> 16;
    *(out + 32) = g_aui_snack_id;
    let rem: i32 = -1;
    if (g_aui_snack_rem >= 0) {
        rem = i32(g_aui_snack_rem / 1000000);
    }
    *(out + 36) = rem;
    let st: i32 = 1;
    if (g_aui_snack_press != 0) { st = 2; }
    *(out + 40) = st;
    return 0;
}

fn aui_debug_rect(key: i32, out: ptr) : i32 {
    let i: i32 = 0;
    while (i < g_aui_node_count) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.key == key) {
            *(out + 0) = n.x >> 16;
            *(out + 4) = n.y >> 16;
            *(out + 8) = n.w >> 16;
            *(out + 12) = n.h >> 16;
            return 0;
        }
        i = i + 1;
    }
    return -1;
}

// D-2a 测试探针：按 key 读修饰值。out = [size_w_dp, size_h_dp,
// text_sp, fg_bits, fg_set, selectable]；找不到 key 返回 -1。
fn aui_debug_d2a(key: i32, out: ptr) : i32 {
    let i: i32 = 0;
    while (i < g_aui_node_count) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.key == key) {
            *(out + 0) = g_d2a_size_w[i];
            *(out + 4) = g_d2a_size_h[i];
            *(out + 8) = g_d2a_text_sp[i];
            *(out + 12) = g_d2a_fg[i];
            *(out + 16) = g_d2a_fg_set[i];
            *(out + 20) = g_d2a_sel[i];
            return 0;
        }
        i = i + 1;
    }
    return -1;
}

// D-2a：选区读回。out = [node_idx, key, start_cp, end_cp]；无选区返回 -1。
fn aui_debug_selection(out: ptr) : i32 {
    if (d2a_sel_valid() == 0) { return -1; }
    let n: ptr<AuiNode> = node_at(g_d2a_sel_node);
    *(out + 0) = g_d2a_sel_node;
    *(out + 4) = n.key;
    *(out + 8) = g_d2a_sel_start;
    *(out + 12) = g_d2a_sel_end;
    return 0;
}

// D-2a：选中文本节点的 key；无选区返回 0。
fn aui_selection_key() : i32 {
    if (d2a_sel_valid() == 0) { return 0; }
    let n: ptr<AuiNode> = node_at(g_d2a_sel_node);
    return n.key;
}

// 测试辅助：设置离屏渲染的密度（dpi）。只给离屏/qemu 测试用。
fn aui_debug_set_density(dpi: i32) : i32 {
    if (dpi <= 0) { return -1; }
    g_aui_density = (dpi << 16) / 160;
    g_aui_need_build = 1;
    g_aui_need_layout = 1;
    g_aui_need_paint = 1;
    return 0;
}

// 测试辅助：给 headless 测试挂一个窗口指针，让 pump_frame_once() 走
// 真机泵路径（v2.7.1；没有窗口时它直接返回，不调任何 tick）。
// 传 0 摘掉窗口。只给离屏/qemu 测试用，渲染路径不依赖。
fn aui_debug_set_win(win: ptr) : i32 {
    g_aui_win = win;
    if (win != 0) { g_aui_have_win = 1; }
    else { g_aui_have_win = 0; }
    return 0;
}

// 测试辅助：按 key 取滚动偏移（像素，四舍五入）。只给离屏/qemu 测试用。
fn aui_debug_scroll(key: i32) : i32 {
    let v: i32 = scroll_get(key);
    if (virtual_key(key) != 0) { return v; }     // 虚拟列表/网格已是像素
    return fx_px(v);
}

// 测试辅助：按 key 取最大偏移（像素）。
fn aui_debug_scroll_max(key: i32) : i32 {
    if (virtual_key(key) != 0) { return scroll_max(key); }
    return fx_px(scroll_max(key));
}

// 测试辅助：直接设置滚动偏移（像素，自动 clamp）。
fn aui_debug_scroll_set(key: i32, px: i32) : i32 {
    if (virtual_key(key) != 0) { return scroll_set(key, px); }
    let v: i32 = scroll_set(key, px << 16);
    return fx_px(v);
}

// ---- 虚拟列表公共/调试接口（v1.45）----
fn vlist_node(key: i32) : i32 {
    let i: i32 = g_aui_node_count - 1;
    while (i >= 0) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.kind == 51 && n.key == key) { return i; }
        i = i - 1;
    }
    return -1;
}

fn aui_vlist_scroll(key: i32) : i32 {
    return scroll_get(key);                       // 已是像素
}

// 程序化滚动：像素，自动 clamp；会触发窗口重建。
fn aui_vlist_scroll_to(key: i32, px: i32) : i32 {
    let v: i32 = scroll_set(key, px);
    let vt: i32 = vlist_touch(key);
    let r: i32 = aui_invalidate_layout();
    return v;
}

// 测试辅助：out = [x,y,w,h,count,first,last,offset_px]（像素/整数）。
fn aui_debug_vlist(key: i32, out: ptr) : i32 {
    let i: i32 = vlist_node(key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    *(out + 0) = n.x >> 16;
    *(out + 4) = n.y >> 16;
    *(out + 8) = n.w >> 16;
    *(out + 12) = n.h >> 16;
    *(out + 16) = n.aux;
    *(out + 20) = g_aui_vlist_first_cur;
    *(out + 24) = g_aui_vlist_last_cur;
    let off: i32 = scroll_get(key);                // 已是像素
    *(out + 28) = off;
    let s: i32 = vlist_find(key);
    if (s >= 0) {
        *(out + 20) = g_aui_vlist_first[s];
        *(out + 24) = g_aui_vlist_last[s];
    }
    return 0;
}

// 测试辅助：当前窗口内某行的矩形；out = [x,y,w,h]。
fn aui_debug_vlist_row(key: i32, index: i32, out: ptr) : i32 {
    let i: i32 = vlist_node(key);
    if (i < 0) { return -1; }
    let vn: ptr<AuiNode> = node_at(i);
    let c: i32 = vn.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        if (cn.aux2 == index) {
            *(out + 0) = cn.x >> 16;
            *(out + 4) = cn.y >> 16;
            *(out + 8) = cn.w >> 16;
            *(out + 12) = cn.h >> 16;
            return 0;
        }
        c = cn.next_sibling;
    }
    return -1;
}

// ---- 虚拟表格公共/调试接口（v2.17）----
// 测试辅助：out = [x,y,w,h,rows,cols,first_row,last_row,first_col,
// last_col,off_y,off_x]（像素/整数）。
fn aui_debug_vtable(key: i32, out: ptr) : i32 {
    let i: i32 = vtable_node(key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    *(out + 0) = n.x >> 16;
    *(out + 4) = n.y >> 16;
    *(out + 8) = n.w >> 16;
    *(out + 12) = n.h >> 16;
    *(out + 16) = n.aux;
    *(out + 20) = n.flags;
    let s: i32 = vtable_find(key);
    if (s >= 0) {
        *(out + 24) = g_aui_vtable_first_row[s];
        *(out + 28) = g_aui_vtable_last_row[s];
        *(out + 32) = g_aui_vtable_first_col[s];
        *(out + 36) = g_aui_vtable_last_col[s];
        *(out + 40) = g_aui_vtable_off[s];
        *(out + 44) = g_aui_vtable_offx[s];
    } else {
        *(out + 24) = g_aui_vtable_first_row_cur;
        *(out + 28) = g_aui_vtable_last_row_cur;
        *(out + 32) = g_aui_vtable_first_col_cur;
        *(out + 36) = g_aui_vtable_last_col_cur;
        *(out + 40) = scroll_get(key);
        *(out + 44) = vtable_off_x(key);
    }
    return 0;
}

// 测试辅助：当前窗口内某格的矩形；out = [x,y,w,h]。格子不在窗口内返回 -1。
fn aui_debug_vtable_cell(key: i32, row: i32, col: i32, out: ptr) : i32 {
    let i: i32 = vtable_node(key);
    if (i < 0) { return -1; }
    let vn: ptr<AuiNode> = node_at(i);
    let c: i32 = vn.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        if (cn.aux == row && cn.aux2 == col) {
            *(out + 0) = cn.x >> 16;
            *(out + 4) = cn.y >> 16;
            *(out + 8) = cn.w >> 16;
            *(out + 12) = cn.h >> 16;
            return 0;
        }
        c = cn.next_sibling;
    }
    return -1;
}

// 测试辅助：直接设置横向偏移（像素，自动夹取）；纵向用 aui_debug_scroll_set。
fn aui_debug_vtable_set_x(key: i32, px: i32) : i32 {
    return vtable_set_x(key, px);
}

// ---- 不定高虚拟列表公共/调试接口（v2.10）----
fn vlvar_node(key: i32) : i32 {
    let i: i32 = g_aui_node_count - 1;
    while (i >= 0) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.kind == 58 && n.key == key) { return i; }
        i = i - 1;
    }
    return -1;
}

// 测试辅助：out = [x,y,w,h,count,first,last,offset_px]（像素/整数）。
fn aui_debug_vlist_var(key: i32, out: ptr) : i32 {
    let i: i32 = vlvar_node(key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    *(out + 0) = n.x >> 16;
    *(out + 4) = n.y >> 16;
    *(out + 8) = n.w >> 16;
    *(out + 12) = n.h >> 16;
    *(out + 16) = n.aux;
    *(out + 20) = g_aui_vlist_first_cur;
    *(out + 24) = g_aui_vlist_last_cur;
    let off: i32 = scroll_get(key);
    *(out + 28) = off;
    let s: i32 = vlist_find(key);
    if (s >= 0) {
        *(out + 20) = g_aui_vlist_first[s];
        *(out + 24) = g_aui_vlist_last[s];
    }
    return 0;
}

// 测试辅助：当前窗口内某行的矩形 + 缓存高度；
// out = [x,y,w,h,cached_h_px,measured]（未测量时 cached_h_px 为估计高）。
fn aui_debug_vlist_var_row(key: i32, index: i32, out: ptr) : i32 {
    let i: i32 = vlvar_node(key);
    if (i < 0) { return -1; }
    let vn: ptr<AuiNode> = node_at(i);
    let c: i32 = vn.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        if (cn.aux2 == index) {
            *(out + 0) = cn.x >> 16;
            *(out + 4) = cn.y >> 16;
            *(out + 8) = cn.w >> 16;
            *(out + 12) = cn.h >> 16;
            let s: i32 = vlist_find(key);
            let estpx: i32 = vn.aux2 >> 16;
            if (estpx < 1) { estpx = 1; }
            let ch: i32 = estpx;
            let ms: i32 = 0;
            if (s >= 0 && index >= 0 && index < AUI_VLVAR_HCAP) {
                let cv: i32 = g_aui_vlvar_h[s * AUI_VLVAR_HCAP + index];
                if (cv > 0) { ch = cv; ms = 1; }
            }
            *(out + 16) = ch;
            *(out + 20) = ms;
            return 0;
        }
        c = cn.next_sibling;
    }
    return -1;
}

// 测试辅助：out = [total_px,measured_count,write_count,cap]。
// ---- 可调分栏调试接口（v2.12）----
fn split_node(key: i32) : i32 {
    let i: i32 = g_aui_node_count - 1;
    while (i >= 0) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.kind == 61 && n.key == key) { return i; }
        i = i - 1;
    }
    return -1;
}

// 测试辅助：out = [x,y,w,h,horizontal,ratio,min_dp,div_px]
// （div_px 是分隔条中心沿主轴的绝对像素坐标；无分隔条时为 -1）。
fn aui_debug_split(key: i32, out: ptr) : i32 {
    let i: i32 = split_node(key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    *(out + 0) = n.x >> 16;
    *(out + 4) = n.y >> 16;
    *(out + 8) = n.w >> 16;
    *(out + 12) = n.h >> 16;
    *(out + 16) = n.aux;
    let s: i32 = split_find(key);
    let r: i32 = n.aux2;
    let m: i32 = 48;
    if (s >= 0) {
        r = g_aui_split_ratio[s];
        m = g_aui_split_min[s];
    }
    *(out + 20) = r;
    *(out + 24) = m;
    *(out + 28) = split_div_center(n);
    return 0;
}

// 测试辅助：某窗格的矩形；out = [x,y,w,h]。
fn aui_debug_split_pane(key: i32, index: i32, out: ptr) : i32 {
    let i: i32 = split_node(key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    let c: i32 = n.first_child;
    if (index == 1) {
        if (c < 0) { return -1; }
        c = node_at(c).next_sibling;
    } else if (index != 0) {
        return -1;
    }
    if (c < 0) { return -1; }
    let cn: ptr<AuiNode> = node_at(c);
    *(out + 0) = cn.x >> 16;
    *(out + 4) = cn.y >> 16;
    *(out + 8) = cn.w >> 16;
    *(out + 12) = cn.h >> 16;
    return 0;
}
fn aui_debug_vlist_var_stats(key: i32, out: ptr) : i32 {
    let s: i32 = vlist_find(key);
    if (s < 0) { return -1; }
    let count: i32 = g_aui_vlvar_count[s];
    let estpx: i32 = g_aui_vlvar_est[s];
    if (estpx < 1) { estpx = 1; }
    *(out + 0) = vlvar_total(s, count, estpx);
    *(out + 4) = vlvar_measured(s, count);
    *(out + 8) = g_aui_vlvar_writes[s];
    *(out + 12) = AUI_VLVAR_HCAP;
    return 0;
}

// 测试辅助：角标矩形；out = [x,y,w,h,visible]。
fn aui_debug_badge(key: i32, out: ptr) : i32 {
    let i: i32 = g_aui_node_count - 1;
    while (i >= 0) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.kind == 60 && n.key == key) {
            *(out + 0) = n.x >> 16;
            *(out + 4) = n.y >> 16;
            *(out + 8) = n.w >> 16;
            *(out + 12) = n.h >> 16;
            let vis: i32 = 1;
            if (n.aux2 == 1 && n.gap <= 0) { vis = 0; }
            *(out + 16) = vis;
            return 0;
        }
        i = i - 1;
    }
    return -1;
}

