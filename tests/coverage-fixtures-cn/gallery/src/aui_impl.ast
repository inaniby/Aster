}

// v1.35：菜单几何/状态。out = [x,y,w,h,key,reason,item_key,off,maxoff,items]
// （像素；没有菜单时返回 -1）。reason/item_key 是最近一次关闭的结果。
fn aui_debug_menu(out: ptr) : i32 {
    if (g_aui_menu < 0) { return -1; }
    let p: ptr<i32> = out;
    p[0] = g_aui_menu_px >> 16;
    p[1] = g_aui_menu_py >> 16;
    p[2] = g_aui_menu_pw >> 16;
    p[3] = g_aui_menu_ph >> 16;
    p[4] = g_aui_menu_key;
    p[5] = g_aui_menu_reason;
    p[6] = g_aui_menu_item_key;
    p[7] = g_aui_menu_off >> 16;
    p[8] = g_aui_menu_max >> 16;
    p[9] = g_aui_menu_items;
    return 0;
}

// v1.35：菜单手势中间态（仅测试）。out = [down, press, drag, dx, dy]。
fn aui_debug_menu_touch(out: ptr) : i32 {
    let p: ptr<i32> = out;
    p[0] = g_aui_menu_down;
    p[1] = g_aui_menu_press;
    p[2] = g_aui_menu_drag;
    p[3] = g_aui_menu_dx;
    p[4] = g_aui_menu_dy;
    return 0;
}

// v1.35：菜单条目。out = [x,y,w,h,index,flags,checked,disabled]。
fn aui_debug_menu_item(key: i32, out: ptr) : i32 {
    let i: i32 = 0;
    while (i < g_aui_node_count) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.kind == 35 && n.key == key) {
            let p: ptr<i32> = out;
            p[0] = n.x >> 16;
            p[1] = n.y >> 16;
            p[2] = n.w >> 16;
            p[3] = n.h >> 16;
            p[4] = n.aux2;
            p[5] = n.flags;
            p[6] = 0;
            if ((n.flags & AUI_MENU_CHECKED) != 0) { p[6] = 1; }
            p[7] = 0;
            if ((n.flags & AUI_MENU_DISABLED) != 0) { p[7] = 1; }
            return 0;
        }
        i = i + 1;
    }
    return -1;
}

// v1.38：底部弹出层几何。out = [x,y,w,h,drag_px,flags]（像素；没有时返回 -1）。
// drag_px 是当前下拉位移，flags bit0 = 隐藏拖拽手柄。
fn aui_debug_sheet(out: ptr) : i32 {
    if (g_aui_sheet < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(g_aui_sheet_card);
    let p: ptr<i32> = out;
    p[0] = n.x >> 16;
    p[1] = n.y >> 16;
    p[2] = n.w >> 16;
    p[3] = n.h >> 16;
    p[4] = 0;
    if (g_aui_sheet_drag > 0) { p[4] = g_aui_sheet_drag >> 16; }
    p[5] = n.flags;
    return 0;
}

// v1.39：锚定浮层。out = [x,y,w,h,方向,对齐,关闭原因]（屏幕像素）；
// 关闭时首元素为 -1，原因保留到下一次打开。
fn aui_debug_popup(out: ptr) : i32 {
    let p: ptr<i32> = out;
    if (g_aui_popup < 0) {
        p[0] = -1;
        p[1] = 0;
        p[2] = 0;
        p[3] = 0;
        p[4] = g_aui_popup_side;
        p[5] = g_aui_popup_align;
        p[6] = g_aui_popup_reason;
        return -1;
    }
    let n: ptr<AuiNode> = node_at(g_aui_popup);
    p[0] = n.x >> 16;
    p[1] = n.y >> 16;
    p[2] = n.w >> 16;
    p[3] = n.h >> 16;
    p[4] = g_aui_popup_side;
    p[5] = g_aui_popup_align;
    p[6] = g_aui_popup_reason;
    return 0;
}

