// text.ast -- AsterUI M1: bitmap font text measurement and glyph access.
//
// Origin of the font bytes: asterui/assets/font8x8.bin is a copy of
// examples/demo_assets/font8x8.bin (95 glyphs x 8 bytes, ASCII 32..126,
// bit 7 = leftmost pixel), copied so the framework does not reach outside
// its own tree. The bytes are embedded once, in assets/embeds.ast
// (M2: the framework's single @embed owner); no other file embeds them.
//
// M1 text model: fixed 8x16 cells per code point. Layout still measures a
// Text node as text_len * 8 wide and 16 high in bytes (M0); this file
// counts code points, not bytes, so ui_text_width is correct for UTF-8
// text. The embedded font holds 8 rows per glyph; the rasterizer draws
// each glyph row twice so the glyph fills the 16 px cell height.
// Non-ASCII code points (and invalid UTF-8 bytes) have no glyph in this
// font: they render as a hollow 8x16 placeholder box, never as a faked
// CJK glyph. M1.2c: ui_text_width's scale is the integer font_scale
// and its result is in dp -- callers convert to px with ui_dp, the
// same single conversion layout applies; the rasterizer takes the
// cell size from the TEXT command instead (see render/raster.ast).
//
// M3.2: CJK fallback atlas. assets/font_cjk16.auf holds 56 hand-drawn
// 16x16 1bpp glyphs (the 54 distinct CJK characters of strings_zh.txt
// plus fullwidth U+FF1A and U+FF1F; see asterui/M3-NOTES.md for the
// licence verdict -- zero third-party font IP, zero licence files --
// and the coverage list). Container format (.auf, 32-byte header,
// 16-byte records, 1bpp rows MSB = leftmost) is reused as a format
// only; the bitmaps are ours. A wide code point measures 16dp (two
// ASCII cells); the rasterizer draws the 16x16 glyph into a cell
// twice the ASCII cell width. A code point in NEITHER atlas draws the
// placeholder box and increments the missing-glyph counter
// (ui_cjk_missing()), so a gap is visible, never silent. The atlas
// is looked up through a 32-entry ring cache (see ui_cjk_find).

include "../aster_std.ast";
include "../../assets/embeds.ast";

let g_font8x8: ptr = 0;
// The font pointer is NOT initialized at the top level: a
// `let g_font8x8: ptr = @embed(...)` is a run-time global initializer,
// and the linker (audit A-22) requires those to live in the object that
// holds _start -- a library module must not carry one. The pointer is
// zero-initialized (.bss) and ui_font_row sets it from @embed on first
// use, so text.o links into any program.
// The @embed itself lives in assets/embeds.ast (the framework's
// single @embed owner -- see that file); ui_font_row calls the
// ui_embed_font accessor instead of embedding here.

// M3.2 CJK atlas state. g_cjk_auf is 0 until first use; g_cjk_ok is 1
// only when the header validated (magic "AUF1", version 1, flags 0 =
// 1bpp, pixel_size 16, table + bitmaps inside the blob). A bad blob
// disables CJK silently at the atlas level -- every non-ASCII code
// point then takes the placeholder path and the missing counter below
// still records it, so the failure is visible in the counter, not in
// a crash. g_cjk_enabled is a test hook (default 1): the pixel test
// turns it off to compare a glyph against its placeholder rendering.
let g_cjk_auf: ptr = 0;
let g_cjk_ok: i32 = 0;
let g_cjk_enabled: i32 = 1;
let g_cjk_count: i32 = 0;
let g_cjk_table: i32 = 0;
let g_cjk_bitmap: i32 = 0;

// M3.2 glyph cache: 32 entries, round-robin replacement. An entry
// maps a code point to its atlas record offset (relative to the atlas
// base). Lookup order is cache scan, then binary search over the atlas
// table (56 records, at most 6 steps). When all 32 slots are valid the
// oldest slot is overwritten and the eviction is counted -- never
// silent unbounded growth, never a silent drop. Counters are exposed
// for the test: hits, misses (cache misses that went to binary search),
// evictions, live entries (<= 32), missing-glyph draws. The cache key
// is (code point, size 16): with one atlas size the size is fixed at
// 16 and recorded here; a second size would extend the key.
let g_cjk_cache_cp: i32[32] = 0;
let g_cjk_cache_rec: i32[32] = 0;
let g_cjk_cache_valid: i32[32] = 0;
let g_cjk_next: i32 = 0;
let g_cjk_hits: i32 = 0;
let g_cjk_misses: i32 = 0;
let g_cjk_evictions: i32 = 0;
let g_cjk_live: i32 = 0;
let g_cjk_missing: i32 = 0;

fn ui_cjk_cache_hits() -> i32 {
    return g_cjk_hits;
}

fn ui_cjk_cache_misses() -> i32 {
    return g_cjk_misses;
}

fn ui_cjk_cache_evictions() -> i32 {
    return g_cjk_evictions;
}

fn ui_cjk_cache_live() -> i32 {
    return g_cjk_live;
}

// Missing-glyph draws: code points that fell back to the placeholder
// box because neither atlas has them. Incremented by the rasterizer,
// never by measurement (measuring a missing code point is not a draw).
fn ui_cjk_missing() -> i32 {
    return g_cjk_missing;
}

fn ui_cjk_note_missing() -> i32 {
    g_cjk_missing = g_cjk_missing + 1;
    return 0;
}

fn ui_cjk_set_enabled(v: i32) -> i32 {
    g_cjk_enabled = v;
    return g_cjk_enabled;
}

// Little-endian u16 / u32 assembled from load_u8 bytes only (the
// stdlib has no load_u16; `*ptr` loads are not used anywhere in this
// tree). The u32 form covers every valid Unicode code point (b3 is
// always 0 below U+110000) and every offset in a blob under the
// 16 MiB @embed limit.
fn ui_cjk_u16(base: ptr, off: i32) -> i32 {
    return load_u8(base + off) + load_u8(base + off + 1) * 256;
}

fn ui_cjk_u32(base: ptr, off: i32) -> i32 {
    return load_u8(base + off) + load_u8(base + off + 1) * 256 + load_u8(base + off + 2) * 65536 + load_u8(base + off + 3) * 16777216;
}

// Validate the atlas header on first use. Answers 1 when the atlas is
// usable, 0 otherwise.
fn ui_cjk_init() -> i32 {
    if (g_cjk_auf != 0) {
        return g_cjk_ok;
    } else {
    }
    g_cjk_auf = ui_embed_font_cjk16();
    if (g_cjk_auf == 0) {
        return 0;
    } else {
    }
    if (load_u8(g_cjk_auf + 0) != 65) {
        return 0;
    } else {
    }
    if (load_u8(g_cjk_auf + 1) != 85) {
        return 0;
    } else {
    }
    if (load_u8(g_cjk_auf + 2) != 70) {
        return 0;
    } else {
    }
    if (load_u8(g_cjk_auf + 3) != 49) {
        return 0;
    } else {
    }
    if (ui_cjk_u16(g_cjk_auf, 4) != 1) {
        return 0;
    } else {
    }
    if (ui_cjk_u16(g_cjk_auf, 6) != 0) {
        return 0;
    } else {
    }
    if (ui_cjk_u16(g_cjk_auf, 10) != 16) {
        return 0;
    } else {
    }
    let cnt: i32 = ui_cjk_u16(g_cjk_auf, 8);
    let tab: i32 = ui_cjk_u32(g_cjk_auf, 16);
    let bm: i32 = ui_cjk_u32(g_cjk_auf, 20);
    let bsz: i32 = ui_cjk_u32(g_cjk_auf, 24);
    if (cnt <= 0) {
        return 0;
    } else {
    }
    if (tab < 32) {
        return 0;
    } else {
    }
    if (bm < tab + cnt * 16) {
        return 0;
    } else {
    }
    if (bm + bsz > g_embed_font_cjk16_len) {
        return 0;
    } else {
    }
    g_cjk_count = cnt;
    g_cjk_table = tab;
    g_cjk_bitmap = bm;
    g_cjk_ok = 1;
    return 1;
}

// Bytes consumed by the UTF-8 sequence whose lead byte is b0.
fn ui_utf8_advance(b0: i32) -> i32 {
    if (b0 < 128) {
        return 1;
    } else {
        if (b0 < 224) {
            return 2;
        } else {
            if (b0 < 240) {
                return 3;
            } else {
                return 4;
            }
        }
    }
}

// 1 when code point cp is full-width (measures two ASCII cells): CJK
// Unified Ideographs and neighbours (0x2E80..0x9FFF), CJK Compatibility
// Ideographs (0xF900..0xFAFF), fullwidth forms (0xFF00..0xFF60), and
// the plane-2 ideographs (0x20000..0x2FA1F). ASCII and Latin-1 (e.g.
// U+00E9) are not wide.
fn ui_text_is_wide(cp: i32) -> i32 {
    if (cp >= 11904) {
        if (cp <= 40959) {
            return 1;
        } else {
        }
    } else {
    }
    if (cp >= 63744) {
        if (cp <= 64255) {
            return 1;
        } else {
        }
    } else {
    }
    if (cp >= 65280) {
        if (cp <= 65376) {
            return 1;
        } else {
        }
    } else {
    }
    if (cp >= 131072) {
        if (cp <= 195103) {
            return 1;
        } else {
        }
    } else {
    }
    return 0;
}

// Binary search over the atlas table (16-byte records, code points
// ascending) plus the 32-entry ring cache. Answers the record offset
// relative to the atlas base, or -1. A disabled atlas (test hook) or
// an unvalidated one answers -1 without touching the blob.
fn ui_cjk_find(cp: i32) -> i32 {
    if (g_cjk_enabled == 0) {
        return -1;
    } else {
    }
    if (ui_cjk_init() == 0) {
        return -1;
    } else {
    }
    let i: i32 = 0;
    while (i < 32) {
        if (g_cjk_cache_valid[i] == 1) {
            if (g_cjk_cache_cp[i] == cp) {
                g_cjk_hits = g_cjk_hits + 1;
                return g_cjk_cache_rec[i];
            } else {
            }
        } else {
        }
        i = i + 1;
    }
    g_cjk_misses = g_cjk_misses + 1;
    let lo: i32 = 0;
    let hi: i32 = g_cjk_count - 1;
    while (lo <= hi) {
        let mid: i32 = (lo + hi) / 2;
        let off: i32 = g_cjk_table + mid * 16;
        let c: i32 = ui_cjk_u32(g_cjk_auf, off);
        if (c == cp) {
            let slot: i32 = g_cjk_next;
            if (g_cjk_cache_valid[slot] == 1) {
                g_cjk_evictions = g_cjk_evictions + 1;
            } else {
                g_cjk_live = g_cjk_live + 1;
            }
            g_cjk_cache_cp[slot] = cp;
            g_cjk_cache_rec[slot] = off;
            g_cjk_cache_valid[slot] = 1;
            g_cjk_next = g_cjk_next + 1;
            if (g_cjk_next >= 32) {
                g_cjk_next = 0;
            } else {
            }
            return off;
        } else {
            if (c < cp) {
                lo = mid + 1;
            } else {
                hi = mid - 1;
            }
        }
    }
    return -1;
}

// 1 when code point cp has a glyph in either atlas (ASCII 32..126,
// or a CJK code point found in the 16x16 atlas), else 0. M3.2: a
// non-ASCII code point that IS in the CJK atlas answers 1 here --
// callers that need the ASCII-only test must check the range, not
// this function (ui_font_row does; the rasterizer branches on the
// range first, then on ui_cjk_find).
fn ui_text_has_glyph(cp: i32) -> i32 {
    if (cp < 32) {
        return 0;
    } else {
        if (cp > 126) {
            if (ui_cjk_find(cp) >= 0) {
                return 1;
            } else {
                return 0;
            }
        } else {
            return 1;
        }
    }
}

// One row (0..7) of the ASCII glyph for code point cp, or 0 when cp
// has no ASCII glyph. A row byte's bit 7 is the leftmost pixel. First
// use sets the font pointer from @embed (see the note at g_font8x8).
// M3.2: the range guard is explicit (32..126), not via
// ui_text_has_glyph -- a CJK code point HAS a glyph (in the CJK
// atlas) but must never index the 8x8 font, which only holds 95
// glyphs; reading it at (cp - 32) * 8 would run past the blob.
fn ui_font_row(cp: i32, row: i32) -> i32 {
    if (cp < 32) {
        return 0;
    } else {
    }
    if (cp > 126) {
        return 0;
    } else {
    }
    if (row < 0) {
        return 0;
    } else {
    }
    if (row > 7) {
        return 0;
    } else {
    }
    if (g_font8x8 == 0) {
        g_font8x8 = ui_embed_font();
    } else {
    }
    return load_u8(g_font8x8 + (cp - 32) * 8 + row);
}

// One row (0..15) of the CJK glyph for code point cp, as a 16-bit
// value whose bit 15 is the leftmost pixel, or 0 when cp has no CJK
// glyph. The bitmap is 16 rows x 2 bytes little-endian per glyph.
fn ui_cjk_row(cp: i32, row: i32) -> i32 {
    if (row < 0) {
        return 0;
    } else {
    }
    if (row > 15) {
        return 0;
    } else {
    }
    let rec: i32 = ui_cjk_find(cp);
    if (rec < 0) {
        return 0;
    } else {
    }
    let boff: i32 = ui_cjk_u32(g_cjk_auf, rec + 12);
    let base: i32 = g_cjk_bitmap + boff + row * 2;
    return ui_cjk_u16(g_cjk_auf, base);
}

// "Is bit col set" for a glyph row byte: bit 7 is the leftmost pixel.
// Same division math as examples/icon_text_demo.ast (glyph_bit).
fn ui_glyph_bit(byte: i32, col: i32) -> i32 {
    let p: i32 = 128;
    let k: i32 = 0;
    while (k < col) {
        p = p / 2;
        k = k + 1;
    }
    let t: i32 = byte / p;
    return t - (t / 2) * 2;
}

// "Is bit col set" for a 16-bit CJK glyph row: bit 15 is the leftmost
// pixel. Same division math as ui_glyph_bit, starting at 32768.
fn ui_glyph_bit16(row: i32, col: i32) -> i32 {
    let p: i32 = 32768;
    let k: i32 = 0;
    while (k < col) {
        p = p / 2;
        k = k + 1;
    }
    let t: i32 = row / p;
    return t - (t / 2) * 2;
}

// Width in dp of the first tlen bytes of text at the given scale,
// counting code points (utf8_decode), not bytes. ASCII and narrow
// code points are 8dp per code point; wide code points (CJK,
// fullwidth forms) are 16dp. An invalid byte counts as one narrow
// placeholder cell and advances one byte. M3.2: the old form counted
// every code point as 8dp, which under-measured zh text (and the old
// layout callers multiplied the BYTE length by 8, which over-measured
// it threefold); both are fixed by summing per code point here.
fn ui_text_width(text: ptr, tlen: i32, scale: i32) -> i32 {
    let n: i32 = 0;
    let at: i32 = 0;
    while (at < tlen) {
        let cp: i32 = utf8_decode(text, at);
        let b0: i32 = load_u8(text + at);
        if (cp < 0) {
            n = n + 8;
            at = at + 1;
        } else {
            if (ui_text_is_wide(cp) == 1) {
                n = n + 16;
            } else {
                n = n + 8;
            }
            at = at + ui_utf8_advance(b0);
        }
    }
    return n * scale;
}
