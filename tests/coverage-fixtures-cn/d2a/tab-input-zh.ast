// tab-input-zh.ast — D-2a 语法草稿，不可编译（需编译器工作单落地）。
// 取材：新线 Gallery 输入页（116 行）；任务书会计目标 99 行，实测见 D2A 报告。
// 130 哨兵改走 键(语言)；事件种按骨架轮框架事件集（变化）；体尾语句见报告。
外部("aui_scroll") 方法 滚动(键: 整数): 整数
外部("aui_weight") 方法 权重(宽: 整数): 整数
外部("aui_column") 方法 列(键: 整数): 整数
外部("aui_row") 方法 行(键: 整数): 整数
外部("aui_pad") 方法 边距(尺寸: 整数): 整数
外部("aui_gap") 方法 间距(尺寸: 整数): 整数
外部("aui_label") 方法 标签(键: 整数, 文本: 指针): 整数
外部("aui_text_field") 方法 文本框(键: 整数, 提示: 指针): 整数
外部("aui_text_value") 方法 文本取值(键: 整数): 指针
外部("aui_focus_get") 方法 焦点取值(): 整数
外部("aui_button") 方法 按钮(键: 整数, 文本: 指针, 回调: 方法(指针): 整数, 用户: 指针): 整数
外部("aui_select") 方法 下拉选择(键: 整数, 当前: 整数, 打开: 整数, 占位: 指针, 回调: 方法(指针): 整数, 用户: 指针): 整数
外部("aui_option") 方法 选项(键: 整数, 文本: 指针): 整数
外部("aui_select_value") 方法 选择取值(键: 整数): 整数
外部("aui_select_reason") 方法 选择原因(): 整数
外部("aui_switch") 方法 开关(键: 整数, 开: 整数, 回调: 方法(指针): 整数, 用户: 指针): 整数
外部("aui_checkbox") 方法 复选框(键: 整数, 文本: 指针, 选中: 整数, 回调: 方法(指针): 整数, 用户: 指针): 整数
外部("aui_slider") 方法 滑杆(键: 整数, 值: 整数, 步长: 整数, 回调: 方法(指针): 整数, 用户: 指针): 整数
外部("aui_slider_value") 方法 滑杆取值(键: 整数): 整数
外部("aui_progress") 方法 进度条(键: 整数, 值: 整数): 整数
外部("aui_keyboard") 方法 键盘(目标键: 整数): 整数
外部("aui_text_clear") 方法 清空文本(键: 整数): 整数
外部("aui_focus") 方法 聚焦(键: 整数): 整数
外部("aui_invalidate") 方法 刷新(): 整数
外部("aui_end") 方法 结束节点(): 整数
事件 清除:被单击() {
    清空文本(键(输入框))
    刷新()
}
事件 聚焦:被单击() {
    聚焦(键(输入框))
    刷新()
}
事件 提醒开关:变化() {
    g_app.提醒 = 1 - g_app.提醒
    刷新()
}
事件 推广:变化() {
    g_app.推广 = 1 - g_app.推广
    刷新()
}
事件 音量:变化() {
    g_app.滑杆 = 滑杆取值(键(音量))
    刷新()
}
事件 语言:变化() {
    变量 原因: 整数 = 选择原因()
    如果 原因 == 0
        g_app.选择打开 = 键(语言)
    否则如果 原因 == 1
        变量 v: 整数 = 选择取值(键(语言))
        如果 v >= 0
            g_app.语言 = v
        结束 如果
        g_app.选择打开 = 0
    否则
        g_app.选择打开 = 0
    结束 如果
    刷新()
}
布局 page_input(s: 指针<应用>, 用户: 指针): 视图 {
    滚动 主滚, 权重(1) {
        列 主列, 内边距(20), 间隙(12) {
            标签 标题, 指针("文本框 + 下拉")
            文本框 输入框, 指针("点按输入…")
            如果 焦点取值() == 0
                标签 回显, 指针("实时值")
                行 回显行, 内边距(12) {
                    标签 回显值, 文本取值(键(输入框)), 权重(1)
                }
            结束 如果
            行 按钮行, 间隙(8) {
                按钮 清除, 指针("清除")
                按钮 聚焦, 指针("聚焦")
            }
            标签 语言标题, 指针("语言")
            变量 打开: 整数 = 0
            如果 s.选择打开 == 键(语言)
                打开 = 1
            结束 如果
            下拉选择 语言, s.语言, 打开, 指针("选择语言") {
                选项 英语, 指针("英语")
                选项 德语, 指针("德语")
                选项 中文, 指针("中文")
            }
            行 提醒行, 间隙(8) {
                标签 提醒, 指针("提醒"), 权重(1)
                开关 提醒开关, s.提醒
            }
            复选框 推广, 指针("推广"), s.推广
            标签 音量标题, 指针("音量")
            滑杆 音量, s.滑杆, 10
            进度条 进度, s.滑杆
        }
    }
    如果 焦点取值() != 0
        键盘(键(输入框))
    结束 如果
}
