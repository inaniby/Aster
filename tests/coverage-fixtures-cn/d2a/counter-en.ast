// counter-en.ast — D-2a syntax draft, NOT compilable (needs the compiler work order to land).
// Source: new-line Gallery Counter tab (68 lines); work-order target 54 lines, measured in the D2A report.
// Node name is identity (name -> key = FNV-1a(declName.nodeName)); event blocks join by name.
// Body rule: event blocks use globals only (g_app), never capture build locals.
// Note: the if/else branches shared key 108; under name-uniqueness they are
// named Zero / NonZero, so the key forks (labels are stateless, no behavior change; see work order W-O4).

extern fn aui_column(key: i32) : i32;
extern fn aui_row(key: i32) : i32;
extern fn aui_pad(dp: i32) : i32;
extern fn aui_gap(dp: i32) : i32;
extern fn aui_label(key: i32, text: ptr) : i32;
extern fn aui_text_i32(key: i32, value: i32) : i32;
extern fn aui_button(key: i32, text: ptr, cb: fn(ptr): i32, user: ptr) : i32;
extern fn aui_state_set(key: i32, value: i32) : i32;
extern fn aui_invalidate() : i32;
extern fn aui_end() : i32;

// on_add: +1.
event Inc:tap() {
    g_app.count = g_app.count + 1;
    aui_state_set(1, g_app.count);
    aui_invalidate();
}

// on_dec: -1.
event Dec:tap() {
    g_app.count = g_app.count - 1;
    aui_state_set(1, g_app.count);
    aui_invalidate();
}

// on_reset: back to zero.
event Reset:tap() {
    g_app.count = 0;
    aui_state_set(1, 0);
    aui_invalidate();
}

// page_counter: the tab body. The row holds - / value / +; Reset sits
// below it, and the status line reads the live count, not a copy.
layout page_counter(s: ptr<App>, user: ptr) : View {
    Column MainCol, Padding(20), Gap(16) {
        Label Title, ptr("Counter")
        Row ButtonRow, Gap(12) {
            Button Dec, ptr("-")
            Number Count, s.count
            Button Inc, ptr("+")
        }
        Button Reset, ptr("Reset")
        Label Hint, ptr("Tap + to count up, - to count down.")
        if (s.count == 0) {
            Label Zero, ptr("Count is zero.")
        } else {
            Label NonZero, ptr("Count is non-zero.")
        }
    }
}
