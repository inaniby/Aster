事件 清除:被单击() {
    清空文本(键(输入框))
    刷新()
}
事件 聚焦:被单击() {
    聚焦(键(输入框))
    刷新()
}
事件 提醒开关:变化() {
    g_app.提醒 = 1 - g_app.提醒
    刷新()
}
事件 推广:变化() {
    g_app.推广 = 1 - g_app.推广
    刷新()
}
事件 音量:变化() {
    g_app.滑杆 = 滑杆取值(键(音量))
    刷新()
}
事件 语言:变化() {
    变量 原因: 整数 = 选择原因()
    如果 原因 == 0
        g_app.选择打开 = 键(语言)
    否则如果 原因 == 1
        变量 v: 整数 = 选择取值(键(语言))
        如果 v >= 0
            g_app.语言 = v
        结束 如果
        g_app.选择打开 = 0
    否则
        g_app.选择打开 = 0
    结束 如果
    刷新()
}
布局 page_input(s: 指针<应用>, 用户: 指针): 视图 {
    滚动 主滚, 权重(1) {
        列 主列, 内边距(20), 间隙(12) {
            标签 标题, 指针("文本框 + 下拉")
            文本框 输入框, 指针("点按输入…")
            如果 焦点取值() == 0
                标签 回显, 指针("实时值")
                行 回显行, 内边距(12) {
                    标签 回显值, 文本取值(键(输入框)), 权重(1)
                }
            结束 如果
            行 按钮行, 间隙(8) {
                按钮 清除, 指针("清除")
                按钮 聚焦, 指针("聚焦")
            }
            标签 语言标题, 指针("语言")
            变量 打开: 整数 = 0
            如果 s.选择打开 == 键(语言)
                打开 = 1
            结束 如果
            下拉选择 语言, s.语言, 打开, 指针("选择语言") {
                选项 英语, 指针("英语")
                选项 德语, 指针("德语")
                选项 中文, 指针("中文")
            }
            行 提醒行, 间隙(8) {
                标签 提醒, 指针("提醒"), 权重(1)
                开关 提醒开关, s.提醒
            }
            复选框 推广, 指针("推广"), s.推广
            标签 音量标题, 指针("音量")
            滑杆 音量, s.滑杆, 10
            进度条 进度, s.滑杆
        }
    }
    如果 焦点取值() != 0
        键盘(键(输入框))
    结束 如果
}
