// D-01 — compact frame > 4095 + a stack-passed argument (frameBytes == 4096).
// Build:  aster build-elf --compact-frames D01_compact_stack_arg.ast -o x.elf
// Expect: 8 (j=9 - a=1).  Actual on v0.23.77-dev: 0 (silent miscompile).
// With plain build-elf (no --compact-frames): 8.
fn g(n:i32)->i32 { return n; }
fn f(a:i32,b:i32,c:i32,d:i32,e:i32,g:i32,h:i32,i:i32,j:i32)->i32 {
    let pad: i64[467] = 0;
    let t: i32 = g(g(0));
    return j - a + t;
}
fn main()->i32 { return f(1,2,3,4,5,6,7,8,9); }
