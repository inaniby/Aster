// D-02 — an f64 local outside slot 0 shares its frame with eight later slots.
// loadVarT/storeVarT encode F64 with imm12 = slot*8 (LDR/STR D scale by 8),
// so slot 1 lands at byte 64 instead of byte 8 and slot 8 overwrites it.
// Expect: 0 (x is still 2.5).  Actual on v0.23.77-dev: 1.
fn main()->i32 {
    let lead:i32 = 1;
    let x:f64 = 2.5;
    let p1:i32=0; let p2:i32=0; let p3:i32=0; let p4:i32=0;
    let p5:i32=0; let p6:i32=0; let p7:i32=0;
    p7 = 99;
    if (x == 2.5) { return 0; }
    return 1;
}
