// D-01 control — compact frame stays below 4096, so the imm12 patch is legal.
// Same 9 arguments, pad=100: expect 8, actual 8.
fn g(n:i32)->i32 { return n; }
fn f(a:i32,b:i32,c:i32,d:i32,e:i32,g:i32,h:i32,i:i32,j:i32)->i32 {
    let pad: i64[100] = 0;
    let t: i32 = g(g(0));
    return j - a + t;
}
fn main()->i32 { return f(1,2,3,4,5,6,7,8,9); }
