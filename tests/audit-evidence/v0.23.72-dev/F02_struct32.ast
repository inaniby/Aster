// F-02 reaches emitElemIndex too: a 32-byte struct element makes
// elemShiftOf() return 5 -> the same reserved UXTW #5 -> SIGILL.
struct E { a: i32, b: i32, c: i32, d: i32, e: i32, f: i32, g: i32, h: i32 }
fn main()->i32 {
    let a: E[2] = E{1,2,3,4,5,6,7,8};
    a[1].a = 42;
    if (a[0].a == 1) { return 0; }
    return 1;
}
