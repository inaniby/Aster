// tests/codegen-fixtures/for.ast — `for` through the stage: the three clauses,
// a `continue` that lands on the step (so the loop still advances), an empty
// init clause, and a `for` nested in a `while`.
let out: u8[8] = 0;

fn main() -> i32 {
    let acc: i32 = 0;
    for (let i: i32 = 0; i < 4; i = i + 1) {
        if (i == 2) { continue; }      // skips the body, still runs the step
        acc = acc + i;                 // 0 + 1 + 3
    }
    let j: i32 = 0;
    for (; j < 3; j = j + 1) {         // empty init clause
        acc = acc + 10;
    }
    let n: i32 = 0;
    while (n < 2) {
        for (let k: i32 = 0; k < 2; k = k + 1) { acc = acc + 100; }
        n = n + 1;
    }
    store_u8(out, 48 + acc / 100);
    store_u8(out + 1, 48 + acc / 10 % 10);
    store_u8(out + 2, 48 + acc % 10);
    store_u8(out + 3, 10);
    write(1, out, 4);
    return 0;
}
