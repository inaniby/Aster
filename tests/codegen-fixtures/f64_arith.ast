let o: u8[16] = 0;

fn main() -> i32 {
    let a: f64 = 1.5;
    let b: f64 = 2.5;
    let c: f64 = a + b;              // 4.0
    if (c > 3.9 && c < 4.1) { store_u8(o, 49); } else { store_u8(o, 48); }
    let d: f64 = b - a;              // 1.0
    if (d > 0.9 && d < 1.1) { store_u8(o + 1, 49); } else { store_u8(o + 1, 48); }
    let e: f64 = a * b;              // 3.75
    if (e > 3.74 && e < 3.76) { store_u8(o + 2, 49); } else { store_u8(o + 2, 48); }
    let f: f64 = b / a;              // 1.6666..
    if (f > 1.66 && f < 1.67) { store_u8(o + 3, 49); } else { store_u8(o + 3, 48); }
    store_u8(o + 4, 10);
    write(1, o, 5);
    return 0;
}
