struct R { a: i32, b: i32, c: i32, d: i32, e: i32 }

let o: u8[8] = 0;

fn total(r: R) -> i32 {
    return r.a + r.b + r.c + r.d + r.e;
}

fn main() -> i32 {
    let r: R = R { 1, 2, 3, 4, 5 };
    let n: i32 = total(r);
    store_u8(o, 48 + n / 10);
    store_u8(o + 1, 48 + n % 10);
    store_u8(o + 2, 10);
    write(1, o, 3);
    return 0;
}
