let o: u8[8] = 0;

fn main() -> i32 {
    let a: char = 'a';
    let b: char = 'z';
    if (a < b) { store_u8(o, 49); } else { store_u8(o, 48); }
    let nl: char = '\n';
    if (nl == 10) { store_u8(o + 1, 49); } else { store_u8(o + 1, 48); }
    store_u8(o + 2, 10);
    write(1, o, 3);
    return 0;
}
