/aster
/build/
/tmp-*
# v0.23.64-dev: tests/ci.sh writes aster.tmp.$$ and renames it; an interrupted
# run leaves the temporary behind, and /aster above does not match it.
*.tmp.*
*.o
*.so
*.elf
*.apk

# v0.23.71-dev: these four are committed reference fixtures, not build
# products. The generic *.o / *.so rules above would otherwise hide them and
# a fresh checkout would have no frozen symtab snapshot to compare against.
!tests/baseline/symtab-frozen/*.o
!tests/baseline/symtab-frozen/*.so

# Coredumps / debug artifacts
core
core.*
*.core
qemu_deep.bin_*

# Logs
build.log
*.log
/ci-artifacts/

# Python caches
__pycache__/
*.pyc

# Local keystore (RSA private key) — never commit
/.aster/
