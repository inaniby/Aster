// Byte-wise equality of n bytes at id against the
// NUL-terminated literal lit; the terminator must sit
// exactly at n, so unequal lengths answer 0 as well.
fn ident_is(lit: ptr<u8>, id: ptr<u8>, n: i32) -> i32 {
    let i: i32 = 0;
    while (i < n) {
        if (load_u8(lit + i) != load_u8(id + i)) { return 0; }
        i = i + 1;
    }
    if (load_u8(lit + n) != 0) { return 0; }
    return 1;
}

// Keyword recognition — the 22 reserved words, one branch
// each, from the same list as the C twin's table
// (tests/lexer_names.h). No match is K_Ident.
fn keyword_kind(id: ptr<u8>, n: i32) -> i32 {
    if (ident_is("fn", id, n)) { return K_Fn; }
    if (ident_is("extern", id, n)) { return K_Extern; }
    if (ident_is("main", id, n)) { return K_Main; }
    if (ident_is("let", id, n)) { return K_Let; }
    if (ident_is("return", id, n)) { return K_Return; }
    if (ident_is("if", id, n)) { return K_If; }
    if (ident_is("else", id, n)) { return K_Else; }
    if (ident_is("while", id, n)) { return K_While; }
    if (ident_is("for", id, n)) { return K_For; }
    if (ident_is("break", id, n)) { return K_Break; }
    if (ident_is("continue", id, n)) { return K_Continue; }
    if (ident_is("i32", id, n)) { return K_I32; }
    if (ident_is("ptr", id, n)) { return K_Ptr; }
    if (ident_is("bool", id, n)) { return K_Bool; }
    if (ident_is("i64", id, n)) { return K_I64; }
    if (ident_is("u8", id, n)) { return K_U8; }
    if (ident_is("u16", id, n)) { return K_U16; }
    if (ident_is("u32", id, n)) { return K_U32; }
    if (ident_is("struct", id, n)) { return K_Struct; }
    if (ident_is("include", id, n)) { return K_Include; }
    if (ident_is("true", id, n)) { return K_True; }
    if (ident_is("false", id, n)) { return K_False; }
    return K_Ident;
}
