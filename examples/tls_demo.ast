// tls_demo.ast — the smallest thread-local program: two `tls` globals, written
// and read back in main, with the process exit code carrying the summed TLS
// value (a = 10+5 = 15, b = 20*2 = 40, 15+40 = 55). Recorded in the A/B
// baseline for build-elf and build-obj --pic; build-so records FAILED because
// it has no `main` (it is a program, not a library). The shared-object form of
// `tls` lives in examples/so_tls_demo.ast, which builds as a .so and is
// exercised by the three-thread dlopen witness in tests/tls-checks.sh.
tls let a: i32 = 10;
tls let b: i32 = 20;
fn main() -> i32 {
    a = a + 5;
    b = b * 2;
    return a + b;
}
