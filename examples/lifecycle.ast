// The ANativeActivity lifecycle callbacks — the slots native_render.ast
// and native_touch.ast never install.
//
// A NativeActivity is driven by a table of function pointers, ANativeActivity-
// Callbacks, whose first entries are the activity lifecycle. The render and
// touch examples fill the window and input entries below them (56..96) and
// leave these empty, which is why an Aster activity had no way to tell that
// it had been backgrounded or that the device was short of memory. This
// example fills every callback slot that is not a window/input slot and logs
// each one.
//
// Every callback also bumps a counter, and `aster_lifecycle_count` reads them
// back by index. That is what makes the wiring checkable without a device: a
// host process can load this as a shared object, hand it a callback table,
// call the entries and read the counters — the same instructions Android
// would run, driven from outside logcat. (See tests/lifecycle-callbacks.sh.)
//
// Offsets, from android/native_activity.h (every entry is a pointer; AOSP
// android-7.1.1_r58, platform/frameworks/native,
// include/android/native_activity.h — the full 16-slot table):
//   onStart@0, onResume@8, onSaveInstanceState@16, onPause@24, onStop@32,
//   onDestroy@40, onWindowFocusChanged@48, onNativeWindowCreated@56,
//   onNativeWindowResized@64, onNativeWindowRedrawNeeded@72,
//   onNativeWindowDestroyed@80, onInputQueueCreated@88,
//   onInputQueueDestroyed@96, onContentRectChanged@104,
//   onConfigurationChanged@112, onLowMemory@120.
// M3.6: the previous version of this file installed a wrong 7-slot model
// (onPause@16, onStop@24, onDestroy@32, onConfigurationChanged@40,
// onLowMemory@48) that omitted onSaveInstanceState and
// onWindowFocusChanged — the same error M1.2d fixed in
// asterui/backend/android.ast. The window/input slots 56..96 are NOT
// installed here; they belong to native_render.ast / native_touch.ast.

extern fn __android_log_print(prio: i32, tag: ptr, fmt: ptr) -> i32;

// Cross-callback state: one counter per installed slot.
let g_started: i32 = 0;
let g_resumed: i32 = 0;
let g_saved: i32 = 0;
let g_paused: i32 = 0;
let g_stopped: i32 = 0;
let g_destroyed: i32 = 0;
let g_focus: i32 = 0;
let g_rect: i32 = 0;
let g_config: i32 = 0;
let g_lowmem: i32 = 0;

// Diagnostics: fixed strings only (Aster cannot format numbers).
fn llog(msg: ptr) -> i32 {
    return __android_log_print(4, "AsterLifecycle", msg);
}

fn on_start(activity: ptr) -> i32 {
    g_started = g_started + 1;
    return llog("onStart");
}

fn on_resume(activity: ptr) -> i32 {
    g_resumed = g_resumed + 1;
    return llog("onResume");
}

// The framework asks for the instance state to save. This example keeps no
// saveable state, so answer NULL with *outSize = 0: nothing to persist,
// nothing for the framework to free. Signature per the header:
// void *(*onSaveInstanceState)(ANativeActivity *, size_t *outSize).
fn on_save_instance_state(activity: ptr, outSize: ptr<u8>) -> ptr {
    g_saved = g_saved + 1;
    if (outSize != 0) {
        // Zero all 8 bytes of the size_t with byte stores (no libc import:
        // this .so must stay loadable with only __android_log_print
        // provided, so memset is not declared here).
        let i: i32 = 0;
        while (i < 8) {
            let s: i32 = store_u8(outSize + i, 0);
            i = i + 1;
        }
    } else {
    }
    let l: i32 = llog("onSaveInstanceState");
    return 0;
}

fn on_pause(activity: ptr) -> i32 {
    g_paused = g_paused + 1;
    return llog("onPause");
}

fn on_stop(activity: ptr) -> i32 {
    g_stopped = g_stopped + 1;
    return llog("onStop");
}

fn on_destroy(activity: ptr) -> i32 {
    g_destroyed = g_destroyed + 1;
    return llog("onDestroy");
}

// Focus changed. Log-only: losing focus does not pause the app (the pause
// behaviour belongs to onPause alone). M3.6: the previous version installed
// on_low_memory at this slot (48), so every focus gain logged a phantom
// onLowMemory.
fn on_window_focus_changed(activity: ptr, hasFocus: i32) -> i32 {
    g_focus = g_focus + 1;
    if (hasFocus == 1) {
        return llog("onWindowFocusChanged 1");
    } else {
        return llog("onWindowFocusChanged 0");
    }
}

// The content rect changed (e.g. the soft keyboard appeared and shrank the
// area content should use). Log-only here: the example draws nothing.
fn on_content_rect_changed(activity: ptr, rect: ptr) -> i32 {
    g_rect = g_rect + 1;
    return llog("onContentRectChanged");
}

fn on_configuration_changed(activity: ptr) -> i32 {
    g_config = g_config + 1;
    return llog("onConfigurationChanged");
}

fn on_low_memory(activity: ptr) -> i32 {
    g_lowmem = g_lowmem + 1;
    return llog("onLowMemory");
}

// The ten counters, by index in callback-table order: 0 onStart,
// 1 onResume, 2 onSaveInstanceState, 3 onPause, 4 onStop, 5 onDestroy,
// 6 onWindowFocusChanged, 7 onContentRectChanged, 8 onConfigurationChanged,
// 9 onLowMemory. -1 for anything else. M3.6: indices 2..6 changed meaning
// from the previous version (which had onPause at 2 and onLowMemory at 6)
// because the previous version encoded the wrong table; the index now
// follows the slot order, so a slot and its counter can never drift apart
// again without the harness noticing.
fn aster_lifecycle_count(which: i32) -> i32 {
    if (which == 0) { return g_started; }
    if (which == 1) { return g_resumed; }
    if (which == 2) { return g_saved; }
    if (which == 3) { return g_paused; }
    if (which == 4) { return g_stopped; }
    if (which == 5) { return g_destroyed; }
    if (which == 6) { return g_focus; }
    if (which == 7) { return g_rect; }
    if (which == 8) { return g_config; }
    if (which == 9) { return g_lowmem; }
    return -1;
}

fn ANativeActivity_onCreate(activity: ptr, savedState: ptr, savedStateSize: i32) -> i32 {
    // ANativeActivity.callbacks is the first pointer of the struct.
    let cb: ptr = load_ptr(activity);
    *(cb + 0) = on_start;
    *(cb + 8) = on_resume;
    *(cb + 16) = on_save_instance_state;
    *(cb + 24) = on_pause;
    *(cb + 32) = on_stop;
    *(cb + 40) = on_destroy;
    *(cb + 48) = on_window_focus_changed;
    *(cb + 104) = on_content_rect_changed;
    *(cb + 112) = on_configuration_changed;
    *(cb + 120) = on_low_memory;
    return 0;
}
