extern fn __android_log_print(prio: i32, tag: ptr, fmt: ptr) -> i32;
extern fn ANativeWindow_setBuffersGeometry(window: ptr, width: i32, height: i32, format: i32) -> i32;
extern fn ANativeWindow_lock(window: ptr, outBuffer: ptr, inOutDirty: ptr) -> i32;
extern fn ANativeWindow_unlockAndPost(window: ptr) -> i32;

let g_winbuf: i32[32] = 0;
let g_dirty: i32[4] = 0;

// Draw one gradient frame into the window's pixel buffer.
// ANativeWindow_Buffer layout: width@0 height@4 stride@8 format@12 bits@16
fn draw_frame(window: ptr) -> i32 {
    // Ask for 32-bit pixels up front: most devices honor this, and every path
    // below then knows the pixel size. 0 means "keep the window's value".
    let geom: i32 = ANativeWindow_setBuffersGeometry(window, 0, 0, 1);
    let locked: i32 = ANativeWindow_lock(window, g_winbuf, g_dirty);
    if (locked != 0) {
        // lock failed: the buffer fields are not valid, do not touch them.
        return 0;
    } else {
        let w: i32 = g_winbuf[0];
        let h: i32 = g_winbuf[1];
        if (w < 1) {
            return 0;
        } else {
            let stride: i32 = g_winbuf[2];
            let fmt: i32 = g_winbuf[3];
            let bits: ptr = load_ptr(g_winbuf + 16);
            // WINDOW_FORMAT_RGBA_8888=1, WINDOW_FORMAT_RGBX_8888=2: 4 bytes/px.
            // WINDOW_FORMAT_RGB_565=4: 2 bytes/px. Anything else (e.g. YV12) has
            // no byte layout we can write safely: skip and say so.
            if (fmt == 1) {
            } else {
                if (fmt == 2) {
                } else {
                    if (fmt == 4) {
                    } else {
                        let logged: i32 = __android_log_print(6, "Aster", "unsupported pixel format");
                        return 0;
                    }
                }
            }
            let y: i32 = 0;
            while (y < h) {
                let x: i32 = 0;
                while (x < w) {
                    let r: i32 = (x * 255) / w;
                    let g: i32 = (y * 255) / h;
                    if (fmt == 4) {
                        // RGB565: r5 g6 b5, little-endian. Aster has no shifts,
                        // so encode with division/multiplication instead.
                        // stride counts PIXELS per row, so the byte offset of
                        // pixel (x, y) is (y * stride + x) * bytes_per_pixel.
                        // Scaling only the x term (y*stride + x*2) writes every
                        // row 1/bpp of the way down: rows overlap, only the top
                        // slice of the window gets covered, and each display row
                        // ends up assembled from bpp different source rows.
                        let px: i32 = (y * stride + x) * 2;
                        let v: i32 = (r / 8) * 2048 + (g / 4) * 32 + 16;
                        let lo: i32 = v - (v / 256) * 256;
                        let hi: i32 = v / 256;
                        let s0: i32 = store_u8(bits + px + 0, lo);
                        let s1: i32 = store_u8(bits + px + 1, hi);
                    } else {
                        // 4 bytes/px: same rule, (y * stride + x) * 4.
                        let px: i32 = (y * stride + x) * 4;
                        let s0: i32 = store_u8(bits + px + 0, r);
                        let s1: i32 = store_u8(bits + px + 1, g);
                        let s2: i32 = store_u8(bits + px + 2, 128);
                        let s3: i32 = store_u8(bits + px + 3, 255);
                    }
                    x = x + 1;
                }
                y = y + 1;
            }
            let posted: i32 = ANativeWindow_unlockAndPost(window);
            return 0;
        }
    }
}

// The window is usually still small when it is first created, so a single
// draw leaves black bands and stretched stripes once the layout settles.
// Redraw on every resize/redraw notification: the callbacks receive the
// window directly, so no global state is needed.
fn on_native_window_created(activity: ptr, window: ptr) -> i32 {
    let logged: i32 = __android_log_print(3, "Aster", "window created");
    return draw_frame(window);
}

fn on_native_window_resized(activity: ptr, window: ptr) -> i32 {
    return draw_frame(window);
}

fn on_native_window_redraw_needed(activity: ptr, window: ptr) -> i32 {
    return draw_frame(window);
}

fn ANativeActivity_onCreate(activity: ptr, savedState: ptr, savedStateSize: i32) -> i32 {
    // ANativeActivity layout: callbacks@0, vm@8, env@16, clazz@24,
    // internalDataPath@32, externalDataPath@40, sdkVersion@48, instance@56,
    // assetManager@64, obbPath@72. Offset 48 holds sdkVersion (int32), not a
    // pointer -- reading it as callbacks crashes on the first callback write.
    let cb: ptr = load_ptr(activity);
    // ANativeActivityCallbacks offsets: onNativeWindowCreated@56,
    // onNativeWindowResized@64, onNativeWindowRedrawNeeded@72
    *(cb + 56) = on_native_window_created;
    *(cb + 64) = on_native_window_resized;
    *(cb + 72) = on_native_window_redraw_needed;
    return 0;
}
