fn aster_mixed_sum10(p0: ptr, a1: i32, p2: ptr, a3: i32, p4: ptr, a5: i32, p6: ptr, a7: i32, p8: ptr, a9: i32) -> i32 {
    return a1 + a3 + a5 + a7 + a9;
}

fn aster_mixed_sum10_forward(p0: ptr, a1: i32, p2: ptr, a3: i32, p4: ptr, a5: i32, p6: ptr, a7: i32, p8: ptr, a9: i32) -> i32 {
    return aster_mixed_sum10(p0, a1, p2, a3, p4, a5, p6, a7, p8, a9);
}

fn aster_mixed_last_ptr(p0: ptr, a1: i32, p2: ptr, a3: i32, p4: ptr, a5: i32, p6: ptr, a7: i32, p8: ptr, a9: i32) -> ptr {
    return p8;
}

fn aster_mixed_last_ptr_forward(p0: ptr, a1: i32, p2: ptr, a3: i32, p4: ptr, a5: i32, p6: ptr, a7: i32, p8: ptr, a9: i32) -> ptr {
    return aster_mixed_last_ptr(p0, a1, p2, a3, p4, a5, p6, a7, p8, a9);
}
